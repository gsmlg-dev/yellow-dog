  },
  "dependencies": {
    "@duskmoon-dev/art-elements": "2.0.0-rc.3",
    "@duskmoon-dev/components": "2.0.0-rc.3",
    "@duskmoon-dev/core": "2.0.0-rc.3",
    "@duskmoon-dev/css-art": "2.0.0-rc.3",
    "@duskmoon-dev/elements": "2.0.0-rc.3",
    "duskmoon_phoenix": "2.0.0-rc.3",
    "jsonschema": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@redocly/cli": "2.77.0",
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
