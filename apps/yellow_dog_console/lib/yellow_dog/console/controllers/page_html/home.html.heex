<Layouts.app flash={@flash}>
  <div class="hero min-h-[calc(100vh-5rem)] bg-gradient-to-br from-primary/10 via-base-200 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-4xl">
        <div class="flex items-center justify-center gap-4 mb-8">
          <div class="text-6xl">🐕</div>
          <h1 class="text-7xl font-bold">
            <span class="text-primary">Yellow</span><span class="text-warning">Dog</span>
          </h1>
        </div>

        <p class="text-2xl font-light mb-8">
          Distributed DNS and DHCP Server
        </p>

        <p class="text-lg text-base-content/70 mb-12 max-w-2xl mx-auto">
          A high-performance, Erlang/Elixir-powered DNS and DHCP server with real-time monitoring,
          mDNS service discovery, and comprehensive network management capabilities.
        </p>

        <div class="stats stats-vertical lg:stats-horizontal shadow-xl mb-12">
          <div class="stat">
            <div class="stat-figure text-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                />
              </svg>
            </div>
            <div class="stat-title">DNS Service</div>
            <div class="stat-value text-primary">Running</div>
            <div class="stat-desc">Port 53</div>
          </div>

          <div class="stat">
            <div class="stat-figure text-success">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                />
              </svg>
            </div>
            <div class="stat-title">DHCP Services</div>
            <div class="stat-value text-success">Active</div>
            <div class="stat-desc">IPv4 & IPv6</div>
          </div>

          <div class="stat">
            <div class="stat-figure text-secondary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"
                />
              </svg>
            </div>
            <div class="stat-title">mDNS</div>
            <div class="stat-value text-secondary">Ready</div>
            <div class="stat-desc">Service Discovery</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <.link navigate={~p"/dashboard"} class="btn btn-primary btn-lg gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              />
            </svg>
            Service Dashboard
          </.link>

          <.link navigate={~p"/dns"} class="btn btn-accent btn-lg gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              />
            </svg>
            DNS Management
          </.link>

          <.link navigate={~p"/mdns"} class="btn btn-secondary btn-lg gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
            mDNS Discovery
          </.link>
        </div>

        <div class="mt-16 text-center text-sm text-base-content/50">
          <p>YellowDog DNS v0.1.0 · Built with Elixir & Phoenix</p>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
