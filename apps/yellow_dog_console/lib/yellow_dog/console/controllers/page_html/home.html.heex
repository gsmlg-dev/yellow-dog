<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>YellowDog DNS Console</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-gray-50">
    <div class="min-h-screen flex items-center justify-center">
      <div class="max-w-2xl w-full px-6 py-12">
        <div class="text-center mb-12">
          <h1 class="text-6xl font-bold text-gray-900 mb-4">
            YellowDog DNS
          </h1>
          <p class="text-xl text-gray-600">
            Distributed DNS and DHCP Server
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <a
            href={~p"/dashboard"}
            class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200"
          >
            <h2 class="text-2xl font-semibold text-gray-900 mb-2">Dashboard</h2>
            <p class="text-gray-600">View system status and metrics</p>
          </a>

          <a
            href={~p"/mdns"}
            class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200"
          >
            <h2 class="text-2xl font-semibold text-gray-900 mb-2">mDNS</h2>
            <p class="text-gray-600">Manage mDNS services and discovery</p>
          </a>
        </div>

        <div class="mt-12 text-center text-sm text-gray-500">
          <p>YellowDog DNS v0.1.0</p>
        </div>
      </div>
    </div>
  </body>
</html>
