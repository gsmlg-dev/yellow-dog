<Layouts.app flash={@flash}>
  <div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-gradient-to-br from-primary/10 via-surface-container to-secondary/10">
    <div class="text-center p-8">
      <div class="max-w-4xl">
        <div class="flex items-center justify-center gap-4 mb-8">
          <div class="text-6xl">🐕</div>
          <h1 class="text-7xl font-bold">
            <span class="text-primary">Yellow</span><span class="text-warning">Dog</span>
          </h1>
        </div>

        <p class="text-2xl font-light mb-8">Network Management Control Plane</p>

        <p class="text-lg text-on-surface-variant mb-12 max-w-2xl mx-auto">
          Management is the source of truth. Select a registered Server or Netman node before
          viewing its status, configuration, and network services.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
          <div class="card card-bordered bg-surface">
            <div class="card-body">
              <h2 class="card-title">
                <div class="flex items-center gap-2">
                  <.dm_mdi name="web" class="w-8 h-8 text-primary" />
                  <span>Management</span>
                </div>
              </h2>
              <div class="text-2xl font-bold text-primary">Source of truth</div>
              <div class="text-sm text-on-surface-variant">Desired state and node inventory</div>
            </div>
          </div>

          <div class="card card-bordered bg-surface">
            <div class="card-body">
              <h2 class="card-title">
                <div class="flex items-center gap-2">
                  <.dm_mdi name="server-network" class="w-8 h-8 text-success" />
                  <span>Servers</span>
                </div>
              </h2>
              <div class="text-2xl font-bold text-success">Remote control</div>
              <div class="text-sm text-on-surface-variant">DNS, DHCP, mDNS, and Netboot</div>
            </div>
          </div>

          <div class="card card-bordered bg-surface">
            <div class="card-body">
              <h2 class="card-title">
                <div class="flex items-center gap-2">
                  <.dm_mdi name="wifi" class="w-8 h-8 text-secondary" />
                  <span>Netman</span>
                </div>
              </h2>
              <div class="text-2xl font-bold text-secondary">Network agents</div>
              <div class="text-sm text-on-surface-variant">
                Profiles, interfaces, and resolver state
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <.link navigate={~p"/management"} class="btn btn-primary gap-2">
            <.dm_mdi name="account-cog" class="w-6 h-6" /> Management
          </.link>

          <.link navigate={~p"/server"} class="btn btn-tertiary gap-2">
            <.dm_mdi name="server-network" class="w-6 h-6" /> Select Server
          </.link>

          <.link navigate={~p"/netman"} class="btn btn-secondary gap-2">
            <.dm_mdi name="lan" class="w-6 h-6" /> Select Netman
          </.link>
        </div>

        <div class="mt-16 text-center text-sm text-on-surface-variant">
          <p>YellowDog DNS v0.1.0 · Built with Elixir & Phoenix</p>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
