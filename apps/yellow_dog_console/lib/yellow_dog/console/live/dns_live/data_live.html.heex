<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">DNS Service</h1>
        <p class="mt-2 text-base-content/70">
          Domain Name System management
        </p>
      </div>
      <button phx-click="refresh" class="btn btn-ghost btn-circle btn-sm" title="Refresh">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          />
        </svg>
      </button>
    </div>

    <!-- Breadcrumb -->
    <div class="breadcrumbs text-sm">
      <ul>
        <li>
          <.link navigate={~p"/dns/data"} class={if @live_action == :views, do: "font-semibold", else: ""}>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"
              />
            </svg>
            Views
          </.link>
        </li>
        <%= if @view_name do %>
          <li>
            <.link
              navigate={~p"/dns/data/#{@view_name}"}
              class={if @live_action == :zones, do: "font-semibold", else: ""}
            >
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                />
              </svg>
              {@view_name}
            </.link>
          </li>
        <% end %>
        <%= if @zone_name do %>
          <li class="font-semibold">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
              />
            </svg>
            {@zone_name}
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Content based on live_action -->
    <%= case @live_action do %>
      <% :views -> %>
        <!-- Views List -->
        <%= if length(@views) > 0 do %>
          <.card title="DNS Views" class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>View Name</th>
                  <th>Priority</th>
                  <th>Recursion</th>
                  <th>ECS</th>
                  <th>Zones</th>
                  <th>Queries</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <%= for view <- @views do %>
                  <tr class="hover cursor-pointer" phx-click={JS.navigate(~p"/dns/data/#{view.name}")}>
                    <td class="font-mono font-semibold">{view.name}</td>
                    <td>{view.priority}</td>
                    <td>
                      <%= if view.recursion_enabled do %>
                        <.badge color="success" size="sm">Enabled</.badge>
                      <% else %>
                        <.badge color="warning" size="sm">Disabled</.badge>
                      <% end %>
                    </td>
                    <td>
                      <%= if view.ecs_enabled do %>
                        <.badge color="info" size="sm">Enabled</.badge>
                      <% else %>
                        <.badge color="ghost" size="sm">Disabled</.badge>
                      <% end %>
                    </td>
                    <td>{view.zone_count}</td>
                    <td>{view.query_count}</td>
                    <td>
                      <.link navigate={~p"/dns/data/#{view.name}"} class="btn btn-ghost btn-sm gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                        View Zones
                      </.link>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </.card>
        <% else %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body text-center py-12">
              <svg
                class="mx-auto h-16 w-16 text-base-content/30"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                />
              </svg>
              <h3 class="mt-4 text-xl font-semibold">No DNS Views</h3>
              <p class="mt-2 text-base-content/60">
                No views have been configured yet.
              </p>
            </div>
          </div>
        <% end %>
      <% :zones -> %>
        <!-- Zones List -->
        <%= if @view do %>
          <!-- View Info -->
          <div class="stats stats-vertical sm:stats-horizontal shadow w-full">
            <div class="stat">
              <div class="stat-title">View Name</div>
              <div class="stat-value text-lg font-mono">{@view.name}</div>
            </div>
            <div class="stat">
              <div class="stat-title">Priority</div>
              <div class="stat-value text-lg">{@view.priority}</div>
            </div>
            <div class="stat">
              <div class="stat-title">Recursion</div>
              <div class="stat-value text-lg">
                <%= if @view.recursion_enabled do %>
                  <.badge color="success">Enabled</.badge>
                <% else %>
                  <.badge color="warning">Disabled</.badge>
                <% end %>
              </div>
            </div>
            <div class="stat">
              <div class="stat-title">Queries</div>
              <div class="stat-value text-lg">{@view.query_count}</div>
            </div>
          </div>

          <!-- Zones Table -->
          <%= if length(@view.zones) > 0 do %>
            <.card title="Zones in #{@view.name}" class="overflow-x-auto">
              <table class="table table-zebra">
                <thead>
                  <tr>
                    <th>Zone Name</th>
                    <th>Type</th>
                    <th>Records</th>
                    <th>Queries</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <%= for zone <- @view.zones do %>
                    <tr
                      class="hover cursor-pointer"
                      phx-click={JS.navigate(~p"/dns/data/#{@view_name}/#{zone.name}")}
                    >
                      <td class="font-mono font-semibold">{zone.name}</td>
                      <td>
                        <.badge color={zone_type_badge(zone.type)}>
                          {zone_type_label(zone.type)}
                        </.badge>
                      </td>
                      <td>{Map.get(zone, :record_count, 0)}</td>
                      <td>{Map.get(zone, :query_count, 0)}</td>
                      <td>
                        <.link
                          navigate={~p"/dns/data/#{@view_name}/#{zone.name}"}
                          class="btn btn-ghost btn-sm gap-1"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 5l7 7-7 7"
                            />
                          </svg>
                          View Records
                        </.link>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </.card>
          <% else %>
            <div class="card bg-base-100 shadow-xl">
              <div class="card-body text-center py-12">
                <svg
                  class="mx-auto h-12 w-12 text-base-content/30"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                  />
                </svg>
                <h3 class="mt-2 text-lg font-semibold">No Zones</h3>
                <p class="mt-1 text-base-content/60">
                  No zones are configured in this view.
                </p>
                <%= if @view.recursion_enabled do %>
                  <p class="text-sm text-info">
                    Queries will be forwarded to upstream servers.
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- View Not Found -->
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body text-center py-12">
              <svg
                class="mx-auto h-16 w-16 text-error"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <h3 class="mt-4 text-xl font-semibold">View Not Found</h3>
              <p class="mt-2 text-base-content/60">
                The view '{@view_name}' does not exist.
              </p>
              <div class="mt-4">
                <.link navigate={~p"/dns/data"} class="btn btn-primary">Back to Views</.link>
              </div>
            </div>
          </div>
        <% end %>
      <% :records -> %>
        <!-- Records View -->
        <%= if @zone do %>
          <!-- Zone Info -->
          <div class="stats stats-vertical sm:stats-horizontal shadow w-full">
            <div class="stat">
              <div class="stat-title">Zone Name</div>
              <div class="stat-value text-lg font-mono">{@zone.name}</div>
            </div>
            <div class="stat">
              <div class="stat-title">Type</div>
              <div class="stat-value text-lg">
                <.badge color={zone_type_badge(@zone.type)} size="lg">
                  {zone_type_label(@zone.type)}
                </.badge>
              </div>
            </div>
            <div class="stat">
              <div class="stat-title">Records</div>
              <div class="stat-value text-lg">{@zone.record_count}</div>
            </div>
            <div class="stat">
              <div class="stat-title">Hit Rate</div>
              <div class="stat-value text-lg">
                {calculate_hit_rate(@zone.hit_count, @zone.miss_count)}%
              </div>
            </div>
          </div>

          <!-- Upstreams (for forward zones) -->
          <%= if @zone.type == :forward and length(@zone.upstreams) > 0 do %>
            <.card title="Upstream Servers">
              <div class="space-y-2">
                <%= for upstream <- @zone.upstreams do %>
                  <div class="flex items-center justify-between p-3 rounded-lg bg-base-200">
                    <span class="font-mono">{inspect(upstream)}</span>
                    <.badge>Upstream</.badge>
                  </div>
                <% end %>
              </div>
            </.card>
          <% end %>

          <!-- Records (for auth zones) -->
          <%= if @zone.type == :auth do %>
            <!-- Filter -->
            <div class="flex flex-col sm:flex-row gap-4">
              <div class="form-control flex-1">
                <div class="join w-full">
                  <span class="join-item bg-base-300 flex items-center px-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                      />
                    </svg>
                  </span>
                  <input
                    type="text"
                    placeholder="Filter by name..."
                    class="input input-bordered join-item w-full"
                    phx-change="filter"
                    phx-debounce="300"
                    name="filter"
                    value={@filter}
                  />
                </div>
              </div>
              <div class="form-control">
                <select class="select select-bordered" phx-change="filter_type" name="type">
                  <option value="all" selected={@type_filter == "all"}>All Types</option>
                  <%= for type <- unique_record_types(@zone.records) do %>
                    <option value={type} selected={@type_filter == to_string(type)}>
                      {String.upcase(to_string(type))}
                    </option>
                  <% end %>
                </select>
              </div>
            </div>

            <!-- Records Table -->
            <.card title="Resource Records" class="overflow-x-auto">
              <%= if length(@zone.records) > 0 do %>
                <table class="table table-zebra">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Type</th>
                      <th>TTL</th>
                      <th>Data</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for record <- filtered_records(@zone.records, @filter, @type_filter) do %>
                      <tr class="hover">
                        <td class="font-mono">{record.name}</td>
                        <td>
                          <.badge color={record_type_badge(record.type)}>
                            {String.upcase(to_string(record.type))}
                          </.badge>
                        </td>
                        <td>{record.ttl}</td>
                        <td class="font-mono text-sm max-w-md truncate" title={record.rdata}>
                          {record.rdata}
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>

                <%= if filtered_records(@zone.records, @filter, @type_filter) == [] do %>
                  <div class="text-center py-8 text-base-content/60">
                    No records match your filter criteria.
                  </div>
                <% end %>
              <% else %>
                <div class="text-center py-12">
                  <svg
                    class="mx-auto h-12 w-12 text-base-content/30"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                  <h3 class="mt-2 text-sm font-medium">No records</h3>
                  <p class="mt-1 text-sm text-base-content/60">
                    This zone has no resource records.
                  </p>
                </div>
              <% end %>
            </.card>
          <% else %>
            <!-- Non-auth zone info -->
            <.card title="Zone Information">
              <div class="prose max-w-none">
                <%= case @zone.type do %>
                  <% :forward -> %>
                    <p>
                      This is a <strong>forward zone</strong>. Queries for names in this zone are
                      forwarded to upstream DNS servers.
                    </p>
                  <% :stub -> %>
                    <p>
                      This is a <strong>stub zone</strong>. It contains only NS records pointing to
                      authoritative servers.
                    </p>
                  <% :cache -> %>
                    <p>
                      This is a <strong>cache zone</strong>. It stores cached responses from
                      recursive queries.
                    </p>
                  <% _ -> %>
                    <p>Zone type: {@zone.type}</p>
                <% end %>
              </div>
            </.card>
          <% end %>
        <% else %>
          <!-- Zone Not Found -->
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body text-center py-12">
              <svg
                class="mx-auto h-16 w-16 text-error"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <h3 class="mt-4 text-xl font-semibold">Zone Not Found</h3>
              <p class="mt-2 text-base-content/60">
                The zone '{@zone_name}' does not exist.
              </p>
              <div class="mt-4">
                <.link navigate={~p"/dns/data/#{@view_name}"} class="btn btn-primary">
                  Back to View
                </.link>
              </div>
            </div>
          </div>
        <% end %>
    <% end %>
  </div>
</Layouts.app>
