<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <!-- Breadcrumb -->
    <div class="breadcrumbs text-sm">
      <ul>
        <li><.link navigate={~p"/dns"}>DNS</.link></li>
        <li><.link navigate={~p"/dns/views/#{@view_name}"}>View: {@view_name}</.link></li>
        <li class="font-semibold">{@zone_name}</li>
      </ul>
    </div>

    <%= if @zone do %>
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold font-mono">{@zone.name}</h1>
          <div class="flex items-center gap-2 mt-2">
            <.badge size="lg" color={zone_type_badge(@zone.type)}>
              {zone_type_label(@zone.type)}
            </.badge>
          </div>
        </div>
        <button phx-click="refresh" class="btn btn-primary gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          Refresh
        </button>
      </div>

      <!-- Stats -->
      <div class="stats stats-vertical lg:stats-horizontal shadow-xl w-full">
        <div class="stat">
          <div class="stat-figure text-primary">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
          </div>
          <div class="stat-title">Records</div>
          <div class="stat-value text-primary">{@zone.record_count}</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-secondary">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <div class="stat-title">Queries</div>
          <div class="stat-value text-secondary">{@zone.query_count}</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-success">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <div class="stat-title">Hit Rate</div>
          <div class="stat-value text-success">
            {calculate_hit_rate(@zone.hit_count, @zone.miss_count)}%
          </div>
          <div class="stat-desc">{@zone.hit_count} hits / {@zone.miss_count} misses</div>
        </div>
      </div>

      <!-- Zone Type Specific Info -->
      <%= if @zone.type == :forward and length(@zone.upstreams) > 0 do %>
        <.card title="Upstream Servers">
          <div class="space-y-2">
            <%= for upstream <- @zone.upstreams do %>
              <div class="flex items-center justify-between p-3 rounded-lg bg-base-200">
                <span class="font-mono">{inspect(upstream)}</span>
                <.badge>Upstream</.badge>
              </div>
            <% end %>
          </div>
        </.card>
      <% end %>

      <!-- Records (for auth zones) -->
      <%= if @zone.type == :auth do %>
        <!-- Filter -->
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="form-control flex-1">
            <label class="input-group">
              <span class="bg-base-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  />
                </svg>
              </span>
              <input
                type="text"
                placeholder="Filter by name..."
                class="input input-bordered w-full"
                phx-change="filter"
                name="filter"
                value={@filter}
              />
            </label>
          </div>
          <div class="form-control">
            <select class="select select-bordered" phx-change="filter_type" name="type">
              <option value="all" selected={@type_filter == "all"}>All Types</option>
              <%= for type <- unique_record_types(@zone.records) do %>
                <option value={type} selected={@type_filter == to_string(type)}>
                  {String.upcase(to_string(type))}
                </option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Records Table -->
        <.card title="Resource Records" class="overflow-x-auto">
          <%= if length(@zone.records) > 0 do %>
            <.table
              id="records"
              rows={filtered_records(@zone.records, @filter, @type_filter)}
              zebra
              hover
            >
              <:col :let={record} label="Name">
                <div class="font-mono">{record.name}</div>
              </:col>
              <:col :let={record} label="Type">
                <.badge color={record_type_badge(record.type)}>
                  {String.upcase(to_string(record.type))}
                </.badge>
              </:col>
              <:col :let={record} label="TTL">
                {record.ttl}
              </:col>
              <:col :let={record} label="Data">
                <div class="font-mono text-sm max-w-md truncate" title={record.rdata}>
                  {record.rdata}
                </div>
              </:col>
            </.table>

            <%= if filtered_records(@zone.records, @filter, @type_filter) == [] do %>
              <div class="text-center py-8 text-base-content/60">
                No records match your filter criteria.
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-12">
              <svg
                class="mx-auto h-12 w-12 text-base-content/30"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                />
              </svg>
              <h3 class="mt-2 text-sm font-medium">No records</h3>
              <p class="mt-1 text-sm text-base-content/60">
                This zone has no resource records.
              </p>
            </div>
          <% end %>
        </.card>
      <% else %>
        <!-- Non-auth zone info -->
        <.card title="Zone Information">
          <div class="prose max-w-none">
            <%= case @zone.type do %>
              <% :forward -> %>
                <p>
                  This is a <strong>forward zone</strong>. Queries for names in this zone are forwarded to upstream DNS servers.
                </p>
              <% :stub -> %>
                <p>
                  This is a <strong>stub zone</strong>. It contains only NS records pointing to authoritative servers.
                </p>
              <% :cache -> %>
                <p>
                  This is a <strong>cache zone</strong>. It stores cached responses from recursive queries.
                </p>
              <% _ -> %>
                <p>Zone type: {@zone.type}</p>
            <% end %>
          </div>
        </.card>
      <% end %>
    <% else %>
      <!-- Zone Not Found -->
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body text-center py-12">
          <svg
            class="mx-auto h-16 w-16 text-error"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
          <h3 class="mt-4 text-xl font-semibold">Zone Not Found</h3>
          <p class="mt-2 text-base-content/60">
            The zone '{@zone_name}' does not exist or has been removed.
          </p>
          <div class="mt-4">
            <.link navigate={~p"/dns/views/#{@view_name}"} class="btn btn-primary">
              Back to View
            </.link>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
