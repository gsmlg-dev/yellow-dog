<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">DNS Service</h1>
        <p class="mt-2 text-base-content/70">
          Views, Zones, and Resource Records
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.status_indicator
          status={if @status.running, do: "running", else: "stopped"}
          label={if @status.running, do: "Running", else: "Stopped"}
          pulse
        />
        <button phx-click="refresh" class="btn btn-ghost btn-circle btn-sm" title="Refresh">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
        </button>
      </div>
    </div>

    <!-- Summary Stats -->
    <div class="stats stats-vertical lg:stats-horizontal shadow-xl w-full">
      <div class="stat">
        <div class="stat-figure text-primary">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
            />
          </svg>
        </div>
        <div class="stat-title">Views</div>
        <div class="stat-value text-primary">{length(@views)}</div>
        <div class="stat-desc">Client perspectives</div>
      </div>

      <div class="stat">
        <div class="stat-figure text-success">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
            />
          </svg>
        </div>
        <div class="stat-title">Total Zones</div>
        <div class="stat-value text-success">{total_zones(@views)}</div>
        <div class="stat-desc">Across all views</div>
      </div>

      <div class="stat">
        <div class="stat-figure text-secondary">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            />
          </svg>
        </div>
        <div class="stat-title">Total Queries</div>
        <div class="stat-value text-secondary">{total_queries(@views)}</div>
        <div class="stat-desc">All time</div>
      </div>
    </div>

    <!-- DNS Hierarchy Info -->
    <div class="alert">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>
      <div>
        <h3 class="font-bold">DNS Hierarchy</h3>
        <div class="text-sm">
          <span class="font-semibold">View</span> (ACL + recursion) →
          <span class="font-semibold">Zone</span> (auth/forward/stub) →
          <span class="font-semibold">Records</span> (A, AAAA, CNAME, etc.)
        </div>
      </div>
    </div>

    <!-- Views List -->
    <div class="space-y-4">
      <%= for view <- @views do %>
        <div class="card bg-base-100 shadow-xl">
          <!-- View Header (clickable) -->
          <div
            class="card-body cursor-pointer hover:bg-base-200 transition-colors"
            phx-click="toggle_view"
            phx-value-view={view.name}
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <!-- Expand/Collapse Icon -->
                <svg
                  class={"w-5 h-5 transition-transform #{if @expanded_view == view.name, do: "rotate-90", else: ""}"}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>

                <div>
                  <h2 class="card-title font-mono">{view.name}</h2>
                  <div class="flex items-center gap-2 mt-1">
                    <.badge size="sm" color="primary">Priority: {view.priority}</.badge>
                    <%= if view.recursion_enabled do %>
                      <.badge size="sm" color="success">Recursion</.badge>
                    <% else %>
                      <.badge size="sm" color="warning">No Recursion</.badge>
                    <% end %>
                    <%= if view.ecs_enabled do %>
                      <.badge size="sm" color="info">ECS</.badge>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <div class="text-right">
                  <div class="text-2xl font-bold">{length(view.zones)}</div>
                  <div class="text-xs text-base-content/60">Zones</div>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold">{view.query_count}</div>
                  <div class="text-xs text-base-content/60">Queries</div>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold">{view.cache_size}</div>
                  <div class="text-xs text-base-content/60">Cached</div>
                </div>

                <.link
                  navigate={~p"/dns/views/#{view.name}"}
                  class="btn btn-ghost btn-sm gap-1"
                  title="View Details"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  Configure
                </.link>
              </div>
            </div>
          </div>

          <!-- Zones (expanded) -->
          <%= if @expanded_view == view.name do %>
            <div class="border-t border-base-300">
              <%= if length(view.zones) > 0 do %>
                <div class="overflow-x-auto">
                  <table class="table table-zebra">
                    <thead>
                      <tr>
                        <th>Zone Name</th>
                        <th>Type</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for zone <- view.zones do %>
                        <tr class="hover">
                          <td class="font-mono font-semibold">{zone.name}</td>
                          <td>
                            <.badge color={zone_type_badge(zone.type)}>
                              {zone_type_label(zone.type)}
                            </.badge>
                          </td>
                          <td>
                            <.link
                              navigate={~p"/dns/views/#{view.name}/zones/#{zone.name}"}
                              class="btn btn-ghost btn-xs gap-1"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                />
                              </svg>
                              Records
                            </.link>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="p-6 text-center text-base-content/60">
                  <svg
                    class="mx-auto h-12 w-12 text-base-content/30"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                    />
                  </svg>
                  <p class="mt-2">No zones configured in this view</p>
                  <%= if view.recursion_enabled do %>
                    <p class="text-sm">Queries will be forwarded to upstream servers</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Empty State -->
    <%= if @views == [] do %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body text-center py-12">
          <svg
            class="mx-auto h-16 w-16 text-base-content/30"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
            />
          </svg>
          <h3 class="mt-4 text-xl font-semibold">No DNS Views Configured</h3>
          <p class="mt-2 text-base-content/60">
            DNS service may not be running or no views have been created yet.
          </p>
        </div>
      </div>
    <% end %>

    <!-- Quick Links -->
    <.card title="Quick Actions">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <.link navigate={~p"/dns/cache"} class="btn btn-secondary btn-lg gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"
            />
          </svg>
          View Cache Statistics
        </.link>

        <.link navigate={~p"/diagnostics"} class="btn btn-accent btn-lg gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
            />
          </svg>
          DNS Diagnostics
        </.link>
      </div>
    </.card>
  </div>
</Layouts.app>
