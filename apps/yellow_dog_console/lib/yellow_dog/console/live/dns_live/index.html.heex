<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">DNS Service</h1>
        <p class="mt-2 text-on-surface-variant">
          Domain Name System management
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.status_indicator
          status={if @status.running, do: "running", else: "stopped"}
          label={if @status.running, do: "Running", else: "Stopped"}
          pulse
        />
        <button
          phx-click="refresh"
          class="btn btn-ghost btn-circle btn-sm"
          title="Refresh"
          aria-label="Refresh"
        >
          <.dm_mdi name="refresh" class="h-5 w-5" />
        </button>
      </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Views</div>
              <div class="text-2xl font-bold text-primary">{@stats.view_count}</div>
              <div class="text-xs text-on-surface-variant">Client perspectives</div>
            </div>
            <.dm_mdi name="eye" class="w-8 h-8 text-primary" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Total Zones</div>
              <div class="text-2xl font-bold text-success">{@stats.total_zones}</div>
              <div class="text-xs text-on-surface-variant">Across all views</div>
            </div>
            <.dm_mdi name="folder-outline" class="w-8 h-8 text-success" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Total Queries</div>
              <div class="text-2xl font-bold text-secondary">{@stats.total_queries}</div>
              <div class="text-xs text-on-surface-variant">All time</div>
            </div>
            <.dm_mdi name="help-circle-outline" class="w-8 h-8 text-secondary" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Hit Rate</div>
              <div class="text-2xl font-bold text-info">
                {calculate_hit_rate(@stats.total_hits, @stats.total_misses)}%
              </div>
              <div class="text-xs text-on-surface-variant">{@stats.total_cache} cached entries</div>
            </div>
            <.dm_mdi name="flash" class="w-8 h-8 text-info" />
          </div>
        </div>
      </div>
    </div>

    <!-- Views Summary Table -->
    <%= if @stats.views != [] do %>
      <.card title="Views Summary">
        <div class="overflow-x-auto">
          <table class="table table-striped">
            <thead>
              <tr>
                <th scope="col">View Name</th>
                <th scope="col">Priority</th>
                <th scope="col">Recursion</th>
                <th scope="col">Zones</th>
                <th scope="col">Queries</th>
                <th scope="col">Hit Rate</th>
              </tr>
            </thead>
            <tbody>
              <%= for view <- @stats.views do %>
                <tr class="hover">
                  <td class="font-mono font-semibold">{view.name}</td>
                  <td>{view.priority}</td>
                  <td>
                    <%= if view.recursion_enabled do %>
                      <.badge color="success" size="sm">Enabled</.badge>
                    <% else %>
                      <.badge color="warning" size="sm">Disabled</.badge>
                    <% end %>
                  </td>
                  <td>{view.zone_count}</td>
                  <td>{view.query_count}</td>
                  <td>{calculate_hit_rate(view.hit_count, view.miss_count)}%</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </.card>
    <% else %>
      <div class="card bg-surface shadow-xl">
        <div class="card-body text-center py-12">
          <.dm_mdi name="eye" class="mx-auto h-16 w-16 text-on-surface-variant" />
          <h3 class="mt-4 text-xl font-semibold">No DNS Views Configured</h3>
          <p class="mt-2 text-on-surface-variant">
            DNS service may not be running or no views have been created yet.
          </p>
        </div>
      </div>
    <% end %>

    <!-- Cache Statistics -->
    <.card title="Cache Statistics">
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <!-- Cache Performance -->
        <div class="space-y-4">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium">Hit Rate</span>
              <span class="text-sm font-semibold">{cache_hit_rate(@cache_stats)}%</span>
            </div>
            <.progress value={cache_hit_rate(@cache_stats)} color="success" />
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium">Cache Utilization</span>
              <span class="text-sm font-semibold">
                {@cache_stats.total_entries} / {@cache_stats.max_entries}
              </span>
            </div>
            <.progress
              value={cache_utilization(@cache_stats.total_entries, @cache_stats.max_entries)}
              color="primary"
            />
          </div>
        </div>

        <!-- Cache Stats Grid -->
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-surface-container rounded-lg p-4">
            <div class="text-sm text-on-surface-variant text-xs">Cache Hits</div>
            <div class="text-2xl font-bold text-success text-2xl">{@cache_stats.hit_count}</div>
          </div>
          <div class="bg-surface-container rounded-lg p-4">
            <div class="text-sm text-on-surface-variant text-xs">Cache Misses</div>
            <div class="text-2xl font-bold text-error text-2xl">{@cache_stats.miss_count}</div>
          </div>
          <div class="bg-surface-container rounded-lg p-4">
            <div class="text-sm text-on-surface-variant text-xs">Insertions</div>
            <div class="text-2xl font-bold text-info text-2xl">{@cache_stats.insert_count}</div>
          </div>
          <div class="bg-surface-container rounded-lg p-4">
            <div class="text-sm text-on-surface-variant text-xs">Evictions</div>
            <div class="text-2xl font-bold text-warning text-2xl">{@cache_stats.eviction_count}</div>
          </div>
        </div>
      </div>
    </.card>

    <!-- Quick Links -->
    <.card title="Quick Actions">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <.link navigate={~p"/dns/views"} class="btn btn-primary btn-lg gap-2">
          <.dm_mdi name="eye" class="w-5 h-5" />
          Manage Views
        </.link>

        <.link navigate={~p"/dns/acl"} class="btn btn-secondary btn-lg gap-2">
          <.dm_mdi name="shield-check" class="w-5 h-5" />
          Configure ACLs
        </.link>
      </div>
    </.card>
  </div>
</Layouts.app>
