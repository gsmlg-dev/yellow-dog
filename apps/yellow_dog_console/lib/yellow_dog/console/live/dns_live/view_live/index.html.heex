<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-4">
    <!-- Breadcrumb -->
    <div class="breadcrumbs text-sm">
      <ul>
        <li><.link navigate={~p"/dns"}>DNS</.link></li>
        <li class="font-semibold">Views</li>
      </ul>
    </div>

    <.service_alert :if={not @service_running} service="DNS" />
    
<!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">DNS Views</h1>
        <p class="text-sm text-base-content/70">
          Manage DNS views for different client groups
        </p>
      </div>
      <div class="flex gap-2">
        <button
          phx-click="export_csv"
          id="export-csv"
          phx-hook="CsvDownload"
          class="btn btn-ghost btn-sm"
          title="Export CSV"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            />
          </svg>
          Export
        </button>
        <button phx-click="refresh" class="btn btn-ghost btn-sm" title="Refresh">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          Refresh
        </button>
        <.link patch={~p"/dns/views/new"} class="btn btn-primary btn-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            />
          </svg>
          Add View
        </.link>
      </div>
    </div>

    <%= case @live_action do %>
      <% :index -> %>
        <!-- Views Data Table -->
        <div class="card bg-base-100 shadow">
          <div class="card-body p-0">
            <%= if @views != [] do %>
              <!-- Filter Bar -->
              <div class="flex flex-wrap gap-2 p-4 border-b border-base-200">
                <input
                  type="text"
                  placeholder="Filter by view name..."
                  aria-label="Filter DNS views"
                  class="input input-bordered input-sm flex-1 min-w-48"
                  phx-change="filter"
                  phx-debounce="300"
                  name="filter"
                  value={@filter}
                />
                <select
                  class="select select-bordered select-sm"
                  phx-change="filter_status"
                  aria-label="Filter by status"
                  name="status"
                >
                  <option value="all" selected={@status_filter == "all"}>All Status</option>
                  <option value="active" selected={@status_filter == "active"}>Active</option>
                  <option value="disabled" selected={@status_filter == "disabled"}>
                    Disabled
                  </option>
                </select>
              </div>
              <div class="overflow-x-auto">
                <table class="table table-zebra">
                  <thead>
                    <tr>
                      <th scope="col">Name</th>
                      <th scope="col">Status</th>
                      <th scope="col">Priority</th>
                      <th scope="col">Recursion</th>
                      <th scope="col">ECS</th>
                      <th scope="col">Zones</th>
                      <th scope="col">Queries</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for view <- filtered_views(@views, @filter, @status_filter) do %>
                      <tr class="hover">
                        <td>
                          <.link
                            navigate={~p"/dns/views/#{view.name}/zones"}
                            class="link link-hover font-mono font-semibold"
                          >
                            {view.name}
                          </.link>
                          <%= if view.name == "default" do %>
                            <span class="badge badge-ghost badge-xs ml-1">default</span>
                          <% end %>
                        </td>
                        <td>
                          <button
                            phx-click="toggle_enabled"
                            phx-value-name={view.name}
                            class="cursor-pointer"
                            title={
                              if view.enabled, do: "Click to disable", else: "Click to enable"
                            }
                          >
                            <%= if view.enabled do %>
                              <.badge color="success" size="sm">Active</.badge>
                            <% else %>
                              <.badge color="error" size="sm">Disabled</.badge>
                            <% end %>
                          </button>
                        </td>
                        <td>
                          <span class="font-mono">
                            <%= if view.priority == :infinity do %>
                              ∞
                            <% else %>
                              {view.priority}
                            <% end %>
                          </span>
                        </td>
                        <td>
                          <%= if view.recursion_enabled do %>
                            <.badge color="success" size="sm">Enabled</.badge>
                          <% else %>
                            <.badge color="ghost" size="sm">Disabled</.badge>
                          <% end %>
                        </td>
                        <td>
                          <%= if view.ecs_enabled do %>
                            <.badge color="info" size="sm">Enabled</.badge>
                          <% else %>
                            <.badge color="ghost" size="sm">Disabled</.badge>
                          <% end %>
                        </td>
                        <td>
                          <.link
                            navigate={~p"/dns/views/#{view.name}/zones"}
                            class="link link-hover"
                          >
                            {view.zone_count} zones
                          </.link>
                        </td>
                        <td class="font-mono text-sm">{format_number(view.query_count)}</td>
                        <td class="text-right">
                          <div class="flex items-center justify-end gap-1">
                            <.link
                              navigate={~p"/dns/views/#{view.name}/zones"}
                              class="btn btn-ghost btn-sm"
                              title="View Zones"
                              aria-label="View Zones"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 5l7 7-7 7"
                                />
                              </svg>
                            </.link>
                            <.link
                              patch={~p"/dns/views/#{view.name}/edit"}
                              class="btn btn-ghost btn-sm"
                              title="Edit"
                              aria-label="Edit"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                />
                              </svg>
                            </.link>
                            <%= if view.name != "default" do %>
                              <button
                                phx-click="confirm_delete"
                                phx-value-name={view.name}
                                class="btn btn-ghost btn-sm text-error"
                                title="Delete"
                                aria-label="Delete"
                              >
                                <svg
                                  class="w-4 h-4"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                  />
                                </svg>
                              </button>
                            <% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="px-4 py-2 border-t border-base-200 text-sm text-base-content/60">
                <% filtered = filtered_views(@views, @filter, @status_filter) %>
                <%= if length(filtered) == length(@views) do %>
                  {length(@views)} view(s)
                <% else %>
                  Showing {length(filtered)} of {length(@views)} view(s)
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-12">
                <div class="text-6xl mb-4">
                  <svg
                    class="w-16 h-16 mx-auto text-base-content/30"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold mb-2">No DNS Views</h3>
                <p class="text-base-content/60 mb-4">
                  Get started by creating your first DNS view.
                </p>
                <.link patch={~p"/dns/views/new"} class="btn btn-primary">
                  Create First View
                </.link>
              </div>
            <% end %>
          </div>
        </div>
      <% :new -> %>
        <!-- New View Form -->
        <.card title="Create New View">
          <.form
            for={@view_form}
            phx-submit="save_view"
            phx-change="validate_view"
            phx-debounce="blur"
            class="space-y-4"
          >
            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">View Name</span>
              </label>
              <input
                type="text"
                name="view[name]"
                value={@view_form[:name].value}
                maxlength="63"
                class={"input input-bordered w-full #{if @form_errors[:name], do: "input-error"}"}
                placeholder="e.g., internal, external, guest"
                required
              />
              <label class="label">
                <%= if @form_errors[:name] do %>
                  <span class="label-text-alt text-error">{@form_errors[:name]}</span>
                <% else %>
                  <span class="label-text-alt">Unique identifier for this view</span>
                <% end %>
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Priority</span>
              </label>
              <input
                type="number"
                name="view[priority]"
                value={@view_form[:priority].value}
                class="input input-bordered w-full"
                placeholder="100"
                min="0"
                required
              />
              <label class="label">
                <span class="label-text-alt">Lower value = higher priority (matched first)</span>
              </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                  <input
                    type="checkbox"
                    name="view[recursion_enabled]"
                    value="true"
                    checked={@view_form[:recursion_enabled].value == "true"}
                    class="checkbox checkbox-primary"
                  />
                  <div>
                    <span class="label-text font-semibold">Enable Recursion</span>
                    <p class="text-xs text-base-content/60">
                      Allow recursive queries for this view
                    </p>
                  </div>
                </label>
              </div>

              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                  <input
                    type="checkbox"
                    name="view[ecs_enabled]"
                    value="true"
                    checked={@view_form[:ecs_enabled].value == "true"}
                    class="checkbox checkbox-info"
                  />
                  <div>
                    <span class="label-text font-semibold">Enable ECS</span>
                    <p class="text-xs text-base-content/60">EDNS Client Subnet support</p>
                  </div>
                </label>
              </div>
            </div>
            
<!-- ACL Configuration for new view -->
            <div class="divider">Access Control</div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">ACL Type</span>
              </label>
              <select
                name="view[acl_type]"
                class="select select-bordered w-full"
                phx-change="acl_type_changed"
              >
                <option value="any" selected={@view_form[:acl_type].value == "any"}>
                  Allow All (any)
                </option>
                <option value="none" selected={@view_form[:acl_type].value == "none"}>
                  Deny All (none)
                </option>
                <option value="localhost" selected={@view_form[:acl_type].value == "localhost"}>
                  Localhost Only
                </option>
                <option value="localnets" selected={@view_form[:acl_type].value == "localnets"}>
                  Local Networks (RFC 1918)
                </option>
                <option value="geo" selected={@view_form[:acl_type].value == "geo"}>
                  Geographic (by country)
                </option>
              </select>
              <label class="label">
                <span class="label-text-alt">Control which clients can use this view</span>
              </label>
            </div>
            
<!-- Geo Country Picker for new view -->
            <%= if @view_form[:acl_type].value == "geo" do %>
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Allowed Countries</span>
                  <span class="label-text-alt">{length(@selected_countries)} selected</span>
                </label>
                
<!-- Selected countries badges -->
                <%= if @selected_countries != [] do %>
                  <div class="flex flex-wrap gap-1 mb-2">
                    <%= for code <- @selected_countries do %>
                      <% country = Enum.find(@countries, fn c -> c.code == code end) %>
                      <button
                        type="button"
                        class="badge badge-secondary gap-1"
                        phx-click="toggle_country"
                        phx-value-code={code}
                      >
                        {code}
                        <%= if country do %>
                          - {country.name}
                        <% end %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"
                          />
                        </svg>
                      </button>
                    <% end %>
                  </div>
                <% end %>
                
<!-- Search input -->
                <div class="relative mb-2">
                  <input
                    type="text"
                    class="input input-bordered input-sm w-full pr-8"
                    placeholder="Search countries..."
                    aria-label="Search countries"
                    value={@country_search}
                    phx-keyup="search_country"
                    phx-debounce="300"
                    phx-value-search={@country_search}
                    name="search"
                  />
                  <%= if @country_search != "" do %>
                    <button
                      type="button"
                      class="absolute right-2 top-1/2 -translate-y-1/2 text-base-content/50 hover:text-base-content"
                      phx-click="clear_country_search"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M6 18L18 6M6 6l12 12"
                        />
                      </svg>
                    </button>
                  <% end %>
                </div>
                
<!-- Country grid -->
                <div class="border border-base-300 rounded-lg p-2 max-h-48 overflow-y-auto">
                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-1">
                    <%= for country <- filtered_countries(@countries, @country_search) do %>
                      <label class="label cursor-pointer justify-start gap-2 p-1 hover:bg-base-200 rounded">
                        <input
                          type="checkbox"
                          class="checkbox checkbox-xs checkbox-secondary"
                          checked={country.code in @selected_countries}
                          phx-click="toggle_country"
                          phx-value-code={country.code}
                        />
                        <span class="label-text text-sm">
                          <span class="font-mono text-xs text-base-content/70">
                            {country.code}
                          </span>
                          {country.name}
                        </span>
                      </label>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
            
<!-- Fallback Forwarders -->
            <div class="divider">Fallback Forwarding</div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Fallback DNS Servers</span>
              </label>
              <textarea
                name="view[fallback_forwarders]"
                class={"textarea textarea-bordered h-20 font-mono text-sm #{if @form_errors[:fallback_forwarders], do: "textarea-error"}"}
                placeholder="8.8.8.8&#10;8.8.4.4&#10;1.1.1.1:53"
              >{@view_form[:fallback_forwarders].value}</textarea>
              <label class="label">
                <%= if @form_errors[:fallback_forwarders] do %>
                  <span class="label-text-alt text-error">
                    {@form_errors[:fallback_forwarders]}
                  </span>
                <% else %>
                  <span class="label-text-alt">
                    Upstream servers used when zone resolution fails (one per line, optional :port)
                  </span>
                <% end %>
              </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Timeout (ms)</span>
                </label>
                <input
                  type="number"
                  name="view[fallback_timeout]"
                  value={@view_form[:fallback_timeout].value}
                  class="input input-bordered w-full"
                  min="100"
                  max="30000"
                />
              </div>
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Retries</span>
                </label>
                <input
                  type="number"
                  name="view[fallback_retries]"
                  value={@view_form[:fallback_retries].value}
                  class="input input-bordered w-full"
                  min="0"
                  max="5"
                />
              </div>
            </div>

            <div class="divider"></div>

            <div class="flex justify-end gap-2">
              <button type="button" class="btn btn-ghost" phx-click="cancel">Cancel</button>
              <button
                type="submit"
                class={["btn btn-primary", map_size(@form_errors) > 0 && "btn-disabled"]}
                disabled={map_size(@form_errors) > 0}
                phx-disable-with="Creating..."
              >
                Create View
              </button>
            </div>
          </.form>
        </.card>
      <% :edit -> %>
        <!-- Edit View Form -->
        <.card title={"Edit View: #{@editing_view}"}>
          <.form
            for={@view_form}
            phx-submit="save_view"
            phx-change="validate_view"
            phx-debounce="blur"
            class="space-y-4"
          >
            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">View Name</span>
              </label>
              <input
                type="text"
                name="view[name]"
                value={@view_form[:name].value}
                class="input input-bordered w-full bg-base-200"
                disabled
              />
              <label class="label">
                <span class="label-text-alt text-base-content/60">Name cannot be changed</span>
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Priority</span>
              </label>
              <%= if @is_default_view do %>
                <input
                  type="text"
                  name="view[priority]"
                  value="∞ (catch-all)"
                  class="input input-bordered w-full bg-base-200 font-mono"
                  disabled
                />
                <label class="label">
                  <span class="label-text-alt text-base-content/60">
                    Default view priority cannot be changed
                  </span>
                </label>
              <% else %>
                <input
                  type="number"
                  name="view[priority]"
                  value={@view_form[:priority].value}
                  class="input input-bordered w-full"
                  min="0"
                  required
                />
                <label class="label">
                  <span class="label-text-alt">Lower value = higher priority</span>
                </label>
              <% end %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                  <input
                    type="checkbox"
                    name="view[recursion_enabled]"
                    value="true"
                    checked={@view_form[:recursion_enabled].value == "true"}
                    class="checkbox checkbox-primary"
                  />
                  <div>
                    <span class="label-text font-semibold">Enable Recursion</span>
                    <p class="text-xs text-base-content/60">Allow recursive queries</p>
                  </div>
                </label>
              </div>

              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                  <input
                    type="checkbox"
                    name="view[ecs_enabled]"
                    value="true"
                    checked={@view_form[:ecs_enabled].value == "true"}
                    class="checkbox checkbox-info"
                  />
                  <div>
                    <span class="label-text font-semibold">Enable ECS</span>
                    <p class="text-xs text-base-content/60">EDNS Client Subnet support</p>
                  </div>
                </label>
              </div>
            </div>
            
<!-- ACL Configuration (hidden for default view) -->
            <%= unless @is_default_view do %>
              <div class="divider">Access Control</div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">ACL Type</span>
                </label>
                <select
                  name="view[acl_type]"
                  class="select select-bordered w-full"
                  phx-change="acl_type_changed"
                >
                  <option value="any" selected={@view_form[:acl_type].value == "any"}>
                    Allow All (any)
                  </option>
                  <option value="none" selected={@view_form[:acl_type].value == "none"}>
                    Deny All (none)
                  </option>
                  <option value="localhost" selected={@view_form[:acl_type].value == "localhost"}>
                    Localhost Only
                  </option>
                  <option value="localnets" selected={@view_form[:acl_type].value == "localnets"}>
                    Local Networks (RFC 1918)
                  </option>
                  <option value="geo" selected={@view_form[:acl_type].value == "geo"}>
                    Geographic (by country)
                  </option>
                </select>
                <label class="label">
                  <span class="label-text-alt">Control which clients can use this view</span>
                </label>
              </div>
              
<!-- Geo Country Picker for edit view -->
              <%= if @view_form[:acl_type].value == "geo" do %>
                <div class="form-control">
                  <label class="label">
                    <span class="label-text font-semibold">Allowed Countries</span>
                    <span class="label-text-alt">{length(@selected_countries)} selected</span>
                  </label>
                  
<!-- Selected countries badges -->
                  <%= if @selected_countries != [] do %>
                    <div class="flex flex-wrap gap-1 mb-2">
                      <%= for code <- @selected_countries do %>
                        <% country = Enum.find(@countries, fn c -> c.code == code end) %>
                        <button
                          type="button"
                          class="badge badge-secondary gap-1"
                          phx-click="toggle_country"
                          phx-value-code={code}
                        >
                          {code}
                          <%= if country do %>
                            - {country.name}
                          <% end %>
                          <svg
                            class="w-3 h-3"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M6 18L18 6M6 6l12 12"
                            />
                          </svg>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                  
<!-- Search input -->
                  <div class="relative mb-2">
                    <input
                      type="text"
                      class="input input-bordered input-sm w-full pr-8"
                      placeholder="Search countries..."
                      aria-label="Search countries"
                      value={@country_search}
                      phx-keyup="search_country"
                      phx-debounce="300"
                      phx-value-search={@country_search}
                      name="search"
                    />
                    <%= if @country_search != "" do %>
                      <button
                        type="button"
                        class="absolute right-2 top-1/2 -translate-y-1/2 text-base-content/50 hover:text-base-content"
                        phx-click="clear_country_search"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"
                          />
                        </svg>
                      </button>
                    <% end %>
                  </div>
                  
<!-- Country grid -->
                  <div class="border border-base-300 rounded-lg p-2 max-h-48 overflow-y-auto">
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-1">
                      <%= for country <- filtered_countries(@countries, @country_search) do %>
                        <label class="label cursor-pointer justify-start gap-2 p-1 hover:bg-base-200 rounded">
                          <input
                            type="checkbox"
                            class="checkbox checkbox-xs checkbox-secondary"
                            checked={country.code in @selected_countries}
                            phx-click="toggle_country"
                            phx-value-code={country.code}
                          />
                          <span class="label-text text-sm">
                            <span class="font-mono text-xs text-base-content/70">
                              {country.code}
                            </span>
                            {country.name}
                          </span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="divider">Access Control</div>
              <div class="alert alert-info">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span>The default view always accepts all clients (ACL: any)</span>
              </div>
            <% end %>
            
<!-- Fallback Forwarders -->
            <div class="divider">Fallback Forwarding</div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Fallback DNS Servers</span>
              </label>
              <textarea
                name="view[fallback_forwarders]"
                class={"textarea textarea-bordered h-20 font-mono text-sm #{if @form_errors[:fallback_forwarders], do: "textarea-error"}"}
                placeholder="8.8.8.8&#10;8.8.4.4&#10;1.1.1.1:53"
              >{@view_form[:fallback_forwarders].value}</textarea>
              <label class="label">
                <%= if @form_errors[:fallback_forwarders] do %>
                  <span class="label-text-alt text-error">
                    {@form_errors[:fallback_forwarders]}
                  </span>
                <% else %>
                  <span class="label-text-alt">
                    Upstream servers used when zone resolution fails (one per line, optional :port)
                  </span>
                <% end %>
              </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Timeout (ms)</span>
                </label>
                <input
                  type="number"
                  name="view[fallback_timeout]"
                  value={@view_form[:fallback_timeout].value}
                  class="input input-bordered w-full"
                  min="100"
                  max="30000"
                />
              </div>
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Retries</span>
                </label>
                <input
                  type="number"
                  name="view[fallback_retries]"
                  value={@view_form[:fallback_retries].value}
                  class="input input-bordered w-full"
                  min="0"
                  max="5"
                />
              </div>
            </div>

            <div class="divider"></div>

            <div class="flex justify-end gap-2">
              <button type="button" class="btn btn-ghost" phx-click="cancel">Cancel</button>
              <button
                type="submit"
                class={["btn btn-primary", map_size(@form_errors) > 0 && "btn-disabled"]}
                disabled={map_size(@form_errors) > 0}
                phx-disable-with="Saving..."
              >
                Save Changes
              </button>
            </div>
          </.form>
        </.card>
    <% end %>
  </div>
  
<!-- Delete Confirmation Modal -->
  <%= if @delete_confirm do %>
    <.modal id="delete-modal" title="Delete View" show on_cancel={JS.push("close_modal")}>
      <div class="py-4">
        <p class="text-base-content/80">
          Are you sure you want to delete the view <strong class="font-mono">{@delete_confirm}</strong>?
        </p>
        <p class="mt-2 text-sm text-warning">
          This action cannot be undone. All zones associated with this view will be orphaned.
        </p>
      </div>
      <div class="flex justify-end gap-2 mt-4">
        <button type="button" class="btn btn-ghost" phx-click="close_modal">Cancel</button>
        <button
          type="button"
          class="btn btn-error"
          phx-click="delete_view"
          phx-disable-with="Deleting..."
        >
          Delete View
        </button>
      </div>
    </.modal>
  <% end %>
</Layouts.app>
