<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">DHCPv6 Server</h1>
        <p class="mt-2 text-on-surface-variant">
          Monitor IPv6 leases, prefix delegations, and client activity
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.status_indicator
          status={if @status.running, do: "running", else: "stopped"}
          label={if @status.running, do: "Running", else: "Stopped"}
          pulse
        />
        <button class="btn btn-ghost btn-circle btn-sm" aria-label="Refresh">
          <.dm_mdi name="refresh" class="h-5 w-5" />
        </button>
      </div>
    </div>
    <!-- Global Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Total Leases</div>
              <div class="text-2xl font-bold text-primary">{@stats.total_leases}</div>
              <div class="text-xs text-on-surface-variant">All time allocations</div>
            </div>
            <.dm_mdi name="file-document-outline" class="h-12 w-12 text-primary" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Active Leases</div>
              <div class="text-2xl font-bold text-success">{@stats.active_leases}</div>
              <div class="text-xs text-on-surface-variant">Currently allocated</div>
            </div>
            <.dm_mdi name="check-circle-outline" class="h-12 w-12 text-success" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Expired</div>
              <div class="text-2xl font-bold text-warning">{@stats.expired_leases}</div>
              <div class="text-xs text-on-surface-variant">Need renewal</div>
            </div>
            <.dm_mdi name="clock-outline" class="h-12 w-12 text-warning" />
          </div>
        </div>
      </div>

      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm text-on-surface-variant">Pools</div>
              <div class="text-2xl font-bold text-info">{length(@pools)}</div>
              <div class="text-xs text-on-surface-variant">Configured</div>
            </div>
            <.dm_mdi name="server-network" class="h-12 w-12 text-info" />
          </div>
        </div>
      </div>
    </div>
    <!-- Last Event (Real-time) -->
    <%= if @last_event do %>
      <div class="alert alert-success shadow-lg">
        <div class="flex items-center gap-2 w-full">
          <.dm_mdi name="check-circle-outline" class="h-6 w-6 shrink-0" />
          <div class="flex-1">
            <strong>Lease Allocated:</strong>
            DUID {format_duid(@last_event.metadata.duid)} → IPv6 {format_ipv6(
              @last_event.metadata.ip
            )}
          </div>
          <span class="text-xs opacity-70">
            {Calendar.strftime(@last_event.time, "%H:%M:%S")}
          </span>
        </div>
      </div>
    <% end %>
    <!-- IA Type Distribution -->
    <%= if map_size(@stats.by_ia_type) > 0 do %>
      <.card title="Lease Distribution by IA Type">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <%= for {ia_type, count} <- @stats.by_ia_type do %>
            <div class="text-center p-4 bg-surface-container rounded-lg">
              <div class={"text-3xl font-bold " <> ia_type_text_color(ia_type)}>
                {count}
              </div>
              <div class="text-sm text-on-surface-variant mt-1">
                {format_ia_type_verbose(ia_type)}
              </div>
            </div>
          <% end %>
        </div>
      </.card>
    <% end %>
    <!-- Address Pools -->
    <div class="space-y-4">
      <h2 class="text-2xl font-bold">Address & Prefix Pools</h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <%= for {pool_name, pool_stats} <- @pool_stats do %>
          <.card class="hover:shadow-2xl transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="card-title text-xl">
                  {pool_name}
                  <.badge color={utilization_color(pool_stats.utilization_percent)} size="lg">
                    {Float.round(pool_stats.utilization_percent, 1)}%
                  </.badge>
                </h3>
                <p class="text-sm text-on-surface-variant mt-2">
                  {pool_stats.allocated_count} of {pool_stats.total_count} allocated
                </p>
              </div>
            </div>

            <div class="divider my-2"></div>
            <!-- Pool Statistics -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm text-on-surface-variant">Total</span>
                <span class="font-mono font-semibold">{pool_stats.total_count}</span>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-sm text-on-surface-variant">Allocated</span>
                <span class="font-mono font-semibold text-success">
                  {pool_stats.allocated_count}
                </span>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-sm text-on-surface-variant">Available</span>
                <span class="font-mono font-semibold text-info">
                  {pool_stats.available_count}
                </span>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-sm text-on-surface-variant">Static Reservations</span>
                <span class="font-mono font-semibold">{pool_stats.static_reservations}</span>
              </div>
            </div>
            <!-- Utilization Bar -->
            <div class="mt-4">
              <.progress
                value={pool_stats.utilization_percent}
                color={utilization_color(pool_stats.utilization_percent)}
              />
            </div>
            <!-- Lease States -->
            <%= if map_size(pool_stats.leases_by_state) > 0 do %>
              <div class="divider my-2"></div>
              <div class="flex flex-wrap gap-2">
                <%= for {state, count} <- pool_stats.leases_by_state do %>
                  <.badge color={lease_state_color(state)} size="sm">
                    {state}: {count}
                  </.badge>
                <% end %>
              </div>
            <% end %>

            <:actions>
              <.link navigate={~p"/dhcpv6/pools/#{pool_name}"} class="btn btn-sm btn-ghost gap-2">
                <.dm_mdi name="eye" class="h-4 w-4" /> View Details
              </.link>
            </:actions>
          </.card>
        <% end %>
      </div>
    </div>
    <!-- Lease State Distribution -->
    <%= if map_size(@stats.by_state) > 0 do %>
      <.card title="Lease Distribution by State">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          <%= for {state, count} <- @stats.by_state do %>
            <div class="text-center p-4 bg-surface-container rounded-lg">
              <div class={"text-3xl font-bold " <> lease_state_text_color(state)}>
                {count}
              </div>
              <div class="text-sm text-on-surface-variant mt-1 capitalize">
                {state}
              </div>
            </div>
          <% end %>
        </div>
      </.card>
    <% end %>
  </div>
</Layouts.app>
