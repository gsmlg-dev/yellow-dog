<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <.service_alert :if={not @service_running} service="DHCPv6" />

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold">DHCPv6 Leases</h1>
        <p class="mt-2 text-on-surface-variant">
          View and manage all DHCPv6 lease allocations
        </p>
      </div>
      <div class="flex gap-2">
        <.dm_btn
          variant="outline"
          size="sm"
          phx-click="export_csv"
          id="export-csv"
          phx-hook="CsvDownload"
          aria-label="Export CSV"
        >
          <.dm_mdi name="download" class="h-5 w-5" /> Export CSV
        </.dm_btn>
        <.link navigate={~p"/server/dhcpv6"} class="btn btn-ghost btn-sm">
          <.dm_mdi name="arrow-left" class="h-4 w-4" /> Back to Overview
        </.link>
      </div>
    </div>
    <!-- Summary Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Total Leases</div>
          <div class="text-xl font-bold">{length(@leases)}</div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Active</div>
          <div class="text-xl font-bold text-success">
            {Enum.count(@leases, fn l -> l.state == :active end)}
          </div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Expired</div>
          <div class="text-xl font-bold text-warning">
            {Enum.count(@leases, fn l -> l.state == :expired end)}
          </div>
        </div>
      </div>
    </div>
    <!-- Search and Filters -->
    <.card>
      <div class="flex flex-col md:flex-row gap-4">
        <!-- Search -->
        <div class="flex-1">
          <label class="input flex items-center gap-2">
            <.dm_mdi name="magnify" class="h-5 w-5 opacity-70" />
            <input
              type="text"
              class="grow"
              placeholder="Search by DUID, IPv6, or hostname"
              aria-label="Search DHCPv6 leases"
              value={@search_query}
              phx-change="search"
              phx-debounce="300"
              name="search"
            />
          </label>
        </div>
        <!-- State Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_state"
            aria-label="Filter by lease state"
            name="state"
            value={@filter_state}
          >
            <option value="all">All States</option>
            <option value="active">Active</option>
            <option value="offered">Offered</option>
            <option value="released">Released</option>
            <option value="expired">Expired</option>
            <option value="declined">Declined</option>
          </select>
        </div>
        <!-- IA Type Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_ia_type"
            aria-label="Filter by IA type"
            name="ia_type"
            value={@filter_ia_type}
          >
            <option value="all">All IA Types</option>
            <option value="ia_na">IA_NA (Address)</option>
            <option value="ia_ta">IA_TA (Temporary)</option>
            <option value="ia_pd">IA_PD (Prefix)</option>
          </select>
        </div>
        <!-- Pool Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_pool"
            aria-label="Filter by pool"
            name="pool"
            value={@filter_pool}
          >
            <option value="all">All Pools</option>
            <%= for pool <- @pools do %>
              <option value={pool}>{pool}</option>
            <% end %>
          </select>
        </div>
      </div>
    </.card>
    <!-- Leases Table -->
    <.card>
      <div class="overflow-x-auto">
        <table class="table table-striped">
          <thead>
            <tr>
              <th scope="col">DUID</th>
              <th scope="col">IAID</th>
              <th scope="col">IPv6 / Prefix</th>
              <th scope="col">IA Type</th>
              <th scope="col">Pool</th>
              <th scope="col">State</th>
              <th scope="col">Expires</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= if Enum.empty?(@leases) do %>
              <tr>
                <td colspan="8" class="text-center py-8 text-on-surface-variant">
                  No leases found matching your filters
                </td>
              </tr>
            <% else %>
              <%= for lease <- @leases do %>
                <tr>
                  <td>
                    <code class="text-xs">{format_duid(lease.duid)}</code>
                  </td>
                  <td>{lease.iaid}</td>
                  <td>
                    <code class="text-xs">
                      <%= if lease.ia_type == :ia_pd do %>
                        {format_prefix(lease.delegated_prefix)}
                      <% else %>
                        {format_ipv6(lease.ip_address)}
                      <% end %>
                    </code>
                  </td>
                  <td>
                    <.badge color={ia_type_color(lease.ia_type)} size="sm">
                      {format_ia_type(lease.ia_type)}
                    </.badge>
                  </td>
                  <td>{lease.pool_name}</td>
                  <td>
                    <.badge color={lease_state_color(lease.state)} size="sm">
                      {lease.state}
                    </.badge>
                  </td>
                  <td class="text-xs">
                    <%= if lease.expires_at do %>
                      {format_expires(lease.expires_at)}
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                  <td>
                    <%= if lease.state == :active do %>
                      <.dm_btn
                        variant="error"
                        size="xs"
                        phx-click="release_lease"
                        phx-value-duid={format_duid(lease.duid)}
                        phx-value-iaid={lease.iaid}
                        phx-disable-with="Releasing..."
                        data-confirm="Are you sure you want to release this lease?"
                      >
                        Release
                      </.dm_btn>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </.card>
  </div>
</Layouts.app>
