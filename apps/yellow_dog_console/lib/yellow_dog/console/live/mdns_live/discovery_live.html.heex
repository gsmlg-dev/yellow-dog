<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <.service_alert :if={not @service_running} service="mDNS" />
    
<!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">Network Discovery</h1>
        <p class="mt-2 text-base-content/60">
          Browse mDNS services discovered on your local network
        </p>
      </div>
      <button
        phx-click="export_csv"
        id="export-csv"
        phx-hook="CsvDownload"
        class="btn btn-outline btn-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          />
        </svg>
        Export CSV
      </button>
    </div>
    <!-- Search and Filter -->
    <div class="flex items-center gap-4">
      <div class="flex-1">
        <input
          type="text"
          phx-change="search"
          phx-debounce="300"
          name="search"
          value={@search}
          placeholder="Search services by name or type..."
          aria-label="Search discovered services"
          class="input input-bordered w-full"
        />
      </div>
      <select
        phx-change="filter_by_type"
        aria-label="Filter by service type"
        name="type"
        class="select select-bordered"
      >
        <option value="all">All Types</option>
        <option :for={type <- get_service_types(@services)} value={type}>
          {type}
        </option>
      </select>
    </div>
    <!-- Statistics Bar -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Total Services</p>
        <p class="mt-1 text-2xl font-semibold">{length(@services)}</p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Service Types</p>
        <p class="mt-1 text-2xl font-semibold">
          {length(get_service_types(@services))}
        </p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Active Hosts</p>
        <p class="mt-1 text-2xl font-semibold">{count_unique_hosts(@services)}</p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Last Updated</p>
        <p class="mt-1 text-sm font-semibold">
          {format_time(get_most_recent_update(@services))}
        </p>
      </div>
    </div>
    <!-- Services Grid -->
    <%= if Enum.empty?(@services) do %>
      <div class="card bg-base-100 shadow-sm p-12 text-center">
        <svg
          class="mx-auto h-12 w-12 text-base-content/30"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <h3 class="mt-2 text-sm font-medium">No services discovered</h3>
        <p class="mt-1 text-sm text-base-content/50">
          Waiting for mDNS services to appear on your local network...
        </p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div
          :for={service <- @services}
          class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
          phx-click="view_details"
          phx-keydown="view_details"
          phx-key="Enter"
          phx-value-id={service.id}
          role="button"
          tabindex="0"
          aria-label={"View details for #{service.name}"}
        >
          <div class="card-body p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="text-lg font-medium truncate">{service.name}</h3>
                <p class="mt-1 text-sm text-base-content/60">{service.type}</p>
              </div>
              <div class="ml-2 flex-shrink-0">
                <span class="badge badge-success badge-sm">Active</span>
              </div>
            </div>

            <div class="mt-4 space-y-2">
              <%= if service.host do %>
                <div class="flex items-center text-sm">
                  <svg
                    class="w-4 h-4 mr-2 text-base-content/40"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                    />
                  </svg>
                  <span class="text-base-content/70 truncate">{service.host}</span>
                </div>
              <% end %>

              <%= if service.port do %>
                <div class="flex items-center text-sm">
                  <svg
                    class="w-4 h-4 mr-2 text-base-content/40"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  </svg>
                  <span class="text-base-content/70">Port {service.port}</span>
                </div>
              <% end %>

              <%= if service.addresses && length(service.addresses) > 0 do %>
                <div class="flex items-center text-sm">
                  <svg
                    class="w-4 h-4 mr-2 text-base-content/40"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  <span class="text-base-content/70 truncate">{hd(service.addresses)}</span>
                </div>
              <% end %>
            </div>

            <%= if service.txt && map_size(service.txt) > 0 do %>
              <div class="mt-4">
                <div class="flex flex-wrap gap-1">
                  <span
                    :for={{_key, _value} <- Enum.take(service.txt, 3)}
                    class="badge badge-ghost badge-sm"
                  >
                    TXT
                  </span>
                  <%= if map_size(service.txt) > 3 do %>
                    <span class="badge badge-ghost badge-sm">
                      +{map_size(service.txt) - 3}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="mt-4 text-xs text-base-content/40">
              Last seen {format_time_ago(service.last_seen)}
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <!-- Service Details Modal -->
    <%= if @selected_service do %>
      <div
        class="modal modal-open"
        role="dialog"
        aria-modal="true"
        aria-label="Service details"
        phx-window-keydown="close_details"
        phx-key="Escape"
      >
        <div
          class="modal-backdrop"
          phx-click="close_details"
          aria-hidden="true"
        >
        </div>
        <div class="modal-box max-w-3xl">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold">{@selected_service.name}</h3>
            <button
              type="button"
              phx-click="close_details"
              class="btn btn-sm btn-circle btn-ghost"
              aria-label="Close"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>

          <div class="space-y-6">
            <!-- Basic Information -->
            <div>
              <h4 class="text-sm font-medium mb-4">Basic Information</h4>
              <dl class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-sm text-base-content/60">Service Type</dt>
                  <dd class="mt-1 text-sm font-medium">
                    {@selected_service.type}
                  </dd>
                </div>
                <div>
                  <dt class="text-sm text-base-content/60">Port</dt>
                  <dd class="mt-1 text-sm font-medium">
                    {@selected_service.port}
                  </dd>
                </div>
                <div>
                  <dt class="text-sm text-base-content/60">Hostname</dt>
                  <dd class="mt-1 text-sm font-medium">
                    {@selected_service.host}
                  </dd>
                </div>
                <div>
                  <dt class="text-sm text-base-content/60">Last Seen</dt>
                  <dd class="mt-1 text-sm font-medium">
                    {format_time(@selected_service.last_seen)}
                  </dd>
                </div>
              </dl>
            </div>
            <!-- IP Addresses -->
            <%= if @selected_service.addresses && length(@selected_service.addresses) > 0 do %>
              <div>
                <h4 class="text-sm font-medium mb-4">IP Addresses</h4>
                <div class="flex flex-wrap gap-2">
                  <span
                    :for={addr <- @selected_service.addresses}
                    class="badge badge-info badge-lg"
                  >
                    {addr}
                  </span>
                </div>
              </div>
            <% end %>
            <!-- TXT Records -->
            <%= if @selected_service.txt && map_size(@selected_service.txt) > 0 do %>
              <div>
                <h4 class="text-sm font-medium mb-4">TXT Records</h4>
                <div class="bg-base-200 rounded-lg p-4">
                  <dl class="space-y-2">
                    <div
                      :for={{key, value} <- @selected_service.txt}
                      class="flex justify-between"
                    >
                      <dt class="text-sm font-medium text-base-content/70">{key}</dt>
                      <dd class="text-sm">{value}</dd>
                    </div>
                  </dl>
                </div>
              </div>
            <% end %>
          </div>

          <div class="modal-action">
            <button
              type="button"
              phx-click="close_details"
              class="btn"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
