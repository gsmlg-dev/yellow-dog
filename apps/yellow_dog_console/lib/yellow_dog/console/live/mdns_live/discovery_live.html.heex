<Layouts.app flash={@flash} current_path={@current_path}>
  <div id="mdns-discovery" class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">mDNS Discovery</h1>
        <p class="mt-2 text-on-surface-variant">
          {@selected_server.name || @selected_server.id} · {@selected_server.id}
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.badge color={if @service_online?, do: "success", else: "ghost"} size="sm">
          {if @service_online?, do: "Online", else: "Offline"}
        </.badge>
        <button
          type="button"
          class="btn btn-ghost btn-circle"
          phx-click="refresh"
          aria-label="Refresh"
        >
          <.dm_mdi name="refresh" class="h-6 w-6" />
        </button>
      </div>
    </div>

    <div :if={not @service_online?} class="alert alert-warning" id="mdns-discovery-offline">
      <.dm_mdi name="cloud-off-outline" class="h-5 w-5" />
      <span>
        Offline cached snapshot
        <%= if @cached_observed_at do %>
          observed {Calendar.strftime(@cached_observed_at, "%Y-%m-%d %H:%M:%S UTC")}
        <% end %>.
      </span>
    </div>

    <div :if={@management_error} class="alert alert-error" id="mdns-discovery-error">
      <.dm_mdi name="alert-circle-outline" class="h-5 w-5" />
      <span>{@management_error.message}</span>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <input
        type="search"
        name="search"
        value={@search}
        placeholder="Search by name or address"
        aria-label="Search discovered services"
        class="input w-full"
        phx-change="search"
        phx-debounce="300"
      />
      <select
        name="type"
        class="select"
        aria-label="Filter by service type"
        phx-change="filter_by_type"
      >
        <option value="all" selected={@type_filter == "all"}>All types</option>
        <option
          :for={type <- service_types(@services)}
          value={type}
          selected={@type_filter == type}
        >
          {type}
        </option>
      </select>
    </div>

    <.card>
      <div
        :if={filtered_services(@services, @search, @type_filter) == []}
        class="py-10 text-center text-on-surface-variant"
      >
        No discovered services match this filter.
      </div>
      <div
        :if={filtered_services(@services, @search, @type_filter) != []}
        class="overflow-x-auto"
      >
        <table class="table table-striped" id="mdns-discovery-table">
          <thead>
            <tr>
              <th>Name</th><th>Type</th><th>Address</th><th></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={service <- filtered_services(@services, @search, @type_filter)}>
              <td class="font-medium">{service["name"]}</td>
              <td class="font-mono text-sm">{service["service_type"]}</td>
              <td class="font-mono text-sm">{service["address"] || "Unavailable"}</td>
              <td>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs"
                  phx-click="view_details"
                  phx-value-name={service["name"]}
                >
                  Details
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </.card>

    <dialog
      :if={@selected_service}
      id="mdns-discovery-details"
      class="dialog-backdrop dialog-backdrop-show"
      open
      phx-window-keydown="close_details"
      phx-key="Escape"
    >
      <div class="dialog dialog-md">
        <h2 class="mb-4 text-2xl font-bold">{@selected_service["name"]}</h2>
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-sm text-on-surface-variant">Service type</dt>
            <dd class="font-mono">{@selected_service["service_type"]}</dd>
          </div>
          <div>
            <dt class="text-sm text-on-surface-variant">Address</dt>
            <dd class="font-mono">{@selected_service["address"] || "Unavailable"}</dd>
          </div>
        </dl>
        <div class="dialog-actions">
          <button type="button" class="btn btn-ghost" phx-click="close_details">Close</button>
        </div>
      </div>
    </dialog>
  </div>
</Layouts.app>
