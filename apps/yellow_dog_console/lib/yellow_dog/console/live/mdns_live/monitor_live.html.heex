<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <.service_alert :if={not @service_running} service="mDNS" />
    
<!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold">Network Monitor</h1>
        <p class="mt-2 text-base-content/60">Real-time mDNS query and response monitoring</p>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          phx-click="toggle_auto_refresh"
          class={[
            "btn btn-sm",
            if(@auto_refresh, do: "btn-success", else: "btn-ghost")
          ]}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <%= if @auto_refresh do %>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            <% else %>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            <% end %>
          </svg>
          {if @auto_refresh, do: "Auto-Refresh On", else: "Auto-Refresh Off"}
        </button>
        <button
          type="button"
          phx-click="clear_cache"
          data-confirm="Are you sure you want to clear all cached data?"
          class="btn btn-sm btn-error"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
          Clear Cache
        </button>
        <button
          type="button"
          phx-click="export_csv"
          id="export-csv"
          phx-hook="CsvDownload"
          class="btn btn-sm btn-ghost"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          Export CSV
        </button>
      </div>
    </div>
    <!-- Network Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Total Queries</p>
        <p class="mt-1 text-2xl font-semibold">{@stats.total_queries}</p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Total Responses</p>
        <p class="mt-1 text-2xl font-semibold">{@stats.total_responses}</p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Queries/Min</p>
        <p class="mt-1 text-2xl font-semibold text-info">
          {Float.round(@stats.queries_per_minute, 1)}
        </p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Unique Hosts</p>
        <p class="mt-1 text-2xl font-semibold text-secondary">{@stats.unique_hosts}</p>
      </div>
      <div class="card bg-base-100 shadow-sm p-4">
        <p class="text-sm text-base-content/60">Active Services</p>
        <p class="mt-1 text-2xl font-semibold text-success">{@stats.active_services}</p>
      </div>
    </div>
    <!-- Most Queried Services -->
    <%= if @stats.most_queried_services && length(@stats.most_queried_services) > 0 do %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">Most Queried Services</h2>
          <div class="space-y-3">
            <div
              :for={service <- Enum.take(@stats.most_queried_services, 5)}
              class="flex items-center justify-between"
            >
              <div class="flex-1">
                <p class="text-sm font-medium">{elem(service, 0)}</p>
                <progress
                  class="progress progress-primary w-full"
                  value={calculate_percentage(elem(service, 1), @stats.most_queried_services)}
                  max="100"
                >
                </progress>
              </div>
              <div class="ml-4">
                <span class="text-sm font-semibold">{elem(service, 1)}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <!-- Query Log -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-0">
        <div class="flex items-center justify-between gap-4 px-6 py-4">
          <h2 class="card-title shrink-0">Recent Queries</h2>
          <input
            type="text"
            placeholder="Search queries..."
            aria-label="Search mDNS queries"
            value={@search}
            phx-change="search"
            phx-debounce="300"
            name="search"
            class="input input-bordered input-sm flex-1 max-w-xs"
          />
          <select
            phx-change="set_limit"
            name="limit"
            class="select select-bordered select-sm"
            aria-label="Results per page"
          >
            <option value="50" selected={@limit == 50}>50 queries</option>
            <option value="100" selected={@limit == 100}>100 queries</option>
            <option value="200" selected={@limit == 200}>200 queries</option>
            <option value="500" selected={@limit == 500}>500 queries</option>
          </select>
        </div>
        <div class="overflow-x-auto">
          <%= if Enum.empty?(@queries) do %>
            <div class="p-12 text-center">
              <svg
                class="mx-auto h-12 w-12 text-base-content/30"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                />
              </svg>
              <h3 class="mt-2 text-sm font-medium">No queries logged yet</h3>
              <p class="mt-1 text-sm text-base-content/50">
                mDNS queries will appear here as they are detected on the network
              </p>
            </div>
          <% else %>
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th scope="col">Time</th>
                  <th scope="col">Source IP</th>
                  <th scope="col">Query Name</th>
                  <th scope="col">Type</th>
                  <th scope="col">Class</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={query <- filtered_queries(@queries, @search)}>
                  <td class="text-base-content/60">
                    {format_timestamp(query.timestamp)}
                  </td>
                  <td class="font-medium">
                    {format_ip(query.source_ip)}
                  </td>
                  <td>
                    {query.name}
                  </td>
                  <td>
                    <span class="badge badge-info badge-sm">
                      {query.type}
                    </span>
                  </td>
                  <td class="text-base-content/60">
                    {query.class}
                  </td>
                </tr>
              </tbody>
            </table>
          <% end %>
        </div>
        <%= if @search != "" do %>
          <div class="px-6 py-2 text-sm text-base-content/50">
            Showing {length(filtered_queries(@queries, @search))} of {length(@queries)} queries
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
