<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-4xl font-bold">{@pool_name}</h1>
          <.badge color={utilization_color(@pool_stats.utilization_percent)} size="lg">
            {Float.round(@pool_stats.utilization_percent, 1)}% utilized
          </.badge>
        </div>
        <p class="mt-2 text-on-surface-variant">
          Detailed pool configuration and lease management
        </p>
      </div>
      <.link navigate={~p"/server/dhcpv4"} class="btn btn-ghost">
        <.dm_mdi name="arrow-left" class="h-4 w-4" /> Back to Overview
      </.link>
    </div>
    <!-- Pool Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Total Addresses</div>
          <div class="text-xl font-bold">{@pool_stats.total_addresses}</div>
          <div class="text-xs text-on-surface-variant">In pool range</div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Allocated</div>
          <div class="text-xl font-bold text-success">
            {@pool_stats.allocated_addresses}
          </div>
          <div class="text-xs text-on-surface-variant">Currently in use</div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Available</div>
          <div class="text-xl font-bold text-info">{@pool_stats.available_addresses}</div>
          <div class="text-xs text-on-surface-variant">Ready to allocate</div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Static Reservations</div>
          <div class="text-xl font-bold">{@pool_stats.static_reservations}</div>
          <div class="text-xs text-on-surface-variant">Reserved IPs</div>
        </div>
      </div>
    </div>
    <!-- Utilization Progress -->
    <.card title="Pool Utilization">
      <div class="space-y-4">
        <.progress
          value={@pool_stats.utilization_percent}
          color={utilization_color(@pool_stats.utilization_percent)}
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div>
            <span class="text-on-surface-variant">Allocated:</span>
            <span class="font-semibold ml-2">
              {@pool_stats.allocated_addresses} / {@pool_stats.total_addresses}
            </span>
          </div>
          <div>
            <span class="text-on-surface-variant">Available:</span>
            <span class="font-semibold ml-2">{@pool_stats.available_addresses}</span>
          </div>
          <div>
            <span class="text-on-surface-variant">Utilization:</span>
            <span class="font-semibold ml-2">
              {Float.round(@pool_stats.utilization_percent, 2)}%
            </span>
          </div>
        </div>
      </div>
    </.card>
    <!-- Pool Configuration -->
    <.card title="Pool Configuration">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-3">
          <div>
            <div class="text-sm text-on-surface-variant">Pool Name</div>
            <div class="font-mono font-semibold">{@pool_config.name}</div>
          </div>

          <div>
            <div class="text-sm text-on-surface-variant">IP Range</div>
            <div class="font-mono font-semibold">
              {format_ip(@pool_config.range_start)} - {format_ip(@pool_config.range_end)}
            </div>
          </div>

          <div>
            <div class="text-sm text-on-surface-variant">Subnet Mask</div>
            <div class="font-mono font-semibold">{format_ip(@pool_config.subnet_mask)}</div>
          </div>

          <div>
            <div class="text-sm text-on-surface-variant">Gateway</div>
            <div class="font-mono font-semibold">
              {if @pool_config.gateway,
                do: format_ip(@pool_config.gateway),
                else: "Not configured"}
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div>
            <div class="text-sm text-on-surface-variant">DNS Servers</div>
            <div class="font-mono font-semibold">
              <%= if @pool_config.dns_servers && @pool_config.dns_servers != [] do %>
                {Enum.map_join(@pool_config.dns_servers, ", ", &format_ip/1)}
              <% else %>
                Not configured
              <% end %>
            </div>
          </div>

          <div>
            <div class="text-sm text-on-surface-variant">Domain Name</div>
            <div class="font-mono font-semibold">
              {@pool_config.domain_name || "Not configured"}
            </div>
          </div>

          <div>
            <div class="text-sm text-on-surface-variant">Lease Time</div>
            <div class="font-mono font-semibold">
              {format_duration(@pool_config.lease_time)}
            </div>
          </div>

          <%= if @pool_config.excluded_ranges && @pool_config.excluded_ranges != [] do %>
            <div>
              <div class="text-sm text-on-surface-variant">Excluded Ranges</div>
              <div class="font-mono text-sm">
                <%= for {range_start, range_end} <- @pool_config.excluded_ranges do %>
                  <div>{format_ip(range_start)} - {format_ip(range_end)}</div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </.card>
    <!-- Lease State Distribution -->
    <%= if map_size(@pool_stats.leases_by_state) > 0 do %>
      <.card title="Lease Distribution by State">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          <%= for {state, count} <- @pool_stats.leases_by_state do %>
            <div class="text-center p-4 bg-surface-container rounded-lg">
              <div class={lease_state_text_color(state) <> " text-3xl font-bold"}>
                {count}
              </div>
              <div class="text-sm text-on-surface-variant mt-1 capitalize">
                {state}
              </div>
            </div>
          <% end %>
        </div>
      </.card>
    <% end %>
    <!-- Static Reservations -->
    <%= if @static_reservations && @static_reservations != [] do %>
      <.card title="Static Reservations">
        <div class="overflow-x-auto">
          <table class="table table-striped">
            <thead>
              <tr>
                <th scope="col">MAC Address</th>
                <th scope="col">Reserved IP</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              <%= for reservation <- @static_reservations do %>
                <tr>
                  <td class="font-mono text-sm">{format_mac(reservation.mac_address)}</td>
                  <td class="font-mono text-sm font-semibold">
                    {format_ip(reservation.ip_address)}
                  </td>
                  <td class="text-sm">
                    {reservation.description || "-"}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </.card>
    <% end %>
    <!-- Search and Filters -->
    <.card>
      <div class="flex flex-col md:flex-row gap-4">
        <!-- Search -->
        <div class="flex-1">
          <label class="input flex items-center gap-2">
            <.dm_mdi name="magnify" class="h-5 w-5 opacity-70" />
            <input
              type="text"
              class="grow"
              placeholder="Search by MAC, IP, or hostname"
              aria-label="Search DHCPv4 pool leases"
              value={@search_query}
              phx-change="search"
              phx-debounce="300"
              name="search"
            />
          </label>
        </div>
        <!-- State Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_state"
            aria-label="Filter by lease state"
            name="state"
            value={@filter_state}
          >
            <option value="all">All States</option>
            <option value="active">Active</option>
            <option value="offered">Offered</option>
            <option value="released">Released</option>
            <option value="expired">Expired</option>
            <option value="declined">Declined</option>
          </select>
        </div>
      </div>
    </.card>
    <!-- Leases Table -->
    <.card title={"Pool Leases (#{length(@filtered_leases)})"}>
      <div class="overflow-x-auto">
        <table class="table table-striped">
          <thead>
            <tr>
              <th scope="col">MAC Address</th>
              <th scope="col">IP Address</th>
              <th scope="col">Hostname</th>
              <th scope="col">State</th>
              <th scope="col">Expires</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= if @filtered_leases == [] do %>
              <tr>
                <td colspan="6" class="text-center text-on-surface-variant py-8">
                  No leases found in this pool
                </td>
              </tr>
            <% else %>
              <%= for lease <- @filtered_leases do %>
                <tr>
                  <td>
                    <div class="font-mono text-sm">
                      {format_mac(lease.mac_address)}
                    </div>
                    <%= if lease.client_id do %>
                      <div class="text-xs text-on-surface-variant">
                        Client ID: {Base.encode16(lease.client_id, case: :lower)
                        |> String.slice(0, 16)}...
                      </div>
                    <% end %>
                  </td>
                  <td>
                    <div class="font-mono text-sm font-semibold">
                      {format_ip(lease.ip_address)}
                    </div>
                  </td>
                  <td>
                    <%= if lease.hostname do %>
                      <div class="font-medium">{lease.hostname}</div>
                    <% else %>
                      <span class="text-on-surface-variant italic">No hostname</span>
                    <% end %>
                  </td>
                  <td>
                    <.badge color={lease_state_color(lease.state)} size="sm">
                      {lease.state}
                    </.badge>
                  </td>
                  <td>
                    <%= if lease.state == :active do %>
                      <div class="text-sm">
                        {format_expiration(lease.expires_at)}
                      </div>
                      <div class={expiration_color(lease.expires_at) <> " text-xs"}>
                        {format_time_remaining(lease.expires_at)}
                      </div>
                    <% else %>
                      <span class="text-on-surface-variant">-</span>
                    <% end %>
                  </td>
                  <td>
                    <%= if lease.state == :active do %>
                      <.dm_btn
                        variant="error"
                        size="xs"
                        class="btn-outline"
                        phx-click="release_lease"
                        phx-value-mac={format_mac(lease.mac_address)}
                        phx-disable-with="Releasing..."
                        data-confirm="Are you sure you want to release this lease?"
                      >
                        Release
                      </.dm_btn>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </.card>
  </div>
</Layouts.app>
