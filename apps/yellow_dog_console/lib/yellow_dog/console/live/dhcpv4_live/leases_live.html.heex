<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <.service_alert :if={not @service_running} service="DHCPv4" />
    
<!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold">DHCP Leases</h1>
        <p class="mt-2 text-on-surface-variant">
          View and manage all DHCP lease allocations
        </p>
      </div>
      <div class="flex gap-2">
        <button
          phx-click="export_csv"
          id="export-csv"
          phx-hook="CsvDownload"
          class="btn btn-outline btn-sm"
          aria-label="Export CSV"
        >
          <.dm_mdi name="download" class="h-5 w-5" /> Export CSV
        </button>
        <.link navigate={~p"/server/dhcpv4"} class="btn btn-ghost btn-sm">
          <.dm_mdi name="arrow-left" class="h-4 w-4" /> Back to Overview
        </.link>
      </div>
    </div>
    <!-- Search and Filters -->
    <.card>
      <div class="flex flex-col md:flex-row gap-4">
        <!-- Search -->
        <div class="flex-1">
          <label class="input flex items-center gap-2">
            <.dm_mdi name="magnify" class="h-5 w-5 opacity-70" />
            <input
              type="text"
              class="grow"
              placeholder="Search by MAC, IP, or hostname"
              aria-label="Search DHCPv4 leases"
              value={@search_query}
              phx-change="search"
              phx-debounce="300"
              name="search"
            />
          </label>
        </div>
        <!-- State Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_state"
            aria-label="Filter by lease state"
            name="state"
            value={@filter_state}
          >
            <option value="all">All States</option>
            <option value="active">Active</option>
            <option value="offered">Offered</option>
            <option value="released">Released</option>
            <option value="expired">Expired</option>
            <option value="declined">Declined</option>
          </select>
        </div>
        <!-- Pool Filter -->
        <div class="form-group w-full md:w-48">
          <select
            class="select"
            phx-change="filter_pool"
            aria-label="Filter by pool"
            name="pool"
            value={@filter_pool}
          >
            <option value="all">All Pools</option>
            <%= for pool <- @pools do %>
              <option value={pool}>{pool}</option>
            <% end %>
          </select>
        </div>
      </div>
    </.card>
    <!-- Stats Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Total Displayed</div>
          <div class="text-xl font-bold">{length(@filtered_leases)}</div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Active</div>
          <div class="text-xl font-bold text-success">
            {count_by_state(@filtered_leases, :active)}
          </div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Offered</div>
          <div class="text-xl font-bold text-info">
            {count_by_state(@filtered_leases, :offered)}
          </div>
        </div>
      </div>
      <div class="card card-bordered bg-surface">
        <div class="card-body">
          <div class="text-sm text-on-surface-variant">Expired</div>
          <div class="text-xl font-bold text-warning">
            {count_by_state(@filtered_leases, :expired)}
          </div>
        </div>
      </div>
    </div>
    <!-- Leases Table -->
    <.card>
      <div class="overflow-x-auto">
        <table class="table table-striped">
          <thead>
            <tr>
              <th scope="col">MAC Address</th>
              <th scope="col">IP Address</th>
              <th scope="col">Hostname</th>
              <th scope="col">Pool</th>
              <th scope="col">State</th>
              <th scope="col">Expires</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= if @filtered_leases == [] do %>
              <tr>
                <td colspan="7" class="text-center text-on-surface-variant py-8">
                  No leases found matching your criteria
                </td>
              </tr>
            <% else %>
              <%= for lease <- @filtered_leases do %>
                <tr>
                  <td>
                    <div class="font-mono text-sm">
                      {format_mac(lease.mac_address)}
                    </div>
                    <%= if lease.client_id do %>
                      <div class="text-xs text-on-surface-variant">
                        Client ID: {Base.encode16(lease.client_id, case: :lower)
                        |> String.slice(0, 16)}...
                      </div>
                    <% end %>
                  </td>
                  <td>
                    <div class="font-mono text-sm font-semibold">
                      {format_ip(lease.ip_address)}
                    </div>
                  </td>
                  <td>
                    <%= if lease.hostname do %>
                      <div class="font-medium">{lease.hostname}</div>
                    <% else %>
                      <span class="text-on-surface-variant italic">No hostname</span>
                    <% end %>
                  </td>
                  <td>
                    <.badge size="sm">{lease.pool_name}</.badge>
                  </td>
                  <td>
                    <.badge color={lease_state_color(lease.state)} size="sm">
                      {lease.state}
                    </.badge>
                  </td>
                  <td>
                    <%= if lease.state == :active do %>
                      <div class="text-sm">
                        {format_expiration(lease.expires_at)}
                      </div>
                      <div class={"text-xs " <> expiration_color(lease.expires_at)}>
                        {format_time_remaining(lease.expires_at)}
                      </div>
                    <% else %>
                      <span class="text-on-surface-variant">-</span>
                    <% end %>
                  </td>
                  <td>
                    <%= if lease.state == :active do %>
                      <button
                        phx-click="release_lease"
                        phx-value-mac={format_mac(lease.mac_address)}
                        phx-disable-with="Releasing..."
                        class="btn btn-xs btn-error btn-outline"
                        data-confirm="Are you sure you want to release this lease?"
                      >
                        Release
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </.card>
  </div>
</Layouts.app>
