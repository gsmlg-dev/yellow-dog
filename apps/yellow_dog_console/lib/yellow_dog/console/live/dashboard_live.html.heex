<Layouts.app flash={@flash} current_path={@current_path}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold">Service Dashboard</h1>
        <p class="mt-2 text-on-surface-variant">Monitor and manage your Yellow Dog services</p>
      </div>
      <button phx-click="refresh" class="btn btn-ghost btn-circle" aria-label="Refresh">
        <.dm_mdi name="refresh" class="h-6 w-6" />
      </button>
    </div>
    <!-- Service Stats Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 w-full">
      <div
        :for={service <- @services}
        class="p-4 bg-surface-container rounded-lg flex flex-col gap-1"
      >
        <div class="flex justify-between items-center">
          <span class="text-sm text-on-surface-variant">{service.description}</span>
          <.status_indicator
            status={
              cond do
                service.status == "Running" -> "running"
                service.status == "Error" -> "error"
                true -> "stopped"
              end
            }
            pulse
          />
        </div>
        <div class="text-2xl font-bold text-on-surface">
          <span class={
            cond do
              service.status == "Running" -> "text-success"
              service.status == "Error" -> "text-error"
              true -> "text-on-surface-variant"
            end
          }>
            {service.name}
          </span>
        </div>
        <div class="text-xs text-on-surface-variant">
          Port {service.port} · {service.status}
        </div>
      </div>
    </div>
    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <!-- Service Cards -->
      <div class="xl:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
        <.card :for={service <- @services} class="hover:shadow-2xl transition-shadow">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="card-title text-lg mb-2">
                {service.name}
                <.badge
                  color={
                    cond do
                      service.status == "Running" -> "success"
                      service.status == "Error" -> "error"
                      true -> "neutral"
                    end
                  }
                  size="sm"
                >
                  {service.status}
                </.badge>
              </h3>
              <p class="text-sm text-on-surface-variant mb-4">
                {service.description}
              </p>
              <%= if service.error do %>
                <div class="alert alert-error text-sm py-2 px-3">
                  <.dm_mdi name="close-circle-outline" class="stroke-current shrink-0 h-4 w-4" />
                  <span>{service.error}</span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="divider my-2"></div>

          <div class="space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-on-surface-variant">Port</span>
              <span class="font-mono font-semibold">{service.port}</span>
            </div>

            <div class="flex items-center justify-between text-sm">
              <span class="text-on-surface-variant">Status</span>
              <.status_indicator
                status={
                  cond do
                    service.status == "Running" -> "running"
                    service.status == "Error" -> "error"
                    true -> "stopped"
                  end
                }
                label={service.status}
              />
            </div>

            <%= if service.status == "Running" do %>
              <div class="flex items-center justify-between text-sm">
                <span class="text-on-surface-variant">Supervisor PID</span>
                <span class="font-mono font-semibold text-xs">{service.pid}</span>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-on-surface-variant">Memory</span>
                <span class="font-mono font-semibold">{service.memory}</span>
              </div>

              <%= if service.uptime do %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-on-surface-variant">Uptime</span>
                  <span class="font-mono font-semibold">{service.uptime}</span>
                </div>
              <% end %>
            <% end %>

            <.progress
              value={if service.status == "Running", do: 100, else: 0}
              color={
                cond do
                  service.status == "Running" -> "success"
                  service.status == "Error" -> "error"
                  true -> "neutral"
                end
              }
              class="mt-2"
            />
          </div>

          <:actions>
            <%= if service.running do %>
              <button
                class="btn btn-sm btn-error gap-2"
                phx-click="stop_service"
                phx-value-service={service.key}
                phx-disable-with="Stopping..."
              >
                <.dm_mdi name="stop-circle-outline" class="h-4 w-4" /> Stop
              </button>
            <% else %>
              <button
                class="btn btn-sm btn-success gap-2"
                phx-click="start_service"
                phx-value-service={service.key}
                phx-disable-with="Starting..."
              >
                <.dm_mdi name="play-circle-outline" class="h-4 w-4" /> Start
              </button>
            <% end %>
            <.link navigate={"/system/settings/#{service.key}"} class="btn btn-sm btn-ghost gap-2">
              <.dm_mdi name="cog" class="h-4 w-4" /> Configure
            </.link>
          </:actions>
        </.card>
      </div>
      <!-- Sidebar - Quick Actions & Activity -->
      <div class="space-y-6">
        <!-- Quick Actions Card -->
        <.card title="Quick Actions">
          <div class="space-y-2">
            <.link navigate={~p"/server/dns"} class="btn btn-outline w-full justify-start gap-2">
              <.dm_mdi name="web" class="h-5 w-5" /> DNS Management
            </.link>

            <.link
              navigate={~p"/server/dhcpv4"}
              class="btn btn-outline w-full justify-start gap-2"
            >
              <.dm_mdi name="server-network" class="h-5 w-5" /> DHCPv4 Server
            </.link>

            <.link navigate={~p"/server/mdns"} class="btn btn-outline w-full justify-start gap-2">
              <.dm_mdi name="wifi" class="h-5 w-5" /> mDNS Discovery
            </.link>

            <.link
              navigate={~p"/system/settings"}
              class="btn btn-outline w-full justify-start gap-2"
            >
              <.dm_mdi name="cog" class="h-5 w-5" /> Configuration
            </.link>
          </div>
        </.card>
        <!-- System Health Card -->
        <.card title="BEAM VM Health">
          <div class="space-y-4">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm">Process Memory</span>
                <span class="text-sm font-semibold">{@system_health.memory_pct}%</span>
              </div>
              <.progress
                value={@system_health.memory_pct}
                color={
                  if @system_health.memory_pct > 80,
                    do: "error",
                    else: if(@system_health.memory_pct > 60, do: "warning", else: "info")
                }
              />
              <div class="text-xs text-on-surface-variant mt-1">
                {@system_health.memory_processes} of {@system_health.memory_total}
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm">Processes</span>
                <span class="text-sm font-semibold">{@system_health.process_pct}%</span>
              </div>
              <.progress
                value={@system_health.process_pct}
                color={if @system_health.process_pct > 80, do: "error", else: "success"}
              />
              <div class="text-xs text-on-surface-variant mt-1">
                {@system_health.process_count} / {@system_health.process_limit}
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm">VM Uptime</span>
                <span class="text-sm font-semibold">{@system_health.uptime}</span>
              </div>
            </div>
          </div>
        </.card>
      </div>
    </div>
  </div>
</Layouts.app>
