<div class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl">
        Yellow Dog Console
      </h1>
      <p class="mt-6 text-lg leading-8 text-zinc-600">
        Management interface for Yellow Dog DNS and DHCP services.
      </p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a
          href="/dashboard"
          class="rounded-md bg-zinc-900 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-zinc-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900"
        >
          Get started
        </a>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-zinc-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-zinc-900">
              <span class="text-white font-bold">D</span>
            </div>
            DNS Management
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-zinc-600">
            <p class="flex-auto">Manage DNS zones, records, and resolution settings with an intuitive interface.</p>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-zinc-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-zinc-900">
              <span class="text-white font-bold">H</span>
            </div>
            DHCP Services
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-zinc-600">
            <p class="flex-auto">Monitor and configure DHCPv4 and DHCPv6 services and lease management.</p>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-zinc-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-zinc-900">
              <span class="text-white font-bold">M</span>
            </div>
            Real-time Monitoring
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-zinc-600">
            <p class="flex-auto">Live monitoring of service status, performance metrics, and system health.</p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>