<!DOCTYPE html>
<html lang="en" data-theme="sunshine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <.live_title suffix=" · Yellow Dog">
      {assigns[:page_title] || "Management"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href="/management.css" />
    <script defer phx-track-static type="module" src="/management-live.js">
    </script>
  </head>
  <body class="bg-surface text-on-surface">
    {@inner_content}
  </body>
</html>
