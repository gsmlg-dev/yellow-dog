<Layouts.app flash={@flash} current_path={@current_path}>
  <div id="server-dashboard" class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">Server Dashboard</h1>
        <p class="mt-2 text-on-surface-variant">
          {@selected_server.name || @selected_server.id} · {@selected_server.id}
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.badge color={if @service_online?, do: "success", else: "ghost"} size="sm">
          {if @service_online?, do: "Online", else: "Offline"}
        </.badge>
        <button
          type="button"
          class="btn btn-ghost btn-circle"
          phx-click="refresh"
          aria-label="Refresh"
        >
          <.dm_mdi name="refresh" class="h-6 w-6" />
        </button>
      </div>
    </div>

    <div :if={not @service_online?} class="alert alert-warning" id="server-offline-snapshot">
      <.dm_mdi name="cloud-off-outline" class="h-5 w-5" />
      <span>
        Showing the latest management snapshot
        <%= if @cached_observed_at do %>
          observed {Calendar.strftime(@cached_observed_at, "%Y-%m-%d %H:%M:%S UTC")}
        <% end %>.
        Runtime actions are disabled.
      </span>
    </div>

    <div :if={@management_error} class="alert alert-error" id="server-management-error">
      <.dm_mdi name="alert-circle-outline" class="h-5 w-5" />
      <span>{@management_error}</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <.card :for={service <- @services}>
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold">{service.name}</h2>
            <p class="text-sm text-on-surface-variant">{service.description}</p>
          </div>
          <.badge color={service_state_color(service.state)} size="sm">
            {service_state_label(service.state)}
          </.badge>
        </div>

        <:actions>
          <button
            :if={service.running}
            type="button"
            class="btn btn-error btn-sm gap-2"
            phx-click="stop_service"
            phx-value-service={service.key}
            phx-disable-with="Stopping..."
            disabled={!@commands_enabled?}
          >
            <.dm_mdi name="stop-circle-outline" class="h-4 w-4" /> Stop
          </button>
          <button
            :if={not service.running}
            type="button"
            class="btn btn-success btn-sm gap-2"
            phx-click="start_service"
            phx-value-service={service.key}
            phx-disable-with="Starting..."
            disabled={!@commands_enabled?}
          >
            <.dm_mdi name="play-circle-outline" class="h-4 w-4" /> Start
          </button>
          <.link
            navigate={server_service_path(@selected_server.id, service.key)}
            class="btn btn-sm btn-ghost gap-2"
          >
            <.dm_mdi name="arrow-right" class="h-4 w-4" /> Details
          </.link>
        </:actions>
      </.card>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <.card title="Runtime Health">
        <div class="flex items-center justify-between mb-4">
          <span class="text-on-surface-variant">Overall status</span>
          <.badge color={health_color(@health["status"])} size="sm">
            {service_state_label(@health["status"] || "unknown")}
          </.badge>
        </div>
        <div class="divide-y divide-outline-variant">
          <div :for={check <- @health["checks"] || []} class="flex justify-between py-2 text-sm">
            <span>{check["name"]}</span>
            <span>{service_state_label(check["status"] || "unknown")}</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mt-4">
          <.stat title="Requests" value={to_string(@stats["requests"] || 0)} />
          <.stat title="Errors" value={to_string(@stats["errors"] || 0)} />
        </div>
      </.card>

      <.card title="Quick Actions">
        <div class="space-y-2">
          <.link
            :for={{label, path} <- server_quick_actions(@selected_server.id)}
            navigate={path}
            class="btn btn-outline w-full justify-start gap-2"
          >
            <.dm_mdi name="arrow-right" class="h-5 w-5" /> {label}
          </.link>
        </div>
      </.card>
    </div>
  </div>
</Layouts.app>
