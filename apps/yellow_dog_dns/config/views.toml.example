# DNS Views Configuration Example
# Copy this file to views.toml and customize for your network

# ============================================================================
# Example 1: Basic Split-Horizon DNS
# ============================================================================
# Internal users see internal resources, external users see public resources

[[view]]
name = "internal"
match_clients = "localnets"
zones = [
    "corp.example.com",
    "internal.example.com",
    "dev.example.com"
]
recursion_enabled = true

[[view]]
name = "external"
match_clients = "any"
zones = [
    "example.com",
    "www.example.com",
    "public.example.com"
]
recursion_enabled = false

