{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PnsCZM7TdtDMZypeG96hCx","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.ServiceRegistry do\n     2→  @moduledoc \"\"\"\n     3→  Registry for managing locally registered mDNS services.\n     4→\n     5→  Stores service definitions in ETS for fast lookups, manages service lifecycle\n     6→  (probing, announcing, registered), and handles persistence to/from files.\n     7→  \"\"\"\n     8→\n     9→  use GenServer\n    10→\n    11→  alias YellowDog.Mdns.ServiceStore\n    12→\n    13→  @table_name :mdns_service_registry\n    14→  @ets_options [:named_table, :public, :set, read_concurrency: true, write_concurrency: true]\n    15→\n    16→  @type service_id :: String.t()\n    17→  @type service_state :: :probing | :announcing | :registered | :disabled\n    18→\n    19→  @type service :: %{\n    20→          id: service_id(),\n    21→          name: String.t(),\n    22→          type: String.t(),\n    23→          domain: String.t(),\n    24→          fqdn: String.t(),\n    25→          host: String.t(),\n    26→          port: pos_integer(),\n    27→          txt_records: map(),\n    28→          addresses: [tuple()],\n    29→          priority: non_neg_integer(),\n    30→          weight: non_neg_integer(),\n    31→          ttl: pos_integer(),\n    32→          state: service_state(),\n    33→          source: :file | :api,\n    34→          enabled: boolean(),\n    35→          registered_at: integer(),\n    36→          last_announced: integer() | nil\n    37→        }\n    38→\n    39→  # Default TTLs per RFC 6762\n    40→  @default_service_ttl 4500\n    41→  # 75 minutes\n    42→\n    43→  # Client API\n    44→\n    45→  @doc \"\"\"\n    46→  Starts the ServiceRegistry GenServer.\n    47→  \"\"\"\n    48→  @spec start_link(keyword()) :: GenServer.on_start()\n    49→  def start_link(opts \\\\ []) do\n    50→    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n    51→  end\n    52→\n    53→  @doc \"\"\"\n    54→  Registers a new service.\n    55→\n    56→  ## Parameters\n    57→  - `service_def` - Service definition map\n    58→  - `opts` - Options\n    59→    - `:persist` - Save to file (default: false)\n    60→    - `:source` - Source of registration (:file or :api, default: :api)\n    61→\n    62→  ## Returns\n    63→  - `{:ok, service_id}` on success\n    64→  - `{:error, reason}` on failure\n    65→\n    66→  ## Examples\n    67→      iex> YellowDog.Mdns.ServiceRegistry.register_service(%{\n    68→      ...>   name: \"Web Server\",\n    69→      ...>   type: \"_http._tcp\",\n    70→      ...>   port: 8080,\n    71→      ...>   txt: %{\"path\" => \"/api\"}\n    72→      ...> })\n    73→      {:ok, \"Web Server._http._tcp.local\"}\n    74→  \"\"\"\n    75→  @spec register_service(map(), keyword()) :: {:ok, service_id()} | {:error, term()}\n    76→  def register_service(service_def, opts \\\\ []) do\n    77→    GenServer.call(__MODULE__, {:register_service, service_def, opts})\n    78→  end\n    79→\n    80→  @doc \"\"\"\n    81→  Unregisters a service.\n    82→\n    83→  ## Parameters\n    84→  - `service_id` - Service identifier\n    85→  - `opts` - Options\n    86→    - `:persist` - Update file (default: false)\n    87→  \"\"\"\n    88→  @spec unregister_service(service_id(), keyword()) :: :ok | {:error, term()}\n    89→  def unregister_service(service_id, opts \\\\ []) do\n    90→    GenServer.call(__MODULE__, {:unregister_service, service_id, opts})\n    91→  end\n    92→\n    93→  @doc \"\"\"\n    94→  Updates a service.\n    95→\n    96→  ## Parameters\n    97→  - `service_id` - Service identifier\n    98→  - `updates` - Map of fields to update\n    99→  - `opts` - Options\n   100→    - `:persist` - Save to file (default: false)\n   101→  \"\"\"\n   102→  @spec update_service(service_id(), map(), keyword()) :: :ok | {:error, term()}\n   103→  def update_service(service_id, updates, opts \\\\ []) do\n   104→    GenServer.call(__MODULE__, {:update_service, service_id, updates, opts})\n   105→  end\n   106→\n   107→  @doc \"\"\"\n   108→  Enables or disables a service.\n   109→  \"\"\"\n   110→  @spec toggle_service(service_id()) :: :ok | {:error, term()}\n   111→  def toggle_service(service_id) do\n   112→    GenServer.call(__MODULE__, {:toggle_service, service_id})\n   113→  end\n   114→\n   115→  @doc \"\"\"\n   116→  Gets a service by ID.\n   117→  \"\"\"\n   118→  @spec get_service(service_id()) :: service() | nil\n   119→  def get_service(service_id) do\n   120→    case :ets.lookup(@table_name, service_id) do\n   121→      [{^service_id, service}] -> service\n   122→      [] -> nil\n   123→    end\n   124→  end\n   125→\n   126→  @doc \"\"\"\n   127→  Lists all registered services.\n   128→\n   129→  ## Options\n   130→  - `:filter` - Filter services (:all, :enabled, :disabled, :registered)\n   131→  - `:source` - Filter by source (:file, :api, :all)\n   132→  \"\"\"\n   133→  @spec list_services(keyword()) :: [service()]\n   134→  def list_services(opts \\\\ []) do\n   135→    filter = Keyword.get(opts, :filter, :all)\n   136→    source_filter = Keyword.get(opts, :source, :all)\n   137→\n   138→    @table_name\n   139→    |> :ets.tab2list()\n   140→    |> Enum.map(fn {_id, service} -> service end)\n   141→    |> apply_filters(filter, source_filter)\n   142→    |> Enum.sort_by(& &1.name)\n   143→  end\n   144→\n   145→  @doc \"\"\"\n   146→  Gets DNS records for a query.\n   147→\n   148→  Used by the Responder to match incoming queries against registered services.\n   149→\n   150→  ## Parameters\n   151→  - `questions` - List of DNS questions from query\n   152→  \"\"\"\n   153→  @spec get_records_for_query([DNS.Question.t()]) :: [service()]\n   154→  def get_records_for_query(questions) do\n   155→    Enum.flat_map(questions, fn question ->\n   156→      qname = to_string(question.name) |> String.downcase() |> String.trim_trailing(\".\")\n   157→      qtype = question.type\n   158→\n   159→      # Find matching services\n   160→      list_services(filter: :registered)\n   161→      |> Enum.filter(fn service ->\n   162→        matches_query?(service, qname, qtype)\n   163→      end)\n   164→    end)\n   165→    |> Enum.uniq_by(& &1.id)\n   166→  end\n   167→\n   168→  @doc \"\"\"\n   169→  Reloads services from file.\n   170→\n   171→  Called by FileWatcher when the services file changes.\n   172→  \"\"\"\n   173→  @spec reload_from_file([map()]) :: :ok\n   174→  def reload_from_file(services) do\n   175→    GenServer.cast(__MODULE__, {:reload_from_file, services})\n   176→  end\n   177→\n   178→  @doc \"\"\"\n   179→  Loads services from the configured file.\n   180→  \"\"\"\n   181→  @spec load_from_file() :: {:ok, integer()} | {:error, term()}\n   182→  def load_from_file do\n   183→    GenServer.call(__MODULE__, :load_from_file)\n   184→  end\n   185→\n   186→  @doc \"\"\"\n   187→  Saves current services to file.\n   188→  \"\"\"\n   189→  @spec save_to_file() :: :ok | {:error, term()}\n   190→  def save_to_file do\n   191→    GenServer.call(__MODULE__, :save_to_file)\n   192→  end\n   193→\n   194→  @doc \"\"\"\n   195→  Gets registry statistics.\n   196→  \"\"\"\n   197→  @spec stats() :: map()\n   198→  def stats do\n   199→    services = list_services()\n   200→\n   201→    %{\n   202→      total: length(services),\n   203→      enabled: length(Enum.filter(services, & &1.enabled)),\n   204→      disabled: length(Enum.filter(services, &(not &1.enabled))),\n   205→      registered: length(Enum.filter(services, &(&1.state == :registered))),\n   206→      probing: length(Enum.filter(services, &(&1.state == :probing))),\n   207→      announcing: length(Enum.filter(services, &(&1.state == :announcing))),\n   208→      from_file: length(Enum.filter(services, &(&1.source == :file))),\n   209→      from_api: length(Enum.filter(services, &(&1.source == :api)))\n   210→    }\n   211→  end\n   212→\n   213→  # Server Callbacks\n   214→\n   215→  @impl true\n   216→  def init(opts) do\n   217→    # Initialize ETS table\n   218→    init_table()\n   219→\n   220→    # Get configuration\n   221→    storage_file = Keyword.get(opts, :storage_file, \"data/mdns_services.toml\")\n   222→    auto_save = Keyword.get(opts, :auto_save, true)\n   223→    load_on_start = Keyword.get(opts, :load_on_start, true)\n   224→\n   225→    state = %{\n   226→      storage_file: storage_file,\n   227→      auto_save: auto_save,\n   228→      hostname: get_hostname()\n   229→    }\n   230→\n   231→    # Load services from file if configured\n   232→    if load_on_start do\n   233→      case ServiceStore.load_services(storage_file) do\n   234→        {:ok, services} ->\n   235→          Enum.each(services, fn service_def ->\n   236→            register_service_internal(service_def, state, source: :file)\n   237→          end)\n   238→\n   239→          :telemetry.execute(\n   240→            [:yellow_dog, :mdns, :service_registry, :loaded_from_file],\n   241→            %{service_count: length(services)},\n   242→            %{file: storage_file}\n   243→          )\n   244→\n   245→        {:error, reason} ->\n   246→          :telemetry.execute(\n   247→            [:yellow_dog, :mdns, :service_registry, :load_failed],\n   248→            %{count: 1},\n   249→            %{reason: inspect(reason), file: storage_file}\n   250→          )\n   251→      end\n   252→    end\n   253→\n   254→    {:ok, state}\n   255→  end\n   256→\n   257→  @impl true\n   258→  def handle_call({:register_service, service_def, opts}, _from, state) do\n   259→    source = Keyword.get(opts, :source, :api)\n   260→    persist = Keyword.get(opts, :persist, false)\n   261→\n   262→    case register_service_internal(service_def, state, source: source) do\n   263→      {:ok, service_id} ->\n   264→        if persist and state.auto_save do\n   265→          save_services_to_file(state)\n   266→        end\n   267→\n   268→        notify_service_change(:registered, service_id)\n   269→        {:reply, {:ok, service_id}, state}\n   270→\n   271→      error ->\n   272→        {:reply, error, state}\n   273→    end\n   274→  end\n   275→\n   276→  def handle_call({:unregister_service, service_id, opts}, _from, state) do\n   277→    persist = Keyword.get(opts, :persist, false)\n   278→\n   279→    case :ets.lookup(@table_name, service_id) do\n   280→      [{^service_id, _service}] ->\n   281→        :ets.delete(@table_name, service_id)\n   282→\n   283→        if persist and state.auto_save do\n   284→          save_services_to_file(state)\n   285→        end\n   286→\n   287→        notify_service_change(:unregistered, service_id)\n   288→        {:reply, :ok, state}\n   289→\n   290→      [] ->\n   291→        {:reply, {:error, :not_found}, state}\n   292→    end\n   293→  end\n   294→\n   295→  def handle_call({:update_service, service_id, updates, opts}, _from, state) do\n   296→    persist = Keyword.get(opts, :persist, false)\n   297→\n   298→    case :ets.lookup(@table_name, service_id) do\n   299→      [{^service_id, service}] ->\n   300→        updated_service = Map.merge(service, updates)\n   301→        :ets.insert(@table_name, {service_id, updated_service})\n   302→\n   303→        if persist and state.auto_save do\n   304→          save_services_to_file(state)\n   305→        end\n   306→\n   307→        notify_service_change(:updated, service_id)\n   308→        {:reply, :ok, state}\n   309→\n   310→      [] ->\n   311→        {:reply, {:error, :not_found}, state}\n   312→    end\n   313→  end\n   314→\n   315→  def handle_call({:toggle_service, service_id}, _from, state) do\n   316→    case :ets.lookup(@table_name, service_id) do\n   317→      [{^service_id, service}] ->\n   318→        updated_service = %{service | enabled: not service.enabled}\n   319→        :ets.insert(@table_name, {service_id, updated_service})\n   320→\n   321→        if state.auto_save do\n   322→          save_services_to_file(state)\n   323→        end\n   324→\n   325→        notify_service_change(:toggled, service_id)\n   326→        {:reply, :ok, state}\n   327→\n   328→      [] ->\n   329→        {:reply, {:error, :not_found}, state}\n   330→    end\n   331→  end\n   332→\n   333→  def handle_call(:load_from_file, _from, state) do\n   334→    case ServiceStore.load_services(state.storage_file) do\n   335→      {:ok, services} ->\n   336→        # Clear existing file-based services\n   337→        list_services(source: :file)\n   338→        |> Enum.each(fn service ->\n   339→          :ets.delete(@table_name, service.id)\n   340→        end)\n   341→\n   342→        # Register new services\n   343→        Enum.each(services, fn service_def ->\n   344→          register_service_internal(service_def, state, source: :file)\n   345→        end)\n   346→\n   347→        {:reply, {:ok, length(services)}, state}\n   348→\n   349→      error ->\n   350→        {:reply, error, state}\n   351→    end\n   352→  end\n   353→\n   354→  def handle_call(:save_to_file, _from, state) do\n   355→    result = save_services_to_file(state)\n   356→    {:reply, result, state}\n   357→  end\n   358→\n   359→  @impl true\n   360→  def handle_cast({:reload_from_file, services}, state) do\n   361→    # Remove old file-based services\n   362→    list_services(source: :file)\n   363→    |> Enum.each(fn service ->\n   364→      :ets.delete(@table_name, service.id)\n   365→    end)\n   366→\n   367→    # Register new services from file\n   368→    Enum.each(services, fn service_def ->\n   369→      register_service_internal(service_def, state, source: :file)\n   370→    end)\n   371→\n   372→    :telemetry.execute(\n   373→      [:yellow_dog, :mdns, :service_registry, :reloaded_from_file],\n   374→      %{service_count: length(services)},\n   375→      %{}\n   376→    )\n   377→\n   378→    {:noreply, state}\n   379→  end\n   380→\n   381→  # Private functions\n   382→\n   383→  defp init_table do\n   384→    if :ets.whereis(@table_name) == :undefined do\n   385→      :ets.new(@table_name, @ets_options)\n   386→    end\n   387→\n   388→    :ok\n   389→  end\n   390→\n   391→  defp register_service_internal(service_def, state, opts) do\n   392→    source = Keyword.get(opts, :source, :api)\n   393→\n   394→    with :ok <- ServiceStore.validate_service(service_def) do\n   395→      service = build_service(service_def, state, source)\n   396→      :ets.insert(@table_name, {service.id, service})\n   397→\n   398→      :telemetry.execute(\n   399→        [:yellow_dog, :mdns, :service_registered],\n   400→        %{},\n   401→        %{service_id: service.id, source: source}\n   402→      )\n   403→\n   404→      {:ok, service.id}\n   405→    end\n   406→  end\n   407→\n   408→  defp build_service(service_def, state, source) do\n   409→    type_with_proto = normalize_service_type(service_def.type)\n   410→    domain = \"local\"\n   411→    name = service_def.name\n   412→    host = service_def[:host] || state.hostname\n   413→\n   414→    # Build FQDN: name.type.domain\n   415→    fqdn = \"#{name}.#{type_with_proto}.#{domain}\"\n   416→\n   417→    %{\n   418→      id: fqdn,\n   419→      name: name,\n   420→      type: type_with_proto,\n   421→      domain: domain,\n   422→      fqdn: fqdn,\n   423→      host: \"#{host}.#{domain}\",\n   424→      port: service_def.port,\n   425→      txt_records: service_def[:txt] || %{},\n   426→      addresses: parse_addresses(service_def[:addresses] || []),\n   427→      priority: 0,\n   428→      weight: 0,\n   429→      ttl: @default_service_ttl,\n   430→      state: if(service_def[:enabled] != false, do: :registered, else: :disabled),\n   431→      source: source,\n   432→      enabled: service_def[:enabled] != false,\n   433→      registered_at: System.system_time(:second),\n   434→      last_announced: nil\n   435→    }\n   436→  end\n   437→\n   438→  defp normalize_service_type(type) do\n   439→    # Ensure service type has proper format: _service._proto\n   440→    cond do\n   441→      String.contains?(type, \"._\") -> type\n   442→      String.starts_with?(type, \"_\") -> type <> \"._tcp\"\n   443→      true -> \"_\" <> type <> \"._tcp\"\n   444→    end\n   445→  end\n   446→\n   447→  defp parse_addresses(addresses) when is_list(addresses) do\n   448→    Enum.map(addresses, &parse_address/1)\n   449→    |> Enum.reject(&is_nil/1)\n   450→  end\n   451→\n   452→  defp parse_addresses(_), do: []\n   453→\n   454→  defp parse_address(addr) when is_binary(addr) do\n   455→    case :inet.parse_address(String.to_charlist(addr)) do\n   456→      {:ok, ip_tuple} -> ip_tuple\n   457→      _ -> nil\n   458→    end\n   459→  end\n   460→\n   461→  defp parse_address(addr) when is_tuple(addr), do: addr\n   462→  defp parse_address(_), do: nil\n   463→\n   464→  defp matches_query?(service, qname, qtype) do\n   465→    # Match service FQDN or type enumeration\n   466→    service_fqdn = String.downcase(service.fqdn) |> String.trim_trailing(\".\")\n   467→\n   468→    service_type =\n   469→      String.downcase(\"#{service.type}.#{service.domain}\") |> String.trim_trailing(\".\")\n   470→\n   471→    service_host = String.downcase(service.host) |> String.trim_trailing(\".\")\n   472→\n   473→    cond do\n   474→      # Direct service name query\n   475→      qname == service_fqdn and qtype in [:ANY, :SRV, :TXT] ->\n   476→        true\n   477→\n   478→      # Service type enumeration (PTR query)\n   479→      qname == service_type and qtype == :PTR ->\n   480→        true\n   481→\n   482→      # Host address query\n   483→      qname == service_host and qtype in [:A, :AAAA, :ANY] ->\n   484→        true\n   485→\n   486→      true ->\n   487→        false\n   488→    end\n   489→  end\n   490→\n   491→  defp apply_filters(services, filter, source_filter) do\n   492→    services\n   493→    |> apply_state_filter(filter)\n   494→    |> apply_source_filter(source_filter)\n   495→  end\n   496→\n   497→  defp apply_state_filter(services, :all), do: services\n   498→  defp apply_state_filter(services, :enabled), do: Enum.filter(services, & &1.enabled)\n   499→  defp apply_state_filter(services, :disabled), do: Enum.filter(services, &(not &1.enabled))\n   500→\n   501→  defp apply_state_filter(services, :registered),\n   502→    do: Enum.filter(services, &(&1.state == :registered))\n   503→\n   504→  defp apply_source_filter(services, :all), do: services\n   505→  defp apply_source_filter(services, source), do: Enum.filter(services, &(&1.source == source))\n   506→\n   507→  defp save_services_to_file(state) do\n   508→    services =\n   509→      list_services()\n   510→      |> Enum.map(&service_to_def/1)\n   511→\n   512→    ServiceStore.save_services(state.storage_file, services)\n   513→  end\n   514→\n   515→  defp service_to_def(service) do\n   516→    %{\n   517→      name: service.name,\n   518→      type: service.type,\n   519→      port: service.port,\n   520→      host: String.replace_suffix(service.host, \".#{service.domain}\", \"\"),\n   521→      txt: if(map_size(service.txt_records) > 0, do: service.txt_records, else: nil),\n   522→      addresses: Enum.map(service.addresses, &format_ip/1),\n   523→      enabled: service.enabled\n   524→    }\n   525→  end\n   526→\n   527→  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n   528→\n   529→  defp format_ip({a, b, c, d, e, f, g, h}) do\n   530→    parts = [a, b, c, d, e, f, g, h]\n   531→    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n   532→    Enum.join(hex_parts, \":\")\n   533→  end\n   534→\n   535→  defp get_hostname do\n   536→    case :inet.gethostname() do\n   537→      {:ok, hostname} -> to_string(hostname)\n   538→      _ -> \"localhost\"\n   539→    end\n   540→  end\n   541→\n   542→  defp notify_service_change(event, service_id) do\n   543→    # Notify web console if available\n   544→    # Map internal event names to expected LiveView event names\n   545→    pubsub_event =\n   546→      case event do\n   547→        :registered -> :service_registered\n   548→        :unregistered -> :service_unregistered\n   549→        :updated -> :service_updated\n   550→        :toggled -> :service_toggled\n   551→        other -> other\n   552→      end\n   553→\n   554→    case Process.whereis(YellowDog.Console.PubSub) do\n   555→      nil ->\n   556→        :ok\n   557→\n   558→      _pid ->\n   559→        try do\n   560→          apply(Phoenix.PubSub, :broadcast, [\n   561→            YellowDog.Console.PubSub,\n   562→            \"mdns:services\",\n   563→            {pubsub_event, service_id}\n   564→          ])\n   565→        rescue\n   566→          _ -> :ok\n   567→        end\n   568→    end\n   569→  end\n   570→end\n   571→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb21cfce-0067-4926-ae35-eac907707d9d","uuid":"248fb94d-b062-4732-9888-a06b6cbc58d9","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/lib/yellow_dog/mdns/service_registry.ex","content":"defmodule YellowDog.Mdns.ServiceRegistry do\n  @moduledoc \"\"\"\n  Registry for managing locally registered mDNS services.\n\n  Stores service definitions in ETS for fast lookups, manages service lifecycle\n  (probing, announcing, registered), and handles persistence to/from files.\n  \"\"\"\n\n  use GenServer\n\n  alias YellowDog.Mdns.ServiceStore\n\n  @table_name :mdns_service_registry\n  @ets_options [:named_table, :public, :set, read_concurrency: true, write_concurrency: true]\n\n  @type service_id :: String.t()\n  @type service_state :: :probing | :announcing | :registered | :disabled\n\n  @type service :: %{\n          id: service_id(),\n          name: String.t(),\n          type: String.t(),\n          domain: String.t(),\n          fqdn: String.t(),\n          host: String.t(),\n          port: pos_integer(),\n          txt_records: map(),\n          addresses: [tuple()],\n          priority: non_neg_integer(),\n          weight: non_neg_integer(),\n          ttl: pos_integer(),\n          state: service_state(),\n          source: :file | :api,\n          enabled: boolean(),\n          registered_at: integer(),\n          last_announced: integer() | nil\n        }\n\n  # Default TTLs per RFC 6762\n  @default_service_ttl 4500\n  # 75 minutes\n\n  # Client API\n\n  @doc \"\"\"\n  Starts the ServiceRegistry GenServer.\n  \"\"\"\n  @spec start_link(keyword()) :: GenServer.on_start()\n  def start_link(opts \\\\ []) do\n    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Registers a new service.\n\n  ## Parameters\n  - `service_def` - Service definition map\n  - `opts` - Options\n    - `:persist` - Save to file (default: false)\n    - `:source` - Source of registration (:file or :api, default: :api)\n\n  ## Returns\n  - `{:ok, service_id}` on success\n  - `{:error, reason}` on failure\n\n  ## Examples\n      iex> YellowDog.Mdns.ServiceRegistry.register_service(%{\n      ...>   name: \"Web Server\",\n      ...>   type: \"_http._tcp\",\n      ...>   port: 8080,\n      ...>   txt: %{\"path\" => \"/api\"}\n      ...> })\n      {:ok, \"Web Server._http._tcp.local\"}\n  \"\"\"\n  @spec register_service(map(), keyword()) :: {:ok, service_id()} | {:error, term()}\n  def register_service(service_def, opts \\\\ []) do\n    GenServer.call(__MODULE__, {:register_service, service_def, opts})\n  end\n\n  @doc \"\"\"\n  Unregisters a service.\n\n  ## Parameters\n  - `service_id` - Service identifier\n  - `opts` - Options\n    - `:persist` - Update file (default: false)\n  \"\"\"\n  @spec unregister_service(service_id(), keyword()) :: :ok | {:error, term()}\n  def unregister_service(service_id, opts \\\\ []) do\n    GenServer.call(__MODULE__, {:unregister_service, service_id, opts})\n  end\n\n  @doc \"\"\"\n  Updates a service.\n\n  ## Parameters\n  - `service_id` - Service identifier\n  - `updates` - Map of fields to update\n  - `opts` - Options\n    - `:persist` - Save to file (default: false)\n  \"\"\"\n  @spec update_service(service_id(), map(), keyword()) :: :ok | {:error, term()}\n  def update_service(service_id, updates, opts \\\\ []) do\n    GenServer.call(__MODULE__, {:update_service, service_id, updates, opts})\n  end\n\n  @doc \"\"\"\n  Enables or disables a service.\n  \"\"\"\n  @spec toggle_service(service_id()) :: :ok | {:error, term()}\n  def toggle_service(service_id) do\n    GenServer.call(__MODULE__, {:toggle_service, service_id})\n  end\n\n  @doc \"\"\"\n  Gets a service by ID.\n  \"\"\"\n  @spec get_service(service_id()) :: service() | nil\n  def get_service(service_id) do\n    case :ets.lookup(@table_name, service_id) do\n      [{^service_id, service}] -> service\n      [] -> nil\n    end\n  end\n\n  @doc \"\"\"\n  Lists all registered services.\n\n  ## Options\n  - `:filter` - Filter services (:all, :enabled, :disabled, :registered)\n  - `:source` - Filter by source (:file, :api, :all)\n  \"\"\"\n  @spec list_services(keyword()) :: [service()]\n  def list_services(opts \\\\ []) do\n    filter = Keyword.get(opts, :filter, :all)\n    source_filter = Keyword.get(opts, :source, :all)\n\n    @table_name\n    |> :ets.tab2list()\n    |> Enum.map(fn {_id, service} -> service end)\n    |> apply_filters(filter, source_filter)\n    |> Enum.sort_by(& &1.name)\n  end\n\n  @doc \"\"\"\n  Gets DNS records for a query.\n\n  Used by the Responder to match incoming queries against registered services.\n\n  ## Parameters\n  - `questions` - List of DNS questions from query\n  \"\"\"\n  @spec get_records_for_query([DNS.Question.t()]) :: [service()]\n  def get_records_for_query(questions) do\n    Enum.flat_map(questions, fn question ->\n      qname = to_string(question.name) |> String.downcase() |> String.trim_trailing(\".\")\n      qtype = question.type\n\n      # Find matching services\n      list_services(filter: :registered)\n      |> Enum.filter(fn service ->\n        matches_query?(service, qname, qtype)\n      end)\n    end)\n    |> Enum.uniq_by(& &1.id)\n  end\n\n  @doc \"\"\"\n  Reloads services from file.\n\n  Called by FileWatcher when the services file changes.\n  \"\"\"\n  @spec reload_from_file([map()]) :: :ok\n  def reload_from_file(services) do\n    GenServer.cast(__MODULE__, {:reload_from_file, services})\n  end\n\n  @doc \"\"\"\n  Loads services from the configured file.\n  \"\"\"\n  @spec load_from_file() :: {:ok, integer()} | {:error, term()}\n  def load_from_file do\n    GenServer.call(__MODULE__, :load_from_file)\n  end\n\n  @doc \"\"\"\n  Saves current services to file.\n  \"\"\"\n  @spec save_to_file() :: :ok | {:error, term()}\n  def save_to_file do\n    GenServer.call(__MODULE__, :save_to_file)\n  end\n\n  @doc \"\"\"\n  Gets registry statistics.\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    services = list_services()\n\n    %{\n      total: length(services),\n      enabled: length(Enum.filter(services, & &1.enabled)),\n      disabled: length(Enum.filter(services, &(not &1.enabled))),\n      registered: length(Enum.filter(services, &(&1.state == :registered))),\n      probing: length(Enum.filter(services, &(&1.state == :probing))),\n      announcing: length(Enum.filter(services, &(&1.state == :announcing))),\n      from_file: length(Enum.filter(services, &(&1.source == :file))),\n      from_api: length(Enum.filter(services, &(&1.source == :api)))\n    }\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(opts) do\n    # Initialize ETS table\n    init_table()\n\n    # Get configuration\n    storage_file = Keyword.get(opts, :storage_file, \"data/mdns_services.toml\")\n    auto_save = Keyword.get(opts, :auto_save, true)\n    load_on_start = Keyword.get(opts, :load_on_start, true)\n\n    state = %{\n      storage_file: storage_file,\n      auto_save: auto_save,\n      hostname: get_hostname()\n    }\n\n    # Load services from file if configured\n    if load_on_start do\n      case ServiceStore.load_services(storage_file) do\n        {:ok, services} ->\n          Enum.each(services, fn service_def ->\n            register_service_internal(service_def, state, source: :file)\n          end)\n\n          :telemetry.execute(\n            [:yellow_dog, :mdns, :service_registry, :loaded_from_file],\n            %{service_count: length(services)},\n            %{file: storage_file}\n          )\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :mdns, :service_registry, :load_failed],\n            %{count: 1},\n            %{reason: inspect(reason), file: storage_file}\n          )\n      end\n    end\n\n    {:ok, state}\n  end\n\n  @impl true\n  def handle_call({:register_service, service_def, opts}, _from, state) do\n    source = Keyword.get(opts, :source, :api)\n    persist = Keyword.get(opts, :persist, false)\n\n    case register_service_internal(service_def, state, source: source) do\n      {:ok, service_id} ->\n        if persist and state.auto_save do\n          save_services_to_file(state)\n        end\n\n        notify_service_change(:registered, service_id)\n        {:reply, {:ok, service_id}, state}\n\n      error ->\n        {:reply, error, state}\n    end\n  end\n\n  def handle_call({:unregister_service, service_id, opts}, _from, state) do\n    persist = Keyword.get(opts, :persist, false)\n\n    case :ets.lookup(@table_name, service_id) do\n      [{^service_id, _service}] ->\n        :ets.delete(@table_name, service_id)\n\n        if persist and state.auto_save do\n          save_services_to_file(state)\n        end\n\n        notify_service_change(:unregistered, service_id)\n        {:reply, :ok, state}\n\n      [] ->\n        {:reply, {:error, :not_found}, state}\n    end\n  end\n\n  def handle_call({:update_service, service_id, updates, opts}, _from, state) do\n    persist = Keyword.get(opts, :persist, false)\n\n    case :ets.lookup(@table_name, service_id) do\n      [{^service_id, service}] ->\n        updated_service = Map.merge(service, updates)\n        :ets.insert(@table_name, {service_id, updated_service})\n\n        if persist and state.auto_save do\n          save_services_to_file(state)\n        end\n\n        notify_service_change(:updated, service_id)\n        {:reply, :ok, state}\n\n      [] ->\n        {:reply, {:error, :not_found}, state}\n    end\n  end\n\n  def handle_call({:toggle_service, service_id}, _from, state) do\n    case :ets.lookup(@table_name, service_id) do\n      [{^service_id, service}] ->\n        updated_service = %{service | enabled: not service.enabled}\n        :ets.insert(@table_name, {service_id, updated_service})\n\n        if state.auto_save do\n          save_services_to_file(state)\n        end\n\n        notify_service_change(:toggled, service_id)\n        {:reply, :ok, state}\n\n      [] ->\n        {:reply, {:error, :not_found}, state}\n    end\n  end\n\n  def handle_call(:load_from_file, _from, state) do\n    case ServiceStore.load_services(state.storage_file) do\n      {:ok, services} ->\n        # Clear existing file-based services\n        list_services(source: :file)\n        |> Enum.each(fn service ->\n          :ets.delete(@table_name, service.id)\n        end)\n\n        # Register new services\n        Enum.each(services, fn service_def ->\n          register_service_internal(service_def, state, source: :file)\n        end)\n\n        {:reply, {:ok, length(services)}, state}\n\n      error ->\n        {:reply, error, state}\n    end\n  end\n\n  def handle_call(:save_to_file, _from, state) do\n    result = save_services_to_file(state)\n    {:reply, result, state}\n  end\n\n  @impl true\n  def handle_cast({:reload_from_file, services}, state) do\n    # Remove old file-based services\n    list_services(source: :file)\n    |> Enum.each(fn service ->\n      :ets.delete(@table_name, service.id)\n    end)\n\n    # Register new services from file\n    Enum.each(services, fn service_def ->\n      register_service_internal(service_def, state, source: :file)\n    end)\n\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :service_registry, :reloaded_from_file],\n      %{service_count: length(services)},\n      %{}\n    )\n\n    {:noreply, state}\n  end\n\n  # Private functions\n\n  defp init_table do\n    if :ets.whereis(@table_name) == :undefined do\n      :ets.new(@table_name, @ets_options)\n    end\n\n    :ok\n  end\n\n  defp register_service_internal(service_def, state, opts) do\n    source = Keyword.get(opts, :source, :api)\n\n    with :ok <- ServiceStore.validate_service(service_def) do\n      service = build_service(service_def, state, source)\n      :ets.insert(@table_name, {service.id, service})\n\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :service_registered],\n        %{},\n        %{service_id: service.id, source: source}\n      )\n\n      {:ok, service.id}\n    end\n  end\n\n  defp build_service(service_def, state, source) do\n    type_with_proto = normalize_service_type(service_def.type)\n    domain = \"local\"\n    name = service_def.name\n    host = service_def[:host] || state.hostname\n\n    # Build FQDN: name.type.domain\n    fqdn = \"#{name}.#{type_with_proto}.#{domain}\"\n\n    %{\n      id: fqdn,\n      name: name,\n      type: type_with_proto,\n      domain: domain,\n      fqdn: fqdn,\n      host: \"#{host}.#{domain}\",\n      port: service_def.port,\n      txt_records: service_def[:txt] || %{},\n      addresses: parse_addresses(service_def[:addresses] || []),\n      priority: 0,\n      weight: 0,\n      ttl: @default_service_ttl,\n      state: if(service_def[:enabled] != false, do: :registered, else: :disabled),\n      source: source,\n      enabled: service_def[:enabled] != false,\n      registered_at: System.system_time(:second),\n      last_announced: nil\n    }\n  end\n\n  defp normalize_service_type(type) do\n    # Ensure service type has proper format: _service._proto\n    cond do\n      String.contains?(type, \"._\") -> type\n      String.starts_with?(type, \"_\") -> type <> \"._tcp\"\n      true -> \"_\" <> type <> \"._tcp\"\n    end\n  end\n\n  defp parse_addresses(addresses) when is_list(addresses) do\n    Enum.map(addresses, &parse_address/1)\n    |> Enum.reject(&is_nil/1)\n  end\n\n  defp parse_addresses(_), do: []\n\n  defp parse_address(addr) when is_binary(addr) do\n    case :inet.parse_address(String.to_charlist(addr)) do\n      {:ok, ip_tuple} -> ip_tuple\n      _ -> nil\n    end\n  end\n\n  defp parse_address(addr) when is_tuple(addr), do: addr\n  defp parse_address(_), do: nil\n\n  defp matches_query?(service, qname, qtype) do\n    # Match service FQDN or type enumeration\n    service_fqdn = String.downcase(service.fqdn) |> String.trim_trailing(\".\")\n\n    service_type =\n      String.downcase(\"#{service.type}.#{service.domain}\") |> String.trim_trailing(\".\")\n\n    service_host = String.downcase(service.host) |> String.trim_trailing(\".\")\n\n    cond do\n      # Direct service name query\n      qname == service_fqdn and qtype in [:ANY, :SRV, :TXT] ->\n        true\n\n      # Service type enumeration (PTR query)\n      qname == service_type and qtype == :PTR ->\n        true\n\n      # Host address query\n      qname == service_host and qtype in [:A, :AAAA, :ANY] ->\n        true\n\n      true ->\n        false\n    end\n  end\n\n  defp apply_filters(services, filter, source_filter) do\n    services\n    |> apply_state_filter(filter)\n    |> apply_source_filter(source_filter)\n  end\n\n  defp apply_state_filter(services, :all), do: services\n  defp apply_state_filter(services, :enabled), do: Enum.filter(services, & &1.enabled)\n  defp apply_state_filter(services, :disabled), do: Enum.filter(services, &(not &1.enabled))\n\n  defp apply_state_filter(services, :registered),\n    do: Enum.filter(services, &(&1.state == :registered))\n\n  defp apply_source_filter(services, :all), do: services\n  defp apply_source_filter(services, source), do: Enum.filter(services, &(&1.source == source))\n\n  defp save_services_to_file(state) do\n    services =\n      list_services()\n      |> Enum.map(&service_to_def/1)\n\n    ServiceStore.save_services(state.storage_file, services)\n  end\n\n  defp service_to_def(service) do\n    %{\n      name: service.name,\n      type: service.type,\n      port: service.port,\n      host: String.replace_suffix(service.host, \".#{service.domain}\", \"\"),\n      txt: if(map_size(service.txt_records) > 0, do: service.txt_records, else: nil),\n      addresses: Enum.map(service.addresses, &format_ip/1),\n      enabled: service.enabled\n    }\n  end\n\n  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n\n  defp format_ip({a, b, c, d, e, f, g, h}) do\n    parts = [a, b, c, d, e, f, g, h]\n    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n    Enum.join(hex_parts, \":\")\n  end\n\n  defp get_hostname do\n    case :inet.gethostname() do\n      {:ok, hostname} -> to_string(hostname)\n      _ -> \"localhost\"\n    end\n  end\n\n  defp notify_service_change(event, service_id) do\n    # Notify web console if available\n    # Map internal event names to expected LiveView event names\n    pubsub_event =\n      case event do\n        :registered -> :service_registered\n        :unregistered -> :service_unregistered\n        :updated -> :service_updated\n        :toggled -> :service_toggled\n        other -> other\n      end\n\n    case Process.whereis(YellowDog.Console.PubSub) do\n      nil ->\n        :ok\n\n      _pid ->\n        try do\n          apply(Phoenix.PubSub, :broadcast, [\n            YellowDog.Console.PubSub,\n            \"mdns:services\",\n            {pubsub_event, service_id}\n          ])\n        rescue\n          _ -> :ok\n        end\n    end\n  end\nend\n","numLines":571,"startLine":1,"totalLines":571}}}
