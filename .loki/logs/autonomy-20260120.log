{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0182aEWvq5gJnxr54v4hwiGQ","type":"tool_result","content":"     1→defmodule YellowDog.Dns.Zone.AuthTest do\n     2→  use ExUnit.Case, async: false\n     3→\n     4→  alias YellowDog.Dns.Zone.Auth\n     5→\n     6→  setup_all do\n     7→    # Start the ZoneRegistry once for all tests\n     8→    {:ok, _registry_pid} = Registry.start_link(keys: :unique, name: YellowDog.Dns.ZoneRegistry)\n     9→    :ok\n    10→  end\n    11→\n    12→  setup do\n    13→    # Start an auth zone for testing with a unique name to avoid conflicts\n    14→    zone_name = \"example-#{System.unique_integer([:positive])}.com\"\n    15→    {:ok, pid} = Auth.start_link(name: zone_name, records: [])\n    16→\n    17→    on_exit(fn ->\n    18→      # Gracefully stop the zone process, catching any errors from already-stopped processes\n    19→      try do\n    20→        if Process.alive?(pid) do\n    21→          GenServer.stop(pid, :normal, 1000)\n    22→        end\n    23→      catch\n    24→        :exit, _ -> :ok\n    25→      end\n    26→    end)\n    27→\n    28→    {:ok, zone: pid, zone_name: zone_name}\n    29→  end\n    30→\n    31→  describe \"add_record/2 with atom types\" do\n    32→    test \"adds A record with string name and atom type\", %{zone: pid} do\n    33→      record = %{\n    34→        name: \"www.example.com\",\n    35→        type: :a,\n    36→        class: :in,\n    37→        ttl: 3600,\n    38→        rdata: {192, 0, 2, 1}\n    39→      }\n    40→\n    41→      assert :ok = Auth.add_record(pid, record)\n    42→\n    43→      records = Auth.get_all_records(pid)\n    44→      assert length(records) == 1\n    45→\n    46→      [added] = records\n    47→      assert added.name == \"www.example.com\"\n    48→      assert added.type == :a\n    49→    end\n    50→\n    51→    test \"adds AAAA record\", %{zone: pid} do\n    52→      record = %{\n    53→        name: \"ipv6.example.com\",\n    54→        type: :aaaa,\n    55→        class: :in,\n    56→        ttl: 3600,\n    57→        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 1}\n    58→      }\n    59→\n    60→      assert :ok = Auth.add_record(pid, record)\n    61→\n    62→      records = Auth.get_all_records(pid)\n    63→      assert length(records) == 1\n    64→    end\n    65→\n    66→    test \"adds multiple records\", %{zone: pid} do\n    67→      records = [\n    68→        %{name: \"www.example.com\", type: :a, class: :in, ttl: 3600, rdata: {192, 0, 2, 1}},\n    69→        %{name: \"mail.example.com\", type: :a, class: :in, ttl: 3600, rdata: {192, 0, 2, 2}},\n    70→        %{name: \"example.com\", type: :mx, class: :in, ttl: 3600, rdata: {10, \"mail.example.com\"}}\n    71→      ]\n    72→\n    73→      for record <- records do\n    74→        assert :ok = Auth.add_record(pid, record)\n    75→      end\n    76→\n    77→      all_records = Auth.get_all_records(pid)\n    78→      assert length(all_records) == 3\n    79→    end\n    80→  end\n    81→\n    82→  describe \"add_record/2 with DNS.Message.Record struct\" do\n    83→    test \"adds record using DNS.Message.Record.new/5\", %{zone: pid} do\n    84→      record = DNS.Message.Record.new(\"test.example.com\", :a, :in, 3600, {10, 0, 0, 1})\n    85→\n    86→      assert :ok = Auth.add_record(pid, record)\n    87→\n    88→      records = Auth.get_all_records(pid)\n    89→      assert length(records) == 1\n    90→    end\n    91→\n    92→    test \"adds record with Domain struct name\", %{zone: pid} do\n    93→      domain = DNS.Message.Domain.new(\"api.example.com\")\n    94→\n    95→      record = %{\n    96→        name: domain,\n    97→        type: :a,\n    98→        class: :in,\n    99→        ttl: 300,\n   100→        rdata: {10, 0, 0, 2}\n   101→      }\n   102→\n   103→      assert :ok = Auth.add_record(pid, record)\n   104→\n   105→      records = Auth.get_all_records(pid)\n   106→      assert length(records) == 1\n   107→    end\n   108→\n   109→    test \"adds record with RRType struct\", %{zone: pid} do\n   110→      rtype = DNS.ResourceRecordType.new(:a)\n   111→\n   112→      record = %{\n   113→        name: \"rtype.example.com\",\n   114→        type: rtype,\n   115→        class: :in,\n   116→        ttl: 300,\n   117→        rdata: {10, 0, 0, 3}\n   118→      }\n   119→\n   120→      assert :ok = Auth.add_record(pid, record)\n   121→\n   122→      records = Auth.get_all_records(pid)\n   123→      assert length(records) == 1\n   124→    end\n   125→\n   126→    test \"adds record with both Domain and RRType structs\", %{zone: pid} do\n   127→      domain = DNS.Message.Domain.new(\"full.example.com\")\n   128→      rtype = DNS.ResourceRecordType.new(:aaaa)\n   129→\n   130→      record = %{\n   131→        name: domain,\n   132→        type: rtype,\n   133→        class: :in,\n   134→        ttl: 600,\n   135→        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 0x100}\n   136→      }\n   137→\n   138→      assert :ok = Auth.add_record(pid, record)\n   139→\n   140→      records = Auth.get_all_records(pid)\n   141→      assert length(records) == 1\n   142→    end\n   143→  end\n   144→\n   145→  describe \"get_records/3\" do\n   146→    test \"retrieves specific record by name and type\", %{zone: pid} do\n   147→      Auth.add_record(pid, %{\n   148→        name: \"www.example.com\",\n   149→        type: :a,\n   150→        class: :in,\n   151→        ttl: 3600,\n   152→        rdata: {192, 0, 2, 1}\n   153→      })\n   154→\n   155→      Auth.add_record(pid, %{\n   156→        name: \"www.example.com\",\n   157→        type: :aaaa,\n   158→        class: :in,\n   159→        ttl: 3600,\n   160→        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 1}\n   161→      })\n   162→\n   163→      a_records = Auth.get_records(pid, \"www.example.com\", :a)\n   164→      assert length(a_records) == 1\n   165→\n   166→      aaaa_records = Auth.get_records(pid, \"www.example.com\", :aaaa)\n   167→      assert length(aaaa_records) == 1\n   168→    end\n   169→\n   170→    test \"retrieves all records for a name with :any type\", %{zone: pid} do\n   171→      Auth.add_record(pid, %{\n   172→        name: \"multi.example.com\",\n   173→        type: :a,\n   174→        class: :in,\n   175→        ttl: 3600,\n   176→        rdata: {192, 0, 2, 1}\n   177→      })\n   178→\n   179→      Auth.add_record(pid, %{\n   180→        name: \"multi.example.com\",\n   181→        type: :txt,\n   182→        class: :in,\n   183→        ttl: 3600,\n   184→        rdata: \"test record\"\n   185→      })\n   186→\n   187→      all_records = Auth.get_records(pid, \"multi.example.com\", :any)\n   188→      assert length(all_records) == 2\n   189→    end\n   190→\n   191→    test \"returns empty list for non-existent name\", %{zone: pid} do\n   192→      records = Auth.get_records(pid, \"nonexistent.example.com\", :a)\n   193→      assert records == []\n   194→    end\n   195→  end\n   196→\n   197→  describe \"remove_record/3\" do\n   198→    test \"removes a record by name and type\", %{zone: pid} do\n   199→      Auth.add_record(pid, %{\n   200→        name: \"temp.example.com\",\n   201→        type: :a,\n   202→        class: :in,\n   203→        ttl: 3600,\n   204→        rdata: {192, 0, 2, 1}\n   205→      })\n   206→\n   207→      assert length(Auth.get_all_records(pid)) == 1\n   208→\n   209→      :ok = Auth.remove_record(pid, \"temp.example.com\", :a)\n   210→\n   211→      assert length(Auth.get_all_records(pid)) == 0\n   212→    end\n   213→\n   214→    test \"only removes matching type\", %{zone: pid} do\n   215→      Auth.add_record(pid, %{\n   216→        name: \"mixed.example.com\",\n   217→        type: :a,\n   218→        class: :in,\n   219→        ttl: 3600,\n   220→        rdata: {192, 0, 2, 1}\n   221→      })\n   222→\n   223→      Auth.add_record(pid, %{\n   224→        name: \"mixed.example.com\",\n   225→        type: :txt,\n   226→        class: :in,\n   227→        ttl: 3600,\n   228→        rdata: \"keep me\"\n   229→      })\n   230→\n   231→      :ok = Auth.remove_record(pid, \"mixed.example.com\", :a)\n   232→\n   233→      records = Auth.get_all_records(pid)\n   234→      assert length(records) == 1\n   235→      assert hd(records).type == :txt\n   236→    end\n   237→  end\n   238→\n   239→  describe \"name normalization\" do\n   240→    test \"normalizes names with trailing dots\", %{zone: pid} do\n   241→      Auth.add_record(pid, %{\n   242→        name: \"trailing.example.com.\",\n   243→        type: :a,\n   244→        class: :in,\n   245→        ttl: 3600,\n   246→        rdata: {192, 0, 2, 1}\n   247→      })\n   248→\n   249→      # Should be able to retrieve without trailing dot\n   250→      records = Auth.get_records(pid, \"trailing.example.com\", :a)\n   251→      assert length(records) == 1\n   252→    end\n   253→\n   254→    test \"normalizes case-insensitive names\", %{zone: pid} do\n   255→      Auth.add_record(pid, %{\n   256→        name: \"UPPERCASE.example.com\",\n   257→        type: :a,\n   258→        class: :in,\n   259→        ttl: 3600,\n   260→        rdata: {192, 0, 2, 1}\n   261→      })\n   262→\n   263→      # Should be able to retrieve with lowercase\n   264→      records = Auth.get_records(pid, \"uppercase.example.com\", :a)\n   265→      assert length(records) == 1\n   266→    end\n   267→  end\n   268→\n   269→  describe \"stats/1\" do\n   270→    test \"returns zone statistics\", %{zone: pid, zone_name: zone_name} do\n   271→      Auth.add_record(pid, %{\n   272→        name: \"stat.#{zone_name}\",\n   273→        type: :a,\n   274→        class: :in,\n   275→        ttl: 3600,\n   276→        rdata: {192, 0, 2, 1}\n   277→      })\n   278→\n   279→      stats = Auth.stats(pid)\n   280→\n   281→      assert stats.name == zone_name\n   282→      assert stats.record_count >= 1\n   283→      assert is_integer(stats.query_count)\n   284→      assert is_integer(stats.hit_count)\n   285→      assert is_integer(stats.miss_count)\n   286→    end\n   287→  end\n   288→\n   289→  describe \"dirty?/1\" do\n   290→    test \"marks zone as dirty after adding record\", %{zone: pid} do\n   291→      refute Auth.dirty?(pid)\n   292→\n   293→      Auth.add_record(pid, %{\n   294→        name: \"dirty.example.com\",\n   295→        type: :a,\n   296→        class: :in,\n   297→        ttl: 3600,\n   298→        rdata: {192, 0, 2, 1}\n   299→      })\n   300→\n   301→      assert Auth.dirty?(pid)\n   302→    end\n   303→  end\n   304→\n   305→  describe \"version metadata\" do\n   306→    test \"get_version/1 returns initial version\", %{zone: pid} do\n   307→      assert Auth.get_version(pid) == 1\n   308→    end\n   309→\n   310→    test \"version increments on add_record\", %{zone: pid} do\n   311→      initial_version = Auth.get_version(pid)\n   312→\n   313→      Auth.add_record(pid, %{\n   314→        name: \"v1.example.com\",\n   315→        type: :a,\n   316→        class: :in,\n   317→        ttl: 3600,\n   318→        rdata: {192, 0, 2, 1}\n   319→      })\n   320→\n   321→      assert Auth.get_version(pid) == initial_version + 1\n   322→    end\n   323→\n   324→    test \"version increments on remove_record\", %{zone: pid} do\n   325→      Auth.add_record(pid, %{\n   326→        name: \"removeme.example.com\",\n   327→        type: :a,\n   328→        class: :in,\n   329→        ttl: 3600,\n   330→        rdata: {192, 0, 2, 1}\n   331→      })\n   332→\n   333→      version_after_add = Auth.get_version(pid)\n   334→\n   335→      Auth.remove_record(pid, \"removeme.example.com\", :a)\n   336→\n   337→      assert Auth.get_version(pid) == version_after_add + 1\n   338→    end\n   339→\n   340→    test \"get_metadata/1 returns version info\", %{zone: pid} do\n   341→      metadata = Auth.get_metadata(pid)\n   342→\n   343→      assert metadata.version == 1\n   344→      assert metadata.updated_at == nil\n   345→      assert %DateTime{} = metadata.created_at\n   346→      assert metadata.dirty == false\n   347→    end\n   348→\n   349→    test \"updated_at is set after modification\", %{zone: pid} do\n   350→      assert Auth.get_metadata(pid).updated_at == nil\n   351→\n   352→      Auth.add_record(pid, %{\n   353→        name: \"update.example.com\",\n   354→        type: :a,\n   355→        class: :in,\n   356→        ttl: 3600,\n   357→        rdata: {192, 0, 2, 1}\n   358→      })\n   359→\n   360→      metadata = Auth.get_metadata(pid)\n   361→      assert %DateTime{} = metadata.updated_at\n   362→    end\n   363→\n   364→    test \"stats includes version info\", %{zone: pid, zone_name: zone_name} do\n   365→      Auth.add_record(pid, %{\n   366→        name: \"stat.#{zone_name}\",\n   367→        type: :a,\n   368→        class: :in,\n   369→        ttl: 3600,\n   370→        rdata: {192, 0, 2, 1}\n   371→      })\n   372→\n   373→      stats = Auth.stats(pid)\n   374→\n   375→      assert stats.version == 2\n   376→      assert %DateTime{} = stats.updated_at\n   377→    end\n   378→  end\n   379→\n   380→  describe \"versioned operations\" do\n   381→    test \"add_record_versioned succeeds with correct version\", %{zone: pid} do\n   382→      current_version = Auth.get_version(pid)\n   383→\n   384→      assert {:ok, new_version} =\n   385→               Auth.add_record_versioned(\n   386→                 pid,\n   387→                 %{\n   388→                   name: \"versioned.example.com\",\n   389→                   type: :a,\n   390→                   class: :in,\n   391→                   ttl: 3600,\n   392→                   rdata: {192, 0, 2, 1}\n   393→                 },\n   394→                 current_version\n   395→               )\n   396→\n   397→      assert new_version == current_version + 1\n   398→      assert Auth.get_version(pid) == new_version\n   399→    end\n   400→\n   401→    test \"add_record_versioned fails with stale version\", %{zone: pid} do\n   402→      stale_version = Auth.get_version(pid) - 1\n   403→\n   404→      assert {:error, :version_conflict} =\n   405→               Auth.add_record_versioned(\n   406→                 pid,\n   407→                 %{\n   408→                   name: \"stale.example.com\",\n   409→                   type: :a,\n   410→                   class: :in,\n   411→                   ttl: 3600,\n   412→                   rdata: {192, 0, 2, 1}\n   413→                 },\n   414→                 stale_version\n   415→               )\n   416→\n   417→      # Version should not have changed\n   418→      assert Auth.get_version(pid) == 1\n   419→    end\n   420→\n   421→    test \"add_record_versioned fails after concurrent modification\", %{zone: pid} do\n   422→      version_before = Auth.get_version(pid)\n   423→\n   424→      # Simulate concurrent modification\n   425→      Auth.add_record(pid, %{\n   426→        name: \"concurrent.example.com\",\n   427→        type: :a,\n   428→        class: :in,\n   429→        ttl: 3600,\n   430→        rdata: {192, 0, 2, 1}\n   431→      })\n   432→\n   433→      # Now try versioned add with old version\n   434→      assert {:error, :version_conflict} =\n   435→               Auth.add_record_versioned(\n   436→                 pid,\n   437→                 %{\n   438→                   name: \"delayed.example.com\",\n   439→                   type: :a,\n   440→                   class: :in,\n   441→                   ttl: 3600,\n   442→                   rdata: {192, 0, 2, 2}\n   443→                 },\n   444→                 version_before\n   445→               )\n   446→    end\n   447→\n   448→    test \"remove_record_versioned succeeds with correct version\", %{zone: pid} do\n   449→      Auth.add_record(pid, %{\n   450→        name: \"toremove.example.com\",\n   451→        type: :a,\n   452→        class: :in,\n   453→        ttl: 3600,\n   454→        rdata: {192, 0, 2, 1}\n   455→      })\n   456→\n   457→      current_version = Auth.get_version(pid)\n   458→\n   459→      assert {:ok, new_version} =\n   460→               Auth.remove_record_versioned(pid, \"toremove.example.com\", :a, current_version)\n   461→\n   462→      assert new_version == current_version + 1\n   463→    end\n   464→\n   465→    test \"remove_record_versioned fails with stale version\", %{zone: pid} do\n   466→      Auth.add_record(pid, %{\n   467→        name: \"keepme.example.com\",\n   468→        type: :a,\n   469→        class: :in,\n   470→        ttl: 3600,\n   471→        rdata: {192, 0, 2, 1}\n   472→      })\n   473→\n   474→      stale_version = Auth.get_version(pid) - 1\n   475→\n   476→      assert {:error, :version_conflict} =\n   477→               Auth.remove_record_versioned(pid, \"keepme.example.com\", :a, stale_version)\n   478→\n   479→      # Record should still exist\n   480→      assert length(Auth.get_records(pid, \"keepme.example.com\", :a)) == 1\n   481→    end\n   482→  end\n   483→end\n   484→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"7c220806-c174-4d9f-900e-6478dcb9dce0","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/test/yellow_dog/dns/zone/auth_test.exs","content":"defmodule YellowDog.Dns.Zone.AuthTest do\n  use ExUnit.Case, async: false\n\n  alias YellowDog.Dns.Zone.Auth\n\n  setup_all do\n    # Start the ZoneRegistry once for all tests\n    {:ok, _registry_pid} = Registry.start_link(keys: :unique, name: YellowDog.Dns.ZoneRegistry)\n    :ok\n  end\n\n  setup do\n    # Start an auth zone for testing with a unique name to avoid conflicts\n    zone_name = \"example-#{System.unique_integer([:positive])}.com\"\n    {:ok, pid} = Auth.start_link(name: zone_name, records: [])\n\n    on_exit(fn ->\n      # Gracefully stop the zone process, catching any errors from already-stopped processes\n      try do\n        if Process.alive?(pid) do\n          GenServer.stop(pid, :normal, 1000)\n        end\n      catch\n        :exit, _ -> :ok\n      end\n    end)\n\n    {:ok, zone: pid, zone_name: zone_name}\n  end\n\n  describe \"add_record/2 with atom types\" do\n    test \"adds A record with string name and atom type\", %{zone: pid} do\n      record = %{\n        name: \"www.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      }\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n\n      [added] = records\n      assert added.name == \"www.example.com\"\n      assert added.type == :a\n    end\n\n    test \"adds AAAA record\", %{zone: pid} do\n      record = %{\n        name: \"ipv6.example.com\",\n        type: :aaaa,\n        class: :in,\n        ttl: 3600,\n        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 1}\n      }\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n    end\n\n    test \"adds multiple records\", %{zone: pid} do\n      records = [\n        %{name: \"www.example.com\", type: :a, class: :in, ttl: 3600, rdata: {192, 0, 2, 1}},\n        %{name: \"mail.example.com\", type: :a, class: :in, ttl: 3600, rdata: {192, 0, 2, 2}},\n        %{name: \"example.com\", type: :mx, class: :in, ttl: 3600, rdata: {10, \"mail.example.com\"}}\n      ]\n\n      for record <- records do\n        assert :ok = Auth.add_record(pid, record)\n      end\n\n      all_records = Auth.get_all_records(pid)\n      assert length(all_records) == 3\n    end\n  end\n\n  describe \"add_record/2 with DNS.Message.Record struct\" do\n    test \"adds record using DNS.Message.Record.new/5\", %{zone: pid} do\n      record = DNS.Message.Record.new(\"test.example.com\", :a, :in, 3600, {10, 0, 0, 1})\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n    end\n\n    test \"adds record with Domain struct name\", %{zone: pid} do\n      domain = DNS.Message.Domain.new(\"api.example.com\")\n\n      record = %{\n        name: domain,\n        type: :a,\n        class: :in,\n        ttl: 300,\n        rdata: {10, 0, 0, 2}\n      }\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n    end\n\n    test \"adds record with RRType struct\", %{zone: pid} do\n      rtype = DNS.ResourceRecordType.new(:a)\n\n      record = %{\n        name: \"rtype.example.com\",\n        type: rtype,\n        class: :in,\n        ttl: 300,\n        rdata: {10, 0, 0, 3}\n      }\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n    end\n\n    test \"adds record with both Domain and RRType structs\", %{zone: pid} do\n      domain = DNS.Message.Domain.new(\"full.example.com\")\n      rtype = DNS.ResourceRecordType.new(:aaaa)\n\n      record = %{\n        name: domain,\n        type: rtype,\n        class: :in,\n        ttl: 600,\n        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 0x100}\n      }\n\n      assert :ok = Auth.add_record(pid, record)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n    end\n  end\n\n  describe \"get_records/3\" do\n    test \"retrieves specific record by name and type\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"www.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      Auth.add_record(pid, %{\n        name: \"www.example.com\",\n        type: :aaaa,\n        class: :in,\n        ttl: 3600,\n        rdata: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 1}\n      })\n\n      a_records = Auth.get_records(pid, \"www.example.com\", :a)\n      assert length(a_records) == 1\n\n      aaaa_records = Auth.get_records(pid, \"www.example.com\", :aaaa)\n      assert length(aaaa_records) == 1\n    end\n\n    test \"retrieves all records for a name with :any type\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"multi.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      Auth.add_record(pid, %{\n        name: \"multi.example.com\",\n        type: :txt,\n        class: :in,\n        ttl: 3600,\n        rdata: \"test record\"\n      })\n\n      all_records = Auth.get_records(pid, \"multi.example.com\", :any)\n      assert length(all_records) == 2\n    end\n\n    test \"returns empty list for non-existent name\", %{zone: pid} do\n      records = Auth.get_records(pid, \"nonexistent.example.com\", :a)\n      assert records == []\n    end\n  end\n\n  describe \"remove_record/3\" do\n    test \"removes a record by name and type\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"temp.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      assert length(Auth.get_all_records(pid)) == 1\n\n      :ok = Auth.remove_record(pid, \"temp.example.com\", :a)\n\n      assert length(Auth.get_all_records(pid)) == 0\n    end\n\n    test \"only removes matching type\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"mixed.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      Auth.add_record(pid, %{\n        name: \"mixed.example.com\",\n        type: :txt,\n        class: :in,\n        ttl: 3600,\n        rdata: \"keep me\"\n      })\n\n      :ok = Auth.remove_record(pid, \"mixed.example.com\", :a)\n\n      records = Auth.get_all_records(pid)\n      assert length(records) == 1\n      assert hd(records).type == :txt\n    end\n  end\n\n  describe \"name normalization\" do\n    test \"normalizes names with trailing dots\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"trailing.example.com.\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      # Should be able to retrieve without trailing dot\n      records = Auth.get_records(pid, \"trailing.example.com\", :a)\n      assert length(records) == 1\n    end\n\n    test \"normalizes case-insensitive names\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"UPPERCASE.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      # Should be able to retrieve with lowercase\n      records = Auth.get_records(pid, \"uppercase.example.com\", :a)\n      assert length(records) == 1\n    end\n  end\n\n  describe \"stats/1\" do\n    test \"returns zone statistics\", %{zone: pid, zone_name: zone_name} do\n      Auth.add_record(pid, %{\n        name: \"stat.#{zone_name}\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      stats = Auth.stats(pid)\n\n      assert stats.name == zone_name\n      assert stats.record_count >= 1\n      assert is_integer(stats.query_count)\n      assert is_integer(stats.hit_count)\n      assert is_integer(stats.miss_count)\n    end\n  end\n\n  describe \"dirty?/1\" do\n    test \"marks zone as dirty after adding record\", %{zone: pid} do\n      refute Auth.dirty?(pid)\n\n      Auth.add_record(pid, %{\n        name: \"dirty.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      assert Auth.dirty?(pid)\n    end\n  end\n\n  describe \"version metadata\" do\n    test \"get_version/1 returns initial version\", %{zone: pid} do\n      assert Auth.get_version(pid) == 1\n    end\n\n    test \"version increments on add_record\", %{zone: pid} do\n      initial_version = Auth.get_version(pid)\n\n      Auth.add_record(pid, %{\n        name: \"v1.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      assert Auth.get_version(pid) == initial_version + 1\n    end\n\n    test \"version increments on remove_record\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"removeme.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      version_after_add = Auth.get_version(pid)\n\n      Auth.remove_record(pid, \"removeme.example.com\", :a)\n\n      assert Auth.get_version(pid) == version_after_add + 1\n    end\n\n    test \"get_metadata/1 returns version info\", %{zone: pid} do\n      metadata = Auth.get_metadata(pid)\n\n      assert metadata.version == 1\n      assert metadata.updated_at == nil\n      assert %DateTime{} = metadata.created_at\n      assert metadata.dirty == false\n    end\n\n    test \"updated_at is set after modification\", %{zone: pid} do\n      assert Auth.get_metadata(pid).updated_at == nil\n\n      Auth.add_record(pid, %{\n        name: \"update.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      metadata = Auth.get_metadata(pid)\n      assert %DateTime{} = metadata.updated_at\n    end\n\n    test \"stats includes version info\", %{zone: pid, zone_name: zone_name} do\n      Auth.add_record(pid, %{\n        name: \"stat.#{zone_name}\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      stats = Auth.stats(pid)\n\n      assert stats.version == 2\n      assert %DateTime{} = stats.updated_at\n    end\n  end\n\n  describe \"versioned operations\" do\n    test \"add_record_versioned succeeds with correct version\", %{zone: pid} do\n      current_version = Auth.get_version(pid)\n\n      assert {:ok, new_version} =\n               Auth.add_record_versioned(\n                 pid,\n                 %{\n                   name: \"versioned.example.com\",\n                   type: :a,\n                   class: :in,\n                   ttl: 3600,\n                   rdata: {192, 0, 2, 1}\n                 },\n                 current_version\n               )\n\n      assert new_version == current_version + 1\n      assert Auth.get_version(pid) == new_version\n    end\n\n    test \"add_record_versioned fails with stale version\", %{zone: pid} do\n      stale_version = Auth.get_version(pid) - 1\n\n      assert {:error, :version_conflict} =\n               Auth.add_record_versioned(\n                 pid,\n                 %{\n                   name: \"stale.example.com\",\n                   type: :a,\n                   class: :in,\n                   ttl: 3600,\n                   rdata: {192, 0, 2, 1}\n                 },\n                 stale_version\n               )\n\n      # Version should not have changed\n      assert Auth.get_version(pid) == 1\n    end\n\n    test \"add_record_versioned fails after concurrent modification\", %{zone: pid} do\n      version_before = Auth.get_version(pid)\n\n      # Simulate concurrent modification\n      Auth.add_record(pid, %{\n        name: \"concurrent.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      # Now try versioned add with old version\n      assert {:error, :version_conflict} =\n               Auth.add_record_versioned(\n                 pid,\n                 %{\n                   name: \"delayed.example.com\",\n                   type: :a,\n                   class: :in,\n                   ttl: 3600,\n                   rdata: {192, 0, 2, 2}\n                 },\n                 version_before\n               )\n    end\n\n    test \"remove_record_versioned succeeds with correct version\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"toremove.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      current_version = Auth.get_version(pid)\n\n      assert {:ok, new_version} =\n               Auth.remove_record_versioned(pid, \"toremove.example.com\", :a, current_version)\n\n      assert new_version == current_version + 1\n    end\n\n    test \"remove_record_versioned fails with stale version\", %{zone: pid} do\n      Auth.add_record(pid, %{\n        name: \"keepme.example.com\",\n        type: :a,\n        class: :in,\n        ttl: 3600,\n        rdata: {192, 0, 2, 1}\n      })\n\n      stale_version = Auth.get_version(pid) - 1\n\n      assert {:error, :version_conflict} =\n               Auth.remove_record_versioned(pid, \"keepme.example.com\", :a, stale_version)\n\n      # Record should still exist\n      assert length(Auth.get_records(pid, \"keepme.example.com\", :a)) == 1\n    end\n  end\nend\n","numLines":484,"startLine":1,"totalLines":484}}}
