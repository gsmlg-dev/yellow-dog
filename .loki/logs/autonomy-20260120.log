{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H3mrEMMvm5Znp8B9mEcFWx","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv4 message handler using the Abyss.Handler behaviour.\n     4→\n     5→  Processes incoming DHCPv4 messages and implements the DHCP server logic\n     6→  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n     7→  messages. Emits telemetry events for monitoring and debugging.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv4.LeaseManager\n    13→\n    14→  # Telemetry events are handled via :telemetry directly\n    15→\n    16→  @doc \"\"\"\n    17→  Handles incoming DHCPv4 messages from clients.\n    18→\n    19→  ## Parameters\n    20→  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n    21→  - `state`: Handler state containing socket information\n    22→\n    23→  ## Returns\n    24→  - `{:continue, state}` - Continue handling more packets\n    25→  - `{:close, state}` - Close connection after response\n    26→  \"\"\"\n    27→  @impl true\n    28→  def handle_data({ip, port, data}, state) do\n    29→    start_time = System.monotonic_time(:microsecond)\n    30→\n    31→    try do\n    32→      message = DHCPv4.Message.from_iodata(data)\n    33→\n    34→      # Emit telemetry event for message received\n    35→      :telemetry.execute(\n    36→        [:yellow_dog, :dhcpv4, :message_received],\n    37→        %{duration: System.monotonic_time(:microsecond) - start_time},\n    38→        %{client_ip: ip, client_port: port, message_type: message.op}\n    39→      )\n    40→\n    41→      # Process the DHCP message\n    42→      handle_dhcp_message(message, ip, port, state, start_time)\n    43→    rescue\n    44→      e ->\n    45→        # Emit telemetry event for error\n    46→        :telemetry.execute(\n    47→          [:yellow_dog, :dhcpv4, :message, :error],\n    48→          %{duration: System.monotonic_time(:microsecond) - start_time},\n    49→          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n    50→        )\n    51→\n    52→        {:continue, state}\n    53→    end\n    54→  end\n    55→\n    56→  @impl true\n    57→  def handle_error(reason, state) do\n    58→    :telemetry.execute(\n    59→      [:yellow_dog, :dhcpv4, :handler, :error],\n    60→      %{count: 1},\n    61→      %{reason: inspect(reason)}\n    62→    )\n    63→\n    64→    {:continue, state}\n    65→  end\n    66→\n    67→  @impl true\n    68→  def handle_timeout(state) do\n    69→    :telemetry.execute(\n    70→      [:yellow_dog, :dhcpv4, :handler, :timeout],\n    71→      %{count: 1},\n    72→      %{}\n    73→    )\n    74→\n    75→    {:continue, state}\n    76→  end\n    77→\n    78→  # Private helper functions\n    79→\n    80→  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n    81→    case message.op do\n    82→      # BOOTREQUEST\n    83→      1 ->\n    84→        handle_boot_request(message, client_ip, client_port, state, start_time)\n    85→\n    86→      # BOOTREPLY\n    87→      2 ->\n    88→        :telemetry.execute(\n    89→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n    90→          %{count: 1},\n    91→          %{message_type: :bootreply, reason: \"should not happen on server\"}\n    92→        )\n    93→\n    94→        {:continue, state}\n    95→\n    96→      op ->\n    97→        :telemetry.execute(\n    98→          [:yellow_dog, :dhcpv4, :message, :unknown],\n    99→          %{count: 1},\n   100→          %{operation: op}\n   101→        )\n   102→\n   103→        {:continue, state}\n   104→    end\n   105→  end\n   106→\n   107→  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n   108→    case get_dhcp_message_type(message) do\n   109→      :discover ->\n   110→        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n   111→\n   112→      :request ->\n   113→        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n   114→\n   115→      :decline ->\n   116→        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n   117→\n   118→      :release ->\n   119→        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n   120→\n   121→      :inform ->\n   122→        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n   123→\n   124→      msg_type when msg_type in [:offer, :ack, :nak] ->\n   125→        :telemetry.execute(\n   126→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n   127→          %{count: 1},\n   128→          %{message_type: msg_type, reason: \"should not happen on server\"}\n   129→        )\n   130→\n   131→        {:continue, state}\n   132→\n   133→      _ ->\n   134→        :telemetry.execute(\n   135→          [:yellow_dog, :dhcpv4, :message, :unsupported],\n   136→          %{count: 1},\n   137→          %{reason: \"missing or unsupported message type option\"}\n   138→        )\n   139→\n   140→        {:continue, state}\n   141→    end\n   142→  end\n   143→\n   144→  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n   145→    :telemetry.execute(\n   146→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   147→      %{count: 1},\n   148→      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n   149→    )\n   150→\n   151→    # Generate a DHCPOFFER response\n   152→    case create_dhcp_offer(message, client_ip) do\n   153→      nil ->\n   154→        :telemetry.execute(\n   155→          [:yellow_dog, :dhcpv4, :offer, :failed],\n   156→          %{count: 1},\n   157→          %{client_mac: message.chaddr, reason: \"could not create offer\"}\n   158→        )\n   159→\n   160→      offer ->\n   161→        send_dhcp_response(offer, client_ip, client_port, state)\n   162→    end\n   163→\n   164→    # Emit telemetry event\n   165→    :telemetry.execute(\n   166→      [:yellow_dog, :dhcpv4, :discover_handled],\n   167→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   168→      %{client_ip: client_ip, client_mac: message.chaddr}\n   169→    )\n   170→\n   171→    {:continue, state}\n   172→  end\n   173→\n   174→  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n   175→    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n   176→    request_state = determine_request_state(message)\n   177→\n   178→    :telemetry.execute(\n   179→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   180→      %{count: 1},\n   181→      %{\n   182→        client_ip: client_ip,\n   183→        client_mac: message.chaddr,\n   184→        message_type: :request,\n   185→        state: request_state\n   186→      }\n   187→    )\n   188→\n   189→    # Generate a DHCPACK or DHCPNAK response based on state\n   190→    case create_dhcp_ack(message, client_ip, request_state) do\n   191→      {:ok, ack} ->\n   192→        send_dhcp_response(ack, client_ip, client_port, state)\n   193→\n   194→        :telemetry.execute(\n   195→          [:yellow_dog, :dhcpv4, :lease, :granted],\n   196→          %{duration: System.monotonic_time(:microsecond) - start_time},\n   197→          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n   198→        )\n   199→\n   200→      {:nak, reason} ->\n   201→        :telemetry.execute(\n   202→          [:yellow_dog, :dhcpv4, :lease, :rejected],\n   203→          %{count: 1},\n   204→          %{client_mac: message.chaddr, reason: reason, state: request_state}\n   205→        )\n   206→\n   207→        nak = build_dhcp_nak(message, reason)\n   208→        send_dhcp_response(nak, client_ip, client_port, state)\n   209→    end\n   210→\n   211→    {:continue, state}\n   212→  end\n   213→\n   214→  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n   215→    # Get the declined IP address\n   216→    declined_ip = get_requested_ip(message) || client_ip\n   217→\n   218→    :telemetry.execute(\n   219→      [:yellow_dog, :dhcpv4, :lease, :declined],\n   220→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   221→      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n   222→    )\n   223→\n   224→    # Mark the IP as declined in LeaseManager\n   225→    LeaseManager.decline_ip(declined_ip, message.chaddr)\n   226→\n   227→    {:continue, state}\n   228→  end\n   229→\n   230→  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n   231→    :telemetry.execute(\n   232→      [:yellow_dog, :dhcpv4, :lease, :released],\n   233→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   234→      %{client_ip: client_ip, client_mac: message.chaddr}\n   235→    )\n   236→\n   237→    # Release the lease for this MAC address\n   238→    LeaseManager.release_lease(message.chaddr)\n   239→\n   240→    {:continue, state}\n   241→  end\n   242→\n   243→  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n   244→    :telemetry.execute(\n   245→      [:yellow_dog, :dhcpv4, :inform, :received],\n   246→      %{count: 1},\n   247→      %{client_ip: client_ip, client_mac: message.chaddr}\n   248→    )\n   249→\n   250→    # Handle inform - provide configuration parameters only\n   251→    ack = create_dhcp_ack_inform(message, client_ip)\n   252→    # Send to client port 68\n   253→    send_dhcp_response(ack, client_ip, 68, state)\n   254→\n   255→    :telemetry.execute(\n   256→      [:yellow_dog, :dhcpv4, :inform, :handled],\n   257→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   258→      %{client_ip: client_ip, client_mac: message.chaddr}\n   259→    )\n   260→\n   261→    {:continue, state}\n   262→  end\n   263→\n   264→  defp create_dhcp_offer(discover, _client_ip) do\n   265→    # Extract hostname and client identifier from options if present\n   266→    hostname = get_hostname_from_options(discover.options)\n   267→    client_id = get_client_id_from_options(discover.options)\n   268→\n   269→    # Try to allocate a lease from LeaseManager\n   270→    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, \"default\", client_id) do\n   271→      {:ok, lease} ->\n   272→        # Build DHCPOFFER with lease information\n   273→        build_dhcp_offer(discover, lease)\n   274→\n   275→      {:error, :pool_exhausted} ->\n   276→        :telemetry.execute(\n   277→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   278→          %{count: 1},\n   279→          %{client_mac: discover.chaddr, operation: :offer}\n   280→        )\n   281→\n   282→        nil\n   283→\n   284→      {:error, reason} ->\n   285→        :telemetry.execute(\n   286→          [:yellow_dog, :dhcpv4, :offer, :error],\n   287→          %{count: 1},\n   288→          %{client_mac: discover.chaddr, reason: inspect(reason)}\n   289→        )\n   290→\n   291→        nil\n   292→    end\n   293→  end\n   294→\n   295→  defp build_dhcp_offer(discover, lease) do\n   296→    # Get pool configuration for network parameters\n   297→    pool = get_pool_for_lease(lease)\n   298→\n   299→    DHCPv4.Message.new()\n   300→    # BOOTREPLY = 2\n   301→    |> Map.put(:op, 2)\n   302→    |> Map.put(:htype, discover.htype)\n   303→    |> Map.put(:hlen, discover.hlen)\n   304→    |> Map.put(:xid, discover.xid)\n   305→    |> Map.put(:flags, discover.flags)\n   306→    |> Map.put(:ciaddr, 0)\n   307→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   308→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   309→    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n   310→    |> Map.put(:chaddr, discover.chaddr)\n   311→    |> Map.put(:options, build_dhcp_options(2, pool, lease))\n   312→  end\n   313→\n   314→  defp create_dhcp_ack(request, _client_ip, request_state) do\n   315→    # Extract hostname, requested IP, and client identifier\n   316→    hostname = get_hostname_from_options(request.options)\n   317→    client_id = get_client_id_from_options(request.options)\n   318→    server_id = get_server_id_from_options(request.options)\n   319→\n   320→    # Get requested IP based on state\n   321→    requested_ip =\n   322→      case request_state do\n   323→        :renewing ->\n   324→          # For RENEWING, use ciaddr (client's current IP)\n   325→          integer_to_ip_tuple(request.ciaddr)\n   326→\n   327→        :rebinding ->\n   328→          # For REBINDING, use ciaddr (client's current IP)\n   329→          integer_to_ip_tuple(request.ciaddr)\n   330→\n   331→        _ ->\n   332→          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n   333→          get_requested_ip(request)\n   334→      end\n   335→\n   336→    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n   337→    # For SELECTING state, server identifier is required and must match\n   338→    case validate_server_identifier(server_id, request_state) do\n   339→      :ok ->\n   340→        # Server ID is valid, proceed with lease allocation\n   341→        allocate_and_respond(request, requested_ip, hostname, client_id)\n   342→\n   343→      {:error, :wrong_server} ->\n   344→        # Client is requesting from a different server, silently ignore\n   345→        :telemetry.execute(\n   346→          [:yellow_dog, :dhcpv4, :request, :ignored],\n   347→          %{count: 1},\n   348→          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n   349→        )\n   350→\n   351→        {:nak, \"Wrong server identifier\"}\n   352→    end\n   353→  end\n   354→\n   355→  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n   356→    # Try to allocate/renew lease\n   357→    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n   358→      {:ok, lease} ->\n   359→        ack = build_dhcp_ack(request, lease)\n   360→        {:ok, ack}\n   361→\n   362→      {:error, :pool_exhausted} ->\n   363→        :telemetry.execute(\n   364→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   365→          %{count: 1},\n   366→          %{client_mac: request.chaddr, operation: :ack}\n   367→        )\n   368→\n   369→        {:nak, \"Address pool exhausted\"}\n   370→\n   371→      {:error, :pool_not_found} ->\n   372→        :telemetry.execute(\n   373→          [:yellow_dog, :dhcpv4, :pool, :not_found],\n   374→          %{count: 1},\n   375→          %{client_mac: request.chaddr}\n   376→        )\n   377→\n   378→        {:nak, \"Invalid network or pool\"}\n   379→\n   380→      {:error, reason} ->\n   381→        :telemetry.execute(\n   382→          [:yellow_dog, :dhcpv4, :ack, :error],\n   383→          %{count: 1},\n   384→          %{client_mac: request.chaddr, reason: inspect(reason)}\n   385→        )\n   386→\n   387→        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n   388→    end\n   389→  end\n   390→\n   391→  defp build_dhcp_ack(request, lease) do\n   392→    # Get pool configuration for network parameters\n   393→    pool = get_pool_for_lease(lease)\n   394→\n   395→    DHCPv4.Message.new()\n   396→    # BOOTREPLY = 2\n   397→    |> Map.put(:op, 2)\n   398→    |> Map.put(:htype, request.htype)\n   399→    |> Map.put(:hlen, request.hlen)\n   400→    |> Map.put(:xid, request.xid)\n   401→    |> Map.put(:flags, request.flags)\n   402→    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n   403→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   404→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   405→    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n   406→    |> Map.put(:chaddr, request.chaddr)\n   407→    |> Map.put(:options, build_dhcp_options(5, pool, lease))\n   408→  end\n   409→\n   410→  defp build_dhcp_nak(request, reason) do\n   411→    # Get default pool for server identifier\n   412→    pool = get_default_pool()\n   413→\n   414→    # Build DHCPNAK message according to RFC 2131\n   415→    DHCPv4.Message.new()\n   416→    # BOOTREPLY = 2\n   417→    |> Map.put(:op, 2)\n   418→    |> Map.put(:htype, request.htype)\n   419→    |> Map.put(:hlen, request.hlen)\n   420→    |> Map.put(:xid, request.xid)\n   421→    |> Map.put(:flags, request.flags)\n   422→    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n   423→    |> Map.put(:ciaddr, 0)\n   424→    |> Map.put(:yiaddr, 0)\n   425→    |> Map.put(:siaddr, 0)\n   426→    |> Map.put(:giaddr, 0)\n   427→    |> Map.put(:chaddr, request.chaddr)\n   428→    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n   429→  end\n   430→\n   431→  defp build_dhcp_nak_options(pool, reason) do\n   432→    # DHCPNAK options per RFC 2131\n   433→    base_options = [\n   434→      # Message type = 6 (DHCPNAK)\n   435→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n   436→      # Server identifier\n   437→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n   438→    ]\n   439→\n   440→    # Add message option if reason is provided\n   441→    options_with_message =\n   442→      if reason && is_binary(reason) && byte_size(reason) > 0 do\n   443→        message_value = :binary.copy(reason)\n   444→\n   445→        base_options ++\n   446→          [\n   447→            %DHCPv4.Message.Option{\n   448→              type: 56,\n   449→              length: byte_size(message_value),\n   450→              value: message_value\n   451→            }\n   452→          ]\n   453→      else\n   454→        base_options\n   455→      end\n   456→\n   457→    # Add end option\n   458→    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   459→  end\n   460→\n   461→  defp create_dhcp_ack_inform(inform, client_ip) do\n   462→    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n   463→    # Use first available pool for configuration parameters\n   464→    case LeaseManager.list_leases() do\n   465→      [] ->\n   466→        # No leases, use default pool\n   467→        pool = get_default_pool()\n   468→        build_dhcp_ack_inform(inform, client_ip, pool)\n   469→\n   470→      [lease | _] ->\n   471→        # Use pool from an existing lease\n   472→        pool = get_pool_for_lease(lease)\n   473→        build_dhcp_ack_inform(inform, client_ip, pool)\n   474→    end\n   475→  end\n   476→\n   477→  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n   478→    DHCPv4.Message.new()\n   479→    # BOOTREPLY = 2\n   480→    |> Map.put(:op, 2)\n   481→    |> Map.put(:htype, inform.htype)\n   482→    |> Map.put(:hlen, inform.hlen)\n   483→    |> Map.put(:xid, inform.xid)\n   484→    |> Map.put(:flags, inform.flags)\n   485→    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n   486→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   487→    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n   488→    |> Map.put(:chaddr, inform.chaddr)\n   489→    |> Map.put(:options, [\n   490→      # DHCPACK = 5\n   491→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n   492→      # server identifier\n   493→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   494→      # subnet mask\n   495→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   496→      # router\n   497→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   498→      # DNS servers\n   499→      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n   500→      # :end\n   501→      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n   502→    ])\n   503→  end\n   504→\n   505→  defp send_dhcp_response(response, client_ip, client_port, state) do\n   506→    data = DHCP.Parameter.to_iodata(response)\n   507→\n   508→    # Send response to client (port 67 for broadcast, 68 for unicast)\n   509→    response_port = if client_port == 67, do: 68, else: client_port\n   510→\n   511→    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n   512→      :ok ->\n   513→        :telemetry.execute(\n   514→          [:yellow_dog, :dhcpv4, :response, :sent],\n   515→          %{count: 1, bytes: IO.iodata_length(data)},\n   516→          %{client_ip: client_ip, client_port: response_port}\n   517→        )\n   518→\n   519→      {:error, reason} ->\n   520→        :telemetry.execute(\n   521→          [:yellow_dog, :dhcpv4, :response, :error],\n   522→          %{count: 1},\n   523→          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n   524→        )\n   525→    end\n   526→  end\n   527→\n   528→  # Helper functions for building DHCP responses\n   529→\n   530→  defp build_dhcp_options(message_type, pool, lease) do\n   531→    lease_time_binary = <<lease.lease_time::32>>\n   532→    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n   533→\n   534→    base_options = [\n   535→      # Message type\n   536→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n   537→      # Server identifier\n   538→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   539→      # Lease time\n   540→      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n   541→      # Subnet mask\n   542→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   543→      # Router\n   544→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   545→      %DHCPv4.Message.Option{\n   546→        type: 6,\n   547→        length: byte_size(dns_servers_binary),\n   548→        # DNS servers\n   549→        value: dns_servers_binary\n   550→      }\n   551→    ]\n   552→\n   553→    # Add domain name if present\n   554→    options_with_domain =\n   555→      case pool.domain_name do\n   556→        nil ->\n   557→          base_options\n   558→\n   559→        \"\" ->\n   560→          base_options\n   561→\n   562→        domain ->\n   563→          base_options ++\n   564→            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n   565→      end\n   566→\n   567→    # Add end option\n   568→    options_with_domain ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   569→  end\n   570→\n   571→  defp get_pool_for_lease(_lease) do\n   572→    # For now, use the first pool from LeaseManager state\n   573→    # In a production system, you'd look up the pool by name from _lease.pool_name\n   574→    get_default_pool()\n   575→  end\n   576→\n   577→  defp get_default_pool do\n   578→    # Return a default pool configuration\n   579→    # This should be retrieved from configuration or LeaseManager state\n   580→    %{\n   581→      name: \"default\",\n   582→      range_start: {192, 168, 1, 100},\n   583→      range_end: {192, 168, 1, 200},\n   584→      subnet_mask: {255, 255, 255, 0},\n   585→      gateway: {192, 168, 1, 1},\n   586→      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n   587→      domain_name: \"local\",\n   588→      lease_time: 86400\n   589→    }\n   590→  end\n   591→\n   592→  defp encode_dns_servers(dns_servers) do\n   593→    dns_servers\n   594→    |> Enum.map(&ip_to_binary/1)\n   595→    |> Enum.join()\n   596→  end\n   597→\n   598→  defp get_hostname_from_options(options) do\n   599→    Enum.find_value(options, fn option ->\n   600→      # Option 12 is hostname\n   601→      if option.type == 12, do: option.value, else: nil\n   602→    end)\n   603→  end\n   604→\n   605→  defp get_client_id_from_options(options) do\n   606→    Enum.find_value(options, fn option ->\n   607→      # Option 61 is client identifier\n   608→      if option.type == 61, do: option.value, else: nil\n   609→    end)\n   610→  end\n   611→\n   612→  defp get_server_id_from_options(options) do\n   613→    Enum.find_value(options, fn option ->\n   614→      # Option 54 is server identifier\n   615→      if option.type == 54, do: option.value, else: nil\n   616→    end)\n   617→  end\n   618→\n   619→  defp validate_server_identifier(nil, :renewing), do: :ok\n   620→  defp validate_server_identifier(nil, :rebinding), do: :ok\n   621→  defp validate_server_identifier(nil, _), do: :ok\n   622→\n   623→  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n   624→    # Get our server identifier (gateway IP from default pool)\n   625→    our_server_id = get_server_identifier()\n   626→\n   627→    if server_id == our_server_id do\n   628→      :ok\n   629→    else\n   630→      {:error, :wrong_server}\n   631→    end\n   632→  end\n   633→\n   634→  defp determine_request_state(request) do\n   635→    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n   636→    server_id = get_server_id_from_options(request.options)\n   637→    requested_ip = get_requested_ip(request)\n   638→    ciaddr = request.ciaddr\n   639→\n   640→    cond do\n   641→      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n   642→      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n   643→        :selecting\n   644→\n   645→      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n   646→      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n   647→        :init_reboot\n   648→\n   649→      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n   650→      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n   651→        :renewing\n   652→\n   653→      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n   654→      ciaddr != 0 && server_id == nil ->\n   655→        :rebinding\n   656→\n   657→      # Default to selecting if we can't determine\n   658→      true ->\n   659→        :selecting\n   660→    end\n   661→  end\n   662→\n   663→  defp integer_to_ip_tuple(0), do: nil\n   664→\n   665→  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n   666→    a = div(ip_int, 256 * 256 * 256)\n   667→    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n   668→    c = div(rem(ip_int, 256 * 256), 256)\n   669→    d = rem(ip_int, 256)\n   670→    {a, b, c, d}\n   671→  end\n   672→\n   673→  defp get_server_identifier do\n   674→    # Get the gateway IP from the default pool as our server identifier\n   675→    pool = get_default_pool()\n   676→    ip_to_binary(pool.gateway)\n   677→  end\n   678→\n   679→  defp get_requested_ip(request) do\n   680→    Enum.find_value(request.options, fn option ->\n   681→      if option.type == 50, do: binary_to_ip(option.value), else: nil\n   682→    end)\n   683→  end\n   684→\n   685→  defp get_dhcp_message_type(message) do\n   686→    Enum.find_value(message.options, 0, fn option ->\n   687→      if option.type == 53, do: decode_message_type(option.value), else: nil\n   688→    end)\n   689→  end\n   690→\n   691→  defp decode_message_type(<<1>>), do: :discover\n   692→  defp decode_message_type(<<2>>), do: :offer\n   693→  defp decode_message_type(<<3>>), do: :request\n   694→  defp decode_message_type(<<4>>), do: :decline\n   695→  defp decode_message_type(<<5>>), do: :ack\n   696→  defp decode_message_type(<<6>>), do: :nak\n   697→  defp decode_message_type(<<7>>), do: :release\n   698→  defp decode_message_type(<<8>>), do: :inform\n   699→  defp decode_message_type(_), do: 0\n   700→\n   701→  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n   702→  defp binary_to_ip(_), do: nil\n   703→\n   704→  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n   705→  defp ip_to_binary(_), do: <<192, 168, 1, 1>>\n   706→\n   707→  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n   708→  defp ip_tuple_to_integer({a, b, c, d})\n   709→       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n   710→    <<integer::32>> = <<a, b, c, d>>\n   711→    integer\n   712→  end\n   713→\n   714→  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n   715→  defp ip_tuple_to_integer(_), do: 0\n   716→end\n   717→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"b49a63bc-ee1e-4ae2-a6ca-aa40b332ff5a","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/handler.ex","content":"defmodule YellowDog.Dhcpv4.Handler do\n  @moduledoc \"\"\"\n  DHCPv4 message handler using the Abyss.Handler behaviour.\n\n  Processes incoming DHCPv4 messages and implements the DHCP server logic\n  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n  messages. Emits telemetry events for monitoring and debugging.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv4.LeaseManager\n\n  # Telemetry events are handled via :telemetry directly\n\n  @doc \"\"\"\n  Handles incoming DHCPv4 messages from clients.\n\n  ## Parameters\n  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n  - `state`: Handler state containing socket information\n\n  ## Returns\n  - `{:continue, state}` - Continue handling more packets\n  - `{:close, state}` - Close connection after response\n  \"\"\"\n  @impl true\n  def handle_data({ip, port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    try do\n      message = DHCPv4.Message.from_iodata(data)\n\n      # Emit telemetry event for message received\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :message_received],\n        %{duration: System.monotonic_time(:microsecond) - start_time},\n        %{client_ip: ip, client_port: port, message_type: message.op}\n      )\n\n      # Process the DHCP message\n      handle_dhcp_message(message, ip, port, state, start_time)\n    rescue\n      e ->\n        # Emit telemetry event for error\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :error],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @impl true\n  def handle_error(reason, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(reason)}\n    )\n\n    {:continue, state}\n  end\n\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private helper functions\n\n  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n    case message.op do\n      # BOOTREQUEST\n      1 ->\n        handle_boot_request(message, client_ip, client_port, state, start_time)\n\n      # BOOTREPLY\n      2 ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: :bootreply, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      op ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unknown],\n          %{count: 1},\n          %{operation: op}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n    case get_dhcp_message_type(message) do\n      :discover ->\n        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n\n      :request ->\n        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n\n      :decline ->\n        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n\n      :release ->\n        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n\n      :inform ->\n        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n\n      msg_type when msg_type in [:offer, :ack, :nak] ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: msg_type, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unsupported],\n          %{count: 1},\n          %{reason: \"missing or unsupported message type option\"}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n    )\n\n    # Generate a DHCPOFFER response\n    case create_dhcp_offer(message, client_ip) do\n      nil ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :offer, :failed],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: \"could not create offer\"}\n        )\n\n      offer ->\n        send_dhcp_response(offer, client_ip, client_port, state)\n    end\n\n    # Emit telemetry event\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :discover_handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n    request_state = determine_request_state(message)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{\n        client_ip: client_ip,\n        client_mac: message.chaddr,\n        message_type: :request,\n        state: request_state\n      }\n    )\n\n    # Generate a DHCPACK or DHCPNAK response based on state\n    case create_dhcp_ack(message, client_ip, request_state) do\n      {:ok, ack} ->\n        send_dhcp_response(ack, client_ip, client_port, state)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :granted],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n        )\n\n      {:nak, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :rejected],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: reason, state: request_state}\n        )\n\n        nak = build_dhcp_nak(message, reason)\n        send_dhcp_response(nak, client_ip, client_port, state)\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n    # Get the declined IP address\n    declined_ip = get_requested_ip(message) || client_ip\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :declined],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n    )\n\n    # Mark the IP as declined in LeaseManager\n    LeaseManager.decline_ip(declined_ip, message.chaddr)\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :released],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Release the lease for this MAC address\n    LeaseManager.release_lease(message.chaddr)\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :received],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Handle inform - provide configuration parameters only\n    ack = create_dhcp_ack_inform(message, client_ip)\n    # Send to client port 68\n    send_dhcp_response(ack, client_ip, 68, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp create_dhcp_offer(discover, _client_ip) do\n    # Extract hostname and client identifier from options if present\n    hostname = get_hostname_from_options(discover.options)\n    client_id = get_client_id_from_options(discover.options)\n\n    # Try to allocate a lease from LeaseManager\n    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, \"default\", client_id) do\n      {:ok, lease} ->\n        # Build DHCPOFFER with lease information\n        build_dhcp_offer(discover, lease)\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: discover.chaddr, operation: :offer}\n        )\n\n        nil\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :offer, :error],\n          %{count: 1},\n          %{client_mac: discover.chaddr, reason: inspect(reason)}\n        )\n\n        nil\n    end\n  end\n\n  defp build_dhcp_offer(discover, lease) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, discover.htype)\n    |> Map.put(:hlen, discover.hlen)\n    |> Map.put(:xid, discover.xid)\n    |> Map.put(:flags, discover.flags)\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n    |> Map.put(:chaddr, discover.chaddr)\n    |> Map.put(:options, build_dhcp_options(2, pool, lease))\n  end\n\n  defp create_dhcp_ack(request, _client_ip, request_state) do\n    # Extract hostname, requested IP, and client identifier\n    hostname = get_hostname_from_options(request.options)\n    client_id = get_client_id_from_options(request.options)\n    server_id = get_server_id_from_options(request.options)\n\n    # Get requested IP based on state\n    requested_ip =\n      case request_state do\n        :renewing ->\n          # For RENEWING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        :rebinding ->\n          # For REBINDING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        _ ->\n          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n          get_requested_ip(request)\n      end\n\n    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n    # For SELECTING state, server identifier is required and must match\n    case validate_server_identifier(server_id, request_state) do\n      :ok ->\n        # Server ID is valid, proceed with lease allocation\n        allocate_and_respond(request, requested_ip, hostname, client_id)\n\n      {:error, :wrong_server} ->\n        # Client is requesting from a different server, silently ignore\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :request, :ignored],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n        )\n\n        {:nak, \"Wrong server identifier\"}\n    end\n  end\n\n  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n    # Try to allocate/renew lease\n    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n      {:ok, lease} ->\n        ack = build_dhcp_ack(request, lease)\n        {:ok, ack}\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: request.chaddr, operation: :ack}\n        )\n\n        {:nak, \"Address pool exhausted\"}\n\n      {:error, :pool_not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :not_found],\n          %{count: 1},\n          %{client_mac: request.chaddr}\n        )\n\n        {:nak, \"Invalid network or pool\"}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :ack, :error],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: inspect(reason)}\n        )\n\n        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n    end\n  end\n\n  defp build_dhcp_ack(request, lease) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_options(5, pool, lease))\n  end\n\n  defp build_dhcp_nak(request, reason) do\n    # Get default pool for server identifier\n    pool = get_default_pool()\n\n    # Build DHCPNAK message according to RFC 2131\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, 0)\n    |> Map.put(:siaddr, 0)\n    |> Map.put(:giaddr, 0)\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n  end\n\n  defp build_dhcp_nak_options(pool, reason) do\n    # DHCPNAK options per RFC 2131\n    base_options = [\n      # Message type = 6 (DHCPNAK)\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n    ]\n\n    # Add message option if reason is provided\n    options_with_message =\n      if reason && is_binary(reason) && byte_size(reason) > 0 do\n        message_value = :binary.copy(reason)\n\n        base_options ++\n          [\n            %DHCPv4.Message.Option{\n              type: 56,\n              length: byte_size(message_value),\n              value: message_value\n            }\n          ]\n      else\n        base_options\n      end\n\n    # Add end option\n    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp create_dhcp_ack_inform(inform, client_ip) do\n    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n    # Use first available pool for configuration parameters\n    case LeaseManager.list_leases() do\n      [] ->\n        # No leases, use default pool\n        pool = get_default_pool()\n        build_dhcp_ack_inform(inform, client_ip, pool)\n\n      [lease | _] ->\n        # Use pool from an existing lease\n        pool = get_pool_for_lease(lease)\n        build_dhcp_ack_inform(inform, client_ip, pool)\n    end\n  end\n\n  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, inform.htype)\n    |> Map.put(:hlen, inform.hlen)\n    |> Map.put(:xid, inform.xid)\n    |> Map.put(:flags, inform.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n    |> Map.put(:chaddr, inform.chaddr)\n    |> Map.put(:options, [\n      # DHCPACK = 5\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n      # server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      # DNS servers\n      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n      # :end\n      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n    ])\n  end\n\n  defp send_dhcp_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    # Send response to client (port 67 for broadcast, 68 for unicast)\n    response_port = if client_port == 67, do: 68, else: client_port\n\n    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :sent],\n          %{count: 1, bytes: IO.iodata_length(data)},\n          %{client_ip: client_ip, client_port: response_port}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :error],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Helper functions for building DHCP responses\n\n  defp build_dhcp_options(message_type, pool, lease) do\n    lease_time_binary = <<lease.lease_time::32>>\n    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n\n    base_options = [\n      # Message type\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # Lease time\n      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n      # Subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # Router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      %DHCPv4.Message.Option{\n        type: 6,\n        length: byte_size(dns_servers_binary),\n        # DNS servers\n        value: dns_servers_binary\n      }\n    ]\n\n    # Add domain name if present\n    options_with_domain =\n      case pool.domain_name do\n        nil ->\n          base_options\n\n        \"\" ->\n          base_options\n\n        domain ->\n          base_options ++\n            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n      end\n\n    # Add end option\n    options_with_domain ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use the first pool from LeaseManager state\n    # In a production system, you'd look up the pool by name from _lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    # Return a default pool configuration\n    # This should be retrieved from configuration or LeaseManager state\n    %{\n      name: \"default\",\n      range_start: {192, 168, 1, 100},\n      range_end: {192, 168, 1, 200},\n      subnet_mask: {255, 255, 255, 0},\n      gateway: {192, 168, 1, 1},\n      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n      domain_name: \"local\",\n      lease_time: 86400\n    }\n  end\n\n  defp encode_dns_servers(dns_servers) do\n    dns_servers\n    |> Enum.map(&ip_to_binary/1)\n    |> Enum.join()\n  end\n\n  defp get_hostname_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 12 is hostname\n      if option.type == 12, do: option.value, else: nil\n    end)\n  end\n\n  defp get_client_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 61 is client identifier\n      if option.type == 61, do: option.value, else: nil\n    end)\n  end\n\n  defp get_server_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 54 is server identifier\n      if option.type == 54, do: option.value, else: nil\n    end)\n  end\n\n  defp validate_server_identifier(nil, :renewing), do: :ok\n  defp validate_server_identifier(nil, :rebinding), do: :ok\n  defp validate_server_identifier(nil, _), do: :ok\n\n  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n    # Get our server identifier (gateway IP from default pool)\n    our_server_id = get_server_identifier()\n\n    if server_id == our_server_id do\n      :ok\n    else\n      {:error, :wrong_server}\n    end\n  end\n\n  defp determine_request_state(request) do\n    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n    server_id = get_server_id_from_options(request.options)\n    requested_ip = get_requested_ip(request)\n    ciaddr = request.ciaddr\n\n    cond do\n      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n        :selecting\n\n      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n        :init_reboot\n\n      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n        :renewing\n\n      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n      ciaddr != 0 && server_id == nil ->\n        :rebinding\n\n      # Default to selecting if we can't determine\n      true ->\n        :selecting\n    end\n  end\n\n  defp integer_to_ip_tuple(0), do: nil\n\n  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n    a = div(ip_int, 256 * 256 * 256)\n    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n    c = div(rem(ip_int, 256 * 256), 256)\n    d = rem(ip_int, 256)\n    {a, b, c, d}\n  end\n\n  defp get_server_identifier do\n    # Get the gateway IP from the default pool as our server identifier\n    pool = get_default_pool()\n    ip_to_binary(pool.gateway)\n  end\n\n  defp get_requested_ip(request) do\n    Enum.find_value(request.options, fn option ->\n      if option.type == 50, do: binary_to_ip(option.value), else: nil\n    end)\n  end\n\n  defp get_dhcp_message_type(message) do\n    Enum.find_value(message.options, 0, fn option ->\n      if option.type == 53, do: decode_message_type(option.value), else: nil\n    end)\n  end\n\n  defp decode_message_type(<<1>>), do: :discover\n  defp decode_message_type(<<2>>), do: :offer\n  defp decode_message_type(<<3>>), do: :request\n  defp decode_message_type(<<4>>), do: :decline\n  defp decode_message_type(<<5>>), do: :ack\n  defp decode_message_type(<<6>>), do: :nak\n  defp decode_message_type(<<7>>), do: :release\n  defp decode_message_type(<<8>>), do: :inform\n  defp decode_message_type(_), do: 0\n\n  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n  defp binary_to_ip(_), do: nil\n\n  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n  defp ip_to_binary(_), do: <<192, 168, 1, 1>>\n\n  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n  defp ip_tuple_to_integer({a, b, c, d})\n       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n    <<integer::32>> = <<a, b, c, d>>\n    integer\n  end\n\n  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n  defp ip_tuple_to_integer(_), do: 0\nend\n","numLines":717,"startLine":1,"totalLines":717}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141i4mMAMyMx8PmBAjLCFZm","type":"tool_result","content":"     1→defmodule Abyss.Handler do\n     2→  @moduledoc \"\"\"\n     3→  `Abyss.Handler` defines the behaviour required of the application layer of a Abyss server.\n     4→\n     5→  # Example\n     6→\n     7→  Another example of a server that echoes back all data sent to it is as follows:\n     8→\n     9→  ```elixir\n    10→  defmodule Echo do\n    11→    use Abyss.Handler\n    12→\n    13→    @impl Abyss.Handler\n    14→    def handle_data(data, state) do\n    15→      Abyss.Transport.UDP.send(state.socket, data)\n    16→      {:continue, state}\n    17→    end\n    18→  end\n    19→  ```\n    20→\n    21→  Note that in this example there is no `c:handle_connection/2` callback defined. The default implementation of this\n    22→  callback will simply return `{:continue, state}`, which is appropriate for cases where the client is the first\n    23→  party to communicate.\n    24→\n    25→  Another example of a server which can send and receive messages asynchronously is as follows:\n    26→\n    27→  ```elixir\n    28→  defmodule Messenger do\n    29→    use Abyss.Handler\n    30→\n    31→    @impl Abyss.Handler\n    32→    def handle_data(msg, state) do\n    33→      IO.inspect(msg)\n    34→      {:continue, state}\n    35→    end\n    36→\n    37→    def handle_info({:udp, socket, ip, port, data}, state) do\n    38→      Abyss.Transport.UDP.send(socket, ip, port, msg)\n    39→      {:noreply, state, state.read_timeout}\n    40→    end\n    41→  end\n    42→  ```\n    43→\n    44→  Note that in this example we make use of the fact that the handler process is really just a GenServer to send it messages\n    45→  which are able to make use of the underlying socket. This allows for bidirectional sending and receiving of messages in\n    46→  an asynchronous manner.\n    47→\n    48→  You can pass options to the default handler underlying `GenServer` by passing a `genserver_options` key to `Abyss.start_link/1`\n    49→  containing `t:GenServer.options/0` to be passed to the last argument of `GenServer.start_link/3`.\n    50→\n    51→  Please note that you should not pass the `name` `t:GenServer.option/0`. If you need to register handler processes for\n    52→  later lookup and use, you should perform process registration in `handle_connection/2`, ensuring the handler process is\n    53→  registered only after the underlying connection is established and you have access to the connection socket and metadata\n    54→  via `Abyss.Transport.UDP.peername/1`.\n    55→\n    56→  For example, using a custom process registry via `Registry`:\n    57→\n    58→  ```elixir\n    59→\n    60→  defmodule Messenger do\n    61→    use Abyss.Handler\n    62→\n    63→    @impl Abyss.Handler\n    64→    def handle_data(recv_data, state) do\n    65→      {ip, port, data} = recv_data\n    66→      Abyss.Transport.UDP.send(state.socket, ip, port, data)\n    67→      {:continue, state}\n    68→    end\n    69→  end\n    70→  ```\n    71→\n    72→  This example assumes you have started a `Registry` and registered it under the name `MessengerRegistry`.\n    73→\n    74→  # When Handler Isn't Enough\n    75→\n    76→  The `use Abyss.Handler` implementation should be flexible enough to power just about any handler, however if\n    77→  this should not be the case for you, there is an escape hatch available. If you require more flexibility than the\n    78→  `Abyss.Handler` behaviour provides, you are free to specify any module which implements `start_link/1` as the\n    79→  `handler_module` parameter. The process of getting from this new process to a ready-to-use socket is somewhat\n    80→  delicate, however. The steps required are as follows:\n    81→\n    82→  1. Abyss calls `start_link/1` on the configured `handler_module`, passing in a tuple\n    83→  consisting of the configured handler and genserver opts. This function is expected to return a\n    84→  conventional `GenServer.on_start()` style tuple. Note that this newly created process is not\n    85→  passed the connection socket immediately.\n    86→  2. The raw `t:Abyss.Transport.socket()` socket will be passed to the new process via a\n    87→  message of the form `{:abyss_received, listener_socket, server_config, acceptor_span,\n    88→  start_time}`.\n    89→  3. Your implenentation must turn this into a `to::inet.socket()` socket by using the\n    90→  `Abyss.Transport.UDP.new/3` call.\n    91→  4. Your implementation must then call `Abyss.Transport.UDP.handshake/1` with the socket as the\n    92→  sole argument in order to finalize the setup of the socket.\n    93→  5. The socket is now ready to use.\n    94→\n    95→  In addition to this process, there are several other considerations to be aware of:\n    96→\n    97→  * The underlying socket is closed automatically when the handler process ends.\n    98→\n    99→  * Handler processes should have a restart strategy of `:temporary` to ensure that Abyss does not attempt to\n   100→  restart crashed handlers.\n   101→\n   102→  * Handler processes should trap exit if possible so that existing connections can be given a chance to cleanly shut\n   103→  down when shutting down a Abyss server instance.\n   104→\n   105→  * Some of the `:connection` family of telemetry span events are emitted by the\n   106→  `Abyss.Handler` implementation. If you use your own implementation in its place it is\n   107→  likely that such spans will not behave as expected.\n   108→  \"\"\"\n   109→\n   110→  @typedoc \"The possible ways to indicate a timeout when returning values to Abyss\"\n   111→  @type timeout_options :: timeout() | {:persistent, timeout()}\n   112→\n   113→  @typedoc \"The value returned by `c:handle_connection/2` and `c:handle_data/3`\"\n   114→  @type handler_result ::\n   115→          {:continue, state :: term()}\n   116→          | {:continue, state :: term(), timeout_options()}\n   117→          | {:close, state :: term()}\n   118→          | {:error, term(), state :: term()}\n   119→\n   120→  @doc \"\"\"\n   121→  This callback is called whenever client data is received after `c:handle_connection/2` or `c:handle_data/3` have returned an\n   122→  `{:continue, state}` tuple. The data received is passed as the first argument, and handlers may choose to interact\n   123→  synchronously with the socket in this callback via calls to various `Abyss.Transport.UDP` functions.\n   124→\n   125→  The value returned by this callback causes Abyss to proceed in one of several ways:\n   126→\n   127→  * Returning `{:close, state}` will cause Abyss to close the socket & call the `c:handle_close/2` callback to\n   128→  allow final cleanup to be done.\n   129→  * Returning `{:continue, state}` will cause Abyss to switch the socket to an asynchronous mode. When the\n   130→  client subsequently sends data (or if there is already unread data waiting from the client), Abyss will call\n   131→  `c:handle_data/3` to allow this data to be processed.\n   132→  * Returning `{:continue, state, timeout}` is identical to the previous case with the\n   133→  addition of a timeout. If `timeout` milliseconds passes with no data being received or messages\n   134→  being sent to the process, the socket will be closed and `c:handle_timeout/2` will be called.\n   135→  Note that this timeout is not persistent; it applies only to the interval until the next message\n   136→  is received. In order to set a persistent timeout for all future messages (essentially\n   137→  overwriting the value of `read_timeout` that was set at server startup), a value of\n   138→  `{:persistent, timeout}` may be returned.\n   139→  * Returning `{:error, reason, state}` will cause Abyss to close the socket & call the `c:handle_error/3` callback to\n   140→  allow final cleanup to be done.\n   141→  \"\"\"\n   142→  @callback handle_data(data :: Abyss.Transport.recv_data(), state :: term()) ::\n   143→              handler_result()\n   144→\n   145→  @doc \"\"\"\n   146→  This callback is called when the underlying socket is closed by the remote end; it should perform any cleanup required\n   147→  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n   148→  has already been closed by the time this callback is called. The return value is ignored.\n   149→\n   150→  This callback is not called if the connection is explicitly closed via `Abyss.Transport.UDP.close/1`, however it\n   151→  will be called in cases where `handle_connection/2` or `handle_data/3` return a `{:close, state}` tuple.\n   152→  \"\"\"\n   153→  @callback handle_close(state :: term()) :: term()\n   154→\n   155→  @doc \"\"\"\n   156→  This callback is called when the underlying socket encounters an error; it should perform any cleanup required\n   157→  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n   158→  has already been closed by the time this callback is called. The return value is ignored.\n   159→\n   160→  In addition to socket level errors, this callback is also called in cases where `handle_connection/2` or `handle_data/3`\n   161→  return a `{:error, reason, state}` tuple, or when connection handshaking (typically TLS\n   162→  negotiation) fails.\n   163→  \"\"\"\n   164→  @callback handle_error(reason :: any(), state :: term()) ::\n   165→              term()\n   166→\n   167→  @doc \"\"\"\n   168→  This callback is called when the server process itself is being shut down; it should perform any cleanup required\n   169→  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n   170→  has NOT been closed by the time this callback is called. The return value is ignored.\n   171→\n   172→  This callback is only called when the shutdown reason is `:normal`, and is subject to the same caveats described\n   173→  in `c:GenServer.terminate/2`.\n   174→  \"\"\"\n   175→  @callback handle_shutdown(state :: term()) :: term()\n   176→\n   177→  @doc \"\"\"\n   178→  This callback is called when a handler process has gone more than `timeout` ms without receiving\n   179→  either remote data or a local message. The value used for `timeout` defaults to the\n   180→  `read_timeout` value specified at server startup, and may be overridden on a one-shot or\n   181→  persistent basis based on values returned from `c:handle_connection/2` or `c:handle_data/3`\n   182→  calls. Note that it is NOT called on explicit `Abyss.Transport.UDP.recv/3` calls as they have\n   183→  their own timeout semantics. The underlying socket has NOT been closed by the time this callback\n   184→  is called. The return value is ignored.\n   185→  \"\"\"\n   186→  @callback handle_timeout(state :: term()) :: term()\n   187→\n   188→  @optional_callbacks handle_data: 2,\n   189→                      handle_error: 2,\n   190→                      handle_close: 1,\n   191→                      handle_shutdown: 1,\n   192→                      handle_timeout: 1\n   193→\n   194→  @spec __using__(any) :: Macro.t()\n   195→  defmacro __using__(_opts) do\n   196→    quote location: :keep do\n   197→      @behaviour Abyss.Handler\n   198→\n   199→      use GenServer, restart: :temporary\n   200→\n   201→      def start_link(args) do\n   202→        GenServer.start_link(__MODULE__, args)\n   203→      end\n   204→\n   205→      unquote(genserver_impl())\n   206→      unquote(handler_impl())\n   207→    end\n   208→  end\n   209→\n   210→  @doc false\n   211→  defmacro add_handle_info_fallback(_module) do\n   212→    quote do\n   213→      def handle_info({msg, _raw_ip, _port, _data}, _state) when msg in [:udp] do\n   214→        raise \"\"\"\n   215→          The callback's `state` doesn't match the expected `{socket, state}` form.\n   216→          Please ensure that you are returning a `{socket, state}` tuple from any\n   217→          `GenServer.handle_*` callbacks you have implemented\n   218→        \"\"\"\n   219→      end\n   220→    end\n   221→  end\n   222→\n   223→  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity\n   224→  def genserver_impl do\n   225→    quote do\n   226→      @impl GenServer\n   227→      def init({connection_span, server_config, listener_pid, listener_socket}) do\n   228→        Process.flag(:trap_exit, true)\n   229→\n   230→        # Start memory monitoring for long-running handlers\n   231→        # Check every 10 seconds\n   232→        Process.send_after(self(), :memory_check, 10_000)\n   233→\n   234→        {:ok,\n   235→         %{\n   236→           connection_span: connection_span,\n   237→           server_config: server_config,\n   238→           listener: listener_pid,\n   239→           broadcast: server_config.broadcast,\n   240→           socket: listener_socket,\n   241→           read_timeout: server_config.read_timeout,\n   242→           # Track last 10 processing times for adaptive timeout\n   243→           processing_times: [],\n   244→           adaptive_timeout: server_config.read_timeout,\n   245→           memory_check_interval: server_config.handler_memory_check_interval\n   246→         }}\n   247→      end\n   248→\n   249→      @impl GenServer\n   250→      def handle_info(\n   251→            {:new_connection, listener_socket, recv_data},\n   252→            %{broadcast: false} = state\n   253→          ) do\n   254→        Abyss.Telemetry.span_event(state.connection_span, :ready)\n   255→        {:noreply, state, {:continue, {:handle_data, recv_data}}}\n   256→      catch\n   257→        {:stop, _, _} = stop -> stop\n   258→      end\n   259→\n   260→      def handle_info(\n   261→            {:new_connection, listener_socket, recv_data},\n   262→            %{broadcast: true} = state\n   263→          ) do\n   264→        {:noreply, state, {:continue, {:handle_broadcast_data, recv_data}}}\n   265→      catch\n   266→        {:stop, _, _} = stop -> stop\n   267→      end\n   268→\n   269→      def handle_info(:timeout, state) do\n   270→        {:stop, {:shutdown, :timeout}, state}\n   271→      end\n   272→\n   273→      def handle_info(:memory_check, %{memory_check_interval: interval} = state) do\n   274→        case :erlang.process_info(self(), :memory) do\n   275→          {:memory, memory_words} ->\n   276→            memory_mb = memory_words * :erlang.system_info(:wordsize) / (1024 * 1024)\n   277→            warning_threshold = state.server_config.handler_memory_warning_threshold\n   278→            hard_limit = state.server_config.handler_memory_hard_limit\n   279→\n   280→            if memory_mb > warning_threshold do\n   281→              # Log memory warning via telemetry\n   282→              :telemetry.execute(\n   283→                [:abyss, :handler, :memory_warning],\n   284→                %{memory_mb: memory_mb},\n   285→                %{handler_pid: self(), threshold: warning_threshold}\n   286→              )\n   287→\n   288→              # Trigger garbage collection\n   289→              :erlang.garbage_collect(self())\n   290→\n   291→              # Check if memory is still high after GC\n   292→              case :erlang.process_info(self(), :memory) do\n   293→                {:memory, new_memory_words} ->\n   294→                  new_memory_mb =\n   295→                    new_memory_words * :erlang.system_info(:wordsize) / (1024 * 1024)\n   296→\n   297→                  if new_memory_mb > hard_limit do\n   298→                    {:stop, {:shutdown, :memory_limit_exceeded}, state}\n   299→                  else\n   300→                    Process.send_after(self(), :memory_check, interval)\n   301→                    {:noreply, state}\n   302→                  end\n   303→\n   304→                _ ->\n   305→                  Process.send_after(self(), :memory_check, interval)\n   306→                  {:noreply, state}\n   307→              end\n   308→            else\n   309→              Process.send_after(self(), :memory_check, interval)\n   310→              {:noreply, state}\n   311→            end\n   312→\n   313→          _ ->\n   314→            Process.send_after(self(), :memory_check, interval)\n   315→            {:noreply, state}\n   316→        end\n   317→      end\n   318→\n   319→      @before_compile {Abyss.Handler, :add_handle_info_fallback}\n   320→\n   321→      # Use a continue pattern here so that we have committed the socket\n   322→      # to state in case the `c:handle_connection/2` callback raises an error.\n   323→      # This ensures that the `c:terminate/2` calls below are able to properly\n   324→      # close down the process\n   325→      @impl true\n   326→      def handle_continue({:handle_data, recv_data}, %{processing_times: times} = state) do\n   327→        start_time = System.monotonic_time()\n   328→\n   329→        result = __MODULE__.handle_data(recv_data, state)\n   330→        processing_time = System.monotonic_time() - start_time\n   331→\n   332→        # Keep last 10 processing times for adaptive timeout calculation\n   333→        new_times = [processing_time | Enum.take(times, 9)]\n   334→        new_state = %{state | processing_times: new_times}\n   335→\n   336→        # Calculate adaptive timeout based on processing history\n   337→        adaptive_timeout = Abyss.Handler.calculate_adaptive_timeout(state.read_timeout, new_times)\n   338→        final_state = %{new_state | adaptive_timeout: adaptive_timeout}\n   339→\n   340→        result\n   341→        |> Abyss.Handler.handle_continuation(final_state)\n   342→      end\n   343→\n   344→      def handle_continue({:handle_broadcast_data, recv_data}, state) do\n   345→        _reason = __MODULE__.handle_data(recv_data, state)\n   346→        Process.send_after(self(), :broadcast, 10)\n   347→        {:stop, {:shutdown, :broadcast}, state}\n   348→      end\n   349→\n   350→      @impl true\n   351→      def terminate({:shutdown, :broadcast}, %{connection_span: connection_span} = state) do\n   352→        # Track connection closure\n   353→        Abyss.Telemetry.track_connection_closed()\n   354→\n   355→        # Calculate response time if we have accept start time\n   356→        response_time = calculate_response_time(state)\n   357→\n   358→        if response_time do\n   359→          Abyss.Telemetry.track_response_sent(response_time)\n   360→        end\n   361→\n   362→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :broadcast})\n   363→\n   364→        :ok\n   365→      end\n   366→\n   367→      # Called by GenServer if we hit our read_timeout. Socket is still open\n   368→      def terminate(\n   369→            {:shutdown, :timeout},\n   370→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   371→              state\n   372→          ) do\n   373→        out = __MODULE__.handle_timeout(state)\n   374→        # Only call controlling_process if socket is not a reference (test environment)\n   375→        if not is_reference(listener_socket) do\n   376→          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n   377→        end\n   378→\n   379→        # Track connection closure\n   380→        Abyss.Telemetry.track_connection_closed()\n   381→\n   382→        # Calculate response time if we have accept start time\n   383→        response_time = calculate_response_time(state)\n   384→\n   385→        if response_time do\n   386→          Abyss.Telemetry.track_response_sent(response_time)\n   387→        end\n   388→\n   389→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :timeout})\n   390→        out\n   391→      end\n   392→\n   393→      # Called if we're being shutdown in an orderly manner. Socket is still open\n   394→      def terminate(\n   395→            :shutdown,\n   396→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   397→              state\n   398→          ) do\n   399→        out = __MODULE__.handle_shutdown(state)\n   400→        # Only call controlling_process if socket is not a reference (test environment)\n   401→        if not is_reference(listener_socket) do\n   402→          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n   403→        end\n   404→\n   405→        # Track connection closure\n   406→        Abyss.Telemetry.track_connection_closed()\n   407→\n   408→        # Calculate response time if we have accept start time\n   409→        response_time = calculate_response_time(state)\n   410→\n   411→        if response_time do\n   412→          Abyss.Telemetry.track_response_sent(response_time)\n   413→        end\n   414→\n   415→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :shutdown})\n   416→        out\n   417→      end\n   418→\n   419→      # Called if the socket encountered an error and we are configured to shutdown silently.\n   420→      # Socket is closed\n   421→      def terminate(\n   422→            {:shutdown, {:silent_termination, reason}},\n   423→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   424→              state\n   425→          ) do\n   426→        out =\n   427→          __MODULE__.handle_error(\n   428→            reason,\n   429→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   430→              state\n   431→          )\n   432→\n   433→        # Only call controlling_process if socket is not a reference (test environment)\n   434→        if not is_reference(listener_socket) do\n   435→          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n   436→        end\n   437→\n   438→        # Track connection closure\n   439→        Abyss.Telemetry.track_connection_closed()\n   440→\n   441→        # Calculate response time if we have accept start time\n   442→        response_time = calculate_response_time(state)\n   443→\n   444→        if response_time do\n   445→          Abyss.Telemetry.track_response_sent(response_time)\n   446→        end\n   447→\n   448→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n   449→        out\n   450→      end\n   451→\n   452→      # Called if the remote end shut down the connection, or if the local end closed the\n   453→      # connection by returning a `{:close,...}` tuple (in which case the socket will be open)\n   454→      def terminate(\n   455→            {:shutdown, reason},\n   456→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   457→              state\n   458→          ) do\n   459→        out = __MODULE__.handle_close(state)\n   460→        # Only call controlling_process if socket is not a reference (test environment)\n   461→        if not is_reference(listener_socket) do\n   462→          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n   463→        end\n   464→\n   465→        # Track connection closure\n   466→        Abyss.Telemetry.track_connection_closed()\n   467→\n   468→        # Calculate response time if we have accept start time\n   469→        response_time = calculate_response_time(state)\n   470→\n   471→        if response_time do\n   472→          Abyss.Telemetry.track_response_sent(response_time)\n   473→        end\n   474→\n   475→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n   476→        out\n   477→      end\n   478→\n   479→      # This clause could happen if we do not have a socket defined in state (either because the\n   480→      # process crashed before setting it up, or because the user sent an invalid state)\n   481→      @impl GenServer\n   482→      def terminate(\n   483→            reason,\n   484→            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n   485→              state\n   486→          ) do\n   487→        # Only call controlling_process if socket is not a reference (test environment)\n   488→        if not is_reference(listener_socket) do\n   489→          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n   490→        end\n   491→\n   492→        # Track connection closure\n   493→        Abyss.Telemetry.track_connection_closed()\n   494→\n   495→        # Calculate response time if we have accept start time\n   496→        response_time = calculate_response_time(state)\n   497→\n   498→        if response_time do\n   499→          Abyss.Telemetry.track_response_sent(response_time)\n   500→        end\n   501→\n   502→        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n   503→\n   504→        :ok\n   505→      end\n   506→\n   507→      # Private helper functions\n   508→\n   509→      defp calculate_response_time(%{\n   510→             connection_span: %{start_metadata: %{accept_start_time: start_time}}\n   511→           })\n   512→           when is_integer(start_time) do\n   513→        end_time = System.monotonic_time()\n   514→        System.convert_time_unit(end_time - start_time, :native, :millisecond)\n   515→      end\n   516→\n   517→      defp calculate_response_time(_state), do: nil\n   518→    end\n   519→  end\n   520→\n   521→  def handler_impl do\n   522→    quote do\n   523→      # @impl true\n   524→      # def handle_data(_data, state), do: {:close, state}\n   525→\n   526→      @impl true\n   527→      def handle_close(_state), do: :ok\n   528→\n   529→      @impl true\n   530→      def handle_error(_error, _state), do: :ok\n   531→\n   532→      @impl true\n   533→      def handle_shutdown(_state), do: :ok\n   534→\n   535→      @impl true\n   536→      def handle_timeout(_state), do: :ok\n   537→\n   538→      defoverridable Abyss.Handler\n   539→    end\n   540→  end\n   541→\n   542→  @doc false\n   543→  def handle_continuation(continuation, state) do\n   544→    case continuation do\n   545→      {:continue, _state} ->\n   546→        # Use adaptive timeout instead of fixed read_timeout\n   547→        timeout = Map.get(state, :adaptive_timeout, state[:read_timeout])\n   548→        {:noreply, state, timeout}\n   549→\n   550→      {:close, _state} ->\n   551→        {:stop, {:shutdown, :local_closed}, state}\n   552→\n   553→      {:error, :timeout, _state} ->\n   554→        {:stop, {:shutdown, :timeout}, state}\n   555→\n   556→      {:error, reason, _state} ->\n   557→        if state.server_config.silent_terminate_on_error do\n   558→          {:stop, {:shutdown, {:silent_termination, reason}}, state}\n   559→        else\n   560→          {:stop, reason, state}\n   561→        end\n   562→    end\n   563→  end\n   564→\n   565→  @doc false\n   566→  # Add adaptive timeout calculation helper function\n   567→  # Returns timeout in milliseconds\n   568→  def calculate_adaptive_timeout(base_timeout, processing_times) do\n   569→    case processing_times do\n   570→      [] ->\n   571→        base_timeout\n   572→\n   573→      times ->\n   574→        # Calculate average processing time in native time units\n   575→        avg_time_native = Enum.sum(times) / length(times)\n   576→\n   577→        # Convert to milliseconds for calculation\n   578→        avg_time_ms = System.convert_time_unit(round(avg_time_native), :native, :millisecond)\n   579→\n   580→        # Set timeout to 3x average processing time\n   581→        timeout_ms = round(avg_time_ms * 3)\n   582→\n   583→        # Ensure timeout is between 50% and 200% of base timeout (all in milliseconds)\n   584→        min_timeout_ms = div(base_timeout, 2)\n   585→        max_timeout_ms = base_timeout * 2\n   586→\n   587→        # Apply bounds and return timeout in milliseconds\n   588→        timeout_ms\n   589→        |> max(min_timeout_ms)\n   590→        |> min(max_timeout_ms)\n   591→    end\n   592→  end\n   593→end\n   594→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"6a896e1c-acf0-4d0c-b228-4d00db5e0a92","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/abyss/lib/abyss/handler.ex","content":"defmodule Abyss.Handler do\n  @moduledoc \"\"\"\n  `Abyss.Handler` defines the behaviour required of the application layer of a Abyss server.\n\n  # Example\n\n  Another example of a server that echoes back all data sent to it is as follows:\n\n  ```elixir\n  defmodule Echo do\n    use Abyss.Handler\n\n    @impl Abyss.Handler\n    def handle_data(data, state) do\n      Abyss.Transport.UDP.send(state.socket, data)\n      {:continue, state}\n    end\n  end\n  ```\n\n  Note that in this example there is no `c:handle_connection/2` callback defined. The default implementation of this\n  callback will simply return `{:continue, state}`, which is appropriate for cases where the client is the first\n  party to communicate.\n\n  Another example of a server which can send and receive messages asynchronously is as follows:\n\n  ```elixir\n  defmodule Messenger do\n    use Abyss.Handler\n\n    @impl Abyss.Handler\n    def handle_data(msg, state) do\n      IO.inspect(msg)\n      {:continue, state}\n    end\n\n    def handle_info({:udp, socket, ip, port, data}, state) do\n      Abyss.Transport.UDP.send(socket, ip, port, msg)\n      {:noreply, state, state.read_timeout}\n    end\n  end\n  ```\n\n  Note that in this example we make use of the fact that the handler process is really just a GenServer to send it messages\n  which are able to make use of the underlying socket. This allows for bidirectional sending and receiving of messages in\n  an asynchronous manner.\n\n  You can pass options to the default handler underlying `GenServer` by passing a `genserver_options` key to `Abyss.start_link/1`\n  containing `t:GenServer.options/0` to be passed to the last argument of `GenServer.start_link/3`.\n\n  Please note that you should not pass the `name` `t:GenServer.option/0`. If you need to register handler processes for\n  later lookup and use, you should perform process registration in `handle_connection/2`, ensuring the handler process is\n  registered only after the underlying connection is established and you have access to the connection socket and metadata\n  via `Abyss.Transport.UDP.peername/1`.\n\n  For example, using a custom process registry via `Registry`:\n\n  ```elixir\n\n  defmodule Messenger do\n    use Abyss.Handler\n\n    @impl Abyss.Handler\n    def handle_data(recv_data, state) do\n      {ip, port, data} = recv_data\n      Abyss.Transport.UDP.send(state.socket, ip, port, data)\n      {:continue, state}\n    end\n  end\n  ```\n\n  This example assumes you have started a `Registry` and registered it under the name `MessengerRegistry`.\n\n  # When Handler Isn't Enough\n\n  The `use Abyss.Handler` implementation should be flexible enough to power just about any handler, however if\n  this should not be the case for you, there is an escape hatch available. If you require more flexibility than the\n  `Abyss.Handler` behaviour provides, you are free to specify any module which implements `start_link/1` as the\n  `handler_module` parameter. The process of getting from this new process to a ready-to-use socket is somewhat\n  delicate, however. The steps required are as follows:\n\n  1. Abyss calls `start_link/1` on the configured `handler_module`, passing in a tuple\n  consisting of the configured handler and genserver opts. This function is expected to return a\n  conventional `GenServer.on_start()` style tuple. Note that this newly created process is not\n  passed the connection socket immediately.\n  2. The raw `t:Abyss.Transport.socket()` socket will be passed to the new process via a\n  message of the form `{:abyss_received, listener_socket, server_config, acceptor_span,\n  start_time}`.\n  3. Your implenentation must turn this into a `to::inet.socket()` socket by using the\n  `Abyss.Transport.UDP.new/3` call.\n  4. Your implementation must then call `Abyss.Transport.UDP.handshake/1` with the socket as the\n  sole argument in order to finalize the setup of the socket.\n  5. The socket is now ready to use.\n\n  In addition to this process, there are several other considerations to be aware of:\n\n  * The underlying socket is closed automatically when the handler process ends.\n\n  * Handler processes should have a restart strategy of `:temporary` to ensure that Abyss does not attempt to\n  restart crashed handlers.\n\n  * Handler processes should trap exit if possible so that existing connections can be given a chance to cleanly shut\n  down when shutting down a Abyss server instance.\n\n  * Some of the `:connection` family of telemetry span events are emitted by the\n  `Abyss.Handler` implementation. If you use your own implementation in its place it is\n  likely that such spans will not behave as expected.\n  \"\"\"\n\n  @typedoc \"The possible ways to indicate a timeout when returning values to Abyss\"\n  @type timeout_options :: timeout() | {:persistent, timeout()}\n\n  @typedoc \"The value returned by `c:handle_connection/2` and `c:handle_data/3`\"\n  @type handler_result ::\n          {:continue, state :: term()}\n          | {:continue, state :: term(), timeout_options()}\n          | {:close, state :: term()}\n          | {:error, term(), state :: term()}\n\n  @doc \"\"\"\n  This callback is called whenever client data is received after `c:handle_connection/2` or `c:handle_data/3` have returned an\n  `{:continue, state}` tuple. The data received is passed as the first argument, and handlers may choose to interact\n  synchronously with the socket in this callback via calls to various `Abyss.Transport.UDP` functions.\n\n  The value returned by this callback causes Abyss to proceed in one of several ways:\n\n  * Returning `{:close, state}` will cause Abyss to close the socket & call the `c:handle_close/2` callback to\n  allow final cleanup to be done.\n  * Returning `{:continue, state}` will cause Abyss to switch the socket to an asynchronous mode. When the\n  client subsequently sends data (or if there is already unread data waiting from the client), Abyss will call\n  `c:handle_data/3` to allow this data to be processed.\n  * Returning `{:continue, state, timeout}` is identical to the previous case with the\n  addition of a timeout. If `timeout` milliseconds passes with no data being received or messages\n  being sent to the process, the socket will be closed and `c:handle_timeout/2` will be called.\n  Note that this timeout is not persistent; it applies only to the interval until the next message\n  is received. In order to set a persistent timeout for all future messages (essentially\n  overwriting the value of `read_timeout` that was set at server startup), a value of\n  `{:persistent, timeout}` may be returned.\n  * Returning `{:error, reason, state}` will cause Abyss to close the socket & call the `c:handle_error/3` callback to\n  allow final cleanup to be done.\n  \"\"\"\n  @callback handle_data(data :: Abyss.Transport.recv_data(), state :: term()) ::\n              handler_result()\n\n  @doc \"\"\"\n  This callback is called when the underlying socket is closed by the remote end; it should perform any cleanup required\n  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n  has already been closed by the time this callback is called. The return value is ignored.\n\n  This callback is not called if the connection is explicitly closed via `Abyss.Transport.UDP.close/1`, however it\n  will be called in cases where `handle_connection/2` or `handle_data/3` return a `{:close, state}` tuple.\n  \"\"\"\n  @callback handle_close(state :: term()) :: term()\n\n  @doc \"\"\"\n  This callback is called when the underlying socket encounters an error; it should perform any cleanup required\n  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n  has already been closed by the time this callback is called. The return value is ignored.\n\n  In addition to socket level errors, this callback is also called in cases where `handle_connection/2` or `handle_data/3`\n  return a `{:error, reason, state}` tuple, or when connection handshaking (typically TLS\n  negotiation) fails.\n  \"\"\"\n  @callback handle_error(reason :: any(), state :: term()) ::\n              term()\n\n  @doc \"\"\"\n  This callback is called when the server process itself is being shut down; it should perform any cleanup required\n  as it is the last callback called before the process backing this connection is terminated. The underlying socket\n  has NOT been closed by the time this callback is called. The return value is ignored.\n\n  This callback is only called when the shutdown reason is `:normal`, and is subject to the same caveats described\n  in `c:GenServer.terminate/2`.\n  \"\"\"\n  @callback handle_shutdown(state :: term()) :: term()\n\n  @doc \"\"\"\n  This callback is called when a handler process has gone more than `timeout` ms without receiving\n  either remote data or a local message. The value used for `timeout` defaults to the\n  `read_timeout` value specified at server startup, and may be overridden on a one-shot or\n  persistent basis based on values returned from `c:handle_connection/2` or `c:handle_data/3`\n  calls. Note that it is NOT called on explicit `Abyss.Transport.UDP.recv/3` calls as they have\n  their own timeout semantics. The underlying socket has NOT been closed by the time this callback\n  is called. The return value is ignored.\n  \"\"\"\n  @callback handle_timeout(state :: term()) :: term()\n\n  @optional_callbacks handle_data: 2,\n                      handle_error: 2,\n                      handle_close: 1,\n                      handle_shutdown: 1,\n                      handle_timeout: 1\n\n  @spec __using__(any) :: Macro.t()\n  defmacro __using__(_opts) do\n    quote location: :keep do\n      @behaviour Abyss.Handler\n\n      use GenServer, restart: :temporary\n\n      def start_link(args) do\n        GenServer.start_link(__MODULE__, args)\n      end\n\n      unquote(genserver_impl())\n      unquote(handler_impl())\n    end\n  end\n\n  @doc false\n  defmacro add_handle_info_fallback(_module) do\n    quote do\n      def handle_info({msg, _raw_ip, _port, _data}, _state) when msg in [:udp] do\n        raise \"\"\"\n          The callback's `state` doesn't match the expected `{socket, state}` form.\n          Please ensure that you are returning a `{socket, state}` tuple from any\n          `GenServer.handle_*` callbacks you have implemented\n        \"\"\"\n      end\n    end\n  end\n\n  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity\n  def genserver_impl do\n    quote do\n      @impl GenServer\n      def init({connection_span, server_config, listener_pid, listener_socket}) do\n        Process.flag(:trap_exit, true)\n\n        # Start memory monitoring for long-running handlers\n        # Check every 10 seconds\n        Process.send_after(self(), :memory_check, 10_000)\n\n        {:ok,\n         %{\n           connection_span: connection_span,\n           server_config: server_config,\n           listener: listener_pid,\n           broadcast: server_config.broadcast,\n           socket: listener_socket,\n           read_timeout: server_config.read_timeout,\n           # Track last 10 processing times for adaptive timeout\n           processing_times: [],\n           adaptive_timeout: server_config.read_timeout,\n           memory_check_interval: server_config.handler_memory_check_interval\n         }}\n      end\n\n      @impl GenServer\n      def handle_info(\n            {:new_connection, listener_socket, recv_data},\n            %{broadcast: false} = state\n          ) do\n        Abyss.Telemetry.span_event(state.connection_span, :ready)\n        {:noreply, state, {:continue, {:handle_data, recv_data}}}\n      catch\n        {:stop, _, _} = stop -> stop\n      end\n\n      def handle_info(\n            {:new_connection, listener_socket, recv_data},\n            %{broadcast: true} = state\n          ) do\n        {:noreply, state, {:continue, {:handle_broadcast_data, recv_data}}}\n      catch\n        {:stop, _, _} = stop -> stop\n      end\n\n      def handle_info(:timeout, state) do\n        {:stop, {:shutdown, :timeout}, state}\n      end\n\n      def handle_info(:memory_check, %{memory_check_interval: interval} = state) do\n        case :erlang.process_info(self(), :memory) do\n          {:memory, memory_words} ->\n            memory_mb = memory_words * :erlang.system_info(:wordsize) / (1024 * 1024)\n            warning_threshold = state.server_config.handler_memory_warning_threshold\n            hard_limit = state.server_config.handler_memory_hard_limit\n\n            if memory_mb > warning_threshold do\n              # Log memory warning via telemetry\n              :telemetry.execute(\n                [:abyss, :handler, :memory_warning],\n                %{memory_mb: memory_mb},\n                %{handler_pid: self(), threshold: warning_threshold}\n              )\n\n              # Trigger garbage collection\n              :erlang.garbage_collect(self())\n\n              # Check if memory is still high after GC\n              case :erlang.process_info(self(), :memory) do\n                {:memory, new_memory_words} ->\n                  new_memory_mb =\n                    new_memory_words * :erlang.system_info(:wordsize) / (1024 * 1024)\n\n                  if new_memory_mb > hard_limit do\n                    {:stop, {:shutdown, :memory_limit_exceeded}, state}\n                  else\n                    Process.send_after(self(), :memory_check, interval)\n                    {:noreply, state}\n                  end\n\n                _ ->\n                  Process.send_after(self(), :memory_check, interval)\n                  {:noreply, state}\n              end\n            else\n              Process.send_after(self(), :memory_check, interval)\n              {:noreply, state}\n            end\n\n          _ ->\n            Process.send_after(self(), :memory_check, interval)\n            {:noreply, state}\n        end\n      end\n\n      @before_compile {Abyss.Handler, :add_handle_info_fallback}\n\n      # Use a continue pattern here so that we have committed the socket\n      # to state in case the `c:handle_connection/2` callback raises an error.\n      # This ensures that the `c:terminate/2` calls below are able to properly\n      # close down the process\n      @impl true\n      def handle_continue({:handle_data, recv_data}, %{processing_times: times} = state) do\n        start_time = System.monotonic_time()\n\n        result = __MODULE__.handle_data(recv_data, state)\n        processing_time = System.monotonic_time() - start_time\n\n        # Keep last 10 processing times for adaptive timeout calculation\n        new_times = [processing_time | Enum.take(times, 9)]\n        new_state = %{state | processing_times: new_times}\n\n        # Calculate adaptive timeout based on processing history\n        adaptive_timeout = Abyss.Handler.calculate_adaptive_timeout(state.read_timeout, new_times)\n        final_state = %{new_state | adaptive_timeout: adaptive_timeout}\n\n        result\n        |> Abyss.Handler.handle_continuation(final_state)\n      end\n\n      def handle_continue({:handle_broadcast_data, recv_data}, state) do\n        _reason = __MODULE__.handle_data(recv_data, state)\n        Process.send_after(self(), :broadcast, 10)\n        {:stop, {:shutdown, :broadcast}, state}\n      end\n\n      @impl true\n      def terminate({:shutdown, :broadcast}, %{connection_span: connection_span} = state) do\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :broadcast})\n\n        :ok\n      end\n\n      # Called by GenServer if we hit our read_timeout. Socket is still open\n      def terminate(\n            {:shutdown, :timeout},\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          ) do\n        out = __MODULE__.handle_timeout(state)\n        # Only call controlling_process if socket is not a reference (test environment)\n        if not is_reference(listener_socket) do\n          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n        end\n\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :timeout})\n        out\n      end\n\n      # Called if we're being shutdown in an orderly manner. Socket is still open\n      def terminate(\n            :shutdown,\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          ) do\n        out = __MODULE__.handle_shutdown(state)\n        # Only call controlling_process if socket is not a reference (test environment)\n        if not is_reference(listener_socket) do\n          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n        end\n\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: :shutdown})\n        out\n      end\n\n      # Called if the socket encountered an error and we are configured to shutdown silently.\n      # Socket is closed\n      def terminate(\n            {:shutdown, {:silent_termination, reason}},\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          ) do\n        out =\n          __MODULE__.handle_error(\n            reason,\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          )\n\n        # Only call controlling_process if socket is not a reference (test environment)\n        if not is_reference(listener_socket) do\n          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n        end\n\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n        out\n      end\n\n      # Called if the remote end shut down the connection, or if the local end closed the\n      # connection by returning a `{:close,...}` tuple (in which case the socket will be open)\n      def terminate(\n            {:shutdown, reason},\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          ) do\n        out = __MODULE__.handle_close(state)\n        # Only call controlling_process if socket is not a reference (test environment)\n        if not is_reference(listener_socket) do\n          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n        end\n\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n        out\n      end\n\n      # This clause could happen if we do not have a socket defined in state (either because the\n      # process crashed before setting it up, or because the user sent an invalid state)\n      @impl GenServer\n      def terminate(\n            reason,\n            %{connection_span: connection_span, listener: listener_pid, socket: listener_socket} =\n              state\n          ) do\n        # Only call controlling_process if socket is not a reference (test environment)\n        if not is_reference(listener_socket) do\n          Abyss.Transport.UDP.controlling_process(listener_socket, listener_pid)\n        end\n\n        # Track connection closure\n        Abyss.Telemetry.track_connection_closed()\n\n        # Calculate response time if we have accept start time\n        response_time = calculate_response_time(state)\n\n        if response_time do\n          Abyss.Telemetry.track_response_sent(response_time)\n        end\n\n        Abyss.Telemetry.stop_span(connection_span, %{}, %{reason: reason})\n\n        :ok\n      end\n\n      # Private helper functions\n\n      defp calculate_response_time(%{\n             connection_span: %{start_metadata: %{accept_start_time: start_time}}\n           })\n           when is_integer(start_time) do\n        end_time = System.monotonic_time()\n        System.convert_time_unit(end_time - start_time, :native, :millisecond)\n      end\n\n      defp calculate_response_time(_state), do: nil\n    end\n  end\n\n  def handler_impl do\n    quote do\n      # @impl true\n      # def handle_data(_data, state), do: {:close, state}\n\n      @impl true\n      def handle_close(_state), do: :ok\n\n      @impl true\n      def handle_error(_error, _state), do: :ok\n\n      @impl true\n      def handle_shutdown(_state), do: :ok\n\n      @impl true\n      def handle_timeout(_state), do: :ok\n\n      defoverridable Abyss.Handler\n    end\n  end\n\n  @doc false\n  def handle_continuation(continuation, state) do\n    case continuation do\n      {:continue, _state} ->\n        # Use adaptive timeout instead of fixed read_timeout\n        timeout = Map.get(state, :adaptive_timeout, state[:read_timeout])\n        {:noreply, state, timeout}\n\n      {:close, _state} ->\n        {:stop, {:shutdown, :local_closed}, state}\n\n      {:error, :timeout, _state} ->\n        {:stop, {:shutdown, :timeout}, state}\n\n      {:error, reason, _state} ->\n        if state.server_config.silent_terminate_on_error do\n          {:stop, {:shutdown, {:silent_termination, reason}}, state}\n        else\n          {:stop, reason, state}\n        end\n    end\n  end\n\n  @doc false\n  # Add adaptive timeout calculation helper function\n  # Returns timeout in milliseconds\n  def calculate_adaptive_timeout(base_timeout, processing_times) do\n    case processing_times do\n      [] ->\n        base_timeout\n\n      times ->\n        # Calculate average processing time in native time units\n        avg_time_native = Enum.sum(times) / length(times)\n\n        # Convert to milliseconds for calculation\n        avg_time_ms = System.convert_time_unit(round(avg_time_native), :native, :millisecond)\n\n        # Set timeout to 3x average processing time\n        timeout_ms = round(avg_time_ms * 3)\n\n        # Ensure timeout is between 50% and 200% of base timeout (all in milliseconds)\n        min_timeout_ms = div(base_timeout, 2)\n        max_timeout_ms = base_timeout * 2\n\n        # Apply bounds and return timeout in milliseconds\n        timeout_ms\n        |> max(min_timeout_ms)\n        |> min(max_timeout_ms)\n    end\n  end\nend\n","numLines":594,"startLine":1,"totalLines":594}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbBZHbxNnwvqUXPyDsdVG5","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n     6→  REPLY, and other DHCPv6 protocol messages. Handles client identification\n     7→  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n     8→  \"\"\"\n     9→\n    10→  alias YellowDog.Dhcpv6.LeaseManager\n    11→\n    12→  # DHCPv6 message type constants\n    13→  @msg_type_solicit 1\n    14→  @msg_type_advertise 2\n    15→  @msg_type_request 3\n    16→  # @msg_type_confirm 4\n    17→  @msg_type_renew 5\n    18→  @msg_type_rebind 6\n    19→  @msg_type_reply 7\n    20→  @msg_type_release 8\n    21→  @msg_type_decline 9\n    22→  # @msg_type_reconfigure 10\n    23→  @msg_type_information_request 11\n    24→  @msg_type_relay_forw 12\n    25→  @msg_type_relay_repl 13\n    26→\n    27→  # DHCPv6 option codes\n    28→  @option_client_id 1\n    29→  @option_server_id 2\n    30→  @option_ia_na 3\n    31→  @option_ia_ta 4\n    32→  @option_ia_addr 5\n    33→  # @option_oro 6\n    34→  @option_preference 7\n    35→  # @option_elapsed_time 8\n    36→  # @option_status_code 13\n    37→  # @option_rapid_commit 14\n    38→  @option_dns_servers 23\n    39→  @option_domain_list 24\n    40→  @option_ia_pd 25\n    41→  @option_ia_prefix 26\n    42→\n    43→  @doc \"\"\"\n    44→  Handles incoming DHCPv6 data from clients.\n    45→  \"\"\"\n    46→  def handle_data({client_ip, client_port, data}, state) do\n    47→    start_time = System.monotonic_time(:microsecond)\n    48→\n    49→    try do\n    50→      case DHCPv6.Message.from_iodata(data) do\n    51→        {:ok, message} ->\n    52→          :telemetry.execute(\n    53→            [:yellow_dog, :dhcpv6, :message, :received],\n    54→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    55→            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n    56→          )\n    57→\n    58→          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n    59→\n    60→        {:error, reason} ->\n    61→          :telemetry.execute(\n    62→            [:yellow_dog, :dhcpv6, :message, :parse_error],\n    63→            %{count: 1},\n    64→            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n    65→          )\n    66→\n    67→          {:continue, state}\n    68→      end\n    69→    rescue\n    70→      error ->\n    71→        :telemetry.execute(\n    72→          [:yellow_dog, :dhcpv6, :message, :error],\n    73→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    74→          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n    75→        )\n    76→\n    77→        {:continue, state}\n    78→    end\n    79→  end\n    80→\n    81→  @doc \"\"\"\n    82→  Handles handler errors (implements Abyss.Handler callback).\n    83→  \"\"\"\n    84→  def handle_error(error, state) do\n    85→    :telemetry.execute(\n    86→      [:yellow_dog, :dhcpv6, :handler, :error],\n    87→      %{count: 1},\n    88→      %{reason: inspect(error)}\n    89→    )\n    90→\n    91→    {:continue, state}\n    92→  end\n    93→\n    94→  @doc \"\"\"\n    95→  Handles handler timeouts (implements Abyss.Handler callback).\n    96→  \"\"\"\n    97→  def handle_timeout(state) do\n    98→    :telemetry.execute(\n    99→      [:yellow_dog, :dhcpv6, :handler, :timeout],\n   100→      %{count: 1},\n   101→      %{}\n   102→    )\n   103→\n   104→    {:continue, state}\n   105→  end\n   106→\n   107→  # Private functions for handling specific DHCPv6 message types\n   108→\n   109→  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n   110→    case message.msg_type do\n   111→      @msg_type_solicit ->\n   112→        handle_solicit(message, client_ip, client_port, state, start_time)\n   113→\n   114→      @msg_type_request ->\n   115→        handle_request(message, client_ip, client_port, state, start_time)\n   116→\n   117→      @msg_type_renew ->\n   118→        handle_renew(message, client_ip, client_port, state, start_time)\n   119→\n   120→      @msg_type_rebind ->\n   121→        handle_rebind(message, client_ip, client_port, state, start_time)\n   122→\n   123→      @msg_type_release ->\n   124→        handle_release(message, client_ip, client_port, state, start_time)\n   125→\n   126→      @msg_type_decline ->\n   127→        handle_decline(message, client_ip, client_port, state, start_time)\n   128→\n   129→      @msg_type_information_request ->\n   130→        handle_inform(message, client_ip, client_port, state, start_time)\n   131→\n   132→      @msg_type_relay_forw ->\n   133→        handle_relay_forward(message, client_ip, client_port, state)\n   134→\n   135→      @msg_type_relay_repl ->\n   136→        handle_relay_reply(message, client_ip, client_port, state)\n   137→\n   138→      _ ->\n   139→        :telemetry.execute(\n   140→          [:yellow_dog, :dhcpv6, :message, :unknown],\n   141→          %{count: 1},\n   142→          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n   143→        )\n   144→\n   145→        {:continue, state}\n   146→    end\n   147→  end\n   148→\n   149→  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n   150→    :telemetry.execute(\n   151→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   152→      %{count: 1},\n   153→      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n   154→    )\n   155→\n   156→    client_duid = get_client_duid(message)\n   157→    ia_na = get_ia_na(message)\n   158→    ia_ta = get_ia_ta(message)\n   159→    ia_pd = get_ia_pd(message)\n   160→\n   161→    # Check if any IA type is present\n   162→    case {client_duid, ia_na, ia_ta, ia_pd} do\n   163→      {nil, _, _, _} ->\n   164→        :telemetry.execute(\n   165→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   166→          %{count: 1},\n   167→          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n   168→        )\n   169→\n   170→        {:continue, state}\n   171→\n   172→      {_, nil, nil, nil} ->\n   173→        :telemetry.execute(\n   174→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   175→          %{count: 1},\n   176→          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n   177→        )\n   178→\n   179→        {:continue, state}\n   180→\n   181→      {duid, _, _, _} ->\n   182→        # Process each IA type\n   183→        leases = []\n   184→\n   185→        # Handle IA_NA if present\n   186→        leases =\n   187→          if ia_na do\n   188→            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n   189→              {:ok, lease} ->\n   190→                [lease | leases]\n   191→\n   192→              {:error, reason} ->\n   193→                :telemetry.execute(\n   194→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   195→                  %{count: 1},\n   196→                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n   197→                )\n   198→\n   199→                leases\n   200→            end\n   201→          else\n   202→            leases\n   203→          end\n   204→\n   205→        # Handle IA_TA if present\n   206→        leases =\n   207→          if ia_ta do\n   208→            case allocate_temporary_address(duid, ia_ta.iaid) do\n   209→              {:ok, ta_lease} ->\n   210→                [ta_lease | leases]\n   211→\n   212→              {:error, reason} ->\n   213→                :telemetry.execute(\n   214→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   215→                  %{count: 1},\n   216→                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n   217→                )\n   218→\n   219→                leases\n   220→            end\n   221→          else\n   222→            leases\n   223→          end\n   224→\n   225→        # Handle IA_PD if present\n   226→        leases =\n   227→          if ia_pd do\n   228→            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n   229→            [pd_lease | leases]\n   230→          else\n   231→            leases\n   232→          end\n   233→\n   234→        if length(leases) > 0 do\n   235→          advertise = create_advertise_multi(message, leases)\n   236→          send_dhcpv6_response(advertise, client_ip, client_port, state)\n   237→\n   238→          :telemetry.execute(\n   239→            [:yellow_dog, :dhcpv6, :solicit, :completed],\n   240→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   241→            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n   242→          )\n   243→        end\n   244→\n   245→        {:continue, state}\n   246→    end\n   247→  end\n   248→\n   249→  defp handle_request(message, client_ip, client_port, state, start_time) do\n   250→    :telemetry.execute(\n   251→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   252→      %{count: 1},\n   253→      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n   254→    )\n   255→\n   256→    client_duid = get_client_duid(message)\n   257→    ia_na = get_ia_na(message)\n   258→\n   259→    case {client_duid, ia_na} do\n   260→      {nil, _} ->\n   261→        :telemetry.execute(\n   262→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   263→          %{count: 1},\n   264→          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n   265→        )\n   266→\n   267→        {:continue, state}\n   268→\n   269→      {_, nil} ->\n   270→        :telemetry.execute(\n   271→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   272→          %{count: 1},\n   273→          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n   274→        )\n   275→\n   276→        {:continue, state}\n   277→\n   278→      {duid, %{iaid: iaid}} ->\n   279→        # Allocate or renew lease\n   280→        case LeaseManager.allocate_lease(duid, iaid) do\n   281→          {:ok, lease} ->\n   282→            reply = create_reply(message, lease)\n   283→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   284→\n   285→            :telemetry.execute(\n   286→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   287→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   288→              %{client_ip: client_ip, client_duid: duid}\n   289→            )\n   290→\n   291→          {:error, reason} ->\n   292→            :telemetry.execute(\n   293→              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   294→              %{count: 1},\n   295→              %{reason: inspect(reason), client_duid: duid}\n   296→            )\n   297→        end\n   298→\n   299→        {:continue, state}\n   300→    end\n   301→  end\n   302→\n   303→  defp handle_renew(message, client_ip, client_port, state, start_time) do\n   304→    :telemetry.execute(\n   305→      [:yellow_dog, :dhcpv6, :lease, :renewed],\n   306→      %{count: 1},\n   307→      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n   308→    )\n   309→\n   310→    client_duid = get_client_duid(message)\n   311→    ia_na = get_ia_na(message)\n   312→\n   313→    case {client_duid, ia_na} do\n   314→      {duid, %{iaid: iaid}} when duid != nil ->\n   315→        # Renew existing lease\n   316→        case LeaseManager.allocate_lease(duid, iaid) do\n   317→          {:ok, lease} ->\n   318→            reply = create_reply(message, lease)\n   319→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   320→\n   321→            :telemetry.execute(\n   322→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   323→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   324→              %{client_ip: client_ip, client_duid: duid}\n   325→            )\n   326→\n   327→          {:error, reason} ->\n   328→            :telemetry.execute(\n   329→              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n   330→              %{count: 1},\n   331→              %{reason: inspect(reason), client_duid: duid}\n   332→            )\n   333→        end\n   334→\n   335→        {:continue, state}\n   336→\n   337→      _ ->\n   338→        :telemetry.execute(\n   339→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   340→          %{count: 1},\n   341→          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n   342→        )\n   343→\n   344→        {:continue, state}\n   345→    end\n   346→  end\n   347→\n   348→  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n   349→    :telemetry.execute(\n   350→      [:yellow_dog, :dhcpv6, :lease, :rebind],\n   351→      %{count: 1},\n   352→      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n   353→    )\n   354→\n   355→    # Rebind is similar to renew - reuse the renew logic\n   356→    client_duid = get_client_duid(message)\n   357→    ia_na = get_ia_na(message)\n   358→\n   359→    case {client_duid, ia_na} do\n   360→      {duid, %{iaid: iaid}} when duid != nil ->\n   361→        case LeaseManager.allocate_lease(duid, iaid) do\n   362→          {:ok, lease} ->\n   363→            reply = create_reply(message, lease)\n   364→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   365→\n   366→            :telemetry.execute(\n   367→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   368→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   369→              %{client_ip: client_ip, client_duid: duid}\n   370→            )\n   371→\n   372→          {:error, reason} ->\n   373→            :telemetry.execute(\n   374→              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n   375→              %{count: 1},\n   376→              %{reason: inspect(reason), client_duid: duid}\n   377→            )\n   378→        end\n   379→\n   380→        {:continue, state}\n   381→\n   382→      _ ->\n   383→        :telemetry.execute(\n   384→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   385→          %{count: 1},\n   386→          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n   387→        )\n   388→\n   389→        {:continue, state}\n   390→    end\n   391→  end\n   392→\n   393→  defp handle_release(message, client_ip, client_port, state, start_time) do\n   394→    :telemetry.execute(\n   395→      [:yellow_dog, :dhcpv6, :lease, :released],\n   396→      %{count: 1},\n   397→      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n   398→    )\n   399→\n   400→    client_duid = get_client_duid(message)\n   401→    ia_na = get_ia_na(message)\n   402→\n   403→    case {client_duid, ia_na} do\n   404→      {duid, %{iaid: iaid}} when duid != nil ->\n   405→        LeaseManager.release_lease(duid, iaid)\n   406→\n   407→        :telemetry.execute(\n   408→          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n   409→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   410→          %{client_ip: client_ip, client_duid: duid}\n   411→        )\n   412→\n   413→      _ ->\n   414→        :telemetry.execute(\n   415→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   416→          %{count: 1},\n   417→          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n   418→        )\n   419→    end\n   420→\n   421→    {:continue, state}\n   422→  end\n   423→\n   424→  defp handle_decline(message, client_ip, client_port, state, start_time) do\n   425→    :telemetry.execute(\n   426→      [:yellow_dog, :dhcpv6, :lease, :declined],\n   427→      %{count: 1},\n   428→      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n   429→    )\n   430→\n   431→    client_duid = get_client_duid(message)\n   432→    ia_na = get_ia_na(message)\n   433→\n   434→    case {client_duid, ia_na} do\n   435→      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n   436→        LeaseManager.decline_ip(ia_addr, duid)\n   437→\n   438→        :telemetry.execute(\n   439→          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n   440→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   441→          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n   442→        )\n   443→\n   444→      _ ->\n   445→        :telemetry.execute(\n   446→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   447→          %{count: 1},\n   448→          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n   449→        )\n   450→    end\n   451→\n   452→    {:continue, state}\n   453→  end\n   454→\n   455→  defp handle_inform(message, client_ip, client_port, state, start_time) do\n   456→    :telemetry.execute(\n   457→      [:yellow_dog, :dhcpv6, :inform, :requested],\n   458→      %{count: 1},\n   459→      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n   460→    )\n   461→\n   462→    # INFORMATION-REQUEST - provide configuration without address allocation\n   463→    reply = create_information_reply(message)\n   464→    send_dhcpv6_response(reply, client_ip, client_port, state)\n   465→\n   466→    :telemetry.execute(\n   467→      [:yellow_dog, :dhcpv6, :inform, :completed],\n   468→      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   469→      %{client_ip: client_ip}\n   470→    )\n   471→\n   472→    {:continue, state}\n   473→  end\n   474→\n   475→  defp handle_relay_forward(_message, client_ip, client_port, state) do\n   476→    :telemetry.execute(\n   477→      [:yellow_dog, :dhcpv6, :relay, :forward],\n   478→      %{count: 1},\n   479→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   480→    )\n   481→\n   482→    {:continue, state}\n   483→  end\n   484→\n   485→  defp handle_relay_reply(_message, client_ip, client_port, state) do\n   486→    :telemetry.execute(\n   487→      [:yellow_dog, :dhcpv6, :relay, :reply],\n   488→      %{count: 1},\n   489→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   490→    )\n   491→\n   492→    {:continue, state}\n   493→  end\n   494→\n   495→  # Message creation functions\n   496→\n   497→  defp create_reply(request, lease) do\n   498→    pool = get_pool_for_lease(lease)\n   499→\n   500→    %DHCPv6.Message{\n   501→      msg_type: @msg_type_reply,\n   502→      transaction_id: request.transaction_id,\n   503→      options:\n   504→        [\n   505→          # Server DUID\n   506→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   507→          # Client DUID (echo back)\n   508→          %DHCPv6.Message.Option{\n   509→            option_code: @option_client_id,\n   510→            option_data: get_client_duid(request)\n   511→          },\n   512→          # IA_NA with IA_ADDR\n   513→          create_ia_na_option(lease),\n   514→          # DNS servers\n   515→          create_dns_servers_option(pool.dns_servers)\n   516→        ]\n   517→        |> add_domain_list_option(pool.domain_name)\n   518→    }\n   519→  end\n   520→\n   521→  defp create_information_reply(request) do\n   522→    pool = get_default_pool()\n   523→\n   524→    %DHCPv6.Message{\n   525→      msg_type: @msg_type_reply,\n   526→      transaction_id: request.transaction_id,\n   527→      options:\n   528→        [\n   529→          # Server DUID\n   530→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   531→          # Client DUID (echo back)\n   532→          %DHCPv6.Message.Option{\n   533→            option_code: @option_client_id,\n   534→            option_data: get_client_duid(request)\n   535→          },\n   536→          # DNS servers\n   537→          create_dns_servers_option(pool.dns_servers)\n   538→        ]\n   539→        |> add_domain_list_option(pool.domain_name)\n   540→    }\n   541→  end\n   542→\n   543→  # Helper functions for creating options\n   544→\n   545→  defp create_ia_na_option(lease) do\n   546→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   547→    ia_addr_data =\n   548→      ipv6_to_binary(lease.ip) <>\n   549→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   550→\n   551→    ia_addr_option = %DHCPv6.Message.Option{\n   552→      option_code: @option_ia_addr,\n   553→      option_data: ia_addr_data\n   554→    }\n   555→\n   556→    # IA_NA option (option 3) - contains IA_ADDR\n   557→    # IAID + T1 + T2 (0 = server decides)\n   558→    ia_na_data =\n   559→      <<lease.iaid::32, 0::32, 0::32>> <>\n   560→        DHCP.Parameter.to_iodata(ia_addr_option)\n   561→\n   562→    %DHCPv6.Message.Option{\n   563→      option_code: @option_ia_na,\n   564→      option_data: ia_na_data\n   565→    }\n   566→  end\n   567→\n   568→  defp create_dns_servers_option(dns_servers) do\n   569→    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n   570→\n   571→    %DHCPv6.Message.Option{\n   572→      option_code: @option_dns_servers,\n   573→      option_data: dns_data\n   574→    }\n   575→  end\n   576→\n   577→  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n   578→\n   579→  defp add_domain_list_option(options, domain) do\n   580→    # Encode domain name in DNS format (length-prefixed labels)\n   581→    domain_data = encode_domain_name(domain)\n   582→\n   583→    domain_option = %DHCPv6.Message.Option{\n   584→      option_code: @option_domain_list,\n   585→      option_data: domain_data\n   586→    }\n   587→\n   588→    options ++ [domain_option]\n   589→  end\n   590→\n   591→  defp encode_domain_name(domain) do\n   592→    domain\n   593→    |> String.split(\".\")\n   594→    |> Enum.map_join(fn label ->\n   595→      <<byte_size(label)::8, label::binary>>\n   596→    end)\n   597→    # Terminating zero\n   598→    |> Kernel.<>(<<0>>)\n   599→  end\n   600→\n   601→  # Helper functions for extracting information from messages\n   602→\n   603→  defp get_client_duid(message) do\n   604→    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n   605→      nil -> nil\n   606→      option -> option.option_data\n   607→    end\n   608→  end\n   609→\n   610→  defp get_ia_na(message) do\n   611→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n   612→      nil ->\n   613→        nil\n   614→\n   615→      option ->\n   616→        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   617→        case option.option_data do\n   618→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   619→            # Try to extract IA_ADDR if present\n   620→            ia_addr = extract_ia_addr(rest)\n   621→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n   622→\n   623→          _ ->\n   624→            nil\n   625→        end\n   626→    end\n   627→  end\n   628→\n   629→  defp get_ia_ta(message) do\n   630→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n   631→      nil ->\n   632→        nil\n   633→\n   634→      option ->\n   635→        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n   636→        case option.option_data do\n   637→          <<iaid::32, rest::binary>> ->\n   638→            ia_addr = extract_ia_addr(rest)\n   639→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n   640→\n   641→          _ ->\n   642→            nil\n   643→        end\n   644→    end\n   645→  end\n   646→\n   647→  defp get_ia_pd(message) do\n   648→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n   649→      nil ->\n   650→        nil\n   651→\n   652→      option ->\n   653→        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   654→        case option.option_data do\n   655→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   656→            ia_prefix = extract_ia_prefix(rest)\n   657→            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n   658→\n   659→          _ ->\n   660→            nil\n   661→        end\n   662→    end\n   663→  end\n   664→\n   665→  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n   666→    case data do\n   667→      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n   668→        {a, b, c, d, e, f, g, h}\n   669→\n   670→      _ ->\n   671→        nil\n   672→    end\n   673→  end\n   674→\n   675→  defp extract_ia_addr(_), do: nil\n   676→\n   677→  defp extract_ia_prefix(\n   678→         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n   679→       ) do\n   680→    case data do\n   681→      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n   682→        g::16, h::16>> ->\n   683→        {{a, b, c, d, e, f, g, h}, prefix_len}\n   684→\n   685→      _ ->\n   686→        nil\n   687→    end\n   688→  end\n   689→\n   690→  defp extract_ia_prefix(_), do: nil\n   691→\n   692→  # Allocation helper functions\n   693→\n   694→  defp allocate_temporary_address(duid, iaid) do\n   695→    # Temporary addresses use a separate pool with shorter lifetimes\n   696→    # For now, delegate to LeaseManager with IA_TA type marker\n   697→    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n   698→      {:ok, lease} ->\n   699→        # Mark as temporary address with shorter lifetime\n   700→        ta_lease = %{\n   701→          lease\n   702→          | ia_type: :ia_ta,\n   703→            preferred_lifetime: 600,\n   704→            # 10 minutes\n   705→            valid_lifetime: 1200\n   706→            # 20 minutes\n   707→        }\n   708→\n   709→        {:ok, ta_lease}\n   710→\n   711→      error ->\n   712→        error\n   713→    end\n   714→  end\n   715→\n   716→  defp allocate_prefix_delegation(duid, iaid) do\n   717→    # For now, return a placeholder\n   718→    # Full implementation would use PrefixPool module\n   719→    :telemetry.execute(\n   720→      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n   721→      %{count: 1},\n   722→      %{client_duid: duid, iaid: iaid}\n   723→    )\n   724→\n   725→    # TODO: Integrate with PrefixPool module\n   726→    # Example placeholder prefix: 2001:db8:1000::/56\n   727→    {:ok,\n   728→     %{\n   729→       duid: duid,\n   730→       iaid: iaid,\n   731→       ia_type: :ia_pd,\n   732→       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n   733→       preferred_lifetime: 3600,\n   734→       valid_lifetime: 7200,\n   735→       pool_name: \"default-pd\"\n   736→     }}\n   737→  end\n   738→\n   739→  # Message creation functions with multi-IA support\n   740→\n   741→  defp create_advertise_multi(solicit, leases) do\n   742→    pool = get_default_pool()\n   743→\n   744→    options = [\n   745→      # Server DUID\n   746→      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   747→      # Client DUID (echo back)\n   748→      %DHCPv6.Message.Option{\n   749→        option_code: @option_client_id,\n   750→        option_data: get_client_duid(solicit)\n   751→      },\n   752→      # Preference\n   753→      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n   754→    ]\n   755→\n   756→    # Add IA options for each lease\n   757→    ia_options =\n   758→      Enum.flat_map(leases, fn lease ->\n   759→        case lease.ia_type do\n   760→          :ia_na -> [create_ia_na_option(lease)]\n   761→          :ia_ta -> [create_ia_ta_option(lease)]\n   762→          :ia_pd -> [create_ia_pd_option(lease)]\n   763→          _ -> []\n   764→        end\n   765→      end)\n   766→\n   767→    # Add configuration options (DNS, etc.)\n   768→    config_options =\n   769→      [\n   770→        create_dns_servers_option(pool.dns_servers)\n   771→      ] ++ add_domain_list_option([], pool.domain_name)\n   772→\n   773→    %DHCPv6.Message{\n   774→      msg_type: @msg_type_advertise,\n   775→      transaction_id: solicit.transaction_id,\n   776→      options: options ++ ia_options ++ config_options\n   777→    }\n   778→  end\n   779→\n   780→  defp create_ia_ta_option(lease) do\n   781→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   782→    ia_addr_data =\n   783→      ipv6_to_binary(lease.ip) <>\n   784→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   785→\n   786→    ia_addr_option = %DHCPv6.Message.Option{\n   787→      option_code: @option_ia_addr,\n   788→      option_data: ia_addr_data\n   789→    }\n   790→\n   791→    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n   792→    ia_ta_data =\n   793→      <<lease.iaid::32>> <>\n   794→        DHCP.Parameter.to_iodata(ia_addr_option)\n   795→\n   796→    %DHCPv6.Message.Option{\n   797→      option_code: @option_ia_ta,\n   798→      option_data: ia_ta_data\n   799→    }\n   800→  end\n   801→\n   802→  defp create_ia_pd_option(lease) do\n   803→    {prefix_addr, prefix_len} = lease.delegated_prefix\n   804→\n   805→    # IA_PREFIX option (option 26)\n   806→    ia_prefix_data =\n   807→      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n   808→        ipv6_to_binary(prefix_addr)\n   809→\n   810→    ia_prefix_option = %DHCPv6.Message.Option{\n   811→      option_code: @option_ia_prefix,\n   812→      option_data: ia_prefix_data\n   813→    }\n   814→\n   815→    # IA_PD option (option 25)\n   816→    ia_pd_data =\n   817→      <<lease.iaid::32, 0::32, 0::32>> <>\n   818→        DHCP.Parameter.to_iodata(ia_prefix_option)\n   819→\n   820→    %DHCPv6.Message.Option{\n   821→      option_code: @option_ia_pd,\n   822→      option_data: ia_pd_data\n   823→    }\n   824→  end\n   825→\n   826→  defp get_server_duid do\n   827→    # Generate a simple DUID-LL (Link-Layer) based on server\n   828→    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n   829→    # Using a static server identifier for now\n   830→    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n   831→  end\n   832→\n   833→  defp get_pool_for_lease(_lease) do\n   834→    # For now, use default pool\n   835→    # In production, look up pool by lease.pool_name\n   836→    get_default_pool()\n   837→  end\n   838→\n   839→  defp get_default_pool do\n   840→    %{\n   841→      name: \"default\",\n   842→      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   843→      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n   844→      prefix_length: 64,\n   845→      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n   846→      domain_name: \"local\",\n   847→      preferred_lifetime: 3600,\n   848→      valid_lifetime: 7200\n   849→    }\n   850→  end\n   851→\n   852→  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n   853→    data = DHCP.Parameter.to_iodata(response)\n   854→\n   855→    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n   856→      :ok ->\n   857→        :telemetry.execute(\n   858→          [:yellow_dog, :dhcpv6, :response, :sent],\n   859→          %{count: 1},\n   860→          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n   861→        )\n   862→\n   863→      {:error, reason} ->\n   864→        :telemetry.execute(\n   865→          [:yellow_dog, :dhcpv6, :response, :send_failed],\n   866→          %{count: 1},\n   867→          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n   868→        )\n   869→    end\n   870→  end\n   871→\n   872→  # Utility functions\n   873→\n   874→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   875→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   876→  end\n   877→end\n   878→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"9ad24c15-2e85-4225-bccd-910985a59ac8","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/handler.ex","content":"defmodule YellowDog.Dhcpv6.Handler do\n  @moduledoc \"\"\"\n  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n\n  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n  REPLY, and other DHCPv6 protocol messages. Handles client identification\n  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n  \"\"\"\n\n  alias YellowDog.Dhcpv6.LeaseManager\n\n  # DHCPv6 message type constants\n  @msg_type_solicit 1\n  @msg_type_advertise 2\n  @msg_type_request 3\n  # @msg_type_confirm 4\n  @msg_type_renew 5\n  @msg_type_rebind 6\n  @msg_type_reply 7\n  @msg_type_release 8\n  @msg_type_decline 9\n  # @msg_type_reconfigure 10\n  @msg_type_information_request 11\n  @msg_type_relay_forw 12\n  @msg_type_relay_repl 13\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  # @option_oro 6\n  @option_preference 7\n  # @option_elapsed_time 8\n  # @option_status_code 13\n  # @option_rapid_commit 14\n  @option_dns_servers 23\n  @option_domain_list 24\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @doc \"\"\"\n  Handles incoming DHCPv6 data from clients.\n  \"\"\"\n  def handle_data({client_ip, client_port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    try do\n      case DHCPv6.Message.from_iodata(data) do\n        {:ok, message} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :received],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n          )\n\n          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :parse_error],\n            %{count: 1},\n            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n          )\n\n          {:continue, state}\n      end\n    rescue\n      error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :error],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @doc \"\"\"\n  Handles handler errors (implements Abyss.Handler callback).\n  \"\"\"\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles handler timeouts (implements Abyss.Handler callback).\n  \"\"\"\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions for handling specific DHCPv6 message types\n\n  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n    case message.msg_type do\n      @msg_type_solicit ->\n        handle_solicit(message, client_ip, client_port, state, start_time)\n\n      @msg_type_request ->\n        handle_request(message, client_ip, client_port, state, start_time)\n\n      @msg_type_renew ->\n        handle_renew(message, client_ip, client_port, state, start_time)\n\n      @msg_type_rebind ->\n        handle_rebind(message, client_ip, client_port, state, start_time)\n\n      @msg_type_release ->\n        handle_release(message, client_ip, client_port, state, start_time)\n\n      @msg_type_decline ->\n        handle_decline(message, client_ip, client_port, state, start_time)\n\n      @msg_type_information_request ->\n        handle_inform(message, client_ip, client_port, state, start_time)\n\n      @msg_type_relay_forw ->\n        handle_relay_forward(message, client_ip, client_port, state)\n\n      @msg_type_relay_repl ->\n        handle_relay_reply(message, client_ip, client_port, state)\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :unknown],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n    ia_ta = get_ia_ta(message)\n    ia_pd = get_ia_pd(message)\n\n    # Check if any IA type is present\n    case {client_duid, ia_na, ia_ta, ia_pd} do\n      {nil, _, _, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil, nil, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, _, _, _} ->\n        # Process each IA type\n        leases = []\n\n        # Handle IA_NA if present\n        leases =\n          if ia_na do\n            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n              {:ok, lease} ->\n                [lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_TA if present\n        leases =\n          if ia_ta do\n            case allocate_temporary_address(duid, ia_ta.iaid) do\n              {:ok, ta_lease} ->\n                [ta_lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_PD if present\n        leases =\n          if ia_pd do\n            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n            [pd_lease | leases]\n          else\n            leases\n          end\n\n        if length(leases) > 0 do\n          advertise = create_advertise_multi(message, leases)\n          send_dhcpv6_response(advertise, client_ip, client_port, state)\n\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :solicit, :completed],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n          )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_request(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {nil, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, %{iaid: iaid}} ->\n        # Allocate or renew lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_renew(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :renewed],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        # Renew existing lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :rebind],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n    )\n\n    # Rebind is similar to renew - reuse the renew logic\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_release(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :released],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        LeaseManager.release_lease(duid, iaid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_decline(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :declined],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n        LeaseManager.decline_ip(ia_addr, duid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_inform(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n    )\n\n    # INFORMATION-REQUEST - provide configuration without address allocation\n    reply = create_information_reply(message)\n    send_dhcpv6_response(reply, client_ip, client_port, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :completed],\n      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_forward(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :forward],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_reply(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :reply],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  # Message creation functions\n\n  defp create_reply(request, lease) do\n    pool = get_pool_for_lease(lease)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # IA_NA with IA_ADDR\n          create_ia_na_option(lease),\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  defp create_information_reply(request) do\n    pool = get_default_pool()\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  # Helper functions for creating options\n\n  defp create_ia_na_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_NA option (option 3) - contains IA_ADDR\n    # IAID + T1 + T2 (0 = server decides)\n    ia_na_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_na,\n      option_data: ia_na_data\n    }\n  end\n\n  defp create_dns_servers_option(dns_servers) do\n    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_dns_servers,\n      option_data: dns_data\n    }\n  end\n\n  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n\n  defp add_domain_list_option(options, domain) do\n    # Encode domain name in DNS format (length-prefixed labels)\n    domain_data = encode_domain_name(domain)\n\n    domain_option = %DHCPv6.Message.Option{\n      option_code: @option_domain_list,\n      option_data: domain_data\n    }\n\n    options ++ [domain_option]\n  end\n\n  defp encode_domain_name(domain) do\n    domain\n    |> String.split(\".\")\n    |> Enum.map_join(fn label ->\n      <<byte_size(label)::8, label::binary>>\n    end)\n    # Terminating zero\n    |> Kernel.<>(<<0>>)\n  end\n\n  # Helper functions for extracting information from messages\n\n  defp get_client_duid(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n      nil -> nil\n      option -> option.option_data\n    end\n  end\n\n  defp get_ia_na(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            # Try to extract IA_ADDR if present\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_ta(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n        case option.option_data do\n          <<iaid::32, rest::binary>> ->\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_pd(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            ia_prefix = extract_ia_prefix(rest)\n            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\n\n  # Allocation helper functions\n\n  defp allocate_temporary_address(duid, iaid) do\n    # Temporary addresses use a separate pool with shorter lifetimes\n    # For now, delegate to LeaseManager with IA_TA type marker\n    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n      {:ok, lease} ->\n        # Mark as temporary address with shorter lifetime\n        ta_lease = %{\n          lease\n          | ia_type: :ia_ta,\n            preferred_lifetime: 600,\n            # 10 minutes\n            valid_lifetime: 1200\n            # 20 minutes\n        }\n\n        {:ok, ta_lease}\n\n      error ->\n        error\n    end\n  end\n\n  defp allocate_prefix_delegation(duid, iaid) do\n    # For now, return a placeholder\n    # Full implementation would use PrefixPool module\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n      %{count: 1},\n      %{client_duid: duid, iaid: iaid}\n    )\n\n    # TODO: Integrate with PrefixPool module\n    # Example placeholder prefix: 2001:db8:1000::/56\n    {:ok,\n     %{\n       duid: duid,\n       iaid: iaid,\n       ia_type: :ia_pd,\n       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n       preferred_lifetime: 3600,\n       valid_lifetime: 7200,\n       pool_name: \"default-pd\"\n     }}\n  end\n\n  # Message creation functions with multi-IA support\n\n  defp create_advertise_multi(solicit, leases) do\n    pool = get_default_pool()\n\n    options = [\n      # Server DUID\n      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n      # Client DUID (echo back)\n      %DHCPv6.Message.Option{\n        option_code: @option_client_id,\n        option_data: get_client_duid(solicit)\n      },\n      # Preference\n      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n    ]\n\n    # Add IA options for each lease\n    ia_options =\n      Enum.flat_map(leases, fn lease ->\n        case lease.ia_type do\n          :ia_na -> [create_ia_na_option(lease)]\n          :ia_ta -> [create_ia_ta_option(lease)]\n          :ia_pd -> [create_ia_pd_option(lease)]\n          _ -> []\n        end\n      end)\n\n    # Add configuration options (DNS, etc.)\n    config_options =\n      [\n        create_dns_servers_option(pool.dns_servers)\n      ] ++ add_domain_list_option([], pool.domain_name)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_advertise,\n      transaction_id: solicit.transaction_id,\n      options: options ++ ia_options ++ config_options\n    }\n  end\n\n  defp create_ia_ta_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n    ia_ta_data =\n      <<lease.iaid::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_ta,\n      option_data: ia_ta_data\n    }\n  end\n\n  defp create_ia_pd_option(lease) do\n    {prefix_addr, prefix_len} = lease.delegated_prefix\n\n    # IA_PREFIX option (option 26)\n    ia_prefix_data =\n      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n        ipv6_to_binary(prefix_addr)\n\n    ia_prefix_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_prefix,\n      option_data: ia_prefix_data\n    }\n\n    # IA_PD option (option 25)\n    ia_pd_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_prefix_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_pd,\n      option_data: ia_pd_data\n    }\n  end\n\n  defp get_server_duid do\n    # Generate a simple DUID-LL (Link-Layer) based on server\n    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n    # Using a static server identifier for now\n    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use default pool\n    # In production, look up pool by lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    %{\n      name: \"default\",\n      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n      prefix_length: 64,\n      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n      domain_name: \"local\",\n      preferred_lifetime: 3600,\n      valid_lifetime: 7200\n    }\n  end\n\n  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :sent],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :send_failed],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Utility functions\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\nend\n","numLines":878,"startLine":1,"totalLines":878}}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_0136gBcx2mhzmz4wCwD9HLFn","type":"message","role":"assistant","content":[{"type":"text","text":"★ Insight ─────────────────────────────────────\n**Key Difference Found**: \n- `YellowDog.Dhcpv4.Handler` uses `use Abyss.Handler` which injects `use GenServer, restart: :temporary` and a `start_link/1` function\n- `YellowDog.Dhcpv6.Handler` does NOT use `use Abyss.Handler` - it's just a plain module with callback functions\n\nThe fix is simple: add `use Abyss.Handler` to the DHCPv6 handler module. This will inject the required `child_spec/1` via GenServer and the standard lifecycle callbacks.\n─────────────────────────────────────────────────"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":18394,"cache_creation_input_tokens":12219,"cache_read_input_tokens":62496,"cache_creation":{"ephemeral_5m_input_tokens":12219,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"3a4e84da-4e11-4d4d-abd1-19afb60f4894"}
