{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013HWXmpNHttW36h8De33yz8","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.LeaseManager do\n     2→  @moduledoc \"\"\"\n     3→  Manages DHCP lease allocation and tracking using Mnesia persistent storage.\n     4→\n     5→  Tracks active leases with MAC → IP bindings, handles lease expiration,\n     6→  and provides persistence across server restarts. Supports multiple lease\n     7→  states (offered, active, released, expired, declined) for full DHCP\n     8→  protocol compliance.\n     9→  \"\"\"\n    10→\n    11→  use GenServer\n    12→\n    13→  alias YellowDog.Dhcpv4.AddressPool\n    14→  alias YellowDog.Dhcpv4.LeaseStorage\n    15→\n    16→  # Run cleanup every minute\n    17→  @cleanup_interval 60_000\n    18→\n    19→  @type ip_address :: AddressPool.ip_address()\n    20→  @type mac_address :: binary()\n    21→  @type lease :: LeaseStorage.lease()\n    22→\n    23→  # Client API\n    24→\n    25→  @doc \"\"\"\n    26→  Starts the LeaseManager GenServer.\n    27→\n    28→  ## Options\n    29→  - `pools` - List of address pool configurations\n    30→\n    31→  ## Returns\n    32→  - `{:ok, pid}` - Successfully started\n    33→  - `{:error, reason}` - Failed to start\n    34→  \"\"\"\n    35→  @spec start_link(keyword()) :: GenServer.on_start()\n    36→  def start_link(opts \\\\ []) do\n    37→    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n    38→  end\n    39→\n    40→  @doc \"\"\"\n    41→  Allocates or renews a lease for a MAC address.\n    42→\n    43→  ## Parameters\n    44→  - `mac` - Client MAC address (6 bytes binary)\n    45→  - `requested_ip` - Optional requested IP address\n    46→  - `hostname` - Optional client hostname\n    47→  - `pool_name` - Pool name to allocate from (default: \"default\")\n    48→  - `client_id` - Optional client identifier (option 61)\n    49→\n    50→  ## Returns\n    51→  - `{:ok, lease}` - Successfully allocated/renewed lease\n    52→  - `{:error, reason}` - Failed to allocate lease\n    53→  \"\"\"\n    54→  @spec allocate_lease(\n    55→          mac_address(),\n    56→          ip_address() | nil,\n    57→          String.t() | nil,\n    58→          String.t(),\n    59→          binary() | nil\n    60→        ) ::\n    61→          {:ok, lease()} | {:error, term()}\n    62→  def allocate_lease(\n    63→        mac,\n    64→        requested_ip \\\\ nil,\n    65→        hostname \\\\ nil,\n    66→        pool_name \\\\ \"default\",\n    67→        client_id \\\\ nil\n    68→      ) do\n    69→    GenServer.call(\n    70→      __MODULE__,\n    71→      {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id}\n    72→    )\n    73→  end\n    74→\n    75→  @doc \"\"\"\n    76→  Releases a lease for a MAC address.\n    77→\n    78→  ## Parameters\n    79→  - `mac` - Client MAC address\n    80→\n    81→  ## Returns\n    82→  - `:ok` - Lease released\n    83→  \"\"\"\n    84→  @spec release_lease(mac_address()) :: :ok\n    85→  def release_lease(mac) do\n    86→    GenServer.call(__MODULE__, {:release_lease, mac})\n    87→  end\n    88→\n    89→  @doc \"\"\"\n    90→  Declines an IP address (marks it as unavailable for a period).\n    91→\n    92→  ## Parameters\n    93→  - `ip` - IP address to decline\n    94→  - `mac` - Client MAC address that declined\n    95→\n    96→  ## Returns\n    97→  - `:ok` - IP declined\n    98→  \"\"\"\n    99→  @spec decline_ip(ip_address(), mac_address()) :: :ok\n   100→  def decline_ip(ip, mac) do\n   101→    GenServer.call(__MODULE__, {:decline_ip, ip, mac})\n   102→  end\n   103→\n   104→  @doc \"\"\"\n   105→  Gets the current lease for a MAC address.\n   106→\n   107→  ## Parameters\n   108→  - `mac` - Client MAC address\n   109→\n   110→  ## Returns\n   111→  - `{:ok, lease}` - Active lease found\n   112→  - `{:error, :not_found}` - No active lease\n   113→  \"\"\"\n   114→  @spec get_lease(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n   115→  def get_lease(mac) do\n   116→    mac_key = normalize_mac(mac)\n   117→\n   118→    case LeaseStorage.get(mac_key) do\n   119→      {:ok, lease} ->\n   120→        # Check if lease is active and not expired\n   121→        if lease.state == :active && lease.expires_at > System.system_time(:second) do\n   122→          {:ok, lease}\n   123→        else\n   124→          {:error, :not_found}\n   125→        end\n   126→\n   127→      {:error, :not_found} ->\n   128→        {:error, :not_found}\n   129→    end\n   130→  end\n   131→\n   132→  @doc \"\"\"\n   133→  Gets all active leases.\n   134→\n   135→  ## Returns\n   136→  - List of active leases\n   137→  \"\"\"\n   138→  @spec list_leases() :: [lease()]\n   139→  def list_leases do\n   140→    LeaseStorage.list_active()\n   141→  end\n   142→\n   143→  @doc \"\"\"\n   144→  Gets all allocated IP addresses.\n   145→\n   146→  ## Returns\n   147→  - MapSet of allocated IP addresses\n   148→  \"\"\"\n   149→  @spec get_allocated_ips() :: MapSet.t(ip_address())\n   150→  def get_allocated_ips do\n   151→    LeaseStorage.get_allocated_ips()\n   152→  end\n   153→\n   154→  @doc \"\"\"\n   155→  Gets lease statistics.\n   156→\n   157→  ## Returns\n   158→  - Map with lease statistics\n   159→  \"\"\"\n   160→  @spec stats() :: map()\n   161→  def stats do\n   162→    LeaseStorage.stats()\n   163→  end\n   164→\n   165→  @doc \"\"\"\n   166→  Gets all configured pools.\n   167→\n   168→  ## Returns\n   169→  - List of pool configurations\n   170→  \"\"\"\n   171→  @spec get_pools() :: [AddressPool.pool_config()]\n   172→  def get_pools do\n   173→    GenServer.call(__MODULE__, :get_pools)\n   174→  end\n   175→\n   176→  @doc \"\"\"\n   177→  Gets statistics for a specific pool.\n   178→\n   179→  ## Parameters\n   180→  - `pool_name` - Name of the pool\n   181→\n   182→  ## Returns\n   183→  - `{:ok, stats}` - Pool statistics\n   184→  - `{:error, :pool_not_found}` - Pool does not exist\n   185→  \"\"\"\n   186→  @spec get_pool_stats(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n   187→  def get_pool_stats(pool_name) do\n   188→    GenServer.call(__MODULE__, {:get_pool_stats, pool_name})\n   189→  end\n   190→\n   191→  @doc \"\"\"\n   192→  Gets statistics for all pools.\n   193→\n   194→  ## Returns\n   195→  - Map with pool names as keys and statistics as values\n   196→  \"\"\"\n   197→  @spec get_all_pool_stats() :: map()\n   198→  def get_all_pool_stats do\n   199→    GenServer.call(__MODULE__, :get_all_pool_stats)\n   200→  end\n   201→\n   202→  @doc \"\"\"\n   203→  Gets the configuration for a specific pool.\n   204→\n   205→  ## Parameters\n   206→  - `pool_name` - Name of the pool\n   207→\n   208→  ## Returns\n   209→  - `{:ok, config}` - Pool configuration\n   210→  - `{:error, :pool_not_found}` - Pool does not exist\n   211→  \"\"\"\n   212→  @spec get_pool_config(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n   213→  def get_pool_config(pool_name) do\n   214→    GenServer.call(__MODULE__, {:get_pool_config, pool_name})\n   215→  end\n   216→\n   217→  @doc \"\"\"\n   218→  Gets static reservations for a specific pool.\n   219→\n   220→  ## Parameters\n   221→  - `pool_name` - Name of the pool\n   222→\n   223→  ## Returns\n   224→  - List of static reservations\n   225→  \"\"\"\n   226→  @spec get_static_reservations(String.t()) :: [map()]\n   227→  def get_static_reservations(pool_name) do\n   228→    GenServer.call(__MODULE__, {:get_static_reservations, pool_name})\n   229→  end\n   230→\n   231→  # Server Callbacks\n   232→\n   233→  @impl true\n   234→  def init(opts) do\n   235→    # Initialize Mnesia storage\n   236→    storage_type = if Mix.env() == :test, do: :ram_copies, else: :disc_copies\n   237→\n   238→    case LeaseStorage.init(storage_type: storage_type) do\n   239→      :ok ->\n   240→        :telemetry.execute(\n   241→          [:yellow_dog, :dhcpv4, :storage, :initialized],\n   242→          %{count: 1},\n   243→          %{storage_type: storage_type}\n   244→        )\n   245→\n   246→      {:error, reason} ->\n   247→        :telemetry.execute(\n   248→          [:yellow_dog, :dhcpv4, :storage, :init_failed],\n   249→          %{count: 1},\n   250→          %{reason: inspect(reason)}\n   251→        )\n   252→    end\n   253→\n   254→    # Extract pools from options\n   255→    pools = Keyword.get(opts, :pools, [])\n   256→\n   257→    # Parse pools into AddressPool configs\n   258→    parsed_pools =\n   259→      Enum.map(pools, fn pool_config ->\n   260→        case AddressPool.new(pool_config) do\n   261→          {:ok, pool} ->\n   262→            pool\n   263→\n   264→          {:error, reason} ->\n   265→            :telemetry.execute(\n   266→              [:yellow_dog, :dhcpv4, :pool, :creation_failed],\n   267→              %{count: 1},\n   268→              %{reason: inspect(reason)}\n   269→            )\n   270→\n   271→            nil\n   272→        end\n   273→      end)\n   274→      |> Enum.reject(&is_nil/1)\n   275→\n   276→    # Schedule periodic cleanup\n   277→    schedule_cleanup()\n   278→\n   279→    state = %{\n   280→      pools: parsed_pools\n   281→    }\n   282→\n   283→    :telemetry.execute(\n   284→      [:yellow_dog, :dhcpv4, :lease_manager, :started],\n   285→      %{count: 1, pool_count: length(parsed_pools)},\n   286→      %{}\n   287→    )\n   288→\n   289→    {:ok, state}\n   290→  end\n   291→\n   292→  @impl true\n   293→  def handle_call(\n   294→        {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id},\n   295→        _from,\n   296→        state\n   297→      ) do\n   298→    # Find the pool\n   299→    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n   300→\n   301→    if pool do\n   302→      result = do_allocate_lease(mac, requested_ip, hostname, pool, client_id)\n   303→      {:reply, result, state}\n   304→    else\n   305→      {:reply, {:error, :pool_not_found}, state}\n   306→    end\n   307→  end\n   308→\n   309→  @impl true\n   310→  def handle_call({:release_lease, mac}, _from, state) do\n   311→    mac_key = normalize_mac(mac)\n   312→\n   313→    case LeaseStorage.update_state(mac_key, :released) do\n   314→      {:ok, _lease} ->\n   315→        :telemetry.execute(\n   316→          [:yellow_dog, :dhcpv4, :lease, :release_completed],\n   317→          %{count: 1},\n   318→          %{client_mac: mac_key}\n   319→        )\n   320→\n   321→        {:reply, :ok, state}\n   322→\n   323→      {:error, :not_found} ->\n   324→        :telemetry.execute(\n   325→          [:yellow_dog, :dhcpv4, :lease, :release_not_found],\n   326→          %{count: 1},\n   327→          %{client_mac: mac_key}\n   328→        )\n   329→\n   330→        {:reply, :ok, state}\n   331→\n   332→      {:error, reason} ->\n   333→        :telemetry.execute(\n   334→          [:yellow_dog, :dhcpv4, :lease, :release_failed],\n   335→          %{count: 1},\n   336→          %{reason: inspect(reason)}\n   337→        )\n   338→\n   339→        {:reply, {:error, reason}, state}\n   340→    end\n   341→  end\n   342→\n   343→  @impl true\n   344→  def handle_call({:decline_ip, ip, mac}, _from, state) do\n   345→    mac_key = normalize_mac(mac)\n   346→\n   347→    case LeaseStorage.update_state(mac_key, :declined) do\n   348→      {:ok, _lease} ->\n   349→        :telemetry.execute(\n   350→          [:yellow_dog, :dhcpv4, :lease, :decline_completed],\n   351→          %{count: 1},\n   352→          %{client_mac: mac_key, declined_ip: ip}\n   353→        )\n   354→\n   355→        {:reply, :ok, state}\n   356→\n   357→      {:error, :not_found} ->\n   358→        :telemetry.execute(\n   359→          [:yellow_dog, :dhcpv4, :lease, :decline_not_found],\n   360→          %{count: 1},\n   361→          %{client_mac: mac_key}\n   362→        )\n   363→\n   364→        {:reply, :ok, state}\n   365→\n   366→      {:error, reason} ->\n   367→        :telemetry.execute(\n   368→          [:yellow_dog, :dhcpv4, :lease, :decline_failed],\n   369→          %{count: 1},\n   370→          %{reason: inspect(reason)}\n   371→        )\n   372→\n   373→        {:reply, {:error, reason}, state}\n   374→    end\n   375→  end\n   376→\n   377→  @impl true\n   378→  def handle_call(:get_pools, _from, state) do\n   379→    {:reply, state.pools, state}\n   380→  end\n   381→\n   382→  @impl true\n   383→  def handle_call({:get_pool_stats, pool_name}, _from, state) do\n   384→    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n   385→\n   386→    if pool do\n   387→      stats = YellowDog.Dhcpv4.PoolStats.get_pool_stats(pool)\n   388→      {:reply, {:ok, stats}, state}\n   389→    else\n   390→      {:reply, {:error, :pool_not_found}, state}\n   391→    end\n   392→  end\n   393→\n   394→  @impl true\n   395→  def handle_call(:get_all_pool_stats, _from, state) do\n   396→    stats = YellowDog.Dhcpv4.PoolStats.get_all_pool_stats(state.pools)\n   397→    {:reply, stats, state}\n   398→  end\n   399→\n   400→  @impl true\n   401→  def handle_call({:get_pool_config, pool_name}, _from, state) do\n   402→    case Enum.find(state.pools, fn pool -> pool.name == pool_name end) do\n   403→      nil ->\n   404→        {:reply, {:error, :pool_not_found}, state}\n   405→\n   406→      pool ->\n   407→        # Return the full pool struct for use with AddressPool functions\n   408→        {:reply, {:ok, pool}, state}\n   409→    end\n   410→  end\n   411→\n   412→  @impl true\n   413→  def handle_call({:get_static_reservations, pool_name}, _from, state) do\n   414→    case Enum.find(state.pools, fn pool -> pool.name == pool_name end) do\n   415→      nil ->\n   416→        {:reply, [], state}\n   417→\n   418→      pool ->\n   419→        reservations =\n   420→          pool.static_reservations\n   421→          |> Enum.map(fn {mac, ip} ->\n   422→            %{\n   423→              mac_address: mac,\n   424→              ip_address: ip,\n   425→              description: nil\n   426→            }\n   427→          end)\n   428→\n   429→        {:reply, reservations, state}\n   430→    end\n   431→  end\n   432→\n   433→  @impl true\n   434→  def handle_info(:cleanup_expired_leases, state) do\n   435→    case LeaseStorage.cleanup_expired() do\n   436→      {:ok, _count} ->\n   437→        :ok\n   438→\n   439→      {:error, reason} ->\n   440→        :telemetry.execute(\n   441→          [:yellow_dog, :dhcpv4, :lease, :cleanup_failed],\n   442→          %{count: 1},\n   443→          %{reason: inspect(reason)}\n   444→        )\n   445→    end\n   446→\n   447→    schedule_cleanup()\n   448→    {:noreply, state}\n   449→  end\n   450→\n   451→  # Private helper functions\n   452→\n   453→  defp do_allocate_lease(mac, requested_ip, hostname, pool, client_id) do\n   454→    mac_key = normalize_mac(mac)\n   455→\n   456→    # Check for existing lease\n   457→    case LeaseStorage.get(mac_key) do\n   458→      {:ok, existing_lease} ->\n   459→        # Renew existing lease\n   460→        renewed_lease = renew_lease(existing_lease, hostname, client_id)\n   461→\n   462→        case LeaseStorage.put(renewed_lease) do\n   463→          {:ok, lease} ->\n   464→            :telemetry.execute(\n   465→              [:yellow_dog, :dhcpv4, :lease, :renewed],\n   466→              %{count: 1},\n   467→              %{client_mac: mac_key, ip_address: lease.ip_address}\n   468→            )\n   469→\n   470→            {:ok, lease}\n   471→\n   472→          {:error, reason} ->\n   473→            :telemetry.execute(\n   474→              [:yellow_dog, :dhcpv4, :lease, :renew_failed],\n   475→              %{count: 1},\n   476→              %{reason: inspect(reason)}\n   477→            )\n   478→\n   479→            {:error, reason}\n   480→        end\n   481→\n   482→      {:error, :not_found} ->\n   483→        # Allocate new lease\n   484→        allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n   485→    end\n   486→  end\n   487→\n   488→  defp allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n   489→    # Check max_leases limit before allocation (PRD FR1.6)\n   490→    max_leases = Map.get(pool, :max_leases, 1000)\n   491→    current_lease_count = count_pool_leases(pool.name)\n   492→\n   493→    if current_lease_count >= max_leases do\n   494→      :telemetry.execute(\n   495→        [:yellow_dog, :dhcpv4, :pool, :limit_exceeded],\n   496→        %{count: 1, current: current_lease_count, max: max_leases},\n   497→        %{pool_name: pool.name}\n   498→      )\n   499→\n   500→      {:error, :pool_limit_exceeded}\n   501→    else\n   502→      do_allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n   503→    end\n   504→  end\n   505→\n   506→  defp do_allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n   507→    allocated_ips = get_allocated_ips()\n   508→\n   509→    # Try to honor requested IP if provided and available\n   510→    ip =\n   511→      cond do\n   512→        requested_ip && AddressPool.in_range?(pool, requested_ip) &&\n   513→            not MapSet.member?(allocated_ips, requested_ip) ->\n   514→          requested_ip\n   515→\n   516→        true ->\n   517→          case AddressPool.get_available_ip(pool, allocated_ips, mac) do\n   518→            {:ok, available_ip} -> available_ip\n   519→            {:error, :pool_exhausted} -> nil\n   520→          end\n   521→      end\n   522→\n   523→    if ip do\n   524→      now = System.system_time(:second)\n   525→\n   526→      lease = %{\n   527→        mac_address: mac_key,\n   528→        ip_address: ip,\n   529→        pool_name: pool.name,\n   530→        state: :active,\n   531→        lease_time: pool.lease_time,\n   532→        expires_at: now + pool.lease_time,\n   533→        hostname: hostname,\n   534→        client_id: client_id,\n   535→        created_at: now,\n   536→        updated_at: now\n   537→      }\n   538→\n   539→      case LeaseStorage.put(lease) do\n   540→        {:ok, stored_lease} ->\n   541→          :telemetry.execute(\n   542→            [:yellow_dog, :dhcpv4, :lease, :allocated],\n   543→            %{count: 1},\n   544→            %{client_mac: mac_key, ip_address: ip, pool_name: pool.name}\n   545→          )\n   546→\n   547→          {:ok, stored_lease}\n   548→\n   549→        {:error, reason} ->\n   550→          :telemetry.execute(\n   551→            [:yellow_dog, :dhcpv4, :lease, :store_failed],\n   552→            %{count: 1},\n   553→            %{reason: inspect(reason)}\n   554→          )\n   555→\n   556→          {:error, reason}\n   557→      end\n   558→    else\n   559→      :telemetry.execute(\n   560→        [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   561→        %{count: 1},\n   562→        %{pool_name: pool.name}\n   563→      )\n   564→\n   565→      {:error, :pool_exhausted}\n   566→    end\n   567→  end\n   568→\n   569→  defp renew_lease(lease, hostname, client_id) do\n   570→    now = System.system_time(:second)\n   571→\n   572→    %{\n   573→      lease\n   574→      | state: :active,\n   575→        expires_at: now + lease.lease_time,\n   576→        hostname: hostname || lease.hostname,\n   577→        client_id: client_id || lease.client_id,\n   578→        updated_at: now\n   579→    }\n   580→  end\n   581→\n   582→  defp schedule_cleanup do\n   583→    Process.send_after(self(), :cleanup_expired_leases, @cleanup_interval)\n   584→  end\n   585→\n   586→  # Count active leases for a pool (PRD FR1.6)\n   587→  defp count_pool_leases(pool_name) do\n   588→    LeaseStorage.list(pool_name: pool_name, active_only: true)\n   589→    |> length()\n   590→  end\n   591→\n   592→  # Normalize MAC address to consistent binary format\n   593→  defp normalize_mac(<<mac::binary-size(6)>>), do: mac\n   594→\n   595→  defp normalize_mac(mac) when is_binary(mac) and byte_size(mac) == 16 do\n   596→    # Handle padded MAC address from DHCP message (16 bytes with trailing zeros)\n   597→    <<actual_mac::binary-size(6), _rest::binary>> = mac\n   598→    actual_mac\n   599→  end\n   600→\n   601→  defp normalize_mac(mac) when is_binary(mac), do: mac\n   602→end\n   603→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"7945bb50-941d-4a8f-bfc0-9b5ae667bb15","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_manager.ex","content":"defmodule YellowDog.Dhcpv4.LeaseManager do\n  @moduledoc \"\"\"\n  Manages DHCP lease allocation and tracking using Mnesia persistent storage.\n\n  Tracks active leases with MAC → IP bindings, handles lease expiration,\n  and provides persistence across server restarts. Supports multiple lease\n  states (offered, active, released, expired, declined) for full DHCP\n  protocol compliance.\n  \"\"\"\n\n  use GenServer\n\n  alias YellowDog.Dhcpv4.AddressPool\n  alias YellowDog.Dhcpv4.LeaseStorage\n\n  # Run cleanup every minute\n  @cleanup_interval 60_000\n\n  @type ip_address :: AddressPool.ip_address()\n  @type mac_address :: binary()\n  @type lease :: LeaseStorage.lease()\n\n  # Client API\n\n  @doc \"\"\"\n  Starts the LeaseManager GenServer.\n\n  ## Options\n  - `pools` - List of address pool configurations\n\n  ## Returns\n  - `{:ok, pid}` - Successfully started\n  - `{:error, reason}` - Failed to start\n  \"\"\"\n  @spec start_link(keyword()) :: GenServer.on_start()\n  def start_link(opts \\\\ []) do\n    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Allocates or renews a lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address (6 bytes binary)\n  - `requested_ip` - Optional requested IP address\n  - `hostname` - Optional client hostname\n  - `pool_name` - Pool name to allocate from (default: \"default\")\n  - `client_id` - Optional client identifier (option 61)\n\n  ## Returns\n  - `{:ok, lease}` - Successfully allocated/renewed lease\n  - `{:error, reason}` - Failed to allocate lease\n  \"\"\"\n  @spec allocate_lease(\n          mac_address(),\n          ip_address() | nil,\n          String.t() | nil,\n          String.t(),\n          binary() | nil\n        ) ::\n          {:ok, lease()} | {:error, term()}\n  def allocate_lease(\n        mac,\n        requested_ip \\\\ nil,\n        hostname \\\\ nil,\n        pool_name \\\\ \"default\",\n        client_id \\\\ nil\n      ) do\n    GenServer.call(\n      __MODULE__,\n      {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id}\n    )\n  end\n\n  @doc \"\"\"\n  Releases a lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address\n\n  ## Returns\n  - `:ok` - Lease released\n  \"\"\"\n  @spec release_lease(mac_address()) :: :ok\n  def release_lease(mac) do\n    GenServer.call(__MODULE__, {:release_lease, mac})\n  end\n\n  @doc \"\"\"\n  Declines an IP address (marks it as unavailable for a period).\n\n  ## Parameters\n  - `ip` - IP address to decline\n  - `mac` - Client MAC address that declined\n\n  ## Returns\n  - `:ok` - IP declined\n  \"\"\"\n  @spec decline_ip(ip_address(), mac_address()) :: :ok\n  def decline_ip(ip, mac) do\n    GenServer.call(__MODULE__, {:decline_ip, ip, mac})\n  end\n\n  @doc \"\"\"\n  Gets the current lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address\n\n  ## Returns\n  - `{:ok, lease}` - Active lease found\n  - `{:error, :not_found}` - No active lease\n  \"\"\"\n  @spec get_lease(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get_lease(mac) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.get(mac_key) do\n      {:ok, lease} ->\n        # Check if lease is active and not expired\n        if lease.state == :active && lease.expires_at > System.system_time(:second) do\n          {:ok, lease}\n        else\n          {:error, :not_found}\n        end\n\n      {:error, :not_found} ->\n        {:error, :not_found}\n    end\n  end\n\n  @doc \"\"\"\n  Gets all active leases.\n\n  ## Returns\n  - List of active leases\n  \"\"\"\n  @spec list_leases() :: [lease()]\n  def list_leases do\n    LeaseStorage.list_active()\n  end\n\n  @doc \"\"\"\n  Gets all allocated IP addresses.\n\n  ## Returns\n  - MapSet of allocated IP addresses\n  \"\"\"\n  @spec get_allocated_ips() :: MapSet.t(ip_address())\n  def get_allocated_ips do\n    LeaseStorage.get_allocated_ips()\n  end\n\n  @doc \"\"\"\n  Gets lease statistics.\n\n  ## Returns\n  - Map with lease statistics\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    LeaseStorage.stats()\n  end\n\n  @doc \"\"\"\n  Gets all configured pools.\n\n  ## Returns\n  - List of pool configurations\n  \"\"\"\n  @spec get_pools() :: [AddressPool.pool_config()]\n  def get_pools do\n    GenServer.call(__MODULE__, :get_pools)\n  end\n\n  @doc \"\"\"\n  Gets statistics for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - `{:ok, stats}` - Pool statistics\n  - `{:error, :pool_not_found}` - Pool does not exist\n  \"\"\"\n  @spec get_pool_stats(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n  def get_pool_stats(pool_name) do\n    GenServer.call(__MODULE__, {:get_pool_stats, pool_name})\n  end\n\n  @doc \"\"\"\n  Gets statistics for all pools.\n\n  ## Returns\n  - Map with pool names as keys and statistics as values\n  \"\"\"\n  @spec get_all_pool_stats() :: map()\n  def get_all_pool_stats do\n    GenServer.call(__MODULE__, :get_all_pool_stats)\n  end\n\n  @doc \"\"\"\n  Gets the configuration for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - `{:ok, config}` - Pool configuration\n  - `{:error, :pool_not_found}` - Pool does not exist\n  \"\"\"\n  @spec get_pool_config(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n  def get_pool_config(pool_name) do\n    GenServer.call(__MODULE__, {:get_pool_config, pool_name})\n  end\n\n  @doc \"\"\"\n  Gets static reservations for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - List of static reservations\n  \"\"\"\n  @spec get_static_reservations(String.t()) :: [map()]\n  def get_static_reservations(pool_name) do\n    GenServer.call(__MODULE__, {:get_static_reservations, pool_name})\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(opts) do\n    # Initialize Mnesia storage\n    storage_type = if Mix.env() == :test, do: :ram_copies, else: :disc_copies\n\n    case LeaseStorage.init(storage_type: storage_type) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :storage, :initialized],\n          %{count: 1},\n          %{storage_type: storage_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :storage, :init_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n    end\n\n    # Extract pools from options\n    pools = Keyword.get(opts, :pools, [])\n\n    # Parse pools into AddressPool configs\n    parsed_pools =\n      Enum.map(pools, fn pool_config ->\n        case AddressPool.new(pool_config) do\n          {:ok, pool} ->\n            pool\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :pool, :creation_failed],\n              %{count: 1},\n              %{reason: inspect(reason)}\n            )\n\n            nil\n        end\n      end)\n      |> Enum.reject(&is_nil/1)\n\n    # Schedule periodic cleanup\n    schedule_cleanup()\n\n    state = %{\n      pools: parsed_pools\n    }\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease_manager, :started],\n      %{count: 1, pool_count: length(parsed_pools)},\n      %{}\n    )\n\n    {:ok, state}\n  end\n\n  @impl true\n  def handle_call(\n        {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id},\n        _from,\n        state\n      ) do\n    # Find the pool\n    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n\n    if pool do\n      result = do_allocate_lease(mac, requested_ip, hostname, pool, client_id)\n      {:reply, result, state}\n    else\n      {:reply, {:error, :pool_not_found}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:release_lease, mac}, _from, state) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.update_state(mac_key, :released) do\n      {:ok, _lease} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_completed],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, :not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_not_found],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:reply, {:error, reason}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:decline_ip, ip, mac}, _from, state) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.update_state(mac_key, :declined) do\n      {:ok, _lease} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_completed],\n          %{count: 1},\n          %{client_mac: mac_key, declined_ip: ip}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, :not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_not_found],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:reply, {:error, reason}, state}\n    end\n  end\n\n  @impl true\n  def handle_call(:get_pools, _from, state) do\n    {:reply, state.pools, state}\n  end\n\n  @impl true\n  def handle_call({:get_pool_stats, pool_name}, _from, state) do\n    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n\n    if pool do\n      stats = YellowDog.Dhcpv4.PoolStats.get_pool_stats(pool)\n      {:reply, {:ok, stats}, state}\n    else\n      {:reply, {:error, :pool_not_found}, state}\n    end\n  end\n\n  @impl true\n  def handle_call(:get_all_pool_stats, _from, state) do\n    stats = YellowDog.Dhcpv4.PoolStats.get_all_pool_stats(state.pools)\n    {:reply, stats, state}\n  end\n\n  @impl true\n  def handle_call({:get_pool_config, pool_name}, _from, state) do\n    case Enum.find(state.pools, fn pool -> pool.name == pool_name end) do\n      nil ->\n        {:reply, {:error, :pool_not_found}, state}\n\n      pool ->\n        # Return the full pool struct for use with AddressPool functions\n        {:reply, {:ok, pool}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:get_static_reservations, pool_name}, _from, state) do\n    case Enum.find(state.pools, fn pool -> pool.name == pool_name end) do\n      nil ->\n        {:reply, [], state}\n\n      pool ->\n        reservations =\n          pool.static_reservations\n          |> Enum.map(fn {mac, ip} ->\n            %{\n              mac_address: mac,\n              ip_address: ip,\n              description: nil\n            }\n          end)\n\n        {:reply, reservations, state}\n    end\n  end\n\n  @impl true\n  def handle_info(:cleanup_expired_leases, state) do\n    case LeaseStorage.cleanup_expired() do\n      {:ok, _count} ->\n        :ok\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :cleanup_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n    end\n\n    schedule_cleanup()\n    {:noreply, state}\n  end\n\n  # Private helper functions\n\n  defp do_allocate_lease(mac, requested_ip, hostname, pool, client_id) do\n    mac_key = normalize_mac(mac)\n\n    # Check for existing lease\n    case LeaseStorage.get(mac_key) do\n      {:ok, existing_lease} ->\n        # Renew existing lease\n        renewed_lease = renew_lease(existing_lease, hostname, client_id)\n\n        case LeaseStorage.put(renewed_lease) do\n          {:ok, lease} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :lease, :renewed],\n              %{count: 1},\n              %{client_mac: mac_key, ip_address: lease.ip_address}\n            )\n\n            {:ok, lease}\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason)}\n            )\n\n            {:error, reason}\n        end\n\n      {:error, :not_found} ->\n        # Allocate new lease\n        allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n    end\n  end\n\n  defp allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n    # Check max_leases limit before allocation (PRD FR1.6)\n    max_leases = Map.get(pool, :max_leases, 1000)\n    current_lease_count = count_pool_leases(pool.name)\n\n    if current_lease_count >= max_leases do\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :pool, :limit_exceeded],\n        %{count: 1, current: current_lease_count, max: max_leases},\n        %{pool_name: pool.name}\n      )\n\n      {:error, :pool_limit_exceeded}\n    else\n      do_allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n    end\n  end\n\n  defp do_allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n    allocated_ips = get_allocated_ips()\n\n    # Try to honor requested IP if provided and available\n    ip =\n      cond do\n        requested_ip && AddressPool.in_range?(pool, requested_ip) &&\n            not MapSet.member?(allocated_ips, requested_ip) ->\n          requested_ip\n\n        true ->\n          case AddressPool.get_available_ip(pool, allocated_ips, mac) do\n            {:ok, available_ip} -> available_ip\n            {:error, :pool_exhausted} -> nil\n          end\n      end\n\n    if ip do\n      now = System.system_time(:second)\n\n      lease = %{\n        mac_address: mac_key,\n        ip_address: ip,\n        pool_name: pool.name,\n        state: :active,\n        lease_time: pool.lease_time,\n        expires_at: now + pool.lease_time,\n        hostname: hostname,\n        client_id: client_id,\n        created_at: now,\n        updated_at: now\n      }\n\n      case LeaseStorage.put(lease) do\n        {:ok, stored_lease} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease, :allocated],\n            %{count: 1},\n            %{client_mac: mac_key, ip_address: ip, pool_name: pool.name}\n          )\n\n          {:ok, stored_lease}\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease, :store_failed],\n            %{count: 1},\n            %{reason: inspect(reason)}\n          )\n\n          {:error, reason}\n      end\n    else\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :pool, :exhausted],\n        %{count: 1},\n        %{pool_name: pool.name}\n      )\n\n      {:error, :pool_exhausted}\n    end\n  end\n\n  defp renew_lease(lease, hostname, client_id) do\n    now = System.system_time(:second)\n\n    %{\n      lease\n      | state: :active,\n        expires_at: now + lease.lease_time,\n        hostname: hostname || lease.hostname,\n        client_id: client_id || lease.client_id,\n        updated_at: now\n    }\n  end\n\n  defp schedule_cleanup do\n    Process.send_after(self(), :cleanup_expired_leases, @cleanup_interval)\n  end\n\n  # Count active leases for a pool (PRD FR1.6)\n  defp count_pool_leases(pool_name) do\n    LeaseStorage.list(pool_name: pool_name, active_only: true)\n    |> length()\n  end\n\n  # Normalize MAC address to consistent binary format\n  defp normalize_mac(<<mac::binary-size(6)>>), do: mac\n\n  defp normalize_mac(mac) when is_binary(mac) and byte_size(mac) == 16 do\n    # Handle padded MAC address from DHCP message (16 bytes with trailing zeros)\n    <<actual_mac::binary-size(6), _rest::binary>> = mac\n    actual_mac\n  end\n\n  defp normalize_mac(mac) when is_binary(mac), do: mac\nend\n","numLines":603,"startLine":1,"totalLines":603}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tELgTdubkyy5wPpzPTtAw","type":"tool_result","content":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/address_pool.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/config_watcher.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_storage.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/pool_stats.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/server.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/acl.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/custom_options.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/pool_config.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_manager.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/handler.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/conflict_resolver.ex\n/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/supervisor.ex"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"a5dd31f7-36ea-4dd6-87b3-ffbbe649b089","tool_use_result":{"filenames":["/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/address_pool.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/config_watcher.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_storage.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/pool_stats.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/server.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/acl.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/custom_options.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/pool_config.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_manager.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/handler.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/conflict_resolver.ex","/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/supervisor.ex"],"durationMs":22,"numFiles":12,"truncated":false}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_019BxnD53LnbjZSTpGegxTnL","type":"message","role":"assistant","content":[{"type":"text","text":"`★ Insight ─────────────────────────────────────`\n**LeaseManager Architecture:**\n- LeaseManager already uses `LeaseStorage` module (abstraction layer exists)\n- Uses Mnesia with `disc_copies` in prod, `ram_copies` in test\n- Already supports atomic transactions, lease expiration, and cleanup\n- FR5 persistence appears to be implemented via Mnesia (not DETS as originally in PRD)\n`─────────────────────────────────────────────────`"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7840,"cache_read_input_tokens":65621,"cache_creation":{"ephemeral_5m_input_tokens":7840,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"8f392094-020b-422b-bc0e-8c31fe924dd1"}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_019BxnD53LnbjZSTpGegxTnL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Hb5MgcTCYeugqM4qZYHNNU","name":"Read","input":{"file_path":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_storage.ex"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7840,"cache_read_input_tokens":65621,"cache_creation":{"ephemeral_5m_input_tokens":7840,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"5a439b7b-0c5e-489b-8d01-2b88e5045eda"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hb5MgcTCYeugqM4qZYHNNU","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.LeaseStorage do\n     2→  @moduledoc \"\"\"\n     3→  Persistent lease storage using Mnesia.\n     4→\n     5→  Provides a durable, transactional storage layer for DHCP leases with\n     6→  support for multiple lease states and comprehensive querying.\n     7→\n     8→  ## Lease States\n     9→\n    10→  - `:offered` - IP address offered to client, awaiting REQUEST\n    11→  - `:active` - Lease active and in use by client\n    12→  - `:released` - Client released the lease voluntarily\n    13→  - `:expired` - Lease exceeded its lifetime\n    14→  - `:declined` - Client declined the offered IP (conflict detected)\n    15→\n    16→  ## Storage Modes\n    17→\n    18→  - `:disc_copies` - Persistent storage (default for production)\n    19→  - `:ram_copies` - Memory-only storage (for testing)\n    20→  \"\"\"\n    21→\n    22→  require Record\n    23→\n    24→  alias YellowDog.Dhcpv4.AddressPool\n    25→\n    26→  @type ip_address :: AddressPool.ip_address()\n    27→  @type mac_address :: binary()\n    28→  @type client_id :: binary() | nil\n    29→  @type lease_state :: :offered | :active | :released | :expired | :declined\n    30→\n    31→  @type lease :: %{\n    32→          mac_address: mac_address(),\n    33→          ip_address: ip_address(),\n    34→          pool_name: String.t(),\n    35→          state: lease_state(),\n    36→          lease_time: pos_integer(),\n    37→          expires_at: integer(),\n    38→          hostname: String.t() | nil,\n    39→          client_id: client_id(),\n    40→          created_at: integer(),\n    41→          updated_at: integer()\n    42→        }\n    43→\n    44→  # Define Mnesia record\n    45→  Record.defrecord(:lease_record,\n    46→    mac_address: nil,\n    47→    ip_address: nil,\n    48→    pool_name: nil,\n    49→    state: :offered,\n    50→    lease_time: 0,\n    51→    expires_at: 0,\n    52→    hostname: nil,\n    53→    client_id: nil,\n    54→    created_at: 0,\n    55→    updated_at: 0\n    56→  )\n    57→\n    58→  @table_name :dhcpv4_leases\n    59→\n    60→  ## Public API\n    61→\n    62→  @doc \"\"\"\n    63→  Initializes the Mnesia schema and creates the leases table.\n    64→\n    65→  ## Options\n    66→\n    67→  - `:storage_type` - `:disc_copies` (default) or `:ram_copies`\n    68→  - `:nodes` - List of nodes to create table on (default: [node()])\n    69→\n    70→  ## Returns\n    71→\n    72→  - `:ok` - Successfully initialized\n    73→  - `{:error, reason}` - Failed to initialize\n    74→  \"\"\"\n    75→  @spec init(keyword()) :: :ok | {:error, term()}\n    76→  def init(opts \\\\ []) do\n    77→    storage_type = Keyword.get(opts, :storage_type, :disc_copies)\n    78→    nodes = Keyword.get(opts, :nodes, [node()])\n    79→\n    80→    with :ok <- ensure_schema_created(nodes),\n    81→         :ok <- ensure_table_created(storage_type, nodes) do\n    82→      :telemetry.execute(\n    83→        [:yellow_dog, :dhcpv4, :lease_storage, :initialized],\n    84→        %{count: 1},\n    85→        %{storage_type: storage_type, nodes: nodes}\n    86→      )\n    87→\n    88→      :ok\n    89→    else\n    90→      {:error, reason} = error ->\n    91→        :telemetry.execute(\n    92→          [:yellow_dog, :dhcpv4, :lease_storage, :init_failed],\n    93→          %{count: 1},\n    94→          %{reason: inspect(reason)}\n    95→        )\n    96→\n    97→        error\n    98→    end\n    99→  end\n   100→\n   101→  @doc \"\"\"\n   102→  Stores or updates a lease in the database.\n   103→\n   104→  ## Parameters\n   105→\n   106→  - `lease` - Lease map with required fields\n   107→\n   108→  ## Returns\n   109→\n   110→  - `{:ok, lease}` - Successfully stored\n   111→  - `{:error, reason}` - Failed to store\n   112→  \"\"\"\n   113→  @spec put(lease()) :: {:ok, lease()} | {:error, term()}\n   114→  def put(lease) do\n   115→    now = System.system_time(:second)\n   116→\n   117→    record =\n   118→      lease_record(\n   119→        mac_address: lease.mac_address,\n   120→        ip_address: lease.ip_address,\n   121→        pool_name: lease.pool_name,\n   122→        state: lease.state,\n   123→        lease_time: lease.lease_time,\n   124→        expires_at: lease.expires_at,\n   125→        hostname: lease[:hostname],\n   126→        client_id: lease[:client_id],\n   127→        created_at: lease[:created_at] || now,\n   128→        updated_at: now\n   129→      )\n   130→\n   131→    transaction = fn ->\n   132→      :mnesia.write(@table_name, record, :write)\n   133→      record_to_map(record)\n   134→    end\n   135→\n   136→    case :mnesia.transaction(transaction) do\n   137→      {:atomic, result} ->\n   138→        {:ok, result}\n   139→\n   140→      {:aborted, reason} ->\n   141→        :telemetry.execute(\n   142→          [:yellow_dog, :dhcpv4, :lease_storage, :store_failed],\n   143→          %{count: 1},\n   144→          %{reason: inspect(reason)}\n   145→        )\n   146→\n   147→        {:error, reason}\n   148→    end\n   149→  end\n   150→\n   151→  @doc \"\"\"\n   152→  Retrieves a lease by MAC address.\n   153→\n   154→  ## Parameters\n   155→\n   156→  - `mac_address` - Client MAC address\n   157→\n   158→  ## Returns\n   159→\n   160→  - `{:ok, lease}` - Lease found\n   161→  - `{:error, :not_found}` - No lease exists\n   162→  \"\"\"\n   163→  @spec get(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n   164→  def get(mac_address) do\n   165→    transaction = fn ->\n   166→      case :mnesia.read(@table_name, mac_address) do\n   167→        [record] -> record_to_map(record)\n   168→        [] -> nil\n   169→      end\n   170→    end\n   171→\n   172→    case :mnesia.transaction(transaction) do\n   173→      {:atomic, nil} ->\n   174→        {:error, :not_found}\n   175→\n   176→      {:atomic, lease} ->\n   177→        {:ok, lease}\n   178→\n   179→      {:aborted, reason} ->\n   180→        :telemetry.execute(\n   181→          [:yellow_dog, :dhcpv4, :lease_storage, :read_failed],\n   182→          %{count: 1},\n   183→          %{reason: inspect(reason)}\n   184→        )\n   185→\n   186→        {:error, reason}\n   187→    end\n   188→  end\n   189→\n   190→  @doc \"\"\"\n   191→  Retrieves a lease by IP address.\n   192→\n   193→  ## Parameters\n   194→\n   195→  - `ip_address` - IP address tuple\n   196→\n   197→  ## Returns\n   198→\n   199→  - `{:ok, lease}` - Lease found\n   200→  - `{:error, :not_found}` - No lease exists\n   201→  \"\"\"\n   202→  @spec get_by_ip(ip_address()) :: {:ok, lease()} | {:error, :not_found}\n   203→  def get_by_ip(ip_address) do\n   204→    transaction = fn ->\n   205→      :mnesia.match_object(@table_name, lease_record(ip_address: ip_address, _: :_), :read)\n   206→    end\n   207→\n   208→    case :mnesia.transaction(transaction) do\n   209→      {:atomic, [record]} ->\n   210→        {:ok, record_to_map(record)}\n   211→\n   212→      {:atomic, []} ->\n   213→        {:error, :not_found}\n   214→\n   215→      {:atomic, _multiple} ->\n   216→        # This shouldn't happen - IP should be unique\n   217→        :telemetry.execute(\n   218→          [:yellow_dog, :dhcpv4, :lease_storage, :multiple_found],\n   219→          %{count: 1},\n   220→          %{ip_address: ip_address}\n   221→        )\n   222→\n   223→        {:error, :multiple_found}\n   224→\n   225→      {:aborted, reason} ->\n   226→        :telemetry.execute(\n   227→          [:yellow_dog, :dhcpv4, :lease_storage, :read_by_ip_failed],\n   228→          %{count: 1},\n   229→          %{reason: inspect(reason)}\n   230→        )\n   231→\n   232→        {:error, reason}\n   233→    end\n   234→  end\n   235→\n   236→  @doc \"\"\"\n   237→  Deletes a lease by MAC address.\n   238→\n   239→  ## Parameters\n   240→\n   241→  - `mac_address` - Client MAC address\n   242→\n   243→  ## Returns\n   244→\n   245→  - `:ok` - Successfully deleted or didn't exist\n   246→  \"\"\"\n   247→  @spec delete(mac_address()) :: :ok\n   248→  def delete(mac_address) do\n   249→    transaction = fn ->\n   250→      :mnesia.delete(@table_name, mac_address, :write)\n   251→    end\n   252→\n   253→    case :mnesia.transaction(transaction) do\n   254→      {:atomic, :ok} ->\n   255→        :ok\n   256→\n   257→      {:aborted, reason} ->\n   258→        :telemetry.execute(\n   259→          [:yellow_dog, :dhcpv4, :lease_storage, :delete_failed],\n   260→          %{count: 1},\n   261→          %{reason: inspect(reason)}\n   262→        )\n   263→\n   264→        {:error, reason}\n   265→    end\n   266→  end\n   267→\n   268→  @doc \"\"\"\n   269→  Lists all leases with optional filtering.\n   270→\n   271→  ## Options\n   272→\n   273→  - `:state` - Filter by state (e.g., :active, :expired)\n   274→  - `:pool_name` - Filter by pool name\n   275→  - `:active_only` - Only return non-expired leases (default: false)\n   276→\n   277→  ## Returns\n   278→\n   279→  - List of leases\n   280→  \"\"\"\n   281→  @spec list(keyword()) :: [lease()]\n   282→  def list(opts \\\\ []) do\n   283→    state_filter = Keyword.get(opts, :state)\n   284→    pool_filter = Keyword.get(opts, :pool_name)\n   285→    active_only = Keyword.get(opts, :active_only, false)\n   286→    now = System.system_time(:second)\n   287→\n   288→    transaction = fn ->\n   289→      pattern =\n   290→        cond do\n   291→          state_filter && pool_filter ->\n   292→            lease_record(state: state_filter, pool_name: pool_filter, _: :_)\n   293→\n   294→          state_filter ->\n   295→            lease_record(state: state_filter, _: :_)\n   296→\n   297→          pool_filter ->\n   298→            lease_record(pool_name: pool_filter, _: :_)\n   299→\n   300→          true ->\n   301→            lease_record(_: :_)\n   302→        end\n   303→\n   304→      :mnesia.match_object(@table_name, pattern, :read)\n   305→      |> Enum.map(&record_to_map/1)\n   306→      |> then(fn leases ->\n   307→        if active_only do\n   308→          Enum.filter(leases, fn lease ->\n   309→            lease.state == :active && lease.expires_at > now\n   310→          end)\n   311→        else\n   312→          leases\n   313→        end\n   314→      end)\n   315→    end\n   316→\n   317→    case :mnesia.transaction(transaction) do\n   318→      {:atomic, leases} ->\n   319→        leases\n   320→\n   321→      {:aborted, reason} ->\n   322→        :telemetry.execute(\n   323→          [:yellow_dog, :dhcpv4, :lease_storage, :list_failed],\n   324→          %{count: 1},\n   325→          %{reason: inspect(reason)}\n   326→        )\n   327→\n   328→        []\n   329→    end\n   330→  end\n   331→\n   332→  @doc \"\"\"\n   333→  Gets all active (non-expired) leases.\n   334→\n   335→  ## Returns\n   336→\n   337→  - List of active leases\n   338→  \"\"\"\n   339→  @spec list_active() :: [lease()]\n   340→  def list_active do\n   341→    list(active_only: true)\n   342→  end\n   343→\n   344→  @doc \"\"\"\n   345→  Gets all allocated IP addresses for active leases.\n   346→\n   347→  ## Returns\n   348→\n   349→  - MapSet of IP addresses\n   350→  \"\"\"\n   351→  @spec get_allocated_ips() :: MapSet.t(ip_address())\n   352→  def get_allocated_ips do\n   353→    list_active()\n   354→    |> Enum.map(& &1.ip_address)\n   355→    |> MapSet.new()\n   356→  end\n   357→\n   358→  @doc \"\"\"\n   359→  Updates the state of a lease.\n   360→\n   361→  ## Parameters\n   362→\n   363→  - `mac_address` - Client MAC address\n   364→  - `new_state` - New lease state\n   365→\n   366→  ## Returns\n   367→\n   368→  - `{:ok, lease}` - Successfully updated\n   369→  - `{:error, reason}` - Failed to update\n   370→  \"\"\"\n   371→  @spec update_state(mac_address(), lease_state()) :: {:ok, lease()} | {:error, term()}\n   372→  def update_state(mac_address, new_state) do\n   373→    transaction = fn ->\n   374→      case :mnesia.read(@table_name, mac_address) do\n   375→        [record] ->\n   376→          now = System.system_time(:second)\n   377→\n   378→          updated_record =\n   379→            lease_record(record,\n   380→              state: new_state,\n   381→              updated_at: now\n   382→            )\n   383→\n   384→          :mnesia.write(@table_name, updated_record, :write)\n   385→          record_to_map(updated_record)\n   386→\n   387→        [] ->\n   388→          nil\n   389→      end\n   390→    end\n   391→\n   392→    case :mnesia.transaction(transaction) do\n   393→      {:atomic, nil} ->\n   394→        {:error, :not_found}\n   395→\n   396→      {:atomic, lease} ->\n   397→        {:ok, lease}\n   398→\n   399→      {:aborted, reason} ->\n   400→        :telemetry.execute(\n   401→          [:yellow_dog, :dhcpv4, :lease_storage, :update_state_failed],\n   402→          %{count: 1},\n   403→          %{reason: inspect(reason)}\n   404→        )\n   405→\n   406→        {:error, reason}\n   407→    end\n   408→  end\n   409→\n   410→  @doc \"\"\"\n   411→  Cleans up expired leases by updating their state to :expired.\n   412→\n   413→  ## Returns\n   414→\n   415→  - `{:ok, count}` - Number of leases expired\n   416→  \"\"\"\n   417→  @spec cleanup_expired() :: {:ok, non_neg_integer()}\n   418→  def cleanup_expired do\n   419→    now = System.system_time(:second)\n   420→\n   421→    transaction = fn ->\n   422→      # Find all active leases that have expired\n   423→      :mnesia.match_object(@table_name, lease_record(state: :active, _: :_), :read)\n   424→      |> Enum.filter(fn record ->\n   425→        lease_record(expires_at: expires_at) = record\n   426→        expires_at <= now\n   427→      end)\n   428→      |> Enum.each(fn record ->\n   429→        updated_record =\n   430→          lease_record(record,\n   431→            state: :expired,\n   432→            updated_at: now\n   433→          )\n   434→\n   435→        :mnesia.write(@table_name, updated_record, :write)\n   436→      end)\n   437→      |> length()\n   438→    end\n   439→\n   440→    case :mnesia.transaction(transaction) do\n   441→      {:atomic, count} ->\n   442→        if count > 0 do\n   443→          :telemetry.execute(\n   444→            [:yellow_dog, :dhcpv4, :lease_storage, :expired],\n   445→            %{count: count},\n   446→            %{}\n   447→          )\n   448→        end\n   449→\n   450→        {:ok, count}\n   451→\n   452→      {:aborted, reason} ->\n   453→        :telemetry.execute(\n   454→          [:yellow_dog, :dhcpv4, :lease_storage, :cleanup_failed],\n   455→          %{count: 1},\n   456→          %{reason: inspect(reason)}\n   457→        )\n   458→\n   459→        {:error, reason}\n   460→    end\n   461→  end\n   462→\n   463→  @doc \"\"\"\n   464→  Gets storage statistics.\n   465→\n   466→  ## Returns\n   467→\n   468→  - Map with statistics\n   469→  \"\"\"\n   470→  @spec stats() :: map()\n   471→  def stats do\n   472→    now = System.system_time(:second)\n   473→    all_leases = list()\n   474→\n   475→    active_leases =\n   476→      Enum.filter(all_leases, fn lease ->\n   477→        lease.state == :active && lease.expires_at > now\n   478→      end)\n   479→\n   480→    expired_leases = Enum.filter(all_leases, fn lease -> lease.expires_at <= now end)\n   481→\n   482→    state_counts =\n   483→      Enum.reduce(all_leases, %{}, fn lease, acc ->\n   484→        Map.update(acc, lease.state, 1, &(&1 + 1))\n   485→      end)\n   486→\n   487→    %{\n   488→      total_leases: length(all_leases),\n   489→      active_leases: length(active_leases),\n   490→      expired_leases: length(expired_leases),\n   491→      by_state: state_counts\n   492→    }\n   493→  end\n   494→\n   495→  @doc \"\"\"\n   496→  Clears all leases from storage.\n   497→\n   498→  WARNING: This is destructive and should only be used for testing or maintenance.\n   499→\n   500→  ## Returns\n   501→\n   502→  - `:ok` - Successfully cleared\n   503→  \"\"\"\n   504→  @spec clear_all() :: :ok\n   505→  def clear_all do\n   506→    transaction = fn ->\n   507→      :mnesia.clear_table(@table_name)\n   508→    end\n   509→\n   510→    case :mnesia.transaction(transaction) do\n   511→      {:atomic, :ok} ->\n   512→        :telemetry.execute(\n   513→          [:yellow_dog, :dhcpv4, :lease_storage, :cleared],\n   514→          %{count: 1},\n   515→          %{}\n   516→        )\n   517→\n   518→        :ok\n   519→\n   520→      {:aborted, reason} ->\n   521→        :telemetry.execute(\n   522→          [:yellow_dog, :dhcpv4, :lease_storage, :clear_failed],\n   523→          %{count: 1},\n   524→          %{reason: inspect(reason)}\n   525→        )\n   526→\n   527→        {:error, reason}\n   528→    end\n   529→  end\n   530→\n   531→  ## Private Functions\n   532→\n   533→  defp ensure_schema_created(nodes) do\n   534→    case :mnesia.create_schema(nodes) do\n   535→      :ok ->\n   536→        :ok\n   537→\n   538→      {:error, {_node, {:already_exists, _}}} ->\n   539→        :ok\n   540→\n   541→      {:error, reason} ->\n   542→        {:error, reason}\n   543→    end\n   544→  end\n   545→\n   546→  defp ensure_table_created(storage_type, nodes) do\n   547→    # Start Mnesia if not already started\n   548→    :mnesia.start()\n   549→\n   550→    table_opts =\n   551→      [\n   552→        attributes: [\n   553→          :mac_address,\n   554→          :ip_address,\n   555→          :pool_name,\n   556→          :state,\n   557→          :lease_time,\n   558→          :expires_at,\n   559→          :hostname,\n   560→          :client_id,\n   561→          :created_at,\n   562→          :updated_at\n   563→        ],\n   564→        record_name: :lease_record,\n   565→        type: :set,\n   566→        index: [:ip_address, :state, :pool_name]\n   567→      ] ++ [{storage_type, nodes}]\n   568→\n   569→    case :mnesia.create_table(@table_name, table_opts) do\n   570→      {:atomic, :ok} ->\n   571→        :ok\n   572→\n   573→      {:aborted, {:already_exists, @table_name}} ->\n   574→        # Table exists, ensure it has the right properties\n   575→        ensure_indices()\n   576→        :ok\n   577→\n   578→      {:aborted, reason} ->\n   579→        {:error, reason}\n   580→    end\n   581→  end\n   582→\n   583→  defp ensure_indices do\n   584→    # Ensure secondary indices exist\n   585→    existing_indices = :mnesia.table_info(@table_name, :index)\n   586→\n   587→    [:ip_address, :state, :pool_name]\n   588→    |> Enum.reject(&(&1 in existing_indices))\n   589→    |> Enum.each(fn attr ->\n   590→      case :mnesia.add_table_index(@table_name, attr) do\n   591→        {:atomic, :ok} ->\n   592→          :telemetry.execute(\n   593→            [:yellow_dog, :dhcpv4, :lease_storage, :index_added],\n   594→            %{count: 1},\n   595→            %{attribute: attr}\n   596→          )\n   597→\n   598→        {:aborted, {:already_exists, @table_name, _}} ->\n   599→          :ok\n   600→\n   601→        {:aborted, reason} ->\n   602→          :telemetry.execute(\n   603→            [:yellow_dog, :dhcpv4, :lease_storage, :index_failed],\n   604→            %{count: 1},\n   605→            %{attribute: attr, reason: inspect(reason)}\n   606→          )\n   607→      end\n   608→    end)\n   609→  end\n   610→\n   611→  defp record_to_map(record) do\n   612→    lease_record(\n   613→      mac_address: mac,\n   614→      ip_address: ip,\n   615→      pool_name: pool,\n   616→      state: state,\n   617→      lease_time: lease_time,\n   618→      expires_at: expires_at,\n   619→      hostname: hostname,\n   620→      client_id: client_id,\n   621→      created_at: created_at,\n   622→      updated_at: updated_at\n   623→    ) = record\n   624→\n   625→    %{\n   626→      mac_address: mac,\n   627→      ip_address: ip,\n   628→      pool_name: pool,\n   629→      state: state,\n   630→      lease_time: lease_time,\n   631→      expires_at: expires_at,\n   632→      hostname: hostname,\n   633→      client_id: client_id,\n   634→      created_at: created_at,\n   635→      updated_at: updated_at\n   636→    }\n   637→  end\n   638→end\n   639→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"08c84764-13d1-478c-b0ce-d4387a6f3426","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_storage.ex","content":"defmodule YellowDog.Dhcpv4.LeaseStorage do\n  @moduledoc \"\"\"\n  Persistent lease storage using Mnesia.\n\n  Provides a durable, transactional storage layer for DHCP leases with\n  support for multiple lease states and comprehensive querying.\n\n  ## Lease States\n\n  - `:offered` - IP address offered to client, awaiting REQUEST\n  - `:active` - Lease active and in use by client\n  - `:released` - Client released the lease voluntarily\n  - `:expired` - Lease exceeded its lifetime\n  - `:declined` - Client declined the offered IP (conflict detected)\n\n  ## Storage Modes\n\n  - `:disc_copies` - Persistent storage (default for production)\n  - `:ram_copies` - Memory-only storage (for testing)\n  \"\"\"\n\n  require Record\n\n  alias YellowDog.Dhcpv4.AddressPool\n\n  @type ip_address :: AddressPool.ip_address()\n  @type mac_address :: binary()\n  @type client_id :: binary() | nil\n  @type lease_state :: :offered | :active | :released | :expired | :declined\n\n  @type lease :: %{\n          mac_address: mac_address(),\n          ip_address: ip_address(),\n          pool_name: String.t(),\n          state: lease_state(),\n          lease_time: pos_integer(),\n          expires_at: integer(),\n          hostname: String.t() | nil,\n          client_id: client_id(),\n          created_at: integer(),\n          updated_at: integer()\n        }\n\n  # Define Mnesia record\n  Record.defrecord(:lease_record,\n    mac_address: nil,\n    ip_address: nil,\n    pool_name: nil,\n    state: :offered,\n    lease_time: 0,\n    expires_at: 0,\n    hostname: nil,\n    client_id: nil,\n    created_at: 0,\n    updated_at: 0\n  )\n\n  @table_name :dhcpv4_leases\n\n  ## Public API\n\n  @doc \"\"\"\n  Initializes the Mnesia schema and creates the leases table.\n\n  ## Options\n\n  - `:storage_type` - `:disc_copies` (default) or `:ram_copies`\n  - `:nodes` - List of nodes to create table on (default: [node()])\n\n  ## Returns\n\n  - `:ok` - Successfully initialized\n  - `{:error, reason}` - Failed to initialize\n  \"\"\"\n  @spec init(keyword()) :: :ok | {:error, term()}\n  def init(opts \\\\ []) do\n    storage_type = Keyword.get(opts, :storage_type, :disc_copies)\n    nodes = Keyword.get(opts, :nodes, [node()])\n\n    with :ok <- ensure_schema_created(nodes),\n         :ok <- ensure_table_created(storage_type, nodes) do\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :lease_storage, :initialized],\n        %{count: 1},\n        %{storage_type: storage_type, nodes: nodes}\n      )\n\n      :ok\n    else\n      {:error, reason} = error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :init_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Stores or updates a lease in the database.\n\n  ## Parameters\n\n  - `lease` - Lease map with required fields\n\n  ## Returns\n\n  - `{:ok, lease}` - Successfully stored\n  - `{:error, reason}` - Failed to store\n  \"\"\"\n  @spec put(lease()) :: {:ok, lease()} | {:error, term()}\n  def put(lease) do\n    now = System.system_time(:second)\n\n    record =\n      lease_record(\n        mac_address: lease.mac_address,\n        ip_address: lease.ip_address,\n        pool_name: lease.pool_name,\n        state: lease.state,\n        lease_time: lease.lease_time,\n        expires_at: lease.expires_at,\n        hostname: lease[:hostname],\n        client_id: lease[:client_id],\n        created_at: lease[:created_at] || now,\n        updated_at: now\n      )\n\n    transaction = fn ->\n      :mnesia.write(@table_name, record, :write)\n      record_to_map(record)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, result} ->\n        {:ok, result}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :store_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Retrieves a lease by MAC address.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n\n  ## Returns\n\n  - `{:ok, lease}` - Lease found\n  - `{:error, :not_found}` - No lease exists\n  \"\"\"\n  @spec get(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get(mac_address) do\n    transaction = fn ->\n      case :mnesia.read(@table_name, mac_address) do\n        [record] -> record_to_map(record)\n        [] -> nil\n      end\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, nil} ->\n        {:error, :not_found}\n\n      {:atomic, lease} ->\n        {:ok, lease}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :read_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Retrieves a lease by IP address.\n\n  ## Parameters\n\n  - `ip_address` - IP address tuple\n\n  ## Returns\n\n  - `{:ok, lease}` - Lease found\n  - `{:error, :not_found}` - No lease exists\n  \"\"\"\n  @spec get_by_ip(ip_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get_by_ip(ip_address) do\n    transaction = fn ->\n      :mnesia.match_object(@table_name, lease_record(ip_address: ip_address, _: :_), :read)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, [record]} ->\n        {:ok, record_to_map(record)}\n\n      {:atomic, []} ->\n        {:error, :not_found}\n\n      {:atomic, _multiple} ->\n        # This shouldn't happen - IP should be unique\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :multiple_found],\n          %{count: 1},\n          %{ip_address: ip_address}\n        )\n\n        {:error, :multiple_found}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :read_by_ip_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Deletes a lease by MAC address.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n\n  ## Returns\n\n  - `:ok` - Successfully deleted or didn't exist\n  \"\"\"\n  @spec delete(mac_address()) :: :ok\n  def delete(mac_address) do\n    transaction = fn ->\n      :mnesia.delete(@table_name, mac_address, :write)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, :ok} ->\n        :ok\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :delete_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Lists all leases with optional filtering.\n\n  ## Options\n\n  - `:state` - Filter by state (e.g., :active, :expired)\n  - `:pool_name` - Filter by pool name\n  - `:active_only` - Only return non-expired leases (default: false)\n\n  ## Returns\n\n  - List of leases\n  \"\"\"\n  @spec list(keyword()) :: [lease()]\n  def list(opts \\\\ []) do\n    state_filter = Keyword.get(opts, :state)\n    pool_filter = Keyword.get(opts, :pool_name)\n    active_only = Keyword.get(opts, :active_only, false)\n    now = System.system_time(:second)\n\n    transaction = fn ->\n      pattern =\n        cond do\n          state_filter && pool_filter ->\n            lease_record(state: state_filter, pool_name: pool_filter, _: :_)\n\n          state_filter ->\n            lease_record(state: state_filter, _: :_)\n\n          pool_filter ->\n            lease_record(pool_name: pool_filter, _: :_)\n\n          true ->\n            lease_record(_: :_)\n        end\n\n      :mnesia.match_object(@table_name, pattern, :read)\n      |> Enum.map(&record_to_map/1)\n      |> then(fn leases ->\n        if active_only do\n          Enum.filter(leases, fn lease ->\n            lease.state == :active && lease.expires_at > now\n          end)\n        else\n          leases\n        end\n      end)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, leases} ->\n        leases\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :list_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        []\n    end\n  end\n\n  @doc \"\"\"\n  Gets all active (non-expired) leases.\n\n  ## Returns\n\n  - List of active leases\n  \"\"\"\n  @spec list_active() :: [lease()]\n  def list_active do\n    list(active_only: true)\n  end\n\n  @doc \"\"\"\n  Gets all allocated IP addresses for active leases.\n\n  ## Returns\n\n  - MapSet of IP addresses\n  \"\"\"\n  @spec get_allocated_ips() :: MapSet.t(ip_address())\n  def get_allocated_ips do\n    list_active()\n    |> Enum.map(& &1.ip_address)\n    |> MapSet.new()\n  end\n\n  @doc \"\"\"\n  Updates the state of a lease.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n  - `new_state` - New lease state\n\n  ## Returns\n\n  - `{:ok, lease}` - Successfully updated\n  - `{:error, reason}` - Failed to update\n  \"\"\"\n  @spec update_state(mac_address(), lease_state()) :: {:ok, lease()} | {:error, term()}\n  def update_state(mac_address, new_state) do\n    transaction = fn ->\n      case :mnesia.read(@table_name, mac_address) do\n        [record] ->\n          now = System.system_time(:second)\n\n          updated_record =\n            lease_record(record,\n              state: new_state,\n              updated_at: now\n            )\n\n          :mnesia.write(@table_name, updated_record, :write)\n          record_to_map(updated_record)\n\n        [] ->\n          nil\n      end\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, nil} ->\n        {:error, :not_found}\n\n      {:atomic, lease} ->\n        {:ok, lease}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :update_state_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Cleans up expired leases by updating their state to :expired.\n\n  ## Returns\n\n  - `{:ok, count}` - Number of leases expired\n  \"\"\"\n  @spec cleanup_expired() :: {:ok, non_neg_integer()}\n  def cleanup_expired do\n    now = System.system_time(:second)\n\n    transaction = fn ->\n      # Find all active leases that have expired\n      :mnesia.match_object(@table_name, lease_record(state: :active, _: :_), :read)\n      |> Enum.filter(fn record ->\n        lease_record(expires_at: expires_at) = record\n        expires_at <= now\n      end)\n      |> Enum.each(fn record ->\n        updated_record =\n          lease_record(record,\n            state: :expired,\n            updated_at: now\n          )\n\n        :mnesia.write(@table_name, updated_record, :write)\n      end)\n      |> length()\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, count} ->\n        if count > 0 do\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :expired],\n            %{count: count},\n            %{}\n          )\n        end\n\n        {:ok, count}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :cleanup_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Gets storage statistics.\n\n  ## Returns\n\n  - Map with statistics\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    now = System.system_time(:second)\n    all_leases = list()\n\n    active_leases =\n      Enum.filter(all_leases, fn lease ->\n        lease.state == :active && lease.expires_at > now\n      end)\n\n    expired_leases = Enum.filter(all_leases, fn lease -> lease.expires_at <= now end)\n\n    state_counts =\n      Enum.reduce(all_leases, %{}, fn lease, acc ->\n        Map.update(acc, lease.state, 1, &(&1 + 1))\n      end)\n\n    %{\n      total_leases: length(all_leases),\n      active_leases: length(active_leases),\n      expired_leases: length(expired_leases),\n      by_state: state_counts\n    }\n  end\n\n  @doc \"\"\"\n  Clears all leases from storage.\n\n  WARNING: This is destructive and should only be used for testing or maintenance.\n\n  ## Returns\n\n  - `:ok` - Successfully cleared\n  \"\"\"\n  @spec clear_all() :: :ok\n  def clear_all do\n    transaction = fn ->\n      :mnesia.clear_table(@table_name)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, :ok} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :cleared],\n          %{count: 1},\n          %{}\n        )\n\n        :ok\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :clear_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  ## Private Functions\n\n  defp ensure_schema_created(nodes) do\n    case :mnesia.create_schema(nodes) do\n      :ok ->\n        :ok\n\n      {:error, {_node, {:already_exists, _}}} ->\n        :ok\n\n      {:error, reason} ->\n        {:error, reason}\n    end\n  end\n\n  defp ensure_table_created(storage_type, nodes) do\n    # Start Mnesia if not already started\n    :mnesia.start()\n\n    table_opts =\n      [\n        attributes: [\n          :mac_address,\n          :ip_address,\n          :pool_name,\n          :state,\n          :lease_time,\n          :expires_at,\n          :hostname,\n          :client_id,\n          :created_at,\n          :updated_at\n        ],\n        record_name: :lease_record,\n        type: :set,\n        index: [:ip_address, :state, :pool_name]\n      ] ++ [{storage_type, nodes}]\n\n    case :mnesia.create_table(@table_name, table_opts) do\n      {:atomic, :ok} ->\n        :ok\n\n      {:aborted, {:already_exists, @table_name}} ->\n        # Table exists, ensure it has the right properties\n        ensure_indices()\n        :ok\n\n      {:aborted, reason} ->\n        {:error, reason}\n    end\n  end\n\n  defp ensure_indices do\n    # Ensure secondary indices exist\n    existing_indices = :mnesia.table_info(@table_name, :index)\n\n    [:ip_address, :state, :pool_name]\n    |> Enum.reject(&(&1 in existing_indices))\n    |> Enum.each(fn attr ->\n      case :mnesia.add_table_index(@table_name, attr) do\n        {:atomic, :ok} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :index_added],\n            %{count: 1},\n            %{attribute: attr}\n          )\n\n        {:aborted, {:already_exists, @table_name, _}} ->\n          :ok\n\n        {:aborted, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :index_failed],\n            %{count: 1},\n            %{attribute: attr, reason: inspect(reason)}\n          )\n      end\n    end)\n  end\n\n  defp record_to_map(record) do\n    lease_record(\n      mac_address: mac,\n      ip_address: ip,\n      pool_name: pool,\n      state: state,\n      lease_time: lease_time,\n      expires_at: expires_at,\n      hostname: hostname,\n      client_id: client_id,\n      created_at: created_at,\n      updated_at: updated_at\n    ) = record\n\n    %{\n      mac_address: mac,\n      ip_address: ip,\n      pool_name: pool,\n      state: state,\n      lease_time: lease_time,\n      expires_at: expires_at,\n      hostname: hostname,\n      client_id: client_id,\n      created_at: created_at,\n      updated_at: updated_at\n    }\n  end\nend\n","numLines":639,"startLine":1,"totalLines":639}}}
