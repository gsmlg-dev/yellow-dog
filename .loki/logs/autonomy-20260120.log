{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CmDEzrNexybp1P9HvFqCBe","type":"tool_result","content":"     1→defmodule YellowDog.Console.SettingsLiveTest do\n     2→  use YellowDog.Console.ConnCase, async: false\n     3→\n     4→  import Phoenix.LiveViewTest\n     5→\n     6→  alias YellowDog.Console.ConfigManager\n     7→  alias YellowDog.Console.Settings.ConfigurationVersion\n     8→\n     9→  setup do\n    10→    # Create temporary config file for testing\n    11→    config_dir = System.tmp_dir!()\n    12→    config_path = Path.join(config_dir, \"test_config_#{:rand.uniform(100_000)}.toml\")\n    13→\n    14→    # Write default test configuration\n    15→    default_config = \"\"\"\n    16→    [core]\n    17→    dns = true\n    18→    mdns = true\n    19→    dhcpv4 = false\n    20→    dhcpv6 = false\n    21→\n    22→    [dns]\n    23→    listen = \"0.0.0.0\"\n    24→    port = 5353\n    25→\n    26→    [mdns]\n    27→    listen = \"0.0.0.0\"\n    28→    port = 5353\n    29→    mode = \"responder\"\n    30→\n    31→    [dhcpv4]\n    32→    listen = \"0.0.0.0\"\n    33→    port = 6767\n    34→\n    35→    [dhcpv6]\n    36→    listen = \"::\"\n    37→    port = 5667\n    38→    \"\"\"\n    39→\n    40→    File.write!(config_path, default_config)\n    41→\n    42→    # Configure test environment\n    43→    Application.put_env(:yellow_dog_console, :config_path, config_path)\n    44→\n    45→    # Start ConfigurationVersion Agent if not already started\n    46→    case Process.whereis(ConfigurationVersion) do\n    47→      nil -> start_supervised!(ConfigurationVersion)\n    48→      _pid -> :ok\n    49→    end\n    50→\n    51→    on_exit(fn ->\n    52→      # Clean up config file and backups\n    53→      File.rm_rf(config_dir)\n    54→    end)\n    55→\n    56→    %{config_path: config_path}\n    57→  end\n    58→\n    59→  describe \"SettingsLive mount\" do\n    60→    test \"successfully mounts with valid configuration\", %{conn: conn} do\n    61→      {:ok, view, html} = live(conn, ~p\"/settings\")\n    62→\n    63→      assert html =~ \"Service Settings\"\n    64→      assert html =~ \"Configure YellowDog network services\"\n    65→      assert has_element?(view, \"a[href='/settings/dns']\")\n    66→      assert has_element?(view, \"a[href='/settings/mdns']\")\n    67→      assert has_element?(view, \"a[href='/settings/dhcpv4']\")\n    68→      assert has_element?(view, \"a[href='/settings/dhcpv6']\")\n    69→    end\n    70→\n    71→    test \"displays current configuration version\", %{conn: conn, config_path: config_path} do\n    72→      version_info = ConfigurationVersion.get_version(config_path)\n    73→      {:ok, _view, html} = live(conn, ~p\"/settings\")\n    74→\n    75→      assert html =~ \"Config Version: #{version_info.version}\"\n    76→    end\n    77→\n    78→    test \"loads DNS service configuration correctly\", %{conn: conn} do\n    79→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n    80→\n    81→      # Check DNS tab is active by default\n    82→      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n    83→\n    84→      # Verify DNS form fields are populated\n    85→      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n    86→      assert has_element?(view, \"input[name='service_configuration[port]'][value='5353']\")\n    87→      assert has_element?(view, \"input[name='service_configuration[enabled]'][checked]\")\n    88→    end\n    89→\n    90→    test \"handles missing configuration file gracefully\", %{conn: conn} do\n    91→      # Set non-existent config path\n    92→      Application.put_env(:yellow_dog_console, :config_path, \"/nonexistent/config.toml\")\n    93→\n    94→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n    95→\n    96→      # Page should load without crashing, showing empty state\n    97→      rendered = render(view)\n    98→      assert rendered =~ \"Service Settings\"\n    99→      assert rendered =~ \"Config Version: 0\"\n   100→      # Should show form with default/empty values\n   101→      assert has_element?(view, \"form\")\n   102→    end\n   103→  end\n   104→\n   105→  describe \"SettingsLive tab navigation\" do\n   106→    test \"switches between tabs via navigation\", %{conn: conn} do\n   107→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   108→\n   109→      # Initially on DNS tab\n   110→      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n   111→\n   112→      # Navigate to mDNS tab\n   113→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   114→\n   115→      assert has_element?(view, \"a.tab.tab-active[href='/settings/mdns']\")\n   116→      refute has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n   117→\n   118→      # Navigate to DHCPv4 tab\n   119→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   120→\n   121→      assert has_element?(view, \"a.tab.tab-active[href='/settings/dhcpv4']\")\n   122→\n   123→      # Navigate back to DNS\n   124→      {:ok, view, _html} = live(conn, ~p\"/settings/dns\")\n   125→\n   126→      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n   127→    end\n   128→\n   129→    @tag :skip\n   130→    test \"preserves form state when switching tabs\", %{conn: conn} do\n   131→      # NOTE: This test is skipped because with URL-based navigation,\n   132→      # each tab creates a new LiveView instance and form state is not preserved.\n   133→      # Form state preservation would require saving to the server before switching tabs.\n   134→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   135→\n   136→      # Modify DNS configuration\n   137→      view\n   138→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454})\n   139→      |> render_change()\n   140→\n   141→      # Navigate to mDNS tab\n   142→      {:ok, _mdns_view, _html} = live(conn, ~p\"/settings/mdns\")\n   143→\n   144→      # Navigate back to DNS tab\n   145→      {:ok, view, _html} = live(conn, ~p\"/settings/dns\")\n   146→\n   147→      # Verify DNS form still has modified values\n   148→      assert has_element?(view, \"input[name='service_configuration[listen]'][value='127.0.0.1']\")\n   149→      assert has_element?(view, \"input[name='service_configuration[port]'][value='5454']\")\n   150→    end\n   151→  end\n   152→\n   153→  describe \"SettingsLive DNS configuration validation\" do\n   154→    test \"validates listen address format\", %{conn: conn} do\n   155→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   156→\n   157→      # Enter invalid IP address\n   158→      html =\n   159→        view\n   160→        |> form(\"form\", service_configuration: %{listen: \"999.999.999.999\", port: 53})\n   161→        |> render_change()\n   162→\n   163→      assert html =~ \"must be a valid IP address\"\n   164→      assert has_element?(view, \"input.input-error[name='service_configuration[listen]']\")\n   165→    end\n   166→\n   167→    test \"validates port range\", %{conn: conn} do\n   168→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   169→\n   170→      # Enter port below range\n   171→      html =\n   172→        view\n   173→        |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 0})\n   174→        |> render_change()\n   175→\n   176→      assert html =~ \"must be greater than 0\"\n   177→\n   178→      # Enter port above range\n   179→      html =\n   180→        view\n   181→        |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 99_999})\n   182→        |> render_change()\n   183→\n   184→      assert html =~ \"must be less than or equal to 65535\"\n   185→    end\n   186→\n   187→    test \"disables save button when validation fails\", %{conn: conn} do\n   188→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   189→\n   190→      # Enter invalid data\n   191→      view\n   192→      |> form(\"form\", service_configuration: %{listen: \"invalid\", port: 53})\n   193→      |> render_change()\n   194→\n   195→      # Save button should be disabled\n   196→      assert has_element?(view, \"button[type='submit'].btn-disabled\")\n   197→    end\n   198→\n   199→    test \"enables save button when all fields are valid\", %{conn: conn} do\n   200→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   201→\n   202→      # Enter valid data\n   203→      view\n   204→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n   205→      |> render_change()\n   206→\n   207→      # Save button should be enabled\n   208→      refute has_element?(view, \"button[type='submit'].btn-disabled\")\n   209→    end\n   210→  end\n   211→\n   212→  describe \"SettingsLive DNS configuration save\" do\n   213→    test \"successfully saves valid DNS configuration\", %{conn: conn, config_path: config_path} do\n   214→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   215→\n   216→      # Modify and save DNS configuration\n   217→      html =\n   218→        view\n   219→        |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n   220→        |> render_submit()\n   221→\n   222→      # Verify flash message\n   223→      assert html =~ \"Configuration saved successfully\"\n   224→\n   225→      # Verify configuration was persisted to file\n   226→      {:ok, config} = ConfigManager.load_config(config_path)\n   227→      assert config[\"dns\"][\"listen\"] == \"127.0.0.1\"\n   228→      assert config[\"dns\"][\"port\"] == 5454\n   229→      assert config[\"core\"][\"dns\"] == true\n   230→    end\n   231→\n   232→    test \"creates backup before saving\", %{conn: conn, config_path: config_path} do\n   233→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   234→\n   235→      # Save configuration\n   236→      view\n   237→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n   238→      |> render_submit()\n   239→\n   240→      # Verify backup was created\n   241→      backup_dir = Path.dirname(config_path)\n   242→      base_name = Path.basename(config_path)\n   243→\n   244→      {:ok, files} = File.ls(backup_dir)\n   245→      backup_files = Enum.filter(files, &String.starts_with?(&1, \"#{base_name}.backup.\"))\n   246→\n   247→      assert length(backup_files) > 0\n   248→    end\n   249→\n   250→    test \"increments version after successful save\", %{conn: conn, config_path: config_path} do\n   251→      initial_version = ConfigurationVersion.get_version(config_path).version\n   252→\n   253→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   254→\n   255→      # Save configuration\n   256→      view\n   257→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n   258→      |> render_submit()\n   259→\n   260→      # Verify version was incremented\n   261→      new_version = ConfigurationVersion.get_version(config_path).version\n   262→      assert new_version == initial_version + 1\n   263→    end\n   264→\n   265→    test \"prevents save when validation errors exist\", %{conn: conn} do\n   266→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   267→\n   268→      # Attempt to save invalid configuration\n   269→      html =\n   270→        view\n   271→        |> form(\"form\", service_configuration: %{listen: \"invalid\", port: 99_999, enabled: true})\n   272→        |> render_submit()\n   273→\n   274→      # Verify error message\n   275→      assert html =~ \"Please fix validation errors before saving\"\n   276→    end\n   277→  end\n   278→\n   279→  describe \"SettingsLive apply changes\" do\n   280→    test \"shows apply button when pending changes exist\", %{conn: conn} do\n   281→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   282→\n   283→      # Save configuration (creates pending changes)\n   284→      view\n   285→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n   286→      |> render_submit()\n   287→\n   288→      # Verify apply button appears with pending badge\n   289→      assert has_element?(view, \"button[phx-click='apply_changes_dns']\")\n   290→      assert has_element?(view, \".badge\", \"Pending Changes\")\n   291→    end\n   292→\n   293→    test \"hides apply button when no pending changes\", %{conn: conn} do\n   294→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   295→\n   296→      # No changes made\n   297→      refute has_element?(view, \"button[phx-click='apply_changes_dns']\")\n   298→      assert has_element?(view, \".badge\", \"Saved\")\n   299→    end\n   300→\n   301→    test \"applies changes and restarts service\", %{conn: conn} do\n   302→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   303→\n   304→      # Save configuration\n   305→      view\n   306→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n   307→      |> render_submit()\n   308→\n   309→      # Click apply changes\n   310→      view\n   311→      |> element(\"button[phx-click='apply_changes_dns']\")\n   312→      |> render_click()\n   313→\n   314→      # Note: ServiceManager.apply_and_restart will fail in test environment\n   315→      # because services aren't actually running. We're testing the UI flow.\n   316→      # In real implementation, this would trigger service restart.\n   317→\n   318→      # Verify UI shows some feedback (either success or failure)\n   319→      rendered = render(view)\n   320→      # The message will be either success or failure depending on service state\n   321→      assert rendered =~ \"DNS\" or rendered =~ \"restart\" or rendered =~ \"service\" or\n   322→               rendered =~ \"Configuration\"\n   323→    end\n   324→  end\n   325→\n   326→  describe \"SettingsLive optimistic locking conflict\" do\n   327→    test \"detects concurrent modification and shows conflict modal\", %{\n   328→      conn: conn,\n   329→      config_path: config_path\n   330→    } do\n   331→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   332→\n   333→      # Simulate external modification (another user/process)\n   334→      {:ok, _config} = ConfigManager.load_config(config_path)\n   335→\n   336→      # Use the correct update format for ConfigManager\n   337→      updates = %{\"dns.port\" => 9999}\n   338→      ConfigManager.save_config(config_path, updates)\n   339→      ConfigurationVersion.increment_version()\n   340→\n   341→      # Attempt to save from LiveView (should detect conflict)\n   342→      view\n   343→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n   344→      |> render_submit()\n   345→\n   346→      # Verify conflict modal is shown\n   347→      html = render(view)\n   348→      assert html =~ \"Configuration Conflict Detected\"\n   349→      assert html =~ \"modified by another user\"\n   350→    end\n   351→\n   352→    test \"reload button in conflict modal refreshes configuration\", %{conn: conn} do\n   353→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   354→\n   355→      # Trigger conflict (simplified - in real test would need concurrent modification)\n   356→      # For now, just test the reload functionality\n   357→\n   358→      html =\n   359→        view\n   360→        |> element(\"button[phx-click='reload_config']\")\n   361→        |> render_click()\n   362→\n   363→      assert html =~ \"Configuration reloaded from disk\"\n   364→    end\n   365→  end\n   366→\n   367→  describe \"SettingsLive configuration reload\" do\n   368→    test \"reloads configuration from disk\", %{conn: conn, config_path: config_path} do\n   369→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   370→\n   371→      # Externally modify configuration file\n   372→      ConfigManager.save_config(config_path, %{\"dns.port\" => 7777})\n   373→\n   374→      # Reload configuration in LiveView\n   375→      html =\n   376→        view\n   377→        |> element(\"button[phx-click='reload_config']\")\n   378→        |> render_click()\n   379→\n   380→      # Verify new configuration is loaded\n   381→      assert has_element?(view, \"input[name='service_configuration[port]'][value='7777']\")\n   382→      assert html =~ \"Configuration reloaded from disk\"\n   383→    end\n   384→\n   385→    test \"clears pending changes on reload\", %{conn: conn} do\n   386→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   387→\n   388→      # Make changes\n   389→      view\n   390→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n   391→      |> render_submit()\n   392→\n   393→      # Verify pending changes badge\n   394→      assert has_element?(view, \".badge\", \"Pending Changes\")\n   395→\n   396→      # Reload configuration\n   397→      view\n   398→      |> element(\"button[phx-click='reload_config']\")\n   399→      |> render_click()\n   400→\n   401→      # Verify pending changes cleared\n   402→      assert has_element?(view, \".badge\", \"Saved\")\n   403→      refute has_element?(view, \"button[phx-click='apply_changes_dns']\")\n   404→    end\n   405→  end\n   406→\n   407→  describe \"SettingsLive configuration persistence\" do\n   408→    test \"persists enabled/disabled toggle\", %{conn: conn, config_path: config_path} do\n   409→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   410→\n   411→      # Disable DNS service\n   412→      view\n   413→      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: false})\n   414→      |> render_submit()\n   415→\n   416→      # Verify persisted to file\n   417→      {:ok, config} = ConfigManager.load_config(config_path)\n   418→      assert config[\"core\"][\"dns\"] == false\n   419→    end\n   420→\n   421→    test \"preserves TOML section comments\", %{conn: conn, config_path: config_path} do\n   422→      # Add comments to config file\n   423→      config_with_comments = \"\"\"\n   424→      # Core service configuration\n   425→      [core]\n   426→      dns = true\n   427→      mdns = true\n   428→      dhcpv4 = false\n   429→      dhcpv6 = false\n   430→\n   431→      # DNS configuration\n   432→      [dns]\n   433→      listen = \"0.0.0.0\"\n   434→      port = 5353\n   435→\n   436→      # mDNS configuration\n   437→      [mdns]\n   438→      listen = \"0.0.0.0\"\n   439→      port = 5353\n   440→      mode = \"responder\"\n   441→\n   442→      [dhcpv4]\n   443→      listen = \"0.0.0.0\"\n   444→      port = 6767\n   445→\n   446→      [dhcpv6]\n   447→      listen = \"::\"\n   448→      port = 5667\n   449→      \"\"\"\n   450→\n   451→      File.write!(config_path, config_with_comments)\n   452→\n   453→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   454→\n   455→      # Modify DNS port\n   456→      view\n   457→      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5454, enabled: true})\n   458→      |> render_submit()\n   459→\n   460→      # Verify section comments are preserved (inline comments are not preserved)\n   461→      content = File.read!(config_path)\n   462→      assert content =~ \"# Core service configuration\"\n   463→      assert content =~ \"# DNS configuration\"\n   464→      assert content =~ \"port = 5454\"\n   465→    end\n   466→\n   467→    test \"handles multiple sequential saves correctly\", %{conn: conn, config_path: config_path} do\n   468→      {:ok, view, _html} = live(conn, ~p\"/settings\")\n   469→\n   470→      # First save\n   471→      view\n   472→      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n   473→      |> render_submit()\n   474→\n   475→      # Second save\n   476→      view\n   477→      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5454, enabled: false})\n   478→      |> render_submit()\n   479→\n   480→      # Third save\n   481→      view\n   482→      |> form(\"form\", service_configuration: %{listen: \"192.168.1.1\", port: 5555, enabled: true})\n   483→      |> render_submit()\n   484→\n   485→      # Verify final state\n   486→      {:ok, config} = ConfigManager.load_config(config_path)\n   487→      assert config[\"dns\"][\"listen\"] == \"192.168.1.1\"\n   488→      assert config[\"dns\"][\"port\"] == 5555\n   489→      assert config[\"core\"][\"dns\"] == true\n   490→    end\n   491→  end\n   492→\n   493→  describe \"SettingsLive mDNS configuration\" do\n   494→    test \"loads mDNS configuration correctly\", %{conn: conn} do\n   495→      # Navigate directly to mDNS tab\n   496→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   497→\n   498→      # Verify mDNS form fields are populated from config\n   499→      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n   500→      assert has_element?(view, \"input[name='service_configuration[port]'][value='5353']\")\n   501→      assert has_element?(view, \"input[name='service_configuration[enabled]'][checked]\")\n   502→      assert has_element?(view, \"select[name='service_configuration[mode]']\")\n   503→    end\n   504→\n   505→    test \"validates mDNS mode field is required\", %{conn: conn} do\n   506→      # Navigate directly to mDNS tab\n   507→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   508→\n   509→      # Try to save without mode (by clearing it)\n   510→      html =\n   511→        view\n   512→        |> form(\"form\",\n   513→          service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: true, mode: \"\"}\n   514→        )\n   515→        |> render_submit()\n   516→\n   517→      assert html =~ \"can&#39;t be blank\" or html =~ \"is invalid\"\n   518→    end\n   519→\n   520→    test \"successfully saves valid mDNS configuration\", %{conn: conn, config_path: config_path} do\n   521→      # Navigate directly to mDNS tab\n   522→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   523→\n   524→      # Modify and save mDNS configuration\n   525→      html =\n   526→        view\n   527→        |> form(\"form\",\n   528→          service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n   529→        )\n   530→        |> render_submit()\n   531→\n   532→      # Verify flash message\n   533→      assert html =~ \"Configuration saved successfully\"\n   534→\n   535→      # Verify configuration was persisted to file\n   536→      {:ok, config} = ConfigManager.load_config(config_path)\n   537→      assert config[\"mdns\"][\"listen\"] == \"127.0.0.1\"\n   538→      assert config[\"mdns\"][\"port\"] == 5454\n   539→      assert config[\"mdns\"][\"mode\"] == \"hybrid\"\n   540→      assert config[\"core\"][\"mdns\"] == true\n   541→    end\n   542→\n   543→    test \"toggles mDNS service enabled status\", %{conn: conn, config_path: config_path} do\n   544→      # Navigate directly to mDNS tab\n   545→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   546→\n   547→      # Disable mDNS service\n   548→      view\n   549→      |> form(\"form\",\n   550→        service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: false, mode: \"responder\"}\n   551→      )\n   552→      |> render_submit()\n   553→\n   554→      # Verify persisted to file\n   555→      {:ok, config} = ConfigManager.load_config(config_path)\n   556→      assert config[\"core\"][\"mdns\"] == false\n   557→    end\n   558→\n   559→    test \"validates mode must be responder or hybrid\", %{conn: conn} do\n   560→      # Navigate directly to mDNS tab\n   561→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   562→\n   563→      # The select dropdown should only show valid options\n   564→      # This test verifies the component structure\n   565→      assert has_element?(\n   566→               view,\n   567→               \"select[name='service_configuration[mode]'] option[value='responder']\"\n   568→             )\n   569→\n   570→      assert has_element?(\n   571→               view,\n   572→               \"select[name='service_configuration[mode]'] option[value='hybrid']\"\n   573→             )\n   574→    end\n   575→\n   576→    @tag :skip\n   577→    test \"preserves mDNS changes when switching tabs\", %{conn: conn} do\n   578→      # NOTE: This test is skipped because with URL-based navigation,\n   579→      # each tab creates a new LiveView instance and form state is not preserved.\n   580→      # Form state preservation would require saving to the server before switching tabs.\n   581→\n   582→      # Navigate directly to mDNS tab\n   583→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   584→\n   585→      # Modify mDNS configuration\n   586→      view\n   587→      |> form(\"form\",\n   588→        service_configuration: %{listen: \"192.168.1.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n   589→      )\n   590→      |> render_change()\n   591→\n   592→      # Navigate to DNS tab\n   593→      {:ok, _dns_view, _html} = live(conn, ~p\"/settings/dns\")\n   594→\n   595→      # Navigate back to mDNS tab\n   596→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   597→\n   598→      # Verify mDNS form still has modified values\n   599→      assert has_element?(\n   600→               view,\n   601→               \"input[name='service_configuration[listen]'][value='192.168.1.1']\"\n   602→             )\n   603→\n   604→      assert has_element?(view, \"input[name='service_configuration[port]'][value='5454']\")\n   605→\n   606→      assert has_element?(\n   607→               view,\n   608→               \"select[name='service_configuration[mode]'] option[value='hybrid'][selected]\"\n   609→             )\n   610→    end\n   611→\n   612→    test \"shows apply button when mDNS has pending changes\", %{conn: conn} do\n   613→      # Navigate directly to mDNS tab\n   614→      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n   615→\n   616→      # Save configuration (creates pending changes)\n   617→      view\n   618→      |> form(\"form\",\n   619→        service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n   620→      )\n   621→      |> render_submit()\n   622→\n   623→      # Verify apply button appears\n   624→      assert has_element?(view, \"button[phx-click='apply_changes_mdns']\")\n   625→      assert has_element?(view, \".badge\", \"Pending Changes\")\n   626→    end\n   627→  end\n   628→\n   629→  describe \"SettingsLive DHCPv4 pool management\" do\n   630→    setup %{config_path: config_path} do\n   631→      # Add a test pool to the DHCPv4 configuration\n   632→      config_with_pool = \"\"\"\n   633→      [core]\n   634→      dns = true\n   635→      mdns = true\n   636→      dhcpv4 = true\n   637→      dhcpv6 = false\n   638→\n   639→      [dns]\n   640→      listen = \"0.0.0.0\"\n   641→      port = 5353\n   642→\n   643→      [mdns]\n   644→      listen = \"0.0.0.0\"\n   645→      port = 5353\n   646→      mode = \"responder\"\n   647→\n   648→      [dhcpv4]\n   649→      listen = \"0.0.0.0\"\n   650→      port = 6767\n   651→\n   652→      [[dhcpv4.pools]]\n   653→      name = \"test-pool\"\n   654→      range_start = \"192.168.1.100\"\n   655→      range_end = \"192.168.1.200\"\n   656→      lease_time = 3600\n   657→      gateway = \"192.168.1.1\"\n   658→      dns_servers = [\"8.8.8.8\", \"8.8.4.4\"]\n   659→\n   660→      [dhcpv6]\n   661→      listen = \"::\"\n   662→      port = 5667\n   663→      \"\"\"\n   664→\n   665→      File.write!(config_path, config_with_pool)\n   666→      :ok\n   667→    end\n   668→\n   669→    test \"loads DHCPv4 configuration with pools\", %{conn: conn} do\n   670→      # Navigate directly to DHCPv4 tab\n   671→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   672→\n   673→      # Verify service form fields\n   674→      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n   675→      assert has_element?(view, \"input[name='service_configuration[port]'][value='6767']\")\n   676→\n   677→      # Verify pool table displays the test pool\n   678→      assert has_element?(view, \"td\", \"test-pool\")\n   679→      assert has_element?(view, \"td\", \"192.168.1.100 - 192.168.1.200\")\n   680→      assert has_element?(view, \"td\", \"1h\")\n   681→      assert has_element?(view, \"td\", \"192.168.1.1\")\n   682→      assert has_element?(view, \"td\", \"8.8.8.8, 8.8.4.4\")\n   683→    end\n   684→\n   685→    test \"opens add pool modal when clicking Add Pool button\", %{conn: conn} do\n   686→      # Navigate directly to DHCPv4 tab\n   687→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   688→\n   689→      # Click Add Pool button\n   690→      html =\n   691→        view\n   692→        |> element(\"button[phx-click='add_dhcpv4_pool']\")\n   693→        |> render_click()\n   694→\n   695→      # Verify modal is displayed with create mode\n   696→      assert html =~ \"Add DHCPv4 Pool\"\n   697→      assert has_element?(view, \"input[name='address_pool[name]']\")\n   698→      assert has_element?(view, \"input[name='address_pool[range_start]']\")\n   699→      assert has_element?(view, \"input[name='address_pool[range_end]']\")\n   700→      assert has_element?(view, \"input[name='address_pool[lease_time]']\")\n   701→      assert has_element?(view, \"input[name='address_pool[gateway]']\")\n   702→    end\n   703→\n   704→    test \"validates pool form fields\", %{conn: conn} do\n   705→      # Navigate directly to DHCPv4 tab\n   706→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   707→\n   708→      view\n   709→      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n   710→      |> render_click()\n   711→\n   712→      # Try to submit empty form\n   713→      html =\n   714→        view\n   715→        |> element(\"#pool-form\")\n   716→        |> render_submit(%{address_pool: %{protocol: \"ipv4\"}})\n   717→\n   718→      # Verify validation errors are displayed\n   719→      assert html =~ \"can&#39;t be blank\" or html =~ \"is required\"\n   720→    end\n   721→\n   722→    test \"successfully adds a new pool\", %{conn: conn, config_path: config_path} do\n   723→      # Navigate directly to DHCPv4 tab\n   724→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   725→\n   726→      view\n   727→      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n   728→      |> render_click()\n   729→\n   730→      # Fill out and submit the pool form\n   731→      view\n   732→      |> element(\"#pool-form\")\n   733→      |> render_submit(%{\n   734→        address_pool: %{\n   735→          protocol: \"ipv4\",\n   736→          name: \"new-pool\",\n   737→          range_start: \"192.168.2.100\",\n   738→          range_end: \"192.168.2.200\",\n   739→          lease_time: \"7200\",\n   740→          gateway: \"192.168.2.1\",\n   741→          dns_servers_str: \"1.1.1.1, 1.0.0.1\"\n   742→        }\n   743→      })\n   744→\n   745→      # Verify success message\n   746→      assert render(view) =~ \"Pool added successfully\"\n   747→\n   748→      # Verify new pool appears in the table\n   749→      assert has_element?(view, \"td\", \"new-pool\")\n   750→      assert has_element?(view, \"td\", \"192.168.2.100 - 192.168.2.200\")\n   751→      assert has_element?(view, \"td\", \"2h\")\n   752→\n   753→      # Save configuration to persist pools\n   754→      view\n   755→      |> form(\"form[phx-submit='save_dhcpv4']\",\n   756→        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n   757→      )\n   758→      |> render_submit()\n   759→\n   760→      # Verify both pools are in config file\n   761→      {:ok, config} = ConfigManager.load_config(config_path)\n   762→      pools = config[\"dhcpv4\"][\"pools\"]\n   763→      assert length(pools) == 2\n   764→      assert Enum.any?(pools, fn p -> p[\"name\"] == \"test-pool\" end)\n   765→      assert Enum.any?(pools, fn p -> p[\"name\"] == \"new-pool\" end)\n   766→    end\n   767→\n   768→    test \"opens edit pool modal with existing pool data\", %{conn: conn} do\n   769→      # Navigate directly to DHCPv4 tab\n   770→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   771→\n   772→      # Get the pool ID from the rendered page\n   773→      # The edit button should have phx-value-pool-id attribute\n   774→      html = render(view)\n   775→      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n   776→\n   777→      # Click edit button for the test pool\n   778→      html =\n   779→        view\n   780→        |> element(\"button[phx-click='edit_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n   781→        |> render_click()\n   782→\n   783→      # Verify modal shows edit mode with existing pool data\n   784→      assert html =~ \"Edit DHCPv4 Pool\"\n   785→      assert has_element?(view, \"input[name='address_pool[name]'][value='test-pool']\")\n   786→\n   787→      assert has_element?(\n   788→               view,\n   789→               \"input[name='address_pool[range_start]'][value='192.168.1.100']\"\n   790→             )\n   791→\n   792→      assert has_element?(view, \"input[name='address_pool[range_end]'][value='192.168.1.200']\")\n   793→      assert has_element?(view, \"input[name='address_pool[lease_time]'][value='3600']\")\n   794→      assert has_element?(view, \"input[name='address_pool[gateway]'][value='192.168.1.1']\")\n   795→    end\n   796→\n   797→    test \"successfully edits an existing pool\", %{conn: conn, config_path: config_path} do\n   798→      # Navigate directly to DHCPv4 tab\n   799→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   800→\n   801→      # Get the pool ID\n   802→      html = render(view)\n   803→      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n   804→\n   805→      # Open edit modal\n   806→      view\n   807→      |> element(\"button[phx-click='edit_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n   808→      |> render_click()\n   809→\n   810→      # Edit the pool\n   811→      view\n   812→      |> element(\"#pool-form\")\n   813→      |> render_submit(%{\n   814→        address_pool: %{\n   815→          id: pool_id,\n   816→          protocol: \"ipv4\",\n   817→          name: \"updated-pool\",\n   818→          range_start: \"192.168.1.100\",\n   819→          range_end: \"192.168.1.250\",\n   820→          lease_time: \"7200\",\n   821→          gateway: \"192.168.1.254\",\n   822→          dns_servers_str: \"8.8.8.8\"\n   823→        }\n   824→      })\n   825→\n   826→      # Verify success message\n   827→      assert render(view) =~ \"Pool updated successfully\"\n   828→\n   829→      # Verify updated pool appears in the table\n   830→      assert has_element?(view, \"td\", \"updated-pool\")\n   831→      assert has_element?(view, \"td\", \"192.168.1.100 - 192.168.1.250\")\n   832→      assert has_element?(view, \"td\", \"192.168.1.254\")\n   833→\n   834→      # Save configuration\n   835→      view\n   836→      |> form(\"form[phx-submit='save_dhcpv4']\",\n   837→        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n   838→      )\n   839→      |> render_submit()\n   840→\n   841→      # Verify pool was updated in config file\n   842→      {:ok, config} = ConfigManager.load_config(config_path)\n   843→      pool = List.first(config[\"dhcpv4\"][\"pools\"])\n   844→      assert pool[\"name\"] == \"updated-pool\"\n   845→      assert pool[\"range_end\"] == \"192.168.1.250\"\n   846→      assert pool[\"gateway\"] == \"192.168.1.254\"\n   847→    end\n   848→\n   849→    test \"successfully deletes a pool\", %{conn: conn, config_path: config_path} do\n   850→      # Navigate directly to DHCPv4 tab\n   851→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   852→\n   853→      # Verify pool exists\n   854→      assert has_element?(view, \"td\", \"test-pool\")\n   855→\n   856→      # Get the pool ID\n   857→      html = render(view)\n   858→      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n   859→\n   860→      # Delete the pool\n   861→      view\n   862→      |> element(\"button[phx-click='delete_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n   863→      |> render_click()\n   864→\n   865→      # Verify success message\n   866→      assert render(view) =~ \"Pool deleted\"\n   867→\n   868→      # Verify pool is removed from table\n   869→      assert has_element?(view, \"p\", \"No address pools configured\")\n   870→\n   871→      # Save configuration\n   872→      view\n   873→      |> form(\"form[phx-submit='save_dhcpv4']\",\n   874→        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n   875→      )\n   876→      |> render_submit()\n   877→\n   878→      # Verify pool was removed from config file\n   879→      {:ok, config} = ConfigManager.load_config(config_path)\n   880→      pools = config[\"dhcpv4\"][\"pools\"] || []\n   881→      assert Enum.empty?(pools)\n   882→    end\n   883→\n   884→    test \"closes pool form modal when clicking cancel\", %{conn: conn} do\n   885→      # Navigate directly to DHCPv4 tab\n   886→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   887→\n   888→      view\n   889→      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n   890→      |> render_click()\n   891→\n   892→      # Verify modal is open\n   893→      assert render(view) =~ \"Add DHCPv4 Pool\"\n   894→\n   895→      # Click cancel button\n   896→      view\n   897→      |> element(\"#pool-form button[phx-click='close']\")\n   898→      |> render_click()\n   899→\n   900→      # Wait for parent to process the message and verify modal is closed\n   901→      html = render(view)\n   902→      refute html =~ \"Add DHCPv4 Pool\"\n   903→    end\n   904→\n   905→    test \"validates pool IP addresses must be valid IPv4\", %{conn: conn} do\n   906→      # Navigate directly to DHCPv4 tab\n   907→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n   908→\n   909→      view\n   910→      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n   911→      |> render_click()\n   912→\n   913→      # Submit with invalid IPv4 addresses\n   914→      html =\n   915→        view\n   916→        |> element(\"#pool-form\")\n   917→        |> render_submit(%{\n   918→          address_pool: %{\n   919→            protocol: \"ipv4\",\n   920→            name: \"bad-pool\",\n   921→            range_start: \"not-an-ip\",\n   922→            range_end: \"999.999.999.999\",\n   923→            lease_time: \"3600\"\n   924→          }\n   925→        })\n   926→\n   927→      # Verify validation errors\n   928→      assert html =~ \"must be a valid\"\n   929→    end\n   930→  end\n   931→\n   932→  describe \"SettingsLive DHCPv6 pool management\" do\n   933→    setup %{config_path: config_path} do\n   934→      # Add a test pool to the DHCPv6 configuration\n   935→      config_with_pool = \"\"\"\n   936→      [core]\n   937→      dns = true\n   938→      mdns = true\n   939→      dhcpv4 = false\n   940→      dhcpv6 = true\n   941→\n   942→      [dns]\n   943→      listen = \"0.0.0.0\"\n   944→      port = 5353\n   945→\n   946→      [mdns]\n   947→      listen = \"0.0.0.0\"\n   948→      port = 5353\n   949→      mode = \"responder\"\n   950→\n   951→      [dhcpv4]\n   952→      listen = \"0.0.0.0\"\n   953→      port = 6767\n   954→\n   955→      [dhcpv6]\n   956→      listen = \"::\"\n   957→      port = 5667\n   958→\n   959→      [[dhcpv6.pools]]\n   960→      name = \"test-ipv6-pool\"\n   961→      range_start = \"2001:db8::100\"\n   962→      range_end = \"2001:db8::200\"\n   963→      preferred_lifetime = 3600\n   964→      valid_lifetime = 7200\n   965→      dns_servers = [\"2001:4860:4860::8888\", \"2001:4860:4860::8844\"]\n   966→      \"\"\"\n   967→\n   968→      File.write!(config_path, config_with_pool)\n   969→      :ok\n   970→    end\n   971→\n   972→    test \"loads DHCPv6 configuration with pools\", %{conn: conn} do\n   973→      # Navigate directly to DHCPv6 tab\n   974→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n   975→\n   976→      # Verify service form fields\n   977→      assert has_element?(view, \"input[name='service_configuration[listen]'][value='::']\")\n   978→      assert has_element?(view, \"input[name='service_configuration[port]'][value='5667']\")\n   979→\n   980→      # Verify pool table displays the test pool\n   981→      assert has_element?(view, \"td\", \"test-ipv6-pool\")\n   982→      assert has_element?(view, \"td\", \"2001:db8::100 - 2001:db8::200\")\n   983→      assert has_element?(view, \"td\", \"1h\")\n   984→      assert has_element?(view, \"td\", \"2h\")\n   985→      assert has_element?(view, \"td\", \"2001:4860:4860::8888, 2001:4860:4860::8844\")\n   986→    end\n   987→\n   988→    test \"opens add pool modal for DHCPv6\", %{conn: conn} do\n   989→      # Navigate directly to DHCPv6 tab\n   990→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n   991→\n   992→      # Click Add Pool button\n   993→      html =\n   994→        view\n   995→        |> element(\"button[phx-click='add_dhcpv6_pool']\")\n   996→        |> render_click()\n   997→\n   998→      # Verify modal is displayed with create mode for DHCPv6\n   999→      assert html =~ \"Add DHCPv6 Pool\"\n  1000→      assert has_element?(view, \"input[name='address_pool[name]']\")\n  1001→      assert has_element?(view, \"input[name='address_pool[range_start]']\")\n  1002→      assert has_element?(view, \"input[name='address_pool[range_end]']\")\n  1003→      assert has_element?(view, \"input[name='address_pool[preferred_lifetime]']\")\n  1004→      assert has_element?(view, \"input[name='address_pool[valid_lifetime]']\")\n  1005→      # DHCPv6 should NOT have gateway field\n  1006→      refute has_element?(view, \"input[name='address_pool[gateway]']\")\n  1007→    end\n  1008→\n  1009→    test \"successfully adds a new IPv6 pool\", %{conn: conn, config_path: _config_path} do\n  1010→      # Navigate directly to DHCPv6 tab\n  1011→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n  1012→\n  1013→      view\n  1014→      |> element(\"button[phx-click='add_dhcpv6_pool']\")\n  1015→      |> render_click()\n  1016→\n  1017→      # Fill out and submit the pool form\n  1018→      view\n  1019→      |> element(\"#pool-form\")\n  1020→      |> render_submit(%{\n  1021→        address_pool: %{\n  1022→          protocol: \"ipv6\",\n  1023→          name: \"new-ipv6-pool\",\n  1024→          range_start: \"2001:db8:1::100\",\n  1025→          range_end: \"2001:db8:1::200\",\n  1026→          preferred_lifetime: \"3600\",\n  1027→          valid_lifetime: \"7200\",\n  1028→          dns_servers_str: \"2001:4860:4860::8888\"\n  1029→        }\n  1030→      })\n  1031→\n  1032→      # Verify success message\n  1033→      assert render(view) =~ \"Pool added successfully\"\n  1034→\n  1035→      # Verify new pool appears in the table\n  1036→      assert has_element?(view, \"td\", \"new-ipv6-pool\")\n  1037→      assert has_element?(view, \"td\", \"2001:db8:1::100 - 2001:db8:1::200\")\n  1038→    end\n  1039→\n  1040→    test \"validates IPv6 pool addresses must be valid\", %{conn: conn} do\n  1041→      # Navigate directly to DHCPv6 tab\n  1042→      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n  1043→\n  1044→      view\n  1045→      |> element(\"button[phx-click='add_dhcpv6_pool']\")\n  1046→      |> render_click()\n  1047→\n  1048→      # Submit with invalid IPv6 addresses\n  1049→      html =\n  1050→        view\n  1051→        |> element(\"#pool-form\")\n  1052→        |> render_submit(%{\n  1053→          address_pool: %{\n  1054→            protocol: \"ipv6\",\n  1055→            name: \"bad-pool\",\n  1056→            range_start: \"not-an-ipv6\",\n  1057→            range_end: \"gggg:hhhh::1\",\n  1058→            preferred_lifetime: \"3600\",\n  1059→            valid_lifetime: \"7200\"\n  1060→          }\n  1061→        })\n  1062→\n  1063→      # Verify validation errors\n  1064→      assert html =~ \"must be a valid\"\n  1065→    end\n  1066→  end\n  1067→end\n  1068→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"2cecf5e4-568c-4a02-a5eb-6b470cf8a7cc","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_console/test/yellow_dog/console/live/settings_live_test.exs","content":"defmodule YellowDog.Console.SettingsLiveTest do\n  use YellowDog.Console.ConnCase, async: false\n\n  import Phoenix.LiveViewTest\n\n  alias YellowDog.Console.ConfigManager\n  alias YellowDog.Console.Settings.ConfigurationVersion\n\n  setup do\n    # Create temporary config file for testing\n    config_dir = System.tmp_dir!()\n    config_path = Path.join(config_dir, \"test_config_#{:rand.uniform(100_000)}.toml\")\n\n    # Write default test configuration\n    default_config = \"\"\"\n    [core]\n    dns = true\n    mdns = true\n    dhcpv4 = false\n    dhcpv6 = false\n\n    [dns]\n    listen = \"0.0.0.0\"\n    port = 5353\n\n    [mdns]\n    listen = \"0.0.0.0\"\n    port = 5353\n    mode = \"responder\"\n\n    [dhcpv4]\n    listen = \"0.0.0.0\"\n    port = 6767\n\n    [dhcpv6]\n    listen = \"::\"\n    port = 5667\n    \"\"\"\n\n    File.write!(config_path, default_config)\n\n    # Configure test environment\n    Application.put_env(:yellow_dog_console, :config_path, config_path)\n\n    # Start ConfigurationVersion Agent if not already started\n    case Process.whereis(ConfigurationVersion) do\n      nil -> start_supervised!(ConfigurationVersion)\n      _pid -> :ok\n    end\n\n    on_exit(fn ->\n      # Clean up config file and backups\n      File.rm_rf(config_dir)\n    end)\n\n    %{config_path: config_path}\n  end\n\n  describe \"SettingsLive mount\" do\n    test \"successfully mounts with valid configuration\", %{conn: conn} do\n      {:ok, view, html} = live(conn, ~p\"/settings\")\n\n      assert html =~ \"Service Settings\"\n      assert html =~ \"Configure YellowDog network services\"\n      assert has_element?(view, \"a[href='/settings/dns']\")\n      assert has_element?(view, \"a[href='/settings/mdns']\")\n      assert has_element?(view, \"a[href='/settings/dhcpv4']\")\n      assert has_element?(view, \"a[href='/settings/dhcpv6']\")\n    end\n\n    test \"displays current configuration version\", %{conn: conn, config_path: config_path} do\n      version_info = ConfigurationVersion.get_version(config_path)\n      {:ok, _view, html} = live(conn, ~p\"/settings\")\n\n      assert html =~ \"Config Version: #{version_info.version}\"\n    end\n\n    test \"loads DNS service configuration correctly\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Check DNS tab is active by default\n      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n\n      # Verify DNS form fields are populated\n      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='5353']\")\n      assert has_element?(view, \"input[name='service_configuration[enabled]'][checked]\")\n    end\n\n    test \"handles missing configuration file gracefully\", %{conn: conn} do\n      # Set non-existent config path\n      Application.put_env(:yellow_dog_console, :config_path, \"/nonexistent/config.toml\")\n\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Page should load without crashing, showing empty state\n      rendered = render(view)\n      assert rendered =~ \"Service Settings\"\n      assert rendered =~ \"Config Version: 0\"\n      # Should show form with default/empty values\n      assert has_element?(view, \"form\")\n    end\n  end\n\n  describe \"SettingsLive tab navigation\" do\n    test \"switches between tabs via navigation\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Initially on DNS tab\n      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n\n      # Navigate to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      assert has_element?(view, \"a.tab.tab-active[href='/settings/mdns']\")\n      refute has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n\n      # Navigate to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      assert has_element?(view, \"a.tab.tab-active[href='/settings/dhcpv4']\")\n\n      # Navigate back to DNS\n      {:ok, view, _html} = live(conn, ~p\"/settings/dns\")\n\n      assert has_element?(view, \"a.tab.tab-active[href='/settings/dns']\")\n    end\n\n    @tag :skip\n    test \"preserves form state when switching tabs\", %{conn: conn} do\n      # NOTE: This test is skipped because with URL-based navigation,\n      # each tab creates a new LiveView instance and form state is not preserved.\n      # Form state preservation would require saving to the server before switching tabs.\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Modify DNS configuration\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454})\n      |> render_change()\n\n      # Navigate to mDNS tab\n      {:ok, _mdns_view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Navigate back to DNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dns\")\n\n      # Verify DNS form still has modified values\n      assert has_element?(view, \"input[name='service_configuration[listen]'][value='127.0.0.1']\")\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='5454']\")\n    end\n  end\n\n  describe \"SettingsLive DNS configuration validation\" do\n    test \"validates listen address format\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Enter invalid IP address\n      html =\n        view\n        |> form(\"form\", service_configuration: %{listen: \"999.999.999.999\", port: 53})\n        |> render_change()\n\n      assert html =~ \"must be a valid IP address\"\n      assert has_element?(view, \"input.input-error[name='service_configuration[listen]']\")\n    end\n\n    test \"validates port range\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Enter port below range\n      html =\n        view\n        |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 0})\n        |> render_change()\n\n      assert html =~ \"must be greater than 0\"\n\n      # Enter port above range\n      html =\n        view\n        |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 99_999})\n        |> render_change()\n\n      assert html =~ \"must be less than or equal to 65535\"\n    end\n\n    test \"disables save button when validation fails\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Enter invalid data\n      view\n      |> form(\"form\", service_configuration: %{listen: \"invalid\", port: 53})\n      |> render_change()\n\n      # Save button should be disabled\n      assert has_element?(view, \"button[type='submit'].btn-disabled\")\n    end\n\n    test \"enables save button when all fields are valid\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Enter valid data\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n      |> render_change()\n\n      # Save button should be enabled\n      refute has_element?(view, \"button[type='submit'].btn-disabled\")\n    end\n  end\n\n  describe \"SettingsLive DNS configuration save\" do\n    test \"successfully saves valid DNS configuration\", %{conn: conn, config_path: config_path} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Modify and save DNS configuration\n      html =\n        view\n        |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n        |> render_submit()\n\n      # Verify flash message\n      assert html =~ \"Configuration saved successfully\"\n\n      # Verify configuration was persisted to file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      assert config[\"dns\"][\"listen\"] == \"127.0.0.1\"\n      assert config[\"dns\"][\"port\"] == 5454\n      assert config[\"core\"][\"dns\"] == true\n    end\n\n    test \"creates backup before saving\", %{conn: conn, config_path: config_path} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Save configuration\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n      |> render_submit()\n\n      # Verify backup was created\n      backup_dir = Path.dirname(config_path)\n      base_name = Path.basename(config_path)\n\n      {:ok, files} = File.ls(backup_dir)\n      backup_files = Enum.filter(files, &String.starts_with?(&1, \"#{base_name}.backup.\"))\n\n      assert length(backup_files) > 0\n    end\n\n    test \"increments version after successful save\", %{conn: conn, config_path: config_path} do\n      initial_version = ConfigurationVersion.get_version(config_path).version\n\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Save configuration\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n      |> render_submit()\n\n      # Verify version was incremented\n      new_version = ConfigurationVersion.get_version(config_path).version\n      assert new_version == initial_version + 1\n    end\n\n    test \"prevents save when validation errors exist\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Attempt to save invalid configuration\n      html =\n        view\n        |> form(\"form\", service_configuration: %{listen: \"invalid\", port: 99_999, enabled: true})\n        |> render_submit()\n\n      # Verify error message\n      assert html =~ \"Please fix validation errors before saving\"\n    end\n  end\n\n  describe \"SettingsLive apply changes\" do\n    test \"shows apply button when pending changes exist\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Save configuration (creates pending changes)\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n      |> render_submit()\n\n      # Verify apply button appears with pending badge\n      assert has_element?(view, \"button[phx-click='apply_changes_dns']\")\n      assert has_element?(view, \".badge\", \"Pending Changes\")\n    end\n\n    test \"hides apply button when no pending changes\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # No changes made\n      refute has_element?(view, \"button[phx-click='apply_changes_dns']\")\n      assert has_element?(view, \".badge\", \"Saved\")\n    end\n\n    test \"applies changes and restarts service\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Save configuration\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n      |> render_submit()\n\n      # Click apply changes\n      view\n      |> element(\"button[phx-click='apply_changes_dns']\")\n      |> render_click()\n\n      # Note: ServiceManager.apply_and_restart will fail in test environment\n      # because services aren't actually running. We're testing the UI flow.\n      # In real implementation, this would trigger service restart.\n\n      # Verify UI shows some feedback (either success or failure)\n      rendered = render(view)\n      # The message will be either success or failure depending on service state\n      assert rendered =~ \"DNS\" or rendered =~ \"restart\" or rendered =~ \"service\" or\n               rendered =~ \"Configuration\"\n    end\n  end\n\n  describe \"SettingsLive optimistic locking conflict\" do\n    test \"detects concurrent modification and shows conflict modal\", %{\n      conn: conn,\n      config_path: config_path\n    } do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Simulate external modification (another user/process)\n      {:ok, _config} = ConfigManager.load_config(config_path)\n\n      # Use the correct update format for ConfigManager\n      updates = %{\"dns.port\" => 9999}\n      ConfigManager.save_config(config_path, updates)\n      ConfigurationVersion.increment_version()\n\n      # Attempt to save from LiveView (should detect conflict)\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n      |> render_submit()\n\n      # Verify conflict modal is shown\n      html = render(view)\n      assert html =~ \"Configuration Conflict Detected\"\n      assert html =~ \"modified by another user\"\n    end\n\n    test \"reload button in conflict modal refreshes configuration\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Trigger conflict (simplified - in real test would need concurrent modification)\n      # For now, just test the reload functionality\n\n      html =\n        view\n        |> element(\"button[phx-click='reload_config']\")\n        |> render_click()\n\n      assert html =~ \"Configuration reloaded from disk\"\n    end\n  end\n\n  describe \"SettingsLive configuration reload\" do\n    test \"reloads configuration from disk\", %{conn: conn, config_path: config_path} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Externally modify configuration file\n      ConfigManager.save_config(config_path, %{\"dns.port\" => 7777})\n\n      # Reload configuration in LiveView\n      html =\n        view\n        |> element(\"button[phx-click='reload_config']\")\n        |> render_click()\n\n      # Verify new configuration is loaded\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='7777']\")\n      assert html =~ \"Configuration reloaded from disk\"\n    end\n\n    test \"clears pending changes on reload\", %{conn: conn} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Make changes\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true})\n      |> render_submit()\n\n      # Verify pending changes badge\n      assert has_element?(view, \".badge\", \"Pending Changes\")\n\n      # Reload configuration\n      view\n      |> element(\"button[phx-click='reload_config']\")\n      |> render_click()\n\n      # Verify pending changes cleared\n      assert has_element?(view, \".badge\", \"Saved\")\n      refute has_element?(view, \"button[phx-click='apply_changes_dns']\")\n    end\n  end\n\n  describe \"SettingsLive configuration persistence\" do\n    test \"persists enabled/disabled toggle\", %{conn: conn, config_path: config_path} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Disable DNS service\n      view\n      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: false})\n      |> render_submit()\n\n      # Verify persisted to file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      assert config[\"core\"][\"dns\"] == false\n    end\n\n    test \"preserves TOML section comments\", %{conn: conn, config_path: config_path} do\n      # Add comments to config file\n      config_with_comments = \"\"\"\n      # Core service configuration\n      [core]\n      dns = true\n      mdns = true\n      dhcpv4 = false\n      dhcpv6 = false\n\n      # DNS configuration\n      [dns]\n      listen = \"0.0.0.0\"\n      port = 5353\n\n      # mDNS configuration\n      [mdns]\n      listen = \"0.0.0.0\"\n      port = 5353\n      mode = \"responder\"\n\n      [dhcpv4]\n      listen = \"0.0.0.0\"\n      port = 6767\n\n      [dhcpv6]\n      listen = \"::\"\n      port = 5667\n      \"\"\"\n\n      File.write!(config_path, config_with_comments)\n\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # Modify DNS port\n      view\n      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5454, enabled: true})\n      |> render_submit()\n\n      # Verify section comments are preserved (inline comments are not preserved)\n      content = File.read!(config_path)\n      assert content =~ \"# Core service configuration\"\n      assert content =~ \"# DNS configuration\"\n      assert content =~ \"port = 5454\"\n    end\n\n    test \"handles multiple sequential saves correctly\", %{conn: conn, config_path: config_path} do\n      {:ok, view, _html} = live(conn, ~p\"/settings\")\n\n      # First save\n      view\n      |> form(\"form\", service_configuration: %{listen: \"127.0.0.1\", port: 5353, enabled: true})\n      |> render_submit()\n\n      # Second save\n      view\n      |> form(\"form\", service_configuration: %{listen: \"0.0.0.0\", port: 5454, enabled: false})\n      |> render_submit()\n\n      # Third save\n      view\n      |> form(\"form\", service_configuration: %{listen: \"192.168.1.1\", port: 5555, enabled: true})\n      |> render_submit()\n\n      # Verify final state\n      {:ok, config} = ConfigManager.load_config(config_path)\n      assert config[\"dns\"][\"listen\"] == \"192.168.1.1\"\n      assert config[\"dns\"][\"port\"] == 5555\n      assert config[\"core\"][\"dns\"] == true\n    end\n  end\n\n  describe \"SettingsLive mDNS configuration\" do\n    test \"loads mDNS configuration correctly\", %{conn: conn} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Verify mDNS form fields are populated from config\n      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='5353']\")\n      assert has_element?(view, \"input[name='service_configuration[enabled]'][checked]\")\n      assert has_element?(view, \"select[name='service_configuration[mode]']\")\n    end\n\n    test \"validates mDNS mode field is required\", %{conn: conn} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Try to save without mode (by clearing it)\n      html =\n        view\n        |> form(\"form\",\n          service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: true, mode: \"\"}\n        )\n        |> render_submit()\n\n      assert html =~ \"can&#39;t be blank\" or html =~ \"is invalid\"\n    end\n\n    test \"successfully saves valid mDNS configuration\", %{conn: conn, config_path: config_path} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Modify and save mDNS configuration\n      html =\n        view\n        |> form(\"form\",\n          service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n        )\n        |> render_submit()\n\n      # Verify flash message\n      assert html =~ \"Configuration saved successfully\"\n\n      # Verify configuration was persisted to file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      assert config[\"mdns\"][\"listen\"] == \"127.0.0.1\"\n      assert config[\"mdns\"][\"port\"] == 5454\n      assert config[\"mdns\"][\"mode\"] == \"hybrid\"\n      assert config[\"core\"][\"mdns\"] == true\n    end\n\n    test \"toggles mDNS service enabled status\", %{conn: conn, config_path: config_path} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Disable mDNS service\n      view\n      |> form(\"form\",\n        service_configuration: %{listen: \"0.0.0.0\", port: 5353, enabled: false, mode: \"responder\"}\n      )\n      |> render_submit()\n\n      # Verify persisted to file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      assert config[\"core\"][\"mdns\"] == false\n    end\n\n    test \"validates mode must be responder or hybrid\", %{conn: conn} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # The select dropdown should only show valid options\n      # This test verifies the component structure\n      assert has_element?(\n               view,\n               \"select[name='service_configuration[mode]'] option[value='responder']\"\n             )\n\n      assert has_element?(\n               view,\n               \"select[name='service_configuration[mode]'] option[value='hybrid']\"\n             )\n    end\n\n    @tag :skip\n    test \"preserves mDNS changes when switching tabs\", %{conn: conn} do\n      # NOTE: This test is skipped because with URL-based navigation,\n      # each tab creates a new LiveView instance and form state is not preserved.\n      # Form state preservation would require saving to the server before switching tabs.\n\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Modify mDNS configuration\n      view\n      |> form(\"form\",\n        service_configuration: %{listen: \"192.168.1.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n      )\n      |> render_change()\n\n      # Navigate to DNS tab\n      {:ok, _dns_view, _html} = live(conn, ~p\"/settings/dns\")\n\n      # Navigate back to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Verify mDNS form still has modified values\n      assert has_element?(\n               view,\n               \"input[name='service_configuration[listen]'][value='192.168.1.1']\"\n             )\n\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='5454']\")\n\n      assert has_element?(\n               view,\n               \"select[name='service_configuration[mode]'] option[value='hybrid'][selected]\"\n             )\n    end\n\n    test \"shows apply button when mDNS has pending changes\", %{conn: conn} do\n      # Navigate directly to mDNS tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/mdns\")\n\n      # Save configuration (creates pending changes)\n      view\n      |> form(\"form\",\n        service_configuration: %{listen: \"127.0.0.1\", port: 5454, enabled: true, mode: \"hybrid\"}\n      )\n      |> render_submit()\n\n      # Verify apply button appears\n      assert has_element?(view, \"button[phx-click='apply_changes_mdns']\")\n      assert has_element?(view, \".badge\", \"Pending Changes\")\n    end\n  end\n\n  describe \"SettingsLive DHCPv4 pool management\" do\n    setup %{config_path: config_path} do\n      # Add a test pool to the DHCPv4 configuration\n      config_with_pool = \"\"\"\n      [core]\n      dns = true\n      mdns = true\n      dhcpv4 = true\n      dhcpv6 = false\n\n      [dns]\n      listen = \"0.0.0.0\"\n      port = 5353\n\n      [mdns]\n      listen = \"0.0.0.0\"\n      port = 5353\n      mode = \"responder\"\n\n      [dhcpv4]\n      listen = \"0.0.0.0\"\n      port = 6767\n\n      [[dhcpv4.pools]]\n      name = \"test-pool\"\n      range_start = \"192.168.1.100\"\n      range_end = \"192.168.1.200\"\n      lease_time = 3600\n      gateway = \"192.168.1.1\"\n      dns_servers = [\"8.8.8.8\", \"8.8.4.4\"]\n\n      [dhcpv6]\n      listen = \"::\"\n      port = 5667\n      \"\"\"\n\n      File.write!(config_path, config_with_pool)\n      :ok\n    end\n\n    test \"loads DHCPv4 configuration with pools\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      # Verify service form fields\n      assert has_element?(view, \"input[name='service_configuration[listen]'][value='0.0.0.0']\")\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='6767']\")\n\n      # Verify pool table displays the test pool\n      assert has_element?(view, \"td\", \"test-pool\")\n      assert has_element?(view, \"td\", \"192.168.1.100 - 192.168.1.200\")\n      assert has_element?(view, \"td\", \"1h\")\n      assert has_element?(view, \"td\", \"192.168.1.1\")\n      assert has_element?(view, \"td\", \"8.8.8.8, 8.8.4.4\")\n    end\n\n    test \"opens add pool modal when clicking Add Pool button\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      # Click Add Pool button\n      html =\n        view\n        |> element(\"button[phx-click='add_dhcpv4_pool']\")\n        |> render_click()\n\n      # Verify modal is displayed with create mode\n      assert html =~ \"Add DHCPv4 Pool\"\n      assert has_element?(view, \"input[name='address_pool[name]']\")\n      assert has_element?(view, \"input[name='address_pool[range_start]']\")\n      assert has_element?(view, \"input[name='address_pool[range_end]']\")\n      assert has_element?(view, \"input[name='address_pool[lease_time]']\")\n      assert has_element?(view, \"input[name='address_pool[gateway]']\")\n    end\n\n    test \"validates pool form fields\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n      |> render_click()\n\n      # Try to submit empty form\n      html =\n        view\n        |> element(\"#pool-form\")\n        |> render_submit(%{address_pool: %{protocol: \"ipv4\"}})\n\n      # Verify validation errors are displayed\n      assert html =~ \"can&#39;t be blank\" or html =~ \"is required\"\n    end\n\n    test \"successfully adds a new pool\", %{conn: conn, config_path: config_path} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n      |> render_click()\n\n      # Fill out and submit the pool form\n      view\n      |> element(\"#pool-form\")\n      |> render_submit(%{\n        address_pool: %{\n          protocol: \"ipv4\",\n          name: \"new-pool\",\n          range_start: \"192.168.2.100\",\n          range_end: \"192.168.2.200\",\n          lease_time: \"7200\",\n          gateway: \"192.168.2.1\",\n          dns_servers_str: \"1.1.1.1, 1.0.0.1\"\n        }\n      })\n\n      # Verify success message\n      assert render(view) =~ \"Pool added successfully\"\n\n      # Verify new pool appears in the table\n      assert has_element?(view, \"td\", \"new-pool\")\n      assert has_element?(view, \"td\", \"192.168.2.100 - 192.168.2.200\")\n      assert has_element?(view, \"td\", \"2h\")\n\n      # Save configuration to persist pools\n      view\n      |> form(\"form[phx-submit='save_dhcpv4']\",\n        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n      )\n      |> render_submit()\n\n      # Verify both pools are in config file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      pools = config[\"dhcpv4\"][\"pools\"]\n      assert length(pools) == 2\n      assert Enum.any?(pools, fn p -> p[\"name\"] == \"test-pool\" end)\n      assert Enum.any?(pools, fn p -> p[\"name\"] == \"new-pool\" end)\n    end\n\n    test \"opens edit pool modal with existing pool data\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      # Get the pool ID from the rendered page\n      # The edit button should have phx-value-pool-id attribute\n      html = render(view)\n      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n\n      # Click edit button for the test pool\n      html =\n        view\n        |> element(\"button[phx-click='edit_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n        |> render_click()\n\n      # Verify modal shows edit mode with existing pool data\n      assert html =~ \"Edit DHCPv4 Pool\"\n      assert has_element?(view, \"input[name='address_pool[name]'][value='test-pool']\")\n\n      assert has_element?(\n               view,\n               \"input[name='address_pool[range_start]'][value='192.168.1.100']\"\n             )\n\n      assert has_element?(view, \"input[name='address_pool[range_end]'][value='192.168.1.200']\")\n      assert has_element?(view, \"input[name='address_pool[lease_time]'][value='3600']\")\n      assert has_element?(view, \"input[name='address_pool[gateway]'][value='192.168.1.1']\")\n    end\n\n    test \"successfully edits an existing pool\", %{conn: conn, config_path: config_path} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      # Get the pool ID\n      html = render(view)\n      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n\n      # Open edit modal\n      view\n      |> element(\"button[phx-click='edit_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n      |> render_click()\n\n      # Edit the pool\n      view\n      |> element(\"#pool-form\")\n      |> render_submit(%{\n        address_pool: %{\n          id: pool_id,\n          protocol: \"ipv4\",\n          name: \"updated-pool\",\n          range_start: \"192.168.1.100\",\n          range_end: \"192.168.1.250\",\n          lease_time: \"7200\",\n          gateway: \"192.168.1.254\",\n          dns_servers_str: \"8.8.8.8\"\n        }\n      })\n\n      # Verify success message\n      assert render(view) =~ \"Pool updated successfully\"\n\n      # Verify updated pool appears in the table\n      assert has_element?(view, \"td\", \"updated-pool\")\n      assert has_element?(view, \"td\", \"192.168.1.100 - 192.168.1.250\")\n      assert has_element?(view, \"td\", \"192.168.1.254\")\n\n      # Save configuration\n      view\n      |> form(\"form[phx-submit='save_dhcpv4']\",\n        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n      )\n      |> render_submit()\n\n      # Verify pool was updated in config file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      pool = List.first(config[\"dhcpv4\"][\"pools\"])\n      assert pool[\"name\"] == \"updated-pool\"\n      assert pool[\"range_end\"] == \"192.168.1.250\"\n      assert pool[\"gateway\"] == \"192.168.1.254\"\n    end\n\n    test \"successfully deletes a pool\", %{conn: conn, config_path: config_path} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      # Verify pool exists\n      assert has_element?(view, \"td\", \"test-pool\")\n\n      # Get the pool ID\n      html = render(view)\n      [pool_id] = Regex.run(~r/phx-value-pool-id=\"([^\"]+)\"/, html, capture: :all_but_first)\n\n      # Delete the pool\n      view\n      |> element(\"button[phx-click='delete_dhcpv4_pool'][phx-value-pool-id='#{pool_id}']\")\n      |> render_click()\n\n      # Verify success message\n      assert render(view) =~ \"Pool deleted\"\n\n      # Verify pool is removed from table\n      assert has_element?(view, \"p\", \"No address pools configured\")\n\n      # Save configuration\n      view\n      |> form(\"form[phx-submit='save_dhcpv4']\",\n        service_configuration: %{listen: \"0.0.0.0\", port: 6767, enabled: true}\n      )\n      |> render_submit()\n\n      # Verify pool was removed from config file\n      {:ok, config} = ConfigManager.load_config(config_path)\n      pools = config[\"dhcpv4\"][\"pools\"] || []\n      assert Enum.empty?(pools)\n    end\n\n    test \"closes pool form modal when clicking cancel\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n      |> render_click()\n\n      # Verify modal is open\n      assert render(view) =~ \"Add DHCPv4 Pool\"\n\n      # Click cancel button\n      view\n      |> element(\"#pool-form button[phx-click='close']\")\n      |> render_click()\n\n      # Wait for parent to process the message and verify modal is closed\n      html = render(view)\n      refute html =~ \"Add DHCPv4 Pool\"\n    end\n\n    test \"validates pool IP addresses must be valid IPv4\", %{conn: conn} do\n      # Navigate directly to DHCPv4 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv4\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv4_pool']\")\n      |> render_click()\n\n      # Submit with invalid IPv4 addresses\n      html =\n        view\n        |> element(\"#pool-form\")\n        |> render_submit(%{\n          address_pool: %{\n            protocol: \"ipv4\",\n            name: \"bad-pool\",\n            range_start: \"not-an-ip\",\n            range_end: \"999.999.999.999\",\n            lease_time: \"3600\"\n          }\n        })\n\n      # Verify validation errors\n      assert html =~ \"must be a valid\"\n    end\n  end\n\n  describe \"SettingsLive DHCPv6 pool management\" do\n    setup %{config_path: config_path} do\n      # Add a test pool to the DHCPv6 configuration\n      config_with_pool = \"\"\"\n      [core]\n      dns = true\n      mdns = true\n      dhcpv4 = false\n      dhcpv6 = true\n\n      [dns]\n      listen = \"0.0.0.0\"\n      port = 5353\n\n      [mdns]\n      listen = \"0.0.0.0\"\n      port = 5353\n      mode = \"responder\"\n\n      [dhcpv4]\n      listen = \"0.0.0.0\"\n      port = 6767\n\n      [dhcpv6]\n      listen = \"::\"\n      port = 5667\n\n      [[dhcpv6.pools]]\n      name = \"test-ipv6-pool\"\n      range_start = \"2001:db8::100\"\n      range_end = \"2001:db8::200\"\n      preferred_lifetime = 3600\n      valid_lifetime = 7200\n      dns_servers = [\"2001:4860:4860::8888\", \"2001:4860:4860::8844\"]\n      \"\"\"\n\n      File.write!(config_path, config_with_pool)\n      :ok\n    end\n\n    test \"loads DHCPv6 configuration with pools\", %{conn: conn} do\n      # Navigate directly to DHCPv6 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n\n      # Verify service form fields\n      assert has_element?(view, \"input[name='service_configuration[listen]'][value='::']\")\n      assert has_element?(view, \"input[name='service_configuration[port]'][value='5667']\")\n\n      # Verify pool table displays the test pool\n      assert has_element?(view, \"td\", \"test-ipv6-pool\")\n      assert has_element?(view, \"td\", \"2001:db8::100 - 2001:db8::200\")\n      assert has_element?(view, \"td\", \"1h\")\n      assert has_element?(view, \"td\", \"2h\")\n      assert has_element?(view, \"td\", \"2001:4860:4860::8888, 2001:4860:4860::8844\")\n    end\n\n    test \"opens add pool modal for DHCPv6\", %{conn: conn} do\n      # Navigate directly to DHCPv6 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n\n      # Click Add Pool button\n      html =\n        view\n        |> element(\"button[phx-click='add_dhcpv6_pool']\")\n        |> render_click()\n\n      # Verify modal is displayed with create mode for DHCPv6\n      assert html =~ \"Add DHCPv6 Pool\"\n      assert has_element?(view, \"input[name='address_pool[name]']\")\n      assert has_element?(view, \"input[name='address_pool[range_start]']\")\n      assert has_element?(view, \"input[name='address_pool[range_end]']\")\n      assert has_element?(view, \"input[name='address_pool[preferred_lifetime]']\")\n      assert has_element?(view, \"input[name='address_pool[valid_lifetime]']\")\n      # DHCPv6 should NOT have gateway field\n      refute has_element?(view, \"input[name='address_pool[gateway]']\")\n    end\n\n    test \"successfully adds a new IPv6 pool\", %{conn: conn, config_path: _config_path} do\n      # Navigate directly to DHCPv6 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv6_pool']\")\n      |> render_click()\n\n      # Fill out and submit the pool form\n      view\n      |> element(\"#pool-form\")\n      |> render_submit(%{\n        address_pool: %{\n          protocol: \"ipv6\",\n          name: \"new-ipv6-pool\",\n          range_start: \"2001:db8:1::100\",\n          range_end: \"2001:db8:1::200\",\n          preferred_lifetime: \"3600\",\n          valid_lifetime: \"7200\",\n          dns_servers_str: \"2001:4860:4860::8888\"\n        }\n      })\n\n      # Verify success message\n      assert render(view) =~ \"Pool added successfully\"\n\n      # Verify new pool appears in the table\n      assert has_element?(view, \"td\", \"new-ipv6-pool\")\n      assert has_element?(view, \"td\", \"2001:db8:1::100 - 2001:db8:1::200\")\n    end\n\n    test \"validates IPv6 pool addresses must be valid\", %{conn: conn} do\n      # Navigate directly to DHCPv6 tab\n      {:ok, view, _html} = live(conn, ~p\"/settings/dhcpv6\")\n\n      view\n      |> element(\"button[phx-click='add_dhcpv6_pool']\")\n      |> render_click()\n\n      # Submit with invalid IPv6 addresses\n      html =\n        view\n        |> element(\"#pool-form\")\n        |> render_submit(%{\n          address_pool: %{\n            protocol: \"ipv6\",\n            name: \"bad-pool\",\n            range_start: \"not-an-ipv6\",\n            range_end: \"gggg:hhhh::1\",\n            preferred_lifetime: \"3600\",\n            valid_lifetime: \"7200\"\n          }\n        })\n\n      # Verify validation errors\n      assert html =~ \"must be a valid\"\n    end\n  end\nend\n","numLines":1068,"startLine":1,"totalLines":1068}}}
