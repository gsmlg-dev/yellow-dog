{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0183uXkuWSLcDBdgBAYntaYA","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.AddressPool do\n     2→  @moduledoc \"\"\"\n     3→  IP address pool management for DHCPv4.\n     4→\n     5→  Manages IP address ranges, allocation, and availability tracking.\n     6→  Supports multiple pools, static reservations, and address conflict detection.\n     7→  \"\"\"\n     8→\n     9→  @type ip_address :: {0..255, 0..255, 0..255, 0..255}\n    10→  @type mac_address :: binary()\n    11→  @type ip_range :: {ip_address(), ip_address()}\n    12→  @type pool_config :: %{\n    13→          name: String.t(),\n    14→          ranges: [ip_range()],\n    15→          # Legacy support - converted to ranges\n    16→          range_start: ip_address() | nil,\n    17→          range_end: ip_address() | nil,\n    18→          excluded_ranges: [ip_range()],\n    19→          subnet_mask: ip_address(),\n    20→          gateway: ip_address(),\n    21→          dns_servers: [ip_address()],\n    22→          domain_name: String.t() | nil,\n    23→          lease_time: pos_integer()\n    24→        }\n    25→\n    26→  @doc \"\"\"\n    27→  Creates a new address pool from configuration.\n    28→\n    29→  ## Parameters\n    30→  - `config` - Pool configuration map\n    31→\n    32→  ## Returns\n    33→  - `{:ok, pool}` - Successfully created pool\n    34→  - `{:error, reason}` - Failed to create pool\n    35→\n    36→  ## Example\n    37→      iex> config = %{\n    38→      ...>   name: \"main\",\n    39→      ...>   range_start: {192, 168, 1, 100},\n    40→      ...>   range_end: {192, 168, 1, 200},\n    41→      ...>   subnet_mask: {255, 255, 255, 0},\n    42→      ...>   gateway: {192, 168, 1, 1},\n    43→      ...>   dns_servers: [{192, 168, 1, 1}],\n    44→      ...>   domain_name: \"local\",\n    45→      ...>   lease_time: 86400\n    46→      ...> }\n    47→      iex> YellowDog.Dhcpv4.AddressPool.new(config)\n    48→      {:ok, %{...}}\n    49→  \"\"\"\n    50→  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n    51→  def new(config) do\n    52→    with {:ok, validated_config} <- validate_pool_config(config) do\n    53→      # Support both legacy (range_start/range_end) and new (ranges) format\n    54→      ranges = build_ranges(config, validated_config)\n    55→      excluded_ranges = build_excluded_ranges(config)\n    56→\n    57→      # Get first range for defaults\n    58→      {first_range_start, _} = hd(ranges)\n    59→\n    60→      pool = %{\n    61→        name: Map.get(config, :name, \"default\"),\n    62→        ranges: ranges,\n    63→        range_start: validated_config[:range_start],\n    64→        range_end: validated_config[:range_end],\n    65→        excluded_ranges: excluded_ranges,\n    66→        subnet_mask: Map.get(config, :subnet_mask, {255, 255, 255, 0}),\n    67→        gateway: Map.get(config, :gateway, first_range_start),\n    68→        dns_servers: Map.get(config, :dns_servers, [first_range_start]),\n    69→        domain_name: Map.get(config, :domain_name),\n    70→        lease_time: Map.get(config, :lease_time, 86400),\n    71→        static_reservations: Map.get(config, :static_reservations, %{})\n    72→      }\n    73→\n    74→      {:ok, pool}\n    75→    end\n    76→  end\n    77→\n    78→  @doc \"\"\"\n    79→  Validates pool configuration.\n    80→\n    81→  Supports both legacy format (range_start/range_end) and new format (ranges).\n    82→\n    83→  ## Parameters\n    84→  - `config` - Pool configuration to validate\n    85→\n    86→  ## Returns\n    87→  - `{:ok, config}` - Valid configuration\n    88→  - `{:error, reason}` - Invalid configuration\n    89→  \"\"\"\n    90→  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n    91→  def validate_pool_config(config) do\n    92→    cond do\n    93→      # New format with ranges\n    94→      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n    95→        validate_ranges_config(config)\n    96→\n    97→      # Legacy format with range_start/range_end\n    98→      Map.has_key?(config, :range_start) || Map.has_key?(config, \"range_start\") ->\n    99→        validate_legacy_config(config)\n   100→\n   101→      true ->\n   102→        {:error, \"Must specify either :ranges or :range_start/:range_end\"}\n   103→    end\n   104→  end\n   105→\n   106→  defp validate_legacy_config(config) do\n   107→    with {:ok, range_start} <- get_required_ip(config, :range_start),\n   108→         {:ok, range_end} <- get_required_ip(config, :range_end),\n   109→         :ok <- validate_range_order(range_start, range_end) do\n   110→      {:ok, %{range_start: range_start, range_end: range_end}}\n   111→    end\n   112→  end\n   113→\n   114→  defp validate_ranges_config(config) do\n   115→    ranges = config.ranges\n   116→\n   117→    # Validate each range\n   118→    validated_ranges =\n   119→      Enum.reduce_while(ranges, {:ok, []}, fn range_config, {:ok, acc} ->\n   120→        case validate_single_range(range_config) do\n   121→          {:ok, validated_range} ->\n   122→            {:cont, {:ok, [validated_range | acc]}}\n   123→\n   124→          {:error, reason} ->\n   125→            {:halt, {:error, reason}}\n   126→        end\n   127→      end)\n   128→\n   129→    case validated_ranges do\n   130→      {:ok, ranges_list} ->\n   131→        {:ok, %{ranges: Enum.reverse(ranges_list)}}\n   132→\n   133→      error ->\n   134→        error\n   135→    end\n   136→  end\n   137→\n   138→  defp validate_single_range({start_ip, end_ip}) when is_tuple(start_ip) and is_tuple(end_ip) do\n   139→    with :ok <- validate_range_order(start_ip, end_ip) do\n   140→      {:ok, {start_ip, end_ip}}\n   141→    end\n   142→  end\n   143→\n   144→  defp validate_single_range(%{start: start, end: end_ip}) do\n   145→    with {:ok, start_ip} <- normalize_ip(start),\n   146→         {:ok, end_ip_val} <- normalize_ip(end_ip),\n   147→         :ok <- validate_range_order(start_ip, end_ip_val) do\n   148→      {:ok, {start_ip, end_ip_val}}\n   149→    end\n   150→  end\n   151→\n   152→  defp validate_single_range(_), do: {:error, \"Invalid range format\"}\n   153→\n   154→  @doc \"\"\"\n   155→  Gets the next available IP address from the pool.\n   156→\n   157→  ## Parameters\n   158→  - `pool` - Pool configuration\n   159→  - `allocated_ips` - Set of already allocated IP addresses\n   160→  - `mac` - MAC address requesting the IP (for static reservation check)\n   161→\n   162→  ## Returns\n   163→  - `{:ok, ip}` - Available IP address\n   164→  - `{:error, :pool_exhausted}` - No available addresses\n   165→  \"\"\"\n   166→  @spec get_available_ip(pool_config(), MapSet.t(ip_address()), mac_address()) ::\n   167→          {:ok, ip_address()} | {:error, :pool_exhausted}\n   168→  def get_available_ip(pool, allocated_ips, mac) do\n   169→    # Check for static reservation first\n   170→    case get_static_reservation(pool, mac) do\n   171→      {:ok, ip} ->\n   172→        {:ok, ip}\n   173→\n   174→      :not_found ->\n   175→        # Find next available IP across all ranges, excluding excluded ranges\n   176→        find_next_available_in_ranges(pool.ranges, pool.excluded_ranges, allocated_ips)\n   177→    end\n   178→  end\n   179→\n   180→  @doc \"\"\"\n   181→  Checks if an IP address is within any of the pool ranges (and not in excluded ranges).\n   182→\n   183→  ## Parameters\n   184→  - `pool` - Pool configuration\n   185→  - `ip` - IP address to check\n   186→\n   187→  ## Returns\n   188→  - `true` if IP is in range and not excluded, `false` otherwise\n   189→  \"\"\"\n   190→  @spec in_range?(pool_config(), ip_address()) :: boolean()\n   191→  def in_range?(pool, ip) do\n   192→    ip_int = ip_to_integer(ip)\n   193→\n   194→    # Check if IP is in any of the allowed ranges\n   195→    in_allowed_range =\n   196→      Enum.any?(pool.ranges, fn {start_ip, end_ip} ->\n   197→        start_int = ip_to_integer(start_ip)\n   198→        end_int = ip_to_integer(end_ip)\n   199→        start_int <= ip_int and ip_int <= end_int\n   200→      end)\n   201→\n   202→    # If in allowed range, check if it's not in excluded ranges\n   203→    if in_allowed_range do\n   204→      not in_excluded_range?(pool.excluded_ranges, ip_int)\n   205→    else\n   206→      false\n   207→    end\n   208→  end\n   209→\n   210→  @doc \"\"\"\n   211→  Gets static reservation for a MAC address.\n   212→\n   213→  ## Parameters\n   214→  - `pool` - Pool configuration\n   215→  - `mac` - MAC address to look up\n   216→\n   217→  ## Returns\n   218→  - `{:ok, ip}` - Static IP for this MAC\n   219→  - `:not_found` - No static reservation\n   220→  \"\"\"\n   221→  @spec get_static_reservation(pool_config(), mac_address()) ::\n   222→          {:ok, ip_address()} | :not_found\n   223→  def get_static_reservation(pool, mac) do\n   224→    case Map.get(pool.static_reservations, format_mac(mac)) do\n   225→      nil -> :not_found\n   226→      ip -> {:ok, ip}\n   227→    end\n   228→  end\n   229→\n   230→  @doc \"\"\"\n   231→  Counts total addresses in the pool across all ranges, minus excluded ranges.\n   232→\n   233→  ## Parameters\n   234→  - `pool` - Pool configuration\n   235→\n   236→  ## Returns\n   237→  - Total number of usable addresses in the pool\n   238→  \"\"\"\n   239→  @spec pool_size(pool_config()) :: non_neg_integer()\n   240→  def pool_size(pool) do\n   241→    # Count total addresses in all ranges\n   242→    total_in_ranges =\n   243→      Enum.reduce(pool.ranges, 0, fn {start_ip, end_ip}, acc ->\n   244→        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n   245→        acc + size\n   246→      end)\n   247→\n   248→    # Count addresses in excluded ranges\n   249→    total_excluded =\n   250→      Enum.reduce(pool.excluded_ranges, 0, fn {start_ip, end_ip}, acc ->\n   251→        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n   252→        acc + size\n   253→      end)\n   254→\n   255→    max(total_in_ranges - total_excluded, 0)\n   256→  end\n   257→\n   258→  # Private helper functions\n   259→\n   260→  defp build_ranges(_config, validated_config) do\n   261→    cond do\n   262→      # New format with multiple ranges\n   263→      Map.has_key?(validated_config, :ranges) ->\n   264→        validated_config.ranges\n   265→\n   266→      # Legacy format with single range\n   267→      Map.has_key?(validated_config, :range_start) ->\n   268→        [{validated_config.range_start, validated_config.range_end}]\n   269→\n   270→      true ->\n   271→        # Should not happen due to validation\n   272→        []\n   273→    end\n   274→  end\n   275→\n   276→  defp build_excluded_ranges(config) do\n   277→    case Map.get(config, :excluded_ranges) do\n   278→      nil ->\n   279→        []\n   280→\n   281→      excluded when is_list(excluded) ->\n   282→        Enum.map(excluded, fn\n   283→          {start_ip, end_ip} when is_tuple(start_ip) and is_tuple(end_ip) ->\n   284→            {start_ip, end_ip}\n   285→\n   286→          %{start: start, end: end_ip} ->\n   287→            {:ok, start_ip} = normalize_ip(start)\n   288→            {:ok, end_ip_tuple} = normalize_ip(end_ip)\n   289→            {start_ip, end_ip_tuple}\n   290→\n   291→          _ ->\n   292→            nil\n   293→        end)\n   294→        |> Enum.reject(&is_nil/1)\n   295→\n   296→      _ ->\n   297→        []\n   298→    end\n   299→  end\n   300→\n   301→  defp find_next_available_in_ranges(ranges, excluded_ranges, allocated_ips) do\n   302→    # Try each range until we find an available IP\n   303→    Enum.reduce_while(ranges, {:error, :pool_exhausted}, fn {start_ip, end_ip}, _acc ->\n   304→      case find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n   305→        {:ok, ip} ->\n   306→          {:halt, {:ok, ip}}\n   307→\n   308→        {:error, :pool_exhausted} ->\n   309→          {:cont, {:error, :pool_exhausted}}\n   310→      end\n   311→    end)\n   312→  end\n   313→\n   314→  defp in_excluded_range?([], _ip_int), do: false\n   315→\n   316→  defp in_excluded_range?(excluded_ranges, ip_int) do\n   317→    Enum.any?(excluded_ranges, fn {start_ip, end_ip} ->\n   318→      start_int = ip_to_integer(start_ip)\n   319→      end_int = ip_to_integer(end_ip)\n   320→      start_int <= ip_int and ip_int <= end_int\n   321→    end)\n   322→  end\n   323→\n   324→  defp normalize_ip(ip) when is_tuple(ip) and tuple_size(ip) == 4, do: {:ok, ip}\n   325→  defp normalize_ip(ip) when is_binary(ip), do: parse_ip_string(ip)\n   326→  defp normalize_ip(_), do: {:error, \"Invalid IP format\"}\n   327→\n   328→  defp get_required_ip(config, key) do\n   329→    case Map.get(config, key) do\n   330→      nil ->\n   331→        {:error, \"Missing required field: #{key}\"}\n   332→\n   333→      ip when is_tuple(ip) and tuple_size(ip) == 4 ->\n   334→        {:ok, ip}\n   335→\n   336→      ip when is_binary(ip) ->\n   337→        parse_ip_string(ip)\n   338→\n   339→      _ ->\n   340→        {:error, \"Invalid IP address format for #{key}\"}\n   341→    end\n   342→  end\n   343→\n   344→  defp validate_range_order(start_ip, end_ip) do\n   345→    if ip_to_integer(start_ip) <= ip_to_integer(end_ip) do\n   346→      :ok\n   347→    else\n   348→      {:error, \"range_start must be less than or equal to range_end\"}\n   349→    end\n   350→  end\n   351→\n   352→  defp find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n   353→    start_int = ip_to_integer(start_ip)\n   354→    end_int = ip_to_integer(end_ip)\n   355→\n   356→    result =\n   357→      Enum.find(start_int..end_int, fn ip_int ->\n   358→        ip = integer_to_ip(ip_int)\n   359→\n   360→        not MapSet.member?(allocated_ips, ip) and\n   361→          not in_excluded_range?(excluded_ranges, ip_int)\n   362→      end)\n   363→\n   364→    case result do\n   365→      nil ->\n   366→        {:error, :pool_exhausted}\n   367→\n   368→      ip_int ->\n   369→        {:ok, integer_to_ip(ip_int)}\n   370→    end\n   371→  end\n   372→\n   373→  defp ip_to_integer({a, b, c, d}) do\n   374→    a * 256 * 256 * 256 + b * 256 * 256 + c * 256 + d\n   375→  end\n   376→\n   377→  defp integer_to_ip(int) do\n   378→    a = div(int, 256 * 256 * 256)\n   379→    b = div(rem(int, 256 * 256 * 256), 256 * 256)\n   380→    c = div(rem(int, 256 * 256), 256)\n   381→    d = rem(int, 256)\n   382→    {a, b, c, d}\n   383→  end\n   384→\n   385→  defp parse_ip_string(ip_string) do\n   386→    case String.split(ip_string, \".\") do\n   387→      [a, b, c, d] ->\n   388→        try do\n   389→          {:ok,\n   390→           {String.to_integer(a), String.to_integer(b), String.to_integer(c),\n   391→            String.to_integer(d)}}\n   392→        rescue\n   393→          _ -> {:error, \"Invalid IP address string: #{ip_string}\"}\n   394→        end\n   395→\n   396→      _ ->\n   397→        {:error, \"Invalid IP address string format: #{ip_string}\"}\n   398→    end\n   399→  end\n   400→\n   401→  defp format_mac(<<mac::binary-size(6)>>) do\n   402→    mac\n   403→    |> :binary.bin_to_list()\n   404→    |> Enum.map(&Integer.to_string(&1, 16))\n   405→    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n   406→    |> Enum.join(\":\")\n   407→    |> String.upcase()\n   408→  end\n   409→\n   410→  defp format_mac(_), do: \"UNKNOWN\"\n   411→end\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"e5fe7247-64ec-4dbe-adc6-2e605602ff68","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/address_pool.ex","content":"defmodule YellowDog.Dhcpv4.AddressPool do\n  @moduledoc \"\"\"\n  IP address pool management for DHCPv4.\n\n  Manages IP address ranges, allocation, and availability tracking.\n  Supports multiple pools, static reservations, and address conflict detection.\n  \"\"\"\n\n  @type ip_address :: {0..255, 0..255, 0..255, 0..255}\n  @type mac_address :: binary()\n  @type ip_range :: {ip_address(), ip_address()}\n  @type pool_config :: %{\n          name: String.t(),\n          ranges: [ip_range()],\n          # Legacy support - converted to ranges\n          range_start: ip_address() | nil,\n          range_end: ip_address() | nil,\n          excluded_ranges: [ip_range()],\n          subnet_mask: ip_address(),\n          gateway: ip_address(),\n          dns_servers: [ip_address()],\n          domain_name: String.t() | nil,\n          lease_time: pos_integer()\n        }\n\n  @doc \"\"\"\n  Creates a new address pool from configuration.\n\n  ## Parameters\n  - `config` - Pool configuration map\n\n  ## Returns\n  - `{:ok, pool}` - Successfully created pool\n  - `{:error, reason}` - Failed to create pool\n\n  ## Example\n      iex> config = %{\n      ...>   name: \"main\",\n      ...>   range_start: {192, 168, 1, 100},\n      ...>   range_end: {192, 168, 1, 200},\n      ...>   subnet_mask: {255, 255, 255, 0},\n      ...>   gateway: {192, 168, 1, 1},\n      ...>   dns_servers: [{192, 168, 1, 1}],\n      ...>   domain_name: \"local\",\n      ...>   lease_time: 86400\n      ...> }\n      iex> YellowDog.Dhcpv4.AddressPool.new(config)\n      {:ok, %{...}}\n  \"\"\"\n  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n  def new(config) do\n    with {:ok, validated_config} <- validate_pool_config(config) do\n      # Support both legacy (range_start/range_end) and new (ranges) format\n      ranges = build_ranges(config, validated_config)\n      excluded_ranges = build_excluded_ranges(config)\n\n      # Get first range for defaults\n      {first_range_start, _} = hd(ranges)\n\n      pool = %{\n        name: Map.get(config, :name, \"default\"),\n        ranges: ranges,\n        range_start: validated_config[:range_start],\n        range_end: validated_config[:range_end],\n        excluded_ranges: excluded_ranges,\n        subnet_mask: Map.get(config, :subnet_mask, {255, 255, 255, 0}),\n        gateway: Map.get(config, :gateway, first_range_start),\n        dns_servers: Map.get(config, :dns_servers, [first_range_start]),\n        domain_name: Map.get(config, :domain_name),\n        lease_time: Map.get(config, :lease_time, 86400),\n        static_reservations: Map.get(config, :static_reservations, %{})\n      }\n\n      {:ok, pool}\n    end\n  end\n\n  @doc \"\"\"\n  Validates pool configuration.\n\n  Supports both legacy format (range_start/range_end) and new format (ranges).\n\n  ## Parameters\n  - `config` - Pool configuration to validate\n\n  ## Returns\n  - `{:ok, config}` - Valid configuration\n  - `{:error, reason}` - Invalid configuration\n  \"\"\"\n  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n  def validate_pool_config(config) do\n    cond do\n      # New format with ranges\n      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n        validate_ranges_config(config)\n\n      # Legacy format with range_start/range_end\n      Map.has_key?(config, :range_start) || Map.has_key?(config, \"range_start\") ->\n        validate_legacy_config(config)\n\n      true ->\n        {:error, \"Must specify either :ranges or :range_start/:range_end\"}\n    end\n  end\n\n  defp validate_legacy_config(config) do\n    with {:ok, range_start} <- get_required_ip(config, :range_start),\n         {:ok, range_end} <- get_required_ip(config, :range_end),\n         :ok <- validate_range_order(range_start, range_end) do\n      {:ok, %{range_start: range_start, range_end: range_end}}\n    end\n  end\n\n  defp validate_ranges_config(config) do\n    ranges = config.ranges\n\n    # Validate each range\n    validated_ranges =\n      Enum.reduce_while(ranges, {:ok, []}, fn range_config, {:ok, acc} ->\n        case validate_single_range(range_config) do\n          {:ok, validated_range} ->\n            {:cont, {:ok, [validated_range | acc]}}\n\n          {:error, reason} ->\n            {:halt, {:error, reason}}\n        end\n      end)\n\n    case validated_ranges do\n      {:ok, ranges_list} ->\n        {:ok, %{ranges: Enum.reverse(ranges_list)}}\n\n      error ->\n        error\n    end\n  end\n\n  defp validate_single_range({start_ip, end_ip}) when is_tuple(start_ip) and is_tuple(end_ip) do\n    with :ok <- validate_range_order(start_ip, end_ip) do\n      {:ok, {start_ip, end_ip}}\n    end\n  end\n\n  defp validate_single_range(%{start: start, end: end_ip}) do\n    with {:ok, start_ip} <- normalize_ip(start),\n         {:ok, end_ip_val} <- normalize_ip(end_ip),\n         :ok <- validate_range_order(start_ip, end_ip_val) do\n      {:ok, {start_ip, end_ip_val}}\n    end\n  end\n\n  defp validate_single_range(_), do: {:error, \"Invalid range format\"}\n\n  @doc \"\"\"\n  Gets the next available IP address from the pool.\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `allocated_ips` - Set of already allocated IP addresses\n  - `mac` - MAC address requesting the IP (for static reservation check)\n\n  ## Returns\n  - `{:ok, ip}` - Available IP address\n  - `{:error, :pool_exhausted}` - No available addresses\n  \"\"\"\n  @spec get_available_ip(pool_config(), MapSet.t(ip_address()), mac_address()) ::\n          {:ok, ip_address()} | {:error, :pool_exhausted}\n  def get_available_ip(pool, allocated_ips, mac) do\n    # Check for static reservation first\n    case get_static_reservation(pool, mac) do\n      {:ok, ip} ->\n        {:ok, ip}\n\n      :not_found ->\n        # Find next available IP across all ranges, excluding excluded ranges\n        find_next_available_in_ranges(pool.ranges, pool.excluded_ranges, allocated_ips)\n    end\n  end\n\n  @doc \"\"\"\n  Checks if an IP address is within any of the pool ranges (and not in excluded ranges).\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `ip` - IP address to check\n\n  ## Returns\n  - `true` if IP is in range and not excluded, `false` otherwise\n  \"\"\"\n  @spec in_range?(pool_config(), ip_address()) :: boolean()\n  def in_range?(pool, ip) do\n    ip_int = ip_to_integer(ip)\n\n    # Check if IP is in any of the allowed ranges\n    in_allowed_range =\n      Enum.any?(pool.ranges, fn {start_ip, end_ip} ->\n        start_int = ip_to_integer(start_ip)\n        end_int = ip_to_integer(end_ip)\n        start_int <= ip_int and ip_int <= end_int\n      end)\n\n    # If in allowed range, check if it's not in excluded ranges\n    if in_allowed_range do\n      not in_excluded_range?(pool.excluded_ranges, ip_int)\n    else\n      false\n    end\n  end\n\n  @doc \"\"\"\n  Gets static reservation for a MAC address.\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `mac` - MAC address to look up\n\n  ## Returns\n  - `{:ok, ip}` - Static IP for this MAC\n  - `:not_found` - No static reservation\n  \"\"\"\n  @spec get_static_reservation(pool_config(), mac_address()) ::\n          {:ok, ip_address()} | :not_found\n  def get_static_reservation(pool, mac) do\n    case Map.get(pool.static_reservations, format_mac(mac)) do\n      nil -> :not_found\n      ip -> {:ok, ip}\n    end\n  end\n\n  @doc \"\"\"\n  Counts total addresses in the pool across all ranges, minus excluded ranges.\n\n  ## Parameters\n  - `pool` - Pool configuration\n\n  ## Returns\n  - Total number of usable addresses in the pool\n  \"\"\"\n  @spec pool_size(pool_config()) :: non_neg_integer()\n  def pool_size(pool) do\n    # Count total addresses in all ranges\n    total_in_ranges =\n      Enum.reduce(pool.ranges, 0, fn {start_ip, end_ip}, acc ->\n        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n        acc + size\n      end)\n\n    # Count addresses in excluded ranges\n    total_excluded =\n      Enum.reduce(pool.excluded_ranges, 0, fn {start_ip, end_ip}, acc ->\n        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n        acc + size\n      end)\n\n    max(total_in_ranges - total_excluded, 0)\n  end\n\n  # Private helper functions\n\n  defp build_ranges(_config, validated_config) do\n    cond do\n      # New format with multiple ranges\n      Map.has_key?(validated_config, :ranges) ->\n        validated_config.ranges\n\n      # Legacy format with single range\n      Map.has_key?(validated_config, :range_start) ->\n        [{validated_config.range_start, validated_config.range_end}]\n\n      true ->\n        # Should not happen due to validation\n        []\n    end\n  end\n\n  defp build_excluded_ranges(config) do\n    case Map.get(config, :excluded_ranges) do\n      nil ->\n        []\n\n      excluded when is_list(excluded) ->\n        Enum.map(excluded, fn\n          {start_ip, end_ip} when is_tuple(start_ip) and is_tuple(end_ip) ->\n            {start_ip, end_ip}\n\n          %{start: start, end: end_ip} ->\n            {:ok, start_ip} = normalize_ip(start)\n            {:ok, end_ip_tuple} = normalize_ip(end_ip)\n            {start_ip, end_ip_tuple}\n\n          _ ->\n            nil\n        end)\n        |> Enum.reject(&is_nil/1)\n\n      _ ->\n        []\n    end\n  end\n\n  defp find_next_available_in_ranges(ranges, excluded_ranges, allocated_ips) do\n    # Try each range until we find an available IP\n    Enum.reduce_while(ranges, {:error, :pool_exhausted}, fn {start_ip, end_ip}, _acc ->\n      case find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n        {:ok, ip} ->\n          {:halt, {:ok, ip}}\n\n        {:error, :pool_exhausted} ->\n          {:cont, {:error, :pool_exhausted}}\n      end\n    end)\n  end\n\n  defp in_excluded_range?([], _ip_int), do: false\n\n  defp in_excluded_range?(excluded_ranges, ip_int) do\n    Enum.any?(excluded_ranges, fn {start_ip, end_ip} ->\n      start_int = ip_to_integer(start_ip)\n      end_int = ip_to_integer(end_ip)\n      start_int <= ip_int and ip_int <= end_int\n    end)\n  end\n\n  defp normalize_ip(ip) when is_tuple(ip) and tuple_size(ip) == 4, do: {:ok, ip}\n  defp normalize_ip(ip) when is_binary(ip), do: parse_ip_string(ip)\n  defp normalize_ip(_), do: {:error, \"Invalid IP format\"}\n\n  defp get_required_ip(config, key) do\n    case Map.get(config, key) do\n      nil ->\n        {:error, \"Missing required field: #{key}\"}\n\n      ip when is_tuple(ip) and tuple_size(ip) == 4 ->\n        {:ok, ip}\n\n      ip when is_binary(ip) ->\n        parse_ip_string(ip)\n\n      _ ->\n        {:error, \"Invalid IP address format for #{key}\"}\n    end\n  end\n\n  defp validate_range_order(start_ip, end_ip) do\n    if ip_to_integer(start_ip) <= ip_to_integer(end_ip) do\n      :ok\n    else\n      {:error, \"range_start must be less than or equal to range_end\"}\n    end\n  end\n\n  defp find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n    start_int = ip_to_integer(start_ip)\n    end_int = ip_to_integer(end_ip)\n\n    result =\n      Enum.find(start_int..end_int, fn ip_int ->\n        ip = integer_to_ip(ip_int)\n\n        not MapSet.member?(allocated_ips, ip) and\n          not in_excluded_range?(excluded_ranges, ip_int)\n      end)\n\n    case result do\n      nil ->\n        {:error, :pool_exhausted}\n\n      ip_int ->\n        {:ok, integer_to_ip(ip_int)}\n    end\n  end\n\n  defp ip_to_integer({a, b, c, d}) do\n    a * 256 * 256 * 256 + b * 256 * 256 + c * 256 + d\n  end\n\n  defp integer_to_ip(int) do\n    a = div(int, 256 * 256 * 256)\n    b = div(rem(int, 256 * 256 * 256), 256 * 256)\n    c = div(rem(int, 256 * 256), 256)\n    d = rem(int, 256)\n    {a, b, c, d}\n  end\n\n  defp parse_ip_string(ip_string) do\n    case String.split(ip_string, \".\") do\n      [a, b, c, d] ->\n        try do\n          {:ok,\n           {String.to_integer(a), String.to_integer(b), String.to_integer(c),\n            String.to_integer(d)}}\n        rescue\n          _ -> {:error, \"Invalid IP address string: #{ip_string}\"}\n        end\n\n      _ ->\n        {:error, \"Invalid IP address string format: #{ip_string}\"}\n    end\n  end\n\n  defp format_mac(<<mac::binary-size(6)>>) do\n    mac\n    |> :binary.bin_to_list()\n    |> Enum.map(&Integer.to_string(&1, 16))\n    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n    |> Enum.join(\":\")\n    |> String.upcase()\n  end\n\n  defp format_mac(_), do: \"UNKNOWN\"\nend\n","numLines":412,"startLine":1,"totalLines":412}}}
