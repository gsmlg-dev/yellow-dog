{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Yw68HCm4NV9CwYeZMJjjd","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n     6→  REPLY, and other DHCPv6 protocol messages. Handles client identification\n     7→  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv6.LeaseManager\n    13→\n    14→  # DHCPv6 message type constants\n    15→  @msg_type_solicit 1\n    16→  @msg_type_advertise 2\n    17→  @msg_type_request 3\n    18→  # @msg_type_confirm 4\n    19→  @msg_type_renew 5\n    20→  @msg_type_rebind 6\n    21→  @msg_type_reply 7\n    22→  @msg_type_release 8\n    23→  @msg_type_decline 9\n    24→  # @msg_type_reconfigure 10\n    25→  @msg_type_information_request 11\n    26→  @msg_type_relay_forw 12\n    27→  @msg_type_relay_repl 13\n    28→\n    29→  # DHCPv6 option codes\n    30→  @option_client_id 1\n    31→  @option_server_id 2\n    32→  @option_ia_na 3\n    33→  @option_ia_ta 4\n    34→  @option_ia_addr 5\n    35→  # @option_oro 6\n    36→  @option_preference 7\n    37→  # @option_elapsed_time 8\n    38→  # @option_status_code 13\n    39→  # @option_rapid_commit 14\n    40→  @option_dns_servers 23\n    41→  @option_domain_list 24\n    42→  @option_ia_pd 25\n    43→  @option_ia_prefix 26\n    44→\n    45→  @doc \"\"\"\n    46→  Handles incoming DHCPv6 data from clients.\n    47→  \"\"\"\n    48→  @impl true\n    49→  def handle_data({client_ip, client_port, data}, state) do\n    50→    start_time = System.monotonic_time(:microsecond)\n    51→\n    52→    try do\n    53→      case DHCPv6.Message.from_iodata(data) do\n    54→        {:ok, message} ->\n    55→          :telemetry.execute(\n    56→            [:yellow_dog, :dhcpv6, :message, :received],\n    57→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    58→            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n    59→          )\n    60→\n    61→          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n    62→\n    63→        {:error, reason} ->\n    64→          :telemetry.execute(\n    65→            [:yellow_dog, :dhcpv6, :message, :parse_error],\n    66→            %{count: 1},\n    67→            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n    68→          )\n    69→\n    70→          {:continue, state}\n    71→      end\n    72→    rescue\n    73→      error ->\n    74→        :telemetry.execute(\n    75→          [:yellow_dog, :dhcpv6, :message, :error],\n    76→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    77→          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n    78→        )\n    79→\n    80→        {:continue, state}\n    81→    end\n    82→  end\n    83→\n    84→  @doc \"\"\"\n    85→  Handles handler errors (implements Abyss.Handler callback).\n    86→  \"\"\"\n    87→  @impl true\n    88→  def handle_error(error, state) do\n    89→    :telemetry.execute(\n    90→      [:yellow_dog, :dhcpv6, :handler, :error],\n    91→      %{count: 1},\n    92→      %{reason: inspect(error)}\n    93→    )\n    94→\n    95→    {:continue, state}\n    96→  end\n    97→\n    98→  @doc \"\"\"\n    99→  Handles handler timeouts (implements Abyss.Handler callback).\n   100→  \"\"\"\n   101→  @impl true\n   102→  def handle_timeout(state) do\n   103→    :telemetry.execute(\n   104→      [:yellow_dog, :dhcpv6, :handler, :timeout],\n   105→      %{count: 1},\n   106→      %{}\n   107→    )\n   108→\n   109→    {:continue, state}\n   110→  end\n   111→\n   112→  # Private functions for handling specific DHCPv6 message types\n   113→\n   114→  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n   115→    case message.msg_type do\n   116→      @msg_type_solicit ->\n   117→        handle_solicit(message, client_ip, client_port, state, start_time)\n   118→\n   119→      @msg_type_request ->\n   120→        handle_request(message, client_ip, client_port, state, start_time)\n   121→\n   122→      @msg_type_renew ->\n   123→        handle_renew(message, client_ip, client_port, state, start_time)\n   124→\n   125→      @msg_type_rebind ->\n   126→        handle_rebind(message, client_ip, client_port, state, start_time)\n   127→\n   128→      @msg_type_release ->\n   129→        handle_release(message, client_ip, client_port, state, start_time)\n   130→\n   131→      @msg_type_decline ->\n   132→        handle_decline(message, client_ip, client_port, state, start_time)\n   133→\n   134→      @msg_type_information_request ->\n   135→        handle_inform(message, client_ip, client_port, state, start_time)\n   136→\n   137→      @msg_type_relay_forw ->\n   138→        handle_relay_forward(message, client_ip, client_port, state)\n   139→\n   140→      @msg_type_relay_repl ->\n   141→        handle_relay_reply(message, client_ip, client_port, state)\n   142→\n   143→      _ ->\n   144→        :telemetry.execute(\n   145→          [:yellow_dog, :dhcpv6, :message, :unknown],\n   146→          %{count: 1},\n   147→          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n   148→        )\n   149→\n   150→        {:continue, state}\n   151→    end\n   152→  end\n   153→\n   154→  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n   155→    :telemetry.execute(\n   156→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   157→      %{count: 1},\n   158→      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n   159→    )\n   160→\n   161→    client_duid = get_client_duid(message)\n   162→    ia_na = get_ia_na(message)\n   163→    ia_ta = get_ia_ta(message)\n   164→    ia_pd = get_ia_pd(message)\n   165→\n   166→    # Check if any IA type is present\n   167→    case {client_duid, ia_na, ia_ta, ia_pd} do\n   168→      {nil, _, _, _} ->\n   169→        :telemetry.execute(\n   170→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   171→          %{count: 1},\n   172→          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n   173→        )\n   174→\n   175→        {:continue, state}\n   176→\n   177→      {_, nil, nil, nil} ->\n   178→        :telemetry.execute(\n   179→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   180→          %{count: 1},\n   181→          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n   182→        )\n   183→\n   184→        {:continue, state}\n   185→\n   186→      {duid, _, _, _} ->\n   187→        # Process each IA type\n   188→        leases = []\n   189→\n   190→        # Handle IA_NA if present\n   191→        leases =\n   192→          if ia_na do\n   193→            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n   194→              {:ok, lease} ->\n   195→                [lease | leases]\n   196→\n   197→              {:error, reason} ->\n   198→                :telemetry.execute(\n   199→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   200→                  %{count: 1},\n   201→                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n   202→                )\n   203→\n   204→                leases\n   205→            end\n   206→          else\n   207→            leases\n   208→          end\n   209→\n   210→        # Handle IA_TA if present\n   211→        leases =\n   212→          if ia_ta do\n   213→            case allocate_temporary_address(duid, ia_ta.iaid) do\n   214→              {:ok, ta_lease} ->\n   215→                [ta_lease | leases]\n   216→\n   217→              {:error, reason} ->\n   218→                :telemetry.execute(\n   219→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   220→                  %{count: 1},\n   221→                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n   222→                )\n   223→\n   224→                leases\n   225→            end\n   226→          else\n   227→            leases\n   228→          end\n   229→\n   230→        # Handle IA_PD if present\n   231→        leases =\n   232→          if ia_pd do\n   233→            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n   234→            [pd_lease | leases]\n   235→          else\n   236→            leases\n   237→          end\n   238→\n   239→        if length(leases) > 0 do\n   240→          advertise = create_advertise_multi(message, leases)\n   241→          send_dhcpv6_response(advertise, client_ip, client_port, state)\n   242→\n   243→          :telemetry.execute(\n   244→            [:yellow_dog, :dhcpv6, :solicit, :completed],\n   245→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   246→            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n   247→          )\n   248→        end\n   249→\n   250→        {:continue, state}\n   251→    end\n   252→  end\n   253→\n   254→  defp handle_request(message, client_ip, client_port, state, start_time) do\n   255→    :telemetry.execute(\n   256→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   257→      %{count: 1},\n   258→      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n   259→    )\n   260→\n   261→    client_duid = get_client_duid(message)\n   262→    ia_na = get_ia_na(message)\n   263→\n   264→    case {client_duid, ia_na} do\n   265→      {nil, _} ->\n   266→        :telemetry.execute(\n   267→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   268→          %{count: 1},\n   269→          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n   270→        )\n   271→\n   272→        {:continue, state}\n   273→\n   274→      {_, nil} ->\n   275→        :telemetry.execute(\n   276→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   277→          %{count: 1},\n   278→          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n   279→        )\n   280→\n   281→        {:continue, state}\n   282→\n   283→      {duid, %{iaid: iaid}} ->\n   284→        # Allocate or renew lease\n   285→        case LeaseManager.allocate_lease(duid, iaid) do\n   286→          {:ok, lease} ->\n   287→            reply = create_reply(message, lease)\n   288→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   289→\n   290→            :telemetry.execute(\n   291→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   292→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   293→              %{client_ip: client_ip, client_duid: duid}\n   294→            )\n   295→\n   296→          {:error, reason} ->\n   297→            :telemetry.execute(\n   298→              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   299→              %{count: 1},\n   300→              %{reason: inspect(reason), client_duid: duid}\n   301→            )\n   302→        end\n   303→\n   304→        {:continue, state}\n   305→    end\n   306→  end\n   307→\n   308→  defp handle_renew(message, client_ip, client_port, state, start_time) do\n   309→    :telemetry.execute(\n   310→      [:yellow_dog, :dhcpv6, :lease, :renewed],\n   311→      %{count: 1},\n   312→      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n   313→    )\n   314→\n   315→    client_duid = get_client_duid(message)\n   316→    ia_na = get_ia_na(message)\n   317→\n   318→    case {client_duid, ia_na} do\n   319→      {duid, %{iaid: iaid}} when duid != nil ->\n   320→        # Renew existing lease\n   321→        case LeaseManager.allocate_lease(duid, iaid) do\n   322→          {:ok, lease} ->\n   323→            reply = create_reply(message, lease)\n   324→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   325→\n   326→            :telemetry.execute(\n   327→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   328→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   329→              %{client_ip: client_ip, client_duid: duid}\n   330→            )\n   331→\n   332→          {:error, reason} ->\n   333→            :telemetry.execute(\n   334→              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n   335→              %{count: 1},\n   336→              %{reason: inspect(reason), client_duid: duid}\n   337→            )\n   338→        end\n   339→\n   340→        {:continue, state}\n   341→\n   342→      _ ->\n   343→        :telemetry.execute(\n   344→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   345→          %{count: 1},\n   346→          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n   347→        )\n   348→\n   349→        {:continue, state}\n   350→    end\n   351→  end\n   352→\n   353→  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n   354→    :telemetry.execute(\n   355→      [:yellow_dog, :dhcpv6, :lease, :rebind],\n   356→      %{count: 1},\n   357→      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n   358→    )\n   359→\n   360→    # Rebind is similar to renew - reuse the renew logic\n   361→    client_duid = get_client_duid(message)\n   362→    ia_na = get_ia_na(message)\n   363→\n   364→    case {client_duid, ia_na} do\n   365→      {duid, %{iaid: iaid}} when duid != nil ->\n   366→        case LeaseManager.allocate_lease(duid, iaid) do\n   367→          {:ok, lease} ->\n   368→            reply = create_reply(message, lease)\n   369→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   370→\n   371→            :telemetry.execute(\n   372→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   373→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   374→              %{client_ip: client_ip, client_duid: duid}\n   375→            )\n   376→\n   377→          {:error, reason} ->\n   378→            :telemetry.execute(\n   379→              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n   380→              %{count: 1},\n   381→              %{reason: inspect(reason), client_duid: duid}\n   382→            )\n   383→        end\n   384→\n   385→        {:continue, state}\n   386→\n   387→      _ ->\n   388→        :telemetry.execute(\n   389→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   390→          %{count: 1},\n   391→          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n   392→        )\n   393→\n   394→        {:continue, state}\n   395→    end\n   396→  end\n   397→\n   398→  defp handle_release(message, client_ip, client_port, state, start_time) do\n   399→    :telemetry.execute(\n   400→      [:yellow_dog, :dhcpv6, :lease, :released],\n   401→      %{count: 1},\n   402→      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n   403→    )\n   404→\n   405→    client_duid = get_client_duid(message)\n   406→    ia_na = get_ia_na(message)\n   407→\n   408→    case {client_duid, ia_na} do\n   409→      {duid, %{iaid: iaid}} when duid != nil ->\n   410→        LeaseManager.release_lease(duid, iaid)\n   411→\n   412→        :telemetry.execute(\n   413→          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n   414→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   415→          %{client_ip: client_ip, client_duid: duid}\n   416→        )\n   417→\n   418→      _ ->\n   419→        :telemetry.execute(\n   420→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   421→          %{count: 1},\n   422→          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n   423→        )\n   424→    end\n   425→\n   426→    {:continue, state}\n   427→  end\n   428→\n   429→  defp handle_decline(message, client_ip, client_port, state, start_time) do\n   430→    :telemetry.execute(\n   431→      [:yellow_dog, :dhcpv6, :lease, :declined],\n   432→      %{count: 1},\n   433→      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n   434→    )\n   435→\n   436→    client_duid = get_client_duid(message)\n   437→    ia_na = get_ia_na(message)\n   438→\n   439→    case {client_duid, ia_na} do\n   440→      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n   441→        LeaseManager.decline_ip(ia_addr, duid)\n   442→\n   443→        :telemetry.execute(\n   444→          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n   445→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   446→          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n   447→        )\n   448→\n   449→      _ ->\n   450→        :telemetry.execute(\n   451→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   452→          %{count: 1},\n   453→          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n   454→        )\n   455→    end\n   456→\n   457→    {:continue, state}\n   458→  end\n   459→\n   460→  defp handle_inform(message, client_ip, client_port, state, start_time) do\n   461→    :telemetry.execute(\n   462→      [:yellow_dog, :dhcpv6, :inform, :requested],\n   463→      %{count: 1},\n   464→      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n   465→    )\n   466→\n   467→    # INFORMATION-REQUEST - provide configuration without address allocation\n   468→    reply = create_information_reply(message)\n   469→    send_dhcpv6_response(reply, client_ip, client_port, state)\n   470→\n   471→    :telemetry.execute(\n   472→      [:yellow_dog, :dhcpv6, :inform, :completed],\n   473→      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   474→      %{client_ip: client_ip}\n   475→    )\n   476→\n   477→    {:continue, state}\n   478→  end\n   479→\n   480→  defp handle_relay_forward(_message, client_ip, client_port, state) do\n   481→    :telemetry.execute(\n   482→      [:yellow_dog, :dhcpv6, :relay, :forward],\n   483→      %{count: 1},\n   484→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   485→    )\n   486→\n   487→    {:continue, state}\n   488→  end\n   489→\n   490→  defp handle_relay_reply(_message, client_ip, client_port, state) do\n   491→    :telemetry.execute(\n   492→      [:yellow_dog, :dhcpv6, :relay, :reply],\n   493→      %{count: 1},\n   494→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   495→    )\n   496→\n   497→    {:continue, state}\n   498→  end\n   499→\n   500→  # Message creation functions\n   501→\n   502→  defp create_reply(request, lease) do\n   503→    pool = get_pool_for_lease(lease)\n   504→\n   505→    %DHCPv6.Message{\n   506→      msg_type: @msg_type_reply,\n   507→      transaction_id: request.transaction_id,\n   508→      options:\n   509→        [\n   510→          # Server DUID\n   511→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   512→          # Client DUID (echo back)\n   513→          %DHCPv6.Message.Option{\n   514→            option_code: @option_client_id,\n   515→            option_data: get_client_duid(request)\n   516→          },\n   517→          # IA_NA with IA_ADDR\n   518→          create_ia_na_option(lease),\n   519→          # DNS servers\n   520→          create_dns_servers_option(pool.dns_servers)\n   521→        ]\n   522→        |> add_domain_list_option(pool.domain_name)\n   523→    }\n   524→  end\n   525→\n   526→  defp create_information_reply(request) do\n   527→    pool = get_default_pool()\n   528→\n   529→    %DHCPv6.Message{\n   530→      msg_type: @msg_type_reply,\n   531→      transaction_id: request.transaction_id,\n   532→      options:\n   533→        [\n   534→          # Server DUID\n   535→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   536→          # Client DUID (echo back)\n   537→          %DHCPv6.Message.Option{\n   538→            option_code: @option_client_id,\n   539→            option_data: get_client_duid(request)\n   540→          },\n   541→          # DNS servers\n   542→          create_dns_servers_option(pool.dns_servers)\n   543→        ]\n   544→        |> add_domain_list_option(pool.domain_name)\n   545→    }\n   546→  end\n   547→\n   548→  # Helper functions for creating options\n   549→\n   550→  defp create_ia_na_option(lease) do\n   551→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   552→    ia_addr_data =\n   553→      ipv6_to_binary(lease.ip) <>\n   554→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   555→\n   556→    ia_addr_option = %DHCPv6.Message.Option{\n   557→      option_code: @option_ia_addr,\n   558→      option_data: ia_addr_data\n   559→    }\n   560→\n   561→    # IA_NA option (option 3) - contains IA_ADDR\n   562→    # IAID + T1 + T2 (0 = server decides)\n   563→    ia_na_data =\n   564→      <<lease.iaid::32, 0::32, 0::32>> <>\n   565→        DHCP.Parameter.to_iodata(ia_addr_option)\n   566→\n   567→    %DHCPv6.Message.Option{\n   568→      option_code: @option_ia_na,\n   569→      option_data: ia_na_data\n   570→    }\n   571→  end\n   572→\n   573→  defp create_dns_servers_option(dns_servers) do\n   574→    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n   575→\n   576→    %DHCPv6.Message.Option{\n   577→      option_code: @option_dns_servers,\n   578→      option_data: dns_data\n   579→    }\n   580→  end\n   581→\n   582→  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n   583→\n   584→  defp add_domain_list_option(options, domain) do\n   585→    # Encode domain name in DNS format (length-prefixed labels)\n   586→    domain_data = encode_domain_name(domain)\n   587→\n   588→    domain_option = %DHCPv6.Message.Option{\n   589→      option_code: @option_domain_list,\n   590→      option_data: domain_data\n   591→    }\n   592→\n   593→    options ++ [domain_option]\n   594→  end\n   595→\n   596→  defp encode_domain_name(domain) do\n   597→    # RFC 1035: Each label is limited to 63 octets\n   598→    domain\n   599→    |> String.split(\".\")\n   600→    |> Enum.map_join(fn label ->\n   601→      # Enforce max label length per DNS specification\n   602→      truncated_label =\n   603→        if byte_size(label) > 63 do\n   604→          :telemetry.execute(\n   605→            [:yellow_dog, :dhcpv6, :config, :warning],\n   606→            %{count: 1},\n   607→            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n   608→          )\n   609→\n   610→          binary_part(label, 0, 63)\n   611→        else\n   612→          label\n   613→        end\n   614→\n   615→      <<byte_size(truncated_label)::8, truncated_label::binary>>\n   616→    end)\n   617→    # Terminating zero\n   618→    |> Kernel.<>(<<0>>)\n   619→  end\n   620→\n   621→  # Helper functions for extracting information from messages\n   622→\n   623→  defp get_client_duid(message) do\n   624→    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n   625→      nil -> nil\n   626→      option -> option.option_data\n   627→    end\n   628→  end\n   629→\n   630→  defp get_ia_na(message) do\n   631→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n   632→      nil ->\n   633→        nil\n   634→\n   635→      option ->\n   636→        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   637→        case option.option_data do\n   638→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   639→            # Try to extract IA_ADDR if present\n   640→            ia_addr = extract_ia_addr(rest)\n   641→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n   642→\n   643→          _ ->\n   644→            nil\n   645→        end\n   646→    end\n   647→  end\n   648→\n   649→  defp get_ia_ta(message) do\n   650→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n   651→      nil ->\n   652→        nil\n   653→\n   654→      option ->\n   655→        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n   656→        case option.option_data do\n   657→          <<iaid::32, rest::binary>> ->\n   658→            ia_addr = extract_ia_addr(rest)\n   659→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n   660→\n   661→          _ ->\n   662→            nil\n   663→        end\n   664→    end\n   665→  end\n   666→\n   667→  defp get_ia_pd(message) do\n   668→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n   669→      nil ->\n   670→        nil\n   671→\n   672→      option ->\n   673→        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   674→        case option.option_data do\n   675→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   676→            ia_prefix = extract_ia_prefix(rest)\n   677→            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n   678→\n   679→          _ ->\n   680→            nil\n   681→        end\n   682→    end\n   683→  end\n   684→\n   685→  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n   686→    case data do\n   687→      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n   688→        {a, b, c, d, e, f, g, h}\n   689→\n   690→      _ ->\n   691→        nil\n   692→    end\n   693→  end\n   694→\n   695→  defp extract_ia_addr(_), do: nil\n   696→\n   697→  defp extract_ia_prefix(\n   698→         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n   699→       ) do\n   700→    case data do\n   701→      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n   702→        g::16, h::16>> ->\n   703→        {{a, b, c, d, e, f, g, h}, prefix_len}\n   704→\n   705→      _ ->\n   706→        nil\n   707→    end\n   708→  end\n   709→\n   710→  defp extract_ia_prefix(_), do: nil\n   711→\n   712→  # Allocation helper functions\n   713→\n   714→  defp allocate_temporary_address(duid, iaid) do\n   715→    # Temporary addresses use a separate pool with shorter lifetimes\n   716→    # For now, delegate to LeaseManager with IA_TA type marker\n   717→    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n   718→      {:ok, lease} ->\n   719→        # Mark as temporary address with shorter lifetime\n   720→        ta_lease = %{\n   721→          lease\n   722→          | ia_type: :ia_ta,\n   723→            preferred_lifetime: 600,\n   724→            # 10 minutes\n   725→            valid_lifetime: 1200\n   726→            # 20 minutes\n   727→        }\n   728→\n   729→        {:ok, ta_lease}\n   730→\n   731→      error ->\n   732→        error\n   733→    end\n   734→  end\n   735→\n   736→  defp allocate_prefix_delegation(duid, iaid) do\n   737→    # For now, return a placeholder\n   738→    # Full implementation would use PrefixPool module\n   739→    :telemetry.execute(\n   740→      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n   741→      %{count: 1},\n   742→      %{client_duid: duid, iaid: iaid}\n   743→    )\n   744→\n   745→    # TODO: Integrate with PrefixPool module\n   746→    # Example placeholder prefix: 2001:db8:1000::/56\n   747→    {:ok,\n   748→     %{\n   749→       duid: duid,\n   750→       iaid: iaid,\n   751→       ia_type: :ia_pd,\n   752→       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n   753→       preferred_lifetime: 3600,\n   754→       valid_lifetime: 7200,\n   755→       pool_name: \"default-pd\"\n   756→     }}\n   757→  end\n   758→\n   759→  # Message creation functions with multi-IA support\n   760→\n   761→  defp create_advertise_multi(solicit, leases) do\n   762→    pool = get_default_pool()\n   763→\n   764→    options = [\n   765→      # Server DUID\n   766→      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   767→      # Client DUID (echo back)\n   768→      %DHCPv6.Message.Option{\n   769→        option_code: @option_client_id,\n   770→        option_data: get_client_duid(solicit)\n   771→      },\n   772→      # Preference\n   773→      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n   774→    ]\n   775→\n   776→    # Add IA options for each lease\n   777→    ia_options =\n   778→      Enum.flat_map(leases, fn lease ->\n   779→        case lease.ia_type do\n   780→          :ia_na -> [create_ia_na_option(lease)]\n   781→          :ia_ta -> [create_ia_ta_option(lease)]\n   782→          :ia_pd -> [create_ia_pd_option(lease)]\n   783→          _ -> []\n   784→        end\n   785→      end)\n   786→\n   787→    # Add configuration options (DNS, etc.)\n   788→    config_options =\n   789→      [\n   790→        create_dns_servers_option(pool.dns_servers)\n   791→      ] ++ add_domain_list_option([], pool.domain_name)\n   792→\n   793→    %DHCPv6.Message{\n   794→      msg_type: @msg_type_advertise,\n   795→      transaction_id: solicit.transaction_id,\n   796→      options: options ++ ia_options ++ config_options\n   797→    }\n   798→  end\n   799→\n   800→  defp create_ia_ta_option(lease) do\n   801→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   802→    ia_addr_data =\n   803→      ipv6_to_binary(lease.ip) <>\n   804→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   805→\n   806→    ia_addr_option = %DHCPv6.Message.Option{\n   807→      option_code: @option_ia_addr,\n   808→      option_data: ia_addr_data\n   809→    }\n   810→\n   811→    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n   812→    ia_ta_data =\n   813→      <<lease.iaid::32>> <>\n   814→        DHCP.Parameter.to_iodata(ia_addr_option)\n   815→\n   816→    %DHCPv6.Message.Option{\n   817→      option_code: @option_ia_ta,\n   818→      option_data: ia_ta_data\n   819→    }\n   820→  end\n   821→\n   822→  defp create_ia_pd_option(lease) do\n   823→    {prefix_addr, prefix_len} = lease.delegated_prefix\n   824→\n   825→    # IA_PREFIX option (option 26)\n   826→    ia_prefix_data =\n   827→      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n   828→        ipv6_to_binary(prefix_addr)\n   829→\n   830→    ia_prefix_option = %DHCPv6.Message.Option{\n   831→      option_code: @option_ia_prefix,\n   832→      option_data: ia_prefix_data\n   833→    }\n   834→\n   835→    # IA_PD option (option 25)\n   836→    ia_pd_data =\n   837→      <<lease.iaid::32, 0::32, 0::32>> <>\n   838→        DHCP.Parameter.to_iodata(ia_prefix_option)\n   839→\n   840→    %DHCPv6.Message.Option{\n   841→      option_code: @option_ia_pd,\n   842→      option_data: ia_pd_data\n   843→    }\n   844→  end\n   845→\n   846→  defp get_server_duid do\n   847→    # Generate a simple DUID-LL (Link-Layer) based on server\n   848→    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n   849→    # Using a static server identifier for now\n   850→    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n   851→  end\n   852→\n   853→  defp get_pool_for_lease(_lease) do\n   854→    # For now, use default pool\n   855→    # In production, look up pool by lease.pool_name\n   856→    get_default_pool()\n   857→  end\n   858→\n   859→  defp get_default_pool do\n   860→    %{\n   861→      name: \"default\",\n   862→      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   863→      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n   864→      prefix_length: 64,\n   865→      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n   866→      domain_name: \"local\",\n   867→      preferred_lifetime: 3600,\n   868→      valid_lifetime: 7200\n   869→    }\n   870→  end\n   871→\n   872→  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n   873→    data = DHCP.Parameter.to_iodata(response)\n   874→\n   875→    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n   876→      :ok ->\n   877→        :telemetry.execute(\n   878→          [:yellow_dog, :dhcpv6, :response, :sent],\n   879→          %{count: 1},\n   880→          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n   881→        )\n   882→\n   883→      {:error, reason} ->\n   884→        :telemetry.execute(\n   885→          [:yellow_dog, :dhcpv6, :response, :send_failed],\n   886→          %{count: 1},\n   887→          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n   888→        )\n   889→    end\n   890→  end\n   891→\n   892→  # Utility functions\n   893→\n   894→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   895→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   896→  end\n   897→end\n   898→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01GysfH7RjSXXrDh7G4bTCfc","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"4618db32-faea-44ea-a9ca-28615ecb7ae5","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/handler.ex","content":"defmodule YellowDog.Dhcpv6.Handler do\n  @moduledoc \"\"\"\n  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n\n  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n  REPLY, and other DHCPv6 protocol messages. Handles client identification\n  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv6.LeaseManager\n\n  # DHCPv6 message type constants\n  @msg_type_solicit 1\n  @msg_type_advertise 2\n  @msg_type_request 3\n  # @msg_type_confirm 4\n  @msg_type_renew 5\n  @msg_type_rebind 6\n  @msg_type_reply 7\n  @msg_type_release 8\n  @msg_type_decline 9\n  # @msg_type_reconfigure 10\n  @msg_type_information_request 11\n  @msg_type_relay_forw 12\n  @msg_type_relay_repl 13\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  # @option_oro 6\n  @option_preference 7\n  # @option_elapsed_time 8\n  # @option_status_code 13\n  # @option_rapid_commit 14\n  @option_dns_servers 23\n  @option_domain_list 24\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @doc \"\"\"\n  Handles incoming DHCPv6 data from clients.\n  \"\"\"\n  @impl true\n  def handle_data({client_ip, client_port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    try do\n      case DHCPv6.Message.from_iodata(data) do\n        {:ok, message} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :received],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n          )\n\n          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :parse_error],\n            %{count: 1},\n            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n          )\n\n          {:continue, state}\n      end\n    rescue\n      error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :error],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @doc \"\"\"\n  Handles handler errors (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles handler timeouts (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions for handling specific DHCPv6 message types\n\n  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n    case message.msg_type do\n      @msg_type_solicit ->\n        handle_solicit(message, client_ip, client_port, state, start_time)\n\n      @msg_type_request ->\n        handle_request(message, client_ip, client_port, state, start_time)\n\n      @msg_type_renew ->\n        handle_renew(message, client_ip, client_port, state, start_time)\n\n      @msg_type_rebind ->\n        handle_rebind(message, client_ip, client_port, state, start_time)\n\n      @msg_type_release ->\n        handle_release(message, client_ip, client_port, state, start_time)\n\n      @msg_type_decline ->\n        handle_decline(message, client_ip, client_port, state, start_time)\n\n      @msg_type_information_request ->\n        handle_inform(message, client_ip, client_port, state, start_time)\n\n      @msg_type_relay_forw ->\n        handle_relay_forward(message, client_ip, client_port, state)\n\n      @msg_type_relay_repl ->\n        handle_relay_reply(message, client_ip, client_port, state)\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :unknown],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n    ia_ta = get_ia_ta(message)\n    ia_pd = get_ia_pd(message)\n\n    # Check if any IA type is present\n    case {client_duid, ia_na, ia_ta, ia_pd} do\n      {nil, _, _, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil, nil, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, _, _, _} ->\n        # Process each IA type\n        leases = []\n\n        # Handle IA_NA if present\n        leases =\n          if ia_na do\n            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n              {:ok, lease} ->\n                [lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_TA if present\n        leases =\n          if ia_ta do\n            case allocate_temporary_address(duid, ia_ta.iaid) do\n              {:ok, ta_lease} ->\n                [ta_lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_PD if present\n        leases =\n          if ia_pd do\n            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n            [pd_lease | leases]\n          else\n            leases\n          end\n\n        if length(leases) > 0 do\n          advertise = create_advertise_multi(message, leases)\n          send_dhcpv6_response(advertise, client_ip, client_port, state)\n\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :solicit, :completed],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n          )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_request(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {nil, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, %{iaid: iaid}} ->\n        # Allocate or renew lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_renew(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :renewed],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        # Renew existing lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :rebind],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n    )\n\n    # Rebind is similar to renew - reuse the renew logic\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_release(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :released],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        LeaseManager.release_lease(duid, iaid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_decline(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :declined],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n        LeaseManager.decline_ip(ia_addr, duid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_inform(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n    )\n\n    # INFORMATION-REQUEST - provide configuration without address allocation\n    reply = create_information_reply(message)\n    send_dhcpv6_response(reply, client_ip, client_port, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :completed],\n      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_forward(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :forward],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_reply(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :reply],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  # Message creation functions\n\n  defp create_reply(request, lease) do\n    pool = get_pool_for_lease(lease)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # IA_NA with IA_ADDR\n          create_ia_na_option(lease),\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  defp create_information_reply(request) do\n    pool = get_default_pool()\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  # Helper functions for creating options\n\n  defp create_ia_na_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_NA option (option 3) - contains IA_ADDR\n    # IAID + T1 + T2 (0 = server decides)\n    ia_na_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_na,\n      option_data: ia_na_data\n    }\n  end\n\n  defp create_dns_servers_option(dns_servers) do\n    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_dns_servers,\n      option_data: dns_data\n    }\n  end\n\n  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n\n  defp add_domain_list_option(options, domain) do\n    # Encode domain name in DNS format (length-prefixed labels)\n    domain_data = encode_domain_name(domain)\n\n    domain_option = %DHCPv6.Message.Option{\n      option_code: @option_domain_list,\n      option_data: domain_data\n    }\n\n    options ++ [domain_option]\n  end\n\n  defp encode_domain_name(domain) do\n    # RFC 1035: Each label is limited to 63 octets\n    domain\n    |> String.split(\".\")\n    |> Enum.map_join(fn label ->\n      # Enforce max label length per DNS specification\n      truncated_label =\n        if byte_size(label) > 63 do\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :config, :warning],\n            %{count: 1},\n            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n          )\n\n          binary_part(label, 0, 63)\n        else\n          label\n        end\n\n      <<byte_size(truncated_label)::8, truncated_label::binary>>\n    end)\n    # Terminating zero\n    |> Kernel.<>(<<0>>)\n  end\n\n  # Helper functions for extracting information from messages\n\n  defp get_client_duid(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n      nil -> nil\n      option -> option.option_data\n    end\n  end\n\n  defp get_ia_na(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            # Try to extract IA_ADDR if present\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_ta(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n        case option.option_data do\n          <<iaid::32, rest::binary>> ->\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_pd(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            ia_prefix = extract_ia_prefix(rest)\n            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\n\n  # Allocation helper functions\n\n  defp allocate_temporary_address(duid, iaid) do\n    # Temporary addresses use a separate pool with shorter lifetimes\n    # For now, delegate to LeaseManager with IA_TA type marker\n    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n      {:ok, lease} ->\n        # Mark as temporary address with shorter lifetime\n        ta_lease = %{\n          lease\n          | ia_type: :ia_ta,\n            preferred_lifetime: 600,\n            # 10 minutes\n            valid_lifetime: 1200\n            # 20 minutes\n        }\n\n        {:ok, ta_lease}\n\n      error ->\n        error\n    end\n  end\n\n  defp allocate_prefix_delegation(duid, iaid) do\n    # For now, return a placeholder\n    # Full implementation would use PrefixPool module\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n      %{count: 1},\n      %{client_duid: duid, iaid: iaid}\n    )\n\n    # TODO: Integrate with PrefixPool module\n    # Example placeholder prefix: 2001:db8:1000::/56\n    {:ok,\n     %{\n       duid: duid,\n       iaid: iaid,\n       ia_type: :ia_pd,\n       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n       preferred_lifetime: 3600,\n       valid_lifetime: 7200,\n       pool_name: \"default-pd\"\n     }}\n  end\n\n  # Message creation functions with multi-IA support\n\n  defp create_advertise_multi(solicit, leases) do\n    pool = get_default_pool()\n\n    options = [\n      # Server DUID\n      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n      # Client DUID (echo back)\n      %DHCPv6.Message.Option{\n        option_code: @option_client_id,\n        option_data: get_client_duid(solicit)\n      },\n      # Preference\n      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n    ]\n\n    # Add IA options for each lease\n    ia_options =\n      Enum.flat_map(leases, fn lease ->\n        case lease.ia_type do\n          :ia_na -> [create_ia_na_option(lease)]\n          :ia_ta -> [create_ia_ta_option(lease)]\n          :ia_pd -> [create_ia_pd_option(lease)]\n          _ -> []\n        end\n      end)\n\n    # Add configuration options (DNS, etc.)\n    config_options =\n      [\n        create_dns_servers_option(pool.dns_servers)\n      ] ++ add_domain_list_option([], pool.domain_name)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_advertise,\n      transaction_id: solicit.transaction_id,\n      options: options ++ ia_options ++ config_options\n    }\n  end\n\n  defp create_ia_ta_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n    ia_ta_data =\n      <<lease.iaid::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_ta,\n      option_data: ia_ta_data\n    }\n  end\n\n  defp create_ia_pd_option(lease) do\n    {prefix_addr, prefix_len} = lease.delegated_prefix\n\n    # IA_PREFIX option (option 26)\n    ia_prefix_data =\n      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n        ipv6_to_binary(prefix_addr)\n\n    ia_prefix_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_prefix,\n      option_data: ia_prefix_data\n    }\n\n    # IA_PD option (option 25)\n    ia_pd_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_prefix_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_pd,\n      option_data: ia_pd_data\n    }\n  end\n\n  defp get_server_duid do\n    # Generate a simple DUID-LL (Link-Layer) based on server\n    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n    # Using a static server identifier for now\n    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use default pool\n    # In production, look up pool by lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    %{\n      name: \"default\",\n      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n      prefix_length: 64,\n      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n      domain_name: \"local\",\n      preferred_lifetime: 3600,\n      valid_lifetime: 7200\n    }\n  end\n\n  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :sent],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :send_failed],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Utility functions\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\nend\n","numLines":898,"startLine":1,"totalLines":898}}}
