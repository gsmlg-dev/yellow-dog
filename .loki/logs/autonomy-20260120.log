{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016zQdWMLxgJLCLqe6iL4QCL","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.LeaseStorage do\n     2→  @moduledoc \"\"\"\n     3→  Persistent lease storage using Mnesia.\n     4→\n     5→  Provides a durable, transactional storage layer for DHCP leases with\n     6→  support for multiple lease states and comprehensive querying.\n     7→\n     8→  ## Lease States\n     9→\n    10→  - `:offered` - IP address offered to client, awaiting REQUEST\n    11→  - `:active` - Lease active and in use by client\n    12→  - `:released` - Client released the lease voluntarily\n    13→  - `:expired` - Lease exceeded its lifetime\n    14→  - `:declined` - Client declined the offered IP (conflict detected)\n    15→\n    16→  ## Storage Modes\n    17→\n    18→  - `:disc_copies` - Persistent storage (default for production)\n    19→  - `:ram_copies` - Memory-only storage (for testing)\n    20→  \"\"\"\n    21→\n    22→  require Record\n    23→\n    24→  alias YellowDog.Dhcpv4.AddressPool\n    25→\n    26→  @type ip_address :: AddressPool.ip_address()\n    27→  @type mac_address :: binary()\n    28→  @type client_id :: binary() | nil\n    29→  @type lease_state :: :offered | :active | :released | :expired | :declined\n    30→\n    31→  @type lease :: %{\n    32→          mac_address: mac_address(),\n    33→          ip_address: ip_address(),\n    34→          pool_name: String.t(),\n    35→          state: lease_state(),\n    36→          lease_time: pos_integer(),\n    37→          expires_at: integer(),\n    38→          hostname: String.t() | nil,\n    39→          client_id: client_id(),\n    40→          created_at: integer(),\n    41→          updated_at: integer()\n    42→        }\n    43→\n    44→  # Define Mnesia record\n    45→  Record.defrecord(:lease_record,\n    46→    mac_address: nil,\n    47→    ip_address: nil,\n    48→    pool_name: nil,\n    49→    state: :offered,\n    50→    lease_time: 0,\n    51→    expires_at: 0,\n    52→    hostname: nil,\n    53→    client_id: nil,\n    54→    created_at: 0,\n    55→    updated_at: 0\n    56→  )\n    57→\n    58→  @table_name :dhcpv4_leases\n    59→\n    60→  ## Public API\n    61→\n    62→  @doc \"\"\"\n    63→  Initializes the Mnesia schema and creates the leases table.\n    64→\n    65→  ## Options\n    66→\n    67→  - `:storage_type` - `:disc_copies` (default) or `:ram_copies`\n    68→  - `:nodes` - List of nodes to create table on (default: [node()])\n    69→\n    70→  ## Returns\n    71→\n    72→  - `:ok` - Successfully initialized\n    73→  - `{:error, reason}` - Failed to initialize\n    74→  \"\"\"\n    75→  @spec init(keyword()) :: :ok | {:error, term()}\n    76→  def init(opts \\\\ []) do\n    77→    storage_type = Keyword.get(opts, :storage_type, :disc_copies)\n    78→    nodes = Keyword.get(opts, :nodes, [node()])\n    79→\n    80→    with :ok <- ensure_schema_created(nodes),\n    81→         :ok <- ensure_table_created(storage_type, nodes) do\n    82→      :telemetry.execute(\n    83→        [:yellow_dog, :dhcpv4, :lease_storage, :initialized],\n    84→        %{count: 1},\n    85→        %{storage_type: storage_type, nodes: nodes}\n    86→      )\n    87→\n    88→      :ok\n    89→    else\n    90→      {:error, reason} = error ->\n    91→        :telemetry.execute(\n    92→          [:yellow_dog, :dhcpv4, :lease_storage, :init_failed],\n    93→          %{count: 1},\n    94→          %{reason: inspect(reason)}\n    95→        )\n    96→\n    97→        error\n    98→    end\n    99→  end\n   100→\n   101→  @doc \"\"\"\n   102→  Stores or updates a lease in the database.\n   103→\n   104→  ## Parameters\n   105→\n   106→  - `lease` - Lease map with required fields\n   107→\n   108→  ## Returns\n   109→\n   110→  - `{:ok, lease}` - Successfully stored\n   111→  - `{:error, reason}` - Failed to store\n   112→  \"\"\"\n   113→  @spec put(lease()) :: {:ok, lease()} | {:error, term()}\n   114→  def put(lease) do\n   115→    now = System.system_time(:second)\n   116→\n   117→    record =\n   118→      lease_record(\n   119→        mac_address: lease.mac_address,\n   120→        ip_address: lease.ip_address,\n   121→        pool_name: lease.pool_name,\n   122→        state: lease.state,\n   123→        lease_time: lease.lease_time,\n   124→        expires_at: lease.expires_at,\n   125→        hostname: lease[:hostname],\n   126→        client_id: lease[:client_id],\n   127→        created_at: lease[:created_at] || now,\n   128→        updated_at: now\n   129→      )\n   130→\n   131→    transaction = fn ->\n   132→      :mnesia.write(@table_name, record, :write)\n   133→      record_to_map(record)\n   134→    end\n   135→\n   136→    case :mnesia.transaction(transaction) do\n   137→      {:atomic, result} ->\n   138→        {:ok, result}\n   139→\n   140→      {:aborted, reason} ->\n   141→        :telemetry.execute(\n   142→          [:yellow_dog, :dhcpv4, :lease_storage, :store_failed],\n   143→          %{count: 1},\n   144→          %{reason: inspect(reason)}\n   145→        )\n   146→\n   147→        {:error, reason}\n   148→    end\n   149→  end\n   150→\n   151→  @doc \"\"\"\n   152→  Retrieves a lease by MAC address.\n   153→\n   154→  ## Parameters\n   155→\n   156→  - `mac_address` - Client MAC address\n   157→\n   158→  ## Returns\n   159→\n   160→  - `{:ok, lease}` - Lease found\n   161→  - `{:error, :not_found}` - No lease exists\n   162→  \"\"\"\n   163→  @spec get(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n   164→  def get(mac_address) do\n   165→    transaction = fn ->\n   166→      case :mnesia.read(@table_name, mac_address) do\n   167→        [record] -> record_to_map(record)\n   168→        [] -> nil\n   169→      end\n   170→    end\n   171→\n   172→    case :mnesia.transaction(transaction) do\n   173→      {:atomic, nil} ->\n   174→        {:error, :not_found}\n   175→\n   176→      {:atomic, lease} ->\n   177→        {:ok, lease}\n   178→\n   179→      {:aborted, reason} ->\n   180→        :telemetry.execute(\n   181→          [:yellow_dog, :dhcpv4, :lease_storage, :read_failed],\n   182→          %{count: 1},\n   183→          %{reason: inspect(reason)}\n   184→        )\n   185→\n   186→        {:error, reason}\n   187→    end\n   188→  end\n   189→\n   190→  @doc \"\"\"\n   191→  Retrieves a lease by IP address.\n   192→\n   193→  ## Parameters\n   194→\n   195→  - `ip_address` - IP address tuple\n   196→\n   197→  ## Returns\n   198→\n   199→  - `{:ok, lease}` - Lease found\n   200→  - `{:error, :not_found}` - No lease exists\n   201→  \"\"\"\n   202→  @spec get_by_ip(ip_address()) :: {:ok, lease()} | {:error, :not_found}\n   203→  def get_by_ip(ip_address) do\n   204→    transaction = fn ->\n   205→      :mnesia.match_object(@table_name, lease_record(ip_address: ip_address, _: :_), :read)\n   206→    end\n   207→\n   208→    case :mnesia.transaction(transaction) do\n   209→      {:atomic, [record]} ->\n   210→        {:ok, record_to_map(record)}\n   211→\n   212→      {:atomic, []} ->\n   213→        {:error, :not_found}\n   214→\n   215→      {:atomic, _multiple} ->\n   216→        # This shouldn't happen - IP should be unique\n   217→        :telemetry.execute(\n   218→          [:yellow_dog, :dhcpv4, :lease_storage, :multiple_found],\n   219→          %{count: 1},\n   220→          %{ip_address: ip_address}\n   221→        )\n   222→\n   223→        {:error, :multiple_found}\n   224→\n   225→      {:aborted, reason} ->\n   226→        :telemetry.execute(\n   227→          [:yellow_dog, :dhcpv4, :lease_storage, :read_by_ip_failed],\n   228→          %{count: 1},\n   229→          %{reason: inspect(reason)}\n   230→        )\n   231→\n   232→        {:error, reason}\n   233→    end\n   234→  end\n   235→\n   236→  @doc \"\"\"\n   237→  Deletes a lease by MAC address.\n   238→\n   239→  ## Parameters\n   240→\n   241→  - `mac_address` - Client MAC address\n   242→\n   243→  ## Returns\n   244→\n   245→  - `:ok` - Successfully deleted or didn't exist\n   246→  \"\"\"\n   247→  @spec delete(mac_address()) :: :ok\n   248→  def delete(mac_address) do\n   249→    transaction = fn ->\n   250→      :mnesia.delete(@table_name, mac_address, :write)\n   251→    end\n   252→\n   253→    case :mnesia.transaction(transaction) do\n   254→      {:atomic, :ok} ->\n   255→        :ok\n   256→\n   257→      {:aborted, reason} ->\n   258→        :telemetry.execute(\n   259→          [:yellow_dog, :dhcpv4, :lease_storage, :delete_failed],\n   260→          %{count: 1},\n   261→          %{reason: inspect(reason)}\n   262→        )\n   263→\n   264→        {:error, reason}\n   265→    end\n   266→  end\n   267→\n   268→  @doc \"\"\"\n   269→  Lists all leases with optional filtering.\n   270→\n   271→  ## Options\n   272→\n   273→  - `:state` - Filter by state (e.g., :active, :expired)\n   274→  - `:pool_name` - Filter by pool name\n   275→  - `:active_only` - Only return non-expired leases (default: false)\n   276→\n   277→  ## Returns\n   278→\n   279→  - List of leases\n   280→  \"\"\"\n   281→  @spec list(keyword()) :: [lease()]\n   282→  def list(opts \\\\ []) do\n   283→    state_filter = Keyword.get(opts, :state)\n   284→    pool_filter = Keyword.get(opts, :pool_name)\n   285→    active_only = Keyword.get(opts, :active_only, false)\n   286→    now = System.system_time(:second)\n   287→\n   288→    transaction = fn ->\n   289→      pattern =\n   290→        cond do\n   291→          state_filter && pool_filter ->\n   292→            lease_record(state: state_filter, pool_name: pool_filter, _: :_)\n   293→\n   294→          state_filter ->\n   295→            lease_record(state: state_filter, _: :_)\n   296→\n   297→          pool_filter ->\n   298→            lease_record(pool_name: pool_filter, _: :_)\n   299→\n   300→          true ->\n   301→            lease_record(_: :_)\n   302→        end\n   303→\n   304→      :mnesia.match_object(@table_name, pattern, :read)\n   305→      |> Enum.map(&record_to_map/1)\n   306→      |> then(fn leases ->\n   307→        if active_only do\n   308→          Enum.filter(leases, fn lease ->\n   309→            lease.state == :active && lease.expires_at > now\n   310→          end)\n   311→        else\n   312→          leases\n   313→        end\n   314→      end)\n   315→    end\n   316→\n   317→    case :mnesia.transaction(transaction) do\n   318→      {:atomic, leases} ->\n   319→        leases\n   320→\n   321→      {:aborted, reason} ->\n   322→        :telemetry.execute(\n   323→          [:yellow_dog, :dhcpv4, :lease_storage, :list_failed],\n   324→          %{count: 1},\n   325→          %{reason: inspect(reason)}\n   326→        )\n   327→\n   328→        []\n   329→    end\n   330→  end\n   331→\n   332→  @doc \"\"\"\n   333→  Gets all active (non-expired) leases.\n   334→\n   335→  ## Returns\n   336→\n   337→  - List of active leases\n   338→  \"\"\"\n   339→  @spec list_active() :: [lease()]\n   340→  def list_active do\n   341→    list(active_only: true)\n   342→  end\n   343→\n   344→  @doc \"\"\"\n   345→  Gets all allocated IP addresses for active leases.\n   346→\n   347→  ## Returns\n   348→\n   349→  - MapSet of IP addresses\n   350→  \"\"\"\n   351→  @spec get_allocated_ips() :: MapSet.t(ip_address())\n   352→  def get_allocated_ips do\n   353→    list_active()\n   354→    |> Enum.map(& &1.ip_address)\n   355→    |> MapSet.new()\n   356→  end\n   357→\n   358→  @doc \"\"\"\n   359→  Updates the state of a lease.\n   360→\n   361→  ## Parameters\n   362→\n   363→  - `mac_address` - Client MAC address\n   364→  - `new_state` - New lease state\n   365→\n   366→  ## Returns\n   367→\n   368→  - `{:ok, lease}` - Successfully updated\n   369→  - `{:error, reason}` - Failed to update\n   370→  \"\"\"\n   371→  @spec update_state(mac_address(), lease_state()) :: {:ok, lease()} | {:error, term()}\n   372→  def update_state(mac_address, new_state) do\n   373→    transaction = fn ->\n   374→      case :mnesia.read(@table_name, mac_address) do\n   375→        [record] ->\n   376→          now = System.system_time(:second)\n   377→\n   378→          updated_record =\n   379→            lease_record(record,\n   380→              state: new_state,\n   381→              updated_at: now\n   382→            )\n   383→\n   384→          :mnesia.write(@table_name, updated_record, :write)\n   385→          record_to_map(updated_record)\n   386→\n   387→        [] ->\n   388→          nil\n   389→      end\n   390→    end\n   391→\n   392→    case :mnesia.transaction(transaction) do\n   393→      {:atomic, nil} ->\n   394→        {:error, :not_found}\n   395→\n   396→      {:atomic, lease} ->\n   397→        {:ok, lease}\n   398→\n   399→      {:aborted, reason} ->\n   400→        :telemetry.execute(\n   401→          [:yellow_dog, :dhcpv4, :lease_storage, :update_state_failed],\n   402→          %{count: 1},\n   403→          %{reason: inspect(reason)}\n   404→        )\n   405→\n   406→        {:error, reason}\n   407→    end\n   408→  end\n   409→\n   410→  @doc \"\"\"\n   411→  Cleans up expired leases by updating their state to :expired.\n   412→\n   413→  ## Returns\n   414→\n   415→  - `{:ok, count}` - Number of leases expired\n   416→  \"\"\"\n   417→  @spec cleanup_expired() :: {:ok, non_neg_integer()}\n   418→  def cleanup_expired do\n   419→    now = System.system_time(:second)\n   420→\n   421→    transaction = fn ->\n   422→      # Find all active leases that have expired\n   423→      :mnesia.match_object(@table_name, lease_record(state: :active, _: :_), :read)\n   424→      |> Enum.filter(fn record ->\n   425→        lease_record(expires_at: expires_at) = record\n   426→        expires_at <= now\n   427→      end)\n   428→      |> Enum.each(fn record ->\n   429→        updated_record =\n   430→          lease_record(record,\n   431→            state: :expired,\n   432→            updated_at: now\n   433→          )\n   434→\n   435→        :mnesia.write(@table_name, updated_record, :write)\n   436→      end)\n   437→      |> length()\n   438→    end\n   439→\n   440→    case :mnesia.transaction(transaction) do\n   441→      {:atomic, count} ->\n   442→        if count > 0 do\n   443→          :telemetry.execute(\n   444→            [:yellow_dog, :dhcpv4, :lease_storage, :expired],\n   445→            %{count: count},\n   446→            %{}\n   447→          )\n   448→        end\n   449→\n   450→        {:ok, count}\n   451→\n   452→      {:aborted, reason} ->\n   453→        :telemetry.execute(\n   454→          [:yellow_dog, :dhcpv4, :lease_storage, :cleanup_failed],\n   455→          %{count: 1},\n   456→          %{reason: inspect(reason)}\n   457→        )\n   458→\n   459→        {:error, reason}\n   460→    end\n   461→  end\n   462→\n   463→  @doc \"\"\"\n   464→  Gets storage statistics.\n   465→\n   466→  ## Returns\n   467→\n   468→  - Map with statistics\n   469→  \"\"\"\n   470→  @spec stats() :: map()\n   471→  def stats do\n   472→    now = System.system_time(:second)\n   473→    all_leases = list()\n   474→\n   475→    active_leases =\n   476→      Enum.filter(all_leases, fn lease ->\n   477→        lease.state == :active && lease.expires_at > now\n   478→      end)\n   479→\n   480→    expired_leases = Enum.filter(all_leases, fn lease -> lease.expires_at <= now end)\n   481→\n   482→    state_counts =\n   483→      Enum.reduce(all_leases, %{}, fn lease, acc ->\n   484→        Map.update(acc, lease.state, 1, &(&1 + 1))\n   485→      end)\n   486→\n   487→    %{\n   488→      total_leases: length(all_leases),\n   489→      active_leases: length(active_leases),\n   490→      expired_leases: length(expired_leases),\n   491→      by_state: state_counts\n   492→    }\n   493→  end\n   494→\n   495→  @doc \"\"\"\n   496→  Clears all leases from storage.\n   497→\n   498→  WARNING: This is destructive and should only be used for testing or maintenance.\n   499→\n   500→  ## Returns\n   501→\n   502→  - `:ok` - Successfully cleared\n   503→  \"\"\"\n   504→  @spec clear_all() :: :ok\n   505→  def clear_all do\n   506→    transaction = fn ->\n   507→      :mnesia.clear_table(@table_name)\n   508→    end\n   509→\n   510→    case :mnesia.transaction(transaction) do\n   511→      {:atomic, :ok} ->\n   512→        :telemetry.execute(\n   513→          [:yellow_dog, :dhcpv4, :lease_storage, :cleared],\n   514→          %{count: 1},\n   515→          %{}\n   516→        )\n   517→\n   518→        :ok\n   519→\n   520→      {:aborted, reason} ->\n   521→        :telemetry.execute(\n   522→          [:yellow_dog, :dhcpv4, :lease_storage, :clear_failed],\n   523→          %{count: 1},\n   524→          %{reason: inspect(reason)}\n   525→        )\n   526→\n   527→        {:error, reason}\n   528→    end\n   529→  end\n   530→\n   531→  ## Private Functions\n   532→\n   533→  defp ensure_schema_created(nodes) do\n   534→    case :mnesia.create_schema(nodes) do\n   535→      :ok ->\n   536→        :ok\n   537→\n   538→      {:error, {_node, {:already_exists, _}}} ->\n   539→        :ok\n   540→\n   541→      {:error, reason} ->\n   542→        {:error, reason}\n   543→    end\n   544→  end\n   545→\n   546→  defp ensure_table_created(storage_type, nodes) do\n   547→    # Start Mnesia if not already started\n   548→    :mnesia.start()\n   549→\n   550→    table_opts =\n   551→      [\n   552→        attributes: [\n   553→          :mac_address,\n   554→          :ip_address,\n   555→          :pool_name,\n   556→          :state,\n   557→          :lease_time,\n   558→          :expires_at,\n   559→          :hostname,\n   560→          :client_id,\n   561→          :created_at,\n   562→          :updated_at\n   563→        ],\n   564→        record_name: :lease_record,\n   565→        type: :set,\n   566→        index: [:ip_address, :state, :pool_name]\n   567→      ] ++ [{storage_type, nodes}]\n   568→\n   569→    case :mnesia.create_table(@table_name, table_opts) do\n   570→      {:atomic, :ok} ->\n   571→        :ok\n   572→\n   573→      {:aborted, {:already_exists, @table_name}} ->\n   574→        # Table exists, ensure it has the right properties\n   575→        ensure_indices()\n   576→        :ok\n   577→\n   578→      {:aborted, reason} ->\n   579→        {:error, reason}\n   580→    end\n   581→  end\n   582→\n   583→  defp ensure_indices do\n   584→    # Ensure secondary indices exist\n   585→    existing_indices = :mnesia.table_info(@table_name, :index)\n   586→\n   587→    [:ip_address, :state, :pool_name]\n   588→    |> Enum.reject(&(&1 in existing_indices))\n   589→    |> Enum.each(fn attr ->\n   590→      case :mnesia.add_table_index(@table_name, attr) do\n   591→        {:atomic, :ok} ->\n   592→          :telemetry.execute(\n   593→            [:yellow_dog, :dhcpv4, :lease_storage, :index_added],\n   594→            %{count: 1},\n   595→            %{attribute: attr}\n   596→          )\n   597→\n   598→        {:aborted, {:already_exists, @table_name, _}} ->\n   599→          :ok\n   600→\n   601→        {:aborted, reason} ->\n   602→          :telemetry.execute(\n   603→            [:yellow_dog, :dhcpv4, :lease_storage, :index_failed],\n   604→            %{count: 1},\n   605→            %{attribute: attr, reason: inspect(reason)}\n   606→          )\n   607→      end\n   608→    end)\n   609→  end\n   610→\n   611→  defp record_to_map(record) do\n   612→    lease_record(\n   613→      mac_address: mac,\n   614→      ip_address: ip,\n   615→      pool_name: pool,\n   616→      state: state,\n   617→      lease_time: lease_time,\n   618→      expires_at: expires_at,\n   619→      hostname: hostname,\n   620→      client_id: client_id,\n   621→      created_at: created_at,\n   622→      updated_at: updated_at\n   623→    ) = record\n   624→\n   625→    %{\n   626→      mac_address: mac,\n   627→      ip_address: ip,\n   628→      pool_name: pool,\n   629→      state: state,\n   630→      lease_time: lease_time,\n   631→      expires_at: expires_at,\n   632→      hostname: hostname,\n   633→      client_id: client_id,\n   634→      created_at: created_at,\n   635→      updated_at: updated_at\n   636→    }\n   637→  end\n   638→end\n   639→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb21cfce-0067-4926-ae35-eac907707d9d","uuid":"875b9362-f48e-42d8-ad91-f3cebb6368bf","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_storage.ex","content":"defmodule YellowDog.Dhcpv4.LeaseStorage do\n  @moduledoc \"\"\"\n  Persistent lease storage using Mnesia.\n\n  Provides a durable, transactional storage layer for DHCP leases with\n  support for multiple lease states and comprehensive querying.\n\n  ## Lease States\n\n  - `:offered` - IP address offered to client, awaiting REQUEST\n  - `:active` - Lease active and in use by client\n  - `:released` - Client released the lease voluntarily\n  - `:expired` - Lease exceeded its lifetime\n  - `:declined` - Client declined the offered IP (conflict detected)\n\n  ## Storage Modes\n\n  - `:disc_copies` - Persistent storage (default for production)\n  - `:ram_copies` - Memory-only storage (for testing)\n  \"\"\"\n\n  require Record\n\n  alias YellowDog.Dhcpv4.AddressPool\n\n  @type ip_address :: AddressPool.ip_address()\n  @type mac_address :: binary()\n  @type client_id :: binary() | nil\n  @type lease_state :: :offered | :active | :released | :expired | :declined\n\n  @type lease :: %{\n          mac_address: mac_address(),\n          ip_address: ip_address(),\n          pool_name: String.t(),\n          state: lease_state(),\n          lease_time: pos_integer(),\n          expires_at: integer(),\n          hostname: String.t() | nil,\n          client_id: client_id(),\n          created_at: integer(),\n          updated_at: integer()\n        }\n\n  # Define Mnesia record\n  Record.defrecord(:lease_record,\n    mac_address: nil,\n    ip_address: nil,\n    pool_name: nil,\n    state: :offered,\n    lease_time: 0,\n    expires_at: 0,\n    hostname: nil,\n    client_id: nil,\n    created_at: 0,\n    updated_at: 0\n  )\n\n  @table_name :dhcpv4_leases\n\n  ## Public API\n\n  @doc \"\"\"\n  Initializes the Mnesia schema and creates the leases table.\n\n  ## Options\n\n  - `:storage_type` - `:disc_copies` (default) or `:ram_copies`\n  - `:nodes` - List of nodes to create table on (default: [node()])\n\n  ## Returns\n\n  - `:ok` - Successfully initialized\n  - `{:error, reason}` - Failed to initialize\n  \"\"\"\n  @spec init(keyword()) :: :ok | {:error, term()}\n  def init(opts \\\\ []) do\n    storage_type = Keyword.get(opts, :storage_type, :disc_copies)\n    nodes = Keyword.get(opts, :nodes, [node()])\n\n    with :ok <- ensure_schema_created(nodes),\n         :ok <- ensure_table_created(storage_type, nodes) do\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :lease_storage, :initialized],\n        %{count: 1},\n        %{storage_type: storage_type, nodes: nodes}\n      )\n\n      :ok\n    else\n      {:error, reason} = error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :init_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Stores or updates a lease in the database.\n\n  ## Parameters\n\n  - `lease` - Lease map with required fields\n\n  ## Returns\n\n  - `{:ok, lease}` - Successfully stored\n  - `{:error, reason}` - Failed to store\n  \"\"\"\n  @spec put(lease()) :: {:ok, lease()} | {:error, term()}\n  def put(lease) do\n    now = System.system_time(:second)\n\n    record =\n      lease_record(\n        mac_address: lease.mac_address,\n        ip_address: lease.ip_address,\n        pool_name: lease.pool_name,\n        state: lease.state,\n        lease_time: lease.lease_time,\n        expires_at: lease.expires_at,\n        hostname: lease[:hostname],\n        client_id: lease[:client_id],\n        created_at: lease[:created_at] || now,\n        updated_at: now\n      )\n\n    transaction = fn ->\n      :mnesia.write(@table_name, record, :write)\n      record_to_map(record)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, result} ->\n        {:ok, result}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :store_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Retrieves a lease by MAC address.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n\n  ## Returns\n\n  - `{:ok, lease}` - Lease found\n  - `{:error, :not_found}` - No lease exists\n  \"\"\"\n  @spec get(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get(mac_address) do\n    transaction = fn ->\n      case :mnesia.read(@table_name, mac_address) do\n        [record] -> record_to_map(record)\n        [] -> nil\n      end\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, nil} ->\n        {:error, :not_found}\n\n      {:atomic, lease} ->\n        {:ok, lease}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :read_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Retrieves a lease by IP address.\n\n  ## Parameters\n\n  - `ip_address` - IP address tuple\n\n  ## Returns\n\n  - `{:ok, lease}` - Lease found\n  - `{:error, :not_found}` - No lease exists\n  \"\"\"\n  @spec get_by_ip(ip_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get_by_ip(ip_address) do\n    transaction = fn ->\n      :mnesia.match_object(@table_name, lease_record(ip_address: ip_address, _: :_), :read)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, [record]} ->\n        {:ok, record_to_map(record)}\n\n      {:atomic, []} ->\n        {:error, :not_found}\n\n      {:atomic, _multiple} ->\n        # This shouldn't happen - IP should be unique\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :multiple_found],\n          %{count: 1},\n          %{ip_address: ip_address}\n        )\n\n        {:error, :multiple_found}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :read_by_ip_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Deletes a lease by MAC address.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n\n  ## Returns\n\n  - `:ok` - Successfully deleted or didn't exist\n  \"\"\"\n  @spec delete(mac_address()) :: :ok\n  def delete(mac_address) do\n    transaction = fn ->\n      :mnesia.delete(@table_name, mac_address, :write)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, :ok} ->\n        :ok\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :delete_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Lists all leases with optional filtering.\n\n  ## Options\n\n  - `:state` - Filter by state (e.g., :active, :expired)\n  - `:pool_name` - Filter by pool name\n  - `:active_only` - Only return non-expired leases (default: false)\n\n  ## Returns\n\n  - List of leases\n  \"\"\"\n  @spec list(keyword()) :: [lease()]\n  def list(opts \\\\ []) do\n    state_filter = Keyword.get(opts, :state)\n    pool_filter = Keyword.get(opts, :pool_name)\n    active_only = Keyword.get(opts, :active_only, false)\n    now = System.system_time(:second)\n\n    transaction = fn ->\n      pattern =\n        cond do\n          state_filter && pool_filter ->\n            lease_record(state: state_filter, pool_name: pool_filter, _: :_)\n\n          state_filter ->\n            lease_record(state: state_filter, _: :_)\n\n          pool_filter ->\n            lease_record(pool_name: pool_filter, _: :_)\n\n          true ->\n            lease_record(_: :_)\n        end\n\n      :mnesia.match_object(@table_name, pattern, :read)\n      |> Enum.map(&record_to_map/1)\n      |> then(fn leases ->\n        if active_only do\n          Enum.filter(leases, fn lease ->\n            lease.state == :active && lease.expires_at > now\n          end)\n        else\n          leases\n        end\n      end)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, leases} ->\n        leases\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :list_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        []\n    end\n  end\n\n  @doc \"\"\"\n  Gets all active (non-expired) leases.\n\n  ## Returns\n\n  - List of active leases\n  \"\"\"\n  @spec list_active() :: [lease()]\n  def list_active do\n    list(active_only: true)\n  end\n\n  @doc \"\"\"\n  Gets all allocated IP addresses for active leases.\n\n  ## Returns\n\n  - MapSet of IP addresses\n  \"\"\"\n  @spec get_allocated_ips() :: MapSet.t(ip_address())\n  def get_allocated_ips do\n    list_active()\n    |> Enum.map(& &1.ip_address)\n    |> MapSet.new()\n  end\n\n  @doc \"\"\"\n  Updates the state of a lease.\n\n  ## Parameters\n\n  - `mac_address` - Client MAC address\n  - `new_state` - New lease state\n\n  ## Returns\n\n  - `{:ok, lease}` - Successfully updated\n  - `{:error, reason}` - Failed to update\n  \"\"\"\n  @spec update_state(mac_address(), lease_state()) :: {:ok, lease()} | {:error, term()}\n  def update_state(mac_address, new_state) do\n    transaction = fn ->\n      case :mnesia.read(@table_name, mac_address) do\n        [record] ->\n          now = System.system_time(:second)\n\n          updated_record =\n            lease_record(record,\n              state: new_state,\n              updated_at: now\n            )\n\n          :mnesia.write(@table_name, updated_record, :write)\n          record_to_map(updated_record)\n\n        [] ->\n          nil\n      end\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, nil} ->\n        {:error, :not_found}\n\n      {:atomic, lease} ->\n        {:ok, lease}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :update_state_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Cleans up expired leases by updating their state to :expired.\n\n  ## Returns\n\n  - `{:ok, count}` - Number of leases expired\n  \"\"\"\n  @spec cleanup_expired() :: {:ok, non_neg_integer()}\n  def cleanup_expired do\n    now = System.system_time(:second)\n\n    transaction = fn ->\n      # Find all active leases that have expired\n      :mnesia.match_object(@table_name, lease_record(state: :active, _: :_), :read)\n      |> Enum.filter(fn record ->\n        lease_record(expires_at: expires_at) = record\n        expires_at <= now\n      end)\n      |> Enum.each(fn record ->\n        updated_record =\n          lease_record(record,\n            state: :expired,\n            updated_at: now\n          )\n\n        :mnesia.write(@table_name, updated_record, :write)\n      end)\n      |> length()\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, count} ->\n        if count > 0 do\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :expired],\n            %{count: count},\n            %{}\n          )\n        end\n\n        {:ok, count}\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :cleanup_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Gets storage statistics.\n\n  ## Returns\n\n  - Map with statistics\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    now = System.system_time(:second)\n    all_leases = list()\n\n    active_leases =\n      Enum.filter(all_leases, fn lease ->\n        lease.state == :active && lease.expires_at > now\n      end)\n\n    expired_leases = Enum.filter(all_leases, fn lease -> lease.expires_at <= now end)\n\n    state_counts =\n      Enum.reduce(all_leases, %{}, fn lease, acc ->\n        Map.update(acc, lease.state, 1, &(&1 + 1))\n      end)\n\n    %{\n      total_leases: length(all_leases),\n      active_leases: length(active_leases),\n      expired_leases: length(expired_leases),\n      by_state: state_counts\n    }\n  end\n\n  @doc \"\"\"\n  Clears all leases from storage.\n\n  WARNING: This is destructive and should only be used for testing or maintenance.\n\n  ## Returns\n\n  - `:ok` - Successfully cleared\n  \"\"\"\n  @spec clear_all() :: :ok\n  def clear_all do\n    transaction = fn ->\n      :mnesia.clear_table(@table_name)\n    end\n\n    case :mnesia.transaction(transaction) do\n      {:atomic, :ok} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :cleared],\n          %{count: 1},\n          %{}\n        )\n\n        :ok\n\n      {:aborted, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease_storage, :clear_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:error, reason}\n    end\n  end\n\n  ## Private Functions\n\n  defp ensure_schema_created(nodes) do\n    case :mnesia.create_schema(nodes) do\n      :ok ->\n        :ok\n\n      {:error, {_node, {:already_exists, _}}} ->\n        :ok\n\n      {:error, reason} ->\n        {:error, reason}\n    end\n  end\n\n  defp ensure_table_created(storage_type, nodes) do\n    # Start Mnesia if not already started\n    :mnesia.start()\n\n    table_opts =\n      [\n        attributes: [\n          :mac_address,\n          :ip_address,\n          :pool_name,\n          :state,\n          :lease_time,\n          :expires_at,\n          :hostname,\n          :client_id,\n          :created_at,\n          :updated_at\n        ],\n        record_name: :lease_record,\n        type: :set,\n        index: [:ip_address, :state, :pool_name]\n      ] ++ [{storage_type, nodes}]\n\n    case :mnesia.create_table(@table_name, table_opts) do\n      {:atomic, :ok} ->\n        :ok\n\n      {:aborted, {:already_exists, @table_name}} ->\n        # Table exists, ensure it has the right properties\n        ensure_indices()\n        :ok\n\n      {:aborted, reason} ->\n        {:error, reason}\n    end\n  end\n\n  defp ensure_indices do\n    # Ensure secondary indices exist\n    existing_indices = :mnesia.table_info(@table_name, :index)\n\n    [:ip_address, :state, :pool_name]\n    |> Enum.reject(&(&1 in existing_indices))\n    |> Enum.each(fn attr ->\n      case :mnesia.add_table_index(@table_name, attr) do\n        {:atomic, :ok} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :index_added],\n            %{count: 1},\n            %{attribute: attr}\n          )\n\n        {:aborted, {:already_exists, @table_name, _}} ->\n          :ok\n\n        {:aborted, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease_storage, :index_failed],\n            %{count: 1},\n            %{attribute: attr, reason: inspect(reason)}\n          )\n      end\n    end)\n  end\n\n  defp record_to_map(record) do\n    lease_record(\n      mac_address: mac,\n      ip_address: ip,\n      pool_name: pool,\n      state: state,\n      lease_time: lease_time,\n      expires_at: expires_at,\n      hostname: hostname,\n      client_id: client_id,\n      created_at: created_at,\n      updated_at: updated_at\n    ) = record\n\n    %{\n      mac_address: mac,\n      ip_address: ip,\n      pool_name: pool,\n      state: state,\n      lease_time: lease_time,\n      expires_at: expires_at,\n      hostname: hostname,\n      client_id: client_id,\n      created_at: created_at,\n      updated_at: updated_at\n    }\n  end\nend\n","numLines":639,"startLine":1,"totalLines":639}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TkdpspNwoeauxzHBtmj1eP","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.ServiceStore do\n     2→  @moduledoc \"\"\"\n     3→  Persistence layer for mDNS service definitions.\n     4→\n     5→  Handles loading and saving service configurations from/to TOML or JSON files.\n     6→  Supports file watching for hot-reload and atomic writes with backup.\n     7→  \"\"\"\n     8→\n     9→  @type service_def :: %{\n    10→          name: String.t(),\n    11→          type: String.t(),\n    12→          port: pos_integer(),\n    13→          host: String.t() | nil,\n    14→          txt: map() | nil,\n    15→          addresses: [String.t()] | nil,\n    16→          enabled: boolean()\n    17→        }\n    18→\n    19→  @type format :: :toml | :json\n    20→\n    21→  @doc \"\"\"\n    22→  Loads services from a file.\n    23→\n    24→  Supports both TOML and JSON formats, auto-detecting based on file extension\n    25→  or using the provided format parameter.\n    26→\n    27→  ## Parameters\n    28→  - `file_path` - Path to the services file\n    29→  - `opts` - Options\n    30→    - `:format` - Force format (:toml or :json), defaults to auto-detect\n    31→\n    32→  ## Returns\n    33→  - `{:ok, [service_def]}` on success\n    34→  - `{:error, reason}` on failure\n    35→\n    36→  ## Examples\n    37→      iex> YellowDog.Mdns.ServiceStore.load_services(\"/path/to/services.toml\")\n    38→      {:ok, [%{name: \"Web Server\", type: \"_http._tcp\", port: 8080, ...}]}\n    39→  \"\"\"\n    40→  @spec load_services(String.t(), keyword()) :: {:ok, [service_def()]} | {:error, term()}\n    41→  def load_services(file_path, opts \\\\ []) do\n    42→    with {:ok, content} <- File.read(file_path),\n    43→         format <- determine_format(file_path, opts),\n    44→         {:ok, raw_data} <- parse_content(content, format),\n    45→         {:ok, services} <- extract_services(raw_data, format) do\n    46→      validated_services =\n    47→        services\n    48→        |> Enum.map(&validate_and_normalize_service/1)\n    49→        |> Enum.reject(&match?({:error, _}, &1))\n    50→        |> Enum.map(fn {:ok, service} -> service end)\n    51→\n    52→      :telemetry.execute(\n    53→        [:yellow_dog, :mdns, :service_store, :loaded],\n    54→        %{service_count: length(validated_services)},\n    55→        %{file_path: file_path}\n    56→      )\n    57→\n    58→      {:ok, validated_services}\n    59→    else\n    60→      {:error, :enoent} ->\n    61→        :telemetry.execute(\n    62→          [:yellow_dog, :mdns, :service_store, :file_not_found],\n    63→          %{count: 1},\n    64→          %{file_path: file_path}\n    65→        )\n    66→\n    67→        {:ok, []}\n    68→\n    69→      {:error, reason} = error ->\n    70→        :telemetry.execute(\n    71→          [:yellow_dog, :mdns, :service_store, :load_failed],\n    72→          %{count: 1},\n    73→          %{file_path: file_path, reason: inspect(reason)}\n    74→        )\n    75→\n    76→        error\n    77→    end\n    78→  end\n    79→\n    80→  @doc \"\"\"\n    81→  Saves services to a file.\n    82→\n    83→  Performs atomic write by writing to a temporary file first, then renaming.\n    84→  Creates a backup of the existing file if it exists.\n    85→\n    86→  ## Parameters\n    87→  - `file_path` - Path to save the services file\n    88→  - `services` - List of service definitions\n    89→  - `opts` - Options\n    90→    - `:format` - Format to use (:toml or :json), defaults to auto-detect\n    91→    - `:backup` - Create backup before overwriting (default: true)\n    92→\n    93→  ## Returns\n    94→  - `:ok` on success\n    95→  - `{:error, reason}` on failure\n    96→  \"\"\"\n    97→  @spec save_services(String.t(), [service_def()], keyword()) :: :ok | {:error, term()}\n    98→  def save_services(file_path, services, opts \\\\ []) do\n    99→    format = determine_format(file_path, opts)\n   100→    create_backup? = Keyword.get(opts, :backup, true)\n   101→\n   102→    with {:ok, content} <- format_services(services, format),\n   103→         :ok <- ensure_directory(file_path),\n   104→         :ok <- maybe_create_backup(file_path, create_backup?),\n   105→         :ok <- atomic_write(file_path, content) do\n   106→      :telemetry.execute(\n   107→        [:yellow_dog, :mdns, :service_store, :saved],\n   108→        %{service_count: length(services)},\n   109→        %{file_path: file_path}\n   110→      )\n   111→\n   112→      :ok\n   113→    else\n   114→      {:error, reason} = error ->\n   115→        :telemetry.execute(\n   116→          [:yellow_dog, :mdns, :service_store, :save_failed],\n   117→          %{count: 1},\n   118→          %{file_path: file_path, reason: inspect(reason)}\n   119→        )\n   120→\n   121→        error\n   122→    end\n   123→  end\n   124→\n   125→  @doc \"\"\"\n   126→  Validates a service definition.\n   127→\n   128→  ## Parameters\n   129→  - `service` - Service definition map\n   130→\n   131→  ## Returns\n   132→  - `:ok` if valid\n   133→  - `{:error, reason}` if invalid\n   134→  \"\"\"\n   135→  @spec validate_service(map()) :: :ok | {:error, String.t()}\n   136→  def validate_service(service) do\n   137→    with :ok <- validate_required_fields(service),\n   138→         :ok <- validate_name(service.name),\n   139→         :ok <- validate_type(service.type),\n   140→         :ok <- validate_port(service.port),\n   141→         :ok <- validate_addresses(Map.get(service, :addresses)),\n   142→         :ok <- validate_txt_records(Map.get(service, :txt)) do\n   143→      :ok\n   144→    end\n   145→  end\n   146→\n   147→  # Private functions\n   148→\n   149→  defp determine_format(file_path, opts) do\n   150→    case Keyword.get(opts, :format) do\n   151→      format when format in [:toml, :json] ->\n   152→        format\n   153→\n   154→      nil ->\n   155→        case Path.extname(file_path) do\n   156→          \".toml\" -> :toml\n   157→          \".json\" -> :json\n   158→          _ -> :toml\n   159→        end\n   160→    end\n   161→  end\n   162→\n   163→  defp parse_content(content, :toml) do\n   164→    case Toml.decode(content) do\n   165→      {:ok, data} -> {:ok, data}\n   166→      {:error, reason} -> {:error, {:toml_parse_error, reason}}\n   167→    end\n   168→  end\n   169→\n   170→  defp parse_content(content, :json) do\n   171→    case Jason.decode(content, keys: :atoms) do\n   172→      {:ok, data} -> {:ok, data}\n   173→      {:error, reason} -> {:error, {:json_parse_error, reason}}\n   174→    end\n   175→  end\n   176→\n   177→  defp extract_services(data, :toml) do\n   178→    case Map.get(data, \"service\") do\n   179→      nil -> {:ok, []}\n   180→      services when is_list(services) -> {:ok, services}\n   181→      service when is_map(service) -> {:ok, [service]}\n   182→    end\n   183→  end\n   184→\n   185→  defp extract_services(data, :json) do\n   186→    case Map.get(data, :services) do\n   187→      nil -> {:ok, []}\n   188→      services when is_list(services) -> {:ok, services}\n   189→      _ -> {:error, :invalid_json_structure}\n   190→    end\n   191→  end\n   192→\n   193→  defp validate_and_normalize_service(service) do\n   194→    normalized = normalize_service_keys(service)\n   195→\n   196→    case validate_service(normalized) do\n   197→      :ok -> {:ok, normalized}\n   198→      {:error, reason} -> {:error, reason}\n   199→    end\n   200→  end\n   201→\n   202→  defp normalize_service_keys(service) when is_map(service) do\n   203→    %{\n   204→      name: get_string_value(service, [:name, \"name\"]),\n   205→      type: get_string_value(service, [:type, \"type\"]),\n   206→      port: get_integer_value(service, [:port, \"port\"]),\n   207→      host: get_string_value(service, [:host, \"host\"]),\n   208→      txt: get_map_value(service, [:txt, \"txt\"]),\n   209→      addresses: get_addresses(service),\n   210→      enabled: get_boolean_value(service, [:enabled, \"enabled\"], true)\n   211→    }\n   212→  end\n   213→\n   214→  defp get_string_value(map, keys, default \\\\ nil) do\n   215→    Enum.find_value(keys, default, fn key -> Map.get(map, key) end)\n   216→  end\n   217→\n   218→  defp get_integer_value(map, keys, default \\\\ nil) do\n   219→    case Enum.find_value(keys, default, fn key -> Map.get(map, key) end) do\n   220→      value when is_integer(value) -> value\n   221→      value when is_binary(value) -> String.to_integer(value)\n   222→      _ -> default\n   223→    end\n   224→  end\n   225→\n   226→  defp get_boolean_value(map, keys, default) do\n   227→    case Enum.find_value(keys, default, fn key -> Map.get(map, key) end) do\n   228→      value when is_boolean(value) -> value\n   229→      \"true\" -> true\n   230→      \"false\" -> false\n   231→      _ -> default\n   232→    end\n   233→  end\n   234→\n   235→  defp get_map_value(map, keys) do\n   236→    case Enum.find_value(keys, fn key -> Map.get(map, key) end) do\n   237→      value when is_map(value) -> value\n   238→      _ -> %{}\n   239→    end\n   240→  end\n   241→\n   242→  defp get_addresses(service) do\n   243→    # Try different key formats\n   244→    case Map.get(service, :addresses) || Map.get(service, \"addresses\") do\n   245→      nil -> []\n   246→      addresses when is_list(addresses) -> addresses\n   247→      addresses when is_map(addresses) -> flatten_addresses(addresses)\n   248→      _ -> []\n   249→    end\n   250→  end\n   251→\n   252→  defp flatten_addresses(addresses_map) when is_map(addresses_map) do\n   253→    # Handle nested structure like %{ipv4: [...], ipv6: [...]}\n   254→    ipv4 = Map.get(addresses_map, :ipv4) || Map.get(addresses_map, \"ipv4\") || []\n   255→    ipv6 = Map.get(addresses_map, :ipv6) || Map.get(addresses_map, \"ipv6\") || []\n   256→\n   257→    ipv4 ++ ipv6\n   258→  end\n   259→\n   260→  defp validate_required_fields(service) do\n   261→    required = [:name, :type, :port]\n   262→\n   263→    missing =\n   264→      Enum.filter(required, fn field ->\n   265→        is_nil(Map.get(service, field))\n   266→      end)\n   267→\n   268→    if Enum.empty?(missing) do\n   269→      :ok\n   270→    else\n   271→      {:error, \"Missing required fields: #{Enum.join(missing, \", \")}\"}\n   272→    end\n   273→  end\n   274→\n   275→  defp validate_name(name) when is_binary(name) and byte_size(name) > 0, do: :ok\n   276→  defp validate_name(_), do: {:error, \"Invalid name\"}\n   277→\n   278→  defp validate_type(type) when is_binary(type) do\n   279→    if String.starts_with?(type, \"_\") or String.contains?(type, \"._\") do\n   280→      :ok\n   281→    else\n   282→      {:error, \"Service type must start with _ or contain ._ (e.g., _http._tcp)\"}\n   283→    end\n   284→  end\n   285→\n   286→  defp validate_type(_), do: {:error, \"Invalid type\"}\n   287→\n   288→  defp validate_port(port) when is_integer(port) and port > 0 and port < 65536, do: :ok\n   289→  defp validate_port(_), do: {:error, \"Port must be between 1 and 65535\"}\n   290→\n   291→  defp validate_addresses(nil), do: :ok\n   292→  defp validate_addresses([]), do: :ok\n   293→\n   294→  defp validate_addresses(addresses) when is_list(addresses) do\n   295→    invalid =\n   296→      Enum.reject(addresses, fn addr ->\n   297→        is_binary(addr) and (valid_ipv4?(addr) or valid_ipv6?(addr))\n   298→      end)\n   299→\n   300→    if Enum.empty?(invalid) do\n   301→      :ok\n   302→    else\n   303→      {:error, \"Invalid IP addresses: #{inspect(invalid)}\"}\n   304→    end\n   305→  end\n   306→\n   307→  defp validate_addresses(_), do: {:error, \"Addresses must be a list\"}\n   308→\n   309→  defp validate_txt_records(nil), do: :ok\n   310→  defp validate_txt_records(txt) when is_map(txt), do: :ok\n   311→  defp validate_txt_records(_), do: {:error, \"TXT records must be a map\"}\n   312→\n   313→  defp valid_ipv4?(addr) do\n   314→    case :inet.parse_address(String.to_charlist(addr)) do\n   315→      {:ok, {_, _, _, _}} -> true\n   316→      _ -> false\n   317→    end\n   318→  end\n   319→\n   320→  defp valid_ipv6?(addr) do\n   321→    case :inet.parse_address(String.to_charlist(addr)) do\n   322→      {:ok, {_, _, _, _, _, _, _, _}} -> true\n   323→      _ -> false\n   324→    end\n   325→  end\n   326→\n   327→  defp format_services(services, :toml) do\n   328→    # The toml library (v0.7) is decode-only, so we implement basic TOML encoding\n   329→    # for the limited structure we need (array of tables)\n   330→    toml_content =\n   331→      services\n   332→      |> Enum.map(&service_to_toml/1)\n   333→      |> Enum.join(\"\\n\")\n   334→\n   335→    {:ok, toml_content}\n   336→  end\n   337→\n   338→  defp format_services(services, :json) do\n   339→    json_data = %{services: services}\n   340→\n   341→    case Jason.encode(json_data, pretty: true) do\n   342→      {:ok, content} -> {:ok, content}\n   343→      error -> error\n   344→    end\n   345→  end\n   346→\n   347→  defp service_to_toml(service) do\n   348→    lines = [\n   349→      \"[[service]]\",\n   350→      \"name = #{encode_toml_string(service.name)}\",\n   351→      \"type = #{encode_toml_string(service.type)}\",\n   352→      \"port = #{service.port}\",\n   353→      \"enabled = #{service[:enabled] || true}\"\n   354→    ]\n   355→\n   356→    lines =\n   357→      if service[:host] do\n   358→        lines ++ [\"host = #{encode_toml_string(service.host)}\"]\n   359→      else\n   360→        lines\n   361→      end\n   362→\n   363→    lines =\n   364→      if service[:txt] && map_size(service.txt) > 0 do\n   365→        txt_lines =\n   366→          [\"\", \"  [service.txt]\"] ++\n   367→            Enum.map(service.txt, fn {k, v} ->\n   368→              \"  #{k} = #{encode_toml_string(v)}\"\n   369→            end)\n   370→\n   371→        lines ++ txt_lines\n   372→      else\n   373→        lines\n   374→      end\n   375→\n   376→    lines =\n   377→      if service[:addresses] && length(service.addresses) > 0 do\n   378→        ipv4 = Enum.filter(service.addresses, &valid_ipv4?/1)\n   379→        ipv6 = Enum.filter(service.addresses, &valid_ipv6?/1)\n   380→\n   381→        addr_lines = []\n   382→\n   383→        addr_lines =\n   384→          if Enum.any?(ipv4) || Enum.any?(ipv6),\n   385→            do: addr_lines ++ [\"\", \"  [service.addresses]\"],\n   386→            else: addr_lines\n   387→\n   388→        addr_lines =\n   389→          if Enum.any?(ipv4),\n   390→            do: addr_lines ++ [\"  ipv4 = [#{Enum.map_join(ipv4, \", \", &encode_toml_string/1)}]\"],\n   391→            else: addr_lines\n   392→\n   393→        addr_lines =\n   394→          if Enum.any?(ipv6),\n   395→            do: addr_lines ++ [\"  ipv6 = [#{Enum.map_join(ipv6, \", \", &encode_toml_string/1)}]\"],\n   396→            else: addr_lines\n   397→\n   398→        lines ++ addr_lines\n   399→      else\n   400→        lines\n   401→      end\n   402→\n   403→    Enum.join(lines, \"\\n\")\n   404→  end\n   405→\n   406→  defp encode_toml_string(value) when is_binary(value) do\n   407→    \"\\\"#{String.replace(value, \"\\\"\", \"\\\\\\\"\")}\\\"\"\n   408→  end\n   409→\n   410→  defp encode_toml_string(value), do: inspect(value)\n   411→\n   412→  defp ensure_directory(file_path) do\n   413→    dir = Path.dirname(file_path)\n   414→\n   415→    case File.mkdir_p(dir) do\n   416→      :ok -> :ok\n   417→      error -> error\n   418→    end\n   419→  end\n   420→\n   421→  defp maybe_create_backup(_file_path, false), do: :ok\n   422→\n   423→  defp maybe_create_backup(file_path, true) do\n   424→    if File.exists?(file_path) do\n   425→      backup_path = file_path <> \".backup\"\n   426→      File.cp(file_path, backup_path)\n   427→    else\n   428→      :ok\n   429→    end\n   430→  end\n   431→\n   432→  defp atomic_write(file_path, content) do\n   433→    tmp_path = file_path <> \".tmp\"\n   434→\n   435→    with :ok <- File.write(tmp_path, content),\n   436→         :ok <- File.rename(tmp_path, file_path) do\n   437→      :ok\n   438→    else\n   439→      error ->\n   440→        # Clean up temp file on error\n   441→        File.rm(tmp_path)\n   442→        error\n   443→    end\n   444→  end\n   445→end\n   446→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb21cfce-0067-4926-ae35-eac907707d9d","uuid":"faa70367-4b43-4005-bae1-61241ddb567b","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/lib/yellow_dog/mdns/service_store.ex","content":"defmodule YellowDog.Mdns.ServiceStore do\n  @moduledoc \"\"\"\n  Persistence layer for mDNS service definitions.\n\n  Handles loading and saving service configurations from/to TOML or JSON files.\n  Supports file watching for hot-reload and atomic writes with backup.\n  \"\"\"\n\n  @type service_def :: %{\n          name: String.t(),\n          type: String.t(),\n          port: pos_integer(),\n          host: String.t() | nil,\n          txt: map() | nil,\n          addresses: [String.t()] | nil,\n          enabled: boolean()\n        }\n\n  @type format :: :toml | :json\n\n  @doc \"\"\"\n  Loads services from a file.\n\n  Supports both TOML and JSON formats, auto-detecting based on file extension\n  or using the provided format parameter.\n\n  ## Parameters\n  - `file_path` - Path to the services file\n  - `opts` - Options\n    - `:format` - Force format (:toml or :json), defaults to auto-detect\n\n  ## Returns\n  - `{:ok, [service_def]}` on success\n  - `{:error, reason}` on failure\n\n  ## Examples\n      iex> YellowDog.Mdns.ServiceStore.load_services(\"/path/to/services.toml\")\n      {:ok, [%{name: \"Web Server\", type: \"_http._tcp\", port: 8080, ...}]}\n  \"\"\"\n  @spec load_services(String.t(), keyword()) :: {:ok, [service_def()]} | {:error, term()}\n  def load_services(file_path, opts \\\\ []) do\n    with {:ok, content} <- File.read(file_path),\n         format <- determine_format(file_path, opts),\n         {:ok, raw_data} <- parse_content(content, format),\n         {:ok, services} <- extract_services(raw_data, format) do\n      validated_services =\n        services\n        |> Enum.map(&validate_and_normalize_service/1)\n        |> Enum.reject(&match?({:error, _}, &1))\n        |> Enum.map(fn {:ok, service} -> service end)\n\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :service_store, :loaded],\n        %{service_count: length(validated_services)},\n        %{file_path: file_path}\n      )\n\n      {:ok, validated_services}\n    else\n      {:error, :enoent} ->\n        :telemetry.execute(\n          [:yellow_dog, :mdns, :service_store, :file_not_found],\n          %{count: 1},\n          %{file_path: file_path}\n        )\n\n        {:ok, []}\n\n      {:error, reason} = error ->\n        :telemetry.execute(\n          [:yellow_dog, :mdns, :service_store, :load_failed],\n          %{count: 1},\n          %{file_path: file_path, reason: inspect(reason)}\n        )\n\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Saves services to a file.\n\n  Performs atomic write by writing to a temporary file first, then renaming.\n  Creates a backup of the existing file if it exists.\n\n  ## Parameters\n  - `file_path` - Path to save the services file\n  - `services` - List of service definitions\n  - `opts` - Options\n    - `:format` - Format to use (:toml or :json), defaults to auto-detect\n    - `:backup` - Create backup before overwriting (default: true)\n\n  ## Returns\n  - `:ok` on success\n  - `{:error, reason}` on failure\n  \"\"\"\n  @spec save_services(String.t(), [service_def()], keyword()) :: :ok | {:error, term()}\n  def save_services(file_path, services, opts \\\\ []) do\n    format = determine_format(file_path, opts)\n    create_backup? = Keyword.get(opts, :backup, true)\n\n    with {:ok, content} <- format_services(services, format),\n         :ok <- ensure_directory(file_path),\n         :ok <- maybe_create_backup(file_path, create_backup?),\n         :ok <- atomic_write(file_path, content) do\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :service_store, :saved],\n        %{service_count: length(services)},\n        %{file_path: file_path}\n      )\n\n      :ok\n    else\n      {:error, reason} = error ->\n        :telemetry.execute(\n          [:yellow_dog, :mdns, :service_store, :save_failed],\n          %{count: 1},\n          %{file_path: file_path, reason: inspect(reason)}\n        )\n\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Validates a service definition.\n\n  ## Parameters\n  - `service` - Service definition map\n\n  ## Returns\n  - `:ok` if valid\n  - `{:error, reason}` if invalid\n  \"\"\"\n  @spec validate_service(map()) :: :ok | {:error, String.t()}\n  def validate_service(service) do\n    with :ok <- validate_required_fields(service),\n         :ok <- validate_name(service.name),\n         :ok <- validate_type(service.type),\n         :ok <- validate_port(service.port),\n         :ok <- validate_addresses(Map.get(service, :addresses)),\n         :ok <- validate_txt_records(Map.get(service, :txt)) do\n      :ok\n    end\n  end\n\n  # Private functions\n\n  defp determine_format(file_path, opts) do\n    case Keyword.get(opts, :format) do\n      format when format in [:toml, :json] ->\n        format\n\n      nil ->\n        case Path.extname(file_path) do\n          \".toml\" -> :toml\n          \".json\" -> :json\n          _ -> :toml\n        end\n    end\n  end\n\n  defp parse_content(content, :toml) do\n    case Toml.decode(content) do\n      {:ok, data} -> {:ok, data}\n      {:error, reason} -> {:error, {:toml_parse_error, reason}}\n    end\n  end\n\n  defp parse_content(content, :json) do\n    case Jason.decode(content, keys: :atoms) do\n      {:ok, data} -> {:ok, data}\n      {:error, reason} -> {:error, {:json_parse_error, reason}}\n    end\n  end\n\n  defp extract_services(data, :toml) do\n    case Map.get(data, \"service\") do\n      nil -> {:ok, []}\n      services when is_list(services) -> {:ok, services}\n      service when is_map(service) -> {:ok, [service]}\n    end\n  end\n\n  defp extract_services(data, :json) do\n    case Map.get(data, :services) do\n      nil -> {:ok, []}\n      services when is_list(services) -> {:ok, services}\n      _ -> {:error, :invalid_json_structure}\n    end\n  end\n\n  defp validate_and_normalize_service(service) do\n    normalized = normalize_service_keys(service)\n\n    case validate_service(normalized) do\n      :ok -> {:ok, normalized}\n      {:error, reason} -> {:error, reason}\n    end\n  end\n\n  defp normalize_service_keys(service) when is_map(service) do\n    %{\n      name: get_string_value(service, [:name, \"name\"]),\n      type: get_string_value(service, [:type, \"type\"]),\n      port: get_integer_value(service, [:port, \"port\"]),\n      host: get_string_value(service, [:host, \"host\"]),\n      txt: get_map_value(service, [:txt, \"txt\"]),\n      addresses: get_addresses(service),\n      enabled: get_boolean_value(service, [:enabled, \"enabled\"], true)\n    }\n  end\n\n  defp get_string_value(map, keys, default \\\\ nil) do\n    Enum.find_value(keys, default, fn key -> Map.get(map, key) end)\n  end\n\n  defp get_integer_value(map, keys, default \\\\ nil) do\n    case Enum.find_value(keys, default, fn key -> Map.get(map, key) end) do\n      value when is_integer(value) -> value\n      value when is_binary(value) -> String.to_integer(value)\n      _ -> default\n    end\n  end\n\n  defp get_boolean_value(map, keys, default) do\n    case Enum.find_value(keys, default, fn key -> Map.get(map, key) end) do\n      value when is_boolean(value) -> value\n      \"true\" -> true\n      \"false\" -> false\n      _ -> default\n    end\n  end\n\n  defp get_map_value(map, keys) do\n    case Enum.find_value(keys, fn key -> Map.get(map, key) end) do\n      value when is_map(value) -> value\n      _ -> %{}\n    end\n  end\n\n  defp get_addresses(service) do\n    # Try different key formats\n    case Map.get(service, :addresses) || Map.get(service, \"addresses\") do\n      nil -> []\n      addresses when is_list(addresses) -> addresses\n      addresses when is_map(addresses) -> flatten_addresses(addresses)\n      _ -> []\n    end\n  end\n\n  defp flatten_addresses(addresses_map) when is_map(addresses_map) do\n    # Handle nested structure like %{ipv4: [...], ipv6: [...]}\n    ipv4 = Map.get(addresses_map, :ipv4) || Map.get(addresses_map, \"ipv4\") || []\n    ipv6 = Map.get(addresses_map, :ipv6) || Map.get(addresses_map, \"ipv6\") || []\n\n    ipv4 ++ ipv6\n  end\n\n  defp validate_required_fields(service) do\n    required = [:name, :type, :port]\n\n    missing =\n      Enum.filter(required, fn field ->\n        is_nil(Map.get(service, field))\n      end)\n\n    if Enum.empty?(missing) do\n      :ok\n    else\n      {:error, \"Missing required fields: #{Enum.join(missing, \", \")}\"}\n    end\n  end\n\n  defp validate_name(name) when is_binary(name) and byte_size(name) > 0, do: :ok\n  defp validate_name(_), do: {:error, \"Invalid name\"}\n\n  defp validate_type(type) when is_binary(type) do\n    if String.starts_with?(type, \"_\") or String.contains?(type, \"._\") do\n      :ok\n    else\n      {:error, \"Service type must start with _ or contain ._ (e.g., _http._tcp)\"}\n    end\n  end\n\n  defp validate_type(_), do: {:error, \"Invalid type\"}\n\n  defp validate_port(port) when is_integer(port) and port > 0 and port < 65536, do: :ok\n  defp validate_port(_), do: {:error, \"Port must be between 1 and 65535\"}\n\n  defp validate_addresses(nil), do: :ok\n  defp validate_addresses([]), do: :ok\n\n  defp validate_addresses(addresses) when is_list(addresses) do\n    invalid =\n      Enum.reject(addresses, fn addr ->\n        is_binary(addr) and (valid_ipv4?(addr) or valid_ipv6?(addr))\n      end)\n\n    if Enum.empty?(invalid) do\n      :ok\n    else\n      {:error, \"Invalid IP addresses: #{inspect(invalid)}\"}\n    end\n  end\n\n  defp validate_addresses(_), do: {:error, \"Addresses must be a list\"}\n\n  defp validate_txt_records(nil), do: :ok\n  defp validate_txt_records(txt) when is_map(txt), do: :ok\n  defp validate_txt_records(_), do: {:error, \"TXT records must be a map\"}\n\n  defp valid_ipv4?(addr) do\n    case :inet.parse_address(String.to_charlist(addr)) do\n      {:ok, {_, _, _, _}} -> true\n      _ -> false\n    end\n  end\n\n  defp valid_ipv6?(addr) do\n    case :inet.parse_address(String.to_charlist(addr)) do\n      {:ok, {_, _, _, _, _, _, _, _}} -> true\n      _ -> false\n    end\n  end\n\n  defp format_services(services, :toml) do\n    # The toml library (v0.7) is decode-only, so we implement basic TOML encoding\n    # for the limited structure we need (array of tables)\n    toml_content =\n      services\n      |> Enum.map(&service_to_toml/1)\n      |> Enum.join(\"\\n\")\n\n    {:ok, toml_content}\n  end\n\n  defp format_services(services, :json) do\n    json_data = %{services: services}\n\n    case Jason.encode(json_data, pretty: true) do\n      {:ok, content} -> {:ok, content}\n      error -> error\n    end\n  end\n\n  defp service_to_toml(service) do\n    lines = [\n      \"[[service]]\",\n      \"name = #{encode_toml_string(service.name)}\",\n      \"type = #{encode_toml_string(service.type)}\",\n      \"port = #{service.port}\",\n      \"enabled = #{service[:enabled] || true}\"\n    ]\n\n    lines =\n      if service[:host] do\n        lines ++ [\"host = #{encode_toml_string(service.host)}\"]\n      else\n        lines\n      end\n\n    lines =\n      if service[:txt] && map_size(service.txt) > 0 do\n        txt_lines =\n          [\"\", \"  [service.txt]\"] ++\n            Enum.map(service.txt, fn {k, v} ->\n              \"  #{k} = #{encode_toml_string(v)}\"\n            end)\n\n        lines ++ txt_lines\n      else\n        lines\n      end\n\n    lines =\n      if service[:addresses] && length(service.addresses) > 0 do\n        ipv4 = Enum.filter(service.addresses, &valid_ipv4?/1)\n        ipv6 = Enum.filter(service.addresses, &valid_ipv6?/1)\n\n        addr_lines = []\n\n        addr_lines =\n          if Enum.any?(ipv4) || Enum.any?(ipv6),\n            do: addr_lines ++ [\"\", \"  [service.addresses]\"],\n            else: addr_lines\n\n        addr_lines =\n          if Enum.any?(ipv4),\n            do: addr_lines ++ [\"  ipv4 = [#{Enum.map_join(ipv4, \", \", &encode_toml_string/1)}]\"],\n            else: addr_lines\n\n        addr_lines =\n          if Enum.any?(ipv6),\n            do: addr_lines ++ [\"  ipv6 = [#{Enum.map_join(ipv6, \", \", &encode_toml_string/1)}]\"],\n            else: addr_lines\n\n        lines ++ addr_lines\n      else\n        lines\n      end\n\n    Enum.join(lines, \"\\n\")\n  end\n\n  defp encode_toml_string(value) when is_binary(value) do\n    \"\\\"#{String.replace(value, \"\\\"\", \"\\\\\\\"\")}\\\"\"\n  end\n\n  defp encode_toml_string(value), do: inspect(value)\n\n  defp ensure_directory(file_path) do\n    dir = Path.dirname(file_path)\n\n    case File.mkdir_p(dir) do\n      :ok -> :ok\n      error -> error\n    end\n  end\n\n  defp maybe_create_backup(_file_path, false), do: :ok\n\n  defp maybe_create_backup(file_path, true) do\n    if File.exists?(file_path) do\n      backup_path = file_path <> \".backup\"\n      File.cp(file_path, backup_path)\n    else\n      :ok\n    end\n  end\n\n  defp atomic_write(file_path, content) do\n    tmp_path = file_path <> \".tmp\"\n\n    with :ok <- File.write(tmp_path, content),\n         :ok <- File.rename(tmp_path, file_path) do\n      :ok\n    else\n      error ->\n        # Clean up temp file on error\n        File.rm(tmp_path)\n        error\n    end\n  end\nend\n","numLines":446,"startLine":1,"totalLines":446}}}
