{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Brt8XMWGvmFDXXjESKtjqh","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.LeaseManager do\n     2→  @moduledoc \"\"\"\n     3→  Manages DHCP lease allocation and tracking using Mnesia persistent storage.\n     4→\n     5→  Tracks active leases with MAC → IP bindings, handles lease expiration,\n     6→  and provides persistence across server restarts. Supports multiple lease\n     7→  states (offered, active, released, expired, declined) for full DHCP\n     8→  protocol compliance.\n     9→  \"\"\"\n    10→\n    11→  use GenServer\n    12→\n    13→  alias YellowDog.Dhcpv4.AddressPool\n    14→  alias YellowDog.Dhcpv4.LeaseStorage\n    15→\n    16→  # Run cleanup every minute\n    17→  @cleanup_interval 60_000\n    18→\n    19→  @type ip_address :: AddressPool.ip_address()\n    20→  @type mac_address :: binary()\n    21→  @type lease :: LeaseStorage.lease()\n    22→\n    23→  # Client API\n    24→\n    25→  @doc \"\"\"\n    26→  Starts the LeaseManager GenServer.\n    27→\n    28→  ## Options\n    29→  - `pools` - List of address pool configurations\n    30→\n    31→  ## Returns\n    32→  - `{:ok, pid}` - Successfully started\n    33→  - `{:error, reason}` - Failed to start\n    34→  \"\"\"\n    35→  @spec start_link(keyword()) :: GenServer.on_start()\n    36→  def start_link(opts \\\\ []) do\n    37→    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n    38→  end\n    39→\n    40→  @doc \"\"\"\n    41→  Allocates or renews a lease for a MAC address.\n    42→\n    43→  ## Parameters\n    44→  - `mac` - Client MAC address (6 bytes binary)\n    45→  - `requested_ip` - Optional requested IP address\n    46→  - `hostname` - Optional client hostname\n    47→  - `pool_name` - Pool name to allocate from (default: \"default\")\n    48→  - `client_id` - Optional client identifier (option 61)\n    49→\n    50→  ## Returns\n    51→  - `{:ok, lease}` - Successfully allocated/renewed lease\n    52→  - `{:error, reason}` - Failed to allocate lease\n    53→  \"\"\"\n    54→  @spec allocate_lease(\n    55→          mac_address(),\n    56→          ip_address() | nil,\n    57→          String.t() | nil,\n    58→          String.t(),\n    59→          binary() | nil\n    60→        ) ::\n    61→          {:ok, lease()} | {:error, term()}\n    62→  def allocate_lease(\n    63→        mac,\n    64→        requested_ip \\\\ nil,\n    65→        hostname \\\\ nil,\n    66→        pool_name \\\\ \"default\",\n    67→        client_id \\\\ nil\n    68→      ) do\n    69→    GenServer.call(\n    70→      __MODULE__,\n    71→      {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id}\n    72→    )\n    73→  end\n    74→\n    75→  @doc \"\"\"\n    76→  Releases a lease for a MAC address.\n    77→\n    78→  ## Parameters\n    79→  - `mac` - Client MAC address\n    80→\n    81→  ## Returns\n    82→  - `:ok` - Lease released\n    83→  \"\"\"\n    84→  @spec release_lease(mac_address()) :: :ok\n    85→  def release_lease(mac) do\n    86→    GenServer.call(__MODULE__, {:release_lease, mac})\n    87→  end\n    88→\n    89→  @doc \"\"\"\n    90→  Declines an IP address (marks it as unavailable for a period).\n    91→\n    92→  ## Parameters\n    93→  - `ip` - IP address to decline\n    94→  - `mac` - Client MAC address that declined\n    95→\n    96→  ## Returns\n    97→  - `:ok` - IP declined\n    98→  \"\"\"\n    99→  @spec decline_ip(ip_address(), mac_address()) :: :ok\n   100→  def decline_ip(ip, mac) do\n   101→    GenServer.call(__MODULE__, {:decline_ip, ip, mac})\n   102→  end\n   103→\n   104→  @doc \"\"\"\n   105→  Gets the current lease for a MAC address.\n   106→\n   107→  ## Parameters\n   108→  - `mac` - Client MAC address\n   109→\n   110→  ## Returns\n   111→  - `{:ok, lease}` - Active lease found\n   112→  - `{:error, :not_found}` - No active lease\n   113→  \"\"\"\n   114→  @spec get_lease(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n   115→  def get_lease(mac) do\n   116→    mac_key = normalize_mac(mac)\n   117→\n   118→    case LeaseStorage.get(mac_key) do\n   119→      {:ok, lease} ->\n   120→        # Check if lease is active and not expired\n   121→        if lease.state == :active && lease.expires_at > System.system_time(:second) do\n   122→          {:ok, lease}\n   123→        else\n   124→          {:error, :not_found}\n   125→        end\n   126→\n   127→      {:error, :not_found} ->\n   128→        {:error, :not_found}\n   129→    end\n   130→  end\n   131→\n   132→  @doc \"\"\"\n   133→  Gets all active leases.\n   134→\n   135→  ## Returns\n   136→  - List of active leases\n   137→  \"\"\"\n   138→  @spec list_leases() :: [lease()]\n   139→  def list_leases do\n   140→    LeaseStorage.list_active()\n   141→  end\n   142→\n   143→  @doc \"\"\"\n   144→  Gets all allocated IP addresses.\n   145→\n   146→  ## Returns\n   147→  - MapSet of allocated IP addresses\n   148→  \"\"\"\n   149→  @spec get_allocated_ips() :: MapSet.t(ip_address())\n   150→  def get_allocated_ips do\n   151→    LeaseStorage.get_allocated_ips()\n   152→  end\n   153→\n   154→  @doc \"\"\"\n   155→  Gets lease statistics.\n   156→\n   157→  ## Returns\n   158→  - Map with lease statistics\n   159→  \"\"\"\n   160→  @spec stats() :: map()\n   161→  def stats do\n   162→    LeaseStorage.stats()\n   163→  end\n   164→\n   165→  @doc \"\"\"\n   166→  Gets all configured pools.\n   167→\n   168→  ## Returns\n   169→  - List of pool configurations\n   170→  \"\"\"\n   171→  @spec get_pools() :: [AddressPool.pool_config()]\n   172→  def get_pools do\n   173→    GenServer.call(__MODULE__, :get_pools)\n   174→  end\n   175→\n   176→  @doc \"\"\"\n   177→  Gets statistics for a specific pool.\n   178→\n   179→  ## Parameters\n   180→  - `pool_name` - Name of the pool\n   181→\n   182→  ## Returns\n   183→  - `{:ok, stats}` - Pool statistics\n   184→  - `{:error, :pool_not_found}` - Pool does not exist\n   185→  \"\"\"\n   186→  @spec get_pool_stats(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n   187→  def get_pool_stats(pool_name) do\n   188→    GenServer.call(__MODULE__, {:get_pool_stats, pool_name})\n   189→  end\n   190→\n   191→  @doc \"\"\"\n   192→  Gets statistics for all pools.\n   193→\n   194→  ## Returns\n   195→  - Map with pool names as keys and statistics as values\n   196→  \"\"\"\n   197→  @spec get_all_pool_stats() :: map()\n   198→  def get_all_pool_stats do\n   199→    GenServer.call(__MODULE__, :get_all_pool_stats)\n   200→  end\n   201→\n   202→  @doc \"\"\"\n   203→  Gets the configuration for a specific pool.\n   204→\n   205→  ## Parameters\n   206→  - `pool_name` - Name of the pool\n   207→\n   208→  ## Returns\n   209→  - `{:ok, config}` - Pool configuration\n   210→  - `{:error, :pool_not_found}` - Pool does not exist\n   211→  \"\"\"\n   212→  @spec get_pool_config(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n   213→  def get_pool_config(pool_name) do\n   214→    GenServer.call(__MODULE__, {:get_pool_config, pool_name})\n   215→  end\n   216→\n   217→  @doc \"\"\"\n   218→  Gets static reservations for a specific pool.\n   219→\n   220→  ## Parameters\n   221→  - `pool_name` - Name of the pool\n   222→\n   223→  ## Returns\n   224→  - List of static reservations\n   225→  \"\"\"\n   226→  @spec get_static_reservations(String.t()) :: [map()]\n   227→  def get_static_reservations(pool_name) do\n   228→    GenServer.call(__MODULE__, {:get_static_reservations, pool_name})\n   229→  end\n   230→\n   231→  # Server Callbacks\n   232→\n   233→  @impl true\n   234→  def init(opts) do\n   235→    # Initialize Mnesia storage\n   236→    storage_type = if Mix.env() == :test, do: :ram_copies, else: :disc_copies\n   237→\n   238→    case LeaseStorage.init(storage_type: storage_type) do\n   239→      :ok ->\n   240→        :telemetry.execute(\n   241→          [:yellow_dog, :dhcpv4, :storage, :initialized],\n   242→          %{count: 1},\n   243→          %{storage_type: storage_type}\n   244→        )\n   245→\n   246→      {:error, reason} ->\n   247→        :telemetry.execute(\n   248→          [:yellow_dog, :dhcpv4, :storage, :init_failed],\n   249→          %{count: 1},\n   250→          %{reason: inspect(reason)}\n   251→        )\n   252→    end\n   253→\n   254→    # Extract pools from options\n   255→    pools = Keyword.get(opts, :pools, [])\n   256→\n   257→    # Parse pools into AddressPool configs\n   258→    parsed_pools =\n   259→      Enum.map(pools, fn pool_config ->\n   260→        case AddressPool.new(pool_config) do\n   261→          {:ok, pool} ->\n   262→            pool\n   263→\n   264→          {:error, reason} ->\n   265→            :telemetry.execute(\n   266→              [:yellow_dog, :dhcpv4, :pool, :creation_failed],\n   267→              %{count: 1},\n   268→              %{reason: inspect(reason)}\n   269→            )\n   270→\n   271→            nil\n   272→        end\n   273→      end)\n   274→      |> Enum.reject(&is_nil/1)\n   275→\n   276→    # Schedule periodic cleanup\n   277→    schedule_cleanup()\n   278→\n   279→    state = %{\n   280→      pools: parsed_pools\n   281→    }\n   282→\n   283→    :telemetry.execute(\n   284→      [:yellow_dog, :dhcpv4, :lease_manager, :started],\n   285→      %{count: 1, pool_count: length(parsed_pools)},\n   286→      %{}\n   287→    )\n   288→\n   289→    {:ok, state}\n   290→  end\n   291→\n   292→  @impl true\n   293→  def handle_call(\n   294→        {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id},\n   295→        _from,\n   296→        state\n   297→      ) do\n   298→    # Find the pool\n   299→    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n   300→\n   301→    if pool do\n   302→      result = do_allocate_lease(mac, requested_ip, hostname, pool, client_id)\n   303→      {:reply, result, state}\n   304→    else\n   305→      {:reply, {:error, :pool_not_found}, state}\n   306→    end\n   307→  end\n   308→\n   309→  @impl true\n   310→  def handle_call({:release_lease, mac}, _from, state) do\n   311→    mac_key = normalize_mac(mac)\n   312→\n   313→    case LeaseStorage.update_state(mac_key, :released) do\n   314→      {:ok, _lease} ->\n   315→        :telemetry.execute(\n   316→          [:yellow_dog, :dhcpv4, :lease, :release_completed],\n   317→          %{count: 1},\n   318→          %{client_mac: mac_key}\n   319→        )\n   320→\n   321→        {:reply, :ok, state}\n   322→\n   323→      {:error, :not_found} ->\n   324→        :telemetry.execute(\n   325→          [:yellow_dog, :dhcpv4, :lease, :release_not_found],\n   326→          %{count: 1},\n   327→          %{client_mac: mac_key}\n   328→        )\n   329→\n   330→        {:reply, :ok, state}\n   331→\n   332→      {:error, reason} ->\n   333→        :telemetry.execute(\n   334→          [:yellow_dog, :dhcpv4, :lease, :release_failed],\n   335→          %{count: 1},\n   336→          %{reason: inspect(reason)}\n   337→        )\n   338→\n   339→        {:reply, {:error, reason}, state}\n   340→    end\n   341→  end\n   342→\n   343→  @impl true\n   344→  def handle_call({:decline_ip, ip, mac}, _from, state) do\n   345→    mac_key = normalize_mac(mac)\n   346→\n   347→    case LeaseStorage.update_state(mac_key, :declined) do\n   348→      {:ok, _lease} ->\n   349→        :telemetry.execute(\n   350→          [:yellow_dog, :dhcpv4, :lease, :decline_completed],\n   351→          %{count: 1},\n   352→          %{client_mac: mac_key, declined_ip: ip}\n   353→        )\n   354→\n   355→        {:reply, :ok, state}\n   356→\n   357→      {:error, :not_found} ->\n   358→        :telemetry.execute(\n   359→          [:yellow_dog, :dhcpv4, :lease, :decline_not_found],\n   360→          %{count: 1},\n   361→          %{client_mac: mac_key}\n   362→        )\n   363→\n   364→        {:reply, :ok, state}\n   365→\n   366→      {:error, reason} ->\n   367→        :telemetry.execute(\n   368→          [:yellow_dog, :dhcpv4, :lease, :decline_failed],\n   369→          %{count: 1},\n   370→          %{reason: inspect(reason)}\n   371→        )\n   372→\n   373→        {:reply, {:error, reason}, state}\n   374→    end\n   375→  end\n   376→\n   377→  @impl true\n   378→  def handle_call(:get_pools, _from, state) do\n   379→    {:reply, state.pools, state}\n   380→  end\n   381→\n   382→  @impl true\n   383→  def handle_call({:get_pool_stats, pool_name}, _from, state) do\n   384→    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n   385→\n   386→    if pool do\n   387→      stats = YellowDog.Dhcpv4.PoolStats.get_pool_stats(pool)\n   388→      {:reply, {:ok, stats}, state}\n   389→    else\n   390→      {:reply, {:error, :pool_not_found}, state}\n   391→    end\n   392→  end\n   393→\n   394→  @impl true\n   395→  def handle_call(:get_all_pool_stats, _from, state) do\n   396→    stats = YellowDog.Dhcpv4.PoolStats.get_all_pool_stats(state.pools)\n   397→    {:reply, stats, state}\n   398→  end\n   399→\n   400→  @impl true\n   401→  def handle_call({:get_pool_config, pool_name}, _from, state) do\n   402→    case Map.get(state.pools, pool_name) do\n   403→      nil ->\n   404→        {:reply, {:error, :pool_not_found}, state}\n   405→\n   406→      pool ->\n   407→        config = %{\n   408→          name: pool.name,\n   409→          range_start: pool.range_start,\n   410→          range_end: pool.range_end,\n   411→          subnet_mask: pool.subnet_mask,\n   412→          gateway: pool.gateway,\n   413→          dns_servers: pool.dns_servers,\n   414→          domain_name: pool.domain_name,\n   415→          lease_time: pool.lease_time,\n   416→          excluded_ranges: pool.excluded_ranges\n   417→        }\n   418→\n   419→        {:reply, {:ok, config}, state}\n   420→    end\n   421→  end\n   422→\n   423→  @impl true\n   424→  def handle_call({:get_static_reservations, pool_name}, _from, state) do\n   425→    case Map.get(state.pools, pool_name) do\n   426→      nil ->\n   427→        {:reply, [], state}\n   428→\n   429→      pool ->\n   430→        reservations =\n   431→          pool.static_reservations\n   432→          |> Enum.map(fn {mac, ip} ->\n   433→            %{\n   434→              mac_address: mac,\n   435→              ip_address: ip,\n   436→              description: nil\n   437→            }\n   438→          end)\n   439→\n   440→        {:reply, reservations, state}\n   441→    end\n   442→  end\n   443→\n   444→  @impl true\n   445→  def handle_info(:cleanup_expired_leases, state) do\n   446→    case LeaseStorage.cleanup_expired() do\n   447→      {:ok, _count} ->\n   448→        :ok\n   449→\n   450→      {:error, reason} ->\n   451→        :telemetry.execute(\n   452→          [:yellow_dog, :dhcpv4, :lease, :cleanup_failed],\n   453→          %{count: 1},\n   454→          %{reason: inspect(reason)}\n   455→        )\n   456→    end\n   457→\n   458→    schedule_cleanup()\n   459→    {:noreply, state}\n   460→  end\n   461→\n   462→  # Private helper functions\n   463→\n   464→  defp do_allocate_lease(mac, requested_ip, hostname, pool, client_id) do\n   465→    mac_key = normalize_mac(mac)\n   466→\n   467→    # Check for existing lease\n   468→    case LeaseStorage.get(mac_key) do\n   469→      {:ok, existing_lease} ->\n   470→        # Renew existing lease\n   471→        renewed_lease = renew_lease(existing_lease, hostname, client_id)\n   472→\n   473→        case LeaseStorage.put(renewed_lease) do\n   474→          {:ok, lease} ->\n   475→            :telemetry.execute(\n   476→              [:yellow_dog, :dhcpv4, :lease, :renewed],\n   477→              %{count: 1},\n   478→              %{client_mac: mac_key, ip_address: lease.ip_address}\n   479→            )\n   480→\n   481→            {:ok, lease}\n   482→\n   483→          {:error, reason} ->\n   484→            :telemetry.execute(\n   485→              [:yellow_dog, :dhcpv4, :lease, :renew_failed],\n   486→              %{count: 1},\n   487→              %{reason: inspect(reason)}\n   488→            )\n   489→\n   490→            {:error, reason}\n   491→        end\n   492→\n   493→      {:error, :not_found} ->\n   494→        # Allocate new lease\n   495→        allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n   496→    end\n   497→  end\n   498→\n   499→  defp allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n   500→    allocated_ips = get_allocated_ips()\n   501→\n   502→    # Try to honor requested IP if provided and available\n   503→    ip =\n   504→      cond do\n   505→        requested_ip && AddressPool.in_range?(pool, requested_ip) &&\n   506→            not MapSet.member?(allocated_ips, requested_ip) ->\n   507→          requested_ip\n   508→\n   509→        true ->\n   510→          case AddressPool.get_available_ip(pool, allocated_ips, mac) do\n   511→            {:ok, available_ip} -> available_ip\n   512→            {:error, :pool_exhausted} -> nil\n   513→          end\n   514→      end\n   515→\n   516→    if ip do\n   517→      now = System.system_time(:second)\n   518→\n   519→      lease = %{\n   520→        mac_address: mac_key,\n   521→        ip_address: ip,\n   522→        pool_name: pool.name,\n   523→        state: :active,\n   524→        lease_time: pool.lease_time,\n   525→        expires_at: now + pool.lease_time,\n   526→        hostname: hostname,\n   527→        client_id: client_id,\n   528→        created_at: now,\n   529→        updated_at: now\n   530→      }\n   531→\n   532→      case LeaseStorage.put(lease) do\n   533→        {:ok, stored_lease} ->\n   534→          :telemetry.execute(\n   535→            [:yellow_dog, :dhcpv4, :lease, :allocated],\n   536→            %{count: 1},\n   537→            %{client_mac: mac_key, ip_address: ip, pool_name: pool.name}\n   538→          )\n   539→\n   540→          {:ok, stored_lease}\n   541→\n   542→        {:error, reason} ->\n   543→          :telemetry.execute(\n   544→            [:yellow_dog, :dhcpv4, :lease, :store_failed],\n   545→            %{count: 1},\n   546→            %{reason: inspect(reason)}\n   547→          )\n   548→\n   549→          {:error, reason}\n   550→      end\n   551→    else\n   552→      :telemetry.execute(\n   553→        [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   554→        %{count: 1},\n   555→        %{pool_name: pool.name}\n   556→      )\n   557→\n   558→      {:error, :pool_exhausted}\n   559→    end\n   560→  end\n   561→\n   562→  defp renew_lease(lease, hostname, client_id) do\n   563→    now = System.system_time(:second)\n   564→\n   565→    %{\n   566→      lease\n   567→      | state: :active,\n   568→        expires_at: now + lease.lease_time,\n   569→        hostname: hostname || lease.hostname,\n   570→        client_id: client_id || lease.client_id,\n   571→        updated_at: now\n   572→    }\n   573→  end\n   574→\n   575→  defp schedule_cleanup do\n   576→    Process.send_after(self(), :cleanup_expired_leases, @cleanup_interval)\n   577→  end\n   578→\n   579→  # Normalize MAC address to consistent binary format\n   580→  defp normalize_mac(<<mac::binary-size(6)>>), do: mac\n   581→\n   582→  defp normalize_mac(mac) when is_binary(mac) and byte_size(mac) == 16 do\n   583→    # Handle padded MAC address from DHCP message (16 bytes with trailing zeros)\n   584→    <<actual_mac::binary-size(6), _rest::binary>> = mac\n   585→    actual_mac\n   586→  end\n   587→\n   588→  defp normalize_mac(mac) when is_binary(mac), do: mac\n   589→end\n   590→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8559038-3d53-47df-9b7a-d16bbb068c80","uuid":"ecf24235-a8a1-46a6-936b-26d34f3861eb","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/lease_manager.ex","content":"defmodule YellowDog.Dhcpv4.LeaseManager do\n  @moduledoc \"\"\"\n  Manages DHCP lease allocation and tracking using Mnesia persistent storage.\n\n  Tracks active leases with MAC → IP bindings, handles lease expiration,\n  and provides persistence across server restarts. Supports multiple lease\n  states (offered, active, released, expired, declined) for full DHCP\n  protocol compliance.\n  \"\"\"\n\n  use GenServer\n\n  alias YellowDog.Dhcpv4.AddressPool\n  alias YellowDog.Dhcpv4.LeaseStorage\n\n  # Run cleanup every minute\n  @cleanup_interval 60_000\n\n  @type ip_address :: AddressPool.ip_address()\n  @type mac_address :: binary()\n  @type lease :: LeaseStorage.lease()\n\n  # Client API\n\n  @doc \"\"\"\n  Starts the LeaseManager GenServer.\n\n  ## Options\n  - `pools` - List of address pool configurations\n\n  ## Returns\n  - `{:ok, pid}` - Successfully started\n  - `{:error, reason}` - Failed to start\n  \"\"\"\n  @spec start_link(keyword()) :: GenServer.on_start()\n  def start_link(opts \\\\ []) do\n    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Allocates or renews a lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address (6 bytes binary)\n  - `requested_ip` - Optional requested IP address\n  - `hostname` - Optional client hostname\n  - `pool_name` - Pool name to allocate from (default: \"default\")\n  - `client_id` - Optional client identifier (option 61)\n\n  ## Returns\n  - `{:ok, lease}` - Successfully allocated/renewed lease\n  - `{:error, reason}` - Failed to allocate lease\n  \"\"\"\n  @spec allocate_lease(\n          mac_address(),\n          ip_address() | nil,\n          String.t() | nil,\n          String.t(),\n          binary() | nil\n        ) ::\n          {:ok, lease()} | {:error, term()}\n  def allocate_lease(\n        mac,\n        requested_ip \\\\ nil,\n        hostname \\\\ nil,\n        pool_name \\\\ \"default\",\n        client_id \\\\ nil\n      ) do\n    GenServer.call(\n      __MODULE__,\n      {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id}\n    )\n  end\n\n  @doc \"\"\"\n  Releases a lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address\n\n  ## Returns\n  - `:ok` - Lease released\n  \"\"\"\n  @spec release_lease(mac_address()) :: :ok\n  def release_lease(mac) do\n    GenServer.call(__MODULE__, {:release_lease, mac})\n  end\n\n  @doc \"\"\"\n  Declines an IP address (marks it as unavailable for a period).\n\n  ## Parameters\n  - `ip` - IP address to decline\n  - `mac` - Client MAC address that declined\n\n  ## Returns\n  - `:ok` - IP declined\n  \"\"\"\n  @spec decline_ip(ip_address(), mac_address()) :: :ok\n  def decline_ip(ip, mac) do\n    GenServer.call(__MODULE__, {:decline_ip, ip, mac})\n  end\n\n  @doc \"\"\"\n  Gets the current lease for a MAC address.\n\n  ## Parameters\n  - `mac` - Client MAC address\n\n  ## Returns\n  - `{:ok, lease}` - Active lease found\n  - `{:error, :not_found}` - No active lease\n  \"\"\"\n  @spec get_lease(mac_address()) :: {:ok, lease()} | {:error, :not_found}\n  def get_lease(mac) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.get(mac_key) do\n      {:ok, lease} ->\n        # Check if lease is active and not expired\n        if lease.state == :active && lease.expires_at > System.system_time(:second) do\n          {:ok, lease}\n        else\n          {:error, :not_found}\n        end\n\n      {:error, :not_found} ->\n        {:error, :not_found}\n    end\n  end\n\n  @doc \"\"\"\n  Gets all active leases.\n\n  ## Returns\n  - List of active leases\n  \"\"\"\n  @spec list_leases() :: [lease()]\n  def list_leases do\n    LeaseStorage.list_active()\n  end\n\n  @doc \"\"\"\n  Gets all allocated IP addresses.\n\n  ## Returns\n  - MapSet of allocated IP addresses\n  \"\"\"\n  @spec get_allocated_ips() :: MapSet.t(ip_address())\n  def get_allocated_ips do\n    LeaseStorage.get_allocated_ips()\n  end\n\n  @doc \"\"\"\n  Gets lease statistics.\n\n  ## Returns\n  - Map with lease statistics\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    LeaseStorage.stats()\n  end\n\n  @doc \"\"\"\n  Gets all configured pools.\n\n  ## Returns\n  - List of pool configurations\n  \"\"\"\n  @spec get_pools() :: [AddressPool.pool_config()]\n  def get_pools do\n    GenServer.call(__MODULE__, :get_pools)\n  end\n\n  @doc \"\"\"\n  Gets statistics for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - `{:ok, stats}` - Pool statistics\n  - `{:error, :pool_not_found}` - Pool does not exist\n  \"\"\"\n  @spec get_pool_stats(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n  def get_pool_stats(pool_name) do\n    GenServer.call(__MODULE__, {:get_pool_stats, pool_name})\n  end\n\n  @doc \"\"\"\n  Gets statistics for all pools.\n\n  ## Returns\n  - Map with pool names as keys and statistics as values\n  \"\"\"\n  @spec get_all_pool_stats() :: map()\n  def get_all_pool_stats do\n    GenServer.call(__MODULE__, :get_all_pool_stats)\n  end\n\n  @doc \"\"\"\n  Gets the configuration for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - `{:ok, config}` - Pool configuration\n  - `{:error, :pool_not_found}` - Pool does not exist\n  \"\"\"\n  @spec get_pool_config(String.t()) :: {:ok, map()} | {:error, :pool_not_found}\n  def get_pool_config(pool_name) do\n    GenServer.call(__MODULE__, {:get_pool_config, pool_name})\n  end\n\n  @doc \"\"\"\n  Gets static reservations for a specific pool.\n\n  ## Parameters\n  - `pool_name` - Name of the pool\n\n  ## Returns\n  - List of static reservations\n  \"\"\"\n  @spec get_static_reservations(String.t()) :: [map()]\n  def get_static_reservations(pool_name) do\n    GenServer.call(__MODULE__, {:get_static_reservations, pool_name})\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(opts) do\n    # Initialize Mnesia storage\n    storage_type = if Mix.env() == :test, do: :ram_copies, else: :disc_copies\n\n    case LeaseStorage.init(storage_type: storage_type) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :storage, :initialized],\n          %{count: 1},\n          %{storage_type: storage_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :storage, :init_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n    end\n\n    # Extract pools from options\n    pools = Keyword.get(opts, :pools, [])\n\n    # Parse pools into AddressPool configs\n    parsed_pools =\n      Enum.map(pools, fn pool_config ->\n        case AddressPool.new(pool_config) do\n          {:ok, pool} ->\n            pool\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :pool, :creation_failed],\n              %{count: 1},\n              %{reason: inspect(reason)}\n            )\n\n            nil\n        end\n      end)\n      |> Enum.reject(&is_nil/1)\n\n    # Schedule periodic cleanup\n    schedule_cleanup()\n\n    state = %{\n      pools: parsed_pools\n    }\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease_manager, :started],\n      %{count: 1, pool_count: length(parsed_pools)},\n      %{}\n    )\n\n    {:ok, state}\n  end\n\n  @impl true\n  def handle_call(\n        {:allocate_lease, mac, requested_ip, hostname, pool_name, client_id},\n        _from,\n        state\n      ) do\n    # Find the pool\n    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n\n    if pool do\n      result = do_allocate_lease(mac, requested_ip, hostname, pool, client_id)\n      {:reply, result, state}\n    else\n      {:reply, {:error, :pool_not_found}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:release_lease, mac}, _from, state) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.update_state(mac_key, :released) do\n      {:ok, _lease} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_completed],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, :not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_not_found],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :release_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:reply, {:error, reason}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:decline_ip, ip, mac}, _from, state) do\n    mac_key = normalize_mac(mac)\n\n    case LeaseStorage.update_state(mac_key, :declined) do\n      {:ok, _lease} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_completed],\n          %{count: 1},\n          %{client_mac: mac_key, declined_ip: ip}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, :not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_not_found],\n          %{count: 1},\n          %{client_mac: mac_key}\n        )\n\n        {:reply, :ok, state}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :decline_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n\n        {:reply, {:error, reason}, state}\n    end\n  end\n\n  @impl true\n  def handle_call(:get_pools, _from, state) do\n    {:reply, state.pools, state}\n  end\n\n  @impl true\n  def handle_call({:get_pool_stats, pool_name}, _from, state) do\n    pool = Enum.find(state.pools, fn p -> p.name == pool_name end)\n\n    if pool do\n      stats = YellowDog.Dhcpv4.PoolStats.get_pool_stats(pool)\n      {:reply, {:ok, stats}, state}\n    else\n      {:reply, {:error, :pool_not_found}, state}\n    end\n  end\n\n  @impl true\n  def handle_call(:get_all_pool_stats, _from, state) do\n    stats = YellowDog.Dhcpv4.PoolStats.get_all_pool_stats(state.pools)\n    {:reply, stats, state}\n  end\n\n  @impl true\n  def handle_call({:get_pool_config, pool_name}, _from, state) do\n    case Map.get(state.pools, pool_name) do\n      nil ->\n        {:reply, {:error, :pool_not_found}, state}\n\n      pool ->\n        config = %{\n          name: pool.name,\n          range_start: pool.range_start,\n          range_end: pool.range_end,\n          subnet_mask: pool.subnet_mask,\n          gateway: pool.gateway,\n          dns_servers: pool.dns_servers,\n          domain_name: pool.domain_name,\n          lease_time: pool.lease_time,\n          excluded_ranges: pool.excluded_ranges\n        }\n\n        {:reply, {:ok, config}, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:get_static_reservations, pool_name}, _from, state) do\n    case Map.get(state.pools, pool_name) do\n      nil ->\n        {:reply, [], state}\n\n      pool ->\n        reservations =\n          pool.static_reservations\n          |> Enum.map(fn {mac, ip} ->\n            %{\n              mac_address: mac,\n              ip_address: ip,\n              description: nil\n            }\n          end)\n\n        {:reply, reservations, state}\n    end\n  end\n\n  @impl true\n  def handle_info(:cleanup_expired_leases, state) do\n    case LeaseStorage.cleanup_expired() do\n      {:ok, _count} ->\n        :ok\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :cleanup_failed],\n          %{count: 1},\n          %{reason: inspect(reason)}\n        )\n    end\n\n    schedule_cleanup()\n    {:noreply, state}\n  end\n\n  # Private helper functions\n\n  defp do_allocate_lease(mac, requested_ip, hostname, pool, client_id) do\n    mac_key = normalize_mac(mac)\n\n    # Check for existing lease\n    case LeaseStorage.get(mac_key) do\n      {:ok, existing_lease} ->\n        # Renew existing lease\n        renewed_lease = renew_lease(existing_lease, hostname, client_id)\n\n        case LeaseStorage.put(renewed_lease) do\n          {:ok, lease} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :lease, :renewed],\n              %{count: 1},\n              %{client_mac: mac_key, ip_address: lease.ip_address}\n            )\n\n            {:ok, lease}\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason)}\n            )\n\n            {:error, reason}\n        end\n\n      {:error, :not_found} ->\n        # Allocate new lease\n        allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id)\n    end\n  end\n\n  defp allocate_new_lease(mac, mac_key, requested_ip, hostname, pool, client_id) do\n    allocated_ips = get_allocated_ips()\n\n    # Try to honor requested IP if provided and available\n    ip =\n      cond do\n        requested_ip && AddressPool.in_range?(pool, requested_ip) &&\n            not MapSet.member?(allocated_ips, requested_ip) ->\n          requested_ip\n\n        true ->\n          case AddressPool.get_available_ip(pool, allocated_ips, mac) do\n            {:ok, available_ip} -> available_ip\n            {:error, :pool_exhausted} -> nil\n          end\n      end\n\n    if ip do\n      now = System.system_time(:second)\n\n      lease = %{\n        mac_address: mac_key,\n        ip_address: ip,\n        pool_name: pool.name,\n        state: :active,\n        lease_time: pool.lease_time,\n        expires_at: now + pool.lease_time,\n        hostname: hostname,\n        client_id: client_id,\n        created_at: now,\n        updated_at: now\n      }\n\n      case LeaseStorage.put(lease) do\n        {:ok, stored_lease} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease, :allocated],\n            %{count: 1},\n            %{client_mac: mac_key, ip_address: ip, pool_name: pool.name}\n          )\n\n          {:ok, stored_lease}\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv4, :lease, :store_failed],\n            %{count: 1},\n            %{reason: inspect(reason)}\n          )\n\n          {:error, reason}\n      end\n    else\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :pool, :exhausted],\n        %{count: 1},\n        %{pool_name: pool.name}\n      )\n\n      {:error, :pool_exhausted}\n    end\n  end\n\n  defp renew_lease(lease, hostname, client_id) do\n    now = System.system_time(:second)\n\n    %{\n      lease\n      | state: :active,\n        expires_at: now + lease.lease_time,\n        hostname: hostname || lease.hostname,\n        client_id: client_id || lease.client_id,\n        updated_at: now\n    }\n  end\n\n  defp schedule_cleanup do\n    Process.send_after(self(), :cleanup_expired_leases, @cleanup_interval)\n  end\n\n  # Normalize MAC address to consistent binary format\n  defp normalize_mac(<<mac::binary-size(6)>>), do: mac\n\n  defp normalize_mac(mac) when is_binary(mac) and byte_size(mac) == 16 do\n    # Handle padded MAC address from DHCP message (16 bytes with trailing zeros)\n    <<actual_mac::binary-size(6), _rest::binary>> = mac\n    actual_mac\n  end\n\n  defp normalize_mac(mac) when is_binary(mac), do: mac\nend\n","numLines":590,"startLine":1,"totalLines":590}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0136kBa6B1UFbXmc639AGXiH","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.AddressPool do\n     2→  @moduledoc \"\"\"\n     3→  IP address pool management for DHCPv4.\n     4→\n     5→  Manages IP address ranges, allocation, and availability tracking.\n     6→  Supports multiple pools, static reservations, and address conflict detection.\n     7→  \"\"\"\n     8→\n     9→  @type ip_address :: {0..255, 0..255, 0..255, 0..255}\n    10→  @type mac_address :: binary()\n    11→  @type ip_range :: {ip_address(), ip_address()}\n    12→  @type pool_config :: %{\n    13→          name: String.t(),\n    14→          ranges: [ip_range()],\n    15→          # Legacy support - converted to ranges\n    16→          range_start: ip_address() | nil,\n    17→          range_end: ip_address() | nil,\n    18→          excluded_ranges: [ip_range()],\n    19→          subnet_mask: ip_address(),\n    20→          gateway: ip_address(),\n    21→          dns_servers: [ip_address()],\n    22→          domain_name: String.t() | nil,\n    23→          lease_time: pos_integer()\n    24→        }\n    25→\n    26→  @doc \"\"\"\n    27→  Creates a new address pool from configuration.\n    28→\n    29→  ## Parameters\n    30→  - `config` - Pool configuration map\n    31→\n    32→  ## Returns\n    33→  - `{:ok, pool}` - Successfully created pool\n    34→  - `{:error, reason}` - Failed to create pool\n    35→\n    36→  ## Example\n    37→      iex> config = %{\n    38→      ...>   name: \"main\",\n    39→      ...>   range_start: {192, 168, 1, 100},\n    40→      ...>   range_end: {192, 168, 1, 200},\n    41→      ...>   subnet_mask: {255, 255, 255, 0},\n    42→      ...>   gateway: {192, 168, 1, 1},\n    43→      ...>   dns_servers: [{192, 168, 1, 1}],\n    44→      ...>   domain_name: \"local\",\n    45→      ...>   lease_time: 86400\n    46→      ...> }\n    47→      iex> YellowDog.Dhcpv4.AddressPool.new(config)\n    48→      {:ok, %{...}}\n    49→  \"\"\"\n    50→  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n    51→  def new(config) do\n    52→    with {:ok, validated_config} <- validate_pool_config(config) do\n    53→      # Support both legacy (range_start/range_end) and new (ranges) format\n    54→      ranges = build_ranges(config, validated_config)\n    55→      excluded_ranges = build_excluded_ranges(config)\n    56→\n    57→      # Get first range for defaults\n    58→      {first_range_start, _} = hd(ranges)\n    59→\n    60→      pool = %{\n    61→        name: Map.get(config, :name, \"default\"),\n    62→        ranges: ranges,\n    63→        range_start: validated_config[:range_start],\n    64→        range_end: validated_config[:range_end],\n    65→        excluded_ranges: excluded_ranges,\n    66→        subnet_mask: Map.get(config, :subnet_mask, {255, 255, 255, 0}),\n    67→        gateway: Map.get(config, :gateway, first_range_start),\n    68→        dns_servers: Map.get(config, :dns_servers, [first_range_start]),\n    69→        domain_name: Map.get(config, :domain_name),\n    70→        lease_time: Map.get(config, :lease_time, 86400),\n    71→        static_reservations: Map.get(config, :static_reservations, %{})\n    72→      }\n    73→\n    74→      {:ok, pool}\n    75→    end\n    76→  end\n    77→\n    78→  @doc \"\"\"\n    79→  Validates pool configuration.\n    80→\n    81→  Supports both legacy format (range_start/range_end) and new format (ranges).\n    82→\n    83→  ## Parameters\n    84→  - `config` - Pool configuration to validate\n    85→\n    86→  ## Returns\n    87→  - `{:ok, config}` - Valid configuration\n    88→  - `{:error, reason}` - Invalid configuration\n    89→  \"\"\"\n    90→  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n    91→  def validate_pool_config(config) do\n    92→    cond do\n    93→      # New format with ranges\n    94→      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n    95→        validate_ranges_config(config)\n    96→\n    97→      # Legacy format with range_start/range_end\n    98→      Map.has_key?(config, :range_start) || Map.has_key?(config, \"range_start\") ->\n    99→        validate_legacy_config(config)\n   100→\n   101→      true ->\n   102→        {:error, \"Must specify either :ranges or :range_start/:range_end\"}\n   103→    end\n   104→  end\n   105→\n   106→  defp validate_legacy_config(config) do\n   107→    with {:ok, range_start} <- get_required_ip(config, :range_start),\n   108→         {:ok, range_end} <- get_required_ip(config, :range_end),\n   109→         :ok <- validate_range_order(range_start, range_end) do\n   110→      {:ok, %{range_start: range_start, range_end: range_end}}\n   111→    end\n   112→  end\n   113→\n   114→  defp validate_ranges_config(config) do\n   115→    ranges = config.ranges\n   116→\n   117→    # Validate each range\n   118→    validated_ranges =\n   119→      Enum.reduce_while(ranges, {:ok, []}, fn range_config, {:ok, acc} ->\n   120→        case validate_single_range(range_config) do\n   121→          {:ok, validated_range} ->\n   122→            {:cont, {:ok, [validated_range | acc]}}\n   123→\n   124→          {:error, reason} ->\n   125→            {:halt, {:error, reason}}\n   126→        end\n   127→      end)\n   128→\n   129→    case validated_ranges do\n   130→      {:ok, ranges_list} ->\n   131→        {:ok, %{ranges: Enum.reverse(ranges_list)}}\n   132→\n   133→      error ->\n   134→        error\n   135→    end\n   136→  end\n   137→\n   138→  defp validate_single_range({start_ip, end_ip}) when is_tuple(start_ip) and is_tuple(end_ip) do\n   139→    with :ok <- validate_range_order(start_ip, end_ip) do\n   140→      {:ok, {start_ip, end_ip}}\n   141→    end\n   142→  end\n   143→\n   144→  defp validate_single_range(%{start: start, end: end_ip}) do\n   145→    with {:ok, start_ip} <- normalize_ip(start),\n   146→         {:ok, end_ip_val} <- normalize_ip(end_ip),\n   147→         :ok <- validate_range_order(start_ip, end_ip_val) do\n   148→      {:ok, {start_ip, end_ip_val}}\n   149→    end\n   150→  end\n   151→\n   152→  defp validate_single_range(_), do: {:error, \"Invalid range format\"}\n   153→\n   154→  @doc \"\"\"\n   155→  Gets the next available IP address from the pool.\n   156→\n   157→  ## Parameters\n   158→  - `pool` - Pool configuration\n   159→  - `allocated_ips` - Set of already allocated IP addresses\n   160→  - `mac` - MAC address requesting the IP (for static reservation check)\n   161→\n   162→  ## Returns\n   163→  - `{:ok, ip}` - Available IP address\n   164→  - `{:error, :pool_exhausted}` - No available addresses\n   165→  \"\"\"\n   166→  @spec get_available_ip(pool_config(), MapSet.t(ip_address()), mac_address()) ::\n   167→          {:ok, ip_address()} | {:error, :pool_exhausted}\n   168→  def get_available_ip(pool, allocated_ips, mac) do\n   169→    # Check for static reservation first\n   170→    case get_static_reservation(pool, mac) do\n   171→      {:ok, ip} ->\n   172→        {:ok, ip}\n   173→\n   174→      :not_found ->\n   175→        # Find next available IP across all ranges, excluding excluded ranges\n   176→        find_next_available_in_ranges(pool.ranges, pool.excluded_ranges, allocated_ips)\n   177→    end\n   178→  end\n   179→\n   180→  @doc \"\"\"\n   181→  Checks if an IP address is within any of the pool ranges (and not in excluded ranges).\n   182→\n   183→  ## Parameters\n   184→  - `pool` - Pool configuration\n   185→  - `ip` - IP address to check\n   186→\n   187→  ## Returns\n   188→  - `true` if IP is in range and not excluded, `false` otherwise\n   189→  \"\"\"\n   190→  @spec in_range?(pool_config(), ip_address()) :: boolean()\n   191→  def in_range?(pool, ip) do\n   192→    ip_int = ip_to_integer(ip)\n   193→\n   194→    # Check if IP is in any of the allowed ranges\n   195→    in_allowed_range =\n   196→      Enum.any?(pool.ranges, fn {start_ip, end_ip} ->\n   197→        start_int = ip_to_integer(start_ip)\n   198→        end_int = ip_to_integer(end_ip)\n   199→        start_int <= ip_int and ip_int <= end_int\n   200→      end)\n   201→\n   202→    # If in allowed range, check if it's not in excluded ranges\n   203→    if in_allowed_range do\n   204→      not in_excluded_range?(pool.excluded_ranges, ip_int)\n   205→    else\n   206→      false\n   207→    end\n   208→  end\n   209→\n   210→  @doc \"\"\"\n   211→  Gets static reservation for a MAC address.\n   212→\n   213→  ## Parameters\n   214→  - `pool` - Pool configuration\n   215→  - `mac` - MAC address to look up\n   216→\n   217→  ## Returns\n   218→  - `{:ok, ip}` - Static IP for this MAC\n   219→  - `:not_found` - No static reservation\n   220→  \"\"\"\n   221→  @spec get_static_reservation(pool_config(), mac_address()) ::\n   222→          {:ok, ip_address()} | :not_found\n   223→  def get_static_reservation(pool, mac) do\n   224→    case Map.get(pool.static_reservations, format_mac(mac)) do\n   225→      nil -> :not_found\n   226→      ip -> {:ok, ip}\n   227→    end\n   228→  end\n   229→\n   230→  @doc \"\"\"\n   231→  Counts total addresses in the pool across all ranges, minus excluded ranges.\n   232→\n   233→  ## Parameters\n   234→  - `pool` - Pool configuration\n   235→\n   236→  ## Returns\n   237→  - Total number of usable addresses in the pool\n   238→  \"\"\"\n   239→  @spec pool_size(pool_config()) :: non_neg_integer()\n   240→  def pool_size(pool) do\n   241→    # Count total addresses in all ranges\n   242→    total_in_ranges =\n   243→      Enum.reduce(pool.ranges, 0, fn {start_ip, end_ip}, acc ->\n   244→        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n   245→        acc + size\n   246→      end)\n   247→\n   248→    # Count addresses in excluded ranges\n   249→    total_excluded =\n   250→      Enum.reduce(pool.excluded_ranges, 0, fn {start_ip, end_ip}, acc ->\n   251→        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n   252→        acc + size\n   253→      end)\n   254→\n   255→    max(total_in_ranges - total_excluded, 0)\n   256→  end\n   257→\n   258→  # Private helper functions\n   259→\n   260→  defp build_ranges(_config, validated_config) do\n   261→    cond do\n   262→      # New format with multiple ranges\n   263→      Map.has_key?(validated_config, :ranges) ->\n   264→        validated_config.ranges\n   265→\n   266→      # Legacy format with single range\n   267→      Map.has_key?(validated_config, :range_start) ->\n   268→        [{validated_config.range_start, validated_config.range_end}]\n   269→\n   270→      true ->\n   271→        # Should not happen due to validation\n   272→        []\n   273→    end\n   274→  end\n   275→\n   276→  defp build_excluded_ranges(config) do\n   277→    case Map.get(config, :excluded_ranges) do\n   278→      nil ->\n   279→        []\n   280→\n   281→      excluded when is_list(excluded) ->\n   282→        Enum.map(excluded, fn\n   283→          {start_ip, end_ip} when is_tuple(start_ip) and is_tuple(end_ip) ->\n   284→            {start_ip, end_ip}\n   285→\n   286→          %{start: start, end: end_ip} ->\n   287→            {:ok, start_ip} = normalize_ip(start)\n   288→            {:ok, end_ip_tuple} = normalize_ip(end_ip)\n   289→            {start_ip, end_ip_tuple}\n   290→\n   291→          _ ->\n   292→            nil\n   293→        end)\n   294→        |> Enum.reject(&is_nil/1)\n   295→\n   296→      _ ->\n   297→        []\n   298→    end\n   299→  end\n   300→\n   301→  defp find_next_available_in_ranges(ranges, excluded_ranges, allocated_ips) do\n   302→    # Try each range until we find an available IP\n   303→    Enum.reduce_while(ranges, {:error, :pool_exhausted}, fn {start_ip, end_ip}, _acc ->\n   304→      case find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n   305→        {:ok, ip} ->\n   306→          {:halt, {:ok, ip}}\n   307→\n   308→        {:error, :pool_exhausted} ->\n   309→          {:cont, {:error, :pool_exhausted}}\n   310→      end\n   311→    end)\n   312→  end\n   313→\n   314→  defp in_excluded_range?([], _ip_int), do: false\n   315→\n   316→  defp in_excluded_range?(excluded_ranges, ip_int) do\n   317→    Enum.any?(excluded_ranges, fn {start_ip, end_ip} ->\n   318→      start_int = ip_to_integer(start_ip)\n   319→      end_int = ip_to_integer(end_ip)\n   320→      start_int <= ip_int and ip_int <= end_int\n   321→    end)\n   322→  end\n   323→\n   324→  defp normalize_ip(ip) when is_tuple(ip) and tuple_size(ip) == 4, do: {:ok, ip}\n   325→  defp normalize_ip(ip) when is_binary(ip), do: parse_ip_string(ip)\n   326→  defp normalize_ip(_), do: {:error, \"Invalid IP format\"}\n   327→\n   328→  defp get_required_ip(config, key) do\n   329→    case Map.get(config, key) do\n   330→      nil ->\n   331→        {:error, \"Missing required field: #{key}\"}\n   332→\n   333→      ip when is_tuple(ip) and tuple_size(ip) == 4 ->\n   334→        {:ok, ip}\n   335→\n   336→      ip when is_binary(ip) ->\n   337→        parse_ip_string(ip)\n   338→\n   339→      _ ->\n   340→        {:error, \"Invalid IP address format for #{key}\"}\n   341→    end\n   342→  end\n   343→\n   344→  defp validate_range_order(start_ip, end_ip) do\n   345→    if ip_to_integer(start_ip) <= ip_to_integer(end_ip) do\n   346→      :ok\n   347→    else\n   348→      {:error, \"range_start must be less than or equal to range_end\"}\n   349→    end\n   350→  end\n   351→\n   352→  defp find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n   353→    start_int = ip_to_integer(start_ip)\n   354→    end_int = ip_to_integer(end_ip)\n   355→\n   356→    result =\n   357→      Enum.find(start_int..end_int, fn ip_int ->\n   358→        ip = integer_to_ip(ip_int)\n   359→\n   360→        not MapSet.member?(allocated_ips, ip) and\n   361→          not in_excluded_range?(excluded_ranges, ip_int)\n   362→      end)\n   363→\n   364→    case result do\n   365→      nil ->\n   366→        {:error, :pool_exhausted}\n   367→\n   368→      ip_int ->\n   369→        {:ok, integer_to_ip(ip_int)}\n   370→    end\n   371→  end\n   372→\n   373→  defp ip_to_integer({a, b, c, d}) do\n   374→    a * 256 * 256 * 256 + b * 256 * 256 + c * 256 + d\n   375→  end\n   376→\n   377→  defp integer_to_ip(int) do\n   378→    a = div(int, 256 * 256 * 256)\n   379→    b = div(rem(int, 256 * 256 * 256), 256 * 256)\n   380→    c = div(rem(int, 256 * 256), 256)\n   381→    d = rem(int, 256)\n   382→    {a, b, c, d}\n   383→  end\n   384→\n   385→  defp parse_ip_string(ip_string) do\n   386→    case String.split(ip_string, \".\") do\n   387→      [a, b, c, d] ->\n   388→        try do\n   389→          {:ok,\n   390→           {String.to_integer(a), String.to_integer(b), String.to_integer(c),\n   391→            String.to_integer(d)}}\n   392→        rescue\n   393→          _ -> {:error, \"Invalid IP address string: #{ip_string}\"}\n   394→        end\n   395→\n   396→      _ ->\n   397→        {:error, \"Invalid IP address string format: #{ip_string}\"}\n   398→    end\n   399→  end\n   400→\n   401→  defp format_mac(<<mac::binary-size(6)>>) do\n   402→    mac\n   403→    |> :binary.bin_to_list()\n   404→    |> Enum.map(&Integer.to_string(&1, 16))\n   405→    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n   406→    |> Enum.join(\":\")\n   407→    |> String.upcase()\n   408→  end\n   409→\n   410→  defp format_mac(_), do: \"UNKNOWN\"\n   411→end\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8559038-3d53-47df-9b7a-d16bbb068c80","uuid":"f67074b7-f67e-49b6-9fa5-b2b7d9f920c2","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/address_pool.ex","content":"defmodule YellowDog.Dhcpv4.AddressPool do\n  @moduledoc \"\"\"\n  IP address pool management for DHCPv4.\n\n  Manages IP address ranges, allocation, and availability tracking.\n  Supports multiple pools, static reservations, and address conflict detection.\n  \"\"\"\n\n  @type ip_address :: {0..255, 0..255, 0..255, 0..255}\n  @type mac_address :: binary()\n  @type ip_range :: {ip_address(), ip_address()}\n  @type pool_config :: %{\n          name: String.t(),\n          ranges: [ip_range()],\n          # Legacy support - converted to ranges\n          range_start: ip_address() | nil,\n          range_end: ip_address() | nil,\n          excluded_ranges: [ip_range()],\n          subnet_mask: ip_address(),\n          gateway: ip_address(),\n          dns_servers: [ip_address()],\n          domain_name: String.t() | nil,\n          lease_time: pos_integer()\n        }\n\n  @doc \"\"\"\n  Creates a new address pool from configuration.\n\n  ## Parameters\n  - `config` - Pool configuration map\n\n  ## Returns\n  - `{:ok, pool}` - Successfully created pool\n  - `{:error, reason}` - Failed to create pool\n\n  ## Example\n      iex> config = %{\n      ...>   name: \"main\",\n      ...>   range_start: {192, 168, 1, 100},\n      ...>   range_end: {192, 168, 1, 200},\n      ...>   subnet_mask: {255, 255, 255, 0},\n      ...>   gateway: {192, 168, 1, 1},\n      ...>   dns_servers: [{192, 168, 1, 1}],\n      ...>   domain_name: \"local\",\n      ...>   lease_time: 86400\n      ...> }\n      iex> YellowDog.Dhcpv4.AddressPool.new(config)\n      {:ok, %{...}}\n  \"\"\"\n  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n  def new(config) do\n    with {:ok, validated_config} <- validate_pool_config(config) do\n      # Support both legacy (range_start/range_end) and new (ranges) format\n      ranges = build_ranges(config, validated_config)\n      excluded_ranges = build_excluded_ranges(config)\n\n      # Get first range for defaults\n      {first_range_start, _} = hd(ranges)\n\n      pool = %{\n        name: Map.get(config, :name, \"default\"),\n        ranges: ranges,\n        range_start: validated_config[:range_start],\n        range_end: validated_config[:range_end],\n        excluded_ranges: excluded_ranges,\n        subnet_mask: Map.get(config, :subnet_mask, {255, 255, 255, 0}),\n        gateway: Map.get(config, :gateway, first_range_start),\n        dns_servers: Map.get(config, :dns_servers, [first_range_start]),\n        domain_name: Map.get(config, :domain_name),\n        lease_time: Map.get(config, :lease_time, 86400),\n        static_reservations: Map.get(config, :static_reservations, %{})\n      }\n\n      {:ok, pool}\n    end\n  end\n\n  @doc \"\"\"\n  Validates pool configuration.\n\n  Supports both legacy format (range_start/range_end) and new format (ranges).\n\n  ## Parameters\n  - `config` - Pool configuration to validate\n\n  ## Returns\n  - `{:ok, config}` - Valid configuration\n  - `{:error, reason}` - Invalid configuration\n  \"\"\"\n  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n  def validate_pool_config(config) do\n    cond do\n      # New format with ranges\n      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n        validate_ranges_config(config)\n\n      # Legacy format with range_start/range_end\n      Map.has_key?(config, :range_start) || Map.has_key?(config, \"range_start\") ->\n        validate_legacy_config(config)\n\n      true ->\n        {:error, \"Must specify either :ranges or :range_start/:range_end\"}\n    end\n  end\n\n  defp validate_legacy_config(config) do\n    with {:ok, range_start} <- get_required_ip(config, :range_start),\n         {:ok, range_end} <- get_required_ip(config, :range_end),\n         :ok <- validate_range_order(range_start, range_end) do\n      {:ok, %{range_start: range_start, range_end: range_end}}\n    end\n  end\n\n  defp validate_ranges_config(config) do\n    ranges = config.ranges\n\n    # Validate each range\n    validated_ranges =\n      Enum.reduce_while(ranges, {:ok, []}, fn range_config, {:ok, acc} ->\n        case validate_single_range(range_config) do\n          {:ok, validated_range} ->\n            {:cont, {:ok, [validated_range | acc]}}\n\n          {:error, reason} ->\n            {:halt, {:error, reason}}\n        end\n      end)\n\n    case validated_ranges do\n      {:ok, ranges_list} ->\n        {:ok, %{ranges: Enum.reverse(ranges_list)}}\n\n      error ->\n        error\n    end\n  end\n\n  defp validate_single_range({start_ip, end_ip}) when is_tuple(start_ip) and is_tuple(end_ip) do\n    with :ok <- validate_range_order(start_ip, end_ip) do\n      {:ok, {start_ip, end_ip}}\n    end\n  end\n\n  defp validate_single_range(%{start: start, end: end_ip}) do\n    with {:ok, start_ip} <- normalize_ip(start),\n         {:ok, end_ip_val} <- normalize_ip(end_ip),\n         :ok <- validate_range_order(start_ip, end_ip_val) do\n      {:ok, {start_ip, end_ip_val}}\n    end\n  end\n\n  defp validate_single_range(_), do: {:error, \"Invalid range format\"}\n\n  @doc \"\"\"\n  Gets the next available IP address from the pool.\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `allocated_ips` - Set of already allocated IP addresses\n  - `mac` - MAC address requesting the IP (for static reservation check)\n\n  ## Returns\n  - `{:ok, ip}` - Available IP address\n  - `{:error, :pool_exhausted}` - No available addresses\n  \"\"\"\n  @spec get_available_ip(pool_config(), MapSet.t(ip_address()), mac_address()) ::\n          {:ok, ip_address()} | {:error, :pool_exhausted}\n  def get_available_ip(pool, allocated_ips, mac) do\n    # Check for static reservation first\n    case get_static_reservation(pool, mac) do\n      {:ok, ip} ->\n        {:ok, ip}\n\n      :not_found ->\n        # Find next available IP across all ranges, excluding excluded ranges\n        find_next_available_in_ranges(pool.ranges, pool.excluded_ranges, allocated_ips)\n    end\n  end\n\n  @doc \"\"\"\n  Checks if an IP address is within any of the pool ranges (and not in excluded ranges).\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `ip` - IP address to check\n\n  ## Returns\n  - `true` if IP is in range and not excluded, `false` otherwise\n  \"\"\"\n  @spec in_range?(pool_config(), ip_address()) :: boolean()\n  def in_range?(pool, ip) do\n    ip_int = ip_to_integer(ip)\n\n    # Check if IP is in any of the allowed ranges\n    in_allowed_range =\n      Enum.any?(pool.ranges, fn {start_ip, end_ip} ->\n        start_int = ip_to_integer(start_ip)\n        end_int = ip_to_integer(end_ip)\n        start_int <= ip_int and ip_int <= end_int\n      end)\n\n    # If in allowed range, check if it's not in excluded ranges\n    if in_allowed_range do\n      not in_excluded_range?(pool.excluded_ranges, ip_int)\n    else\n      false\n    end\n  end\n\n  @doc \"\"\"\n  Gets static reservation for a MAC address.\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `mac` - MAC address to look up\n\n  ## Returns\n  - `{:ok, ip}` - Static IP for this MAC\n  - `:not_found` - No static reservation\n  \"\"\"\n  @spec get_static_reservation(pool_config(), mac_address()) ::\n          {:ok, ip_address()} | :not_found\n  def get_static_reservation(pool, mac) do\n    case Map.get(pool.static_reservations, format_mac(mac)) do\n      nil -> :not_found\n      ip -> {:ok, ip}\n    end\n  end\n\n  @doc \"\"\"\n  Counts total addresses in the pool across all ranges, minus excluded ranges.\n\n  ## Parameters\n  - `pool` - Pool configuration\n\n  ## Returns\n  - Total number of usable addresses in the pool\n  \"\"\"\n  @spec pool_size(pool_config()) :: non_neg_integer()\n  def pool_size(pool) do\n    # Count total addresses in all ranges\n    total_in_ranges =\n      Enum.reduce(pool.ranges, 0, fn {start_ip, end_ip}, acc ->\n        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n        acc + size\n      end)\n\n    # Count addresses in excluded ranges\n    total_excluded =\n      Enum.reduce(pool.excluded_ranges, 0, fn {start_ip, end_ip}, acc ->\n        size = ip_to_integer(end_ip) - ip_to_integer(start_ip) + 1\n        acc + size\n      end)\n\n    max(total_in_ranges - total_excluded, 0)\n  end\n\n  # Private helper functions\n\n  defp build_ranges(_config, validated_config) do\n    cond do\n      # New format with multiple ranges\n      Map.has_key?(validated_config, :ranges) ->\n        validated_config.ranges\n\n      # Legacy format with single range\n      Map.has_key?(validated_config, :range_start) ->\n        [{validated_config.range_start, validated_config.range_end}]\n\n      true ->\n        # Should not happen due to validation\n        []\n    end\n  end\n\n  defp build_excluded_ranges(config) do\n    case Map.get(config, :excluded_ranges) do\n      nil ->\n        []\n\n      excluded when is_list(excluded) ->\n        Enum.map(excluded, fn\n          {start_ip, end_ip} when is_tuple(start_ip) and is_tuple(end_ip) ->\n            {start_ip, end_ip}\n\n          %{start: start, end: end_ip} ->\n            {:ok, start_ip} = normalize_ip(start)\n            {:ok, end_ip_tuple} = normalize_ip(end_ip)\n            {start_ip, end_ip_tuple}\n\n          _ ->\n            nil\n        end)\n        |> Enum.reject(&is_nil/1)\n\n      _ ->\n        []\n    end\n  end\n\n  defp find_next_available_in_ranges(ranges, excluded_ranges, allocated_ips) do\n    # Try each range until we find an available IP\n    Enum.reduce_while(ranges, {:error, :pool_exhausted}, fn {start_ip, end_ip}, _acc ->\n      case find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n        {:ok, ip} ->\n          {:halt, {:ok, ip}}\n\n        {:error, :pool_exhausted} ->\n          {:cont, {:error, :pool_exhausted}}\n      end\n    end)\n  end\n\n  defp in_excluded_range?([], _ip_int), do: false\n\n  defp in_excluded_range?(excluded_ranges, ip_int) do\n    Enum.any?(excluded_ranges, fn {start_ip, end_ip} ->\n      start_int = ip_to_integer(start_ip)\n      end_int = ip_to_integer(end_ip)\n      start_int <= ip_int and ip_int <= end_int\n    end)\n  end\n\n  defp normalize_ip(ip) when is_tuple(ip) and tuple_size(ip) == 4, do: {:ok, ip}\n  defp normalize_ip(ip) when is_binary(ip), do: parse_ip_string(ip)\n  defp normalize_ip(_), do: {:error, \"Invalid IP format\"}\n\n  defp get_required_ip(config, key) do\n    case Map.get(config, key) do\n      nil ->\n        {:error, \"Missing required field: #{key}\"}\n\n      ip when is_tuple(ip) and tuple_size(ip) == 4 ->\n        {:ok, ip}\n\n      ip when is_binary(ip) ->\n        parse_ip_string(ip)\n\n      _ ->\n        {:error, \"Invalid IP address format for #{key}\"}\n    end\n  end\n\n  defp validate_range_order(start_ip, end_ip) do\n    if ip_to_integer(start_ip) <= ip_to_integer(end_ip) do\n      :ok\n    else\n      {:error, \"range_start must be less than or equal to range_end\"}\n    end\n  end\n\n  defp find_next_available(start_ip, end_ip, allocated_ips, excluded_ranges) do\n    start_int = ip_to_integer(start_ip)\n    end_int = ip_to_integer(end_ip)\n\n    result =\n      Enum.find(start_int..end_int, fn ip_int ->\n        ip = integer_to_ip(ip_int)\n\n        not MapSet.member?(allocated_ips, ip) and\n          not in_excluded_range?(excluded_ranges, ip_int)\n      end)\n\n    case result do\n      nil ->\n        {:error, :pool_exhausted}\n\n      ip_int ->\n        {:ok, integer_to_ip(ip_int)}\n    end\n  end\n\n  defp ip_to_integer({a, b, c, d}) do\n    a * 256 * 256 * 256 + b * 256 * 256 + c * 256 + d\n  end\n\n  defp integer_to_ip(int) do\n    a = div(int, 256 * 256 * 256)\n    b = div(rem(int, 256 * 256 * 256), 256 * 256)\n    c = div(rem(int, 256 * 256), 256)\n    d = rem(int, 256)\n    {a, b, c, d}\n  end\n\n  defp parse_ip_string(ip_string) do\n    case String.split(ip_string, \".\") do\n      [a, b, c, d] ->\n        try do\n          {:ok,\n           {String.to_integer(a), String.to_integer(b), String.to_integer(c),\n            String.to_integer(d)}}\n        rescue\n          _ -> {:error, \"Invalid IP address string: #{ip_string}\"}\n        end\n\n      _ ->\n        {:error, \"Invalid IP address string format: #{ip_string}\"}\n    end\n  end\n\n  defp format_mac(<<mac::binary-size(6)>>) do\n    mac\n    |> :binary.bin_to_list()\n    |> Enum.map(&Integer.to_string(&1, 16))\n    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n    |> Enum.join(\":\")\n    |> String.upcase()\n  end\n\n  defp format_mac(_), do: \"UNKNOWN\"\nend\n","numLines":412,"startLine":1,"totalLines":412}}}
