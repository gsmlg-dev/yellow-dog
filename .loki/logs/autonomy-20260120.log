    55→      file_path = Path.join(tmp_dir, \"services.json\")\n    56→      File.write!(file_path, json_content)\n    57→\n    58→      assert {:ok, services} = ServiceStore.load_services(file_path)\n    59→      assert length(services) == 1\n    60→\n    61→      service = hd(services)\n    62→      assert service.name == \"SSH Server\"\n    63→      assert service.type == \"_ssh._tcp\"\n    64→      assert service.port == 22\n    65→      assert service.addresses == [\"192.168.1.100\", \"fe80::1\"]\n    66→    end\n    67→\n    68→    test \"handles missing file gracefully\", %{tmp_dir: tmp_dir} do\n    69→      file_path = Path.join(tmp_dir, \"nonexistent.toml\")\n    70→      assert {:ok, []} = ServiceStore.load_services(file_path)\n    71→    end\n    72→\n    73→    test \"handles invalid TOML\", %{tmp_dir: tmp_dir} do\n    74→      invalid_toml = \"this is not valid TOML [[\"\n    75→\n    76→      file_path = Path.join(tmp_dir, \"invalid.toml\")\n    77→      File.write!(file_path, invalid_toml)\n    78→\n    79→      assert {:error, _reason} = ServiceStore.load_services(file_path)\n    80→    end\n    81→\n    82→    test \"filters out invalid services\", %{tmp_dir: tmp_dir} do\n    83→      toml_content = \"\"\"\n    84→      [[service]]\n    85→      name = \"Valid Service\"\n    86→      type = \"_http._tcp\"\n    87→      port = 8080\n    88→\n    89→      [[service]]\n    90→      name = \"Invalid Service\"\n    91→      # Missing type and port\n    92→      \"\"\"\n    93→\n    94→      file_path = Path.join(tmp_dir, \"mixed.toml\")\n    95→      File.write!(file_path, toml_content)\n    96→\n    97→      assert {:ok, services} = ServiceStore.load_services(file_path)\n    98→      assert length(services) == 1\n    99→      assert hd(services).name == \"Valid Service\"\n   100→    end\n   101→\n   102→    test \"handles nested addresses structure\", %{tmp_dir: tmp_dir} do\n   103→      toml_content = \"\"\"\n   104→      [[service]]\n   105→      name = \"Multi-address Service\"\n   106→      type = \"_http._tcp\"\n   107→      port = 8080\n   108→\n   109→        [service.addresses]\n   110→        ipv4 = [\"192.168.1.100\", \"192.168.1.101\"]\n   111→        ipv6 = [\"fe80::1\", \"fe80::2\"]\n   112→      \"\"\"\n   113→\n   114→      file_path = Path.join(tmp_dir, \"services.toml\")\n   115→      File.write!(file_path, toml_content)\n   116→\n   117→      assert {:ok, services} = ServiceStore.load_services(file_path)\n   118→      service = hd(services)\n   119→\n   120→      assert length(service.addresses) == 4\n   121→      assert \"192.168.1.100\" in service.addresses\n   122→      assert \"fe80::1\" in service.addresses\n   123→    end\n   124→  end\n   125→\n   126→  describe \"save_services/3\" do\n   127→    test \"saves services to TOML file\", %{tmp_dir: tmp_dir} do\n   128→      services = [\n   129→        %{\n   130→          name: \"Test Service\",\n   131→          type: \"_test._tcp\",\n   132→          port: 9999,\n   133→          txt: %{\"key\" => \"value\"},\n   134→          addresses: [\"192.168.1.100\"],\n   135→          enabled: true\n   136→        }\n   137→      ]\n   138→\n   139→      file_path = Path.join(tmp_dir, \"output.toml\")\n   140→\n   141→      assert :ok = ServiceStore.save_services(file_path, services)\n   142→      assert File.exists?(file_path)\n   143→\n   144→      # Verify we can load it back\n   145→      assert {:ok, loaded} = ServiceStore.load_services(file_path)\n   146→      assert length(loaded) == 1\n   147→      assert hd(loaded).name == \"Test Service\"\n   148→    end\n   149→\n   150→    test \"saves services to JSON file\", %{tmp_dir: tmp_dir} do\n   151→      services = [\n   152→        %{\n   153→          name: \"Test Service\",\n   154→          type: \"_test._tcp\",\n   155→          port: 9999,\n   156→          enabled: true\n   157→        }\n   158→      ]\n   159→\n   160→      file_path = Path.join(tmp_dir, \"output.json\")\n   161→\n   162→      assert :ok = ServiceStore.save_services(file_path, services, format: :json)\n   163→      assert File.exists?(file_path)\n   164→\n   165→      # Verify we can load it back\n   166→      assert {:ok, loaded} = ServiceStore.load_services(file_path)\n   167→      assert length(loaded) == 1\n   168→    end\n   169→\n   170→    test \"creates backup of existing file\", %{tmp_dir: tmp_dir} do\n   171→      file_path = Path.join(tmp_dir, \"services.toml\")\n   172→      backup_path = file_path <> \".backup\"\n   173→\n   174→      # Create initial file\n   175→      File.write!(file_path, \"[[service]]\\nname = \\\"Old\\\"\\ntype = \\\"_old._tcp\\\"\\nport = 8080\")\n   176→\n   177→      services = [\n   178→        %{name: \"New\", type: \"_new._tcp\", port: 9090, enabled: true}\n   179→      ]\n   180→\n   181→      assert :ok = ServiceStore.save_services(file_path, services)\n   182→      assert File.exists?(backup_path)\n   183→\n   184→      # Verify backup contains old data\n   185→      assert {:ok, backup_content} = File.read(backup_path)\n   186→      assert String.contains?(backup_content, \"Old\")\n   187→    end\n   188→\n   189→    test \"performs atomic write\", %{tmp_dir: tmp_dir} do\n   190→      file_path = Path.join(tmp_dir, \"atomic.toml\")\n   191→      tmp_path = file_path <> \".tmp\"\n   192→\n   193→      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n   194→\n   195→      assert :ok = ServiceStore.save_services(file_path, services)\n   196→      # Temp file should be cleaned up\n   197→      refute File.exists?(tmp_path)\n   198→      assert File.exists?(file_path)\n   199→    end\n   200→  end\n   201→\n   202→  describe \"validate_service/1\" do\n   203→    test \"validates service with all required fields\" do\n   204→      service = %{\n   205→        name: \"Valid Service\",\n   206→        type: \"_http._tcp\",\n   207→        port: 8080\n   208→      }\n   209→\n   210→      assert :ok = ServiceStore.validate_service(service)\n   211→    end\n   212→\n   213→    test \"rejects service with missing name\" do\n   214→      service = %{type: \"_http._tcp\", port: 8080}\n   215→      assert {:error, reason} = ServiceStore.validate_service(service)\n   216→      assert reason =~ \"name\"\n   217→    end\n   218→\n   219→    test \"rejects service with missing type\" do\n   220→      service = %{name: \"Test\", port: 8080}\n   221→      assert {:error, reason} = ServiceStore.validate_service(service)\n   222→      assert reason =~ \"type\"\n   223→    end\n   224→\n   225→    test \"rejects service with missing port\" do\n   226→      service = %{name: \"Test\", type: \"_http._tcp\"}\n   227→      assert {:error, reason} = ServiceStore.validate_service(service)\n   228→      assert reason =~ \"port\"\n   229→    end\n   230→\n   231→    test \"rejects service with invalid name\" do\n   232→      service = %{name: \"\", type: \"_http._tcp\", port: 8080}\n   233→      assert {:error, _reason} = ServiceStore.validate_service(service)\n   234→    end\n   235→\n   236→    test \"rejects service with invalid type\" do\n   237→      service = %{name: \"Test\", type: \"http\", port: 8080}\n   238→      assert {:error, reason} = ServiceStore.validate_service(service)\n   239→      assert reason =~ \"type must start with\"\n   240→    end\n   241→\n   242→    test \"rejects service with invalid port\" do\n   243→      service = %{name: \"Test\", type: \"_http._tcp\", port: 99999}\n   244→      assert {:error, reason} = ServiceStore.validate_service(service)\n   245→      assert reason =~ \"Port\"\n   246→    end\n   247→\n   248→    test \"rejects service with invalid IP addresses\" do\n   249→      service = %{\n   250→        name: \"Test\",\n   251→        type: \"_http._tcp\",\n   252→        port: 8080,\n   253→        addresses: [\"not-an-ip\"]\n   254→      }\n   255→\n   256→      assert {:error, reason} = ServiceStore.validate_service(service)\n   257→      assert reason =~ \"Invalid IP\"\n   258→    end\n   259→\n   260→    test \"accepts service with valid IPv4 addresses\" do\n   261→      service = %{\n   262→        name: \"Test\",\n   263→        type: \"_http._tcp\",\n   264→        port: 8080,\n   265→        addresses: [\"192.168.1.1\", \"10.0.0.1\"]\n   266→      }\n   267→\n   268→      assert :ok = ServiceStore.validate_service(service)\n   269→    end\n   270→\n   271→    test \"accepts service with valid IPv6 addresses\" do\n   272→      service = %{\n   273→        name: \"Test\",\n   274→        type: \"_http._tcp\",\n   275→        port: 8080,\n   276→        addresses: [\"fe80::1\", \"2001:db8::1\"]\n   277→      }\n   278→\n   279→      assert :ok = ServiceStore.validate_service(service)\n   280→    end\n   281→\n   282→    test \"accepts service with TXT records\" do\n   283→      service = %{\n   284→        name: \"Test\",\n   285→        type: \"_http._tcp\",\n   286→        port: 8080,\n   287→        txt: %{\"key\" => \"value\", \"version\" => \"1.0\"}\n   288→      }\n   289→\n   290→      assert :ok = ServiceStore.validate_service(service)\n   291→    end\n   292→  end\n   293→\n   294→  describe \"format detection\" do\n   295→    test \"auto-detects TOML from extension\", %{tmp_dir: tmp_dir} do\n   296→      toml_path = Path.join(tmp_dir, \"test.toml\")\n   297→      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n   298→\n   299→      :ok = ServiceStore.save_services(toml_path, services)\n   300→      {:ok, content} = File.read(toml_path)\n   301→      # TOML should contain [[service]]\n   302→      assert String.contains?(content, \"[[service]]\")\n   303→    end\n   304→\n   305→    test \"auto-detects JSON from extension\", %{tmp_dir: tmp_dir} do\n   306→      json_path = Path.join(tmp_dir, \"test.json\")\n   307→      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n   308→\n   309→      :ok = ServiceStore.save_services(json_path, services)\n   310→      {:ok, content} = File.read(json_path)\n   311→      # JSON should contain \"services\"\n   312→      assert String.contains?(content, \"\\\"services\\\"\")\n   313→    end\n   314→\n   315→    test \"uses explicit format option\", %{tmp_dir: tmp_dir} do\n   316→      # Save as JSON even though extension is .txt\n   317→      txt_path = Path.join(tmp_dir, \"test.txt\")\n   318→      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n   319→\n   320→      :ok = ServiceStore.save_services(txt_path, services, format: :json)\n   321→      {:ok, content} = File.read(txt_path)\n   322→      assert String.contains?(content, \"\\\"services\\\"\")\n   323→    end\n   324→  end\n   325→end\n   326→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb21cfce-0067-4926-ae35-eac907707d9d","uuid":"dd3a31ed-a2d6-4ca0-8bde-065f9a894c3b","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/test/yellow_dog/mdns/service_store_test.exs","content":"defmodule YellowDog.Mdns.ServiceStoreTest do\n  use ExUnit.Case, async: true\n\n  alias YellowDog.Mdns.ServiceStore\n\n  @moduletag :tmp_dir\n\n  describe \"load_services/2\" do\n    test \"loads services from TOML file\", %{tmp_dir: tmp_dir} do\n      toml_content = \"\"\"\n      [[service]]\n      name = \"Web Server\"\n      type = \"_http._tcp\"\n      port = 8080\n      enabled = true\n\n        [service.txt]\n        path = \"/api\"\n        version = \"1.0\"\n\n        [service.addresses]\n        ipv4 = [\"192.168.1.100\"]\n      \"\"\"\n\n      file_path = Path.join(tmp_dir, \"services.toml\")\n      File.write!(file_path, toml_content)\n\n      assert {:ok, services} = ServiceStore.load_services(file_path)\n      assert length(services) == 1\n\n      service = hd(services)\n      assert service.name == \"Web Server\"\n      assert service.type == \"_http._tcp\"\n      assert service.port == 8080\n      assert service.txt == %{\"path\" => \"/api\", \"version\" => \"1.0\"}\n      assert service.addresses == [\"192.168.1.100\"]\n      assert service.enabled == true\n    end\n\n    test \"loads services from JSON file\", %{tmp_dir: tmp_dir} do\n      json_content = \"\"\"\n      {\n        \"services\": [\n          {\n            \"name\": \"SSH Server\",\n            \"type\": \"_ssh._tcp\",\n            \"port\": 22,\n            \"enabled\": true,\n            \"addresses\": [\"192.168.1.100\", \"fe80::1\"]\n          }\n        ]\n      }\n      \"\"\"\n\n      file_path = Path.join(tmp_dir, \"services.json\")\n      File.write!(file_path, json_content)\n\n      assert {:ok, services} = ServiceStore.load_services(file_path)\n      assert length(services) == 1\n\n      service = hd(services)\n      assert service.name == \"SSH Server\"\n      assert service.type == \"_ssh._tcp\"\n      assert service.port == 22\n      assert service.addresses == [\"192.168.1.100\", \"fe80::1\"]\n    end\n\n    test \"handles missing file gracefully\", %{tmp_dir: tmp_dir} do\n      file_path = Path.join(tmp_dir, \"nonexistent.toml\")\n      assert {:ok, []} = ServiceStore.load_services(file_path)\n    end\n\n    test \"handles invalid TOML\", %{tmp_dir: tmp_dir} do\n      invalid_toml = \"this is not valid TOML [[\"\n\n      file_path = Path.join(tmp_dir, \"invalid.toml\")\n      File.write!(file_path, invalid_toml)\n\n      assert {:error, _reason} = ServiceStore.load_services(file_path)\n    end\n\n    test \"filters out invalid services\", %{tmp_dir: tmp_dir} do\n      toml_content = \"\"\"\n      [[service]]\n      name = \"Valid Service\"\n      type = \"_http._tcp\"\n      port = 8080\n\n      [[service]]\n      name = \"Invalid Service\"\n      # Missing type and port\n      \"\"\"\n\n      file_path = Path.join(tmp_dir, \"mixed.toml\")\n      File.write!(file_path, toml_content)\n\n      assert {:ok, services} = ServiceStore.load_services(file_path)\n      assert length(services) == 1\n      assert hd(services).name == \"Valid Service\"\n    end\n\n    test \"handles nested addresses structure\", %{tmp_dir: tmp_dir} do\n      toml_content = \"\"\"\n      [[service]]\n      name = \"Multi-address Service\"\n      type = \"_http._tcp\"\n      port = 8080\n\n        [service.addresses]\n        ipv4 = [\"192.168.1.100\", \"192.168.1.101\"]\n        ipv6 = [\"fe80::1\", \"fe80::2\"]\n      \"\"\"\n\n      file_path = Path.join(tmp_dir, \"services.toml\")\n      File.write!(file_path, toml_content)\n\n      assert {:ok, services} = ServiceStore.load_services(file_path)\n      service = hd(services)\n\n      assert length(service.addresses) == 4\n      assert \"192.168.1.100\" in service.addresses\n      assert \"fe80::1\" in service.addresses\n    end\n  end\n\n  describe \"save_services/3\" do\n    test \"saves services to TOML file\", %{tmp_dir: tmp_dir} do\n      services = [\n        %{\n          name: \"Test Service\",\n          type: \"_test._tcp\",\n          port: 9999,\n          txt: %{\"key\" => \"value\"},\n          addresses: [\"192.168.1.100\"],\n          enabled: true\n        }\n      ]\n\n      file_path = Path.join(tmp_dir, \"output.toml\")\n\n      assert :ok = ServiceStore.save_services(file_path, services)\n      assert File.exists?(file_path)\n\n      # Verify we can load it back\n      assert {:ok, loaded} = ServiceStore.load_services(file_path)\n      assert length(loaded) == 1\n      assert hd(loaded).name == \"Test Service\"\n    end\n\n    test \"saves services to JSON file\", %{tmp_dir: tmp_dir} do\n      services = [\n        %{\n          name: \"Test Service\",\n          type: \"_test._tcp\",\n          port: 9999,\n          enabled: true\n        }\n      ]\n\n      file_path = Path.join(tmp_dir, \"output.json\")\n\n      assert :ok = ServiceStore.save_services(file_path, services, format: :json)\n      assert File.exists?(file_path)\n\n      # Verify we can load it back\n      assert {:ok, loaded} = ServiceStore.load_services(file_path)\n      assert length(loaded) == 1\n    end\n\n    test \"creates backup of existing file\", %{tmp_dir: tmp_dir} do\n      file_path = Path.join(tmp_dir, \"services.toml\")\n      backup_path = file_path <> \".backup\"\n\n      # Create initial file\n      File.write!(file_path, \"[[service]]\\nname = \\\"Old\\\"\\ntype = \\\"_old._tcp\\\"\\nport = 8080\")\n\n      services = [\n        %{name: \"New\", type: \"_new._tcp\", port: 9090, enabled: true}\n      ]\n\n      assert :ok = ServiceStore.save_services(file_path, services)\n      assert File.exists?(backup_path)\n\n      # Verify backup contains old data\n      assert {:ok, backup_content} = File.read(backup_path)\n      assert String.contains?(backup_content, \"Old\")\n    end\n\n    test \"performs atomic write\", %{tmp_dir: tmp_dir} do\n      file_path = Path.join(tmp_dir, \"atomic.toml\")\n      tmp_path = file_path <> \".tmp\"\n\n      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n\n      assert :ok = ServiceStore.save_services(file_path, services)\n      # Temp file should be cleaned up\n      refute File.exists?(tmp_path)\n      assert File.exists?(file_path)\n    end\n  end\n\n  describe \"validate_service/1\" do\n    test \"validates service with all required fields\" do\n      service = %{\n        name: \"Valid Service\",\n        type: \"_http._tcp\",\n        port: 8080\n      }\n\n      assert :ok = ServiceStore.validate_service(service)\n    end\n\n    test \"rejects service with missing name\" do\n      service = %{type: \"_http._tcp\", port: 8080}\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"name\"\n    end\n\n    test \"rejects service with missing type\" do\n      service = %{name: \"Test\", port: 8080}\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"type\"\n    end\n\n    test \"rejects service with missing port\" do\n      service = %{name: \"Test\", type: \"_http._tcp\"}\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"port\"\n    end\n\n    test \"rejects service with invalid name\" do\n      service = %{name: \"\", type: \"_http._tcp\", port: 8080}\n      assert {:error, _reason} = ServiceStore.validate_service(service)\n    end\n\n    test \"rejects service with invalid type\" do\n      service = %{name: \"Test\", type: \"http\", port: 8080}\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"type must start with\"\n    end\n\n    test \"rejects service with invalid port\" do\n      service = %{name: \"Test\", type: \"_http._tcp\", port: 99999}\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"Port\"\n    end\n\n    test \"rejects service with invalid IP addresses\" do\n      service = %{\n        name: \"Test\",\n        type: \"_http._tcp\",\n        port: 8080,\n        addresses: [\"not-an-ip\"]\n      }\n\n      assert {:error, reason} = ServiceStore.validate_service(service)\n      assert reason =~ \"Invalid IP\"\n    end\n\n    test \"accepts service with valid IPv4 addresses\" do\n      service = %{\n        name: \"Test\",\n        type: \"_http._tcp\",\n        port: 8080,\n        addresses: [\"192.168.1.1\", \"10.0.0.1\"]\n      }\n\n      assert :ok = ServiceStore.validate_service(service)\n    end\n\n    test \"accepts service with valid IPv6 addresses\" do\n      service = %{\n        name: \"Test\",\n        type: \"_http._tcp\",\n        port: 8080,\n        addresses: [\"fe80::1\", \"2001:db8::1\"]\n      }\n\n      assert :ok = ServiceStore.validate_service(service)\n    end\n\n    test \"accepts service with TXT records\" do\n      service = %{\n        name: \"Test\",\n        type: \"_http._tcp\",\n        port: 8080,\n        txt: %{\"key\" => \"value\", \"version\" => \"1.0\"}\n      }\n\n      assert :ok = ServiceStore.validate_service(service)\n    end\n  end\n\n  describe \"format detection\" do\n    test \"auto-detects TOML from extension\", %{tmp_dir: tmp_dir} do\n      toml_path = Path.join(tmp_dir, \"test.toml\")\n      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n\n      :ok = ServiceStore.save_services(toml_path, services)\n      {:ok, content} = File.read(toml_path)\n      # TOML should contain [[service]]\n      assert String.contains?(content, \"[[service]]\")\n    end\n\n    test \"auto-detects JSON from extension\", %{tmp_dir: tmp_dir} do\n      json_path = Path.join(tmp_dir, \"test.json\")\n      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n\n      :ok = ServiceStore.save_services(json_path, services)\n      {:ok, content} = File.read(json_path)\n      # JSON should contain \"services\"\n      assert String.contains?(content, \"\\\"services\\\"\")\n    end\n\n    test \"uses explicit format option\", %{tmp_dir: tmp_dir} do\n      # Save as JSON even though extension is .txt\n      txt_path = Path.join(tmp_dir, \"test.txt\")\n      services = [%{name: \"Test\", type: \"_test._tcp\", port: 8080, enabled: true}]\n\n      :ok = ServiceStore.save_services(txt_path, services, format: :json)\n      {:ok, content} = File.read(txt_path)\n      assert String.contains?(content, \"\\\"services\\\"\")\n    end\n  end\nend\n","numLines":326,"startLine":1,"totalLines":326}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011BGsi9QbdE8EZQry5S3P7J","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.ServiceRegistryTest do\n     2→  use ExUnit.Case, async: false\n     3→\n     4→  alias YellowDog.Mdns.ServiceRegistry\n     5→  alias DNS.Message.Question\n     6→\n     7→  setup do\n     8→    # Start the registry for each test\n     9→    {:ok, pid} = start_supervised({ServiceRegistry, [load_on_start: false]})\n    10→\n    11→    # Clean up ETS table after each test\n    12→    on_exit(fn ->\n    13→      if Process.alive?(pid) do\n    14→        :ok\n    15→      end\n    16→    end)\n    17→\n    18→    %{registry: pid}\n    19→  end\n    20→\n    21→  describe \"register_service/2\" do\n    22→    test \"registers a new service\" do\n    23→      service_def = %{\n    24→        name: \"Test Web Server\",\n    25→        type: \"_http._tcp\",\n    26→        port: 8080\n    27→      }\n    28→\n    29→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n    30→      assert service_id =~ \"Test Web Server\"\n    31→      assert service_id =~ \"_http._tcp.local\"\n    32→\n    33→      # Verify service can be retrieved\n    34→      service = ServiceRegistry.get_service(service_id)\n    35→      assert service != nil\n    36→      assert service.name == \"Test Web Server\"\n    37→      assert service.port == 8080\n    38→    end\n    39→\n    40→    test \"registers service with TXT records\" do\n    41→      service_def = %{\n    42→        name: \"API Server\",\n    43→        type: \"_http._tcp\",\n    44→        port: 8080,\n    45→        txt: %{\"version\" => \"1.0\", \"path\" => \"/api\"}\n    46→      }\n    47→\n    48→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n    49→      service = ServiceRegistry.get_service(service_id)\n    50→\n    51→      assert service.txt_records == %{\"version\" => \"1.0\", \"path\" => \"/api\"}\n    52→    end\n    53→\n    54→    test \"registers service with addresses\" do\n    55→      service_def = %{\n    56→        name: \"Multi-address Service\",\n    57→        type: \"_http._tcp\",\n    58→        port: 8080,\n    59→        addresses: [\"192.168.1.100\", \"fe80::1\"]\n    60→      }\n    61→\n    62→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n    63→      service = ServiceRegistry.get_service(service_id)\n    64→\n    65→      assert length(service.addresses) == 2\n    66→      assert {192, 168, 1, 100} in service.addresses\n    67→    end\n    68→\n    69→    test \"normalizes service type\" do\n    70→      # Service type without protocol should get _tcp added\n    71→      service_def = %{\n    72→        name: \"Test\",\n    73→        type: \"_myapp\",\n    74→        port: 8080\n    75→      }\n    76→\n    77→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n    78→      service = ServiceRegistry.get_service(service_id)\n    79→\n    80→      assert service.type == \"_myapp._tcp\"\n    81→    end\n    82→\n    83→    test \"sets source to :api by default\" do\n    84→      service_def = %{\n    85→        name: \"Test\",\n    86→        type: \"_http._tcp\",\n    87→        port: 8080\n    88→      }\n    89→\n    90→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n    91→      service = ServiceRegistry.get_service(service_id)\n    92→\n    93→      assert service.source == :api\n    94→    end\n    95→\n    96→    test \"can set source to :file\" do\n    97→      service_def = %{\n    98→        name: \"File Service\",\n    99→        type: \"_http._tcp\",\n   100→        port: 8080\n   101→      }\n   102→\n   103→      assert {:ok, service_id} = ServiceRegistry.register_service(service_def, source: :file)\n   104→      service = ServiceRegistry.get_service(service_id)\n   105→\n   106→      assert service.source == :file\n   107→    end\n   108→\n   109→    test \"rejects invalid service\" do\n   110→      invalid_service = %{\n   111→        name: \"Invalid\",\n   112→        # Missing type and port\n   113→        type: nil,\n   114→        port: nil\n   115→      }\n   116→\n   117→      assert {:error, _reason} = ServiceRegistry.register_service(invalid_service)\n   118→    end\n   119→  end\n   120→\n   121→  describe \"unregister_service/2\" do\n   122→    test \"unregisters an existing service\" do\n   123→      service_def = %{name: \"Temp Service\", type: \"_http._tcp\", port: 8080}\n   124→\n   125→      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n   126→      assert ServiceRegistry.get_service(service_id) != nil\n   127→\n   128→      assert :ok = ServiceRegistry.unregister_service(service_id)\n   129→      assert ServiceRegistry.get_service(service_id) == nil\n   130→    end\n   131→\n   132→    test \"returns error for non-existent service\" do\n   133→      assert {:error, :not_found} =\n   134→               ServiceRegistry.unregister_service(\"nonexistent._http._tcp.local\")\n   135→    end\n   136→  end\n   137→\n   138→  describe \"update_service/3\" do\n   139→    test \"updates service fields\" do\n   140→      service_def = %{name: \"Update Test\", type: \"_http._tcp\", port: 8080}\n   141→\n   142→      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n   143→\n   144→      updates = %{port: 9090, txt_records: %{\"new\" => \"value\"}}\n   145→      assert :ok = ServiceRegistry.update_service(service_id, updates)\n   146→\n   147→      service = ServiceRegistry.get_service(service_id)\n   148→      assert service.port == 9090\n   149→      assert service.txt_records == %{\"new\" => \"value\"}\n   150→    end\n   151→\n   152→    test \"returns error for non-existent service\" do\n   153→      assert {:error, :not_found} =\n   154→               ServiceRegistry.update_service(\"nonexistent._http._tcp.local\", %{port: 9090})\n   155→    end\n   156→  end\n   157→\n   158→  describe \"toggle_service/1\" do\n   159→    test \"toggles service enabled state\" do\n   160→      service_def = %{name: \"Toggle Test\", type: \"_http._tcp\", port: 8080}\n   161→\n   162→      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n   163→      service = ServiceRegistry.get_service(service_id)\n   164→      initial_enabled = service.enabled\n   165→\n   166→      assert :ok = ServiceRegistry.toggle_service(service_id)\n   167→      service = ServiceRegistry.get_service(service_id)\n   168→      assert service.enabled == not initial_enabled\n   169→\n   170→      assert :ok = ServiceRegistry.toggle_service(service_id)\n   171→      service = ServiceRegistry.get_service(service_id)\n   172→      assert service.enabled == initial_enabled\n   173→    end\n   174→  end\n   175→\n   176→  describe \"list_services/1\" do\n   177→    setup do\n   178→      # Register a few test services\n   179→      {:ok, _} =\n   180→        ServiceRegistry.register_service(%{name: \"Service 1\", type: \"_http._tcp\", port: 8080})\n   181→\n   182→      {:ok, _} =\n   183→        ServiceRegistry.register_service(%{\n   184→          name: \"Service 2\",\n   185→          type: \"_ssh._tcp\",\n   186→          port: 22,\n   187→          enabled: false\n   188→        })\n   189→\n   190→      {:ok, _} =\n   191→        ServiceRegistry.register_service(%{name: \"Service 3\", type: \"_ftp._tcp\", port: 21},\n   192→          source: :file\n   193→        )\n   194→\n   195→      :ok\n   196→    end\n   197→\n   198→    test \"lists all services by default\" do\n   199→      services = ServiceRegistry.list_services()\n   200→      assert length(services) >= 3\n   201→    end\n   202→\n   203→    test \"filters enabled services\" do\n   204→      services = ServiceRegistry.list_services(filter: :enabled)\n   205→      assert length(services) >= 2\n   206→      assert Enum.all?(services, & &1.enabled)\n   207→    end\n   208→\n   209→    test \"filters disabled services\" do\n   210→      ServiceRegistry.register_service(%{\n   211→        name: \"Disabled\",\n   212→        type: \"_test._tcp\",\n   213→        port: 9999,\n   214→        enabled: false\n   215→      })\n   216→\n   217→      services = ServiceRegistry.list_services(filter: :disabled)\n   218→      assert length(services) >= 1\n   219→      assert Enum.all?(services, &(not &1.enabled))\n   220→    end\n   221→\n   222→    test \"filters by source\" do\n   223→      file_services = ServiceRegistry.list_services(source: :file)\n   224→      assert length(file_services) >= 1\n   225→      assert Enum.all?(file_services, &(&1.source == :file))\n   226→\n   227→      api_services = ServiceRegistry.list_services(source: :api)\n   228→      assert length(api_services) >= 2\n   229→      assert Enum.all?(api_services, &(&1.source == :api))\n   230→    end\n   231→\n   232→    test \"sorts services by name\" do\n   233→      services = ServiceRegistry.list_services()\n   234→      names = Enum.map(services, & &1.name)\n   235→      assert names == Enum.sort(names)\n   236→    end\n   237→  end\n   238→\n   239→  describe \"get_records_for_query/1\" do\n   240→    setup do\n   241→      {:ok, _} =\n   242→        ServiceRegistry.register_service(%{\n   243→          name: \"Web Server\",\n   244→          type: \"_http._tcp\",\n   245→          port: 8080,\n   246→          addresses: [\"192.168.1.100\"]\n   247→        })\n   248→\n   249→      {:ok, _} =\n   250→        ServiceRegistry.register_service(%{\n   251→          name: \"SSH Server\",\n   252→          type: \"_ssh._tcp\",\n   253→          port: 22\n   254→        })\n   255→\n   256→      :ok\n   257→    end\n   258→\n   259→    test \"finds services matching PTR query\" do\n   260→      question = %Question{\n   261→        name: \"_http._tcp.local\",\n   262→        type: :PTR,\n   263→        class: :IN\n   264→      }\n   265→\n   266→      services = ServiceRegistry.get_records_for_query([question])\n   267→      assert length(services) == 1\n   268→      assert hd(services).name == \"Web Server\"\n   269→    end\n   270→\n   271→    test \"finds services matching SRV query\" do\n   272→      question = %Question{\n   273→        name: \"Web Server._http._tcp.local\",\n   274→        type: :SRV,\n   275→        class: :IN\n   276→      }\n   277→\n   278→      services = ServiceRegistry.get_records_for_query([question])\n   279→      assert length(services) == 1\n   280→      assert hd(services).name == \"Web Server\"\n   281→    end\n   282→\n   283→    test \"returns empty list for non-matching query\" do\n   284→      question = %Question{\n   285→        name: \"_nonexistent._tcp.local\",\n   286→        type: :PTR,\n   287→        class: :IN\n   288→      }\n   289→\n   290→      services = ServiceRegistry.get_records_for_query([question])\n   291→      assert services == []\n   292→    end\n   293→\n   294→    test \"handles multiple questions\" do\n   295→      questions = [\n   296→        %Question{name: \"_http._tcp.local\", type: :PTR, class: :IN},\n   297→        %Question{name: \"_ssh._tcp.local\", type: :PTR, class: :IN}\n   298→      ]\n   299→\n   300→      services = ServiceRegistry.get_records_for_query(questions)\n   301→      assert length(services) == 2\n   302→    end\n   303→  end\n   304→\n   305→  describe \"stats/0\" do\n   306→    test \"returns registry statistics\" do\n   307→      # Register various services\n   308→      {:ok, _} =\n   309→        ServiceRegistry.register_service(%{name: \"S1\", type: \"_http._tcp\", port: 8080})\n   310→\n   311→      {:ok, _} =\n   312→        ServiceRegistry.register_service(%{\n   313→          name: \"S2\",\n   314→          type: \"_ssh._tcp\",\n   315→          port: 22,\n   316→          enabled: false\n   317→        })\n   318→\n   319→      {:ok, _} =\n   320→        ServiceRegistry.register_service(%{name: \"S3\", type: \"_ftp._tcp\", port: 21},\n   321→          source: :file\n   322→        )\n   323→\n   324→      stats = ServiceRegistry.stats()\n   325→\n   326→      assert stats.total >= 3\n   327→      assert stats.enabled >= 2\n   328→      assert stats.disabled >= 1\n   329→      assert stats.from_file >= 1\n   330→      assert stats.from_api >= 2\n   331→    end\n   332→  end\n   333→\n   334→  describe \"persistence\" do\n   335→    @tag :tmp_dir\n   336→    test \"can save and load services\", %{tmp_dir: tmp_dir} do\n   337→      storage_file = Path.join(tmp_dir, \"test_services.toml\")\n   338→\n   339→      # Stop the default registry started in setup\n   340→      stop_supervised(ServiceRegistry)\n   341→\n   342→      # Start registry with custom storage file\n   343→      {:ok, _} =\n   344→        start_supervised(\n   345→          {ServiceRegistry, [storage_file: storage_file, load_on_start: false, auto_save: false]}\n   346→        )\n   347→\n   348→      # Register services\n   349→      {:ok, _} =\n   350→        ServiceRegistry.register_service(%{name: \"Persist Test\", type: \"_http._tcp\", port: 8080})\n   351→\n   352→      # Save to file\n   353→      assert :ok = ServiceRegistry.save_to_file()\n   354→      assert File.exists?(storage_file)\n   355→\n   356→      # Verify file content\n   357→      {:ok, services} = YellowDog.Mdns.ServiceStore.load_services(storage_file)\n   358→      assert length(services) >= 1\n   359→    end\n   360→  end\n   361→end\n   362→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb21cfce-0067-4926-ae35-eac907707d9d","uuid":"958fb287-1440-49a3-8f99-773fa907f32c","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/test/yellow_dog/mdns/service_registry_test.exs","content":"defmodule YellowDog.Mdns.ServiceRegistryTest do\n  use ExUnit.Case, async: false\n\n  alias YellowDog.Mdns.ServiceRegistry\n  alias DNS.Message.Question\n\n  setup do\n    # Start the registry for each test\n    {:ok, pid} = start_supervised({ServiceRegistry, [load_on_start: false]})\n\n    # Clean up ETS table after each test\n    on_exit(fn ->\n      if Process.alive?(pid) do\n        :ok\n      end\n    end)\n\n    %{registry: pid}\n  end\n\n  describe \"register_service/2\" do\n    test \"registers a new service\" do\n      service_def = %{\n        name: \"Test Web Server\",\n        type: \"_http._tcp\",\n        port: 8080\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      assert service_id =~ \"Test Web Server\"\n      assert service_id =~ \"_http._tcp.local\"\n\n      # Verify service can be retrieved\n      service = ServiceRegistry.get_service(service_id)\n      assert service != nil\n      assert service.name == \"Test Web Server\"\n      assert service.port == 8080\n    end\n\n    test \"registers service with TXT records\" do\n      service_def = %{\n        name: \"API Server\",\n        type: \"_http._tcp\",\n        port: 8080,\n        txt: %{\"version\" => \"1.0\", \"path\" => \"/api\"}\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      service = ServiceRegistry.get_service(service_id)\n\n      assert service.txt_records == %{\"version\" => \"1.0\", \"path\" => \"/api\"}\n    end\n\n    test \"registers service with addresses\" do\n      service_def = %{\n        name: \"Multi-address Service\",\n        type: \"_http._tcp\",\n        port: 8080,\n        addresses: [\"192.168.1.100\", \"fe80::1\"]\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      service = ServiceRegistry.get_service(service_id)\n\n      assert length(service.addresses) == 2\n      assert {192, 168, 1, 100} in service.addresses\n    end\n\n    test \"normalizes service type\" do\n      # Service type without protocol should get _tcp added\n      service_def = %{\n        name: \"Test\",\n        type: \"_myapp\",\n        port: 8080\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      service = ServiceRegistry.get_service(service_id)\n\n      assert service.type == \"_myapp._tcp\"\n    end\n\n    test \"sets source to :api by default\" do\n      service_def = %{\n        name: \"Test\",\n        type: \"_http._tcp\",\n        port: 8080\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      service = ServiceRegistry.get_service(service_id)\n\n      assert service.source == :api\n    end\n\n    test \"can set source to :file\" do\n      service_def = %{\n        name: \"File Service\",\n        type: \"_http._tcp\",\n        port: 8080\n      }\n\n      assert {:ok, service_id} = ServiceRegistry.register_service(service_def, source: :file)\n      service = ServiceRegistry.get_service(service_id)\n\n      assert service.source == :file\n    end\n\n    test \"rejects invalid service\" do\n      invalid_service = %{\n        name: \"Invalid\",\n        # Missing type and port\n        type: nil,\n        port: nil\n      }\n\n      assert {:error, _reason} = ServiceRegistry.register_service(invalid_service)\n    end\n  end\n\n  describe \"unregister_service/2\" do\n    test \"unregisters an existing service\" do\n      service_def = %{name: \"Temp Service\", type: \"_http._tcp\", port: 8080}\n\n      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      assert ServiceRegistry.get_service(service_id) != nil\n\n      assert :ok = ServiceRegistry.unregister_service(service_id)\n      assert ServiceRegistry.get_service(service_id) == nil\n    end\n\n    test \"returns error for non-existent service\" do\n      assert {:error, :not_found} =\n               ServiceRegistry.unregister_service(\"nonexistent._http._tcp.local\")\n    end\n  end\n\n  describe \"update_service/3\" do\n    test \"updates service fields\" do\n      service_def = %{name: \"Update Test\", type: \"_http._tcp\", port: 8080}\n\n      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n\n      updates = %{port: 9090, txt_records: %{\"new\" => \"value\"}}\n      assert :ok = ServiceRegistry.update_service(service_id, updates)\n\n      service = ServiceRegistry.get_service(service_id)\n      assert service.port == 9090\n      assert service.txt_records == %{\"new\" => \"value\"}\n    end\n\n    test \"returns error for non-existent service\" do\n      assert {:error, :not_found} =\n               ServiceRegistry.update_service(\"nonexistent._http._tcp.local\", %{port: 9090})\n    end\n  end\n\n  describe \"toggle_service/1\" do\n    test \"toggles service enabled state\" do\n      service_def = %{name: \"Toggle Test\", type: \"_http._tcp\", port: 8080}\n\n      {:ok, service_id} = ServiceRegistry.register_service(service_def)\n      service = ServiceRegistry.get_service(service_id)\n      initial_enabled = service.enabled\n\n      assert :ok = ServiceRegistry.toggle_service(service_id)\n      service = ServiceRegistry.get_service(service_id)\n      assert service.enabled == not initial_enabled\n\n      assert :ok = ServiceRegistry.toggle_service(service_id)\n      service = ServiceRegistry.get_service(service_id)\n      assert service.enabled == initial_enabled\n    end\n  end\n\n  describe \"list_services/1\" do\n    setup do\n      # Register a few test services\n      {:ok, _} =\n        ServiceRegistry.register_service(%{name: \"Service 1\", type: \"_http._tcp\", port: 8080})\n\n      {:ok, _} =\n        ServiceRegistry.register_service(%{\n          name: \"Service 2\",\n          type: \"_ssh._tcp\",\n          port: 22,\n          enabled: false\n        })\n\n      {:ok, _} =\n        ServiceRegistry.register_service(%{name: \"Service 3\", type: \"_ftp._tcp\", port: 21},\n          source: :file\n        )\n\n      :ok\n    end\n\n    test \"lists all services by default\" do\n      services = ServiceRegistry.list_services()\n      assert length(services) >= 3\n    end\n\n    test \"filters enabled services\" do\n      services = ServiceRegistry.list_services(filter: :enabled)\n      assert length(services) >= 2\n      assert Enum.all?(services, & &1.enabled)\n    end\n\n    test \"filters disabled services\" do\n      ServiceRegistry.register_service(%{\n        name: \"Disabled\",\n        type: \"_test._tcp\",\n        port: 9999,\n        enabled: false\n      })\n\n      services = ServiceRegistry.list_services(filter: :disabled)\n      assert length(services) >= 1\n      assert Enum.all?(services, &(not &1.enabled))\n    end\n\n    test \"filters by source\" do\n      file_services = ServiceRegistry.list_services(source: :file)\n      assert length(file_services) >= 1\n      assert Enum.all?(file_services, &(&1.source == :file))\n\n      api_services = ServiceRegistry.list_services(source: :api)\n      assert length(api_services) >= 2\n      assert Enum.all?(api_services, &(&1.source == :api))\n    end\n\n    test \"sorts services by name\" do\n      services = ServiceRegistry.list_services()\n      names = Enum.map(services, & &1.name)\n      assert names == Enum.sort(names)\n    end\n  end\n\n  describe \"get_records_for_query/1\" do\n    setup do\n      {:ok, _} =\n        ServiceRegistry.register_service(%{\n          name: \"Web Server\",\n          type: \"_http._tcp\",\n          port: 8080,\n          addresses: [\"192.168.1.100\"]\n        })\n\n      {:ok, _} =\n        ServiceRegistry.register_service(%{\n          name: \"SSH Server\",\n          type: \"_ssh._tcp\",\n          port: 22\n        })\n\n      :ok\n    end\n\n    test \"finds services matching PTR query\" do\n      question = %Question{\n        name: \"_http._tcp.local\",\n        type: :PTR,\n        class: :IN\n      }\n\n      services = ServiceRegistry.get_records_for_query([question])\n      assert length(services) == 1\n      assert hd(services).name == \"Web Server\"\n    end\n\n    test \"finds services matching SRV query\" do\n      question = %Question{\n        name: \"Web Server._http._tcp.local\",\n        type: :SRV,\n        class: :IN\n      }\n\n      services = ServiceRegistry.get_records_for_query([question])\n      assert length(services) == 1\n      assert hd(services).name == \"Web Server\"\n    end\n\n    test \"returns empty list for non-matching query\" do\n      question = %Question{\n        name: \"_nonexistent._tcp.local\",\n        type: :PTR,\n        class: :IN\n      }\n\n      services = ServiceRegistry.get_records_for_query([question])\n      assert services == []\n    end\n\n    test \"handles multiple questions\" do\n      questions = [\n        %Question{name: \"_http._tcp.local\", type: :PTR, class: :IN},\n        %Question{name: \"_ssh._tcp.local\", type: :PTR, class: :IN}\n      ]\n\n      services = ServiceRegistry.get_records_for_query(questions)\n      assert length(services) == 2\n    end\n  end\n\n  describe \"stats/0\" do\n    test \"returns registry statistics\" do\n      # Register various services\n      {:ok, _} =\n        ServiceRegistry.register_service(%{name: \"S1\", type: \"_http._tcp\", port: 8080})\n\n      {:ok, _} =\n        ServiceRegistry.register_service(%{\n          name: \"S2\",\n          type: \"_ssh._tcp\",\n          port: 22,\n          enabled: false\n        })\n\n      {:ok, _} =\n        ServiceRegistry.register_service(%{name: \"S3\", type: \"_ftp._tcp\", port: 21},\n          source: :file\n        )\n\n      stats = ServiceRegistry.stats()\n\n      assert stats.total >= 3\n      assert stats.enabled >= 2\n      assert stats.disabled >= 1\n      assert stats.from_file >= 1\n      assert stats.from_api >= 2\n    end\n  end\n\n  describe \"persistence\" do\n    @tag :tmp_dir\n    test \"can save and load services\", %{tmp_dir: tmp_dir} do\n      storage_file = Path.join(tmp_dir, \"test_services.toml\")\n\n      # Stop the default registry started in setup\n      stop_supervised(ServiceRegistry)\n\n      # Start registry with custom storage file\n      {:ok, _} =\n        start_supervised(\n          {ServiceRegistry, [storage_file: storage_file, load_on_start: false, auto_save: false]}\n        )\n\n      # Register services\n      {:ok, _} =\n        ServiceRegistry.register_service(%{name: \"Persist Test\", type: \"_http._tcp\", port: 8080})\n\n      # Save to file\n      assert :ok = ServiceRegistry.save_to_file()\n      assert File.exists?(storage_file)\n\n      # Verify file content\n      {:ok, services} = YellowDog.Mdns.ServiceStore.load_services(storage_file)\n      assert length(services) >= 1\n    end\n  end\nend\n","numLines":362,"startLine":1,"totalLines":362}}}
