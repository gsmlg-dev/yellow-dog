{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M7wLTZGnjf6ssYZkumvu1q","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.NetworkMonitor do\n     2→  @moduledoc \"\"\"\n     3→  Monitors all mDNS network traffic (queries + responses) for network visibility.\n     4→\n     5→  Tracks both queries and responses, providing comprehensive network discovery\n     6→  and activity monitoring. This is an enhanced version of MessageCache that\n     7→  tracks not just responses but also queries seen on the network.\n     8→  \"\"\"\n     9→\n    10→  use GenServer\n    11→\n    12→  @response_table :mdns_responses\n    13→  @query_table :mdns_queries\n    14→  @services_table :mdns_discovered_services\n    15→  @ets_options [:named_table, :public, :bag, read_concurrency: true, write_concurrency: true]\n    16→\n    17→  # Cleanup every 5 minutes\n    18→  @cleanup_interval 300_000\n    19→  # Default TTL for cached records\n    20→  @default_ttl 120\n    21→\n    22→  @type message_entry :: %{\n    23→          domain: String.t(),\n    24→          record_type: atom(),\n    25→          message: DNS.Message.t(),\n    26→          source_ip: tuple(),\n    27→          source_port: integer(),\n    28→          received_at: integer(),\n    29→          ttl: integer()\n    30→        }\n    31→\n    32→  @type query_entry :: %{\n    33→          domain: String.t(),\n    34→          record_type: atom(),\n    35→          source_ip: tuple(),\n    36→          source_port: integer(),\n    37→          timestamp: integer(),\n    38→          answered: boolean()\n    39→        }\n    40→\n    41→  @type discovered_service :: %{\n    42→          service_id: String.t(),\n    43→          name: String.t(),\n    44→          type: String.t(),\n    45→          domain: String.t(),\n    46→          host: String.t() | nil,\n    47→          port: integer() | nil,\n    48→          txt_records: map(),\n    49→          addresses: [tuple()],\n    50→          first_seen: integer(),\n    51→          last_seen: integer(),\n    52→          response_count: integer(),\n    53→          source_ips: [tuple()]\n    54→        }\n    55→\n    56→  # Client API\n    57→\n    58→  @doc \"\"\"\n    59→  Starts the NetworkMonitor GenServer.\n    60→  \"\"\"\n    61→  @spec start_link(keyword()) :: GenServer.on_start()\n    62→  def start_link(opts \\\\ []) do\n    63→    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n    64→  end\n    65→\n    66→  @doc \"\"\"\n    67→  Logs a query seen on the network.\n    68→  \"\"\"\n    69→  @spec log_query(DNS.Message.t(), tuple(), integer()) :: :ok\n    70→  def log_query(message, source_ip, source_port) do\n    71→    GenServer.cast(__MODULE__, {:log_query, message, source_ip, source_port})\n    72→  end\n    73→\n    74→  @doc \"\"\"\n    75→  Caches a response message.\n    76→  \"\"\"\n    77→  @spec cache_response(DNS.Message.t(), tuple(), integer()) :: :ok\n    78→  def cache_response(message, source_ip, source_port) do\n    79→    GenServer.cast(__MODULE__, {:cache_response, message, source_ip, source_port})\n    80→  end\n    81→\n    82→  @doc \"\"\"\n    83→  Queries the cache for records matching a domain.\n    84→  \"\"\"\n    85→  @spec query(String.t(), atom() | nil) :: [message_entry()]\n    86→  def query(domain, record_type \\\\ nil) do\n    87→    domain_key = normalize_domain(domain)\n    88→\n    89→    entries =\n    90→      case :ets.lookup(@response_table, domain_key) do\n    91→        [] -> []\n    92→        results -> Enum.map(results, fn {_key, entry} -> entry end)\n    93→      end\n    94→\n    95→    entries =\n    96→      if record_type do\n    97→        Enum.filter(entries, fn entry -> entry.record_type == record_type end)\n    98→      else\n    99→        entries\n   100→      end\n   101→\n   102→    now = System.system_time(:second)\n   103→\n   104→    Enum.filter(entries, fn entry ->\n   105→      entry.received_at + entry.ttl > now\n   106→    end)\n   107→  end\n   108→\n   109→  @doc \"\"\"\n   110→  Gets recent queries seen on the network.\n   111→  \"\"\"\n   112→  @spec get_queries(keyword()) :: [query_entry()]\n   113→  def get_queries(opts \\\\ []) do\n   114→    limit = Keyword.get(opts, :limit, 100)\n   115→    since = Keyword.get(opts, :since, System.system_time(:second) - 3600)\n   116→\n   117→    @query_table\n   118→    |> :ets.tab2list()\n   119→    |> Enum.map(fn {_key, entry} -> entry end)\n   120→    |> Enum.filter(fn entry -> entry.timestamp >= since end)\n   121→    |> Enum.sort_by(& &1.timestamp, :desc)\n   122→    |> Enum.take(limit)\n   123→  end\n   124→\n   125→  @doc \"\"\"\n   126→  Gets queries that have not been answered.\n   127→  \"\"\"\n   128→  @spec get_unanswered_queries() :: [query_entry()]\n   129→  def get_unanswered_queries do\n   130→    @query_table\n   131→    |> :ets.tab2list()\n   132→    |> Enum.map(fn {_key, entry} -> entry end)\n   133→    |> Enum.filter(fn entry -> not entry.answered end)\n   134→    |> Enum.sort_by(& &1.timestamp, :desc)\n   135→  end\n   136→\n   137→  @doc \"\"\"\n   138→  Lists all discovered services on the network.\n   139→  \"\"\"\n   140→  @spec list_discovered_services() :: [discovered_service()]\n   141→  def list_discovered_services do\n   142→    now = System.system_time(:second)\n   143→    # 5 minutes\n   144→    stale_threshold = now - 300\n   145→\n   146→    @services_table\n   147→    |> :ets.tab2list()\n   148→    |> Enum.map(fn {_key, service} -> service end)\n   149→    |> Enum.filter(fn service -> service.last_seen > stale_threshold end)\n   150→    |> Enum.sort_by(& &1.name)\n   151→  end\n   152→\n   153→  @doc \"\"\"\n   154→  Gets details about a specific discovered service.\n   155→  \"\"\"\n   156→  @spec get_discovered_service(String.t()) :: discovered_service() | nil\n   157→  def get_discovered_service(service_id) do\n   158→    case :ets.lookup(@services_table, service_id) do\n   159→      [{^service_id, service}] -> service\n   160→      [] -> nil\n   161→    end\n   162→  end\n   163→\n   164→  @doc \"\"\"\n   165→  Searches for services by type.\n   166→  \"\"\"\n   167→  @spec search_services(keyword()) :: [discovered_service()]\n   168→  def search_services(opts \\\\ []) do\n   169→    type_filter = Keyword.get(opts, :type)\n   170→\n   171→    services = list_discovered_services()\n   172→\n   173→    if type_filter do\n   174→      normalized_type = String.downcase(type_filter)\n   175→\n   176→      Enum.filter(services, fn service ->\n   177→        String.downcase(service.type) == normalized_type\n   178→      end)\n   179→    else\n   180→      services\n   181→    end\n   182→  end\n   183→\n   184→  @doc \"\"\"\n   185→  Gets network statistics.\n   186→  \"\"\"\n   187→  @spec network_stats() :: map()\n   188→  def network_stats do\n   189→    responses = :ets.info(@response_table, :size)\n   190→    queries = :ets.info(@query_table, :size)\n   191→    services = length(list_discovered_services())\n   192→\n   193→    # Get unique hosts\n   194→    unique_hosts =\n   195→      @response_table\n   196→      |> :ets.tab2list()\n   197→      |> Enum.map(fn {_key, entry} -> entry.source_ip end)\n   198→      |> Enum.uniq()\n   199→      |> length()\n   200→\n   201→    # Calculate queries per minute (last hour)\n   202→    now = System.system_time(:second)\n   203→    one_hour_ago = now - 3600\n   204→\n   205→    recent_queries =\n   206→      get_queries(since: one_hour_ago)\n   207→      |> length()\n   208→\n   209→    queries_per_minute = recent_queries / 60.0\n   210→\n   211→    # Get most queried services\n   212→    most_queried =\n   213→      get_queries(since: one_hour_ago)\n   214→      |> Enum.group_by(& &1.domain)\n   215→      |> Enum.map(fn {domain, queries} -> {domain, length(queries)} end)\n   216→      |> Enum.sort_by(fn {_domain, count} -> count end, :desc)\n   217→      |> Enum.take(10)\n   218→      |> Enum.map(fn {domain, count} -> %{domain: domain, count: count} end)\n   219→\n   220→    %{\n   221→      total_responses: responses,\n   222→      total_queries: queries,\n   223→      active_services: services,\n   224→      unique_hosts: unique_hosts,\n   225→      queries_per_minute: Float.round(queries_per_minute, 2),\n   226→      most_queried_services: most_queried\n   227→    }\n   228→  end\n   229→\n   230→  @doc \"\"\"\n   231→  Gets all cached messages (legacy API compatibility).\n   232→  \"\"\"\n   233→  @spec list_all() :: [message_entry()]\n   234→  def list_all do\n   235→    now = System.system_time(:second)\n   236→\n   237→    @response_table\n   238→    |> :ets.tab2list()\n   239→    |> Enum.map(fn {_key, entry} -> entry end)\n   240→    |> Enum.filter(fn entry ->\n   241→      entry.received_at + entry.ttl > now\n   242→    end)\n   243→  end\n   244→\n   245→  @doc \"\"\"\n   246→  Gets cache statistics (legacy API compatibility).\n   247→  \"\"\"\n   248→  @spec stats() :: map()\n   249→  def stats do\n   250→    total = :ets.info(@response_table, :size)\n   251→    now = System.system_time(:second)\n   252→\n   253→    all_entries = :ets.tab2list(@response_table)\n   254→\n   255→    expired =\n   256→      Enum.count(all_entries, fn {_key, entry} ->\n   257→        entry.received_at + entry.ttl <= now\n   258→      end)\n   259→\n   260→    %{\n   261→      total_entries: total,\n   262→      active_entries: total - expired,\n   263→      expired_entries: expired\n   264→    }\n   265→  end\n   266→\n   267→  @doc \"\"\"\n   268→  Clears all entries from the cache.\n   269→  \"\"\"\n   270→  @spec clear() :: :ok\n   271→  def clear do\n   272→    GenServer.call(__MODULE__, :clear)\n   273→  end\n   274→\n   275→  # Server Callbacks\n   276→\n   277→  @impl true\n   278→  def init(_opts) do\n   279→    init_tables()\n   280→    schedule_cleanup()\n   281→\n   282→    :telemetry.execute(\n   283→      [:yellow_dog, :mdns, :network_monitor, :started],\n   284→      %{count: 1},\n   285→      %{}\n   286→    )\n   287→\n   288→    {:ok, %{}}\n   289→  end\n   290→\n   291→  @impl true\n   292→  def handle_cast({:log_query, message, source_ip, source_port}, state) do\n   293→    store_query(message, source_ip, source_port)\n   294→    {:noreply, state}\n   295→  end\n   296→\n   297→  def handle_cast({:cache_response, message, source_ip, source_port}, state) do\n   298→    store_response(message, source_ip, source_port)\n   299→    mark_queries_as_answered(message)\n   300→    update_discovered_services(message, source_ip)\n   301→    {:noreply, state}\n   302→  end\n   303→\n   304→  @impl true\n   305→  def handle_call(:clear, _from, state) do\n   306→    :ets.delete_all_objects(@response_table)\n   307→    :ets.delete_all_objects(@query_table)\n   308→    :ets.delete_all_objects(@services_table)\n   309→\n   310→    :telemetry.execute(\n   311→      [:yellow_dog, :mdns, :network_monitor, :cleared],\n   312→      %{count: 1},\n   313→      %{}\n   314→    )\n   315→\n   316→    {:reply, :ok, state}\n   317→  end\n   318→\n   319→  @impl true\n   320→  def handle_info(:cleanup_expired, state) do\n   321→    cleanup_expired_entries()\n   322→    schedule_cleanup()\n   323→    {:noreply, state}\n   324→  end\n   325→\n   326→  # Private functions\n   327→\n   328→  defp init_tables do\n   329→    for table <- [@response_table, @query_table, @services_table] do\n   330→      if :ets.whereis(table) == :undefined do\n   331→        :ets.new(table, @ets_options)\n   332→      end\n   333→    end\n   334→\n   335→    :ok\n   336→  end\n   337→\n   338→  defp store_query(message, source_ip, source_port) do\n   339→    now = System.system_time(:second)\n   340→\n   341→    Enum.each(message.qdlist, fn question ->\n   342→      domain_key = normalize_domain(to_string(question.name))\n   343→\n   344→      entry = %{\n   345→        domain: to_string(question.name),\n   346→        record_type: question.type,\n   347→        source_ip: source_ip,\n   348→        source_port: source_port,\n   349→        timestamp: now,\n   350→        answered: false\n   351→      }\n   352→\n   353→      :ets.insert(@query_table, {domain_key, entry})\n   354→    end)\n   355→\n   356→    :telemetry.execute(\n   357→      [:yellow_dog, :mdns, :query_logged],\n   358→      %{question_count: length(message.qdlist)},\n   359→      %{source_ip: source_ip}\n   360→    )\n   361→  end\n   362→\n   363→  defp store_response(message, source_ip, source_port) do\n   364→    now = System.system_time(:second)\n   365→\n   366→    # Store answer records\n   367→    Enum.each(message.anlist, fn record ->\n   368→      cache_record(record, message, source_ip, source_port, now, :answer)\n   369→    end)\n   370→\n   371→    # Store authority records\n   372→    Enum.each(message.nslist, fn record ->\n   373→      cache_record(record, message, source_ip, source_port, now, :authority)\n   374→    end)\n   375→\n   376→    # Store additional records\n   377→    Enum.each(message.arlist, fn record ->\n   378→      cache_record(record, message, source_ip, source_port, now, :additional)\n   379→    end)\n   380→  end\n   381→\n   382→  defp cache_record(record, message, source_ip, source_port, received_at, section) do\n   383→    domain_key = normalize_domain(to_string(record.name))\n   384→\n   385→    entry = %{\n   386→      domain: to_string(record.name),\n   387→      record_type: record.type,\n   388→      record: record,\n   389→      message: message,\n   390→      source_ip: source_ip,\n   391→      source_port: source_port,\n   392→      received_at: received_at,\n   393→      ttl: max(record.ttl, @default_ttl),\n   394→      section: section\n   395→    }\n   396→\n   397→    :ets.insert(@response_table, {domain_key, entry})\n   398→  end\n   399→\n   400→  defp mark_queries_as_answered(message) do\n   401→    # Match answers to queries\n   402→    Enum.each(message.anlist, fn record ->\n   403→      domain_key = normalize_domain(to_string(record.name))\n   404→\n   405→      case :ets.lookup(@query_table, domain_key) do\n   406→        [] ->\n   407→          :ok\n   408→\n   409→        queries ->\n   410→          Enum.each(queries, fn {key, query} ->\n   411→            if query.record_type == record.type or query.record_type == :ANY do\n   412→              updated_query = %{query | answered: true}\n   413→              :ets.delete_object(@query_table, {key, query})\n   414→              :ets.insert(@query_table, {key, updated_query})\n   415→            end\n   416→          end)\n   417→      end\n   418→    end)\n   419→  end\n   420→\n   421→  defp update_discovered_services(message, source_ip) do\n   422→    # Extract service information from PTR, SRV, TXT records\n   423→    # Group records by service instance\n   424→\n   425→    services = extract_services_from_message(message, source_ip)\n   426→\n   427→    Enum.each(services, fn service ->\n   428→      update_or_create_service(service)\n   429→    end)\n   430→  end\n   431→\n   432→  defp extract_services_from_message(message, source_ip) do\n   433→    now = System.system_time(:second)\n   434→\n   435→    # Find PTR records (service type enumeration)\n   436→    ptr_records =\n   437→      Enum.filter(message.anlist, fn record -> record.type == :PTR end)\n   438→\n   439→    # For each PTR, try to find corresponding SRV, TXT, A/AAAA records\n   440→    Enum.flat_map(ptr_records, fn ptr ->\n   441→      service_instance = to_string(ptr.data)\n   442→      service_type = to_string(ptr.name)\n   443→\n   444→      # Find SRV record\n   445→      srv_record =\n   446→        Enum.find(message.anlist ++ message.arlist, fn record ->\n   447→          record.type == :SRV and to_string(record.name) == service_instance\n   448→        end)\n   449→\n   450→      # Find TXT record\n   451→      txt_record =\n   452→        Enum.find(message.anlist ++ message.arlist, fn record ->\n   453→          record.type == :TXT and to_string(record.name) == service_instance\n   454→        end)\n   455→\n   456→      # Find A/AAAA records\n   457→      host = if srv_record, do: to_string(srv_record.data.target), else: nil\n   458→\n   459→      addresses =\n   460→        if host do\n   461→          (message.anlist ++ message.arlist)\n   462→          |> Enum.filter(fn record ->\n   463→            record.type in [:A, :AAAA] and to_string(record.name) == host\n   464→          end)\n   465→          |> Enum.map(fn record -> record.data end)\n   466→        else\n   467→          []\n   468→        end\n   469→\n   470→      if srv_record do\n   471→        [\n   472→          %{\n   473→            service_id: service_instance,\n   474→            name: extract_service_name(service_instance),\n   475→            type: service_type,\n   476→            domain: \"local\",\n   477→            host: host,\n   478→            port: srv_record.data.port,\n   479→            txt_records: parse_txt_records(txt_record),\n   480→            addresses: addresses,\n   481→            timestamp: now,\n   482→            source_ip: source_ip\n   483→          }\n   484→        ]\n   485→      else\n   486→        []\n   487→      end\n   488→    end)\n   489→  end\n   490→\n   491→  defp extract_service_name(service_instance) do\n   492→    # service_instance is like \"My Service._http._tcp.local\"\n   493→    # Extract \"My Service\"\n   494→    service_instance\n   495→    |> String.split(\".\")\n   496→    |> hd()\n   497→  end\n   498→\n   499→  defp parse_txt_records(nil), do: %{}\n   500→\n   501→  defp parse_txt_records(txt_record) do\n   502→    case txt_record.data do\n   503→      list when is_list(list) ->\n   504→        list\n   505→        |> Enum.map(fn str ->\n   506→          case String.split(str, \"=\", parts: 2) do\n   507→            [key, value] -> {key, value}\n   508→            [key] -> {key, \"\"}\n   509→          end\n   510→        end)\n   511→        |> Map.new()\n   512→\n   513→      _ ->\n   514→        %{}\n   515→    end\n   516→  end\n   517→\n   518→  defp update_or_create_service(service_info) do\n   519→    service_id = service_info.service_id\n   520→\n   521→    case :ets.lookup(@services_table, service_id) do\n   522→      [{^service_id, existing}] ->\n   523→        # Update existing service\n   524→        updated = %{\n   525→          existing\n   526→          | last_seen: service_info.timestamp,\n   527→            response_count: existing.response_count + 1,\n   528→            source_ips: Enum.uniq([service_info.source_ip | existing.source_ips]),\n   529→            # Update fields that may have changed\n   530→            host: service_info.host || existing.host,\n   531→            port: service_info.port || existing.port,\n   532→            txt_records: Map.merge(existing.txt_records, service_info.txt_records),\n   533→            addresses: Enum.uniq(service_info.addresses ++ existing.addresses)\n   534→        }\n   535→\n   536→        :ets.insert(@services_table, {service_id, updated})\n   537→\n   538→      [] ->\n   539→        # Create new service\n   540→        new_service = %{\n   541→          service_id: service_id,\n   542→          name: service_info.name,\n   543→          type: service_info.type,\n   544→          domain: service_info.domain,\n   545→          host: service_info.host,\n   546→          port: service_info.port,\n   547→          txt_records: service_info.txt_records,\n   548→          addresses: service_info.addresses,\n   549→          first_seen: service_info.timestamp,\n   550→          last_seen: service_info.timestamp,\n   551→          response_count: 1,\n   552→          source_ips: [service_info.source_ip]\n   553→        }\n   554→\n   555→        :ets.insert(@services_table, {service_id, new_service})\n   556→\n   557→        :telemetry.execute(\n   558→          [:yellow_dog, :mdns, :service_discovered],\n   559→          %{count: 1},\n   560→          %{service_id: service_id, type: service_info.type}\n   561→        )\n   562→    end\n   563→  end\n   564→\n   565→  defp cleanup_expired_entries do\n   566→    now = System.system_time(:second)\n   567→\n   568→    # Clean up expired responses\n   569→    response_entries = :ets.tab2list(@response_table)\n   570→\n   571→    expired_responses =\n   572→      Enum.filter(response_entries, fn {_key, entry} ->\n   573→        entry.received_at + entry.ttl <= now\n   574→      end)\n   575→\n   576→    Enum.each(expired_responses, fn {key, entry} ->\n   577→      :ets.delete_object(@response_table, {key, entry})\n   578→    end)\n   579→\n   580→    # Clean up old queries (older than 1 hour)\n   581→    one_hour_ago = now - 3600\n   582→    query_entries = :ets.tab2list(@query_table)\n   583→\n   584→    old_queries =\n   585→      Enum.filter(query_entries, fn {_key, entry} ->\n   586→        entry.timestamp < one_hour_ago\n   587→      end)\n   588→\n   589→    Enum.each(old_queries, fn {key, entry} ->\n   590→      :ets.delete_object(@query_table, {key, entry})\n   591→    end)\n   592→\n   593→    # Clean up stale services (not seen in 10 minutes)\n   594→    ten_minutes_ago = now - 600\n   595→\n   596→    stale_services =\n   597→      @services_table\n   598→      |> :ets.tab2list()\n   599→      |> Enum.filter(fn {_key, service} -> service.last_seen < ten_minutes_ago end)\n   600→\n   601→    Enum.each(stale_services, fn {key, _service} ->\n   602→      :ets.delete(@services_table, key)\n   603→    end)\n   604→\n   605→    total_cleaned = length(expired_responses) + length(old_queries) + length(stale_services)\n   606→\n   607→    if total_cleaned > 0 do\n   608→      :telemetry.execute(\n   609→        [:yellow_dog, :mdns, :network_monitor, :cleanup],\n   610→        %{expired_count: total_cleaned},\n   611→        %{}\n   612→      )\n   613→    end\n   614→  end\n   615→\n   616→  defp schedule_cleanup do\n   617→    Process.send_after(self(), :cleanup_expired, @cleanup_interval)\n   618→  end\n   619→\n   620→  defp normalize_domain(domain) when is_binary(domain) do\n   621→    domain\n   622→    |> String.downcase()\n   623→    |> String.trim_trailing(\".\")\n   624→  end\n   625→end\n   626→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b20a2ce5-4d1a-4dfb-8234-d009f9779d17","uuid":"bdaa45dd-3acb-456d-baa9-b04eaf268658","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/lib/yellow_dog/mdns/network_monitor.ex","content":"defmodule YellowDog.Mdns.NetworkMonitor do\n  @moduledoc \"\"\"\n  Monitors all mDNS network traffic (queries + responses) for network visibility.\n\n  Tracks both queries and responses, providing comprehensive network discovery\n  and activity monitoring. This is an enhanced version of MessageCache that\n  tracks not just responses but also queries seen on the network.\n  \"\"\"\n\n  use GenServer\n\n  @response_table :mdns_responses\n  @query_table :mdns_queries\n  @services_table :mdns_discovered_services\n  @ets_options [:named_table, :public, :bag, read_concurrency: true, write_concurrency: true]\n\n  # Cleanup every 5 minutes\n  @cleanup_interval 300_000\n  # Default TTL for cached records\n  @default_ttl 120\n\n  @type message_entry :: %{\n          domain: String.t(),\n          record_type: atom(),\n          message: DNS.Message.t(),\n          source_ip: tuple(),\n          source_port: integer(),\n          received_at: integer(),\n          ttl: integer()\n        }\n\n  @type query_entry :: %{\n          domain: String.t(),\n          record_type: atom(),\n          source_ip: tuple(),\n          source_port: integer(),\n          timestamp: integer(),\n          answered: boolean()\n        }\n\n  @type discovered_service :: %{\n          service_id: String.t(),\n          name: String.t(),\n          type: String.t(),\n          domain: String.t(),\n          host: String.t() | nil,\n          port: integer() | nil,\n          txt_records: map(),\n          addresses: [tuple()],\n          first_seen: integer(),\n          last_seen: integer(),\n          response_count: integer(),\n          source_ips: [tuple()]\n        }\n\n  # Client API\n\n  @doc \"\"\"\n  Starts the NetworkMonitor GenServer.\n  \"\"\"\n  @spec start_link(keyword()) :: GenServer.on_start()\n  def start_link(opts \\\\ []) do\n    GenServer.start_link(__MODULE__, opts, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Logs a query seen on the network.\n  \"\"\"\n  @spec log_query(DNS.Message.t(), tuple(), integer()) :: :ok\n  def log_query(message, source_ip, source_port) do\n    GenServer.cast(__MODULE__, {:log_query, message, source_ip, source_port})\n  end\n\n  @doc \"\"\"\n  Caches a response message.\n  \"\"\"\n  @spec cache_response(DNS.Message.t(), tuple(), integer()) :: :ok\n  def cache_response(message, source_ip, source_port) do\n    GenServer.cast(__MODULE__, {:cache_response, message, source_ip, source_port})\n  end\n\n  @doc \"\"\"\n  Queries the cache for records matching a domain.\n  \"\"\"\n  @spec query(String.t(), atom() | nil) :: [message_entry()]\n  def query(domain, record_type \\\\ nil) do\n    domain_key = normalize_domain(domain)\n\n    entries =\n      case :ets.lookup(@response_table, domain_key) do\n        [] -> []\n        results -> Enum.map(results, fn {_key, entry} -> entry end)\n      end\n\n    entries =\n      if record_type do\n        Enum.filter(entries, fn entry -> entry.record_type == record_type end)\n      else\n        entries\n      end\n\n    now = System.system_time(:second)\n\n    Enum.filter(entries, fn entry ->\n      entry.received_at + entry.ttl > now\n    end)\n  end\n\n  @doc \"\"\"\n  Gets recent queries seen on the network.\n  \"\"\"\n  @spec get_queries(keyword()) :: [query_entry()]\n  def get_queries(opts \\\\ []) do\n    limit = Keyword.get(opts, :limit, 100)\n    since = Keyword.get(opts, :since, System.system_time(:second) - 3600)\n\n    @query_table\n    |> :ets.tab2list()\n    |> Enum.map(fn {_key, entry} -> entry end)\n    |> Enum.filter(fn entry -> entry.timestamp >= since end)\n    |> Enum.sort_by(& &1.timestamp, :desc)\n    |> Enum.take(limit)\n  end\n\n  @doc \"\"\"\n  Gets queries that have not been answered.\n  \"\"\"\n  @spec get_unanswered_queries() :: [query_entry()]\n  def get_unanswered_queries do\n    @query_table\n    |> :ets.tab2list()\n    |> Enum.map(fn {_key, entry} -> entry end)\n    |> Enum.filter(fn entry -> not entry.answered end)\n    |> Enum.sort_by(& &1.timestamp, :desc)\n  end\n\n  @doc \"\"\"\n  Lists all discovered services on the network.\n  \"\"\"\n  @spec list_discovered_services() :: [discovered_service()]\n  def list_discovered_services do\n    now = System.system_time(:second)\n    # 5 minutes\n    stale_threshold = now - 300\n\n    @services_table\n    |> :ets.tab2list()\n    |> Enum.map(fn {_key, service} -> service end)\n    |> Enum.filter(fn service -> service.last_seen > stale_threshold end)\n    |> Enum.sort_by(& &1.name)\n  end\n\n  @doc \"\"\"\n  Gets details about a specific discovered service.\n  \"\"\"\n  @spec get_discovered_service(String.t()) :: discovered_service() | nil\n  def get_discovered_service(service_id) do\n    case :ets.lookup(@services_table, service_id) do\n      [{^service_id, service}] -> service\n      [] -> nil\n    end\n  end\n\n  @doc \"\"\"\n  Searches for services by type.\n  \"\"\"\n  @spec search_services(keyword()) :: [discovered_service()]\n  def search_services(opts \\\\ []) do\n    type_filter = Keyword.get(opts, :type)\n\n    services = list_discovered_services()\n\n    if type_filter do\n      normalized_type = String.downcase(type_filter)\n\n      Enum.filter(services, fn service ->\n        String.downcase(service.type) == normalized_type\n      end)\n    else\n      services\n    end\n  end\n\n  @doc \"\"\"\n  Gets network statistics.\n  \"\"\"\n  @spec network_stats() :: map()\n  def network_stats do\n    responses = :ets.info(@response_table, :size)\n    queries = :ets.info(@query_table, :size)\n    services = length(list_discovered_services())\n\n    # Get unique hosts\n    unique_hosts =\n      @response_table\n      |> :ets.tab2list()\n      |> Enum.map(fn {_key, entry} -> entry.source_ip end)\n      |> Enum.uniq()\n      |> length()\n\n    # Calculate queries per minute (last hour)\n    now = System.system_time(:second)\n    one_hour_ago = now - 3600\n\n    recent_queries =\n      get_queries(since: one_hour_ago)\n      |> length()\n\n    queries_per_minute = recent_queries / 60.0\n\n    # Get most queried services\n    most_queried =\n      get_queries(since: one_hour_ago)\n      |> Enum.group_by(& &1.domain)\n      |> Enum.map(fn {domain, queries} -> {domain, length(queries)} end)\n      |> Enum.sort_by(fn {_domain, count} -> count end, :desc)\n      |> Enum.take(10)\n      |> Enum.map(fn {domain, count} -> %{domain: domain, count: count} end)\n\n    %{\n      total_responses: responses,\n      total_queries: queries,\n      active_services: services,\n      unique_hosts: unique_hosts,\n      queries_per_minute: Float.round(queries_per_minute, 2),\n      most_queried_services: most_queried\n    }\n  end\n\n  @doc \"\"\"\n  Gets all cached messages (legacy API compatibility).\n  \"\"\"\n  @spec list_all() :: [message_entry()]\n  def list_all do\n    now = System.system_time(:second)\n\n    @response_table\n    |> :ets.tab2list()\n    |> Enum.map(fn {_key, entry} -> entry end)\n    |> Enum.filter(fn entry ->\n      entry.received_at + entry.ttl > now\n    end)\n  end\n\n  @doc \"\"\"\n  Gets cache statistics (legacy API compatibility).\n  \"\"\"\n  @spec stats() :: map()\n  def stats do\n    total = :ets.info(@response_table, :size)\n    now = System.system_time(:second)\n\n    all_entries = :ets.tab2list(@response_table)\n\n    expired =\n      Enum.count(all_entries, fn {_key, entry} ->\n        entry.received_at + entry.ttl <= now\n      end)\n\n    %{\n      total_entries: total,\n      active_entries: total - expired,\n      expired_entries: expired\n    }\n  end\n\n  @doc \"\"\"\n  Clears all entries from the cache.\n  \"\"\"\n  @spec clear() :: :ok\n  def clear do\n    GenServer.call(__MODULE__, :clear)\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(_opts) do\n    init_tables()\n    schedule_cleanup()\n\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :network_monitor, :started],\n      %{count: 1},\n      %{}\n    )\n\n    {:ok, %{}}\n  end\n\n  @impl true\n  def handle_cast({:log_query, message, source_ip, source_port}, state) do\n    store_query(message, source_ip, source_port)\n    {:noreply, state}\n  end\n\n  def handle_cast({:cache_response, message, source_ip, source_port}, state) do\n    store_response(message, source_ip, source_port)\n    mark_queries_as_answered(message)\n    update_discovered_services(message, source_ip)\n    {:noreply, state}\n  end\n\n  @impl true\n  def handle_call(:clear, _from, state) do\n    :ets.delete_all_objects(@response_table)\n    :ets.delete_all_objects(@query_table)\n    :ets.delete_all_objects(@services_table)\n\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :network_monitor, :cleared],\n      %{count: 1},\n      %{}\n    )\n\n    {:reply, :ok, state}\n  end\n\n  @impl true\n  def handle_info(:cleanup_expired, state) do\n    cleanup_expired_entries()\n    schedule_cleanup()\n    {:noreply, state}\n  end\n\n  # Private functions\n\n  defp init_tables do\n    for table <- [@response_table, @query_table, @services_table] do\n      if :ets.whereis(table) == :undefined do\n        :ets.new(table, @ets_options)\n      end\n    end\n\n    :ok\n  end\n\n  defp store_query(message, source_ip, source_port) do\n    now = System.system_time(:second)\n\n    Enum.each(message.qdlist, fn question ->\n      domain_key = normalize_domain(to_string(question.name))\n\n      entry = %{\n        domain: to_string(question.name),\n        record_type: question.type,\n        source_ip: source_ip,\n        source_port: source_port,\n        timestamp: now,\n        answered: false\n      }\n\n      :ets.insert(@query_table, {domain_key, entry})\n    end)\n\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :query_logged],\n      %{question_count: length(message.qdlist)},\n      %{source_ip: source_ip}\n    )\n  end\n\n  defp store_response(message, source_ip, source_port) do\n    now = System.system_time(:second)\n\n    # Store answer records\n    Enum.each(message.anlist, fn record ->\n      cache_record(record, message, source_ip, source_port, now, :answer)\n    end)\n\n    # Store authority records\n    Enum.each(message.nslist, fn record ->\n      cache_record(record, message, source_ip, source_port, now, :authority)\n    end)\n\n    # Store additional records\n    Enum.each(message.arlist, fn record ->\n      cache_record(record, message, source_ip, source_port, now, :additional)\n    end)\n  end\n\n  defp cache_record(record, message, source_ip, source_port, received_at, section) do\n    domain_key = normalize_domain(to_string(record.name))\n\n    entry = %{\n      domain: to_string(record.name),\n      record_type: record.type,\n      record: record,\n      message: message,\n      source_ip: source_ip,\n      source_port: source_port,\n      received_at: received_at,\n      ttl: max(record.ttl, @default_ttl),\n      section: section\n    }\n\n    :ets.insert(@response_table, {domain_key, entry})\n  end\n\n  defp mark_queries_as_answered(message) do\n    # Match answers to queries\n    Enum.each(message.anlist, fn record ->\n      domain_key = normalize_domain(to_string(record.name))\n\n      case :ets.lookup(@query_table, domain_key) do\n        [] ->\n          :ok\n\n        queries ->\n          Enum.each(queries, fn {key, query} ->\n            if query.record_type == record.type or query.record_type == :ANY do\n              updated_query = %{query | answered: true}\n              :ets.delete_object(@query_table, {key, query})\n              :ets.insert(@query_table, {key, updated_query})\n            end\n          end)\n      end\n    end)\n  end\n\n  defp update_discovered_services(message, source_ip) do\n    # Extract service information from PTR, SRV, TXT records\n    # Group records by service instance\n\n    services = extract_services_from_message(message, source_ip)\n\n    Enum.each(services, fn service ->\n      update_or_create_service(service)\n    end)\n  end\n\n  defp extract_services_from_message(message, source_ip) do\n    now = System.system_time(:second)\n\n    # Find PTR records (service type enumeration)\n    ptr_records =\n      Enum.filter(message.anlist, fn record -> record.type == :PTR end)\n\n    # For each PTR, try to find corresponding SRV, TXT, A/AAAA records\n    Enum.flat_map(ptr_records, fn ptr ->\n      service_instance = to_string(ptr.data)\n      service_type = to_string(ptr.name)\n\n      # Find SRV record\n      srv_record =\n        Enum.find(message.anlist ++ message.arlist, fn record ->\n          record.type == :SRV and to_string(record.name) == service_instance\n        end)\n\n      # Find TXT record\n      txt_record =\n        Enum.find(message.anlist ++ message.arlist, fn record ->\n          record.type == :TXT and to_string(record.name) == service_instance\n        end)\n\n      # Find A/AAAA records\n      host = if srv_record, do: to_string(srv_record.data.target), else: nil\n\n      addresses =\n        if host do\n          (message.anlist ++ message.arlist)\n          |> Enum.filter(fn record ->\n            record.type in [:A, :AAAA] and to_string(record.name) == host\n          end)\n          |> Enum.map(fn record -> record.data end)\n        else\n          []\n        end\n\n      if srv_record do\n        [\n          %{\n            service_id: service_instance,\n            name: extract_service_name(service_instance),\n            type: service_type,\n            domain: \"local\",\n            host: host,\n            port: srv_record.data.port,\n            txt_records: parse_txt_records(txt_record),\n            addresses: addresses,\n            timestamp: now,\n            source_ip: source_ip\n          }\n        ]\n      else\n        []\n      end\n    end)\n  end\n\n  defp extract_service_name(service_instance) do\n    # service_instance is like \"My Service._http._tcp.local\"\n    # Extract \"My Service\"\n    service_instance\n    |> String.split(\".\")\n    |> hd()\n  end\n\n  defp parse_txt_records(nil), do: %{}\n\n  defp parse_txt_records(txt_record) do\n    case txt_record.data do\n      list when is_list(list) ->\n        list\n        |> Enum.map(fn str ->\n          case String.split(str, \"=\", parts: 2) do\n            [key, value] -> {key, value}\n            [key] -> {key, \"\"}\n          end\n        end)\n        |> Map.new()\n\n      _ ->\n        %{}\n    end\n  end\n\n  defp update_or_create_service(service_info) do\n    service_id = service_info.service_id\n\n    case :ets.lookup(@services_table, service_id) do\n      [{^service_id, existing}] ->\n        # Update existing service\n        updated = %{\n          existing\n          | last_seen: service_info.timestamp,\n            response_count: existing.response_count + 1,\n            source_ips: Enum.uniq([service_info.source_ip | existing.source_ips]),\n            # Update fields that may have changed\n            host: service_info.host || existing.host,\n            port: service_info.port || existing.port,\n            txt_records: Map.merge(existing.txt_records, service_info.txt_records),\n            addresses: Enum.uniq(service_info.addresses ++ existing.addresses)\n        }\n\n        :ets.insert(@services_table, {service_id, updated})\n\n      [] ->\n        # Create new service\n        new_service = %{\n          service_id: service_id,\n          name: service_info.name,\n          type: service_info.type,\n          domain: service_info.domain,\n          host: service_info.host,\n          port: service_info.port,\n          txt_records: service_info.txt_records,\n          addresses: service_info.addresses,\n          first_seen: service_info.timestamp,\n          last_seen: service_info.timestamp,\n          response_count: 1,\n          source_ips: [service_info.source_ip]\n        }\n\n        :ets.insert(@services_table, {service_id, new_service})\n\n        :telemetry.execute(\n          [:yellow_dog, :mdns, :service_discovered],\n          %{count: 1},\n          %{service_id: service_id, type: service_info.type}\n        )\n    end\n  end\n\n  defp cleanup_expired_entries do\n    now = System.system_time(:second)\n\n    # Clean up expired responses\n    response_entries = :ets.tab2list(@response_table)\n\n    expired_responses =\n      Enum.filter(response_entries, fn {_key, entry} ->\n        entry.received_at + entry.ttl <= now\n      end)\n\n    Enum.each(expired_responses, fn {key, entry} ->\n      :ets.delete_object(@response_table, {key, entry})\n    end)\n\n    # Clean up old queries (older than 1 hour)\n    one_hour_ago = now - 3600\n    query_entries = :ets.tab2list(@query_table)\n\n    old_queries =\n      Enum.filter(query_entries, fn {_key, entry} ->\n        entry.timestamp < one_hour_ago\n      end)\n\n    Enum.each(old_queries, fn {key, entry} ->\n      :ets.delete_object(@query_table, {key, entry})\n    end)\n\n    # Clean up stale services (not seen in 10 minutes)\n    ten_minutes_ago = now - 600\n\n    stale_services =\n      @services_table\n      |> :ets.tab2list()\n      |> Enum.filter(fn {_key, service} -> service.last_seen < ten_minutes_ago end)\n\n    Enum.each(stale_services, fn {key, _service} ->\n      :ets.delete(@services_table, key)\n    end)\n\n    total_cleaned = length(expired_responses) + length(old_queries) + length(stale_services)\n\n    if total_cleaned > 0 do\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :network_monitor, :cleanup],\n        %{expired_count: total_cleaned},\n        %{}\n      )\n    end\n  end\n\n  defp schedule_cleanup do\n    Process.send_after(self(), :cleanup_expired, @cleanup_interval)\n  end\n\n  defp normalize_domain(domain) when is_binary(domain) do\n    domain\n    |> String.downcase()\n    |> String.trim_trailing(\".\")\n  end\nend\n","numLines":626,"startLine":1,"totalLines":626}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HFYq4yfeD9exWzrsmSLo39","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.NetworkMonitorTest do\n     2→  use ExUnit.Case, async: false\n     3→\n     4→  alias YellowDog.Mdns.NetworkMonitor\n     5→  alias DNS.Message.{Record, Question}\n     6→\n     7→  # Helper to create a mock DNS message\n     8→  defp create_dns_message(opts \\\\ []) do\n     9→    answers = Keyword.get(opts, :answers, [])\n    10→    questions = Keyword.get(opts, :questions, [])\n    11→    authority = Keyword.get(opts, :authority, [])\n    12→    additional = Keyword.get(opts, :additional, [])\n    13→\n    14→    %DNS.Message{\n    15→      header: %DNS.Message.Header{\n    16→        id: Keyword.get(opts, :id, :rand.uniform(65535)),\n    17→        qr: Keyword.get(opts, :qr, 1),\n    18→        opcode: 0,\n    19→        aa: 1,\n    20→        tc: 0,\n    21→        rd: 0,\n    22→        ra: 0,\n    23→        z: 0,\n    24→        rcode: 0,\n    25→        qdcount: length(questions),\n    26→        ancount: length(answers),\n    27→        nscount: length(authority),\n    28→        arcount: length(additional)\n    29→      },\n    30→      qdlist: questions,\n    31→      anlist: answers,\n    32→      nslist: authority,\n    33→      arlist: additional\n    34→    }\n    35→  end\n    36→\n    37→  defp create_a_record(name, ip, ttl \\\\ 4500) do\n    38→    %Record{name: name, type: :A, class: :IN, ttl: ttl, data: ip}\n    39→  end\n    40→\n    41→  defp create_aaaa_record(name, ip, ttl \\\\ 4500) do\n    42→    %Record{name: name, type: :AAAA, class: :IN, ttl: ttl, data: ip}\n    43→  end\n    44→\n    45→  defp create_ptr_record(name, target, ttl \\\\ 4500) do\n    46→    %Record{name: name, type: :PTR, class: :IN, ttl: ttl, data: target}\n    47→  end\n    48→\n    49→  defp create_srv_record(name, target, port, ttl \\\\ 4500) do\n    50→    %Record{\n    51→      name: name,\n    52→      type: :SRV,\n    53→      class: :IN,\n    54→      ttl: ttl,\n    55→      data: %{priority: 0, weight: 0, port: port, target: target}\n    56→    }\n    57→  end\n    58→\n    59→  defp create_txt_record(name, data, ttl \\\\ 4500) do\n    60→    %Record{name: name, type: :TXT, class: :IN, ttl: ttl, data: data}\n    61→  end\n    62→\n    63→  defp create_question(name, type \\\\ :A) do\n    64→    %Question{name: name, type: type, class: :IN}\n    65→  end\n    66→\n    67→  setup do\n    68→    start_supervised!(NetworkMonitor)\n    69→    NetworkMonitor.clear()\n    70→    :ok\n    71→  end\n    72→\n    73→  describe \"start_link/1\" do\n    74→    test \"starts successfully\" do\n    75→      assert Process.whereis(NetworkMonitor) != nil\n    76→    end\n    77→  end\n    78→\n    79→  describe \"log_query/3\" do\n    80→    test \"logs a query from the network\" do\n    81→      question = create_question(\"_http._tcp.local\", :PTR)\n    82→      message = create_dns_message(questions: [question], qr: 0)\n    83→\n    84→      assert :ok = NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n    85→      :timer.sleep(10)\n    86→\n    87→      queries = NetworkMonitor.get_queries()\n    88→      assert length(queries) == 1\n    89→\n    90→      query = hd(queries)\n    91→      assert query.domain == \"_http._tcp.local\"\n    92→      assert query.record_type == :PTR\n    93→      assert query.source_ip == {192, 168, 1, 10}\n    94→      assert query.answered == false\n    95→    end\n    96→\n    97→    test \"logs multiple questions from same message\" do\n    98→      q1 = create_question(\"_http._tcp.local\", :PTR)\n    99→      q2 = create_question(\"_ssh._tcp.local\", :PTR)\n   100→      message = create_dns_message(questions: [q1, q2], qr: 0)\n   101→\n   102→      assert :ok = NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n   103→      :timer.sleep(10)\n   104→\n   105→      queries = NetworkMonitor.get_queries()\n   106→      assert length(queries) == 2\n   107→\n   108→      domains = Enum.map(queries, & &1.domain) |> Enum.sort()\n   109→      assert domains == [\"_http._tcp.local\", \"_ssh._tcp.local\"]\n   110→    end\n   111→  end\n   112→\n   113→  describe \"cache_response/3\" do\n   114→    test \"caches response records\" do\n   115→      record = create_a_record(\"myhost.local\", {192, 168, 1, 100})\n   116→      message = create_dns_message(answers: [record])\n   117→\n   118→      assert :ok = NetworkMonitor.cache_response(message, {192, 168, 1, 100}, 5353)\n   119→      :timer.sleep(10)\n   120→\n   121→      entries = NetworkMonitor.query(\"myhost.local\")\n   122→      assert length(entries) == 1\n   123→      assert hd(entries).domain == \"myhost.local\"\n   124→    end\n   125→\n   126→    test \"caches multiple record types\" do\n   127→      a_record = create_a_record(\"service.local\", {192, 168, 1, 50})\n   128→      aaaa_record = create_aaaa_record(\"service.local\", {0, 0, 0, 0, 0, 0, 0, 1})\n   129→      txt_record = create_txt_record(\"service.local\", [\"key=value\"])\n   130→\n   131→      message = create_dns_message(answers: [a_record, aaaa_record, txt_record])\n   132→\n   133→      assert :ok = NetworkMonitor.cache_response(message, {192, 168, 1, 50}, 5353)\n   134→      :timer.sleep(10)\n   135→\n   136→      entries = NetworkMonitor.query(\"service.local\")\n   137→      assert length(entries) == 3\n   138→    end\n   139→  end\n   140→\n   141→  describe \"query/2\" do\n   142→    test \"returns empty list for non-existent domain\" do\n   143→      assert NetworkMonitor.query(\"nonexistent.local\") == []\n   144→    end\n   145→\n   146→    test \"filters by record type\" do\n   147→      a_record = create_a_record(\"multi.local\", {192, 168, 1, 1})\n   148→      aaaa_record = create_aaaa_record(\"multi.local\", {0, 0, 0, 0, 0, 0, 0, 1})\n   149→\n   150→      message = create_dns_message(answers: [a_record, aaaa_record])\n   151→      NetworkMonitor.cache_response(message, {192, 168, 1, 1}, 5353)\n   152→      :timer.sleep(10)\n   153→\n   154→      a_entries = NetworkMonitor.query(\"multi.local\", :A)\n   155→      assert length(a_entries) == 1\n   156→\n   157→      aaaa_entries = NetworkMonitor.query(\"multi.local\", :AAAA)\n   158→      assert length(aaaa_entries) == 1\n   159→    end\n   160→\n   161→    test \"normalizes domain names (case insensitive)\" do\n   162→      record = create_a_record(\"MyHost.Local\", {192, 168, 1, 100})\n   163→      message = create_dns_message(answers: [record])\n   164→\n   165→      NetworkMonitor.cache_response(message, {192, 168, 1, 100}, 5353)\n   166→      :timer.sleep(10)\n   167→\n   168→      assert length(NetworkMonitor.query(\"myhost.local\")) == 1\n   169→      assert length(NetworkMonitor.query(\"MYHOST.LOCAL\")) == 1\n   170→    end\n   171→  end\n   172→\n   173→  describe \"get_queries/1\" do\n   174→    test \"returns recent queries\" do\n   175→      question = create_question(\"test.local\", :A)\n   176→      message = create_dns_message(questions: [question], qr: 0)\n   177→\n   178→      NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n   179→      :timer.sleep(10)\n   180→\n   181→      queries = NetworkMonitor.get_queries()\n   182→      assert length(queries) == 1\n   183→    end\n   184→\n   185→    test \"respects limit option\" do\n   186→      # Log 5 queries\n   187→      for i <- 1..5 do\n   188→        question = create_question(\"test#{i}.local\", :A)\n   189→        message = create_dns_message(questions: [question], qr: 0)\n   190→        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n   191→      end\n   192→\n   193→      :timer.sleep(10)\n   194→\n   195→      queries = NetworkMonitor.get_queries(limit: 3)\n   196→      assert length(queries) == 3\n   197→    end\n   198→\n   199→    test \"sorts by timestamp descending (most recent first)\" do\n   200→      for i <- 1..3 do\n   201→        question = create_question(\"test#{i}.local\", :A)\n   202→        message = create_dns_message(questions: [question], qr: 0)\n   203→        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n   204→        :timer.sleep(5)\n   205→      end\n   206→\n   207→      :timer.sleep(10)\n   208→\n   209→      queries = NetworkMonitor.get_queries()\n   210→      # Most recent should be first\n   211→      timestamps = Enum.map(queries, & &1.timestamp)\n   212→      assert timestamps == Enum.sort(timestamps, :desc)\n   213→    end\n   214→  end\n   215→\n   216→  describe \"get_unanswered_queries/0\" do\n   217→    test \"returns queries that have not been answered\" do\n   218→      question = create_question(\"unanswered.local\", :A)\n   219→      query_message = create_dns_message(questions: [question], qr: 0)\n   220→\n   221→      NetworkMonitor.log_query(query_message, {192, 168, 1, 10}, 5353)\n   222→      :timer.sleep(10)\n   223→\n   224→      unanswered = NetworkMonitor.get_unanswered_queries()\n   225→      assert length(unanswered) == 1\n   226→      assert hd(unanswered).domain == \"unanswered.local\"\n   227→    end\n   228→\n   229→    test \"excludes answered queries\" do\n   230→      # Log a query\n   231→      question = create_question(\"answered.local\", :A)\n   232→      query_message = create_dns_message(questions: [question], qr: 0)\n   233→      NetworkMonitor.log_query(query_message, {192, 168, 1, 10}, 5353)\n   234→\n   235→      # Answer it\n   236→      record = create_a_record(\"answered.local\", {192, 168, 1, 100})\n   237→      response_message = create_dns_message(answers: [record])\n   238→      NetworkMonitor.cache_response(response_message, {192, 168, 1, 100}, 5353)\n   239→\n   240→      :timer.sleep(10)\n   241→\n   242→      unanswered = NetworkMonitor.get_unanswered_queries()\n   243→      assert Enum.empty?(unanswered)\n   244→    end\n   245→  end\n   246→\n   247→  describe \"service discovery\" do\n   248→    test \"discovers service from complete announcement\" do\n   249→      # Service announcement with PTR, SRV, TXT, A records\n   250→      ptr_record = create_ptr_record(\"_http._tcp.local\", \"webserver._http._tcp.local\")\n   251→      srv_record = create_srv_record(\"webserver._http._tcp.local\", \"webserver.local\", 8080)\n   252→      txt_record = create_txt_record(\"webserver._http._tcp.local\", [\"path=/api\", \"version=1.0\"])\n   253→      a_record = create_a_record(\"webserver.local\", {192, 168, 1, 50})\n   254→\n   255→      message =\n   256→        create_dns_message(\n   257→          answers: [ptr_record, srv_record, txt_record],\n   258→          additional: [a_record]\n   259→        )\n   260→\n   261→      NetworkMonitor.cache_response(message, {192, 168, 1, 50}, 5353)\n   262→      :timer.sleep(10)\n   263→\n   264→      services = NetworkMonitor.list_discovered_services()\n   265→      assert length(services) == 1\n   266→\n   267→      service = hd(services)\n   268→      assert service.name == \"webserver\"\n   269→      assert service.type == \"_http._tcp.local\"\n   270→      assert service.host == \"webserver.local\"\n   271→      assert service.port == 8080\n   272→      assert service.txt_records == %{\"path\" => \"/api\", \"version\" => \"1.0\"}\n   273→      assert {192, 168, 1, 50} in service.addresses\n   274→    end\n   275→\n   276→    test \"get_discovered_service/1 returns specific service\" do\n   277→      ptr_record = create_ptr_record(\"_http._tcp.local\", \"myservice._http._tcp.local\")\n   278→      srv_record = create_srv_record(\"myservice._http._tcp.local\", \"host.local\", 80)\n   279→\n   280→      message = create_dns_message(answers: [ptr_record, srv_record])\n   281→      NetworkMonitor.cache_response(message, {192, 168, 1, 10}, 5353)\n   282→      :timer.sleep(10)\n   283→\n   284→      service = NetworkMonitor.get_discovered_service(\"myservice._http._tcp.local\")\n   285→      assert service != nil\n   286→      assert service.name == \"myservice\"\n   287→    end\n   288→\n   289→    test \"get_discovered_service/1 returns nil for unknown service\" do\n   290→      assert NetworkMonitor.get_discovered_service(\"unknown._http._tcp.local\") == nil\n   291→    end\n   292→\n   293→    test \"search_services/1 filters by type\" do\n   294→      # Add HTTP service\n   295→      http_ptr = create_ptr_record(\"_http._tcp.local\", \"web._http._tcp.local\")\n   296→      http_srv = create_srv_record(\"web._http._tcp.local\", \"web.local\", 80)\n   297→      http_msg = create_dns_message(answers: [http_ptr, http_srv])\n   298→      NetworkMonitor.cache_response(http_msg, {192, 168, 1, 10}, 5353)\n   299→\n   300→      # Add SSH service\n   301→      ssh_ptr = create_ptr_record(\"_ssh._tcp.local\", \"server._ssh._tcp.local\")\n   302→      ssh_srv = create_srv_record(\"server._ssh._tcp.local\", \"server.local\", 22)\n   303→      ssh_msg = create_dns_message(answers: [ssh_ptr, ssh_srv])\n   304→      NetworkMonitor.cache_response(ssh_msg, {192, 168, 1, 20}, 5353)\n   305→\n   306→      :timer.sleep(10)\n   307→\n   308→      # All services\n   309→      all = NetworkMonitor.search_services()\n   310→      assert length(all) == 2\n   311→\n   312→      # Only HTTP\n   313→      http = NetworkMonitor.search_services(type: \"_http._tcp.local\")\n   314→      assert length(http) == 1\n   315→      assert hd(http).type == \"_http._tcp.local\"\n   316→\n   317→      # Only SSH\n   318→      ssh = NetworkMonitor.search_services(type: \"_ssh._tcp.local\")\n   319→      assert length(ssh) == 1\n   320→      assert hd(ssh).type == \"_ssh._tcp.local\"\n   321→    end\n   322→  end\n   323→\n   324→  describe \"network_stats/0\" do\n   325→    test \"returns zero counts when empty\" do\n   326→      stats = NetworkMonitor.network_stats()\n   327→\n   328→      assert stats.total_responses == 0\n   329→      assert stats.total_queries == 0\n   330→      assert stats.active_services == 0\n   331→      assert stats.unique_hosts == 0\n   332→    end\n   333→\n   334→    test \"counts responses and queries\" do\n   335→      # Add some queries\n   336→      for i <- 1..3 do\n   337→        question = create_question(\"test#{i}.local\", :A)\n   338→        message = create_dns_message(questions: [question], qr: 0)\n   339→        NetworkMonitor.log_query(message, {192, 168, 1, i}, 5353)\n   340→      end\n   341→\n   342→      # Add some responses\n   343→      for i <- 1..2 do\n   344→        record = create_a_record(\"host#{i}.local\", {192, 168, 1, 100 + i})\n   345→        message = create_dns_message(answers: [record])\n   346→        NetworkMonitor.cache_response(message, {192, 168, 1, 100 + i}, 5353)\n   347→      end\n   348→\n   349→      :timer.sleep(10)\n   350→\n   351→      stats = NetworkMonitor.network_stats()\n   352→      assert stats.total_queries == 3\n   353→      assert stats.total_responses == 2\n   354→      assert stats.unique_hosts == 2\n   355→    end\n   356→\n   357→    test \"calculates queries per minute\" do\n   358→      stats = NetworkMonitor.network_stats()\n   359→      assert is_float(stats.queries_per_minute)\n   360→    end\n   361→\n   362→    test \"tracks most queried services\" do\n   363→      # Query same domain multiple times\n   364→      for _ <- 1..5 do\n   365→        question = create_question(\"popular.local\", :A)\n   366→        message = create_dns_message(questions: [question], qr: 0)\n   367→        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n   368→      end\n   369→\n   370→      # Query different domain once\n   371→      question = create_question(\"other.local\", :A)\n   372→      message = create_dns_message(questions: [question], qr: 0)\n   373→      NetworkMonitor.log_query(message, {192, 168, 1, 20}, 5353)\n   374→\n   375→      :timer.sleep(10)\n   376→\n   377→      stats = NetworkMonitor.network_stats()\n   378→      assert length(stats.most_queried_services) > 0\n   379→\n   380→      # Find the popular.local entry\n   381→      popular = Enum.find(stats.most_queried_services, fn s -> s.domain == \"popular.local\" end)\n   382→      assert popular != nil\n   383→      assert popular.count == 5\n   384→\n   385→      # And the other.local entry\n   386→      other = Enum.find(stats.most_queried_services, fn s -> s.domain == \"other.local\" end)\n   387→      assert other != nil\n   388→      assert other.count == 1\n   389→    end\n   390→  end\n   391→\n   392→  describe \"list_all/0 and stats/0 (legacy API)\" do\n   393→    test \"list_all returns all cached responses\" do\n   394→      record1 = create_a_record(\"host1.local\", {192, 168, 1, 1})\n   395→      record2 = create_a_record(\"host2.local\", {192, 168, 1, 2})\n   396→\n   397→      msg1 = create_dns_message(answers: [record1])\n   398→      msg2 = create_dns_message(answers: [record2])\n   399→\n   400→      NetworkMonitor.cache_response(msg1, {192, 168, 1, 1}, 5353)\n   401→      NetworkMonitor.cache_response(msg2, {192, 168, 1, 2}, 5353)\n   402→      :timer.sleep(10)\n   403→\n   404→      all = NetworkMonitor.list_all()\n   405→      assert length(all) == 2\n   406→    end\n   407→\n   408→    test \"stats returns cache statistics\" do\n   409→      record = create_a_record(\"stat.local\", {192, 168, 1, 1})\n   410→      message = create_dns_message(answers: [record])\n   411→\n   412→      NetworkMonitor.cache_response(message, {192, 168, 1, 1}, 5353)\n   413→      :timer.sleep(10)\n   414→\n   415→      stats = NetworkMonitor.stats()\n   416→      assert stats.total_entries == 1\n   417→      assert stats.active_entries == 1\n   418→      assert stats.expired_entries == 0\n   419→    end\n   420→  end\n   421→\n   422→  describe \"clear/0\" do\n   423→    test \"removes all entries\" do\n   424→      # Add query\n   425→      question = create_question(\"test.local\", :A)\n   426→      query_msg = create_dns_message(questions: [question], qr: 0)\n   427→      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n   428→\n   429→      # Add response\n   430→      record = create_a_record(\"test.local\", {192, 168, 1, 100})\n   431→      response_msg = create_dns_message(answers: [record])\n   432→      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n   433→\n   434→      # Add service\n   435→      ptr = create_ptr_record(\"_http._tcp.local\", \"web._http._tcp.local\")\n   436→      srv = create_srv_record(\"web._http._tcp.local\", \"web.local\", 80)\n   437→      service_msg = create_dns_message(answers: [ptr, srv])\n   438→      NetworkMonitor.cache_response(service_msg, {192, 168, 1, 50}, 5353)\n   439→\n   440→      :timer.sleep(10)\n   441→\n   442→      # Verify data exists\n   443→      assert length(NetworkMonitor.get_queries()) > 0\n   444→      assert length(NetworkMonitor.list_all()) > 0\n   445→      assert length(NetworkMonitor.list_discovered_services()) > 0\n   446→\n   447→      # Clear\n   448→      assert :ok = NetworkMonitor.clear()\n   449→\n   450→      # Verify empty\n   451→      assert NetworkMonitor.get_queries() == []\n   452→      assert NetworkMonitor.list_all() == []\n   453→      assert NetworkMonitor.list_discovered_services() == []\n   454→    end\n   455→  end\n   456→\n   457→  describe \"query answering\" do\n   458→    test \"marks queries as answered when response arrives\" do\n   459→      # Log query\n   460→      question = create_question(\"tobeANSWERED.local\", :A)\n   461→      query_msg = create_dns_message(questions: [question], qr: 0)\n   462→      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n   463→      :timer.sleep(10)\n   464→\n   465→      # Verify unanswered\n   466→      assert length(NetworkMonitor.get_unanswered_queries()) == 1\n   467→\n   468→      # Send response\n   469→      record = create_a_record(\"tobeanswered.local\", {192, 168, 1, 100})\n   470→      response_msg = create_dns_message(answers: [record])\n   471→      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n   472→      :timer.sleep(10)\n   473→\n   474→      # Should be marked answered\n   475→      assert NetworkMonitor.get_unanswered_queries() == []\n   476→    end\n   477→\n   478→    test \"marks ANY type queries as answered by any response\" do\n   479→      # Log ANY query\n   480→      question = create_question(\"any.local\", :ANY)\n   481→      query_msg = create_dns_message(questions: [question], qr: 0)\n   482→      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n   483→      :timer.sleep(10)\n   484→\n   485→      # Verify unanswered\n   486→      assert length(NetworkMonitor.get_unanswered_queries()) == 1\n   487→\n   488→      # Send A record response\n   489→      record = create_a_record(\"any.local\", {192, 168, 1, 100})\n   490→      response_msg = create_dns_message(answers: [record])\n   491→      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n   492→      :timer.sleep(10)\n   493→\n   494→      # Should be marked answered since it was ANY query\n   495→      assert NetworkMonitor.get_unanswered_queries() == []\n   496→    end\n   497→  end\n   498→end\n   499→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b20a2ce5-4d1a-4dfb-8234-d009f9779d17","uuid":"13ba5f64-9161-457c-b040-4d15c32580c8","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/test/yellow_dog/mdns/network_monitor_test.exs","content":"defmodule YellowDog.Mdns.NetworkMonitorTest do\n  use ExUnit.Case, async: false\n\n  alias YellowDog.Mdns.NetworkMonitor\n  alias DNS.Message.{Record, Question}\n\n  # Helper to create a mock DNS message\n  defp create_dns_message(opts \\\\ []) do\n    answers = Keyword.get(opts, :answers, [])\n    questions = Keyword.get(opts, :questions, [])\n    authority = Keyword.get(opts, :authority, [])\n    additional = Keyword.get(opts, :additional, [])\n\n    %DNS.Message{\n      header: %DNS.Message.Header{\n        id: Keyword.get(opts, :id, :rand.uniform(65535)),\n        qr: Keyword.get(opts, :qr, 1),\n        opcode: 0,\n        aa: 1,\n        tc: 0,\n        rd: 0,\n        ra: 0,\n        z: 0,\n        rcode: 0,\n        qdcount: length(questions),\n        ancount: length(answers),\n        nscount: length(authority),\n        arcount: length(additional)\n      },\n      qdlist: questions,\n      anlist: answers,\n      nslist: authority,\n      arlist: additional\n    }\n  end\n\n  defp create_a_record(name, ip, ttl \\\\ 4500) do\n    %Record{name: name, type: :A, class: :IN, ttl: ttl, data: ip}\n  end\n\n  defp create_aaaa_record(name, ip, ttl \\\\ 4500) do\n    %Record{name: name, type: :AAAA, class: :IN, ttl: ttl, data: ip}\n  end\n\n  defp create_ptr_record(name, target, ttl \\\\ 4500) do\n    %Record{name: name, type: :PTR, class: :IN, ttl: ttl, data: target}\n  end\n\n  defp create_srv_record(name, target, port, ttl \\\\ 4500) do\n    %Record{\n      name: name,\n      type: :SRV,\n      class: :IN,\n      ttl: ttl,\n      data: %{priority: 0, weight: 0, port: port, target: target}\n    }\n  end\n\n  defp create_txt_record(name, data, ttl \\\\ 4500) do\n    %Record{name: name, type: :TXT, class: :IN, ttl: ttl, data: data}\n  end\n\n  defp create_question(name, type \\\\ :A) do\n    %Question{name: name, type: type, class: :IN}\n  end\n\n  setup do\n    start_supervised!(NetworkMonitor)\n    NetworkMonitor.clear()\n    :ok\n  end\n\n  describe \"start_link/1\" do\n    test \"starts successfully\" do\n      assert Process.whereis(NetworkMonitor) != nil\n    end\n  end\n\n  describe \"log_query/3\" do\n    test \"logs a query from the network\" do\n      question = create_question(\"_http._tcp.local\", :PTR)\n      message = create_dns_message(questions: [question], qr: 0)\n\n      assert :ok = NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      queries = NetworkMonitor.get_queries()\n      assert length(queries) == 1\n\n      query = hd(queries)\n      assert query.domain == \"_http._tcp.local\"\n      assert query.record_type == :PTR\n      assert query.source_ip == {192, 168, 1, 10}\n      assert query.answered == false\n    end\n\n    test \"logs multiple questions from same message\" do\n      q1 = create_question(\"_http._tcp.local\", :PTR)\n      q2 = create_question(\"_ssh._tcp.local\", :PTR)\n      message = create_dns_message(questions: [q1, q2], qr: 0)\n\n      assert :ok = NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      queries = NetworkMonitor.get_queries()\n      assert length(queries) == 2\n\n      domains = Enum.map(queries, & &1.domain) |> Enum.sort()\n      assert domains == [\"_http._tcp.local\", \"_ssh._tcp.local\"]\n    end\n  end\n\n  describe \"cache_response/3\" do\n    test \"caches response records\" do\n      record = create_a_record(\"myhost.local\", {192, 168, 1, 100})\n      message = create_dns_message(answers: [record])\n\n      assert :ok = NetworkMonitor.cache_response(message, {192, 168, 1, 100}, 5353)\n      :timer.sleep(10)\n\n      entries = NetworkMonitor.query(\"myhost.local\")\n      assert length(entries) == 1\n      assert hd(entries).domain == \"myhost.local\"\n    end\n\n    test \"caches multiple record types\" do\n      a_record = create_a_record(\"service.local\", {192, 168, 1, 50})\n      aaaa_record = create_aaaa_record(\"service.local\", {0, 0, 0, 0, 0, 0, 0, 1})\n      txt_record = create_txt_record(\"service.local\", [\"key=value\"])\n\n      message = create_dns_message(answers: [a_record, aaaa_record, txt_record])\n\n      assert :ok = NetworkMonitor.cache_response(message, {192, 168, 1, 50}, 5353)\n      :timer.sleep(10)\n\n      entries = NetworkMonitor.query(\"service.local\")\n      assert length(entries) == 3\n    end\n  end\n\n  describe \"query/2\" do\n    test \"returns empty list for non-existent domain\" do\n      assert NetworkMonitor.query(\"nonexistent.local\") == []\n    end\n\n    test \"filters by record type\" do\n      a_record = create_a_record(\"multi.local\", {192, 168, 1, 1})\n      aaaa_record = create_aaaa_record(\"multi.local\", {0, 0, 0, 0, 0, 0, 0, 1})\n\n      message = create_dns_message(answers: [a_record, aaaa_record])\n      NetworkMonitor.cache_response(message, {192, 168, 1, 1}, 5353)\n      :timer.sleep(10)\n\n      a_entries = NetworkMonitor.query(\"multi.local\", :A)\n      assert length(a_entries) == 1\n\n      aaaa_entries = NetworkMonitor.query(\"multi.local\", :AAAA)\n      assert length(aaaa_entries) == 1\n    end\n\n    test \"normalizes domain names (case insensitive)\" do\n      record = create_a_record(\"MyHost.Local\", {192, 168, 1, 100})\n      message = create_dns_message(answers: [record])\n\n      NetworkMonitor.cache_response(message, {192, 168, 1, 100}, 5353)\n      :timer.sleep(10)\n\n      assert length(NetworkMonitor.query(\"myhost.local\")) == 1\n      assert length(NetworkMonitor.query(\"MYHOST.LOCAL\")) == 1\n    end\n  end\n\n  describe \"get_queries/1\" do\n    test \"returns recent queries\" do\n      question = create_question(\"test.local\", :A)\n      message = create_dns_message(questions: [question], qr: 0)\n\n      NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      queries = NetworkMonitor.get_queries()\n      assert length(queries) == 1\n    end\n\n    test \"respects limit option\" do\n      # Log 5 queries\n      for i <- 1..5 do\n        question = create_question(\"test#{i}.local\", :A)\n        message = create_dns_message(questions: [question], qr: 0)\n        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n      end\n\n      :timer.sleep(10)\n\n      queries = NetworkMonitor.get_queries(limit: 3)\n      assert length(queries) == 3\n    end\n\n    test \"sorts by timestamp descending (most recent first)\" do\n      for i <- 1..3 do\n        question = create_question(\"test#{i}.local\", :A)\n        message = create_dns_message(questions: [question], qr: 0)\n        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n        :timer.sleep(5)\n      end\n\n      :timer.sleep(10)\n\n      queries = NetworkMonitor.get_queries()\n      # Most recent should be first\n      timestamps = Enum.map(queries, & &1.timestamp)\n      assert timestamps == Enum.sort(timestamps, :desc)\n    end\n  end\n\n  describe \"get_unanswered_queries/0\" do\n    test \"returns queries that have not been answered\" do\n      question = create_question(\"unanswered.local\", :A)\n      query_message = create_dns_message(questions: [question], qr: 0)\n\n      NetworkMonitor.log_query(query_message, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      unanswered = NetworkMonitor.get_unanswered_queries()\n      assert length(unanswered) == 1\n      assert hd(unanswered).domain == \"unanswered.local\"\n    end\n\n    test \"excludes answered queries\" do\n      # Log a query\n      question = create_question(\"answered.local\", :A)\n      query_message = create_dns_message(questions: [question], qr: 0)\n      NetworkMonitor.log_query(query_message, {192, 168, 1, 10}, 5353)\n\n      # Answer it\n      record = create_a_record(\"answered.local\", {192, 168, 1, 100})\n      response_message = create_dns_message(answers: [record])\n      NetworkMonitor.cache_response(response_message, {192, 168, 1, 100}, 5353)\n\n      :timer.sleep(10)\n\n      unanswered = NetworkMonitor.get_unanswered_queries()\n      assert Enum.empty?(unanswered)\n    end\n  end\n\n  describe \"service discovery\" do\n    test \"discovers service from complete announcement\" do\n      # Service announcement with PTR, SRV, TXT, A records\n      ptr_record = create_ptr_record(\"_http._tcp.local\", \"webserver._http._tcp.local\")\n      srv_record = create_srv_record(\"webserver._http._tcp.local\", \"webserver.local\", 8080)\n      txt_record = create_txt_record(\"webserver._http._tcp.local\", [\"path=/api\", \"version=1.0\"])\n      a_record = create_a_record(\"webserver.local\", {192, 168, 1, 50})\n\n      message =\n        create_dns_message(\n          answers: [ptr_record, srv_record, txt_record],\n          additional: [a_record]\n        )\n\n      NetworkMonitor.cache_response(message, {192, 168, 1, 50}, 5353)\n      :timer.sleep(10)\n\n      services = NetworkMonitor.list_discovered_services()\n      assert length(services) == 1\n\n      service = hd(services)\n      assert service.name == \"webserver\"\n      assert service.type == \"_http._tcp.local\"\n      assert service.host == \"webserver.local\"\n      assert service.port == 8080\n      assert service.txt_records == %{\"path\" => \"/api\", \"version\" => \"1.0\"}\n      assert {192, 168, 1, 50} in service.addresses\n    end\n\n    test \"get_discovered_service/1 returns specific service\" do\n      ptr_record = create_ptr_record(\"_http._tcp.local\", \"myservice._http._tcp.local\")\n      srv_record = create_srv_record(\"myservice._http._tcp.local\", \"host.local\", 80)\n\n      message = create_dns_message(answers: [ptr_record, srv_record])\n      NetworkMonitor.cache_response(message, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      service = NetworkMonitor.get_discovered_service(\"myservice._http._tcp.local\")\n      assert service != nil\n      assert service.name == \"myservice\"\n    end\n\n    test \"get_discovered_service/1 returns nil for unknown service\" do\n      assert NetworkMonitor.get_discovered_service(\"unknown._http._tcp.local\") == nil\n    end\n\n    test \"search_services/1 filters by type\" do\n      # Add HTTP service\n      http_ptr = create_ptr_record(\"_http._tcp.local\", \"web._http._tcp.local\")\n      http_srv = create_srv_record(\"web._http._tcp.local\", \"web.local\", 80)\n      http_msg = create_dns_message(answers: [http_ptr, http_srv])\n      NetworkMonitor.cache_response(http_msg, {192, 168, 1, 10}, 5353)\n\n      # Add SSH service\n      ssh_ptr = create_ptr_record(\"_ssh._tcp.local\", \"server._ssh._tcp.local\")\n      ssh_srv = create_srv_record(\"server._ssh._tcp.local\", \"server.local\", 22)\n      ssh_msg = create_dns_message(answers: [ssh_ptr, ssh_srv])\n      NetworkMonitor.cache_response(ssh_msg, {192, 168, 1, 20}, 5353)\n\n      :timer.sleep(10)\n\n      # All services\n      all = NetworkMonitor.search_services()\n      assert length(all) == 2\n\n      # Only HTTP\n      http = NetworkMonitor.search_services(type: \"_http._tcp.local\")\n      assert length(http) == 1\n      assert hd(http).type == \"_http._tcp.local\"\n\n      # Only SSH\n      ssh = NetworkMonitor.search_services(type: \"_ssh._tcp.local\")\n      assert length(ssh) == 1\n      assert hd(ssh).type == \"_ssh._tcp.local\"\n    end\n  end\n\n  describe \"network_stats/0\" do\n    test \"returns zero counts when empty\" do\n      stats = NetworkMonitor.network_stats()\n\n      assert stats.total_responses == 0\n      assert stats.total_queries == 0\n      assert stats.active_services == 0\n      assert stats.unique_hosts == 0\n    end\n\n    test \"counts responses and queries\" do\n      # Add some queries\n      for i <- 1..3 do\n        question = create_question(\"test#{i}.local\", :A)\n        message = create_dns_message(questions: [question], qr: 0)\n        NetworkMonitor.log_query(message, {192, 168, 1, i}, 5353)\n      end\n\n      # Add some responses\n      for i <- 1..2 do\n        record = create_a_record(\"host#{i}.local\", {192, 168, 1, 100 + i})\n        message = create_dns_message(answers: [record])\n        NetworkMonitor.cache_response(message, {192, 168, 1, 100 + i}, 5353)\n      end\n\n      :timer.sleep(10)\n\n      stats = NetworkMonitor.network_stats()\n      assert stats.total_queries == 3\n      assert stats.total_responses == 2\n      assert stats.unique_hosts == 2\n    end\n\n    test \"calculates queries per minute\" do\n      stats = NetworkMonitor.network_stats()\n      assert is_float(stats.queries_per_minute)\n    end\n\n    test \"tracks most queried services\" do\n      # Query same domain multiple times\n      for _ <- 1..5 do\n        question = create_question(\"popular.local\", :A)\n        message = create_dns_message(questions: [question], qr: 0)\n        NetworkMonitor.log_query(message, {192, 168, 1, 10}, 5353)\n      end\n\n      # Query different domain once\n      question = create_question(\"other.local\", :A)\n      message = create_dns_message(questions: [question], qr: 0)\n      NetworkMonitor.log_query(message, {192, 168, 1, 20}, 5353)\n\n      :timer.sleep(10)\n\n      stats = NetworkMonitor.network_stats()\n      assert length(stats.most_queried_services) > 0\n\n      # Find the popular.local entry\n      popular = Enum.find(stats.most_queried_services, fn s -> s.domain == \"popular.local\" end)\n      assert popular != nil\n      assert popular.count == 5\n\n      # And the other.local entry\n      other = Enum.find(stats.most_queried_services, fn s -> s.domain == \"other.local\" end)\n      assert other != nil\n      assert other.count == 1\n    end\n  end\n\n  describe \"list_all/0 and stats/0 (legacy API)\" do\n    test \"list_all returns all cached responses\" do\n      record1 = create_a_record(\"host1.local\", {192, 168, 1, 1})\n      record2 = create_a_record(\"host2.local\", {192, 168, 1, 2})\n\n      msg1 = create_dns_message(answers: [record1])\n      msg2 = create_dns_message(answers: [record2])\n\n      NetworkMonitor.cache_response(msg1, {192, 168, 1, 1}, 5353)\n      NetworkMonitor.cache_response(msg2, {192, 168, 1, 2}, 5353)\n      :timer.sleep(10)\n\n      all = NetworkMonitor.list_all()\n      assert length(all) == 2\n    end\n\n    test \"stats returns cache statistics\" do\n      record = create_a_record(\"stat.local\", {192, 168, 1, 1})\n      message = create_dns_message(answers: [record])\n\n      NetworkMonitor.cache_response(message, {192, 168, 1, 1}, 5353)\n      :timer.sleep(10)\n\n      stats = NetworkMonitor.stats()\n      assert stats.total_entries == 1\n      assert stats.active_entries == 1\n      assert stats.expired_entries == 0\n    end\n  end\n\n  describe \"clear/0\" do\n    test \"removes all entries\" do\n      # Add query\n      question = create_question(\"test.local\", :A)\n      query_msg = create_dns_message(questions: [question], qr: 0)\n      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n\n      # Add response\n      record = create_a_record(\"test.local\", {192, 168, 1, 100})\n      response_msg = create_dns_message(answers: [record])\n      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n\n      # Add service\n      ptr = create_ptr_record(\"_http._tcp.local\", \"web._http._tcp.local\")\n      srv = create_srv_record(\"web._http._tcp.local\", \"web.local\", 80)\n      service_msg = create_dns_message(answers: [ptr, srv])\n      NetworkMonitor.cache_response(service_msg, {192, 168, 1, 50}, 5353)\n\n      :timer.sleep(10)\n\n      # Verify data exists\n      assert length(NetworkMonitor.get_queries()) > 0\n      assert length(NetworkMonitor.list_all()) > 0\n      assert length(NetworkMonitor.list_discovered_services()) > 0\n\n      # Clear\n      assert :ok = NetworkMonitor.clear()\n\n      # Verify empty\n      assert NetworkMonitor.get_queries() == []\n      assert NetworkMonitor.list_all() == []\n      assert NetworkMonitor.list_discovered_services() == []\n    end\n  end\n\n  describe \"query answering\" do\n    test \"marks queries as answered when response arrives\" do\n      # Log query\n      question = create_question(\"tobeANSWERED.local\", :A)\n      query_msg = create_dns_message(questions: [question], qr: 0)\n      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      # Verify unanswered\n      assert length(NetworkMonitor.get_unanswered_queries()) == 1\n\n      # Send response\n      record = create_a_record(\"tobeanswered.local\", {192, 168, 1, 100})\n      response_msg = create_dns_message(answers: [record])\n      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n      :timer.sleep(10)\n\n      # Should be marked answered\n      assert NetworkMonitor.get_unanswered_queries() == []\n    end\n\n    test \"marks ANY type queries as answered by any response\" do\n      # Log ANY query\n      question = create_question(\"any.local\", :ANY)\n      query_msg = create_dns_message(questions: [question], qr: 0)\n      NetworkMonitor.log_query(query_msg, {192, 168, 1, 10}, 5353)\n      :timer.sleep(10)\n\n      # Verify unanswered\n      assert length(NetworkMonitor.get_unanswered_queries()) == 1\n\n      # Send A record response\n      record = create_a_record(\"any.local\", {192, 168, 1, 100})\n      response_msg = create_dns_message(answers: [record])\n      NetworkMonitor.cache_response(response_msg, {192, 168, 1, 100}, 5353)\n      :timer.sleep(10)\n\n      # Should be marked answered since it was ANY query\n      assert NetworkMonitor.get_unanswered_queries() == []\n    end\n  end\nend\n","numLines":499,"startLine":1,"totalLines":499}}}
