{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UTFLLqYE9SovRbfVMRZmU3","type":"tool_result","content":"     1→defmodule YellowDog.Dns.View.ACL do\n     2→  @moduledoc \"\"\"\n     3→  Access Control List (ACL) implementation for DNS views.\n     4→\n     5→  ACLs define which clients can access specific DNS views based on\n     6→  their IP addresses or geographic location. An ACL consists of:\n     7→  - Name (identifier)\n     8→  - Rules (IP addresses, CIDR blocks, geographic locations, or named ACLs)\n     9→  - Match logic (allow/deny)\n    10→\n    11→  ## Built-in ACLs\n    12→\n    13→  - `\"any\"` - Matches all clients\n    14→  - `\"none\"` - Matches no clients\n    15→  - `\"localhost\"` - Matches 127.0.0.1 and ::1\n    16→  - `\"localnets\"` - Matches RFC 1918 private networks\n    17→\n    18→  ## Rule Types\n    19→\n    20→  ### IP/CIDR Rules\n    21→      {:allow, {10, 0, 0, 0}, 8}      # Allow 10.0.0.0/8\n    22→      {:deny, \"192.168.1.0/24\"}       # Deny 192.168.1.0/24\n    23→\n    24→  ### Geo Rules\n    25→      {:allow, {:geo, [\"US\", \"CA\"]}}  # Allow from USA and Canada\n    26→      {:deny, {:geo, [\"CN\", \"RU\"]}}   # Deny from China and Russia\n    27→\n    28→  ## Examples\n    29→\n    30→      # Define an ACL for internal network\n    31→      iex> internal = ACL.new(\"internal\", [\n    32→      ...>   {:allow, {10, 0, 0, 0}, 8},\n    33→      ...>   {:allow, {192, 168, 0, 0}, 16}\n    34→      ...> ])\n    35→\n    36→      # Check if IP matches\n    37→      iex> ACL.matches?(internal, {10, 1, 2, 3})\n    38→      true\n    39→\n    40→      iex> ACL.matches?(internal, {8, 8, 8, 8})\n    41→      false\n    42→\n    43→      # Use CIDR notation\n    44→      iex> external = ACL.new(\"external\", [\n    45→      ...>   {:allow, \"203.0.113.0/24\"},\n    46→      ...>   {:deny, \"203.0.113.100/32\"}\n    47→      ...> ])\n    48→\n    49→      # Use geo-based rules\n    50→      iex> north_america = ACL.new(\"north_america\", [\n    51→      ...>   {:allow, {:geo, [\"US\", \"CA\", \"MX\"]}}\n    52→      ...> ])\n    53→  \"\"\"\n    54→\n    55→  defstruct [:name, :rules]\n    56→\n    57→  @type ip_address :: :inet.ip_address()\n    58→  @type cidr :: {ip_address(), non_neg_integer()}\n    59→  @type geo_rule :: {:geo, [String.t()]}\n    60→  @type rule ::\n    61→          {:allow, ip_address() | cidr() | String.t() | geo_rule()}\n    62→          | {:deny, ip_address() | cidr() | String.t() | geo_rule()}\n    63→          | {:allow, ip_address(), non_neg_integer()}\n    64→          | {:deny, ip_address(), non_neg_integer()}\n    65→  @type t :: %__MODULE__{\n    66→          name: String.t(),\n    67→          rules: [rule()]\n    68→        }\n    69→\n    70→  # Built-in ACL definitions\n    71→  @builtin_acls %{\n    72→    \"any\" => [{:allow, :any}],\n    73→    \"none\" => [{:deny, :any}],\n    74→    \"localhost\" => [\n    75→      {:allow, {127, 0, 0, 1}, 32},\n    76→      {:allow, {0, 0, 0, 0, 0, 0, 0, 1}, 128}\n    77→    ],\n    78→    \"localnets\" => [\n    79→      {:allow, {10, 0, 0, 0}, 8},\n    80→      {:allow, {172, 16, 0, 0}, 12},\n    81→      {:allow, {192, 168, 0, 0}, 16}\n    82→    ]\n    83→  }\n    84→\n    85→  @doc \"\"\"\n    86→  Creates a new ACL with the given name and rules.\n    87→\n    88→  ## Parameters\n    89→  - `name` - ACL identifier\n    90→  - `rules` - List of rules (allow/deny with IP/CIDR)\n    91→\n    92→  ## Examples\n    93→\n    94→      iex> ACL.new(\"internal\", [{:allow, {10, 0, 0, 0}, 8}])\n    95→      %ACL{name: \"internal\", rules: [{:allow, {10, 0, 0, 0}, 8}]}\n    96→  \"\"\"\n    97→  @spec new(String.t(), [rule()]) :: t()\n    98→  def new(name, rules) when is_binary(name) and is_list(rules) do\n    99→    %__MODULE__{\n   100→      name: name,\n   101→      rules: rules\n   102→    }\n   103→  end\n   104→\n   105→  @doc \"\"\"\n   106→  Checks if an IP address matches the ACL.\n   107→\n   108→  Rules are evaluated in order. The first matching rule determines\n   109→  the result. If no rules match, the default is deny (false).\n   110→\n   111→  ## Parameters\n   112→  - `acl` - The ACL to check against\n   113→  - `ip` - Client IP address tuple\n   114→\n   115→  ## Returns\n   116→  - `true` if IP matches (allowed)\n   117→  - `false` if IP doesn't match (denied)\n   118→\n   119→  ## Examples\n   120→\n   121→      iex> acl = ACL.new(\"test\", [{:allow, {10, 0, 0, 0}, 8}])\n   122→      iex> ACL.matches?(acl, {10, 1, 2, 3})\n   123→      true\n   124→\n   125→      iex> ACL.matches?(acl, {192, 168, 1, 1})\n   126→      false\n   127→  \"\"\"\n   128→  @spec matches?(t() | String.t(), ip_address()) :: boolean()\n   129→  def matches?(%__MODULE__{rules: rules}, ip) do\n   130→    evaluate_rules(rules, ip)\n   131→  end\n   132→\n   133→  def matches?(acl_name, ip) when is_binary(acl_name) do\n   134→    # Check for built-in ACLs\n   135→    case Map.get(@builtin_acls, acl_name) do\n   136→      nil ->\n   137→        # Unknown ACL, default deny\n   138→        false\n   139→\n   140→      rules ->\n   141→        evaluate_rules(rules, ip)\n   142→    end\n   143→  end\n   144→\n   145→  @doc \"\"\"\n   146→  Gets a built-in ACL by name.\n   147→\n   148→  ## Parameters\n   149→  - `name` - Built-in ACL name (\"any\", \"none\", \"localhost\", \"localnets\")\n   150→\n   151→  ## Returns\n   152→  - `{:ok, acl}` if found\n   153→  - `{:error, :not_found}` if not found\n   154→\n   155→  ## Examples\n   156→\n   157→      iex> {:ok, acl} = ACL.get_builtin(\"localhost\")\n   158→      iex> ACL.matches?(acl, {127, 0, 0, 1})\n   159→      true\n   160→  \"\"\"\n   161→  @spec get_builtin(String.t()) :: {:ok, t()} | {:error, :not_found}\n   162→  def get_builtin(name) when is_binary(name) do\n   163→    case Map.get(@builtin_acls, name) do\n   164→      nil -> {:error, :not_found}\n   165→      rules -> {:ok, new(name, rules)}\n   166→    end\n   167→  end\n   168→\n   169→  @doc \"\"\"\n   170→  Lists all available built-in ACL names.\n   171→\n   172→  ## Examples\n   173→\n   174→      iex> ACL.list_builtins()\n   175→      [\"any\", \"localhost\", \"localnets\", \"none\"]\n   176→  \"\"\"\n   177→  @spec list_builtins() :: [String.t()]\n   178→  def list_builtins do\n   179→    Map.keys(@builtin_acls) |> Enum.sort()\n   180→  end\n   181→\n   182→  @doc \"\"\"\n   183→  Parses a CIDR notation string to IP and prefix length.\n   184→\n   185→  ## Examples\n   186→\n   187→      iex> ACL.parse_cidr(\"192.168.1.0/24\")\n   188→      {:ok, {{192, 168, 1, 0}, 24}}\n   189→\n   190→      iex> ACL.parse_cidr(\"2001:db8::/32\")\n   191→      {:ok, {{0x2001, 0xdb8, 0, 0, 0, 0, 0, 0}, 32}}\n   192→\n   193→      iex> ACL.parse_cidr(\"invalid\")\n   194→      {:error, :invalid_cidr}\n   195→  \"\"\"\n   196→  @spec parse_cidr(String.t()) :: {:ok, cidr()} | {:error, :invalid_cidr}\n   197→  def parse_cidr(cidr_string) when is_binary(cidr_string) do\n   198→    case String.split(cidr_string, \"/\") do\n   199→      [ip_str, prefix_str] ->\n   200→        with {:ok, ip} <- parse_ip(ip_str),\n   201→             {prefix, \"\"} <- Integer.parse(prefix_str),\n   202→             true <- valid_prefix_length?(ip, prefix) do\n   203→          {:ok, {ip, prefix}}\n   204→        else\n   205→          _ -> {:error, :invalid_cidr}\n   206→        end\n   207→\n   208→      _ ->\n   209→        {:error, :invalid_cidr}\n   210→    end\n   211→  end\n   212→\n   213→  # Private Functions\n   214→\n   215→  defp evaluate_rules([], _ip), do: false\n   216→\n   217→  defp evaluate_rules([rule | rest], ip) do\n   218→    case match_rule?(rule, ip) do\n   219→      {:match, :allow} -> true\n   220→      {:match, :deny} -> false\n   221→      :no_match -> evaluate_rules(rest, ip)\n   222→    end\n   223→  end\n   224→\n   225→  defp match_rule?({action, :any}, _ip) when action in [:allow, :deny] do\n   226→    {:match, action}\n   227→  end\n   228→\n   229→  defp match_rule?({action, ip, prefix}, client_ip) when action in [:allow, :deny] do\n   230→    if ip_in_subnet?(client_ip, ip, prefix) do\n   231→      {:match, action}\n   232→    else\n   233→      :no_match\n   234→    end\n   235→  end\n   236→\n   237→  defp match_rule?({action, ip}, client_ip) when action in [:allow, :deny] and is_tuple(ip) do\n   238→    # Exact IP match\n   239→    if client_ip == ip do\n   240→      {:match, action}\n   241→    else\n   242→      :no_match\n   243→    end\n   244→  end\n   245→\n   246→  defp match_rule?({action, cidr_string}, client_ip)\n   247→       when action in [:allow, :deny] and is_binary(cidr_string) do\n   248→    case parse_cidr(cidr_string) do\n   249→      {:ok, {ip, prefix}} ->\n   250→        if ip_in_subnet?(client_ip, ip, prefix) do\n   251→          {:match, action}\n   252→        else\n   253→          :no_match\n   254→        end\n   255→\n   256→      {:error, _} ->\n   257→        :no_match\n   258→    end\n   259→  end\n   260→\n   261→  # Geo-based rule matching\n   262→  # Matches clients based on their geographic location (country)\n   263→  defp match_rule?({action, {:geo, country_codes}}, client_ip)\n   264→       when action in [:allow, :deny] and is_list(country_codes) do\n   265→    case GeoIpDb.country_code(client_ip) do\n   266→      {:ok, code} when is_binary(code) ->\n   267→        if code in country_codes do\n   268→          {:match, action}\n   269→        else\n   270→          :no_match\n   271→        end\n   272→\n   273→      # IP not found in geo database, no match\n   274→      _ ->\n   275→        :no_match\n   276→    end\n   277→  end\n   278→\n   279→  defp match_rule?(_, _), do: :no_match\n   280→\n   281→  defp ip_in_subnet?(client_ip, network_ip, prefix_length)\n   282→       when tuple_size(client_ip) == 4 and tuple_size(network_ip) == 4 do\n   283→    # IPv4 subnet check\n   284→    client_bits = ip_to_binary(client_ip)\n   285→    network_bits = ip_to_binary(network_ip)\n   286→\n   287→    <<client_prefix::size(prefix_length), _::bitstring>> = client_bits\n   288→    <<network_prefix::size(prefix_length), _::bitstring>> = network_bits\n   289→\n   290→    client_prefix == network_prefix\n   291→  end\n   292→\n   293→  defp ip_in_subnet?(client_ip, network_ip, prefix_length)\n   294→       when tuple_size(client_ip) == 8 and tuple_size(network_ip) == 8 do\n   295→    # IPv6 subnet check\n   296→    client_bits = ipv6_to_binary(client_ip)\n   297→    network_bits = ipv6_to_binary(network_ip)\n   298→\n   299→    <<client_prefix::size(prefix_length), _::bitstring>> = client_bits\n   300→    <<network_prefix::size(prefix_length), _::bitstring>> = network_bits\n   301→\n   302→    client_prefix == network_prefix\n   303→  end\n   304→\n   305→  defp ip_in_subnet?(_, _, _), do: false\n   306→\n   307→  defp ip_to_binary({a, b, c, d}) do\n   308→    <<a, b, c, d>>\n   309→  end\n   310→\n   311→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   312→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   313→  end\n   314→\n   315→  defp parse_ip(ip_string) do\n   316→    charlist = String.to_charlist(ip_string)\n   317→\n   318→    case :inet.parse_ipv4_address(charlist) do\n   319→      {:ok, ip} ->\n   320→        {:ok, ip}\n   321→\n   322→      {:error, _} ->\n   323→        case :inet.parse_ipv6_address(charlist) do\n   324→          {:ok, ip} -> {:ok, ip}\n   325→          {:error, _} -> {:error, :invalid_ip}\n   326→        end\n   327→    end\n   328→  end\n   329→\n   330→  defp valid_prefix_length?(ip, prefix) when tuple_size(ip) == 4 do\n   331→    prefix >= 0 and prefix <= 32\n   332→  end\n   333→\n   334→  defp valid_prefix_length?(ip, prefix) when tuple_size(ip) == 8 do\n   335→    prefix >= 0 and prefix <= 128\n   336→  end\n   337→\n   338→  defp valid_prefix_length?(_, _), do: false\n   339→end\n   340→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"84996b7b-e98e-4515-80e7-3bf6c146a135","uuid":"dc5edb7f-b128-4ced-960f-953b1caf1cc4","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/view/acl.ex","content":"defmodule YellowDog.Dns.View.ACL do\n  @moduledoc \"\"\"\n  Access Control List (ACL) implementation for DNS views.\n\n  ACLs define which clients can access specific DNS views based on\n  their IP addresses or geographic location. An ACL consists of:\n  - Name (identifier)\n  - Rules (IP addresses, CIDR blocks, geographic locations, or named ACLs)\n  - Match logic (allow/deny)\n\n  ## Built-in ACLs\n\n  - `\"any\"` - Matches all clients\n  - `\"none\"` - Matches no clients\n  - `\"localhost\"` - Matches 127.0.0.1 and ::1\n  - `\"localnets\"` - Matches RFC 1918 private networks\n\n  ## Rule Types\n\n  ### IP/CIDR Rules\n      {:allow, {10, 0, 0, 0}, 8}      # Allow 10.0.0.0/8\n      {:deny, \"192.168.1.0/24\"}       # Deny 192.168.1.0/24\n\n  ### Geo Rules\n      {:allow, {:geo, [\"US\", \"CA\"]}}  # Allow from USA and Canada\n      {:deny, {:geo, [\"CN\", \"RU\"]}}   # Deny from China and Russia\n\n  ## Examples\n\n      # Define an ACL for internal network\n      iex> internal = ACL.new(\"internal\", [\n      ...>   {:allow, {10, 0, 0, 0}, 8},\n      ...>   {:allow, {192, 168, 0, 0}, 16}\n      ...> ])\n\n      # Check if IP matches\n      iex> ACL.matches?(internal, {10, 1, 2, 3})\n      true\n\n      iex> ACL.matches?(internal, {8, 8, 8, 8})\n      false\n\n      # Use CIDR notation\n      iex> external = ACL.new(\"external\", [\n      ...>   {:allow, \"203.0.113.0/24\"},\n      ...>   {:deny, \"203.0.113.100/32\"}\n      ...> ])\n\n      # Use geo-based rules\n      iex> north_america = ACL.new(\"north_america\", [\n      ...>   {:allow, {:geo, [\"US\", \"CA\", \"MX\"]}}\n      ...> ])\n  \"\"\"\n\n  defstruct [:name, :rules]\n\n  @type ip_address :: :inet.ip_address()\n  @type cidr :: {ip_address(), non_neg_integer()}\n  @type geo_rule :: {:geo, [String.t()]}\n  @type rule ::\n          {:allow, ip_address() | cidr() | String.t() | geo_rule()}\n          | {:deny, ip_address() | cidr() | String.t() | geo_rule()}\n          | {:allow, ip_address(), non_neg_integer()}\n          | {:deny, ip_address(), non_neg_integer()}\n  @type t :: %__MODULE__{\n          name: String.t(),\n          rules: [rule()]\n        }\n\n  # Built-in ACL definitions\n  @builtin_acls %{\n    \"any\" => [{:allow, :any}],\n    \"none\" => [{:deny, :any}],\n    \"localhost\" => [\n      {:allow, {127, 0, 0, 1}, 32},\n      {:allow, {0, 0, 0, 0, 0, 0, 0, 1}, 128}\n    ],\n    \"localnets\" => [\n      {:allow, {10, 0, 0, 0}, 8},\n      {:allow, {172, 16, 0, 0}, 12},\n      {:allow, {192, 168, 0, 0}, 16}\n    ]\n  }\n\n  @doc \"\"\"\n  Creates a new ACL with the given name and rules.\n\n  ## Parameters\n  - `name` - ACL identifier\n  - `rules` - List of rules (allow/deny with IP/CIDR)\n\n  ## Examples\n\n      iex> ACL.new(\"internal\", [{:allow, {10, 0, 0, 0}, 8}])\n      %ACL{name: \"internal\", rules: [{:allow, {10, 0, 0, 0}, 8}]}\n  \"\"\"\n  @spec new(String.t(), [rule()]) :: t()\n  def new(name, rules) when is_binary(name) and is_list(rules) do\n    %__MODULE__{\n      name: name,\n      rules: rules\n    }\n  end\n\n  @doc \"\"\"\n  Checks if an IP address matches the ACL.\n\n  Rules are evaluated in order. The first matching rule determines\n  the result. If no rules match, the default is deny (false).\n\n  ## Parameters\n  - `acl` - The ACL to check against\n  - `ip` - Client IP address tuple\n\n  ## Returns\n  - `true` if IP matches (allowed)\n  - `false` if IP doesn't match (denied)\n\n  ## Examples\n\n      iex> acl = ACL.new(\"test\", [{:allow, {10, 0, 0, 0}, 8}])\n      iex> ACL.matches?(acl, {10, 1, 2, 3})\n      true\n\n      iex> ACL.matches?(acl, {192, 168, 1, 1})\n      false\n  \"\"\"\n  @spec matches?(t() | String.t(), ip_address()) :: boolean()\n  def matches?(%__MODULE__{rules: rules}, ip) do\n    evaluate_rules(rules, ip)\n  end\n\n  def matches?(acl_name, ip) when is_binary(acl_name) do\n    # Check for built-in ACLs\n    case Map.get(@builtin_acls, acl_name) do\n      nil ->\n        # Unknown ACL, default deny\n        false\n\n      rules ->\n        evaluate_rules(rules, ip)\n    end\n  end\n\n  @doc \"\"\"\n  Gets a built-in ACL by name.\n\n  ## Parameters\n  - `name` - Built-in ACL name (\"any\", \"none\", \"localhost\", \"localnets\")\n\n  ## Returns\n  - `{:ok, acl}` if found\n  - `{:error, :not_found}` if not found\n\n  ## Examples\n\n      iex> {:ok, acl} = ACL.get_builtin(\"localhost\")\n      iex> ACL.matches?(acl, {127, 0, 0, 1})\n      true\n  \"\"\"\n  @spec get_builtin(String.t()) :: {:ok, t()} | {:error, :not_found}\n  def get_builtin(name) when is_binary(name) do\n    case Map.get(@builtin_acls, name) do\n      nil -> {:error, :not_found}\n      rules -> {:ok, new(name, rules)}\n    end\n  end\n\n  @doc \"\"\"\n  Lists all available built-in ACL names.\n\n  ## Examples\n\n      iex> ACL.list_builtins()\n      [\"any\", \"localhost\", \"localnets\", \"none\"]\n  \"\"\"\n  @spec list_builtins() :: [String.t()]\n  def list_builtins do\n    Map.keys(@builtin_acls) |> Enum.sort()\n  end\n\n  @doc \"\"\"\n  Parses a CIDR notation string to IP and prefix length.\n\n  ## Examples\n\n      iex> ACL.parse_cidr(\"192.168.1.0/24\")\n      {:ok, {{192, 168, 1, 0}, 24}}\n\n      iex> ACL.parse_cidr(\"2001:db8::/32\")\n      {:ok, {{0x2001, 0xdb8, 0, 0, 0, 0, 0, 0}, 32}}\n\n      iex> ACL.parse_cidr(\"invalid\")\n      {:error, :invalid_cidr}\n  \"\"\"\n  @spec parse_cidr(String.t()) :: {:ok, cidr()} | {:error, :invalid_cidr}\n  def parse_cidr(cidr_string) when is_binary(cidr_string) do\n    case String.split(cidr_string, \"/\") do\n      [ip_str, prefix_str] ->\n        with {:ok, ip} <- parse_ip(ip_str),\n             {prefix, \"\"} <- Integer.parse(prefix_str),\n             true <- valid_prefix_length?(ip, prefix) do\n          {:ok, {ip, prefix}}\n        else\n          _ -> {:error, :invalid_cidr}\n        end\n\n      _ ->\n        {:error, :invalid_cidr}\n    end\n  end\n\n  # Private Functions\n\n  defp evaluate_rules([], _ip), do: false\n\n  defp evaluate_rules([rule | rest], ip) do\n    case match_rule?(rule, ip) do\n      {:match, :allow} -> true\n      {:match, :deny} -> false\n      :no_match -> evaluate_rules(rest, ip)\n    end\n  end\n\n  defp match_rule?({action, :any}, _ip) when action in [:allow, :deny] do\n    {:match, action}\n  end\n\n  defp match_rule?({action, ip, prefix}, client_ip) when action in [:allow, :deny] do\n    if ip_in_subnet?(client_ip, ip, prefix) do\n      {:match, action}\n    else\n      :no_match\n    end\n  end\n\n  defp match_rule?({action, ip}, client_ip) when action in [:allow, :deny] and is_tuple(ip) do\n    # Exact IP match\n    if client_ip == ip do\n      {:match, action}\n    else\n      :no_match\n    end\n  end\n\n  defp match_rule?({action, cidr_string}, client_ip)\n       when action in [:allow, :deny] and is_binary(cidr_string) do\n    case parse_cidr(cidr_string) do\n      {:ok, {ip, prefix}} ->\n        if ip_in_subnet?(client_ip, ip, prefix) do\n          {:match, action}\n        else\n          :no_match\n        end\n\n      {:error, _} ->\n        :no_match\n    end\n  end\n\n  # Geo-based rule matching\n  # Matches clients based on their geographic location (country)\n  defp match_rule?({action, {:geo, country_codes}}, client_ip)\n       when action in [:allow, :deny] and is_list(country_codes) do\n    case GeoIpDb.country_code(client_ip) do\n      {:ok, code} when is_binary(code) ->\n        if code in country_codes do\n          {:match, action}\n        else\n          :no_match\n        end\n\n      # IP not found in geo database, no match\n      _ ->\n        :no_match\n    end\n  end\n\n  defp match_rule?(_, _), do: :no_match\n\n  defp ip_in_subnet?(client_ip, network_ip, prefix_length)\n       when tuple_size(client_ip) == 4 and tuple_size(network_ip) == 4 do\n    # IPv4 subnet check\n    client_bits = ip_to_binary(client_ip)\n    network_bits = ip_to_binary(network_ip)\n\n    <<client_prefix::size(prefix_length), _::bitstring>> = client_bits\n    <<network_prefix::size(prefix_length), _::bitstring>> = network_bits\n\n    client_prefix == network_prefix\n  end\n\n  defp ip_in_subnet?(client_ip, network_ip, prefix_length)\n       when tuple_size(client_ip) == 8 and tuple_size(network_ip) == 8 do\n    # IPv6 subnet check\n    client_bits = ipv6_to_binary(client_ip)\n    network_bits = ipv6_to_binary(network_ip)\n\n    <<client_prefix::size(prefix_length), _::bitstring>> = client_bits\n    <<network_prefix::size(prefix_length), _::bitstring>> = network_bits\n\n    client_prefix == network_prefix\n  end\n\n  defp ip_in_subnet?(_, _, _), do: false\n\n  defp ip_to_binary({a, b, c, d}) do\n    <<a, b, c, d>>\n  end\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\n\n  defp parse_ip(ip_string) do\n    charlist = String.to_charlist(ip_string)\n\n    case :inet.parse_ipv4_address(charlist) do\n      {:ok, ip} ->\n        {:ok, ip}\n\n      {:error, _} ->\n        case :inet.parse_ipv6_address(charlist) do\n          {:ok, ip} -> {:ok, ip}\n          {:error, _} -> {:error, :invalid_ip}\n        end\n    end\n  end\n\n  defp valid_prefix_length?(ip, prefix) when tuple_size(ip) == 4 do\n    prefix >= 0 and prefix <= 32\n  end\n\n  defp valid_prefix_length?(ip, prefix) when tuple_size(ip) == 8 do\n    prefix >= 0 and prefix <= 128\n  end\n\n  defp valid_prefix_length?(_, _), do: false\nend\n","numLines":340,"startLine":1,"totalLines":340}}}
