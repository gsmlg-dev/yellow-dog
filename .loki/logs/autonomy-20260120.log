{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P5HsMeyPntiji6bBzrHeyr","type":"tool_result","content":"     1→defmodule YellowDog.Dns.ZoneController do\n     2→  @moduledoc \"\"\"\n     3→  Supervisor for DNS zone processes.\n     4→\n     5→  The ZoneController manages the lifecycle of zone processes:\n     6→  - Auth zones (authoritative data)\n     7→  - Forward zones (upstream forwarding)\n     8→  - Stub zones (NS delegation)\n     9→  - Root zone (root hints)\n    10→  - Cache zones (query caching)\n    11→\n    12→  Zones are scoped to views - each view can have its own set of zones\n    13→  with the same names without conflict.\n    14→\n    15→  Zones can be dynamically added, removed, and reloaded.\n    16→  \"\"\"\n    17→\n    18→  use DynamicSupervisor\n    19→\n    20→  alias YellowDog.Telemetry\n    21→\n    22→  # Default view name for zones not explicitly assigned to a view\n    23→  @default_view \"default\"\n    24→\n    25→  @doc \"\"\"\n    26→  Starts the ZoneController supervisor.\n    27→  \"\"\"\n    28→  @spec start_link(keyword()) :: Supervisor.on_start()\n    29→  def start_link(opts \\\\ []) do\n    30→    name = Keyword.get(opts, :name, __MODULE__)\n    31→    DynamicSupervisor.start_link(__MODULE__, opts, name: name)\n    32→  end\n    33→\n    34→  @impl true\n    35→  def init(_opts) do\n    36→    Telemetry.info(\"ZoneController starting\")\n    37→    DynamicSupervisor.init(strategy: :one_for_one)\n    38→  end\n    39→\n    40→  @doc \"\"\"\n    41→  Starts a zone process.\n    42→\n    43→  ## Parameters\n    44→\n    45→  - `zone_type` - Type of zone (:auth, :forward, :stub, :root, :cache)\n    46→  - `zone_name` - Name of the zone (e.g., \"example.com\")\n    47→  - `config` - Zone-specific configuration\n    48→    - `:view_name` - View this zone belongs to (default: \"default\")\n    49→    - Other zone-specific options\n    50→\n    51→  ## Returns\n    52→\n    53→  - `{:ok, pid}` on success\n    54→  - `{:error, reason}` on failure\n    55→  \"\"\"\n    56→  @spec start_zone(atom(), String.t(), keyword()) :: DynamicSupervisor.on_start_child()\n    57→  def start_zone(zone_type, zone_name, config \\\\ []) do\n    58→    start_zone(__MODULE__, zone_type, zone_name, config)\n    59→  end\n    60→\n    61→  @spec start_zone(Supervisor.supervisor(), atom(), String.t(), keyword()) ::\n    62→          DynamicSupervisor.on_start_child()\n    63→  def start_zone(supervisor, zone_type, zone_name, config) do\n    64→    view_name = Keyword.get(config, :view_name, @default_view)\n    65→    module = zone_module(zone_type)\n    66→    opts = Keyword.merge(config, name: zone_name, view_name: view_name)\n    67→\n    68→    # Add zone_data_path for auth zones to enable persistence\n    69→    opts =\n    70→      if zone_type == :auth do\n    71→        case get_zone_data_path() do\n    72→          nil -> opts\n    73→          path -> Keyword.put_new(opts, :zone_data_path, path)\n    74→        end\n    75→      else\n    76→        opts\n    77→      end\n    78→\n    79→    # Zone ID is scoped to view: {view_name, zone_type, zone_name}\n    80→    child_spec = %{\n    81→      id: {view_name, zone_type, zone_name},\n    82→      start: {module, :start_link, [opts]},\n    83→      restart: :permanent,\n    84→      type: :worker\n    85→    }\n    86→\n    87→    case DynamicSupervisor.start_child(supervisor, child_spec) do\n    88→      {:ok, pid} = result ->\n    89→        Telemetry.info(\"Zone started\", %{\n    90→          view: view_name,\n    91→          type: zone_type,\n    92→          name: zone_name,\n    93→          pid: inspect(pid)\n    94→        })\n    95→\n    96→        result\n    97→\n    98→      {:error, reason} = error ->\n    99→        Telemetry.error(\"Failed to start zone\", %{\n   100→          view: view_name,\n   101→          type: zone_type,\n   102→          name: zone_name,\n   103→          reason: inspect(reason)\n   104→        })\n   105→\n   106→        error\n   107→    end\n   108→  end\n   109→\n   110→  @doc \"\"\"\n   111→  Stops a zone process.\n   112→\n   113→  ## Parameters\n   114→\n   115→  - `view_name` - View the zone belongs to\n   116→  - `zone_type` - Type of zone\n   117→  - `zone_name` - Name of the zone\n   118→  \"\"\"\n   119→  @spec stop_zone(String.t(), atom(), String.t()) :: :ok | {:error, :not_found}\n   120→  def stop_zone(view_name, zone_type, zone_name) do\n   121→    stop_zone(__MODULE__, view_name, zone_type, zone_name)\n   122→  end\n   123→\n   124→  # Backward compatible version without view_name (uses default view)\n   125→  @spec stop_zone(atom(), String.t()) :: :ok | {:error, :not_found}\n   126→  def stop_zone(zone_type, zone_name) when is_atom(zone_type) do\n   127→    stop_zone(__MODULE__, @default_view, zone_type, zone_name)\n   128→  end\n   129→\n   130→  @spec stop_zone(Supervisor.supervisor(), String.t(), atom(), String.t()) ::\n   131→          :ok | {:error, :not_found}\n   132→  def stop_zone(supervisor, view_name, zone_type, zone_name) do\n   133→    case find_zone(supervisor, view_name, zone_type, zone_name) do\n   134→      {:ok, pid} ->\n   135→        DynamicSupervisor.terminate_child(supervisor, pid)\n   136→\n   137→        Telemetry.info(\"Zone stopped\", %{view: view_name, type: zone_type, name: zone_name})\n   138→        :ok\n   139→\n   140→      :error ->\n   141→        {:error, :not_found}\n   142→    end\n   143→  end\n   144→\n   145→  @doc \"\"\"\n   146→  Finds a zone process by view, type and name.\n   147→  \"\"\"\n   148→  @spec find_zone(String.t(), atom(), String.t()) :: {:ok, pid()} | :error\n   149→  def find_zone(view_name, zone_type, zone_name) do\n   150→    find_zone(__MODULE__, view_name, zone_type, zone_name)\n   151→  end\n   152→\n   153→  # Backward compatible version without view_name (uses default view)\n   154→  @spec find_zone(atom(), String.t()) :: {:ok, pid()} | :error\n   155→  def find_zone(zone_type, zone_name) when is_atom(zone_type) do\n   156→    find_zone(__MODULE__, @default_view, zone_type, zone_name)\n   157→  end\n   158→\n   159→  @spec find_zone(Supervisor.supervisor(), String.t(), atom(), String.t()) ::\n   160→          {:ok, pid()} | :error\n   161→  def find_zone(supervisor, view_name, zone_type, zone_name) do\n   162→    module = zone_module(zone_type)\n   163→    children = DynamicSupervisor.which_children(supervisor)\n   164→\n   165→    # First try exact ID match\n   166→    case Enum.find(children, fn {id, _pid, _type, _modules} ->\n   167→           id == {view_name, zone_type, zone_name}\n   168→         end) do\n   169→      {_id, pid, _type, _modules} when is_pid(pid) -> {:ok, pid}\n   170→      _ -> find_by_module_view_and_name(children, module, view_name, zone_name)\n   171→    end\n   172→  end\n   173→\n   174→  @doc \"\"\"\n   175→  Lists all active zones.\n   176→\n   177→  Returns a list of tuples: `{view_name, zone_type, zone_name, pid}`\n   178→  \"\"\"\n   179→  @spec list_zones() :: [{String.t(), atom(), String.t(), pid()}]\n   180→  def list_zones do\n   181→    list_zones(__MODULE__)\n   182→  end\n   183→\n   184→  @spec list_zones(Supervisor.supervisor()) :: [{String.t(), atom(), String.t(), pid()}]\n   185→  def list_zones(supervisor) do\n   186→    DynamicSupervisor.which_children(supervisor)\n   187→    |> Enum.filter(fn {_id, pid, _type, _modules} -> is_pid(pid) end)\n   188→    |> Enum.map(fn {id, pid, _type, modules} ->\n   189→      case id do\n   190→        {view_name, zone_type, zone_name} ->\n   191→          {view_name, zone_type, zone_name, pid}\n   192→\n   193→        # Legacy format without view_name\n   194→        {zone_type, zone_name} ->\n   195→          {@default_view, zone_type, zone_name, pid}\n   196→\n   197→        _ ->\n   198→          # ID is :undefined, extract info from module and process\n   199→          zone_type = module_to_zone_type(List.first(modules))\n   200→          zone_name = get_zone_name_from_pid(modules, pid)\n   201→          view_name = get_zone_view_from_pid(modules, pid)\n   202→          {view_name, zone_type, zone_name, pid}\n   203→      end\n   204→    end)\n   205→    |> Enum.filter(fn {_view, _type, name, _pid} -> name != nil end)\n   206→  end\n   207→\n   208→  @doc \"\"\"\n   209→  Lists zones for a specific view.\n   210→  \"\"\"\n   211→  @spec list_zones_for_view(String.t()) :: [{atom(), String.t(), pid()}]\n   212→  def list_zones_for_view(view_name) do\n   213→    list_zones_for_view(__MODULE__, view_name)\n   214→  end\n   215→\n   216→  @spec list_zones_for_view(Supervisor.supervisor(), String.t()) :: [{atom(), String.t(), pid()}]\n   217→  def list_zones_for_view(supervisor, view_name) do\n   218→    list_zones(supervisor)\n   219→    |> Enum.filter(fn {v, _type, _name, _pid} -> v == view_name end)\n   220→    |> Enum.map(fn {_view, type, name, pid} -> {type, name, pid} end)\n   221→  end\n   222→\n   223→  # Map module back to zone type\n   224→  defp module_to_zone_type(YellowDog.Dns.Zone.Auth), do: :auth\n   225→  defp module_to_zone_type(YellowDog.Dns.Zone.Forward), do: :forward\n   226→  defp module_to_zone_type(YellowDog.Dns.Zone.Stub), do: :stub\n   227→  defp module_to_zone_type(YellowDog.Dns.Zone.Root), do: :root\n   228→  defp module_to_zone_type(YellowDog.Dns.Zone.Cache), do: :cache\n   229→  defp module_to_zone_type(YellowDog.Dns.Zone.RPZ), do: :rpz\n   230→  defp module_to_zone_type(_), do: :unknown\n   231→\n   232→  # Get zone name from process\n   233→  defp get_zone_name_from_pid(modules, pid) do\n   234→    module = List.first(modules)\n   235→\n   236→    try do\n   237→      module.get_name(pid)\n   238→    catch\n   239→      _, _ -> nil\n   240→    end\n   241→  end\n   242→\n   243→  # Get zone view from process\n   244→  defp get_zone_view_from_pid(modules, pid) do\n   245→    module = List.first(modules)\n   246→\n   247→    try do\n   248→      module.get_view(pid)\n   249→    catch\n   250→      _, _ -> @default_view\n   251→    end\n   252→  end\n   253→\n   254→  @doc \"\"\"\n   255→  Reloads a zone with new configuration.\n   256→  \"\"\"\n   257→  @spec reload_zone(String.t(), atom(), String.t(), keyword()) :: :ok | {:error, term()}\n   258→  def reload_zone(view_name, zone_type, zone_name, config) do\n   259→    reload_zone(__MODULE__, view_name, zone_type, zone_name, config)\n   260→  end\n   261→\n   262→  # Backward compatible version without view_name\n   263→  @spec reload_zone(atom(), String.t(), keyword()) :: :ok | {:error, term()}\n   264→  def reload_zone(zone_type, zone_name, config) when is_atom(zone_type) do\n   265→    reload_zone(__MODULE__, @default_view, zone_type, zone_name, config)\n   266→  end\n   267→\n   268→  @spec reload_zone(Supervisor.supervisor(), String.t(), atom(), String.t(), keyword()) ::\n   269→          :ok | {:error, term()}\n   270→  def reload_zone(supervisor, view_name, zone_type, zone_name, config) do\n   271→    case find_zone(supervisor, view_name, zone_type, zone_name) do\n   272→      {:ok, pid} ->\n   273→        module = zone_module(zone_type)\n   274→        module.reload(pid, config)\n   275→\n   276→      :error ->\n   277→        {:error, :not_found}\n   278→    end\n   279→  end\n   280→\n   281→  # Maps zone type atoms to module names\n   282→  defp zone_module(:auth), do: YellowDog.Dns.Zone.Auth\n   283→  defp zone_module(:forward), do: YellowDog.Dns.Zone.Forward\n   284→  defp zone_module(:stub), do: YellowDog.Dns.Zone.Stub\n   285→  defp zone_module(:root), do: YellowDog.Dns.Zone.Root\n   286→  defp zone_module(:cache), do: YellowDog.Dns.Zone.Cache\n   287→  defp zone_module(:rpz), do: YellowDog.Dns.Zone.RPZ\n   288→\n   289→  defp find_by_module_view_and_name(children, module, view_name, zone_name) do\n   290→    Enum.find_value(children, :error, fn {_id, pid, _type, modules} ->\n   291→      if is_pid(pid) and module in modules do\n   292→        # Check if this is the right zone by calling get_name and get_view\n   293→        try do\n   294→          pid_name = module.get_name(pid)\n   295→\n   296→          pid_view =\n   297→            try do\n   298→              module.get_view(pid)\n   299→            catch\n   300→              _, _ -> @default_view\n   301→            end\n   302→\n   303→          if pid_name == zone_name and pid_view == view_name do\n   304→            {:ok, pid}\n   305→          else\n   306→            nil\n   307→          end\n   308→        catch\n   309→          _, _ -> nil\n   310→        end\n   311→      else\n   312→        nil\n   313→      end\n   314→    end)\n   315→  end\n   316→\n   317→  # Get zone data path from config with fallback to default\n   318→  defp get_zone_data_path do\n   319→    try do\n   320→      apply(YellowDog.Config, :get, [:dns, :zone_data_path]) ||\n   321→        default_zone_data_path()\n   322→    rescue\n   323→      _ -> default_zone_data_path()\n   324→    end\n   325→  end\n   326→\n   327→  defp default_zone_data_path do\n   328→    # Default to priv/zones directory\n   329→    case :code.priv_dir(:yellow_dog_dns) do\n   330→      {:error, _} -> \"priv/zones\"\n   331→      path -> Path.join(to_string(path), \"zones\")\n   332→    end\n   333→  end\n   334→end\n   335→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"84996b7b-e98e-4515-80e7-3bf6c146a135","uuid":"51c7236d-d0ba-427c-accc-ae3ab4e6ecbd","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/zone_controller.ex","content":"defmodule YellowDog.Dns.ZoneController do\n  @moduledoc \"\"\"\n  Supervisor for DNS zone processes.\n\n  The ZoneController manages the lifecycle of zone processes:\n  - Auth zones (authoritative data)\n  - Forward zones (upstream forwarding)\n  - Stub zones (NS delegation)\n  - Root zone (root hints)\n  - Cache zones (query caching)\n\n  Zones are scoped to views - each view can have its own set of zones\n  with the same names without conflict.\n\n  Zones can be dynamically added, removed, and reloaded.\n  \"\"\"\n\n  use DynamicSupervisor\n\n  alias YellowDog.Telemetry\n\n  # Default view name for zones not explicitly assigned to a view\n  @default_view \"default\"\n\n  @doc \"\"\"\n  Starts the ZoneController supervisor.\n  \"\"\"\n  @spec start_link(keyword()) :: Supervisor.on_start()\n  def start_link(opts \\\\ []) do\n    name = Keyword.get(opts, :name, __MODULE__)\n    DynamicSupervisor.start_link(__MODULE__, opts, name: name)\n  end\n\n  @impl true\n  def init(_opts) do\n    Telemetry.info(\"ZoneController starting\")\n    DynamicSupervisor.init(strategy: :one_for_one)\n  end\n\n  @doc \"\"\"\n  Starts a zone process.\n\n  ## Parameters\n\n  - `zone_type` - Type of zone (:auth, :forward, :stub, :root, :cache)\n  - `zone_name` - Name of the zone (e.g., \"example.com\")\n  - `config` - Zone-specific configuration\n    - `:view_name` - View this zone belongs to (default: \"default\")\n    - Other zone-specific options\n\n  ## Returns\n\n  - `{:ok, pid}` on success\n  - `{:error, reason}` on failure\n  \"\"\"\n  @spec start_zone(atom(), String.t(), keyword()) :: DynamicSupervisor.on_start_child()\n  def start_zone(zone_type, zone_name, config \\\\ []) do\n    start_zone(__MODULE__, zone_type, zone_name, config)\n  end\n\n  @spec start_zone(Supervisor.supervisor(), atom(), String.t(), keyword()) ::\n          DynamicSupervisor.on_start_child()\n  def start_zone(supervisor, zone_type, zone_name, config) do\n    view_name = Keyword.get(config, :view_name, @default_view)\n    module = zone_module(zone_type)\n    opts = Keyword.merge(config, name: zone_name, view_name: view_name)\n\n    # Add zone_data_path for auth zones to enable persistence\n    opts =\n      if zone_type == :auth do\n        case get_zone_data_path() do\n          nil -> opts\n          path -> Keyword.put_new(opts, :zone_data_path, path)\n        end\n      else\n        opts\n      end\n\n    # Zone ID is scoped to view: {view_name, zone_type, zone_name}\n    child_spec = %{\n      id: {view_name, zone_type, zone_name},\n      start: {module, :start_link, [opts]},\n      restart: :permanent,\n      type: :worker\n    }\n\n    case DynamicSupervisor.start_child(supervisor, child_spec) do\n      {:ok, pid} = result ->\n        Telemetry.info(\"Zone started\", %{\n          view: view_name,\n          type: zone_type,\n          name: zone_name,\n          pid: inspect(pid)\n        })\n\n        result\n\n      {:error, reason} = error ->\n        Telemetry.error(\"Failed to start zone\", %{\n          view: view_name,\n          type: zone_type,\n          name: zone_name,\n          reason: inspect(reason)\n        })\n\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Stops a zone process.\n\n  ## Parameters\n\n  - `view_name` - View the zone belongs to\n  - `zone_type` - Type of zone\n  - `zone_name` - Name of the zone\n  \"\"\"\n  @spec stop_zone(String.t(), atom(), String.t()) :: :ok | {:error, :not_found}\n  def stop_zone(view_name, zone_type, zone_name) do\n    stop_zone(__MODULE__, view_name, zone_type, zone_name)\n  end\n\n  # Backward compatible version without view_name (uses default view)\n  @spec stop_zone(atom(), String.t()) :: :ok | {:error, :not_found}\n  def stop_zone(zone_type, zone_name) when is_atom(zone_type) do\n    stop_zone(__MODULE__, @default_view, zone_type, zone_name)\n  end\n\n  @spec stop_zone(Supervisor.supervisor(), String.t(), atom(), String.t()) ::\n          :ok | {:error, :not_found}\n  def stop_zone(supervisor, view_name, zone_type, zone_name) do\n    case find_zone(supervisor, view_name, zone_type, zone_name) do\n      {:ok, pid} ->\n        DynamicSupervisor.terminate_child(supervisor, pid)\n\n        Telemetry.info(\"Zone stopped\", %{view: view_name, type: zone_type, name: zone_name})\n        :ok\n\n      :error ->\n        {:error, :not_found}\n    end\n  end\n\n  @doc \"\"\"\n  Finds a zone process by view, type and name.\n  \"\"\"\n  @spec find_zone(String.t(), atom(), String.t()) :: {:ok, pid()} | :error\n  def find_zone(view_name, zone_type, zone_name) do\n    find_zone(__MODULE__, view_name, zone_type, zone_name)\n  end\n\n  # Backward compatible version without view_name (uses default view)\n  @spec find_zone(atom(), String.t()) :: {:ok, pid()} | :error\n  def find_zone(zone_type, zone_name) when is_atom(zone_type) do\n    find_zone(__MODULE__, @default_view, zone_type, zone_name)\n  end\n\n  @spec find_zone(Supervisor.supervisor(), String.t(), atom(), String.t()) ::\n          {:ok, pid()} | :error\n  def find_zone(supervisor, view_name, zone_type, zone_name) do\n    module = zone_module(zone_type)\n    children = DynamicSupervisor.which_children(supervisor)\n\n    # First try exact ID match\n    case Enum.find(children, fn {id, _pid, _type, _modules} ->\n           id == {view_name, zone_type, zone_name}\n         end) do\n      {_id, pid, _type, _modules} when is_pid(pid) -> {:ok, pid}\n      _ -> find_by_module_view_and_name(children, module, view_name, zone_name)\n    end\n  end\n\n  @doc \"\"\"\n  Lists all active zones.\n\n  Returns a list of tuples: `{view_name, zone_type, zone_name, pid}`\n  \"\"\"\n  @spec list_zones() :: [{String.t(), atom(), String.t(), pid()}]\n  def list_zones do\n    list_zones(__MODULE__)\n  end\n\n  @spec list_zones(Supervisor.supervisor()) :: [{String.t(), atom(), String.t(), pid()}]\n  def list_zones(supervisor) do\n    DynamicSupervisor.which_children(supervisor)\n    |> Enum.filter(fn {_id, pid, _type, _modules} -> is_pid(pid) end)\n    |> Enum.map(fn {id, pid, _type, modules} ->\n      case id do\n        {view_name, zone_type, zone_name} ->\n          {view_name, zone_type, zone_name, pid}\n\n        # Legacy format without view_name\n        {zone_type, zone_name} ->\n          {@default_view, zone_type, zone_name, pid}\n\n        _ ->\n          # ID is :undefined, extract info from module and process\n          zone_type = module_to_zone_type(List.first(modules))\n          zone_name = get_zone_name_from_pid(modules, pid)\n          view_name = get_zone_view_from_pid(modules, pid)\n          {view_name, zone_type, zone_name, pid}\n      end\n    end)\n    |> Enum.filter(fn {_view, _type, name, _pid} -> name != nil end)\n  end\n\n  @doc \"\"\"\n  Lists zones for a specific view.\n  \"\"\"\n  @spec list_zones_for_view(String.t()) :: [{atom(), String.t(), pid()}]\n  def list_zones_for_view(view_name) do\n    list_zones_for_view(__MODULE__, view_name)\n  end\n\n  @spec list_zones_for_view(Supervisor.supervisor(), String.t()) :: [{atom(), String.t(), pid()}]\n  def list_zones_for_view(supervisor, view_name) do\n    list_zones(supervisor)\n    |> Enum.filter(fn {v, _type, _name, _pid} -> v == view_name end)\n    |> Enum.map(fn {_view, type, name, pid} -> {type, name, pid} end)\n  end\n\n  # Map module back to zone type\n  defp module_to_zone_type(YellowDog.Dns.Zone.Auth), do: :auth\n  defp module_to_zone_type(YellowDog.Dns.Zone.Forward), do: :forward\n  defp module_to_zone_type(YellowDog.Dns.Zone.Stub), do: :stub\n  defp module_to_zone_type(YellowDog.Dns.Zone.Root), do: :root\n  defp module_to_zone_type(YellowDog.Dns.Zone.Cache), do: :cache\n  defp module_to_zone_type(YellowDog.Dns.Zone.RPZ), do: :rpz\n  defp module_to_zone_type(_), do: :unknown\n\n  # Get zone name from process\n  defp get_zone_name_from_pid(modules, pid) do\n    module = List.first(modules)\n\n    try do\n      module.get_name(pid)\n    catch\n      _, _ -> nil\n    end\n  end\n\n  # Get zone view from process\n  defp get_zone_view_from_pid(modules, pid) do\n    module = List.first(modules)\n\n    try do\n      module.get_view(pid)\n    catch\n      _, _ -> @default_view\n    end\n  end\n\n  @doc \"\"\"\n  Reloads a zone with new configuration.\n  \"\"\"\n  @spec reload_zone(String.t(), atom(), String.t(), keyword()) :: :ok | {:error, term()}\n  def reload_zone(view_name, zone_type, zone_name, config) do\n    reload_zone(__MODULE__, view_name, zone_type, zone_name, config)\n  end\n\n  # Backward compatible version without view_name\n  @spec reload_zone(atom(), String.t(), keyword()) :: :ok | {:error, term()}\n  def reload_zone(zone_type, zone_name, config) when is_atom(zone_type) do\n    reload_zone(__MODULE__, @default_view, zone_type, zone_name, config)\n  end\n\n  @spec reload_zone(Supervisor.supervisor(), String.t(), atom(), String.t(), keyword()) ::\n          :ok | {:error, term()}\n  def reload_zone(supervisor, view_name, zone_type, zone_name, config) do\n    case find_zone(supervisor, view_name, zone_type, zone_name) do\n      {:ok, pid} ->\n        module = zone_module(zone_type)\n        module.reload(pid, config)\n\n      :error ->\n        {:error, :not_found}\n    end\n  end\n\n  # Maps zone type atoms to module names\n  defp zone_module(:auth), do: YellowDog.Dns.Zone.Auth\n  defp zone_module(:forward), do: YellowDog.Dns.Zone.Forward\n  defp zone_module(:stub), do: YellowDog.Dns.Zone.Stub\n  defp zone_module(:root), do: YellowDog.Dns.Zone.Root\n  defp zone_module(:cache), do: YellowDog.Dns.Zone.Cache\n  defp zone_module(:rpz), do: YellowDog.Dns.Zone.RPZ\n\n  defp find_by_module_view_and_name(children, module, view_name, zone_name) do\n    Enum.find_value(children, :error, fn {_id, pid, _type, modules} ->\n      if is_pid(pid) and module in modules do\n        # Check if this is the right zone by calling get_name and get_view\n        try do\n          pid_name = module.get_name(pid)\n\n          pid_view =\n            try do\n              module.get_view(pid)\n            catch\n              _, _ -> @default_view\n            end\n\n          if pid_name == zone_name and pid_view == view_name do\n            {:ok, pid}\n          else\n            nil\n          end\n        catch\n          _, _ -> nil\n        end\n      else\n        nil\n      end\n    end)\n  end\n\n  # Get zone data path from config with fallback to default\n  defp get_zone_data_path do\n    try do\n      apply(YellowDog.Config, :get, [:dns, :zone_data_path]) ||\n        default_zone_data_path()\n    rescue\n      _ -> default_zone_data_path()\n    end\n  end\n\n  defp default_zone_data_path do\n    # Default to priv/zones directory\n    case :code.priv_dir(:yellow_dog_dns) do\n      {:error, _} -> \"priv/zones\"\n      path -> Path.join(to_string(path), \"zones\")\n    end\n  end\nend\n","numLines":335,"startLine":1,"totalLines":335}}}
