{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KH9rUhSywszZjxyQKNG4mP","type":"tool_result","content":"     1→defmodule YellowDog.Config do\n     2→  @moduledoc \"\"\"\n     3→  Configuration management for YellowDog with TOML file support.\n     4→\n     5→  Provides API for service applications to query their configuration\n     6→  and check if they are enabled.\n     7→  \"\"\"\n     8→\n     9→  use Agent\n    10→\n    11→  @type config_map :: map()\n    12→  @type service_name :: :dns | :mdns | :dhcpv4 | :dhcpv6\n    13→  @type config_key :: atom()\n    14→  @type config_value :: term()\n    15→  @type zone_name :: String.t()\n    16→  @type zone_type :: :authoritative | :stub | :forward | :cache\n    17→\n    18→  # Default configuration fallback (now defined in application)\n    19→  @default_config %{}\n    20→\n    21→  @doc \"\"\"\n    22→  Starts the configuration agent with the given config.\n    23→  \"\"\"\n    24→  def start_link(config) do\n    25→    Agent.start_link(fn -> config end, name: __MODULE__)\n    26→  end\n    27→\n    28→  @doc \"\"\"\n    29→  Gets all configuration as a map.\n    30→  \"\"\"\n    31→  @spec get_all() :: config_map()\n    32→  def get_all do\n    33→    Agent.get(__MODULE__, fn state -> state end)\n    34→  end\n    35→\n    36→  @doc \"\"\"\n    37→  Gets a configuration value by name.\n    38→  \"\"\"\n    39→  @spec get(config_key()) :: config_value()\n    40→  def get(name) do\n    41→    Agent.get(__MODULE__, fn state -> Map.get(state, name) end)\n    42→  end\n    43→\n    44→  @doc \"\"\"\n    45→  Checks if a service is enabled in the configuration.\n    46→\n    47→  ## Examples\n    48→\n    49→      iex> YellowDog.Config.service_enabled?(:dns)\n    50→      true\n    51→\n    52→      iex> YellowDog.Config.service_enabled?(:mdns)\n    53→      false\n    54→  \"\"\"\n    55→  @spec service_enabled?(service_name()) :: boolean()\n    56→  def service_enabled?(service) do\n    57→    case get(\"core\") do\n    58→      %{\"core\" => core_config} ->\n    59→        Map.get(core_config, to_string(service), true)\n    60→\n    61→      core_config when is_map(core_config) ->\n    62→        Map.get(core_config, to_string(service), true)\n    63→\n    64→      _ ->\n    65→        true\n    66→    end\n    67→  end\n    68→\n    69→  @doc \"\"\"\n    70→  Enables or disables a service in the configuration.\n    71→\n    72→  ## Examples\n    73→\n    74→      iex> YellowDog.Config.set_service_enabled(:dns, true)\n    75→      :ok\n    76→\n    77→      iex> YellowDog.Config.set_service_enabled(:mdns, false)\n    78→      :ok\n    79→  \"\"\"\n    80→  @spec set_service_enabled(service_name(), boolean()) :: :ok\n    81→  def set_service_enabled(service, enabled) do\n    82→    Agent.update(__MODULE__, fn state ->\n    83→      core_config = Map.get(state, \"core\", %{})\n    84→      new_core = Map.put(core_config, to_string(service), enabled)\n    85→      Map.put(state, \"core\", new_core)\n    86→    end)\n    87→  end\n    88→\n    89→  @doc \"\"\"\n    90→  Gets a specific configuration value for a service.\n    91→\n    92→  ## Examples\n    93→\n    94→      iex> YellowDog.Config.get(:dns, :port)\n    95→      53\n    96→\n    97→      iex> YellowDog.Config.get(:dhcpv4, :listen)\n    98→      \"0.0.0.0\"\n    99→  \"\"\"\n   100→  @spec get(service_name(), config_key()) :: config_value()\n   101→  def get(service, key) do\n   102→    service_config = get_service(service)\n   103→    Map.get(service_config, key, get_default_value(service, key))\n   104→  end\n   105→\n   106→  @doc \"\"\"\n   107→  Gets the entire configuration for a service.\n   108→\n   109→  ## Examples\n   110→\n   111→      iex> YellowDog.Config.get_service(:dns)\n   112→      %{listen: \"0.0.0.0\", port: 53}\n   113→  \"\"\"\n   114→  @spec get_service(service_name()) :: map()\n   115→  def get_service(service) do\n   116→    case get(to_string(service)) do\n   117→      service_config when is_map(service_config) ->\n   118→        # Convert string keys to atoms for easier access\n   119→        # If keys are already atoms (from transformer), keep them as-is\n   120→        for {key, val} <- service_config, into: %{} do\n   121→          atom_key = if is_binary(key), do: String.to_atom(key), else: key\n   122→          {atom_key, val}\n   123→        end\n   124→\n   125→      _ ->\n   126→        get_default_service_config(service)\n   127→    end\n   128→  end\n   129→\n   130→  @doc \"\"\"\n   131→  Loads configuration from a TOML file path.\n   132→\n   133→  ## Examples\n   134→\n   135→      iex> YellowDog.Config.load(\"/path/to/config.toml\")\n   136→      {:ok, %{...}}\n   137→\n   138→      iex> YellowDog.Config.load(\"/nonexistent.toml\")\n   139→      {:error, :enoent}\n   140→  \"\"\"\n   141→  @spec load(String.t()) :: {:ok, config_map()} | {:error, term()}\n   142→  def load(path) do\n   143→    case File.read(path) do\n   144→      {:ok, content} ->\n   145→        case Toml.decode(content) do\n   146→          {:ok, config} ->\n   147→            :telemetry.execute(\n   148→              [:yellow_dog, :config, :loaded],\n   149→              %{count: 1},\n   150→              %{source: __MODULE__, path: path, severity: :info}\n   151→            )\n   152→\n   153→            {:ok, config}\n   154→\n   155→          {:error, reason} ->\n   156→            :telemetry.execute(\n   157→              [:yellow_dog, :config, :error],\n   158→              %{count: 1},\n   159→              %{\n   160→                source: __MODULE__,\n   161→                path: path,\n   162→                reason: :parse_error,\n   163→                error: inspect(reason),\n   164→                severity: :error\n   165→              }\n   166→            )\n   167→\n   168→            {:error, reason}\n   169→        end\n   170→\n   171→      {:error, reason} ->\n   172→        :telemetry.execute(\n   173→          [:yellow_dog, :config, :error],\n   174→          %{count: 1},\n   175→          %{\n   176→            source: __MODULE__,\n   177→            path: path,\n   178→            reason: :read_error,\n   179→            error: inspect(reason),\n   180→            severity: :error\n   181→          }\n   182→        )\n   183→\n   184→        {:error, reason}\n   185→    end\n   186→  end\n   187→\n   188→  @doc \"\"\"\n   189→  Loads configuration with fallback to defaults.\n   190→  \"\"\"\n   191→  @spec load_with_fallback(String.t()) :: config_map()\n   192→  def load_with_fallback(path) do\n   193→    case load(path) do\n   194→      {:ok, config} ->\n   195→        config\n   196→\n   197→      {:error, _reason} ->\n   198→        :telemetry.execute(\n   199→          [:yellow_dog, :config, :loaded],\n   200→          %{count: 1},\n   201→          %{source: __MODULE__, fallback: true, severity: :warning}\n   202→        )\n   203→\n   204→        @default_config\n   205→    end\n   206→  end\n   207→\n   208→  # Private helper functions\n   209→\n   210→  defp get_default_service_config(service) do\n   211→    case Map.get(@default_config, to_string(service)) do\n   212→      nil ->\n   213→        %{}\n   214→\n   215→      config ->\n   216→        for {key, val} <- config, into: %{}, do: {String.to_atom(key), val}\n   217→    end\n   218→  end\n   219→\n   220→  defp get_default_value(service, key) do\n   221→    service_config = get_default_service_config(service)\n   222→    Map.get(service_config, key)\n   223→  end\n   224→\n   225→  @doc \"\"\"\n   226→  Gets all DNS zones from configuration.\n   227→\n   228→  ## Examples\n   229→\n   230→      iex> YellowDog.Config.get_dns_zones()\n   231→      %{\"example.com\" => %{type: \"authoritative\", file: \"zones/example.com.zone\"}}\n   232→  \"\"\"\n   233→  @spec get_dns_zones() :: map()\n   234→  def get_dns_zones do\n   235→    dns_config = get_service(:dns)\n   236→    Map.get(dns_config, :zones, %{})\n   237→  end\n   238→\n   239→  @doc \"\"\"\n   240→  Gets a specific DNS zone configuration.\n   241→\n   242→  ## Examples\n   243→\n   244→      iex> YellowDog.Config.get_dns_zone(\"example.com\")\n   245→      {:ok, %{type: \"authoritative\", file: \"zones/example.com.zone\"}}\n   246→\n   247→      iex> YellowDog.Config.get_dns_zone(\"nonexistent.com\")\n   248→      {:error, :not_found}\n   249→  \"\"\"\n   250→  @spec get_dns_zone(zone_name()) :: {:ok, map()} | {:error, :not_found}\n   251→  def get_dns_zone(zone_name) do\n   252→    zones = get_dns_zones()\n   253→\n   254→    case Map.get(zones, zone_name) do\n   255→      nil -> {:error, :not_found}\n   256→      zone_config -> {:ok, zone_config}\n   257→    end\n   258→  end\n   259→\n   260→  @doc \"\"\"\n   261→  Lists all configured DNS zone names.\n   262→\n   263→  ## Examples\n   264→\n   265→      iex> YellowDog.Config.list_dns_zones()\n   266→      [\"example.com\", \"test.local\"]\n   267→  \"\"\"\n   268→  @spec list_dns_zones() :: [zone_name()]\n   269→  def list_dns_zones do\n   270→    zones = get_dns_zones()\n   271→    Map.keys(zones)\n   272→  end\n   273→\n   274→  @doc \"\"\"\n   275→  Checks if a zone is configured and enabled.\n   276→\n   277→  ## Examples\n   278→\n   279→      iex> YellowDog.Config.dns_zone_enabled?(\"example.com\")\n   280→      true\n   281→\n   282→      iex> YellowDog.Config.dns_zone_enabled?(\"nonexistent.com\")\n   283→      false\n   284→  \"\"\"\n   285→  @spec dns_zone_enabled?(zone_name()) :: boolean()\n   286→  def dns_zone_enabled?(zone_name) do\n   287→    case get_dns_zone(zone_name) do\n   288→      {:ok, _zone_config} -> true\n   289→      {:error, :not_found} -> false\n   290→    end\n   291→  end\n   292→\n   293→  @doc \"\"\"\n   294→  Gets the type of a DNS zone.\n   295→\n   296→  ## Examples\n   297→\n   298→      iex> YellowDog.Config.get_dns_zone_type(\"example.com\")\n   299→      {:ok, :authoritative}\n   300→\n   301→      iex> YellowDog.Config.get_dns_zone_type(\"nonexistent.com\")\n   302→      {:error, :not_found}\n   303→  \"\"\"\n   304→  @spec get_dns_zone_type(zone_name()) :: {:ok, zone_type()} | {:error, :not_found}\n   305→  def get_dns_zone_type(zone_name) do\n   306→    case get_dns_zone(zone_name) do\n   307→      {:ok, zone_config} ->\n   308→        type_str = Map.get(zone_config, \"type\", \"authoritative\")\n   309→\n   310→        type =\n   311→          case type_str do\n   312→            \"authoritative\" -> :authoritative\n   313→            \"stub\" -> :stub\n   314→            \"forward\" -> :forward\n   315→            \"cache\" -> :cache\n   316→            _ -> :authoritative\n   317→          end\n   318→\n   319→        {:ok, type}\n   320→\n   321→      {:error, :not_found} = error ->\n   322→        error\n   323→    end\n   324→  end\n   325→\n   326→  @doc \"\"\"\n   327→  Gets the zone file path for a DNS zone.\n   328→\n   329→  ## Examples\n   330→\n   331→      iex> YellowDog.Config.get_dns_zone_file(\"example.com\")\n   332→      {:ok, \"zones/example.com.zone\"}\n   333→\n   334→      iex> YellowDog.Config.get_dns_zone_file(\"nonexistent.com\")\n   335→      {:error, :not_found}\n   336→  \"\"\"\n   337→  @spec get_dns_zone_file(zone_name()) :: {:ok, String.t()} | {:error, :not_found}\n   338→  def get_dns_zone_file(zone_name) do\n   339→    case get_dns_zone(zone_name) do\n   340→      {:ok, zone_config} ->\n   341→        case Map.get(zone_config, \"file\") do\n   342→          nil -> {:error, :not_found}\n   343→          file_path -> {:ok, file_path}\n   344→        end\n   345→\n   346→      {:error, :not_found} = error ->\n   347→        error\n   348→    end\n   349→  end\n   350→\n   351→  @doc \"\"\"\n   352→  Updates configuration for a specific service.\n   353→\n   354→  New config will be loaded on next service restart.\n   355→\n   356→  ## Examples\n   357→\n   358→      iex> new_config = %{port: 5353, listen: \"127.0.0.1\"}\n   359→      iex> YellowDog.Config.update(:dns, new_config)\n   360→      :ok\n   361→  \"\"\"\n   362→  @spec update(service_name(), map()) :: :ok\n   363→  def update(service, new_config) do\n   364→    Agent.update(__MODULE__, fn state ->\n   365→      put_in(state, [to_string(service)], new_config)\n   366→    end)\n   367→  end\n   368→\n   369→  @doc \"\"\"\n   370→  Compare-and-swap update with version checking.\n   371→\n   372→  Atomically updates configuration only if the version matches expected.\n   373→  Used for optimistic locking in web console.\n   374→\n   375→  ## Parameters\n   376→    - service: Service atom (:dns, :mdns, :dhcpv4, :dhcpv6)\n   377→    - new_config: New configuration map\n   378→    - expected_version: Expected current version number\n   379→\n   380→  ## Returns\n   381→    - `:ok` if version matches and update successful\n   382→    - `{:error, :version_mismatch}` if version doesn't match\n   383→\n   384→  ## Examples\n   385→\n   386→      iex> YellowDog.Config.compare_and_swap(:dns, %{port: 5353}, 1)\n   387→      :ok\n   388→\n   389→      iex> YellowDog.Config.compare_and_swap(:dns, %{port: 5353}, 99)\n   390→      {:error, :version_mismatch}\n   391→  \"\"\"\n   392→  @spec compare_and_swap(service_name(), map(), non_neg_integer()) ::\n   393→          :ok | {:error, :version_mismatch}\n   394→  def compare_and_swap(service, new_config, expected_version) do\n   395→    Agent.get_and_update(__MODULE__, fn state ->\n   396→      current_version = Map.get(state, :_version, 0)\n   397→\n   398→      if current_version == expected_version do\n   399→        new_state =\n   400→          state\n   401→          |> put_in([to_string(service)], new_config)\n   402→          |> Map.put(:_version, current_version + 1)\n   403→\n   404→        {:ok, new_state}\n   405→      else\n   406→        {{:error, :version_mismatch}, state}\n   407→      end\n   408→    end)\n   409→  end\n   410→\n   411→  @doc \"\"\"\n   412→  Gets the current configuration version.\n   413→\n   414→  Used for optimistic locking to track configuration changes.\n   415→\n   416→  ## Examples\n   417→\n   418→      iex> YellowDog.Config.get_version()\n   419→      0\n   420→  \"\"\"\n   421→  @spec get_version() :: non_neg_integer()\n   422→  def get_version do\n   423→    Agent.get(__MODULE__, fn state -> Map.get(state, :_version, 0) end)\n   424→  end\n   425→end\n   426→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8559038-3d53-47df-9b7a-d16bbb068c80","uuid":"ee441908-4392-40f1-8fa7-f6900f1f6a3e","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog/lib/yellow_dog/config.ex","content":"defmodule YellowDog.Config do\n  @moduledoc \"\"\"\n  Configuration management for YellowDog with TOML file support.\n\n  Provides API for service applications to query their configuration\n  and check if they are enabled.\n  \"\"\"\n\n  use Agent\n\n  @type config_map :: map()\n  @type service_name :: :dns | :mdns | :dhcpv4 | :dhcpv6\n  @type config_key :: atom()\n  @type config_value :: term()\n  @type zone_name :: String.t()\n  @type zone_type :: :authoritative | :stub | :forward | :cache\n\n  # Default configuration fallback (now defined in application)\n  @default_config %{}\n\n  @doc \"\"\"\n  Starts the configuration agent with the given config.\n  \"\"\"\n  def start_link(config) do\n    Agent.start_link(fn -> config end, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Gets all configuration as a map.\n  \"\"\"\n  @spec get_all() :: config_map()\n  def get_all do\n    Agent.get(__MODULE__, fn state -> state end)\n  end\n\n  @doc \"\"\"\n  Gets a configuration value by name.\n  \"\"\"\n  @spec get(config_key()) :: config_value()\n  def get(name) do\n    Agent.get(__MODULE__, fn state -> Map.get(state, name) end)\n  end\n\n  @doc \"\"\"\n  Checks if a service is enabled in the configuration.\n\n  ## Examples\n\n      iex> YellowDog.Config.service_enabled?(:dns)\n      true\n\n      iex> YellowDog.Config.service_enabled?(:mdns)\n      false\n  \"\"\"\n  @spec service_enabled?(service_name()) :: boolean()\n  def service_enabled?(service) do\n    case get(\"core\") do\n      %{\"core\" => core_config} ->\n        Map.get(core_config, to_string(service), true)\n\n      core_config when is_map(core_config) ->\n        Map.get(core_config, to_string(service), true)\n\n      _ ->\n        true\n    end\n  end\n\n  @doc \"\"\"\n  Enables or disables a service in the configuration.\n\n  ## Examples\n\n      iex> YellowDog.Config.set_service_enabled(:dns, true)\n      :ok\n\n      iex> YellowDog.Config.set_service_enabled(:mdns, false)\n      :ok\n  \"\"\"\n  @spec set_service_enabled(service_name(), boolean()) :: :ok\n  def set_service_enabled(service, enabled) do\n    Agent.update(__MODULE__, fn state ->\n      core_config = Map.get(state, \"core\", %{})\n      new_core = Map.put(core_config, to_string(service), enabled)\n      Map.put(state, \"core\", new_core)\n    end)\n  end\n\n  @doc \"\"\"\n  Gets a specific configuration value for a service.\n\n  ## Examples\n\n      iex> YellowDog.Config.get(:dns, :port)\n      53\n\n      iex> YellowDog.Config.get(:dhcpv4, :listen)\n      \"0.0.0.0\"\n  \"\"\"\n  @spec get(service_name(), config_key()) :: config_value()\n  def get(service, key) do\n    service_config = get_service(service)\n    Map.get(service_config, key, get_default_value(service, key))\n  end\n\n  @doc \"\"\"\n  Gets the entire configuration for a service.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_service(:dns)\n      %{listen: \"0.0.0.0\", port: 53}\n  \"\"\"\n  @spec get_service(service_name()) :: map()\n  def get_service(service) do\n    case get(to_string(service)) do\n      service_config when is_map(service_config) ->\n        # Convert string keys to atoms for easier access\n        # If keys are already atoms (from transformer), keep them as-is\n        for {key, val} <- service_config, into: %{} do\n          atom_key = if is_binary(key), do: String.to_atom(key), else: key\n          {atom_key, val}\n        end\n\n      _ ->\n        get_default_service_config(service)\n    end\n  end\n\n  @doc \"\"\"\n  Loads configuration from a TOML file path.\n\n  ## Examples\n\n      iex> YellowDog.Config.load(\"/path/to/config.toml\")\n      {:ok, %{...}}\n\n      iex> YellowDog.Config.load(\"/nonexistent.toml\")\n      {:error, :enoent}\n  \"\"\"\n  @spec load(String.t()) :: {:ok, config_map()} | {:error, term()}\n  def load(path) do\n    case File.read(path) do\n      {:ok, content} ->\n        case Toml.decode(content) do\n          {:ok, config} ->\n            :telemetry.execute(\n              [:yellow_dog, :config, :loaded],\n              %{count: 1},\n              %{source: __MODULE__, path: path, severity: :info}\n            )\n\n            {:ok, config}\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :config, :error],\n              %{count: 1},\n              %{\n                source: __MODULE__,\n                path: path,\n                reason: :parse_error,\n                error: inspect(reason),\n                severity: :error\n              }\n            )\n\n            {:error, reason}\n        end\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :config, :error],\n          %{count: 1},\n          %{\n            source: __MODULE__,\n            path: path,\n            reason: :read_error,\n            error: inspect(reason),\n            severity: :error\n          }\n        )\n\n        {:error, reason}\n    end\n  end\n\n  @doc \"\"\"\n  Loads configuration with fallback to defaults.\n  \"\"\"\n  @spec load_with_fallback(String.t()) :: config_map()\n  def load_with_fallback(path) do\n    case load(path) do\n      {:ok, config} ->\n        config\n\n      {:error, _reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :config, :loaded],\n          %{count: 1},\n          %{source: __MODULE__, fallback: true, severity: :warning}\n        )\n\n        @default_config\n    end\n  end\n\n  # Private helper functions\n\n  defp get_default_service_config(service) do\n    case Map.get(@default_config, to_string(service)) do\n      nil ->\n        %{}\n\n      config ->\n        for {key, val} <- config, into: %{}, do: {String.to_atom(key), val}\n    end\n  end\n\n  defp get_default_value(service, key) do\n    service_config = get_default_service_config(service)\n    Map.get(service_config, key)\n  end\n\n  @doc \"\"\"\n  Gets all DNS zones from configuration.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_dns_zones()\n      %{\"example.com\" => %{type: \"authoritative\", file: \"zones/example.com.zone\"}}\n  \"\"\"\n  @spec get_dns_zones() :: map()\n  def get_dns_zones do\n    dns_config = get_service(:dns)\n    Map.get(dns_config, :zones, %{})\n  end\n\n  @doc \"\"\"\n  Gets a specific DNS zone configuration.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_dns_zone(\"example.com\")\n      {:ok, %{type: \"authoritative\", file: \"zones/example.com.zone\"}}\n\n      iex> YellowDog.Config.get_dns_zone(\"nonexistent.com\")\n      {:error, :not_found}\n  \"\"\"\n  @spec get_dns_zone(zone_name()) :: {:ok, map()} | {:error, :not_found}\n  def get_dns_zone(zone_name) do\n    zones = get_dns_zones()\n\n    case Map.get(zones, zone_name) do\n      nil -> {:error, :not_found}\n      zone_config -> {:ok, zone_config}\n    end\n  end\n\n  @doc \"\"\"\n  Lists all configured DNS zone names.\n\n  ## Examples\n\n      iex> YellowDog.Config.list_dns_zones()\n      [\"example.com\", \"test.local\"]\n  \"\"\"\n  @spec list_dns_zones() :: [zone_name()]\n  def list_dns_zones do\n    zones = get_dns_zones()\n    Map.keys(zones)\n  end\n\n  @doc \"\"\"\n  Checks if a zone is configured and enabled.\n\n  ## Examples\n\n      iex> YellowDog.Config.dns_zone_enabled?(\"example.com\")\n      true\n\n      iex> YellowDog.Config.dns_zone_enabled?(\"nonexistent.com\")\n      false\n  \"\"\"\n  @spec dns_zone_enabled?(zone_name()) :: boolean()\n  def dns_zone_enabled?(zone_name) do\n    case get_dns_zone(zone_name) do\n      {:ok, _zone_config} -> true\n      {:error, :not_found} -> false\n    end\n  end\n\n  @doc \"\"\"\n  Gets the type of a DNS zone.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_dns_zone_type(\"example.com\")\n      {:ok, :authoritative}\n\n      iex> YellowDog.Config.get_dns_zone_type(\"nonexistent.com\")\n      {:error, :not_found}\n  \"\"\"\n  @spec get_dns_zone_type(zone_name()) :: {:ok, zone_type()} | {:error, :not_found}\n  def get_dns_zone_type(zone_name) do\n    case get_dns_zone(zone_name) do\n      {:ok, zone_config} ->\n        type_str = Map.get(zone_config, \"type\", \"authoritative\")\n\n        type =\n          case type_str do\n            \"authoritative\" -> :authoritative\n            \"stub\" -> :stub\n            \"forward\" -> :forward\n            \"cache\" -> :cache\n            _ -> :authoritative\n          end\n\n        {:ok, type}\n\n      {:error, :not_found} = error ->\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Gets the zone file path for a DNS zone.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_dns_zone_file(\"example.com\")\n      {:ok, \"zones/example.com.zone\"}\n\n      iex> YellowDog.Config.get_dns_zone_file(\"nonexistent.com\")\n      {:error, :not_found}\n  \"\"\"\n  @spec get_dns_zone_file(zone_name()) :: {:ok, String.t()} | {:error, :not_found}\n  def get_dns_zone_file(zone_name) do\n    case get_dns_zone(zone_name) do\n      {:ok, zone_config} ->\n        case Map.get(zone_config, \"file\") do\n          nil -> {:error, :not_found}\n          file_path -> {:ok, file_path}\n        end\n\n      {:error, :not_found} = error ->\n        error\n    end\n  end\n\n  @doc \"\"\"\n  Updates configuration for a specific service.\n\n  New config will be loaded on next service restart.\n\n  ## Examples\n\n      iex> new_config = %{port: 5353, listen: \"127.0.0.1\"}\n      iex> YellowDog.Config.update(:dns, new_config)\n      :ok\n  \"\"\"\n  @spec update(service_name(), map()) :: :ok\n  def update(service, new_config) do\n    Agent.update(__MODULE__, fn state ->\n      put_in(state, [to_string(service)], new_config)\n    end)\n  end\n\n  @doc \"\"\"\n  Compare-and-swap update with version checking.\n\n  Atomically updates configuration only if the version matches expected.\n  Used for optimistic locking in web console.\n\n  ## Parameters\n    - service: Service atom (:dns, :mdns, :dhcpv4, :dhcpv6)\n    - new_config: New configuration map\n    - expected_version: Expected current version number\n\n  ## Returns\n    - `:ok` if version matches and update successful\n    - `{:error, :version_mismatch}` if version doesn't match\n\n  ## Examples\n\n      iex> YellowDog.Config.compare_and_swap(:dns, %{port: 5353}, 1)\n      :ok\n\n      iex> YellowDog.Config.compare_and_swap(:dns, %{port: 5353}, 99)\n      {:error, :version_mismatch}\n  \"\"\"\n  @spec compare_and_swap(service_name(), map(), non_neg_integer()) ::\n          :ok | {:error, :version_mismatch}\n  def compare_and_swap(service, new_config, expected_version) do\n    Agent.get_and_update(__MODULE__, fn state ->\n      current_version = Map.get(state, :_version, 0)\n\n      if current_version == expected_version do\n        new_state =\n          state\n          |> put_in([to_string(service)], new_config)\n          |> Map.put(:_version, current_version + 1)\n\n        {:ok, new_state}\n      else\n        {{:error, :version_mismatch}, state}\n      end\n    end)\n  end\n\n  @doc \"\"\"\n  Gets the current configuration version.\n\n  Used for optimistic locking to track configuration changes.\n\n  ## Examples\n\n      iex> YellowDog.Config.get_version()\n      0\n  \"\"\"\n  @spec get_version() :: non_neg_integer()\n  def get_version do\n    Agent.get(__MODULE__, fn state -> Map.get(state, :_version, 0) end)\n  end\nend\n","numLines":426,"startLine":1,"totalLines":426}}}
