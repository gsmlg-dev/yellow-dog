 end"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1164,"cache_read_input_tokens":148734,"cache_creation":{"ephemeral_5m_input_tokens":1164,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0d3ee750-7f11-4e1e-a617-3b37d644afe9","uuid":"791739bd-8e86-41a9-bcd6-c226d9b34ffa"}
