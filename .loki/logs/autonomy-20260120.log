{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0168nFUP8rAW3ehy3WeDctWp","type":"tool_result","content":"     1→defmodule YellowDog.Dns.ServerTest do\n     2→  use ExUnit.Case, async: false\n     3→\n     4→  alias YellowDog.Dns.Server\n     5→\n     6→  describe \"Server configuration\" do\n     7→    test \"get_config/0 returns valid default configuration\" do\n     8→      config = Server.get_config()\n     9→\n    10→      assert is_map(config)\n    11→      assert config.port == 53\n    12→      assert config.listen == {0, 0, 0, 0}\n    13→\n    14→      # Check UDP config\n    15→      udp = config.udp\n    16→      assert udp.transport_module == Abyss.Transport.UDP.Unicast\n    17→      assert udp.handler_module == YellowDog.Dns.Handler.UDP\n    18→      assert is_list(udp.transport_options)\n    19→      assert is_integer(udp.read_timeout)\n    20→      assert is_integer(udp.shutdown_timeout)\n    21→      assert is_integer(udp.num_listeners)\n    22→      assert is_integer(udp.num_connections)\n    23→      assert is_integer(udp.max_packet_size)\n    24→\n    25→      # Check TCP config\n    26→      tcp = config.tcp\n    27→      assert tcp.transport_module == ThousandIsland.Transports.TCP\n    28→      assert tcp.handler_module == YellowDog.Dns.Handler.TCP\n    29→      assert is_list(tcp.transport_options)\n    30→      assert is_integer(tcp.read_timeout)\n    31→      assert is_integer(tcp.shutdown_timeout)\n    32→      assert is_integer(tcp.num_acceptors)\n    33→      assert is_integer(tcp.num_connections)\n    34→    end\n    35→\n    36→    test \"default port is 53 (standard DNS port)\" do\n    37→      config = Server.get_config()\n    38→\n    39→      assert config.port == 53\n    40→    end\n    41→\n    42→    test \"UDP uses unicast transport by default\" do\n    43→      config = Server.get_config()\n    44→\n    45→      assert config.udp.transport_module == Abyss.Transport.UDP.Unicast\n    46→    end\n    47→\n    48→    test \"UDP handler module is set correctly\" do\n    49→      config = Server.get_config()\n    50→\n    51→      assert config.udp.handler_module == YellowDog.Dns.Handler.UDP\n    52→    end\n    53→\n    54→    test \"TCP handler module is set correctly\" do\n    55→      config = Server.get_config()\n    56→\n    57→      assert config.tcp.handler_module == YellowDog.Dns.Handler.TCP\n    58→    end\n    59→\n    60→    test \"max packet size is DNS UDP limit (512 bytes)\" do\n    61→      config = Server.get_config()\n    62→\n    63→      assert config.udp.max_packet_size == 512\n    64→    end\n    65→\n    66→    test \"UDP transport options include IP and reuseaddr\" do\n    67→      config = Server.get_config()\n    68→\n    69→      transport_opts = config.udp.transport_options\n    70→\n    71→      assert is_list(transport_opts)\n    72→      assert Keyword.has_key?(transport_opts, :ip)\n    73→      assert Keyword.has_key?(transport_opts, :reuseaddr)\n    74→      assert transport_opts[:reuseaddr] == true\n    75→    end\n    76→\n    77→    test \"TCP transport options include IP, reuseaddr and nodelay\" do\n    78→      config = Server.get_config()\n    79→\n    80→      transport_opts = config.tcp.transport_options\n    81→\n    82→      assert is_list(transport_opts)\n    83→      assert Keyword.has_key?(transport_opts, :ip)\n    84→      assert Keyword.has_key?(transport_opts, :reuseaddr)\n    85→      assert Keyword.has_key?(transport_opts, :nodelay)\n    86→      assert transport_opts[:reuseaddr] == true\n    87→      assert transport_opts[:nodelay] == true\n    88→    end\n    89→\n    90→    test \"default listen address is 0.0.0.0 (all interfaces)\" do\n    91→      config = Server.get_config()\n    92→\n    93→      assert config.listen == {0, 0, 0, 0}\n    94→    end\n    95→  end\n    96→\n    97→  describe \"Server lifecycle\" do\n    98→    test \"server module exports required functions\" do\n    99→      # start_link has default argument, so arity is 0\n   100→      assert function_exported?(Server, :start_link, 0) or\n   101→               function_exported?(Server, :start_link, 1)\n   102→\n   103→      assert function_exported?(Server, :stop, 1)\n   104→      assert function_exported?(Server, :get_config, 0)\n   105→    end\n   106→\n   107→    test \"stop/1 accepts server name or PID\" do\n   108→      # Just verify the function exists and accepts 1 argument\n   109→      assert function_exported?(Server, :stop, 1)\n   110→    end\n   111→  end\n   112→\n   113→  describe \"Configuration customization\" do\n   114→    test \"configuration can be built with custom port\" do\n   115→      # This tests that the server would accept custom configuration\n   116→      # DNS standard port is 53\n   117→      custom_opts = [port: 53]\n   118→\n   119→      # Verify that passing options would work (can't test actual server start)\n   120→      assert is_list(custom_opts)\n   121→      assert Keyword.has_key?(custom_opts, :port)\n   122→    end\n   123→\n   124→    test \"configuration can specify custom listen address\" do\n   125→      custom_opts = [listen: \"127.0.0.1\"]\n   126→\n   127→      assert is_list(custom_opts)\n   128→      assert Keyword.has_key?(custom_opts, :listen)\n   129→    end\n   130→  end\n   131→\n   132→  describe \"Supervisor behaviour\" do\n   133→    setup do\n   134→      Code.ensure_loaded!(Server)\n   135→      :ok\n   136→    end\n   137→\n   138→    test \"server is a Supervisor\" do\n   139→      # Verify the module uses Supervisor\n   140→      assert Kernel.function_exported?(Server, :init, 1)\n   141→      # Supervisor.init/1 returns {:ok, supervisor_spec}\n   142→    end\n   143→\n   144→    test \"server exports get_port/0 and get_port/1 functions\" do\n   145→      assert Kernel.function_exported?(Server, :get_port, 0)\n   146→      assert Kernel.function_exported?(Server, :get_port, 1)\n   147→    end\n   148→  end\n   149→\n   150→  describe \"Abyss and ThousandIsland integration\" do\n   151→    setup do\n   152→      Code.ensure_loaded!(Server)\n   153→      :ok\n   154→    end\n   155→\n   156→    test \"server is a Supervisor for Abyss and ThousandIsland\" do\n   157→      # The server wraps both, so init should be defined\n   158→      assert Kernel.function_exported?(Server, :init, 1)\n   159→    end\n   160→\n   161→    test \"configuration includes all required Abyss UDP options\" do\n   162→      config = Server.get_config()\n   163→\n   164→      # Shared options\n   165→      assert Map.has_key?(config, :port)\n   166→      assert Map.has_key?(config, :listen)\n   167→\n   168→      # Abyss UDP requires these options\n   169→      udp = config.udp\n   170→      assert Map.has_key?(udp, :handler_module)\n   171→      assert Map.has_key?(udp, :transport_options)\n   172→      assert Map.has_key?(udp, :num_listeners)\n   173→      assert Map.has_key?(udp, :num_connections)\n   174→    end\n   175→\n   176→    test \"configuration includes all required ThousandIsland TCP options\" do\n   177→      config = Server.get_config()\n   178→\n   179→      # ThousandIsland TCP requires these options\n   180→      tcp = config.tcp\n   181→      assert Map.has_key?(tcp, :handler_module)\n   182→      assert Map.has_key?(tcp, :transport_options)\n   183→      assert Map.has_key?(tcp, :num_acceptors)\n   184→      assert Map.has_key?(tcp, :num_connections)\n   185→    end\n   186→  end\n   187→\n   188→  describe \"DNS-specific configuration\" do\n   189→    test \"UDP timeouts are set appropriately for DNS\" do\n   190→      config = Server.get_config()\n   191→\n   192→      # UDP DNS queries should be fast\n   193→      # 5 seconds\n   194→      assert config.udp.read_timeout == 5_000\n   195→      # 5 seconds\n   196→      assert config.udp.shutdown_timeout == 5_000\n   197→    end\n   198→\n   199→    test \"TCP timeouts allow for connection reuse (RFC 7766)\" do\n   200→      config = Server.get_config()\n   201→\n   202→      # TCP DNS connections can be reused, longer timeouts\n   203→      # 2 minutes\n   204→      assert config.tcp.read_timeout == 120_000\n   205→      # 15 seconds\n   206→      assert config.tcp.shutdown_timeout == 15_000\n   207→    end\n   208→\n   209→    test \"UDP listener pool size is appropriate for DNS traffic\" do\n   210→      config = Server.get_config()\n   211→\n   212→      # DNS needs fewer listeners than DHCP since queries are faster\n   213→      assert config.udp.num_listeners == 50\n   214→    end\n   215→\n   216→    test \"UDP connection pool is large for concurrent queries\" do\n   217→      config = Server.get_config()\n   218→\n   219→      # DNS can handle many concurrent queries\n   220→      assert config.udp.num_connections == 10_000\n   221→    end\n   222→\n   223→    test \"TCP acceptor pool is sized for connection handling\" do\n   224→      config = Server.get_config()\n   225→\n   226→      assert config.tcp.num_acceptors == 100\n   227→      assert config.tcp.num_connections == 16_384\n   228→    end\n   229→  end\n   230→end\n   231→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b20a2ce5-4d1a-4dfb-8234-d009f9779d17","uuid":"0fecde76-04df-40de-86fa-404f280252fa","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/test/yellow_dog/dns/server_test.exs","content":"defmodule YellowDog.Dns.ServerTest do\n  use ExUnit.Case, async: false\n\n  alias YellowDog.Dns.Server\n\n  describe \"Server configuration\" do\n    test \"get_config/0 returns valid default configuration\" do\n      config = Server.get_config()\n\n      assert is_map(config)\n      assert config.port == 53\n      assert config.listen == {0, 0, 0, 0}\n\n      # Check UDP config\n      udp = config.udp\n      assert udp.transport_module == Abyss.Transport.UDP.Unicast\n      assert udp.handler_module == YellowDog.Dns.Handler.UDP\n      assert is_list(udp.transport_options)\n      assert is_integer(udp.read_timeout)\n      assert is_integer(udp.shutdown_timeout)\n      assert is_integer(udp.num_listeners)\n      assert is_integer(udp.num_connections)\n      assert is_integer(udp.max_packet_size)\n\n      # Check TCP config\n      tcp = config.tcp\n      assert tcp.transport_module == ThousandIsland.Transports.TCP\n      assert tcp.handler_module == YellowDog.Dns.Handler.TCP\n      assert is_list(tcp.transport_options)\n      assert is_integer(tcp.read_timeout)\n      assert is_integer(tcp.shutdown_timeout)\n      assert is_integer(tcp.num_acceptors)\n      assert is_integer(tcp.num_connections)\n    end\n\n    test \"default port is 53 (standard DNS port)\" do\n      config = Server.get_config()\n\n      assert config.port == 53\n    end\n\n    test \"UDP uses unicast transport by default\" do\n      config = Server.get_config()\n\n      assert config.udp.transport_module == Abyss.Transport.UDP.Unicast\n    end\n\n    test \"UDP handler module is set correctly\" do\n      config = Server.get_config()\n\n      assert config.udp.handler_module == YellowDog.Dns.Handler.UDP\n    end\n\n    test \"TCP handler module is set correctly\" do\n      config = Server.get_config()\n\n      assert config.tcp.handler_module == YellowDog.Dns.Handler.TCP\n    end\n\n    test \"max packet size is DNS UDP limit (512 bytes)\" do\n      config = Server.get_config()\n\n      assert config.udp.max_packet_size == 512\n    end\n\n    test \"UDP transport options include IP and reuseaddr\" do\n      config = Server.get_config()\n\n      transport_opts = config.udp.transport_options\n\n      assert is_list(transport_opts)\n      assert Keyword.has_key?(transport_opts, :ip)\n      assert Keyword.has_key?(transport_opts, :reuseaddr)\n      assert transport_opts[:reuseaddr] == true\n    end\n\n    test \"TCP transport options include IP, reuseaddr and nodelay\" do\n      config = Server.get_config()\n\n      transport_opts = config.tcp.transport_options\n\n      assert is_list(transport_opts)\n      assert Keyword.has_key?(transport_opts, :ip)\n      assert Keyword.has_key?(transport_opts, :reuseaddr)\n      assert Keyword.has_key?(transport_opts, :nodelay)\n      assert transport_opts[:reuseaddr] == true\n      assert transport_opts[:nodelay] == true\n    end\n\n    test \"default listen address is 0.0.0.0 (all interfaces)\" do\n      config = Server.get_config()\n\n      assert config.listen == {0, 0, 0, 0}\n    end\n  end\n\n  describe \"Server lifecycle\" do\n    test \"server module exports required functions\" do\n      # start_link has default argument, so arity is 0\n      assert function_exported?(Server, :start_link, 0) or\n               function_exported?(Server, :start_link, 1)\n\n      assert function_exported?(Server, :stop, 1)\n      assert function_exported?(Server, :get_config, 0)\n    end\n\n    test \"stop/1 accepts server name or PID\" do\n      # Just verify the function exists and accepts 1 argument\n      assert function_exported?(Server, :stop, 1)\n    end\n  end\n\n  describe \"Configuration customization\" do\n    test \"configuration can be built with custom port\" do\n      # This tests that the server would accept custom configuration\n      # DNS standard port is 53\n      custom_opts = [port: 53]\n\n      # Verify that passing options would work (can't test actual server start)\n      assert is_list(custom_opts)\n      assert Keyword.has_key?(custom_opts, :port)\n    end\n\n    test \"configuration can specify custom listen address\" do\n      custom_opts = [listen: \"127.0.0.1\"]\n\n      assert is_list(custom_opts)\n      assert Keyword.has_key?(custom_opts, :listen)\n    end\n  end\n\n  describe \"Supervisor behaviour\" do\n    setup do\n      Code.ensure_loaded!(Server)\n      :ok\n    end\n\n    test \"server is a Supervisor\" do\n      # Verify the module uses Supervisor\n      assert Kernel.function_exported?(Server, :init, 1)\n      # Supervisor.init/1 returns {:ok, supervisor_spec}\n    end\n\n    test \"server exports get_port/0 and get_port/1 functions\" do\n      assert Kernel.function_exported?(Server, :get_port, 0)\n      assert Kernel.function_exported?(Server, :get_port, 1)\n    end\n  end\n\n  describe \"Abyss and ThousandIsland integration\" do\n    setup do\n      Code.ensure_loaded!(Server)\n      :ok\n    end\n\n    test \"server is a Supervisor for Abyss and ThousandIsland\" do\n      # The server wraps both, so init should be defined\n      assert Kernel.function_exported?(Server, :init, 1)\n    end\n\n    test \"configuration includes all required Abyss UDP options\" do\n      config = Server.get_config()\n\n      # Shared options\n      assert Map.has_key?(config, :port)\n      assert Map.has_key?(config, :listen)\n\n      # Abyss UDP requires these options\n      udp = config.udp\n      assert Map.has_key?(udp, :handler_module)\n      assert Map.has_key?(udp, :transport_options)\n      assert Map.has_key?(udp, :num_listeners)\n      assert Map.has_key?(udp, :num_connections)\n    end\n\n    test \"configuration includes all required ThousandIsland TCP options\" do\n      config = Server.get_config()\n\n      # ThousandIsland TCP requires these options\n      tcp = config.tcp\n      assert Map.has_key?(tcp, :handler_module)\n      assert Map.has_key?(tcp, :transport_options)\n      assert Map.has_key?(tcp, :num_acceptors)\n      assert Map.has_key?(tcp, :num_connections)\n    end\n  end\n\n  describe \"DNS-specific configuration\" do\n    test \"UDP timeouts are set appropriately for DNS\" do\n      config = Server.get_config()\n\n      # UDP DNS queries should be fast\n      # 5 seconds\n      assert config.udp.read_timeout == 5_000\n      # 5 seconds\n      assert config.udp.shutdown_timeout == 5_000\n    end\n\n    test \"TCP timeouts allow for connection reuse (RFC 7766)\" do\n      config = Server.get_config()\n\n      # TCP DNS connections can be reused, longer timeouts\n      # 2 minutes\n      assert config.tcp.read_timeout == 120_000\n      # 15 seconds\n      assert config.tcp.shutdown_timeout == 15_000\n    end\n\n    test \"UDP listener pool size is appropriate for DNS traffic\" do\n      config = Server.get_config()\n\n      # DNS needs fewer listeners than DHCP since queries are faster\n      assert config.udp.num_listeners == 50\n    end\n\n    test \"UDP connection pool is large for concurrent queries\" do\n      config = Server.get_config()\n\n      # DNS can handle many concurrent queries\n      assert config.udp.num_connections == 10_000\n    end\n\n    test \"TCP acceptor pool is sized for connection handling\" do\n      config = Server.get_config()\n\n      assert config.tcp.num_acceptors == 100\n      assert config.tcp.num_connections == 16_384\n    end\n  end\nend\n","numLines":231,"startLine":1,"totalLines":231}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XF6sHJSvRMPo4vongkkd8F","type":"tool_result","content":"     1→defmodule YellowDog.Dns.Server do\n     2→  @moduledoc \"\"\"\n     3→  Network I/O server supervisor for DNS.\n     4→\n     5→  Supervises the network servers:\n     6→  - `Abyss` - UDP server for DNS queries\n     7→  - `ThousandIsland` - TCP server for DNS queries\n     8→\n     9→  This supervisor is a child of `YellowDog.Dns.Supervisor` and handles only\n    10→  network I/O. All DNS resolution logic is handled by ConnectionProcess,\n    11→  ViewManager, View, and Zone processes.\n    12→\n    13→  ## Handler Registration\n    14→\n    15→  - UDP: `YellowDog.Dns.Handler.UDP` is registered with Abyss\n    16→  - TCP: `YellowDog.Dns.Handler.TCP` is registered with ThousandIsland\n    17→\n    18→  On each incoming packet/connection, handlers:\n    19→  1. Call ConnectionManager to start a connection process\n    20→  2. Forward queries to the connection process\n    21→  3. Send responses back to the client\n    22→  \"\"\"\n    23→\n    24→  use Supervisor\n    25→\n    26→  alias YellowDog.Telemetry\n    27→\n    28→  @doc \"\"\"\n    29→  Starts the network server supervisor.\n    30→\n    31→  ## Options\n    32→  - `port`: UDP/TCP port to listen on (default: 53)\n    33→  - `listen`: IP address tuple to bind to\n    34→  - `tcp_enabled`: Whether to enable TCP server (default: true, can be configured via TOML)\n    35→\n    36→  ## Returns\n    37→  - `{:ok, pid}` - Server started successfully\n    38→  - `{:error, reason}` - Failed to start server\n    39→  \"\"\"\n    40→  @spec start_link(keyword()) :: Supervisor.on_start()\n    41→  def start_link(opts \\\\ []) do\n    42→    Supervisor.start_link(__MODULE__, opts, name: __MODULE__)\n    43→  end\n    44→\n    45→  @doc \"\"\"\n    46→  Stops the server.\n    47→  \"\"\"\n    48→  @spec stop(pid() | atom()) :: :ok\n    49→  def stop(pid \\\\ __MODULE__) do\n    50→    Supervisor.stop(pid)\n    51→  end\n    52→\n    53→  @doc \"\"\"\n    54→  Gets the default server configuration.\n    55→  \"\"\"\n    56→  @spec get_config() :: map()\n    57→  def get_config do\n    58→    %{\n    59→      # Shared settings\n    60→      port: 53,\n    61→      listen: {0, 0, 0, 0},\n    62→\n    63→      # TCP enabled flag (can be disabled via config)\n    64→      tcp_enabled: true,\n    65→\n    66→      # UDP settings (Abyss)\n    67→      udp: %{\n    68→        transport_module: Abyss.Transport.UDP.Unicast,\n    69→        handler_module: YellowDog.Dns.Handler.UDP,\n    70→        transport_options: [\n    71→          ip: {0, 0, 0, 0},\n    72→          reuseaddr: true\n    73→        ],\n    74→        read_timeout: 5_000,\n    75→        shutdown_timeout: 5_000,\n    76→        num_listeners: 50,\n    77→        num_connections: 10_000,\n    78→        max_packet_size: 512\n    79→      },\n    80→\n    81→      # TCP settings (ThousandIsland)\n    82→      tcp: %{\n    83→        handler_module: YellowDog.Dns.Handler.TCP,\n    84→        transport_module: ThousandIsland.Transports.TCP,\n    85→        transport_options: [\n    86→          ip: {0, 0, 0, 0},\n    87→          reuseaddr: true,\n    88→          nodelay: true\n    89→        ],\n    90→        num_acceptors: 100,\n    91→        num_connections: 16_384,\n    92→        read_timeout: 120_000,\n    93→        shutdown_timeout: 15_000\n    94→      }\n    95→    }\n    96→  end\n    97→\n    98→  @doc \"\"\"\n    99→  Returns server status.\n   100→  \"\"\"\n   101→  @spec status() :: map()\n   102→  def status do\n   103→    tcp_enabled = get_tcp_enabled()\n   104→\n   105→    %{\n   106→      running: Process.whereis(__MODULE__) != nil,\n   107→      udp: %{running: find_abyss_pid(__MODULE__) != nil},\n   108→      tcp: %{\n   109→        enabled: tcp_enabled,\n   110→        running: tcp_enabled and find_thousand_island_pid(__MODULE__) != nil\n   111→      }\n   112→    }\n   113→  end\n   114→\n   115→  @doc \"\"\"\n   116→  Returns whether TCP is enabled.\n   117→  \"\"\"\n   118→  @spec tcp_enabled?() :: boolean()\n   119→  def tcp_enabled? do\n   120→    get_tcp_enabled()\n   121→  end\n   122→\n   123→  @doc \"\"\"\n   124→  Returns the UDP port the server is listening on.\n   125→\n   126→  Useful for tests when starting with port 0 (auto-select).\n   127→  \"\"\"\n   128→  @spec get_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   129→  def get_port, do: get_udp_port(__MODULE__)\n   130→\n   131→  @spec get_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   132→  def get_port(pid), do: get_udp_port(pid)\n   133→\n   134→  @doc \"\"\"\n   135→  Returns the UDP port the server is listening on.\n   136→  \"\"\"\n   137→  @spec get_udp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   138→  def get_udp_port, do: get_udp_port(__MODULE__)\n   139→\n   140→  @spec get_udp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   141→  def get_udp_port(supervisor) do\n   142→    case find_abyss_pid(supervisor) do\n   143→      nil ->\n   144→        {:error, :abyss_not_found}\n   145→\n   146→      abyss_pid ->\n   147→        case Abyss.Server.listener_pool_pid(abyss_pid) do\n   148→          nil ->\n   149→            {:error, :no_listener_pool}\n   150→\n   151→          pool_pid ->\n   152→            case Abyss.ListenerPool.listener_pids(pool_pid) do\n   153→              [] ->\n   154→                {:error, :no_listeners}\n   155→\n   156→              [listener_pid | _] ->\n   157→                case Abyss.Listener.listener_info(listener_pid) do\n   158→                  {_ip, port} when is_integer(port) -> {:ok, port}\n   159→                  _ -> {:error, :invalid_listener_info}\n   160→                end\n   161→            end\n   162→        end\n   163→    end\n   164→  end\n   165→\n   166→  @doc \"\"\"\n   167→  Returns the TCP port the server is listening on.\n   168→  \"\"\"\n   169→  @spec get_tcp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   170→  def get_tcp_port, do: get_tcp_port(__MODULE__)\n   171→\n   172→  @spec get_tcp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   173→  def get_tcp_port(supervisor) do\n   174→    case find_thousand_island_pid(supervisor) do\n   175→      nil ->\n   176→        {:error, :thousand_island_not_found}\n   177→\n   178→      ti_pid ->\n   179→        # ThousandIsland.listener_info returns {:ok, {ip, port}} or :error\n   180→        case ThousandIsland.listener_info(ti_pid) do\n   181→          {:ok, {_ip, port}} when is_integer(port) -> {:ok, port}\n   182→          {:ok, _other} -> {:error, :invalid_listener_info}\n   183→          :error -> {:error, :port_not_available}\n   184→        end\n   185→    end\n   186→  end\n   187→\n   188→  # Supervisor callbacks\n   189→\n   190→  @impl true\n   191→  def init(opts) do\n   192→    Telemetry.info(\"Starting DNS network server\")\n   193→\n   194→    # Build configurations\n   195→    abyss_config = build_abyss_config(opts)\n   196→\n   197→    port = Keyword.get(opts, :port, 53)\n   198→    listen = Keyword.get(opts, :listen, {0, 0, 0, 0})\n   199→    listen_ip = normalize_ip(listen)\n   200→\n   201→    # Check if TCP is enabled\n   202→    tcp_enabled = Keyword.get(opts, :tcp_enabled, get_tcp_enabled())\n   203→\n   204→    Telemetry.info(\"DNS server listening\", %{\n   205→      port: port,\n   206→      listen: format_ip(listen_ip),\n   207→      udp: true,\n   208→      tcp: tcp_enabled\n   209→    })\n   210→\n   211→    # Always start UDP server\n   212→    children = [\n   213→      %{\n   214→        id: :abyss,\n   215→        start: {Abyss, :start_link, [abyss_config]},\n   216→        restart: :permanent,\n   217→        type: :supervisor\n   218→      }\n   219→    ]\n   220→\n   221→    # Conditionally add TCP server\n   222→    children =\n   223→      if tcp_enabled do\n   224→        tcp_config = build_thousand_island_config(opts)\n   225→\n   226→        children ++\n   227→          [\n   228→            %{\n   229→              id: :thousand_island,\n   230→              start: {ThousandIsland, :start_link, [tcp_config]},\n   231→              restart: :permanent,\n   232→              type: :supervisor\n   233→            }\n   234→          ]\n   235→      else\n   236→        Telemetry.info(\"DNS TCP server disabled by configuration\")\n   237→        children\n   238→      end\n   239→\n   240→    Supervisor.init(children, strategy: :one_for_one)\n   241→  end\n   242→\n   243→  # Private helpers\n   244→\n   245→  defp get_tcp_enabled do\n   246→    # Check config for tcp_enabled setting, default to true\n   247→    case apply(YellowDog.Config, :get, [:dns, :tcp_enabled]) do\n   248→      nil -> true\n   249→      enabled when is_boolean(enabled) -> enabled\n   250→      \"true\" -> true\n   251→      \"false\" -> false\n   252→      _ -> true\n   253→    end\n   254→  rescue\n   255→    _ -> true\n   256→  end\n   257→\n   258→  defp find_abyss_pid(supervisor) do\n   259→    pid = resolve_pid(supervisor)\n   260→\n   261→    case pid do\n   262→      nil ->\n   263→        nil\n   264→\n   265→      _ ->\n   266→        children = Supervisor.which_children(pid)\n   267→\n   268→        Enum.find_value(children, fn\n   269→          {:abyss, child_pid, :supervisor, _} when is_pid(child_pid) -> child_pid\n   270→          _ -> nil\n   271→        end)\n   272→    end\n   273→  rescue\n   274→    _ -> nil\n   275→  end\n   276→\n   277→  defp find_thousand_island_pid(supervisor) do\n   278→    pid = resolve_pid(supervisor)\n   279→\n   280→    case pid do\n   281→      nil ->\n   282→        nil\n   283→\n   284→      _ ->\n   285→        children = Supervisor.which_children(pid)\n   286→\n   287→        Enum.find_value(children, fn\n   288→          {:thousand_island, child_pid, :supervisor, _} when is_pid(child_pid) -> ch