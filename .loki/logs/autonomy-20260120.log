{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T4DQcHzSBcGEQhyUtTC8wz","type":"tool_result","content":"     1→defmodule YellowDog.Dns.Server do\n     2→  @moduledoc \"\"\"\n     3→  Network I/O server supervisor for DNS.\n     4→\n     5→  Supervises the network servers:\n     6→  - `Abyss` - UDP server for DNS queries\n     7→  - `ThousandIsland` - TCP server for DNS queries\n     8→\n     9→  This supervisor is a child of `YellowDog.Dns.Supervisor` and handles only\n    10→  network I/O. All DNS resolution logic is handled by ConnectionProcess,\n    11→  ViewManager, View, and Zone processes.\n    12→\n    13→  ## Handler Registration\n    14→\n    15→  - UDP: `YellowDog.Dns.Handler.UDP` is registered with Abyss\n    16→  - TCP: `YellowDog.Dns.Handler.TCP` is registered with ThousandIsland\n    17→\n    18→  On each incoming packet/connection, handlers:\n    19→  1. Call ConnectionManager to start a connection process\n    20→  2. Forward queries to the connection process\n    21→  3. Send responses back to the client\n    22→  \"\"\"\n    23→\n    24→  use Supervisor\n    25→\n    26→  alias YellowDog.Telemetry\n    27→\n    28→  @doc \"\"\"\n    29→  Starts the network server supervisor.\n    30→\n    31→  ## Options\n    32→  - `port`: UDP/TCP port to listen on (default: 53)\n    33→  - `listen`: IP address tuple to bind to\n    34→  - `tcp_enabled`: Whether to enable TCP server (default: true, can be configured via TOML)\n    35→\n    36→  ## Returns\n    37→  - `{:ok, pid}` - Server started successfully\n    38→  - `{:error, reason}` - Failed to start server\n    39→  \"\"\"\n    40→  @spec start_link(keyword()) :: Supervisor.on_start()\n    41→  def start_link(opts \\\\ []) do\n    42→    Supervisor.start_link(__MODULE__, opts, name: __MODULE__)\n    43→  end\n    44→\n    45→  @doc \"\"\"\n    46→  Stops the server.\n    47→  \"\"\"\n    48→  @spec stop(pid() | atom()) :: :ok\n    49→  def stop(pid \\\\ __MODULE__) do\n    50→    Supervisor.stop(pid)\n    51→  end\n    52→\n    53→  @doc \"\"\"\n    54→  Gets the default server configuration.\n    55→  \"\"\"\n    56→  @spec get_config() :: map()\n    57→  def get_config do\n    58→    %{\n    59→      # Shared settings\n    60→      port: 53,\n    61→      listen: {0, 0, 0, 0},\n    62→\n    63→      # TCP enabled flag (can be disabled via config)\n    64→      tcp_enabled: true,\n    65→\n    66→      # UDP settings (Abyss)\n    67→      udp: %{\n    68→        transport_module: Abyss.Transport.UDP.Unicast,\n    69→        handler_module: YellowDog.Dns.Handler.UDP,\n    70→        transport_options: [\n    71→          ip: {0, 0, 0, 0},\n    72→          reuseaddr: true\n    73→        ],\n    74→        read_timeout: 5_000,\n    75→        shutdown_timeout: 5_000,\n    76→        num_listeners: 50,\n    77→        num_connections: 10_000,\n    78→        max_packet_size: 512\n    79→      },\n    80→\n    81→      # TCP settings (ThousandIsland)\n    82→      tcp: %{\n    83→        handler_module: YellowDog.Dns.Handler.TCP,\n    84→        transport_module: ThousandIsland.Transports.TCP,\n    85→        transport_options: [\n    86→          ip: {0, 0, 0, 0},\n    87→          reuseaddr: true,\n    88→          nodelay: true\n    89→        ],\n    90→        num_acceptors: 100,\n    91→        num_connections: 16_384,\n    92→        read_timeout: 120_000,\n    93→        shutdown_timeout: 15_000\n    94→      }\n    95→    }\n    96→  end\n    97→\n    98→  @doc \"\"\"\n    99→  Returns server status.\n   100→  \"\"\"\n   101→  @spec status() :: map()\n   102→  def status do\n   103→    tcp_enabled = get_tcp_enabled()\n   104→\n   105→    %{\n   106→      running: Process.whereis(__MODULE__) != nil,\n   107→      udp: %{running: find_abyss_pid(__MODULE__) != nil},\n   108→      tcp: %{\n   109→        enabled: tcp_enabled,\n   110→        running: tcp_enabled and find_thousand_island_pid(__MODULE__) != nil\n   111→      }\n   112→    }\n   113→  end\n   114→\n   115→  @doc \"\"\"\n   116→  Returns whether TCP is enabled.\n   117→  \"\"\"\n   118→  @spec tcp_enabled?() :: boolean()\n   119→  def tcp_enabled? do\n   120→    get_tcp_enabled()\n   121→  end\n   122→\n   123→  @doc \"\"\"\n   124→  Returns the UDP port the server is listening on.\n   125→\n   126→  Useful for tests when starting with port 0 (auto-select).\n   127→  \"\"\"\n   128→  @spec get_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   129→  def get_port, do: get_udp_port(__MODULE__)\n   130→\n   131→  @spec get_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   132→  def get_port(pid), do: get_udp_port(pid)\n   133→\n   134→  @doc \"\"\"\n   135→  Returns the UDP port the server is listening on.\n   136→  \"\"\"\n   137→  @spec get_udp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   138→  def get_udp_port, do: get_udp_port(__MODULE__)\n   139→\n   140→  @spec get_udp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   141→  def get_udp_port(supervisor) do\n   142→    case find_abyss_pid(supervisor) do\n   143→      nil ->\n   144→        {:error, :abyss_not_found}\n   145→\n   146→      abyss_pid ->\n   147→        case Abyss.Server.listener_pool_pid(abyss_pid) do\n   148→          nil ->\n   149→            {:error, :no_listener_pool}\n   150→\n   151→          pool_pid ->\n   152→            case Abyss.ListenerPool.listener_pids(pool_pid) do\n   153→              [] ->\n   154→                {:error, :no_listeners}\n   155→\n   156→              [listener_pid | _] ->\n   157→                case Abyss.Listener.listener_info(listener_pid) do\n   158→                  {_ip, port} when is_integer(port) -> {:ok, port}\n   159→                  _ -> {:error, :invalid_listener_info}\n   160→                end\n   161→            end\n   162→        end\n   163→    end\n   164→  end\n   165→\n   166→  @doc \"\"\"\n   167→  Returns the TCP port the server is listening on.\n   168→  \"\"\"\n   169→  @spec get_tcp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n   170→  def get_tcp_port, do: get_tcp_port(__MODULE__)\n   171→\n   172→  @spec get_tcp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n   173→  def get_tcp_port(supervisor) do\n   174→    case find_thousand_island_pid(supervisor) do\n   175→      nil ->\n   176→        {:error, :thousand_island_not_found}\n   177→\n   178→      ti_pid ->\n   179→        # ThousandIsland.listener_info returns {:ok, {ip, port}} or :error\n   180→        case ThousandIsland.listener_info(ti_pid) do\n   181→          {:ok, {_ip, port}} when is_integer(port) -> {:ok, port}\n   182→          {:ok, _other} -> {:error, :invalid_listener_info}\n   183→          :error -> {:error, :port_not_available}\n   184→        end\n   185→    end\n   186→  end\n   187→\n   188→  # Supervisor callbacks\n   189→\n   190→  @impl true\n   191→  def init(opts) do\n   192→    Telemetry.info(\"Starting DNS network server\")\n   193→\n   194→    # Build configurations\n   195→    abyss_config = build_abyss_config(opts)\n   196→\n   197→    port = Keyword.get(opts, :port, 53)\n   198→    listen = Keyword.get(opts, :listen, {0, 0, 0, 0})\n   199→    listen_ip = normalize_ip(listen)\n   200→\n   201→    # Check if TCP is enabled\n   202→    tcp_enabled = Keyword.get(opts, :tcp_enabled, get_tcp_enabled())\n   203→\n   204→    Telemetry.info(\"DNS server listening\", %{\n   205→      port: port,\n   206→      listen: format_ip(listen_ip),\n   207→      udp: true,\n   208→      tcp: tcp_enabled\n   209→    })\n   210→\n   211→    # Always start UDP server\n   212→    children = [\n   213→      %{\n   214→        id: :abyss,\n   215→        start: {Abyss, :start_link, [abyss_config]},\n   216→        restart: :permanent,\n   217→        type: :supervisor\n   218→      }\n   219→    ]\n   220→\n   221→    # Conditionally add TCP server\n   222→    children =\n   223→      if tcp_enabled do\n   224→        tcp_config = build_thousand_island_config(opts)\n   225→\n   226→        children ++\n   227→          [\n   228→            %{\n   229→              id: :thousand_island,\n   230→              start: {ThousandIsland, :start_link, [tcp_config]},\n   231→              restart: :permanent,\n   232→              type: :supervisor\n   233→            }\n   234→          ]\n   235→      else\n   236→        Telemetry.info(\"DNS TCP server disabled by configuration\")\n   237→        children\n   238→      end\n   239→\n   240→    Supervisor.init(children, strategy: :one_for_one)\n   241→  end\n   242→\n   243→  # Private helpers\n   244→\n   245→  defp get_tcp_enabled do\n   246→    # Check config for tcp_enabled setting, default to true\n   247→    case apply(YellowDog.Config, :get, [:dns, :tcp_enabled]) do\n   248→      nil -> true\n   249→      enabled when is_boolean(enabled) -> enabled\n   250→      \"true\" -> true\n   251→      \"false\" -> false\n   252→      _ -> true\n   253→    end\n   254→  rescue\n   255→    _ -> true\n   256→  end\n   257→\n   258→  defp find_abyss_pid(supervisor) do\n   259→    pid = resolve_pid(supervisor)\n   260→\n   261→    case pid do\n   262→      nil ->\n   263→        nil\n   264→\n   265→      _ ->\n   266→        children = Supervisor.which_children(pid)\n   267→\n   268→        Enum.find_value(children, fn\n   269→          {:abyss, child_pid, :supervisor, _} when is_pid(child_pid) -> child_pid\n   270→          _ -> nil\n   271→        end)\n   272→    end\n   273→  rescue\n   274→    _ -> nil\n   275→  end\n   276→\n   277→  defp find_thousand_island_pid(supervisor) do\n   278→    pid = resolve_pid(supervisor)\n   279→\n   280→    case pid do\n   281→      nil ->\n   282→        nil\n   283→\n   284→      _ ->\n   285→        children = Supervisor.which_children(pid)\n   286→\n   287→        Enum.find_value(children, fn\n   288→          {:thousand_island, child_pid, :supervisor, _} when is_pid(child_pid) -> child_pid\n   289→          _ -> nil\n   290→        end)\n   291→    end\n   292→  rescue\n   293→    _ -> nil\n   294→  end\n   295→\n   296→  defp resolve_pid(supervisor) do\n   297→    cond do\n   298→      is_pid(supervisor) -> supervisor\n   299→      is_atom(supervisor) -> Process.whereis(supervisor)\n   300→      true -> nil\n   301→    end\n   302→  end\n   303→\n   304→  defp build_abyss_config(opts) do\n   305→    config = get_config()\n   306→    udp_config = config.udp\n   307→\n   308→    port = Keyword.get(opts, :port, config.port)\n   309→    listen_ip = normalize_ip(Keyword.get(opts, :listen, config.listen))\n   310→\n   311→    transport_options =\n   312→      udp_config.transport_options\n   313→      |> Keyword.put(:ip, listen_ip)\n   314→\n   315→    [\n   316→      port: port,\n   317→      transport_module: udp_config.transport_module,\n   318→      handler_module: udp_config.handler_module,\n   319→      transport_options: transport_options,\n   320→      read_timeout: udp_config.read_timeout,\n   321→      shutdown_timeout: udp_config.shutdown_timeout,\n   322→      num_listeners: udp_config.num_listeners,\n   323→      num_connections: udp_config.num_connections,\n   324→      max_packet_size: udp_config.max_packet_size\n   325→    ]\n   326→  end\n   327→\n   328→  defp build_thousand_island_config(opts) do\n   329→    config = get_config()\n   330→    tcp_config = config.tcp\n   331→\n   332→    port = Keyword.get(opts, :port, config.port)\n   333→    listen_ip = normalize_ip(Keyword.get(opts, :listen, config.listen))\n   334→\n   335→    transport_options =\n   336→      tcp_config.transport_options\n   337→      |> Keyword.put(:ip, listen_ip)\n   338→\n   339→    [\n   340→      port: port,\n   341→      handler_module: tcp_config.handler_module,\n   342→      transport_module: tcp_config.transport_module,\n   343→      transport_options: transport_options,\n   344→      num_acceptors: tcp_config.num_acceptors,\n   345→      num_connections: tcp_config.num_connections,\n   346→      read_timeout: tcp_config.read_timeout,\n   347→      shutdown_timeout: tcp_config.shutdown_timeout\n   348→    ]\n   349→  end\n   350→\n   351→  defp normalize_ip(ip) when is_tuple(ip), do: ip\n   352→\n   353→  defp normalize_ip(ip_str) when is_binary(ip_str) do\n   354→    charlist = String.to_charlist(ip_str)\n   355→\n   356→    case :inet.parse_ipv4_address(charlist) do\n   357→      {:ok, ip} ->\n   358→        ip\n   359→\n   360→      {:error, _} ->\n   361→        case :inet.parse_ipv6_address(charlist) do\n   362→          {:ok, ip} -> ip\n   363→          {:error, _} -> {0, 0, 0, 0}\n   364→        end\n   365→    end\n   366→  end\n   367→\n   368→  defp normalize_ip(_), do: {0, 0, 0, 0}\n   369→\n   370→  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n   371→\n   372→  defp format_ip({a, b, c, d, e, f, g, h}) do\n   373→    parts = [a, b, c, d, e, f, g, h]\n   374→    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n   375→    Enum.join(hex_parts, \":\")\n   376→  end\n   377→\n   378→  defp format_ip(other), do: inspect(other)\n   379→end\n   380→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"d2ed9b37-7553-434b-b786-dc21fa8deee6","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/server.ex","content":"defmodule YellowDog.Dns.Server do\n  @moduledoc \"\"\"\n  Network I/O server supervisor for DNS.\n\n  Supervises the network servers:\n  - `Abyss` - UDP server for DNS queries\n  - `ThousandIsland` - TCP server for DNS queries\n\n  This supervisor is a child of `YellowDog.Dns.Supervisor` and handles only\n  network I/O. All DNS resolution logic is handled by ConnectionProcess,\n  ViewManager, View, and Zone processes.\n\n  ## Handler Registration\n\n  - UDP: `YellowDog.Dns.Handler.UDP` is registered with Abyss\n  - TCP: `YellowDog.Dns.Handler.TCP` is registered with ThousandIsland\n\n  On each incoming packet/connection, handlers:\n  1. Call ConnectionManager to start a connection process\n  2. Forward queries to the connection process\n  3. Send responses back to the client\n  \"\"\"\n\n  use Supervisor\n\n  alias YellowDog.Telemetry\n\n  @doc \"\"\"\n  Starts the network server supervisor.\n\n  ## Options\n  - `port`: UDP/TCP port to listen on (default: 53)\n  - `listen`: IP address tuple to bind to\n  - `tcp_enabled`: Whether to enable TCP server (default: true, can be configured via TOML)\n\n  ## Returns\n  - `{:ok, pid}` - Server started successfully\n  - `{:error, reason}` - Failed to start server\n  \"\"\"\n  @spec start_link(keyword()) :: Supervisor.on_start()\n  def start_link(opts \\\\ []) do\n    Supervisor.start_link(__MODULE__, opts, name: __MODULE__)\n  end\n\n  @doc \"\"\"\n  Stops the server.\n  \"\"\"\n  @spec stop(pid() | atom()) :: :ok\n  def stop(pid \\\\ __MODULE__) do\n    Supervisor.stop(pid)\n  end\n\n  @doc \"\"\"\n  Gets the default server configuration.\n  \"\"\"\n  @spec get_config() :: map()\n  def get_config do\n    %{\n      # Shared settings\n      port: 53,\n      listen: {0, 0, 0, 0},\n\n      # TCP enabled flag (can be disabled via config)\n      tcp_enabled: true,\n\n      # UDP settings (Abyss)\n      udp: %{\n        transport_module: Abyss.Transport.UDP.Unicast,\n        handler_module: YellowDog.Dns.Handler.UDP,\n        transport_options: [\n          ip: {0, 0, 0, 0},\n          reuseaddr: true\n        ],\n        read_timeout: 5_000,\n        shutdown_timeout: 5_000,\n        num_listeners: 50,\n        num_connections: 10_000,\n        max_packet_size: 512\n      },\n\n      # TCP settings (ThousandIsland)\n      tcp: %{\n        handler_module: YellowDog.Dns.Handler.TCP,\n        transport_module: ThousandIsland.Transports.TCP,\n        transport_options: [\n          ip: {0, 0, 0, 0},\n          reuseaddr: true,\n          nodelay: true\n        ],\n        num_acceptors: 100,\n        num_connections: 16_384,\n        read_timeout: 120_000,\n        shutdown_timeout: 15_000\n      }\n    }\n  end\n\n  @doc \"\"\"\n  Returns server status.\n  \"\"\"\n  @spec status() :: map()\n  def status do\n    tcp_enabled = get_tcp_enabled()\n\n    %{\n      running: Process.whereis(__MODULE__) != nil,\n      udp: %{running: find_abyss_pid(__MODULE__) != nil},\n      tcp: %{\n        enabled: tcp_enabled,\n        running: tcp_enabled and find_thousand_island_pid(__MODULE__) != nil\n      }\n    }\n  end\n\n  @doc \"\"\"\n  Returns whether TCP is enabled.\n  \"\"\"\n  @spec tcp_enabled?() :: boolean()\n  def tcp_enabled? do\n    get_tcp_enabled()\n  end\n\n  @doc \"\"\"\n  Returns the UDP port the server is listening on.\n\n  Useful for tests when starting with port 0 (auto-select).\n  \"\"\"\n  @spec get_port() :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_port, do: get_udp_port(__MODULE__)\n\n  @spec get_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_port(pid), do: get_udp_port(pid)\n\n  @doc \"\"\"\n  Returns the UDP port the server is listening on.\n  \"\"\"\n  @spec get_udp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_udp_port, do: get_udp_port(__MODULE__)\n\n  @spec get_udp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_udp_port(supervisor) do\n    case find_abyss_pid(supervisor) do\n      nil ->\n        {:error, :abyss_not_found}\n\n      abyss_pid ->\n        case Abyss.Server.listener_pool_pid(abyss_pid) do\n          nil ->\n            {:error, :no_listener_pool}\n\n          pool_pid ->\n            case Abyss.ListenerPool.listener_pids(pool_pid) do\n              [] ->\n                {:error, :no_listeners}\n\n              [listener_pid | _] ->\n                case Abyss.Listener.listener_info(listener_pid) do\n                  {_ip, port} when is_integer(port) -> {:ok, port}\n                  _ -> {:error, :invalid_listener_info}\n                end\n            end\n        end\n    end\n  end\n\n  @doc \"\"\"\n  Returns the TCP port the server is listening on.\n  \"\"\"\n  @spec get_tcp_port() :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_tcp_port, do: get_tcp_port(__MODULE__)\n\n  @spec get_tcp_port(pid() | atom()) :: {:ok, :inet.port_number()} | {:error, term()}\n  def get_tcp_port(supervisor) do\n    case find_thousand_island_pid(supervisor) do\n      nil ->\n        {:error, :thousand_island_not_found}\n\n      ti_pid ->\n        # ThousandIsland.listener_info returns {:ok, {ip, port}} or :error\n        case ThousandIsland.listener_info(ti_pid) do\n          {:ok, {_ip, port}} when is_integer(port) -> {:ok, port}\n          {:ok, _other} -> {:error, :invalid_listener_info}\n          :error -> {:error, :port_not_available}\n        end\n    end\n  end\n\n  # Supervisor callbacks\n\n  @impl true\n  def init(opts) do\n    Telemetry.info(\"Starting DNS network server\")\n\n    # Build configurations\n    abyss_config = build_abyss_config(opts)\n\n    port = Keyword.get(opts, :port, 53)\n    listen = Keyword.get(opts, :listen, {0, 0, 0, 0})\n    listen_ip = normalize_ip(listen)\n\n    # Check if TCP is enabled\n    tcp_enabled = Keyword.get(opts, :tcp_enabled, get_tcp_enabled())\n\n    Telemetry.info(\"DNS server listening\", %{\n      port: port,\n      listen: format_ip(listen_ip),\n      udp: true,\n      tcp: tcp_enabled\n    })\n\n    # Always start UDP server\n    children = [\n      %{\n        id: :abyss,\n        start: {Abyss, :start_link, [abyss_config]},\n        restart: :permanent,\n        type: :supervisor\n      }\n    ]\n\n    # Conditionally add TCP server\n    children =\n      if tcp_enabled do\n        tcp_config = build_thousand_island_config(opts)\n\n        children ++\n          [\n            %{\n              id: :thousand_island,\n              start: {ThousandIsland, :start_link, [tcp_config]},\n              restart: :permanent,\n              type: :supervisor\n            }\n          ]\n      else\n        Telemetry.info(\"DNS TCP server disabled by configuration\")\n        children\n      end\n\n    Supervisor.init(children, strategy: :one_for_one)\n  end\n\n  # Private helpers\n\n  defp get_tcp_enabled do\n    # Check config for tcp_enabled setting, default to true\n    case apply(YellowDog.Config, :get, [:dns, :tcp_enabled]) do\n      nil -> true\n      enabled when is_boolean(enabled) -> enabled\n      \"true\" -> true\n      \"false\" -> false\n      _ -> true\n    end\n  rescue\n    _ -> true\n  end\n\n  defp find_abyss_pid(supervisor) do\n    pid = resolve_pid(supervisor)\n\n    case pid do\n      nil ->\n        nil\n\n      _ ->\n        children = Supervisor.which_children(pid)\n\n        Enum.find_value(children, fn\n          {:abyss, child_pid, :supervisor, _} when is_pid(child_pid) -> child_pid\n          _ -> nil\n        end)\n    end\n  rescue\n    _ -> nil\n  end\n\n  defp find_thousand_island_pid(supervisor) do\n    pid = resolve_pid(supervisor)\n\n    case pid do\n      nil ->\n        nil\n\n      _ ->\n        children = Supervisor.which_children(pid)\n\n        Enum.find_value(children, fn\n          {:thousand_island, child_pid, :supervisor, _} when is_pid(child_pid) -> child_pid\n          _ -> nil\n        end)\n    end\n  rescue\n    _ -> nil\n  end\n\n  defp resolve_pid(supervisor) do\n    cond do\n      is_pid(supervisor) -> supervisor\n      is_atom(supervisor) -> Process.whereis(supervisor)\n      true -> nil\n    end\n  end\n\n  defp build_abyss_config(opts) do\n    config = get_config()\n    udp_config = config.udp\n\n    port = Keyword.get(opts, :port, config.port)\n    listen_ip = normalize_ip(Keyword.get(opts, :listen, config.listen))\n\n    transport_options =\n      udp_config.transport_options\n      |> Keyword.put(:ip, listen_ip)\n\n    [\n      port: port,\n      transport_module: udp_config.transport_module,\n      handler_module: udp_config.handler_module,\n      transport_options: transport_options,\n      read_timeout: udp_config.read_timeout,\n      shutdown_timeout: udp_config.shutdown_timeout,\n      num_listeners: udp_config.num_listeners,\n      num_connections: udp_config.num_connections,\n      max_packet_size: udp_config.max_packet_size\n    ]\n  end\n\n  defp build_thousand_island_config(opts) do\n    config = get_config()\n    tcp_config = config.tcp\n\n    port = Keyword.get(opts, :port, config.port)\n    listen_ip = normalize_ip(Keyword.get(opts, :listen, config.listen))\n\n    transport_options =\n      tcp_config.transport_options\n      |> Keyword.put(:ip, listen_ip)\n\n    [\n      port: port,\n      handler_module: tcp_config.handler_module,\n      transport_module: tcp_config.transport_module,\n      transport_options: transport_options,\n      num_acceptors: tcp_config.num_acceptors,\n      num_connections: tcp_config.num_connections,\n      read_timeout: tcp_config.read_timeout,\n      shutdown_timeout: tcp_config.shutdown_timeout\n    ]\n  end\n\n  defp normalize_ip(ip) when is_tuple(ip), do: ip\n\n  defp normalize_ip(ip_str) when is_binary(ip_str) do\n    charlist = String.to_charlist(ip_str)\n\n    case :inet.parse_ipv4_address(charlist) do\n      {:ok, ip} ->\n        ip\n\n      {:error, _} ->\n        case :inet.parse_ipv6_address(charlist) do\n          {:ok, ip} -> ip\n          {:error, _} -> {0, 0, 0, 0}\n        end\n    end\n  end\n\n  defp normalize_ip(_), do: {0, 0, 0, 0}\n\n  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n\n  defp format_ip({a, b, c, d, e, f, g, h}) do\n    parts = [a, b, c, d, e, f, g, h]\n    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n    Enum.join(hex_parts, \":\")\n  end\n\n  defp format_ip(other), do: inspect(other)\nend\n","numLines":380,"startLine":1,"totalLines":380}}}
