error_count: 0\n    58→  ]\n    59→\n    60→  # Client API\n    61→\n    62→  @doc \"\"\"\n    63→  Starts a RecursionController.\n    64→\n    65→  ## Options\n    66→\n    67→  - `:view_name` - Name of the parent view\n    68→  - `:root_servers` - Custom root server list (optional)\n    69→  \"\"\"\n    70→  @spec start_link(keyword()) :: GenServer.on_start()\n    71→  def start_link(opts \\\\ []) do\n    72→    view_name = Keyword.get(opts, :view_name, \"default\")\n    73→    GenServer.start_link(__MODULE__, opts, name: via_tuple(view_name))\n    74→  end\n    75→\n    76→  @doc \"\"\"\n    77→  Performs recursive resolution for a query.\n    78→  \"\"\"\n    79→  @spec resolve(pid(), Message.t()) :: {:ok, Message.t()} | {:error, atom()}\n    80→  def resolve(pid, query) do\n    81→    GenServer.call(pid, {:resolve, query}, @query_timeout * @max_recursion_depth)\n    82→  end\n    83→\n    84→  @doc \"\"\"\n    85→  Returns recursion controller statistics.\n    86→  \"\"\"\n    87→  @spec stats(pid()) :: map()\n    88→  def stats(pid) do\n    89→    GenServer.call(pid, :stats)\n    90→  end\n    91→\n    92→  # Server Callbacks\n    93→\n    94→  @impl true\n    95→  def init(opts) do\n    96→    view_name = Keyword.get(opts, :view_name, \"default\")\n    97→    root_servers = Keyword.get(opts, :root_servers, @default_root_servers)\n    98→\n    99→    {:ok, socket} = :gen_udp.open(0, [:binary, active: true])\n   100→\n   101→    state = %__MODULE__{\n   102→      view_name: view_name,\n   103→      socket: socket,\n   104→      root_servers: root_servers\n   105→    }\n   106→\n   107→    Telemetry.info(\"RecursionController started\", %{view: view_name})\n   108→\n   109→    {:ok, state}\n   110→  end\n   111→\n   112→  @impl true\n   113→  def handle_call({:resolve, query}, _from, state) do\n   114→    state = %{state | query_count: state.query_count + 1}\n   115→\n   116→    # Start recursive resolution\n   117→    case do_recursive_resolve(state, query, 0) do\n   118→      {:ok, response} ->\n   119→        state = %{state | success_count: state.success_count + 1}\n   120→        {:reply, {:ok, response}, state}\n   121→\n   122→      {:error, reason} ->\n   123→        state = %{state | error_count: state.error_count + 1}\n   124→        {:reply, {:error, reason}, state}\n   125→    end\n   126→  end\n   127→\n   128→  @impl true\n   129→  def handle_call(:stats, _from, state) do\n   130→    stats = %{\n   131→      view_name: state.view_name,\n   132→      query_count: state.query_count,\n   133→      success_count: state.success_count,\n   134→      error_count: state.error_count\n   135→    }\n   136→\n   137→    {:reply, stats, state}\n   138→  end\n   139→\n   140→  @impl true\n   141→  def handle_info({:udp, _socket, _ip, _port, _data}, state) do\n   142→    # Handle async UDP responses if needed\n   143→    {:noreply, state}\n   144→  end\n   145→\n   146→  @impl true\n   147→  def terminate(_reason, state) do\n   148→    :gen_udp.close(state.socket)\n   149→    :ok\n   150→  end\n   151→\n   152→  # Private Functions\n   153→\n   154→  defp do_recursive_resolve(_state, _query, depth) when depth >= @max_recursion_depth do\n   155→    {:error, :max_recursion_depth}\n   156→  end\n   157→\n   158→  defp do_recursive_resolve(state, query, depth) do\n   159→    case query.qdlist do\n   160→      [question | _] ->\n   161→        # Start from root servers\n   162→        resolve_from_servers(state, query, question, state.root_servers, depth)\n   163→\n   164→      [] ->\n   165→        {:error, :format_error}\n   166→    end\n   167→  end\n   168→\n   169→  defp resolve_from_servers(_state, _query, _question, [], _depth) do\n   170→    {:error, :no_servers}\n   171→  end\n   172→\n   173→  defp resolve_from_servers(state, query, question, [server | rest], depth) do\n   174→    case query_server(state, query, server) do\n   175→      {:ok, response} ->\n   176→        handle_response(state, query, question, response, depth)\n   177→\n   178→      {:error, _reason} ->\n   179→        # Try next server\n   180→        resolve_from_servers(state, query, question, rest, depth)\n   181→    end\n   182→  end\n   183→\n   184→  defp query_server(state, query, {ip, port}) do\n   185→    data = DNS.to_iodata(query)\n   186→\n   187→    case :gen_udp.send(state.socket, ip, port, data) do\n   188→      :ok ->\n   189→        receive_response(state.socket, query.header.id)\n   190→\n   191→      {:error, reason} ->\n   192→        {:error, reason}\n   193→    end\n   194→  end\n   195→\n   196→  defp receive_response(socket, expected_id) do\n   197→    receive do\n   198→      {:udp, ^socket, _ip, _port, data} ->\n   199→        try do\n   200→          response = DNS.Message.from_iodata(data)\n   201→\n   202→          if response.header.id == expected_id do\n   203→            {:ok, response}\n   204→          else\n   205→            # Wrong ID, try again\n   206→            receive_response(socket, expected_id)\n   207→          end\n   208→        catch\n   209→          :throw, reason ->\n   210→            {:error, reason}\n   211→        end\n   212→    after\n   213→      @query_timeout ->\n   214→        {:error, :timeout}\n   215→    end\n   216→  end\n   217→\n   218→  defp handle_response(state, query, question, response, depth) do\n   219→    rcode = normalize_rcode(response.header.rcode)\n   220→\n   221→    cond do\n   222→      # Got an answer\n   223→      rcode == :noerror and length(response.anlist) > 0 ->\n   224→        {:ok, response}\n   225→\n   226→      # NXDOMAIN\n   227→      rcode == :nxdomain ->\n   228→        {:ok, response}\n   229→\n   230→      # Got referral (no answers but has authority section with NS records)\n   231→      length(response.anlist) == 0 and has_ns_records?(response.nslist) ->\n   232→        follow_referral(state, query, question, response, depth)\n   233→\n   234→      # Server error\n   235→      rcode != :noerror ->\n   236→        {:error, rcode}\n   237→\n   238→      # No useful response\n   239→      true ->\n   240→        {:error, :no_data}\n   241→    end\n   242→  end\n   243→\n   244→  # Normalize rcode to atom for comparison\n   245→  defp normalize_rcode(:noerror), do: :noerror\n   246→  defp normalize_rcode(:nxdomain), do: :nxdomain\n   247→  defp normalize_rcode(%RCode{value: <<0::4>>}), do: :noerror\n   248→  defp normalize_rcode(%RCode{value: <<1::4>>}), do: :formerr\n   249→  defp normalize_rcode(%RCode{value: <<2::4>>}), do: :servfail\n   250→  defp normalize_rcode(%RCode{value: <<3::4>>}), do: :nxdomain\n   251→  defp normalize_rcode(%RCode{value: <<4::4>>}), do: :notimp\n   252→  defp normalize_rcode(%RCode{value: <<5::4>>}), do: :refused\n   253→  defp normalize_rcode(%RCode{} = rcode), do: rcode\n   254→  defp normalize_rcode(other), do: other\n   255→\n   256→  defp follow_referral(state, query, question, response, depth) do\n   257→    # Extract NS records and their glue\n   258→    ns_records = Enum.filter(response.nslist, &(&1.type == :ns))\n   259→\n   260→    # Get glue records (A/AAAA in additional section)\n   261→    glue_records = extract_glue(response.arlist)\n   262→\n   263→    # Build server list from NS + glue\n   264→    servers = build_server_list(ns_records, glue_records)\n   265→\n   266→    if Enum.empty?(servers) do\n   267→      # No glue, need to resolve NS hostnames first\n   268→      case resolve_ns_addresses(state, ns_records, depth + 1) do\n   269→        {:ok, resolved_servers} ->\n   270→          resolve_from_servers(state, query, question, resolved_servers, depth + 1)\n   271→\n   272→        {:error, reason} ->\n   273→          {:error, reason}\n   274→      end\n   275→    else\n   276→      resolve_from_servers(state, query, question, servers, depth + 1)\n   277→    end\n   278→  end\n   279→\n   280→  defp has_ns_records?(records) do\n   281→    Enum.any?(records, &(&1.type == :ns))\n   282→  end\n   283→\n   284→  defp extract_glue(additional) do\n   285→    additional\n   286→    |> Enum.filter(&(&1.type in [:a, :aaaa]))\n   287→    |> Enum.group_by(& &1.name)\n   288→  end\n   289→\n   290→  defp build_server_list(ns_records, glue_records) do\n   291→    Enum.flat_map(ns_records, fn ns ->\n   292→      ns_hostname = ns.rdata\n   293→\n   294→      case Map.get(glue_records, ns_hostname, []) do\n   295→        [] ->\n   296→          []\n   297→\n   298→        glue ->\n   299→          Enum.map(glue, fn record ->\n   300→            {record.rdata, 53}\n   301→          end)\n   302→      end\n   303→    end)\n   304→  end\n   305→\n   306→  defp resolve_ns_addresses(_state, [], _depth) do\n   307→    {:error, :no_ns}\n   308→  end\n   309→\n   310→  defp resolve_ns_addresses(state, [ns | rest], depth) do\n   311→    ns_hostname = ns.rdata\n   312→\n   313→    # Create query for NS hostname\n   314→    ns_query = build_query(ns_hostname, :a)\n   315→\n   316→    case do_recursive_resolve(state, ns_query, depth) do\n   317→      {:ok, response} ->\n   318→        addresses =\n   319→          response.anlist\n   320→          |> Enum.filter(&(&1.type == :a))\n   321→          |> Enum.map(&{&1.rdata, 53})\n   322→\n   323→        if Enum.empty?(addresses) do\n   324→          resolve_ns_addresses(state, rest, depth)\n   325→        else\n   326→          {:ok, addresses}\n   327→        end\n   328→\n   329→      {:error, _reason} ->\n   330→        resolve_ns_addresses(state, rest, depth)\n   331→    end\n   332→  end\n   333→\n   334→  defp build_query(name, type) do\n   335→    %Message{\n   336→      header: %DNS.Message.Header{\n   337→        id: :rand.uniform(65535),\n   338→        qr: 0,\n   339→        opcode: :query,\n   340→        aa: 0,\n   341→        tc: 0,\n   342→        rd: 0,\n   343→        ra: 0,\n   344→        rcode: RCode.no_error()\n   345→      },\n   346→      qdlist: [\n   347→        DNS.Message.Question.new(name, type, :in)\n   348→      ],\n   349→      anlist: [],\n   350→      nslist: [],\n   351→      arlist: []\n   352→    }\n   353→  end\n   354→\n   355→  defp via_tuple(view_name) do\n   356→    {:via, Registry, {YellowDog.Dns.RecursionRegistry, view_name}}\n   357→  end\n   358→end\n   359→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"84996b7b-e98e-4515-80e7-3bf6c146a135","uuid":"c90b0e1a-f51e-4b89-b744-de6fee2e5da4","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/recursion_controller.ex","content":"defmodule YellowDog.Dns.RecursionController do\n  @moduledoc \"\"\"\n  Handles recursive DNS resolution.\n\n  The RecursionController performs iterative queries starting from root\n  servers to resolve domain names that are not in local zones.\n\n  ## Resolution Process\n\n  1. Start with root hints (root nameservers)\n  2. Query root server for TLD nameservers\n  3. Query TLD server for authoritative nameservers\n  4. Query authoritative server for final answer\n  5. Follow referrals until answer is found or max depth reached\n\n  ## Features\n\n  - Iterative resolution from root\n  - Referral following\n  - Glue record handling\n  - Query depth limiting\n  - Response caching\n  \"\"\"\n\n  use GenServer\n\n  alias YellowDog.Telemetry\n  alias DNS.Message\n  alias DNS.Message.RCode\n\n  @max_recursion_depth 10\n  @query_timeout 5000\n  @default_root_servers [\n    # Root servers - a.root-servers.net through m.root-servers.net\n    {{198, 41, 0, 4}, 53},\n    {{199, 9, 14, 201}, 53},\n    {{192, 33, 4, 12}, 53},\n    {{199, 7, 91, 13}, 53},\n    {{192, 203, 230, 10}, 53},\n    {{192, 5, 5, 241}, 53},\n    {{192, 112, 36, 4}, 53},\n    {{198, 97, 190, 53}, 53},\n    {{192, 36, 148, 17}, 53},\n    {{192, 58, 128, 30}, 53},\n    {{193, 0, 14, 129}, 53},\n    {{199, 7, 83, 42}, 53},\n    {{202, 12, 27, 33}, 53}\n  ]\n\n  defstruct [\n    :view_name,\n    :socket,\n    :root_servers,\n    pending: %{},\n    query_count: 0,\n    success_count: 0,\n    error_count: 0\n  ]\n\n  # Client API\n\n  @doc \"\"\"\n  Starts a RecursionController.\n\n  ## Options\n\n  - `:view_name` - Name of the parent view\n  - `:root_servers` - Custom root server list (optional)\n  \"\"\"\n  @spec start_link(keyword()) :: GenServer.on_start()\n  def start_link(opts \\\\ []) do\n    view_name = Keyword.get(opts, :view_name, \"default\")\n    GenServer.start_link(__MODULE__, opts, name: via_tuple(view_name))\n  end\n\n  @doc \"\"\"\n  Performs recursive resolution for a query.\n  \"\"\"\n  @spec resolve(pid(), Message.t()) :: {:ok, Message.t()} | {:error, atom()}\n  def resolve(pid, query) do\n    GenServer.call(pid, {:resolve, query}, @query_timeout * @max_recursion_depth)\n  end\n\n  @doc \"\"\"\n  Returns recursion controller statistics.\n  \"\"\"\n  @spec stats(pid()) :: map()\n  def stats(pid) do\n    GenServer.call(pid, :stats)\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(opts) do\n    view_name = Keyword.get(opts, :view_name, \"default\")\n    root_servers = Keyword.get(opts, :root_servers, @default_root_servers)\n\n    {:ok, socket} = :gen_udp.open(0, [:binary, active: true])\n\n    state = %__MODULE__{\n      view_name: view_name,\n      socket: socket,\n      root_servers: root_servers\n    }\n\n    Telemetry.info(\"RecursionController started\", %{view: view_name})\n\n    {:ok, state}\n  end\n\n  @impl true\n  def handle_call({:resolve, query}, _from, state) do\n    state = %{state | query_count: state.query_count + 1}\n\n    # Start recursive resolution\n    case do_recursive_resolve(state, query, 0) do\n      {:ok, response} ->\n        state = %{state | success_count: state.success_count + 1}\n        {:reply, {:ok, response}, state}\n\n      {:error, reason} ->\n        state = %{state | error_count: state.error_count + 1}\n        {:reply, {:error, reason}, state}\n    end\n  end\n\n  @impl true\n  def handle_call(:stats, _from, state) do\n    stats = %{\n      view_name: state.view_name,\n      query_count: state.query_count,\n      success_count: state.success_count,\n      error_count: state.error_count\n    }\n\n    {:reply, stats, state}\n  end\n\n  @impl true\n  def handle_info({:udp, _socket, _ip, _port, _data}, state) do\n    # Handle async UDP responses if needed\n    {:noreply, state}\n  end\n\n  @impl true\n  def terminate(_reason, state) do\n    :gen_udp.close(state.socket)\n    :ok\n  end\n\n  # Private Functions\n\n  defp do_recursive_resolve(_state, _query, depth) when depth >= @max_recursion_depth do\n    {:error, :max_recursion_depth}\n  end\n\n  defp do_recursive_resolve(state, query, depth) do\n    case query.qdlist do\n      [question | _] ->\n        # Start from root servers\n        resolve_from_servers(state, query, question, state.root_servers, depth)\n\n      [] ->\n        {:error, :format_error}\n    end\n  end\n\n  defp resolve_from_servers(_state, _query, _question, [], _depth) do\n    {:error, :no_servers}\n  end\n\n  defp resolve_from_servers(state, query, question, [server | rest], depth) do\n    case query_server(state, query, server) do\n      {:ok, response} ->\n        handle_response(state, query, question, response, depth)\n\n      {:error, _reason} ->\n        # Try next server\n        resolve_from_servers(state, query, question, rest, depth)\n    end\n  end\n\n  defp query_server(state, query, {ip, port}) do\n    data = DNS.to_iodata(query)\n\n    case :gen_udp.send(state.socket, ip, port, data) do\n      :ok ->\n        receive_response(state.socket, query.header.id)\n\n      {:error, reason} ->\n        {:error, reason}\n    end\n  end\n\n  defp receive_response(socket, expected_id) do\n    receive do\n      {:udp, ^socket, _ip, _port, data} ->\n        try do\n          response = DNS.Message.from_iodata(data)\n\n          if response.header.id == expected_id do\n            {:ok, response}\n          else\n            # Wrong ID, try again\n            receive_response(socket, expected_id)\n          end\n        catch\n          :throw, reason ->\n            {:error, reason}\n        end\n    after\n      @query_timeout ->\n        {:error, :timeout}\n    end\n  end\n\n  defp handle_response(state, query, question, response, depth) do\n    rcode = normalize_rcode(response.header.rcode)\n\n    cond do\n      # Got an answer\n      rcode == :noerror and length(response.anlist) > 0 ->\n        {:ok, response}\n\n      # NXDOMAIN\n      rcode == :nxdomain ->\n        {:ok, response}\n\n      # Got referral (no answers but has authority section with NS records)\n      length(response.anlist) == 0 and has_ns_records?(response.nslist) ->\n        follow_referral(state, query, question, response, depth)\n\n      # Server error\n      rcode != :noerror ->\n        {:error, rcode}\n\n      # No useful response\n      true ->\n        {:error, :no_data}\n    end\n  end\n\n  # Normalize rcode to atom for comparison\n  defp normalize_rcode(:noerror), do: :noerror\n  defp normalize_rcode(:nxdomain), do: :nxdomain\n  defp normalize_rcode(%RCode{value: <<0::4>>}), do: :noerror\n  defp normalize_rcode(%RCode{value: <<1::4>>}), do: :formerr\n  defp normalize_rcode(%RCode{value: <<2::4>>}), do: :servfail\n  defp normalize_rcode(%RCode{value: <<3::4>>}), do: :nxdomain\n  defp normalize_rcode(%RCode{value: <<4::4>>}), do: :notimp\n  defp normalize_rcode(%RCode{value: <<5::4>>}), do: :refused\n  defp normalize_rcode(%RCode{} = rcode), do: rcode\n  defp normalize_rcode(other), do: other\n\n  defp follow_referral(state, query, question, response, depth) do\n    # Extract NS records and their glue\n    ns_records = Enum.filter(response.nslist, &(&1.type == :ns))\n\n    # Get glue records (A/AAAA in additional section)\n    glue_records = extract_glue(response.arlist)\n\n    # Build server list from NS + glue\n    servers = build_server_list(ns_records, glue_records)\n\n    if Enum.empty?(servers) do\n      # No glue, need to resolve NS hostnames first\n      case resolve_ns_addresses(state, ns_records, depth + 1) do\n        {:ok, resolved_servers} ->\n          resolve_from_servers(state, query, question, resolved_servers, depth + 1)\n\n        {:error, reason} ->\n          {:error, reason}\n      end\n    else\n      resolve_from_servers(state, query, question, servers, depth + 1)\n    end\n  end\n\n  defp has_ns_records?(records) do\n    Enum.any?(records, &(&1.type == :ns))\n  end\n\n  defp extract_glue(additional) do\n    additional\n    |> Enum.filter(&(&1.type in [:a, :aaaa]))\n    |> Enum.group_by(& &1.name)\n  end\n\n  defp build_server_list(ns_records, glue_records) do\n    Enum.flat_map(ns_records, fn ns ->\n      ns_hostname = ns.rdata\n\n      case Map.get(glue_records, ns_hostname, []) do\n        [] ->\n          []\n\n        glue ->\n          Enum.map(glue, fn record ->\n            {record.rdata, 53}\n          end)\n      end\n    end)\n  end\n\n  defp resolve_ns_addresses(_state, [], _depth) do\n    {:error, :no_ns}\n  end\n\n  defp resolve_ns_addresses(state, [ns | rest], depth) do\n    ns_hostname = ns.rdata\n\n    # Create query for NS hostname\n    ns_query = build_query(ns_hostname, :a)\n\n    case do_recursive_resolve(state, ns_query, depth) do\n      {:ok, response} ->\n        addresses =\n          response.anlist\n          |> Enum.filter(&(&1.type == :a))\n          |> Enum.map(&{&1.rdata, 53})\n\n        if Enum.empty?(addresses) do\n          resolve_ns_addresses(state, rest, depth)\n        else\n          {:ok, addresses}\n        end\n\n      {:error, _reason} ->\n        resolve_ns_addresses(state, rest, depth)\n    end\n  end\n\n  defp build_query(name, type) do\n    %Message{\n      header: %DNS.Message.Header{\n        id: :rand.uniform(65535),\n        qr: 0,\n        opcode: :query,\n        aa: 0,\n        tc: 0,\n        rd: 0,\n        ra: 0,\n        rcode: RCode.no_error()\n      },\n      qdlist: [\n        DNS.Message.Question.new(name, type, :in)\n      ],\n      anlist: [],\n      nslist: [],\n      arlist: []\n    }\n  end\n\n  defp via_tuple(view_name) do\n    {:via, Registry, {YellowDog.Dns.RecursionRegistry, view_name}}\n  end\nend\n","numLines":359,"startLine":1,"totalLines":359}}}
