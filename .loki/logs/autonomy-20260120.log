{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UpW8FBAALfvrEJyAbrFaW9","type":"tool_result","content":"     1→defmodule YellowDog.Dns.Handler.UDP do\n     2→  @moduledoc \"\"\"\n     3→  UDP DNS message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  This handler focuses ONLY on network I/O:\n     6→  - On first request: call ConnectionManager to start connection process\n     7→  - Forward all raw data to connection process (no parsing)\n     8→  - Send raw responses from connection process to client\n     9→  - On network connection close: notify connection process to terminate\n    10→\n    11→  All DNS protocol handling (parsing, resolution, encoding) is done by\n    12→  ConnectionProcess, ViewManager, View, and Zone processes.\n    13→\n    14→  ## Lifecycle\n    15→\n    16→  1 network connection = 1 Handler process = 1 connection process\n    17→  UDP: typically one query, then connection closes\n    18→  TCP: potentially multiple concurrent queries, terminates when TCP closes\n    19→  \"\"\"\n    20→\n    21→  use Abyss.Handler\n    22→\n    23→  alias YellowDog.Telemetry\n    24→  alias YellowDog.Dns.{ConnectionManager, RateLimiter}\n    25→\n    26→  ## Abyss.Handler Callbacks\n    27→\n    28→  @impl true\n    29→  def handle_data({client_ip, client_port, data}, state) do\n    30→    # Check rate limit before processing\n    31→    case RateLimiter.check_rate(client_ip) do\n    32→      :ok ->\n    33→        process_data(client_ip, client_port, data, state)\n    34→\n    35→      {:error, :rate_limited} ->\n    36→        Telemetry.warning(\"DNS request rate limited\", %{\n    37→          client_ip: format_ip(client_ip),\n    38→          client_port: client_port\n    39→        })\n    40→\n    41→        :telemetry.execute(\n    42→          [:yellow_dog, :dns, :message, :rate_limited],\n    43→          %{count: 1},\n    44→          %{client_ip: client_ip, client_port: client_port}\n    45→        )\n    46→\n    47→        # Drop the request silently (per RFC best practices for DNS)\n    48→        {:continue, state}\n    49→    end\n    50→  end\n    51→\n    52→  defp process_data(client_ip, client_port, data, state) do\n    53→    Telemetry.debug(\"DNS UDP received data\", %{\n    54→      client_ip: format_ip(client_ip),\n    55→      client_port: client_port,\n    56→      size: byte_size(data)\n    57→    })\n    58→\n    59→    try do\n    60→      handle_raw_data(data, client_ip, client_port, state)\n    61→    rescue\n    62→      error ->\n    63→        Telemetry.error(\"DNS handler exception\", %{\n    64→          client_ip: format_ip(client_ip),\n    65→          client_port: client_port,\n    66→          error: Exception.message(error)\n    67→        })\n    68→\n    69→        {:continue, state}\n    70→    end\n    71→  end\n    72→\n    73→  @impl true\n    74→  def handle_error(error, state) do\n    75→    Telemetry.error(\"DNS handler error\", %{error: inspect(error)})\n    76→    {:continue, state}\n    77→  end\n    78→\n    79→  @impl true\n    80→  def handle_timeout(state) do\n    81→    Telemetry.debug(\"DNS handler timeout\")\n    82→\n    83→    # Notify connection process if it exists\n    84→    if Map.get(state, :connection_pid) do\n    85→      YellowDog.Dns.ConnectionProcess.connection_closed(state.connection_pid)\n    86→    end\n    87→\n    88→    {:continue, state}\n    89→  end\n    90→\n    91→  ## Private Functions\n    92→\n    93→  defp handle_raw_data(data, client_ip, client_port, state) do\n    94→    Telemetry.debug(\"Received DNS data\", %{\n    95→      client_ip: format_ip(client_ip),\n    96→      client_port: client_port,\n    97→      size: byte_size(data)\n    98→    })\n    99→\n   100→    # Get or start connection process\n   101→    case get_or_start_connection(state, client_ip, client_port) do\n   102→      {:ok, conn_pid, new_state} ->\n   103→        # Submit raw data to connection process\n   104→        case YellowDog.Dns.ConnectionProcess.submit_raw_data(conn_pid, data) do\n   105→          :ok ->\n   106→            # Wait for raw response from connection process\n   107→            receive do\n   108→              {:dns_raw_response, _query_id, response_data} ->\n   109→                send_raw_response(response_data, client_ip, client_port, new_state.socket)\n   110→                {:close, new_state}\n   111→            after\n   112→              10_000 ->\n   113→                # Timeout waiting for response\n   114→                Telemetry.warning(\"Timeout waiting for DNS response\", %{\n   115→                  client_ip: format_ip(client_ip),\n   116→                  data_size: byte_size(data)\n   117→                })\n   118→\n   119→                {:close, new_state}\n   120→            end\n   121→\n   122→          {:error, reason} ->\n   123→            Telemetry.warning(\"Failed to submit data to connection process\", %{\n   124→              reason: inspect(reason)\n   125→            })\n   126→\n   127→            {:close, state}\n   128→        end\n   129→\n   130→      {:error, reason} ->\n   131→        Telemetry.error(\"Failed to start connection process\", %{reason: inspect(reason)})\n   132→        {:close, state}\n   133→    end\n   134→  end\n   135→\n   136→  defp get_or_start_connection(state, client_ip, client_port) do\n   137→    case Map.get(state, :connection_pid) do\n   138→      nil ->\n   139→        # Start new connection process\n   140→        case ConnectionManager.start_connection(self(), client_ip, client_port,\n   141→               socket: state.socket\n   142→             ) do\n   143→          {:ok, pid} ->\n   144→            {:ok, pid, Map.put(state, :connection_pid, pid)}\n   145→\n   146→          {:error, reason} ->\n   147→            {:error, reason}\n   148→        end\n   149→\n   150→      pid when is_pid(pid) ->\n   151→        if Process.alive?(pid) do\n   152→          {:ok, pid, state}\n   153→        else\n   154→          # Connection died, start new one\n   155→          case ConnectionManager.start_connection(self(), client_ip, client_port,\n   156→                 socket: state.socket\n   157→               ) do\n   158→            {:ok, new_pid} ->\n   159→              {:ok, new_pid, Map.put(state, :connection_pid, new_pid)}\n   160→\n   161→            {:error, reason} ->\n   162→              {:error, reason}\n   163→          end\n   164→        end\n   165→    end\n   166→  end\n   167→\n   168→  defp send_raw_response(response_data, client_ip, client_port, socket) do\n   169→    case Abyss.Transport.UDP.send(socket, client_ip, client_port, response_data) do\n   170→      :ok ->\n   171→        Telemetry.debug(\"Sent DNS response\", %{\n   172→          client_ip: format_ip(client_ip),\n   173→          client_port: client_port,\n   174→          size: IO.iodata_length(response_data)\n   175→        })\n   176→\n   177→      {:error, reason} ->\n   178→        Telemetry.error(\"Failed to send DNS response\", %{\n   179→          reason: inspect(reason)\n   180→        })\n   181→    end\n   182→  end\n   183→\n   184→  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n   185→\n   186→  defp format_ip({a, b, c, d, e, f, g, h}) do\n   187→    parts = [a, b, c, d, e, f, g, h]\n   188→    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n   189→    Enum.join(hex_parts, \":\")\n   190→  end\n   191→\n   192→  defp format_ip(other), do: inspect(other)\n   193→end\n   194→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"8e9923eb-49c0-49b4-8fd7-a286152e61a5","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/handler/udp.ex","content":"defmodule YellowDog.Dns.Handler.UDP do\n  @moduledoc \"\"\"\n  UDP DNS message handler implementing the Abyss.Handler behaviour.\n\n  This handler focuses ONLY on network I/O:\n  - On first request: call ConnectionManager to start connection process\n  - Forward all raw data to connection process (no parsing)\n  - Send raw responses from connection process to client\n  - On network connection close: notify connection process to terminate\n\n  All DNS protocol handling (parsing, resolution, encoding) is done by\n  ConnectionProcess, ViewManager, View, and Zone processes.\n\n  ## Lifecycle\n\n  1 network connection = 1 Handler process = 1 connection process\n  UDP: typically one query, then connection closes\n  TCP: potentially multiple concurrent queries, terminates when TCP closes\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Telemetry\n  alias YellowDog.Dns.{ConnectionManager, RateLimiter}\n\n  ## Abyss.Handler Callbacks\n\n  @impl true\n  def handle_data({client_ip, client_port, data}, state) do\n    # Check rate limit before processing\n    case RateLimiter.check_rate(client_ip) do\n      :ok ->\n        process_data(client_ip, client_port, data, state)\n\n      {:error, :rate_limited} ->\n        Telemetry.warning(\"DNS request rate limited\", %{\n          client_ip: format_ip(client_ip),\n          client_port: client_port\n        })\n\n        :telemetry.execute(\n          [:yellow_dog, :dns, :message, :rate_limited],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port}\n        )\n\n        # Drop the request silently (per RFC best practices for DNS)\n        {:continue, state}\n    end\n  end\n\n  defp process_data(client_ip, client_port, data, state) do\n    Telemetry.debug(\"DNS UDP received data\", %{\n      client_ip: format_ip(client_ip),\n      client_port: client_port,\n      size: byte_size(data)\n    })\n\n    try do\n      handle_raw_data(data, client_ip, client_port, state)\n    rescue\n      error ->\n        Telemetry.error(\"DNS handler exception\", %{\n          client_ip: format_ip(client_ip),\n          client_port: client_port,\n          error: Exception.message(error)\n        })\n\n        {:continue, state}\n    end\n  end\n\n  @impl true\n  def handle_error(error, state) do\n    Telemetry.error(\"DNS handler error\", %{error: inspect(error)})\n    {:continue, state}\n  end\n\n  @impl true\n  def handle_timeout(state) do\n    Telemetry.debug(\"DNS handler timeout\")\n\n    # Notify connection process if it exists\n    if Map.get(state, :connection_pid) do\n      YellowDog.Dns.ConnectionProcess.connection_closed(state.connection_pid)\n    end\n\n    {:continue, state}\n  end\n\n  ## Private Functions\n\n  defp handle_raw_data(data, client_ip, client_port, state) do\n    Telemetry.debug(\"Received DNS data\", %{\n      client_ip: format_ip(client_ip),\n      client_port: client_port,\n      size: byte_size(data)\n    })\n\n    # Get or start connection process\n    case get_or_start_connection(state, client_ip, client_port) do\n      {:ok, conn_pid, new_state} ->\n        # Submit raw data to connection process\n        case YellowDog.Dns.ConnectionProcess.submit_raw_data(conn_pid, data) do\n          :ok ->\n            # Wait for raw response from connection process\n            receive do\n              {:dns_raw_response, _query_id, response_data} ->\n                send_raw_response(response_data, client_ip, client_port, new_state.socket)\n                {:close, new_state}\n            after\n              10_000 ->\n                # Timeout waiting for response\n                Telemetry.warning(\"Timeout waiting for DNS response\", %{\n                  client_ip: format_ip(client_ip),\n                  data_size: byte_size(data)\n                })\n\n                {:close, new_state}\n            end\n\n          {:error, reason} ->\n            Telemetry.warning(\"Failed to submit data to connection process\", %{\n              reason: inspect(reason)\n            })\n\n            {:close, state}\n        end\n\n      {:error, reason} ->\n        Telemetry.error(\"Failed to start connection process\", %{reason: inspect(reason)})\n        {:close, state}\n    end\n  end\n\n  defp get_or_start_connection(state, client_ip, client_port) do\n    case Map.get(state, :connection_pid) do\n      nil ->\n        # Start new connection process\n        case ConnectionManager.start_connection(self(), client_ip, client_port,\n               socket: state.socket\n             ) do\n          {:ok, pid} ->\n            {:ok, pid, Map.put(state, :connection_pid, pid)}\n\n          {:error, reason} ->\n            {:error, reason}\n        end\n\n      pid when is_pid(pid) ->\n        if Process.alive?(pid) do\n          {:ok, pid, state}\n        else\n          # Connection died, start new one\n          case ConnectionManager.start_connection(self(), client_ip, client_port,\n                 socket: state.socket\n               ) do\n            {:ok, new_pid} ->\n              {:ok, new_pid, Map.put(state, :connection_pid, new_pid)}\n\n            {:error, reason} ->\n              {:error, reason}\n          end\n        end\n    end\n  end\n\n  defp send_raw_response(response_data, client_ip, client_port, socket) do\n    case Abyss.Transport.UDP.send(socket, client_ip, client_port, response_data) do\n      :ok ->\n        Telemetry.debug(\"Sent DNS response\", %{\n          client_ip: format_ip(client_ip),\n          client_port: client_port,\n          size: IO.iodata_length(response_data)\n        })\n\n      {:error, reason} ->\n        Telemetry.error(\"Failed to send DNS response\", %{\n          reason: inspect(reason)\n        })\n    end\n  end\n\n  defp format_ip({a, b, c, d}), do: \"#{a}.#{b}.#{c}.#{d}\"\n\n  defp format_ip({a, b, c, d, e, f, g, h}) do\n    parts = [a, b, c, d, e, f, g, h]\n    hex_parts = Enum.map(parts, &Integer.to_string(&1, 16))\n    Enum.join(hex_parts, \":\")\n  end\n\n  defp format_ip(other), do: inspect(other)\nend\n","numLines":194,"startLine":1,"totalLines":194}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WTb7yoY7X5Asp6MkcwZAdv","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n     6→  REPLY, and other DHCPv6 protocol messages. Handles client identification\n     7→  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv6.{LeaseManager, RateLimiter}\n    13→\n    14→  # DHCPv6 message type constants\n    15→  @msg_type_solicit 1\n    16→  @msg_type_advertise 2\n    17→  @msg_type_request 3\n    18→  # @msg_type_confirm 4\n    19→  @msg_type_renew 5\n    20→  @msg_type_rebind 6\n    21→  @msg_type_reply 7\n    22→  @msg_type_release 8\n    23→  @msg_type_decline 9\n    24→  # @msg_type_reconfigure 10\n    25→  @msg_type_information_request 11\n    26→  @msg_type_relay_forw 12\n    27→  @msg_type_relay_repl 13\n    28→\n    29→  # DHCPv6 option codes\n    30→  @option_client_id 1\n    31→  @option_server_id 2\n    32→  @option_ia_na 3\n    33→  @option_ia_ta 4\n    34→  @option_ia_addr 5\n    35→  # @option_oro 6\n    36→  @option_preference 7\n    37→  # @option_elapsed_time 8\n    38→  # @option_status_code 13\n    39→  # @option_rapid_commit 14\n    40→  @option_dns_servers 23\n    41→  @option_domain_list 24\n    42→  @option_ia_pd 25\n    43→  @option_ia_prefix 26\n    44→\n    45→  @doc \"\"\"\n    46→  Handles incoming DHCPv6 data from clients.\n    47→  \"\"\"\n    48→  @impl true\n    49→  def handle_data({client_ip, client_port, data}, state) do\n    50→    start_time = System.monotonic_time(:microsecond)\n    51→\n    52→    # Check rate limit before processing\n    53→    case RateLimiter.check_rate(client_ip) do\n    54→      :ok ->\n    55→        process_message(client_ip, client_port, data, state, start_time)\n    56→\n    57→      {:error, :rate_limited} ->\n    58→        :telemetry.execute(\n    59→          [:yellow_dog, :dhcpv6, :message, :rate_limited],\n    60→          %{count: 1},\n    61→          %{client_ip: client_ip, client_port: client_port}\n    62→        )\n    63→\n    64→        {:continue, state}\n    65→    end\n    66→  end\n    67→\n    68→  defp process_message(client_ip, client_port, data, state, start_time) do\n    69→    try do\n    70→      case DHCPv6.Message.from_iodata(data) do\n    71→        {:ok, message} ->\n    72→          :telemetry.execute(\n    73→            [:yellow_dog, :dhcpv6, :message, :received],\n    74→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    75→            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n    76→          )\n    77→\n    78→          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n    79→\n    80→        {:error, reason} ->\n    81→          :telemetry.execute(\n    82→            [:yellow_dog, :dhcpv6, :message, :parse_error],\n    83→            %{count: 1},\n    84→            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n    85→          )\n    86→\n    87→          {:continue, state}\n    88→      end\n    89→    rescue\n    90→      error ->\n    91→        :telemetry.execute(\n    92→          [:yellow_dog, :dhcpv6, :message, :error],\n    93→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    94→          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n    95→        )\n    96→\n    97→        {:continue, state}\n    98→    end\n    99→  end\n   100→\n   101→  @doc \"\"\"\n   102→  Handles handler errors (implements Abyss.Handler callback).\n   103→  \"\"\"\n   104→  @impl true\n   105→  def handle_error(error, state) do\n   106→    :telemetry.execute(\n   107→      [:yellow_dog, :dhcpv6, :handler, :error],\n   108→      %{count: 1},\n   109→      %{reason: inspect(error)}\n   110→    )\n   111→\n   112→    {:continue, state}\n   113→  end\n   114→\n   115→  @doc \"\"\"\n   116→  Handles handler timeouts (implements Abyss.Handler callback).\n   117→  \"\"\"\n   118→  @impl true\n   119→  def handle_timeout(state) do\n   120→    :telemetry.execute(\n   121→      [:yellow_dog, :dhcpv6, :handler, :timeout],\n   122→      %{count: 1},\n   123→      %{}\n   124→    )\n   125→\n   126→    {:continue, state}\n   127→  end\n   128→\n   129→  # Private functions for handling specific DHCPv6 message types\n   130→\n   131→  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n   132→    case message.msg_type do\n   133→      @msg_type_solicit ->\n   134→        handle_solicit(message, client_ip, client_port, state, start_time)\n   135→\n   136→      @msg_type_request ->\n   137→        handle_request(message, client_ip, client_port, state, start_time)\n   138→\n   139→      @msg_type_renew ->\n   140→        handle_renew(message, client_ip, client_port, state, start_time)\n   141→\n   142→      @msg_type_rebind ->\n   143→        handle_rebind(message, client_ip, client_port, state, start_time)\n   144→\n   145→      @msg_type_release ->\n   146→        handle_release(message, client_ip, client_port, state, start_time)\n   147→\n   148→      @msg_type_decline ->\n   149→        handle_decline(message, client_ip, client_port, state, start_time)\n   150→\n   151→      @msg_type_information_request ->\n   152→        handle_inform(message, client_ip, client_port, state, start_time)\n   153→\n   154→      @msg_type_relay_forw ->\n   155→        handle_relay_forward(message, client_ip, client_port, state)\n   156→\n   157→      @msg_type_relay_repl ->\n   158→        handle_relay_reply(message, client_ip, client_port, state)\n   159→\n   160→      _ ->\n   161→        :telemetry.execute(\n   162→          [:yellow_dog, :dhcpv6, :message, :unknown],\n   163→          %{count: 1},\n   164→          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n   165→        )\n   166→\n   167→        {:continue, state}\n   168→    end\n   169→  end\n   170→\n   171→  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n   172→    :telemetry.execute(\n   173→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   174→      %{count: 1},\n   175→      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n   176→    )\n   177→\n   178→    client_duid = get_client_duid(message)\n   179→    ia_na = get_ia_na(message)\n   180→    ia_ta = get_ia_ta(message)\n   181→    ia_pd = get_ia_pd(message)\n   182→\n   183→    # Check if any IA type is present\n   184→    case {client_duid, ia_na, ia_ta, ia_pd} do\n   185→      {nil, _, _, _} ->\n   186→        :telemetry.execute(\n   187→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   188→          %{count: 1},\n   189→          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n   190→        )\n   191→\n   192→        {:continue, state}\n   193→\n   194→      {_, nil, nil, nil} ->\n   195→        :telemetry.execute(\n   196→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   197→          %{count: 1},\n   198→          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n   199→        )\n   200→\n   201→        {:continue, state}\n   202→\n   203→      {duid, _, _, _} ->\n   204→        # Process each IA type\n   205→        leases = []\n   206→\n   207→        # Handle IA_NA if present\n   208→        leases =\n   209→          if ia_na do\n   210→            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n   211→              {:ok, lease} ->\n   212→                [lease | leases]\n   213→\n   214→              {:error, reason} ->\n   215→                :telemetry.execute(\n   216→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   217→                  %{count: 1},\n   218→                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n   219→                )\n   220→\n   221→                leases\n   222→            end\n   223→          else\n   224→            leases\n   225→          end\n   226→\n   227→        # Handle IA_TA if present\n   228→        leases =\n   229→          if ia_ta do\n   230→            case allocate_temporary_address(duid, ia_ta.iaid) do\n   231→              {:ok, ta_lease} ->\n   232→                [ta_lease | leases]\n   233→\n   234→              {:error, reason} ->\n   235→                :telemetry.execute(\n   236→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   237→                  %{count: 1},\n   238→                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n   239→                )\n   240→\n   241→                leases\n   242→            end\n   243→          else\n   244→            leases\n   245→          end\n   246→\n   247→        # Handle IA_PD if present\n   248→        leases =\n   249→          if ia_pd do\n   250→            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n   251→            [pd_lease | leases]\n   252→          else\n   253→            leases\n   254→          end\n   255→\n   256→        if length(leases) > 0 do\n   257→          advertise = create_advertise_multi(message, leases)\n   258→          send_dhcpv6_response(advertise, client_ip, client_port, state)\n   259→\n   260→          :telemetry.execute(\n   261→            [:yellow_dog, :dhcpv6, :solicit, :completed],\n   262→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   263→            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n   264→          )\n   265→        end\n   266→\n   267→        {:continue, state}\n   268→    end\n   269→  end\n   270→\n   271→  defp handle_request(message, client_ip, client_port, state, start_time) do\n   272→    :telemetry.execute(\n   273→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   274→      %{count: 1},\n   275→      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n   276→    )\n   277→\n   278→    client_duid = get_client_duid(message)\n   279→    ia_na = get_ia_na(message)\n   280→\n   281→    case {client_duid, ia_na} do\n   282→      {nil, _} ->\n   283→        :telemetry.execute(\n   284→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   285→          %{count: 1},\n   286→          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n   287→        )\n   288→\n   289→        {:continue, state}\n   290→\n   291→      {_, nil} ->\n   292→        :telemetry.execute(\n   293→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   294→          %{count: 1},\n   295→          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n   296→        )\n   297→\n   298→        {:continue, state}\n   299→\n   300→      {duid, %{iaid: iaid}} ->\n   301→        # Allocate or renew lease\n   302→        case LeaseManager.allocate_lease(duid, iaid) do\n   303→          {:ok, lease} ->\n   304→            reply = create_reply(message, lease)\n   305→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   306→\n   307→            :telemetry.execute(\n   308→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   309→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   310→              %{client_ip: client_ip, client_duid: duid}\n   311→            )\n   312→\n   313→          {:error, reason} ->\n   314→            :telemetry.execute(\n   315→              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   316→              %{count: 1},\n   317→              %{reason: inspect(reason), client_duid: duid}\n   318→            )\n   319→        end\n   320→\n   321→        {:continue, state}\n   322→    end\n   323→  end\n   324→\n   325→  defp handle_renew(message, client_ip, client_port, state, start_time) do\n   326→    :telemetry.execute(\n   327→      [:yellow_dog, :dhcpv6, :lease, :renewed],\n   328→      %{count: 1},\n   329→      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n   330→    )\n   331→\n   332→    client_duid = get_client_duid(message)\n   333→    ia_na = get_ia_na(message)\n   334→\n   335→    case {client_duid, ia_na} do\n   336→      {duid, %{iaid: iaid}} when duid != nil ->\n   337→        # Renew existing lease\n   338→        case LeaseManager.allocate_lease(duid, iaid) do\n   339→          {:ok, lease} ->\n   340→            reply = create_reply(message, lease)\n   341→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   342→\n   343→            :telemetry.execute(\n   344→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   345→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   346→              %{client_ip: client_ip, client_duid: duid}\n   347→            )\n   348→\n   349→          {:error, reason} ->\n   350→            :telemetry.execute(\n   351→              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n   352→              %{count: 1},\n   353→              %{reason: inspect(reason), client_duid: duid}\n   354→            )\n   355→        end\n   356→\n   357→        {:continue, state}\n   358→\n   359→      _ ->\n   360→        :telemetry.execute(\n   361→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   362→          %{count: 1},\n   363→          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n   364→        )\n   365→\n   366→        {:continue, state}\n   367→    end\n   368→  end\n   369→\n   370→  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n   371→    :telemetry.execute(\n   372→      [:yellow_dog, :dhcpv6, :lease, :rebind],\n   373→      %{count: 1},\n   374→      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n   375→    )\n   376→\n   377→    # Rebind is similar to renew - reuse the renew logic\n   378→    client_duid = get_client_duid(message)\n   379→    ia_na = get_ia_na(message)\n   380→\n   381→    case {client_duid, ia_na} do\n   382→      {duid, %{iaid: iaid}} when duid != nil ->\n   383→        case LeaseManager.allocate_lease(duid, iaid) do\n   384→          {:ok, lease} ->\n   385→            reply = create_reply(message, lease)\n   386→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   387→\n   388→            :telemetry.execute(\n   389→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   390→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   391→              %{client_ip: client_ip, client_duid: duid}\n   392→            )\n   393→\n   394→          {:error, reason} ->\n   395→            :telemetry.execute(\n   396→              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n   397→              %{count: 1},\n   398→              %{reason: inspect(reason), client_duid: duid}\n   399→            )\n   400→        end\n   401→\n   402→        {:continue, state}\n   403→\n   404→      _ ->\n   405→        :telemetry.execute(\n   406→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   407→          %{count: 1},\n   408→          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n   409→        )\n   410→\n   411→        {:continue, state}\n   412→    end\n   413→  end\n   414→\n   415→  defp handle_release(message, client_ip, client_port, state, start_time) do\n   416→    :telemetry.execute(\n   417→      [:yellow_dog, :dhcpv6, :lease, :released],\n   418→      %{count: 1},\n   419→      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n   420→    )\n   421→\n   422→    client_duid = get_client_duid(message)\n   423→    ia_na = get_ia_na(message)\n   424→\n   425→    case {client_duid, ia_na} do\n   426→      {duid, %{iaid: iaid}} when duid != nil ->\n   427→        LeaseManager.release_lease(duid, iaid)\n   428→\n   429→        :telemetry.execute(\n   430→          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n   431→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   432→          %{client_ip: client_ip, client_duid: duid}\n   433→        )\n   434→\n   435→      _ ->\n   436→        :telemetry.execute(\n   437→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   438→          %{count: 1},\n   439→          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n   440→        )\n   441→    end\n   442→\n   443→    {:continue, state}\n   444→  end\n   445→\n   446→  defp handle_decline(message, client_ip, client_port, state, start_time) do\n   447→    :telemetry.execute(\n   448→      [:yellow_dog, :dhcpv6, :lease, :declined],\n   449→      %{count: 1},\n   450→      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n   451→    )\n   452→\n   453→    client_duid = get_client_duid(message)\n   454→    ia_na = get_ia_na(message)\n   455→\n   456→    case {client_duid, ia_na} do\n   457→      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n   458→        LeaseManager.decline_ip(ia_addr, duid)\n   459→\n   460→        :telemetry.execute(\n   461→          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n   462→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   463→          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n   464→        )\n   465→\n   466→      _ ->\n   467→        :telemetry.execute(\n   468→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   469→          %{count: 1},\n   470→          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n   471→        )\n   472→    end\n   473→\n   474→    {:continue, state}\n   475→  end\n   476→\n   477→  defp handle_inform(message, client_ip, client_port, state, start_time) do\n   478→    :telemetry.execute(\n   479→      [:yellow_dog, :dhcpv6, :inform, :requested],\n   480→      %{count: 1},\n   481→      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n   482→    )\n   483→\n   484→    # INFORMATION-REQUEST - provide configuration without address allocation\n   485→    reply = create_information_reply(message)\n   486→    send_dhcpv6_response(reply, client_ip, client_port, state)\n   487→\n   488→    :telemetry.execute(\n   489→      [:yellow_dog, :dhcpv6, :inform, :completed],\n   490→      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   491→      %{client_ip: client_ip}\n   492→    )\n   493→\n   494→    {:continue, state}\n   495→  end\n   496→\n   497→  defp handle_relay_forward(_message, client_ip, client_port, state) do\n   498→    :telemetry.execute(\n   499→      [:yellow_dog, :dhcpv6, :relay, :forward],\n   500→      %{count: 1},\n   501→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   502→    )\n   503→\n   504→    {:continue, state}\n   505→  end\n   506→\n   507→  defp handle_relay_reply(_message, client_ip, client_port, state) do\n   508→    :telemetry.execute(\n   509→      [:yellow_dog, :dhcpv6, :relay, :reply],\n   510→      %{count: 1},\n   511→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   512→    )\n   513→\n   514→    {:continue, state}\n   515→  end\n   516→\n   517→  # Message creation functions\n   518→\n   519→  defp create_reply(request, lease) do\n   520→    pool = get_pool_for_lease(lease)\n   521→\n   522→    %DHCPv6.Message{\n   523→      msg_type: @msg_type_reply,\n   524→      transaction_id: request.transaction_id,\n   525→      options:\n   526→        [\n   527→          # Server DUID\n   528→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   529→          # Client DUID (echo back)\n   530→          %DHCPv6.Message.Option{\n   531→            option_code: @option_client_id,\n   532→            option_data: get_client_duid(request)\n   533→          },\n   534→          # IA_NA with IA_ADDR\n   535→          create_ia_na_option(lease),\n   536→          # DNS servers\n   537→          create_dns_servers_option(pool.dns_servers)\n   538→        ]\n   539→        |> add_domain_list_option(pool.domain_name)\n   540→    }\n   541→  end\n   542→\n   543→  defp create_information_reply(request) do\n   544→    pool = get_default_pool()\n   545→\n   546→    %DHCPv6.Message{\n   547→      msg_type: @msg_type_reply,\n   548→      transaction_id: request.transaction_id,\n   549→      options:\n   550→        [\n   551→          # Server DUID\n   552→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   553→          # Client DUID (echo back)\n   554→          %DHCPv6.Message.Option{\n   555→            option_code: @option_client_id,\n   556→            option_data: get_client_duid(request)\n   557→          },\n   558→          # DNS servers\n   559→          create_dns_servers_option(pool.dns_servers)\n   560→        ]\n   561→        |> add_domain_list_option(pool.domain_name)\n   562→    }\n   563→  end\n   564→\n   565→  # Helper functions for creating options\n   566→\n   567→  defp create_ia_na_option(lease) do\n   568→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   569→    ia_addr_data =\n   570→      ipv6_to_binary(lease.ip) <>\n   571→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   572→\n   573→    ia_addr_option = %DHCPv6.Message.Option{\n   574→      option_code: @option_ia_addr,\n   575→      option_data: ia_addr_data\n   576→    }\n   577→\n   578→    # IA_NA option (option 3) - contains IA_ADDR\n   579→    # IAID + T1 + T2 (0 = server decides)\n   580→    ia_na_data =\n   581→      <<lease.iaid::32, 0::32, 0::32>> <>\n   582→        DHCP.Parameter.to_iodata(ia_addr_option)\n   583→\n   584→    %DHCPv6.Message.Option{\n   585→      option_code: @option_ia_na,\n   586→      option_data: ia_na_data\n   587→    }\n   588→  end\n   589→\n   590→  defp create_dns_servers_option(dns_servers) do\n   591→    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n   592→\n   593→    %DHCPv6.Message.Option{\n   594→      option_code: @option_dns_servers,\n   595→      option_data: dns_data\n   596→    }\n   597→  end\n   598→\n   599→  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n   600→\n   601→  defp add_domain_list_option(options, domain) do\n   602→    # Encode domain name in DNS format (length-prefixed labels)\n   603→    domain_data = encode_domain_name(domain)\n   604→\n   605→    domain_option = %DHCPv6.Message.Option{\n   606→      option_code: @option_domain_list,\n   607→      option_data: domain_data\n   608→    }\n   609→\n   610→    options ++ [domain_option]\n   611→  end\n   612→\n   613→  defp encode_domain_name(domain) do\n   614→    # RFC 1035: Each label is limited to 63 octets\n   615→    domain\n   616→    |> String.split(\".\")\n   617→    |> Enum.map_join(fn label ->\n   618→      # Enforce max label length per DNS specification\n   619→      truncated_label =\n   620→        if byte_size(label) > 63 do\n   621→          :telemetry.execute(\n   622→            [:yellow_dog, :dhcpv6, :config, :warning],\n   623→            %{count: 1},\n   624→            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n   625→          )\n   626→\n   627→          binary_part(label, 0, 63)\n   628→        else\n   629→          label\n   630→        end\n   631→\n   632→      <<byte_size(truncated_label)::8, truncated_label::binary>>\n   633→    end)\n   634→    # Terminating zero\n   635→    |> Kernel.<>(<<0>>)\n   636→  end\n   637→\n   638→  # Helper functions for extracting information from messages\n   639→\n   640→  defp get_client_duid(message) do\n   641→    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n   642→      nil -> nil\n   643→      option -> option.option_data\n   644→    end\n   645→  end\n   646→\n   647→  defp get_ia_na(message) do\n   648→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n   649→      nil ->\n   650→        nil\n   651→\n   652→      option ->\n   653→        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   654→        case option.option_data do\n   655→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   656→            # Try to extract IA_ADDR if present\n   657→            ia_addr = extract_ia_addr(rest)\n   658→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n   659→\n   660→          _ ->\n   661→            nil\n   662→        end\n   663→    end\n   664→  end\n   665→\n   666→  defp get_ia_ta(message) do\n   667→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n   668→      nil ->\n   669→        nil\n   670→\n   671→      option ->\n   672→        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n   673→        case option.option_data do\n   674→          <<iaid::32, rest::binary>> ->\n   675→            ia_addr = extract_ia_addr(rest)\n   676→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n   677→\n   678→          _ ->\n   679→            nil\n   680→        end\n   681→    end\n   682→  end\n   683→\n   684→  defp get_ia_pd(message) do\n   685→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n   686→      nil ->\n   687→        nil\n   688→\n   689→      option ->\n   690→        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   691→        case option.option_data do\n   692→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   693→            ia_prefix = extract_ia_prefix(rest)\n   694→            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n   695→\n   696→          _ ->\n   697→            nil\n   698→        end\n   699→    end\n   700→  end\n   701→\n   702→  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n   703→    case data do\n   704→      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n   705→        {a, b, c, d, e, f, g, h}\n   706→\n   707→      _ ->\n   708→        nil\n   709→    end\n   710→  end\n   711→\n   712→  defp extract_ia_addr(_), do: nil\n   713→\n   714→  defp extract_ia_prefix(\n   715→         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n   716→       ) do\n   717→    case data do\n   718→      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n   719→        g::16, h::16>> ->\n   720→        {{a, b, c, d, e, f, g, h}, prefix_len}\n   721→\n   722→      _ ->\n   723→        nil\n   724→    end\n   725→  end\n   726→\n   727→  defp extract_ia_prefix(_), do: nil\n   728→\n   729→  # Allocation helper functions\n   730→\n   731→  defp allocate_temporary_address(duid, iaid) do\n   732→    # Temporary addresses use a separate pool with shorter lifetimes\n   733→    # For now, delegate to LeaseManager with IA_TA type marker\n   734→    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n   735→      {:ok, lease} ->\n   736→        # Mark as temporary address with shorter lifetime\n   737→        ta_lease = %{\n   738→          lease\n   739→          | ia_type: :ia_ta,\n   740→            preferred_lifetime: 600,\n   741→            # 10 minutes\n   742→            valid_lifetime: 1200\n   743→            # 20 minutes\n   744→        }\n   745→\n   746→        {:ok, ta_lease}\n   747→\n   748→      error ->\n   749→        error\n   750→    end\n   751→  end\n   752→\n   753→  defp allocate_prefix_delegation(duid, iaid) do\n   754→    # For now, return a placeholder\n   755→    # Full implementation would use PrefixPool module\n   756→    :telemetry.execute(\n   757→      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n   758→      %{count: 1},\n   759→      %{client_duid: duid, iaid: iaid}\n   760→    )\n   761→\n   762→    # TODO: Integrate with PrefixPool module\n   763→    # Example placeholder prefix: 2001:db8:1000::/56\n   764→    {:ok,\n   765→     %{\n   766→       duid: duid,\n   767→       iaid: iaid,\n   768→       ia_type: :ia_pd,\n   769→       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n   770→       preferred_lifetime: 3600,\n   771→       valid_lifetime: 7200,\n   772→       pool_name: \"default-pd\"\n   773→     }}\n   774→  end\n   775→\n   776→  # Message creation functions with multi-IA support\n   777→\n   778→  defp create_advertise_multi(solicit, leases) do\n   779→    pool = get_default_pool()\n   780→\n   781→    options = [\n   782→      # Server DUID\n   783→      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   784→      # Client DUID (echo back)\n   785→      %DHCPv6.Message.Option{\n   786→        option_code: @option_client_id,\n   787→        option_data: get_client_duid(solicit)\n   788→      },\n   789→      # Preference\n   790→      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n   791→    ]\n   792→\n   793→    # Add IA options for each lease\n   794→    ia_options =\n   795→      Enum.flat_map(leases, fn lease ->\n   796→        case lease.ia_type do\n   797→          :ia_na -> [create_ia_na_option(lease)]\n   798→          :ia_ta -> [create_ia_ta_option(lease)]\n   799→          :ia_pd -> [create_ia_pd_option(lease)]\n   800→          _ -> []\n   801→        end\n   802→      end)\n   803→\n   804→    # Add configuration options (DNS, etc.)\n   805→    config_options =\n   806→      [\n   807→        create_dns_servers_option(pool.dns_servers)\n   808→      ] ++ add_domain_list_option([], pool.domain_name)\n   809→\n   810→    %DHCPv6.Message{\n   811→      msg_type: @msg_type_advertise,\n   812→      transaction_id: solicit.transaction_id,\n   813→      options: options ++ ia_options ++ config_options\n   814→    }\n   815→  end\n   816→\n   817→  defp create_ia_ta_option(lease) do\n   818→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   819→    ia_addr_data =\n   820→      ipv6_to_binary(lease.ip) <>\n   821→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   822→\n   823→    ia_addr_option = %DHCPv6.Message.Option{\n   824→      option_code: @option_ia_addr,\n   825→      option_data: ia_addr_data\n   826→    }\n   827→\n   828→    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n   829→    ia_ta_data =\n   830→      <<lease.iaid::32>> <>\n   831→        DHCP.Parameter.to_iodata(ia_addr_option)\n   832→\n   833→    %DHCPv6.Message.Option{\n   834→      option_code: @option_ia_ta,\n   835→      option_data: ia_ta_data\n   836→    }\n   837→  end\n   838→\n   839→  defp create_ia_pd_option(lease) do\n   840→    {prefix_addr, prefix_len} = lease.delegated_prefix\n   841→\n   842→    # IA_PREFIX option (option 26)\n   843→    ia_prefix_data =\n   844→      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n   845→        ipv6_to_binary(prefix_addr)\n   846→\n   847→    ia_prefix_option = %DHCPv6.Message.Option{\n   848→      option_code: @option_ia_prefix,\n   849→      option_data: ia_prefix_data\n   850→    }\n   851→\n   852→    # IA_PD option (option 25)\n   853→    ia_pd_data =\n   854→      <<lease.iaid::32, 0::32, 0::32>> <>\n   855→        DHCP.Parameter.to_iodata(ia_prefix_option)\n   856→\n   857→    %DHCPv6.Message.Option{\n   858→      option_code: @option_ia_pd,\n   859→      option_data: ia_pd_data\n   860→    }\n   861→  end\n   862→\n   863→  defp get_server_duid do\n   864→    # Generate a simple DUID-LL (Link-Layer) based on server\n   865→    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n   866→    # Using a static server identifier for now\n   867→    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n   868→  end\n   869→\n   870→  defp get_pool_for_lease(_lease) do\n   871→    # For now, use default pool\n   872→    # In production, look up pool by lease.pool_name\n   873→    get_default_pool()\n   874→  end\n   875→\n   876→  defp get_default_pool do\n   877→    %{\n   878→      name: \"default\",\n   879→      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   880→      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n   881→      prefix_length: 64,\n   882→      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n   883→      domain_name: \"local\",\n   884→      preferred_lifetime: 3600,\n   885→      valid_lifetime: 7200\n   886→    }\n   887→  end\n   888→\n   889→  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n   890→    data = DHCP.Parameter.to_iodata(response)\n   891→\n   892→    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n   893→      :ok ->\n   894→        :telemetry.execute(\n   895→          [:yellow_dog, :dhcpv6, :response, :sent],\n   896→          %{count: 1},\n   897→          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n   898→        )\n   899→\n   900→      {:error, reason} ->\n   901→        :telemetry.execute(\n   902→          [:yellow_dog, :dhcpv6, :response, :send_failed],\n   903→          %{count: 1},\n   904→          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n   905→        )\n   906→    end\n   907→  end\n   908→\n   909→  # Utility functions\n   910→\n   911→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   912→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   913→  end\n   914→end\n   915→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"3efca259-326c-4832-b0e2-f3f1da835550","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/handler.ex","content":"defmodule YellowDog.Dhcpv6.Handler do\n  @moduledoc \"\"\"\n  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n\n  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n  REPLY, and other DHCPv6 protocol messages. Handles client identification\n  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv6.{LeaseManager, RateLimiter}\n\n  # DHCPv6 message type constants\n  @msg_type_solicit 1\n  @msg_type_advertise 2\n  @msg_type_request 3\n  # @msg_type_confirm 4\n  @msg_type_renew 5\n  @msg_type_rebind 6\n  @msg_type_reply 7\n  @msg_type_release 8\n  @msg_type_decline 9\n  # @msg_type_reconfigure 10\n  @msg_type_information_request 11\n  @msg_type_relay_forw 12\n  @msg_type_relay_repl 13\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  # @option_oro 6\n  @option_preference 7\n  # @option_elapsed_time 8\n  # @option_status_code 13\n  # @option_rapid_commit 14\n  @option_dns_servers 23\n  @option_domain_list 24\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @doc \"\"\"\n  Handles incoming DHCPv6 data from clients.\n  \"\"\"\n  @impl true\n  def handle_data({client_ip, client_port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    # Check rate limit before processing\n    case RateLimiter.check_rate(client_ip) do\n      :ok ->\n        process_message(client_ip, client_port, data, state, start_time)\n\n      {:error, :rate_limited} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :rate_limited],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp process_message(client_ip, client_port, data, state, start_time) do\n    try do\n      case DHCPv6.Message.from_iodata(data) do\n        {:ok, message} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :received],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n          )\n\n          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :parse_error],\n            %{count: 1},\n            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n          )\n\n          {:continue, state}\n      end\n    rescue\n      error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :error],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @doc \"\"\"\n  Handles handler errors (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles handler timeouts (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions for handling specific DHCPv6 message types\n\n  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n    case message.msg_type do\n      @msg_type_solicit ->\n        handle_solicit(message, client_ip, client_port, state, start_time)\n\n      @msg_type_request ->\n        handle_request(message, client_ip, client_port, state, start_time)\n\n      @msg_type_renew ->\n        handle_renew(message, client_ip, client_port, state, start_time)\n\n      @msg_type_rebind ->\n        handle_rebind(message, client_ip, client_port, state, start_time)\n\n      @msg_type_release ->\n        handle_release(message, client_ip, client_port, state, start_time)\n\n      @msg_type_decline ->\n        handle_decline(message, client_ip, client_port, state, start_time)\n\n      @msg_type_information_request ->\n        handle_inform(message, client_ip, client_port, state, start_time)\n\n      @msg_type_relay_forw ->\n        handle_relay_forward(message, client_ip, client_port, state)\n\n      @msg_type_relay_repl ->\n        handle_relay_reply(message, client_ip, client_port, state)\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :unknown],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n    ia_ta = get_ia_ta(message)\n    ia_pd = get_ia_pd(message)\n\n    # Check if any IA type is present\n    case {client_duid, ia_na, ia_ta, ia_pd} do\n      {nil, _, _, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil, nil, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, _, _, _} ->\n        # Process each IA type\n        leases = []\n\n        # Handle IA_NA if present\n        leases =\n          if ia_na do\n            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n              {:ok, lease} ->\n                [lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_TA if present\n        leases =\n          if ia_ta do\n            case allocate_temporary_address(duid, ia_ta.iaid) do\n              {:ok, ta_lease} ->\n                [ta_lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_PD if present\n        leases =\n          if ia_pd do\n            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n            [pd_lease | leases]\n          else\n            leases\n          end\n\n        if length(leases) > 0 do\n          advertise = create_advertise_multi(message, leases)\n          send_dhcpv6_response(advertise, client_ip, client_port, state)\n\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :solicit, :completed],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n          )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_request(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {nil, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, %{iaid: iaid}} ->\n        # Allocate or renew lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_renew(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :renewed],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        # Renew existing lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :rebind],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n    )\n\n    # Rebind is similar to renew - reuse the renew logic\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_release(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :released],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        LeaseManager.release_lease(duid, iaid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_decline(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :declined],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n        LeaseManager.decline_ip(ia_addr, duid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_inform(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n    )\n\n    # INFORMATION-REQUEST - provide configuration without address allocation\n    reply = create_information_reply(message)\n    send_dhcpv6_response(reply, client_ip, client_port, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :completed],\n      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_forward(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :forward],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_reply(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :reply],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  # Message creation functions\n\n  defp create_reply(request, lease) do\n    pool = get_pool_for_lease(lease)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # IA_NA with IA_ADDR\n          create_ia_na_option(lease),\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  defp create_information_reply(request) do\n    pool = get_default_pool()\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  # Helper functions for creating options\n\n  defp create_ia_na_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_NA option (option 3) - contains IA_ADDR\n    # IAID + T1 + T2 (0 = server decides)\n    ia_na_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_na,\n      option_data: ia_na_data\n    }\n  end\n\n  defp create_dns_servers_option(dns_servers) do\n    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_dns_servers,\n      option_data: dns_data\n    }\n  end\n\n  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n\n  defp add_domain_list_option(options, domain) do\n    # Encode domain name in DNS format (length-prefixed labels)\n    domain_data = encode_domain_name(domain)\n\n    domain_option = %DHCPv6.Message.Option{\n      option_code: @option_domain_list,\n      option_data: domain_data\n    }\n\n    options ++ [domain_option]\n  end\n\n  defp encode_domain_name(domain) do\n    # RFC 1035: Each label is limited to 63 octets\n    domain\n    |> String.split(\".\")\n    |> Enum.map_join(fn label ->\n      # Enforce max label length per DNS specification\n      truncated_label =\n        if byte_size(label) > 63 do\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :config, :warning],\n            %{count: 1},\n            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n          )\n\n          binary_part(label, 0, 63)\n        else\n          label\n        end\n\n      <<byte_size(truncated_label)::8, truncated_label::binary>>\n    end)\n    # Terminating zero\n    |> Kernel.<>(<<0>>)\n  end\n\n  # Helper functions for extracting information from messages\n\n  defp get_client_duid(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n      nil -> nil\n      option -> option.option_data\n    end\n  end\n\n  defp get_ia_na(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            # Try to extract IA_ADDR if present\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_ta(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n        case option.option_data do\n          <<iaid::32, rest::binary>> ->\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_pd(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            ia_prefix = extract_ia_prefix(rest)\n            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\n\n  # Allocation helper functions\n\n  defp allocate_temporary_address(duid, iaid) do\n    # Temporary addresses use a separate pool with shorter lifetimes\n    # For now, delegate to LeaseManager with IA_TA type marker\n    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n      {:ok, lease} ->\n        # Mark as temporary address with shorter lifetime\n        ta_lease = %{\n          lease\n          | ia_type: :ia_ta,\n            preferred_lifetime: 600,\n            # 10 minutes\n            valid_lifetime: 1200\n            # 20 minutes\n        }\n\n        {:ok, ta_lease}\n\n      error ->\n        error\n    end\n  end\n\n  defp allocate_prefix_delegation(duid, iaid) do\n    # For now, return a placeholder\n    # Full implementation would use PrefixPool module\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n      %{count: 1},\n      %{client_duid: duid, iaid: iaid}\n    )\n\n    # TODO: Integrate with PrefixPool module\n    # Example placeholder prefix: 2001:db8:1000::/56\n    {:ok,\n     %{\n       duid: duid,\n       iaid: iaid,\n       ia_type: :ia_pd,\n       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n       preferred_lifetime: 3600,\n       valid_lifetime: 7200,\n       pool_name: \"default-pd\"\n     }}\n  end\n\n  # Message creation functions with multi-IA support\n\n  defp create_advertise_multi(solicit, leases) do\n    pool = get_default_pool()\n\n    options = [\n      # Server DUID\n      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n      # Client DUID (echo back)\n      %DHCPv6.Message.Option{\n        option_code: @option_client_id,\n        option_data: get_client_duid(solicit)\n      },\n      # Preference\n      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n    ]\n\n    # Add IA options for each lease\n    ia_options =\n      Enum.flat_map(leases, fn lease ->\n        case lease.ia_type do\n          :ia_na -> [create_ia_na_option(lease)]\n          :ia_ta -> [create_ia_ta_option(lease)]\n          :ia_pd -> [create_ia_pd_option(lease)]\n          _ -> []\n        end\n      end)\n\n    # Add configuration options (DNS, etc.)\n    config_options =\n      [\n        create_dns_servers_option(pool.dns_servers)\n      ] ++ add_domain_list_option([], pool.domain_name)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_advertise,\n      transaction_id: solicit.transaction_id,\n      options: options ++ ia_options ++ config_options\n    }\n  end\n\n  defp create_ia_ta_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n    ia_ta_data =\n      <<lease.iaid::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_ta,\n      option_data: ia_ta_data\n    }\n  end\n\n  defp create_ia_pd_option(lease) do\n    {prefix_addr, prefix_len} = lease.delegated_prefix\n\n    # IA_PREFIX option (option 26)\n    ia_prefix_data =\n      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n        ipv6_to_binary(prefix_addr)\n\n    ia_prefix_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_prefix,\n      option_data: ia_prefix_data\n    }\n\n    # IA_PD option (option 25)\n    ia_pd_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_prefix_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_pd,\n      option_data: ia_pd_data\n    }\n  end\n\n  defp get_server_duid do\n    # Generate a simple DUID-LL (Link-Layer) based on server\n    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n    # Using a static server identifier for now\n    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use default pool\n    # In production, look up pool by lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    %{\n      name: \"default\",\n      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n      prefix_length: 64,\n      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n      domain_name: \"local\",\n      preferred_lifetime: 3600,\n      valid_lifetime: 7200\n    }\n  end\n\n  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :sent],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :send_failed],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Utility functions\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\nend\n","numLines":915,"startLine":1,"totalLines":915}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7ZjUZc9E9h7HjKNvr55Sk","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv4 message handler using the Abyss.Handler behaviour.\n     4→\n     5→  Processes incoming DHCPv4 messages and implements the DHCP server logic\n     6→  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n     7→  messages. Emits telemetry events for monitoring and debugging.\n     8→\n     9→  Includes rate limiting to prevent pool exhaustion and DoS attacks.\n    10→  \"\"\"\n    11→\n    12→  use Abyss.Handler\n    13→\n    14→  alias YellowDog.Dhcpv4.{ACL, ConflictResolver, CustomOptions, LeaseManager, RateLimiter}\n    15→\n    16→  # Telemetry events are handled via :telemetry directly\n    17→\n    18→  @doc \"\"\"\n    19→  Handles incoming DHCPv4 messages from clients.\n    20→\n    21→  ## Parameters\n    22→  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n    23→  - `state`: Handler state containing socket information\n    24→\n    25→  ## Returns\n    26→  - `{:continue, state}` - Continue handling more packets\n    27→  - `{:close, state}` - Close connection after response\n    28→  \"\"\"\n    29→  @impl true\n    30→  def handle_data({ip, port, data}, state) do\n    31→    start_time = System.monotonic_time(:microsecond)\n    32→\n    33→    # Apply rate limiting to prevent DoS and pool exhaustion attacks\n    34→    case RateLimiter.check_rate(ip) do\n    35→      :ok ->\n    36→        process_message(ip, port, data, state, start_time)\n    37→\n    38→      {:error, :rate_limited} ->\n    39→        :telemetry.execute(\n    40→          [:yellow_dog, :dhcpv4, :message, :rate_limited],\n    41→          %{count: 1},\n    42→          %{client_ip: ip, client_port: port}\n    43→        )\n    44→\n    45→        {:continue, state}\n    46→    end\n    47→  end\n    48→\n    49→  defp process_message(ip, port, data, state, start_time) do\n    50→    try do\n    51→      message = DHCPv4.Message.from_iodata(data)\n    52→\n    53→      # Emit telemetry event for message received\n    54→      :telemetry.execute(\n    55→        [:yellow_dog, :dhcpv4, :message_received],\n    56→        %{duration: System.monotonic_time(:microsecond) - start_time},\n    57→        %{client_ip: ip, client_port: port, message_type: message.op}\n    58→      )\n    59→\n    60→      # Process the DHCP message\n    61→      handle_dhcp_message(message, ip, port, state, start_time)\n    62→    rescue\n    63→      e ->\n    64→        # Emit telemetry event for error\n    65→        :telemetry.execute(\n    66→          [:yellow_dog, :dhcpv4, :message, :error],\n    67→          %{duration: System.monotonic_time(:microsecond) - start_time},\n    68→          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n    69→        )\n    70→\n    71→        {:continue, state}\n    72→    end\n    73→  end\n    74→\n    75→  @impl true\n    76→  def handle_error(reason, state) do\n    77→    :telemetry.execute(\n    78→      [:yellow_dog, :dhcpv4, :handler, :error],\n    79→      %{count: 1},\n    80→      %{reason: inspect(reason)}\n    81→    )\n    82→\n    83→    {:continue, state}\n    84→  end\n    85→\n    86→  @impl true\n    87→  def handle_timeout(state) do\n    88→    :telemetry.execute(\n    89→      [:yellow_dog, :dhcpv4, :handler, :timeout],\n    90→      %{count: 1},\n    91→      %{}\n    92→    )\n    93→\n    94→    {:continue, state}\n    95→  end\n    96→\n    97→  # Private helper functions\n    98→\n    99→  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n   100→    case message.op do\n   101→      # BOOTREQUEST\n   102→      1 ->\n   103→        handle_boot_request(message, client_ip, client_port, state, start_time)\n   104→\n   105→      # BOOTREPLY\n   106→      2 ->\n   107→        :telemetry.execute(\n   108→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n   109→          %{count: 1},\n   110→          %{message_type: :bootreply, reason: \"should not happen on server\"}\n   111→        )\n   112→\n   113→        {:continue, state}\n   114→\n   115→      op ->\n   116→        :telemetry.execute(\n   117→          [:yellow_dog, :dhcpv4, :message, :unknown],\n   118→          %{count: 1},\n   119→          %{operation: op}\n   120→        )\n   121→\n   122→        {:continue, state}\n   123→    end\n   124→  end\n   125→\n   126→  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n   127→    case get_dhcp_message_type(message) do\n   128→      :discover ->\n   129→        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n   130→\n   131→      :request ->\n   132→        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n   133→\n   134→      :decline ->\n   135→        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n   136→\n   137→      :release ->\n   138→        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n   139→\n   140→      :inform ->\n   141→        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n   142→\n   143→      msg_type when msg_type in [:offer, :ack, :nak] ->\n   144→        :telemetry.execute(\n   145→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n   146→          %{count: 1},\n   147→          %{message_type: msg_type, reason: \"should not happen on server\"}\n   148→        )\n   149→\n   150→        {:continue, state}\n   151→\n   152→      _ ->\n   153→        :telemetry.execute(\n   154→          [:yellow_dog, :dhcpv4, :message, :unsupported],\n   155→          %{count: 1},\n   156→          %{reason: \"missing or unsupported message type option\"}\n   157→        )\n   158→\n   159→        {:continue, state}\n   160→    end\n   161→  end\n   162→\n   163→  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n   164→    :telemetry.execute(\n   165→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   166→      %{count: 1},\n   167→      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n   168→    )\n   169→\n   170→    # Build client info for ACL evaluation\n   171→    client_info = build_client_info(message)\n   172→\n   173→    # Evaluate ACL rules (FR3)\n   174→    acl_rules = get_acl_rules()\n   175→    acl_result = ACL.evaluate(acl_rules, client_info)\n   176→\n   177→    case acl_result do\n   178→      {:deny, reason} ->\n   179→        :telemetry.execute(\n   180→          [:yellow_dog, :dhcpv4, :acl, :denied],\n   181→          %{count: 1},\n   182→          %{client_mac: message.chaddr, reason: reason}\n   183→        )\n   184→\n   185→        # Don't send a response - silently ignore denied clients\n   186→        :ok\n   187→\n   188→      {:allow, target_pool} ->\n   189→        # Determine pool name from ACL or default\n   190→        pool_name = target_pool || \"default\"\n   191→\n   192→        # Generate a DHCPOFFER response (no custom option set for allow action)\n   193→        case create_dhcp_offer(message, pool_name, nil) do\n   194→          nil ->\n   195→            :telemetry.execute(\n   196→              [:yellow_dog, :dhcpv4, :offer, :failed],\n   197→              %{count: 1},\n   198→              %{client_mac: message.chaddr, reason: \"could not create offer\"}\n   199→            )\n   200→\n   201→          offer ->\n   202→            send_dhcp_response(offer, client_ip, client_port, state)\n   203→        end\n   204→\n   205→      {:custom_options, option_set_name} ->\n   206→        # Apply custom options and allow the request\n   207→        case create_dhcp_offer(message, \"default\", option_set_name) do\n   208→          nil ->\n   209→            :telemetry.execute(\n   210→              [:yellow_dog, :dhcpv4, :offer, :failed],\n   211→              %{count: 1},\n   212→              %{client_mac: message.chaddr, reason: \"could not create offer with custom options\"}\n   213→            )\n   214→\n   215→          offer ->\n   216→            send_dhcp_response(offer, client_ip, client_port, state)\n   217→        end\n   218→    end\n   219→\n   220→    # Emit telemetry event\n   221→    :telemetry.execute(\n   222→      [:yellow_dog, :dhcpv4, :discover_handled],\n   223→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   224→      %{client_ip: client_ip, client_mac: message.chaddr}\n   225→    )\n   226→\n   227→    {:continue, state}\n   228→  end\n   229→\n   230→  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n   231→    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n   232→    request_state = determine_request_state(message)\n   233→\n   234→    :telemetry.execute(\n   235→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   236→      %{count: 1},\n   237→      %{\n   238→        client_ip: client_ip,\n   239→        client_mac: message.chaddr,\n   240→        message_type: :request,\n   241→        state: request_state\n   242→      }\n   243→    )\n   244→\n   245→    # Generate a DHCPACK or DHCPNAK response based on state\n   246→    case create_dhcp_ack(message, client_ip, request_state) do\n   247→      {:ok, ack} ->\n   248→        send_dhcp_response(ack, client_ip, client_port, state)\n   249→\n   250→        :telemetry.execute(\n   251→          [:yellow_dog, :dhcpv4, :lease, :granted],\n   252→          %{duration: System.monotonic_time(:microsecond) - start_time},\n   253→          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n   254→        )\n   255→\n   256→      {:nak, reason} ->\n   257→        :telemetry.execute(\n   258→          [:yellow_dog, :dhcpv4, :lease, :rejected],\n   259→          %{count: 1},\n   260→          %{client_mac: message.chaddr, reason: reason, state: request_state}\n   261→        )\n   262→\n   263→        nak = build_dhcp_nak(message, reason)\n   264→        send_dhcp_response(nak, client_ip, client_port, state)\n   265→    end\n   266→\n   267→    {:continue, state}\n   268→  end\n   269→\n   270→  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n   271→    # Get the declined IP address\n   272→    declined_ip = get_requested_ip(message) || client_ip\n   273→\n   274→    :telemetry.execute(\n   275→      [:yellow_dog, :dhcpv4, :lease, :declined],\n   276→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   277→      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n   278→    )\n   279→\n   280→    # Use ConflictResolver for conflict detection and auto-reassignment (FR2.4)\n   281→    # ConflictResolver will:\n   282→    # 1. Quarantine the declined IP\n   283→    # 2. Attempt to allocate a new address for the client\n   284→    # 3. Log the conflict with client details\n   285→    case ConflictResolver.handle_conflict(declined_ip, message.chaddr, \"default\") do\n   286→      {:ok, new_ip} ->\n   287→        :telemetry.execute(\n   288→          [:yellow_dog, :dhcpv4, :conflict, :reassigned],\n   289→          %{count: 1},\n   290→          %{\n   291→            client_mac: message.chaddr,\n   292→            declined_ip: declined_ip,\n   293→            new_ip: new_ip\n   294→          }\n   295→        )\n   296→\n   297→      {:error, reason} ->\n   298→        :telemetry.execute(\n   299→          [:yellow_dog, :dhcpv4, :conflict, :reassignment_failed],\n   300→          %{count: 1},\n   301→          %{\n   302→            client_mac: message.chaddr,\n   303→            declined_ip: declined_ip,\n   304→            reason: inspect(reason)\n   305→          }\n   306→        )\n   307→    end\n   308→\n   309→    {:continue, state}\n   310→  end\n   311→\n   312→  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n   313→    :telemetry.execute(\n   314→      [:yellow_dog, :dhcpv4, :lease, :released],\n   315→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   316→      %{client_ip: client_ip, client_mac: message.chaddr}\n   317→    )\n   318→\n   319→    # Release the lease for this MAC address\n   320→    LeaseManager.release_lease(message.chaddr)\n   321→\n   322→    {:continue, state}\n   323→  end\n   324→\n   325→  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n   326→    :telemetry.execute(\n   327→      [:yellow_dog, :dhcpv4, :inform, :received],\n   328→      %{count: 1},\n   329→      %{client_ip: client_ip, client_mac: message.chaddr}\n   330→    )\n   331→\n   332→    # Handle inform - provide configuration parameters only\n   333→    ack = create_dhcp_ack_inform(message, client_ip)\n   334→    # Send to client port 68\n   335→    send_dhcp_response(ack, client_ip, 68, state)\n   336→\n   337→    :telemetry.execute(\n   338→      [:yellow_dog, :dhcpv4, :inform, :handled],\n   339→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   340→      %{client_ip: client_ip, client_mac: message.chaddr}\n   341→    )\n   342→\n   343→    {:continue, state}\n   344→  end\n   345→\n   346→  defp create_dhcp_offer(discover, pool_name, option_set_name) do\n   347→    # Extract hostname and client identifier from options if present\n   348→    hostname = get_hostname_from_options(discover.options)\n   349→    client_id = get_client_id_from_options(discover.options)\n   350→\n   351→    # Try to allocate a lease from LeaseManager\n   352→    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, pool_name, client_id) do\n   353→      {:ok, lease} ->\n   354→        # Build DHCPOFFER with lease information and custom options\n   355→        build_dhcp_offer(discover, lease, option_set_name)\n   356→\n   357→      {:error, :pool_exhausted} ->\n   358→        :telemetry.execute(\n   359→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   360→          %{count: 1},\n   361→          %{client_mac: discover.chaddr, operation: :offer}\n   362→        )\n   363→\n   364→        nil\n   365→\n   366→      {:error, :pool_limit_exceeded} ->\n   367→        :telemetry.execute(\n   368→          [:yellow_dog, :dhcpv4, :pool, :limit_exceeded],\n   369→          %{count: 1},\n   370→          %{client_mac: discover.chaddr, pool: pool_name, operation: :offer}\n   371→        )\n   372→\n   373→        nil\n   374→\n   375→      {:error, reason} ->\n   376→        :telemetry.execute(\n   377→          [:yellow_dog, :dhcpv4, :offer, :error],\n   378→          %{count: 1},\n   379→          %{client_mac: discover.chaddr, reason: inspect(reason)}\n   380→        )\n   381→\n   382→        nil\n   383→    end\n   384→  end\n   385→\n   386→  defp build_dhcp_offer(discover, lease, option_set_name) do\n   387→    # Get pool configuration for network parameters\n   388→    pool = get_pool_for_lease(lease)\n   389→\n   390→    # Build context for custom options template substitution (FR4.3)\n   391→    context = %{\n   392→      client_mac: discover.chaddr,\n   393→      client_hostname: get_hostname_from_options(discover.options),\n   394→      lease_address: lease.ip_address,\n   395→      pool_name: lease.pool_name\n   396→    }\n   397→\n   398→    DHCPv4.Message.new()\n   399→    # BOOTREPLY = 2\n   400→    |> Map.put(:op, 2)\n   401→    |> Map.put(:htype, discover.htype)\n   402→    |> Map.put(:hlen, discover.hlen)\n   403→    |> Map.put(:xid, discover.xid)\n   404→    |> Map.put(:flags, discover.flags)\n   405→    |> Map.put(:ciaddr, 0)\n   406→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   407→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   408→    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n   409→    |> Map.put(:chaddr, discover.chaddr)\n   410→    |> Map.put(:options, build_dhcp_options(2, pool, lease, context, option_set_name))\n   411→  end\n   412→\n   413→  defp create_dhcp_ack(request, _client_ip, request_state) do\n   414→    # Extract hostname, requested IP, and client identifier\n   415→    hostname = get_hostname_from_options(request.options)\n   416→    client_id = get_client_id_from_options(request.options)\n   417→    server_id = get_server_id_from_options(request.options)\n   418→\n   419→    # Get requested IP based on state\n   420→    requested_ip =\n   421→      case request_state do\n   422→        :renewing ->\n   423→          # For RENEWING, use ciaddr (client's current IP)\n   424→          integer_to_ip_tuple(request.ciaddr)\n   425→\n   426→        :rebinding ->\n   427→          # For REBINDING, use ciaddr (client's current IP)\n   428→          integer_to_ip_tuple(request.ciaddr)\n   429→\n   430→        _ ->\n   431→          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n   432→          get_requested_ip(request)\n   433→      end\n   434→\n   435→    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n   436→    # For SELECTING state, server identifier is required and must match\n   437→    case validate_server_identifier(server_id, request_state) do\n   438→      :ok ->\n   439→        # Server ID is valid, proceed with lease allocation\n   440→        allocate_and_respond(request, requested_ip, hostname, client_id)\n   441→\n   442→      {:error, :wrong_server} ->\n   443→        # Client is requesting from a different server, silently ignore\n   444→        :telemetry.execute(\n   445→          [:yellow_dog, :dhcpv4, :request, :ignored],\n   446→          %{count: 1},\n   447→          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n   448→        )\n   449→\n   450→        {:nak, \"Wrong server identifier\"}\n   451→    end\n   452→  end\n   453→\n   454→  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n   455→    # Try to allocate/renew lease\n   456→    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n   457→      {:ok, lease} ->\n   458→        ack = build_dhcp_ack(request, lease)\n   459→        {:ok, ack}\n   460→\n   461→      {:error, :pool_exhausted} ->\n   462→        :telemetry.execute(\n   463→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   464→          %{count: 1},\n   465→          %{client_mac: request.chaddr, operation: :ack}\n   466→        )\n   467→\n   468→        {:nak, \"Address pool exhausted\"}\n   469→\n   470→      {:error, :pool_not_found} ->\n   471→        :telemetry.execute(\n   472→          [:yellow_dog, :dhcpv4, :pool, :not_found],\n   473→          %{count: 1},\n   474→          %{client_mac: request.chaddr}\n   475→        )\n   476→\n   477→        {:nak, \"Invalid network or pool\"}\n   478→\n   479→      {:error, reason} ->\n   480→        :telemetry.execute(\n   481→          [:yellow_dog, :dhcpv4, :ack, :error],\n   482→          %{count: 1},\n   483→          %{client_mac: request.chaddr, reason: inspect(reason)}\n   484→        )\n   485→\n   486→        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n   487→    end\n   488→  end\n   489→\n   490→  defp build_dhcp_ack(request, lease) do\n   491→    # Get pool configuration for network parameters\n   492→    pool = get_pool_for_lease(lease)\n   493→\n   494→    # Build context for template substitution\n   495→    context = %{\n   496→      client_mac: request.chaddr,\n   497→      client_hostname: get_hostname_from_options(request.options),\n   498→      lease_address: lease.ip_address,\n   499→      pool_name: lease.pool_name\n   500→    }\n   501→\n   502→    DHCPv4.Message.new()\n   503→    # BOOTREPLY = 2\n   504→    |> Map.put(:op, 2)\n   505→    |> Map.put(:htype, request.htype)\n   506→    |> Map.put(:hlen, request.hlen)\n   507→    |> Map.put(:xid, request.xid)\n   508→    |> Map.put(:flags, request.flags)\n   509→    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n   510→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   511→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   512→    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n   513→    |> Map.put(:chaddr, request.chaddr)\n   514→    |> Map.put(:options, build_dhcp_options(5, pool, lease, context))\n   515→  end\n   516→\n   517→  defp build_dhcp_nak(request, reason) do\n   518→    # Get default pool for server identifier\n   519→    pool = get_default_pool()\n   520→\n   521→    # Build DHCPNAK message according to RFC 2131\n   522→    DHCPv4.Message.new()\n   523→    # BOOTREPLY = 2\n   524→    |> Map.put(:op, 2)\n   525→    |> Map.put(:htype, request.htype)\n   526→    |> Map.put(:hlen, request.hlen)\n   527→    |> Map.put(:xid, request.xid)\n   528→    |> Map.put(:flags, request.flags)\n   529→    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n   530→    |> Map.put(:ciaddr, 0)\n   531→    |> Map.put(:yiaddr, 0)\n   532→    |> Map.put(:siaddr, 0)\n   533→    |> Map.put(:giaddr, 0)\n   534→    |> Map.put(:chaddr, request.chaddr)\n   535→    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n   536→  end\n   537→\n   538→  defp build_dhcp_nak_options(pool, reason) do\n   539→    # DHCPNAK options per RFC 2131\n   540→    base_options = [\n   541→      # Message type = 6 (DHCPNAK)\n   542→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n   543→      # Server identifier\n   544→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n   545→    ]\n   546→\n   547→    # Add message option if reason is provided\n   548→    options_with_message =\n   549→      if reason && is_binary(reason) && byte_size(reason) > 0 do\n   550→        message_value = :binary.copy(reason)\n   551→\n   552→        base_options ++\n   553→          [\n   554→            %DHCPv4.Message.Option{\n   555→              type: 56,\n   556→              length: byte_size(message_value),\n   557→              value: message_value\n   558→            }\n   559→          ]\n   560→      else\n   561→        base_options\n   562→      end\n   563→\n   564→    # Add end option\n   565→    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   566→  end\n   567→\n   568→  defp create_dhcp_ack_inform(inform, client_ip) do\n   569→    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n   570→    # Use first available pool for configuration parameters\n   571→    case LeaseManager.list_leases() do\n   572→      [] ->\n   573→        # No leases, use default pool\n   574→        pool = get_default_pool()\n   575→        build_dhcp_ack_inform(inform, client_ip, pool)\n   576→\n   577→      [lease | _] ->\n   578→        # Use pool from an existing lease\n   579→        pool = get_pool_for_lease(lease)\n   580→        build_dhcp_ack_inform(inform, client_ip, pool)\n   581→    end\n   582→  end\n   583→\n   584→  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n   585→    DHCPv4.Message.new()\n   586→    # BOOTREPLY = 2\n   587→    |> Map.put(:op, 2)\n   588→    |> Map.put(:htype, inform.htype)\n   589→    |> Map.put(:hlen, inform.hlen)\n   590→    |> Map.put(:xid, inform.xid)\n   591→    |> Map.put(:flags, inform.flags)\n   592→    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n   593→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   594→    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n   595→    |> Map.put(:chaddr, inform.chaddr)\n   596→    |> Map.put(:options, [\n   597→      # DHCPACK = 5\n   598→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n   599→      # server identifier\n   600→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   601→      # subnet mask\n   602→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   603→      # router\n   604→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   605→      # DNS servers\n   606→      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n   607→      # :end\n   608→      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n   609→    ])\n   610→  end\n   611→\n   612→  defp send_dhcp_response(response, client_ip, client_port, state) do\n   613→    data = DHCP.Parameter.to_iodata(response)\n   614→\n   615→    # Send response to client (port 67 for broadcast, 68 for unicast)\n   616→    response_port = if client_port == 67, do: 68, else: client_port\n   617→\n   618→    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n   619→      :ok ->\n   620→        :telemetry.execute(\n   621→          [:yellow_dog, :dhcpv4, :response, :sent],\n   622→          %{count: 1, bytes: IO.iodata_length(data)},\n   623→          %{client_ip: client_ip, client_port: response_port}\n   624→        )\n   625→\n   626→      {:error, reason} ->\n   627→        :telemetry.execute(\n   628→          [:yellow_dog, :dhcpv4, :response, :error],\n   629→          %{count: 1},\n   630→          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n   631→        )\n   632→    end\n   633→  end\n   634→\n   635→  # Helper functions for building DHCP responses\n   636→\n   637→  defp build_dhcp_options(message_type, pool, lease, context, option_set_name \\\\ nil) do\n   638→    lease_time_binary = <<lease.lease_time::32>>\n   639→    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n   640→\n   641→    base_options = [\n   642→      # Message type\n   643→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n   644→      # Server identifier\n   645→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   646→      # Lease time\n   647→      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n   648→      # Subnet mask\n   649→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   650→      # Router\n   651→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   652→      %DHCPv4.Message.Option{\n   653→        type: 6,\n   654→        length: byte_size(dns_servers_binary),\n   655→        # DNS servers\n   656→        value: dns_servers_binary\n   657→      }\n   658→    ]\n   659→\n   660→    # Add domain name if present\n   661→    options_with_domain =\n   662→      case pool.domain_name do\n   663→        nil ->\n   664→          base_options\n   665→\n   666→        \"\" ->\n   667→          base_options\n   668→\n   669→        domain ->\n   670→          base_options ++\n   671→            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n   672→      end\n   673→\n   674→    # Apply custom options if option_set_name is specified (FR4)\n   675→    options_with_custom =\n   676→      if option_set_name do\n   677→        apply_custom_options(options_with_domain, option_set_name, context)\n   678→      else\n   679→        options_with_domain\n   680→      end\n   681→\n   682→    # Add end option\n   683→    options_with_custom ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   684→  end\n   685→\n   686→  defp get_pool_for_lease(_lease) do\n   687→    # For now, use the first pool from LeaseManager state\n   688→    # In a production system, you'd look up the pool by name from _lease.pool_name\n   689→    get_default_pool()\n   690→  end\n   691→\n   692→  defp get_default_pool do\n   693→    # Return a default pool configuration\n   694→    # This should be retrieved from configuration or LeaseManager state\n   695→    %{\n   696→      name: \"default\",\n   697→      range_start: {192, 168, 1, 100},\n   698→      range_end: {192, 168, 1, 200},\n   699→      subnet_mask: {255, 255, 255, 0},\n   700→      gateway: {192, 168, 1, 1},\n   701→      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n   702→      domain_name: \"local\",\n   703→      lease_time: 86400\n   704→    }\n   705→  end\n   706→\n   707→  defp encode_dns_servers(dns_servers) do\n   708→    dns_servers\n   709→    |> Enum.map(&ip_to_binary/1)\n   710→    |> Enum.join()\n   711→  end\n   712→\n   713→  defp get_hostname_from_options(options) do\n   714→    Enum.find_value(options, fn option ->\n   715→      # Option 12 is hostname\n   716→      if option.type == 12, do: option.value, else: nil\n   717→    end)\n   718→  end\n   719→\n   720→  defp get_client_id_from_options(options) do\n   721→    Enum.find_value(options, fn option ->\n   722→      # Option 61 is client identifier\n   723→      if option.type == 61, do: option.value, else: nil\n   724→    end)\n   725→  end\n   726→\n   727→  defp get_server_id_from_options(options) do\n   728→    Enum.find_value(options, fn option ->\n   729→      # Option 54 is server identifier\n   730→      if option.type == 54, do: option.value, else: nil\n   731→    end)\n   732→  end\n   733→\n   734→  defp validate_server_identifier(nil, :renewing), do: :ok\n   735→  defp validate_server_identifier(nil, :rebinding), do: :ok\n   736→  defp validate_server_identifier(nil, _), do: :ok\n   737→\n   738→  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n   739→    # Get our server identifier (gateway IP from default pool)\n   740→    our_server_id = get_server_identifier()\n   741→\n   742→    if server_id == our_server_id do\n   743→      :ok\n   744→    else\n   745→      {:error, :wrong_server}\n   746→    end\n   747→  end\n   748→\n   749→  defp determine_request_state(request) do\n   750→    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n   751→    server_id = get_server_id_from_options(request.options)\n   752→    requested_ip = get_requested_ip(request)\n   753→    ciaddr = request.ciaddr\n   754→\n   755→    cond do\n   756→      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n   757→      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n   758→        :selecting\n   759→\n   760→      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n   761→      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n   762→        :init_reboot\n   763→\n   764→      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n   765→      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n   766→        :renewing\n   767→\n   768→      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n   769→      ciaddr != 0 && server_id == nil ->\n   770→        :rebinding\n   771→\n   772→      # Default to selecting if we can't determine\n   773→      true ->\n   774→        :selecting\n   775→    end\n   776→  end\n   777→\n   778→  defp integer_to_ip_tuple(0), do: nil\n   779→\n   780→  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n   781→    a = div(ip_int, 256 * 256 * 256)\n   782→    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n   783→    c = div(rem(ip_int, 256 * 256), 256)\n   784→    d = rem(ip_int, 256)\n   785→    {a, b, c, d}\n   786→  end\n   787→\n   788→  defp get_server_identifier do\n   789→    # Get the gateway IP from the default pool as our server identifier\n   790→    pool = get_default_pool()\n   791→    ip_to_binary(pool.gateway)\n   792→  end\n   793→\n   794→  defp get_requested_ip(request) do\n   795→    Enum.find_value(request.options, fn option ->\n   796→      if option.type == 50, do: binary_to_ip(option.value), else: nil\n   797→    end)\n   798→  end\n   799→\n   800→  defp get_dhcp_message_type(message) do\n   801→    Enum.find_value(message.options, 0, fn option ->\n   802→      if option.type == 53, do: decode_message_type(option.value), else: nil\n   803→    end)\n   804→  end\n   805→\n   806→  defp decode_message_type(<<1>>), do: :discover\n   807→  defp decode_message_type(<<2>>), do: :offer\n   808→  defp decode_message_type(<<3>>), do: :request\n   809→  defp decode_message_type(<<4>>), do: :decline\n   810→  defp decode_message_type(<<5>>), do: :ack\n   811→  defp decode_message_type(<<6>>), do: :nak\n   812→  defp decode_message_type(<<7>>), do: :release\n   813→  defp decode_message_type(<<8>>), do: :inform\n   814→  defp decode_message_type(_), do: 0\n   815→\n   816→  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n   817→  defp binary_to_ip(_), do: nil\n   818→\n   819→  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n   820→\n   821→  defp ip_to_binary(nil) do\n   822→    # Log warning for nil IP addresses - this indicates a configuration issue\n   823→    :telemetry.execute(\n   824→      [:yellow_dog, :dhcpv4, :config, :warning],\n   825→      %{count: 1},\n   826→      %{issue: \"ip_to_binary called with nil, using fallback\"}\n   827→    )\n   828→\n   829→    <<0, 0, 0, 0>>\n   830→  end\n   831→\n   832→  defp ip_to_binary(other) do\n   833→    # Log error for invalid IP format - this is a programming error\n   834→    :telemetry.execute(\n   835→      [:yellow_dog, :dhcpv4, :config, :error],\n   836→      %{count: 1},\n   837→      %{issue: \"ip_to_binary called with invalid format\", value: inspect(other)}\n   838→    )\n   839→\n   840→    <<0, 0, 0, 0>>\n   841→  end\n   842→\n   843→  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n   844→  defp ip_tuple_to_integer({a, b, c, d})\n   845→       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n   846→    <<integer::32>> = <<a, b, c, d>>\n   847→    integer\n   848→  end\n   849→\n   850→  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n   851→  defp ip_tuple_to_integer(_), do: 0\n   852→\n   853→  # Build client info map for ACL evaluation (FR3)\n   854→  defp build_client_info(message) do\n   855→    %{\n   856→      mac_address: message.chaddr,\n   857→      vendor_class: get_vendor_class_from_options(message.options),\n   858→      user_class: get_user_class_from_options(message.options),\n   859→      client_arch: get_client_arch_from_options(message.options)\n   860→    }\n   861→  end\n   862→\n   863→  defp get_vendor_class_from_options(options) do\n   864→    Enum.find_value(options, fn option ->\n   865→      # Option 60 is vendor class identifier\n   866→      if option.type == 60, do: option.value, else: nil\n   867→    end)\n   868→  end\n   869→\n   870→  defp get_user_class_from_options(options) do\n   871→    Enum.find_value(options, fn option ->\n   872→      # Option 77 is user class\n   873→      if option.type == 77, do: option.value, else: nil\n   874→    end)\n   875→  end\n   876→\n   877→  defp get_client_arch_from_options(options) do\n   878→    Enum.find_value(options, fn option ->\n   879→      # Option 93 is client architecture\n   880→      if option.type == 93, do: option.value, else: nil\n   881→    end)\n   882→  end\n   883→\n   884→  # Get ACL rules from configuration\n   885→  defp get_acl_rules do\n   886→    # Load ACL rules from configuration file\n   887→    config_path =\n   888→      Application.get_env(:yellow_dog_dhcpv4, :acl_config_path, \"config/dhcp_acls.toml\")\n   889→\n   890→    ACL.load_with_fallback(config_path)\n   891→  end\n   892→\n   893→  # Apply custom options to base options list (FR4)\n   894→  defp apply_custom_options(base_options, option_set_name, context) do\n   895→    # Load custom options from configuration\n   896→    config_path =\n   897→      Application.get_env(:yellow_dog_dhcpv4, :options_config_path, \"config/dhcp_options.toml\")\n   898→\n   899→    option_sets = CustomOptions.load_with_fallback(config_path)\n   900→\n   901→    case CustomOptions.get_option_set(option_sets, option_set_name) do\n   902→      {:ok, option_set} ->\n   903→        # Apply template substitution\n   904→        processed_set = CustomOptions.apply_templates(option_set, context)\n   905→\n   906→        # Encode custom options to DHCP format\n   907→        custom_options = CustomOptions.encode_options(processed_set.options)\n   908→\n   909→        # Convert custom options to DHCPv4.Message.Option format\n   910→        encoded_custom =\n   911→          Enum.map(custom_options, fn opt ->\n   912→            %DHCPv4.Message.Option{\n   913→              type: opt.type,\n   914→              length: byte_size(opt.value),\n   915→              value: opt.value\n   916→            }\n   917→          end)\n   918→\n   919→        # Merge custom options with base options (custom options override base)\n   920→        merge_options(base_options, encoded_custom)\n   921→\n   922→      {:error, :not_found} ->\n   923→        :telemetry.execute(\n   924→          [:yellow_dog, :dhcpv4, :custom_options, :not_found],\n   925→          %{count: 1},\n   926→          %{option_set: option_set_name}\n   927→        )\n   928→\n   929→        base_options\n   930→    end\n   931→  end\n   932→\n   933→  # Merge options, with later options (custom) overriding earlier (base)\n   934→  defp merge_options(base_options, custom_options) do\n   935→    # Build a map of custom option types for fast lookup\n   936→    custom_types = MapSet.new(Enum.map(custom_options, & &1.type))\n   937→\n   938→    # Filter out base options that are overridden by custom\n   939→    filtered_base =\n   940→      Enum.reject(base_options, fn opt -> MapSet.member?(custom_types, opt.type) end)\n   941→\n   942→    # Combine filtered base with custom options\n   943→    filtered_base ++ custom_options\n   944→  end\n   945→end\n   946→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"78eee498-d658-4078-9e76-11446bdc19ec","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/handler.ex","content":"defmodule YellowDog.Dhcpv4.Handler do\n  @moduledoc \"\"\"\n  DHCPv4 message handler using the Abyss.Handler behaviour.\n\n  Processes incoming DHCPv4 messages and implements the DHCP server logic\n  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n  messages. Emits telemetry events for monitoring and debugging.\n\n  Includes rate limiting to prevent pool exhaustion and DoS attacks.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv4.{ACL, ConflictResolver, CustomOptions, LeaseManager, RateLimiter}\n\n  # Telemetry events are handled via :telemetry directly\n\n  @doc \"\"\"\n  Handles incoming DHCPv4 messages from clients.\n\n  ## Parameters\n  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n  - `state`: Handler state containing socket information\n\n  ## Returns\n  - `{:continue, state}` - Continue handling more packets\n  - `{:close, state}` - Close connection after response\n  \"\"\"\n  @impl true\n  def handle_data({ip, port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    # Apply rate limiting to prevent DoS and pool exhaustion attacks\n    case RateLimiter.check_rate(ip) do\n      :ok ->\n        process_message(ip, port, data, state, start_time)\n\n      {:error, :rate_limited} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :rate_limited],\n          %{count: 1},\n          %{client_ip: ip, client_port: port}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp process_message(ip, port, data, state, start_time) do\n    try do\n      message = DHCPv4.Message.from_iodata(data)\n\n      # Emit telemetry event for message received\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :message_received],\n        %{duration: System.monotonic_time(:microsecond) - start_time},\n        %{client_ip: ip, client_port: port, message_type: message.op}\n      )\n\n      # Process the DHCP message\n      handle_dhcp_message(message, ip, port, state, start_time)\n    rescue\n      e ->\n        # Emit telemetry event for error\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :error],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @impl true\n  def handle_error(reason, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(reason)}\n    )\n\n    {:continue, state}\n  end\n\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private helper functions\n\n  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n    case message.op do\n      # BOOTREQUEST\n      1 ->\n        handle_boot_request(message, client_ip, client_port, state, start_time)\n\n      # BOOTREPLY\n      2 ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: :bootreply, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      op ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unknown],\n          %{count: 1},\n          %{operation: op}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n    case get_dhcp_message_type(message) do\n      :discover ->\n        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n\n      :request ->\n        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n\n      :decline ->\n        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n\n      :release ->\n        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n\n      :inform ->\n        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n\n      msg_type when msg_type in [:offer, :ack, :nak] ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: msg_type, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unsupported],\n          %{count: 1},\n          %{reason: \"missing or unsupported message type option\"}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n    )\n\n    # Build client info for ACL evaluation\n    client_info = build_client_info(message)\n\n    # Evaluate ACL rules (FR3)\n    acl_rules = get_acl_rules()\n    acl_result = ACL.evaluate(acl_rules, client_info)\n\n    case acl_result do\n      {:deny, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :acl, :denied],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: reason}\n        )\n\n        # Don't send a response - silently ignore denied clients\n        :ok\n\n      {:allow, target_pool} ->\n        # Determine pool name from ACL or default\n        pool_name = target_pool || \"default\"\n\n        # Generate a DHCPOFFER response (no custom option set for allow action)\n        case create_dhcp_offer(message, pool_name, nil) do\n          nil ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :offer, :failed],\n              %{count: 1},\n              %{client_mac: message.chaddr, reason: \"could not create offer\"}\n            )\n\n          offer ->\n            send_dhcp_response(offer, client_ip, client_port, state)\n        end\n\n      {:custom_options, option_set_name} ->\n        # Apply custom options and allow the request\n        case create_dhcp_offer(message, \"default\", option_set_name) do\n          nil ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv4, :offer, :failed],\n              %{count: 1},\n              %{client_mac: message.chaddr, reason: \"could not create offer with custom options\"}\n            )\n\n          offer ->\n            send_dhcp_response(offer, client_ip, client_port, state)\n        end\n    end\n\n    # Emit telemetry event\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :discover_handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n    request_state = determine_request_state(message)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{\n        client_ip: client_ip,\n        client_mac: message.chaddr,\n        message_type: :request,\n        state: request_state\n      }\n    )\n\n    # Generate a DHCPACK or DHCPNAK response based on state\n    case create_dhcp_ack(message, client_ip, request_state) do\n      {:ok, ack} ->\n        send_dhcp_response(ack, client_ip, client_port, state)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :granted],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n        )\n\n      {:nak, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :rejected],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: reason, state: request_state}\n        )\n\n        nak = build_dhcp_nak(message, reason)\n        send_dhcp_response(nak, client_ip, client_port, state)\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n    # Get the declined IP address\n    declined_ip = get_requested_ip(message) || client_ip\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :declined],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n    )\n\n    # Use ConflictResolver for conflict detection and auto-reassignment (FR2.4)\n    # ConflictResolver will:\n    # 1. Quarantine the declined IP\n    # 2. Attempt to allocate a new address for the client\n    # 3. Log the conflict with client details\n    case ConflictResolver.handle_conflict(declined_ip, message.chaddr, \"default\") do\n      {:ok, new_ip} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :conflict, :reassigned],\n          %{count: 1},\n          %{\n            client_mac: message.chaddr,\n            declined_ip: declined_ip,\n            new_ip: new_ip\n          }\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :conflict, :reassignment_failed],\n          %{count: 1},\n          %{\n            client_mac: message.chaddr,\n            declined_ip: declined_ip,\n            reason: inspect(reason)\n          }\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :released],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Release the lease for this MAC address\n    LeaseManager.release_lease(message.chaddr)\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :received],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Handle inform - provide configuration parameters only\n    ack = create_dhcp_ack_inform(message, client_ip)\n    # Send to client port 68\n    send_dhcp_response(ack, client_ip, 68, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp create_dhcp_offer(discover, pool_name, option_set_name) do\n    # Extract hostname and client identifier from options if present\n    hostname = get_hostname_from_options(discover.options)\n    client_id = get_client_id_from_options(discover.options)\n\n    # Try to allocate a lease from LeaseManager\n    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, pool_name, client_id) do\n      {:ok, lease} ->\n        # Build DHCPOFFER with lease information and custom options\n        build_dhcp_offer(discover, lease, option_set_name)\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: discover.chaddr, operation: :offer}\n        )\n\n        nil\n\n      {:error, :pool_limit_exceeded} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :limit_exceeded],\n          %{count: 1},\n          %{client_mac: discover.chaddr, pool: pool_name, operation: :offer}\n        )\n\n        nil\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :offer, :error],\n          %{count: 1},\n          %{client_mac: discover.chaddr, reason: inspect(reason)}\n        )\n\n        nil\n    end\n  end\n\n  defp build_dhcp_offer(discover, lease, option_set_name) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    # Build context for custom options template substitution (FR4.3)\n    context = %{\n      client_mac: discover.chaddr,\n      client_hostname: get_hostname_from_options(discover.options),\n      lease_address: lease.ip_address,\n      pool_name: lease.pool_name\n    }\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, discover.htype)\n    |> Map.put(:hlen, discover.hlen)\n    |> Map.put(:xid, discover.xid)\n    |> Map.put(:flags, discover.flags)\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n    |> Map.put(:chaddr, discover.chaddr)\n    |> Map.put(:options, build_dhcp_options(2, pool, lease, context, option_set_name))\n  end\n\n  defp create_dhcp_ack(request, _client_ip, request_state) do\n    # Extract hostname, requested IP, and client identifier\n    hostname = get_hostname_from_options(request.options)\n    client_id = get_client_id_from_options(request.options)\n    server_id = get_server_id_from_options(request.options)\n\n    # Get requested IP based on state\n    requested_ip =\n      case request_state do\n        :renewing ->\n          # For RENEWING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        :rebinding ->\n          # For REBINDING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        _ ->\n          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n          get_requested_ip(request)\n      end\n\n    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n    # For SELECTING state, server identifier is required and must match\n    case validate_server_identifier(server_id, request_state) do\n      :ok ->\n        # Server ID is valid, proceed with lease allocation\n        allocate_and_respond(request, requested_ip, hostname, client_id)\n\n      {:error, :wrong_server} ->\n        # Client is requesting from a different server, silently ignore\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :request, :ignored],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n        )\n\n        {:nak, \"Wrong server identifier\"}\n    end\n  end\n\n  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n    # Try to allocate/renew lease\n    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n      {:ok, lease} ->\n        ack = build_dhcp_ack(request, lease)\n        {:ok, ack}\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: request.chaddr, operation: :ack}\n        )\n\n        {:nak, \"Address pool exhausted\"}\n\n      {:error, :pool_not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :not_found],\n          %{count: 1},\n          %{client_mac: request.chaddr}\n        )\n\n        {:nak, \"Invalid network or pool\"}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :ack, :error],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: inspect(reason)}\n        )\n\n        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n    end\n  end\n\n  defp build_dhcp_ack(request, lease) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    # Build context for template substitution\n    context = %{\n      client_mac: request.chaddr,\n      client_hostname: get_hostname_from_options(request.options),\n      lease_address: lease.ip_address,\n      pool_name: lease.pool_name\n    }\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_options(5, pool, lease, context))\n  end\n\n  defp build_dhcp_nak(request, reason) do\n    # Get default pool for server identifier\n    pool = get_default_pool()\n\n    # Build DHCPNAK message according to RFC 2131\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, 0)\n    |> Map.put(:siaddr, 0)\n    |> Map.put(:giaddr, 0)\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n  end\n\n  defp build_dhcp_nak_options(pool, reason) do\n    # DHCPNAK options per RFC 2131\n    base_options = [\n      # Message type = 6 (DHCPNAK)\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n    ]\n\n    # Add message option if reason is provided\n    options_with_message =\n      if reason && is_binary(reason) && byte_size(reason) > 0 do\n        message_value = :binary.copy(reason)\n\n        base_options ++\n          [\n            %DHCPv4.Message.Option{\n              type: 56,\n              length: byte_size(message_value),\n              value: message_value\n            }\n          ]\n      else\n        base_options\n      end\n\n    # Add end option\n    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp create_dhcp_ack_inform(inform, client_ip) do\n    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n    # Use first available pool for configuration parameters\n    case LeaseManager.list_leases() do\n      [] ->\n        # No leases, use default pool\n        pool = get_default_pool()\n        build_dhcp_ack_inform(inform, client_ip, pool)\n\n      [lease | _] ->\n        # Use pool from an existing lease\n        pool = get_pool_for_lease(lease)\n        build_dhcp_ack_inform(inform, client_ip, pool)\n    end\n  end\n\n  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, inform.htype)\n    |> Map.put(:hlen, inform.hlen)\n    |> Map.put(:xid, inform.xid)\n    |> Map.put(:flags, inform.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n    |> Map.put(:chaddr, inform.chaddr)\n    |> Map.put(:options, [\n      # DHCPACK = 5\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n      # server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      # DNS servers\n      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n      # :end\n      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n    ])\n  end\n\n  defp send_dhcp_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    # Send response to client (port 67 for broadcast, 68 for unicast)\n    response_port = if client_port == 67, do: 68, else: client_port\n\n    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :sent],\n          %{count: 1, bytes: IO.iodata_length(data)},\n          %{client_ip: client_ip, client_port: response_port}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :error],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Helper functions for building DHCP responses\n\n  defp build_dhcp_options(message_type, pool, lease, context, option_set_name \\\\ nil) do\n    lease_time_binary = <<lease.lease_time::32>>\n    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n\n    base_options = [\n      # Message type\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # Lease time\n      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n      # Subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # Router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      %DHCPv4.Message.Option{\n        type: 6,\n        length: byte_size(dns_servers_binary),\n        # DNS servers\n        value: dns_servers_binary\n      }\n    ]\n\n    # Add domain name if present\n    options_with_domain =\n      case pool.domain_name do\n        nil ->\n          base_options\n\n        \"\" ->\n          base_options\n\n        domain ->\n          base_options ++\n            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n      end\n\n    # Apply custom options if option_set_name is specified (FR4)\n    options_with_custom =\n      if option_set_name do\n        apply_custom_options(options_with_domain, option_set_name, context)\n      else\n        options_with_domain\n      end\n\n    # Add end option\n    options_with_custom ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use the first pool from LeaseManager state\n    # In a production system, you'd look up the pool by name from _lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    # Return a default pool configuration\n    # This should be retrieved from configuration or LeaseManager state\n    %{\n      name: \"default\",\n      range_start: {192, 168, 1, 100},\n      range_end: {192, 168, 1, 200},\n      subnet_mask: {255, 255, 255, 0},\n      gateway: {192, 168, 1, 1},\n      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n      domain_name: \"local\",\n      lease_time: 86400\n    }\n  end\n\n  defp encode_dns_servers(dns_servers) do\n    dns_servers\n    |> Enum.map(&ip_to_binary/1)\n    |> Enum.join()\n  end\n\n  defp get_hostname_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 12 is hostname\n      if option.type == 12, do: option.value, else: nil\n    end)\n  end\n\n  defp get_client_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 61 is client identifier\n      if option.type == 61, do: option.value, else: nil\n    end)\n  end\n\n  defp get_server_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 54 is server identifier\n      if option.type == 54, do: option.value, else: nil\n    end)\n  end\n\n  defp validate_server_identifier(nil, :renewing), do: :ok\n  defp validate_server_identifier(nil, :rebinding), do: :ok\n  defp validate_server_identifier(nil, _), do: :ok\n\n  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n    # Get our server identifier (gateway IP from default pool)\n    our_server_id = get_server_identifier()\n\n    if server_id == our_server_id do\n      :ok\n    else\n      {:error, :wrong_server}\n    end\n  end\n\n  defp determine_request_state(request) do\n    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n    server_id = get_server_id_from_options(request.options)\n    requested_ip = get_requested_ip(request)\n    ciaddr = request.ciaddr\n\n    cond do\n      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n        :selecting\n\n      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n        :init_reboot\n\n      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n        :renewing\n\n      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n      ciaddr != 0 && server_id == nil ->\n        :rebinding\n\n      # Default to selecting if we can't determine\n      true ->\n        :selecting\n    end\n  end\n\n  defp integer_to_ip_tuple(0), do: nil\n\n  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n    a = div(ip_int, 256 * 256 * 256)\n    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n    c = div(rem(ip_int, 256 * 256), 256)\n    d = rem(ip_int, 256)\n    {a, b, c, d}\n  end\n\n  defp get_server_identifier do\n    # Get the gateway IP from the default pool as our server identifier\n    pool = get_default_pool()\n    ip_to_binary(pool.gateway)\n  end\n\n  defp get_requested_ip(request) do\n    Enum.find_value(request.options, fn option ->\n      if option.type == 50, do: binary_to_ip(option.value), else: nil\n    end)\n  end\n\n  defp get_dhcp_message_type(message) do\n    Enum.find_value(message.options, 0, fn option ->\n      if option.type == 53, do: decode_message_type(option.value), else: nil\n    end)\n  end\n\n  defp decode_message_type(<<1>>), do: :discover\n  defp decode_message_type(<<2>>), do: :offer\n  defp decode_message_type(<<3>>), do: :request\n  defp decode_message_type(<<4>>), do: :decline\n  defp decode_message_type(<<5>>), do: :ack\n  defp decode_message_type(<<6>>), do: :nak\n  defp decode_message_type(<<7>>), do: :release\n  defp decode_message_type(<<8>>), do: :inform\n  defp decode_message_type(_), do: 0\n\n  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n  defp binary_to_ip(_), do: nil\n\n  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n\n  defp ip_to_binary(nil) do\n    # Log warning for nil IP addresses - this indicates a configuration issue\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :config, :warning],\n      %{count: 1},\n      %{issue: \"ip_to_binary called with nil, using fallback\"}\n    )\n\n    <<0, 0, 0, 0>>\n  end\n\n  defp ip_to_binary(other) do\n    # Log error for invalid IP format - this is a programming error\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :config, :error],\n      %{count: 1},\n      %{issue: \"ip_to_binary called with invalid format\", value: inspect(other)}\n    )\n\n    <<0, 0, 0, 0>>\n  end\n\n  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n  defp ip_tuple_to_integer({a, b, c, d})\n       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n    <<integer::32>> = <<a, b, c, d>>\n    integer\n  end\n\n  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n  defp ip_tuple_to_integer(_), do: 0\n\n  # Build client info map for ACL evaluation (FR3)\n  defp build_client_info(message) do\n    %{\n      mac_address: message.chaddr,\n      vendor_class: get_vendor_class_from_options(message.options),\n      user_class: get_user_class_from_options(message.options),\n      client_arch: get_client_arch_from_options(message.options)\n    }\n  end\n\n  defp get_vendor_class_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 60 is vendor class identifier\n      if option.type == 60, do: option.value, else: nil\n    end)\n  end\n\n  defp get_user_class_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 77 is user class\n      if option.type == 77, do: option.value, else: nil\n    end)\n  end\n\n  defp get_client_arch_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 93 is client architecture\n      if option.type == 93, do: option.value, else: nil\n    end)\n  end\n\n  # Get ACL rules from configuration\n  defp get_acl_rules do\n    # Load ACL rules from configuration file\n    config_path =\n      Application.get_env(:yellow_dog_dhcpv4, :acl_config_path, \"config/dhcp_acls.toml\")\n\n    ACL.load_with_fallback(config_path)\n  end\n\n  # Apply custom options to base options list (FR4)\n  defp apply_custom_options(base_options, option_set_name, context) do\n    # Load custom options from configuration\n    config_path =\n      Application.get_env(:yellow_dog_dhcpv4, :options_config_path, \"config/dhcp_options.toml\")\n\n    option_sets = CustomOptions.load_with_fallback(config_path)\n\n    case CustomOptions.get_option_set(option_sets, option_set_name) do\n      {:ok, option_set} ->\n        # Apply template substitution\n        processed_set = CustomOptions.apply_templates(option_set, context)\n\n        # Encode custom options to DHCP format\n        custom_options = CustomOptions.encode_options(processed_set.options)\n\n        # Convert custom options to DHCPv4.Message.Option format\n        encoded_custom =\n          Enum.map(custom_options, fn opt ->\n            %DHCPv4.Message.Option{\n              type: opt.type,\n              length: byte_size(opt.value),\n              value: opt.value\n            }\n          end)\n\n        # Merge custom options with base options (custom options override base)\n        merge_options(base_options, encoded_custom)\n\n      {:error, :not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :custom_options, :not_found],\n          %{count: 1},\n          %{option_set: option_set_name}\n        )\n\n        base_options\n    end\n  end\n\n  # Merge options, with later options (custom) overriding earlier (base)\n  defp merge_options(base_options, custom_options) do\n    # Build a map of custom option types for fast lookup\n    custom_types = MapSet.new(Enum.map(custom_options, & &1.type))\n\n    # Filter out base options that are overridden by custom\n    filtered_base =\n      Enum.reject(base_options, fn opt -> MapSet.member?(custom_types, opt.type) end)\n\n    # Combine filtered base with custom options\n    filtered_base ++ custom_options\n  end\nend\n","numLines":946,"startLine":1,"totalLines":946}}}
