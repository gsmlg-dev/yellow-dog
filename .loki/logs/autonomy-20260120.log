{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A4Lkw6hb1P2Kh4fntAqJp5","type":"tool_result","content":"     1→defmodule YellowDog.Dns.View do\n     2→  @moduledoc \"\"\"\n     3→  Individual view process handling request routing and resolution strategy.\n     4→\n     5→  Each view is a GenServer that:\n     6→  - Matches client IPs against its ACL\n     7→  - Routes queries to appropriate zones\n     8→  - Manages view-local cache\n     9→  - Handles recursive resolution (via RecursionController)\n    10→  - Applies RPZ policies (post-resolution filtering)\n    11→\n    12→  ## State\n    13→\n    14→  - ACL configuration (client IP / EDNS client subnet matching)\n    15→  - Zone references (registered zones, including dynamic cache zones)\n    16→  - RPZ references (ordered by specificity for post-resolution filtering)\n    17→  - Recursion enabled/disabled flag\n    18→  - ECS matching enabled/disabled flag\n    19→\n    20→  ## Children (for recursive-enabled views)\n    21→\n    22→  - `YellowDog.Dns.RecursionController` - Manages recursive resolution processes\n    23→  - Root Zone process (one per recursive-enabled view)\n    24→\n    25→  ## Request Handling\n    26→\n    27→  1. Receive request from connection process (via ViewManager, with PID)\n    28→  2. Notify connection process: view matched\n    29→  3. Determine resolution strategy (recursive enabled/disabled)\n    30→  4. Find matching zone, send request to zone (with connection process PID)\n    31→  5. Receive response from zone\n    32→  6. Notify connection process: zone response received\n    33→  7. Apply RPZ policies to response (post-resolution)\n    34→  8. Notify connection process: RPZ evaluation complete\n    35→  9. Send final response to connection process\n    36→  \"\"\"\n    37→\n    38→  use GenServer\n    39→\n    40→  alias YellowDog.Telemetry\n    41→  alias YellowDog.Dns.View.ACL\n    42→  alias YellowDog.Dns.ZoneController\n    43→  alias DNS.Message\n    44→\n    45→  @default_cache_size 1000\n    46→  @default_priority 100\n    47→\n    48→  defstruct [\n    49→    :name,\n    50→    :priority,\n    51→    :acl,\n    52→    :zones,\n    53→    :rpz_zones,\n    54→    :cache_table,\n    55→    :recursion_enabled,\n    56→    :ecs_enabled,\n    57→    :recursion_controller,\n    58→    query_count: 0,\n    59→    hit_count: 0,\n    60→    miss_count: 0\n    61→  ]\n    62→\n    63→  # Client API\n    64→\n    65→  @doc \"\"\"\n    66→  Starts a view process.\n    67→\n    68→  ## Options\n    69→\n    70→  - `:name` - View name (required)\n    71→  - `:priority` - Priority for matching (lower = higher priority, default: 100)\n    72→  - `:acl` - ACL for client matching (default: `:any`)\n    73→  - `:zones` - List of zone names or zone configurations\n    74→  - `:rpz_zones` - List of RPZ zone references (ordered by specificity)\n    75→  - `:recursion_enabled` - Enable recursive resolution (default: true)\n    76→  - `:ecs_enabled` - Enable EDNS client subnet matching (default: false)\n    77→  - `:cache_size` - Maximum cache entries (default: 1000)\n    78→  \"\"\"\n    79→  @spec start_link(map() | keyword()) :: GenServer.on_start()\n    80→  def start_link(opts) do\n    81→    config = normalize_opts(opts)\n    82→    view_name = Map.fetch!(config, :name)\n    83→    GenServer.start_link(__MODULE__, config, name: via_tuple(view_name))\n    84→  end\n    85→\n    86→  @doc \"\"\"\n    87→  Checks if a client IP matches this view's ACL.\n    88→  \"\"\"\n    89→  @spec matches?(pid(), :inet.ip_address()) :: boolean()\n    90→  def matches?(pid, client_ip) do\n    91→    GenServer.call(pid, {:matches?, client_ip})\n    92→  end\n    93→\n    94→  @doc \"\"\"\n    95→  Resolves a DNS query within this view.\n    96→\n    97→  The connection_pid is used for sending async resolution notifications.\n    98→  \"\"\"\n    99→  @spec resolve(pid(), pid(), non_neg_integer(), Message.t()) ::\n   100→          {:ok, Message.t()} | {:error, atom()}\n   101→  def resolve(pid, connection_pid, query_id, query) do\n   102→    GenServer.call(pid, {:resolve, connection_pid, query_id, query})\n   103→  end\n   104→\n   105→  @doc \"\"\"\n   106→  Reloads view configuration.\n   107→  \"\"\"\n   108→  @spec reload(pid(), map() | keyword()) :: :ok\n   109→  def reload(pid, config) do\n   110→    GenServer.call(pid, {:reload, config})\n   111→  end\n   112→\n   113→  @doc \"\"\"\n   114→  Returns view statistics.\n   115→  \"\"\"\n   116→  @spec stats(pid()) :: map()\n   117→  def stats(pid) do\n   118→    GenServer.call(pid, :stats)\n   119→  end\n   120→\n   121→  @doc \"\"\"\n   122→  Gets the view name.\n   123→  \"\"\"\n   124→  @spec get_name(pid()) :: String.t()\n   125→  def get_name(pid) do\n   126→    GenServer.call(pid, :get_name)\n   127→  end\n   128→\n   129→  @doc \"\"\"\n   130→  Gets the view priority.\n   131→  \"\"\"\n   132→  @spec get_priority(pid()) :: integer() | :infinity\n   133→  def get_priority(pid) do\n   134→    GenServer.call(pid, :get_priority)\n   135→  end\n   136→\n   137→  @doc \"\"\"\n   138→  Registers a zone with this view.\n   139→  \"\"\"\n   140→  @spec register_zone(pid(), atom(), String.t()) :: :ok\n   141→  def register_zone(pid, zone_type, zone_name) do\n   142→    GenServer.call(pid, {:register_zone, zone_type, zone_name})\n   143→  end\n   144→\n   145→  @doc \"\"\"\n   146→  Registers an RPZ zone with this view.\n   147→  \"\"\"\n   148→  @spec register_rpz_zone(pid(), String.t()) :: :ok\n   149→  def register_rpz_zone(pid, rpz_name) do\n   150→    GenServer.call(pid, {:register_rpz_zone, rpz_name})\n   151→  end\n   152→\n   153→  # Server Callbacks\n   154→\n   155→  @impl true\n   156→  def init(config) do\n   157→    view_name = Map.fetch!(config, :name)\n   158→    priority = Map.get(config, :priority, @default_priority)\n   159→    acl = parse_acl(Map.get(config, :acl, :any))\n   160→    zones = Map.get(config, :zones, [])\n   161→    rpz_zones = Map.get(config, :rpz_zones, [])\n   162→    recursion_enabled = Map.get(config, :recursion_enabled, true)\n   163→    ecs_enabled = Map.get(config, :ecs_enabled, false)\n   164→    _cache_size = Map.get(config, :cache_size, @default_cache_size)\n   165→\n   166→    # Create view-local cache\n   167→    cache_table =\n   168→      :ets.new(:\"view_cache_#{view_name}\", [\n   169→        :set,\n   170→        :protected,\n   171→        read_concurrency: true\n   172→      ])\n   173→\n   174→    state = %__MODULE__{\n   175→      name: view_name,\n   176→      priority: priority,\n   177→      acl: acl,\n   178→      zones: zones,\n   179→      rpz_zones: rpz_zones,\n   180→      cache_table: cache_table,\n   181→      recursion_enabled: recursion_enabled,\n   182→      ecs_enabled: ecs_enabled\n   183→    }\n   184→\n   185→    Telemetry.info(\"View process started\", %{\n   186→      name: view_name,\n   187→      priority: priority,\n   188→      zones: zones,\n   189→      rpz_zones: rpz_zones,\n   190→      recursion: recursion_enabled,\n   191→      ecs: ecs_enabled\n   192→    })\n   193→\n   194→    {:ok, state}\n   195→  end\n   196→\n   197→  @impl true\n   198→  def handle_call(:get_name, _from, state) do\n   199→    {:reply, state.name, state}\n   200→  end\n   201→\n   202→  @impl true\n   203→  def handle_call(:get_priority, _from, state) do\n   204→    {:reply, state.priority, state}\n   205→  end\n   206→\n   207→  @impl true\n   208→  def handle_call({:matches?, client_ip}, _from, state) do\n   209→    result = acl_matches?(state.acl, client_ip)\n   210→    {:reply, result, state}\n   211→  end\n   212→\n   213→  @impl true\n   214→  def handle_call({:resolve, connection_pid, query_id, query}, _from, state) do\n   215→    state = %{state | query_count: state.query_count + 1}\n   216→\n   217→    case do_resolve(state, connection_pid, query_id, query) do\n   218→      {:ok, _response} = result ->\n   219→        state = %{state | hit_count: state.hit_count + 1}\n   220→        {:reply, result, state}\n   221→\n   222→      {:error, _} = error ->\n   223→        state = %{state | miss_count: state.miss_count + 1}\n   224→        {:reply, error, state}\n   225→    end\n   226→  end\n   227→\n   228→  @impl true\n   229→  def handle_call({:reload, config}, _from, state) do\n   230→    config = normalize_opts(config)\n   231→\n   232→    new_state = %{\n   233→      state\n   234→      | priority: Map.get(config, :priority, state.priority),\n   235→        acl: parse_acl(Map.get(config, :acl, state.acl)),\n   236→        zones: Map.get(config, :zones, state.zones),\n   237→        rpz_zones: Map.get(config, :rpz_zones, state.rpz_zones),\n   238→        recursion_enabled: Map.get(config, :recursion_enabled, state.recursion_enabled),\n   239→        ecs_enabled: Map.get(config, :ecs_enabled, state.ecs_enabled)\n   240→    }\n   241→\n   242→    Telemetry.info(\"View reloaded\", %{name: state.name})\n   243→\n   244→    {:reply, :ok, new_state}\n   245→  end\n   246→\n   247→  @impl true\n   248→  def handle_call({:register_zone, zone_type, zone_name}, _from, state) do\n   249→    zones = [{zone_type, zone_name} | state.zones] |> Enum.uniq()\n   250→    {:reply, :ok, %{state | zones: zones}}\n   251→  end\n   252→\n   253→  @impl true\n   254→  def handle_call({:register_rpz_zone, rpz_name}, _from, state) do\n   255→    rpz_zones = [rpz_name | state.rpz_zones] |> Enum.uniq()\n   256→    {:reply, :ok, %{state | rpz_zones: rpz_zones}}\n   257→  end\n   258→\n   259→  @impl true\n   260→  def handle_call(:stats, _from, state) do\n   261→    cache_size = :ets.info(state.cache_table, :size)\n   262→\n   263→    stats = %{\n   264→      name: state.name,\n   265→      priority: state.priority,\n   266→      zones: state.zones,\n   267→      rpz_zones: state.rpz_zones,\n   268→      recursion_enabled: state.recursion_enabled,\n   269→      ecs_enabled: state.ecs_enabled,\n   270→      query_count: state.query_count,\n   271→      hit_count: state.hit_count,\n   272→      miss_count: state.miss_count,\n   273→      cache_size: cache_size\n   274→    }\n   275→\n   276→    {:reply, stats, state}\n   277→  end\n   278→\n   279→  # Handle cancel query message from connection process\n   280→  @impl true\n   281→  def handle_info({:cancel_query, _query_id}, state) do\n   282→    # TODO: Cancel in-flight resolution\n   283→    {:noreply, state}\n   284→  end\n   285→\n   286→  @impl true\n   287→  def handle_info(_msg, state) do\n   288→    {:noreply, state}\n   289→  end\n   290→\n   291→  @impl true\n   292→  def terminate(_reason, state) do\n   293→    :ets.delete(state.cache_table)\n   294→    :ok\n   295→  end\n   296→\n   297→  # Private Functions\n   298→\n   299→  defp do_resolve(state, connection_pid, query_id, query) do\n   300→    case query.qdlist do\n   301→      [question | _] ->\n   302→        # Check view-local cache first\n   303→        case check_cache(state, question.name, question.type) do\n   304→          {:ok, cached_response} ->\n   305→            # Notify connection process of cache hit\n   306→            send(connection_pid, {:zone_lookup, query_id, :hit})\n   307→            response = update_response_id(cached_response, query.header.id)\n   308→            apply_rpz_and_respond(state, connection_pid, query_id, response)\n   309→\n   310→          :miss ->\n   311→            # Notify connection process of cache miss\n   312→            send(connection_pid, {:zone_lookup, query_id, :miss})\n   313→            # Find zone and resolve\n   314→            resolve_query(state, connection_pid, query_id, query, question)\n   315→        end\n   316→\n   317→      [] ->\n   318→        {:error, :format_error}\n   319→    end\n   320→  end\n   321→\n   322→  defp resolve_query(state, connection_pid, query_id, query, question) do\n   323→    zone_name = find_zone_for_name(state.zones, question.name)\n   324→\n   325→    if zone_name do\n   326→      resolve_in_zone(state, connection_pid, query_id, query, zone_name)\n   327→    else\n   328→      # No matching zone - try recursion if enabled\n   329→      if state.recursion_enabled do\n   330→        perform_recursion(state, connection_pid, query_id, query)\n   331→      else\n   332→        {:error, :refused}\n   333→      end\n   334→    end\n   335→  end\n   336→\n   337→  defp resolve_in_zone(state, connection_pid, query_id, query, zone_name) do\n   338→    # Try different zone types in order\n   339→    zone_types = [:auth, :forward, :stub]\n   340→    view_name = state.name\n   341→\n   342→    result =\n   343→      Enum.find_value(zone_types, fn zone_type ->\n   344→        case ZoneController.find_zone(view_name, zone_type, zone_name) do\n   345→          {:ok, zone_pid} ->\n   346→            module = zone_module(zone_type)\n   347→\n   348→            case module.resolve(zone_pid, query) do\n   349→              {:ok, response} = result ->\n   350→                # Notify connection process\n   351→                send(connection_pid, {:zone_response, query_id, response})\n   352→                # Cache the response\n   353→                cache_response(state, query, response)\n   354→                result\n   355→\n   356→              {:referral, _ns_records} ->\n   357→                # Handle referral - for now, treat as not found\n   358→                nil\n   359→\n   360→              {:error, :refused} ->\n   361→                # This zone refused, try next type\n   362→                nil\n   363→\n   364→              {:error, _} = error ->\n   365→                error\n   366→            end\n   367→\n   368→          :error ->\n   369→            nil\n   370→        end\n   371→      end)\n   372→\n   373→    case result do\n   374→      nil ->\n   375→        # No zone could resolve - try recursion if enabled\n   376→        if state.recursion_enabled do\n   377→          perform_recursion(state, connection_pid, query_id, query)\n   378→        else\n   379→          {:error, :refused}\n   380→        end\n   381→\n   382→      {:ok, response} ->\n   383→        apply_rpz_and_respond(state, connection_pid, query_id, response)\n   384→\n   385→      error ->\n   386→        error\n   387→    end\n   388→  end\n   389→\n   390→  defp perform_recursion(state, connection_pid, query_id, query) do\n   391→    # Notify connection process of recursive step\n   392→    send(connection_pid, {:recursive_step, query_id, %{step: :forward}})\n   393→    view_name = state.name\n   394→\n   395→    # Try to find forward zone \".\" in current view, then fall back to default view\n   396→    zone_pid =\n   397→      case ZoneController.find_zone(view_name, :forward, \".\") do\n   398→        {:ok, pid} ->\n   399→          pid\n   400→\n   401→        :error ->\n   402→          # Fall back to default view's forward zone\n   403→          case ZoneController.find_zone(\"default\", :forward, \".\") do\n   404→            {:ok, pid} -> pid\n   405→            :error -> nil\n   406→          end\n   407→      end\n   408→\n   409→    case zone_pid do\n   410→      nil ->\n   411→        # No forwarding configured\n   412→        {:error, :servfail}\n   413→\n   414→      pid ->\n   415→        case YellowDog.Dns.Zone.Forward.resolve(pid, query) do\n   416→          {:ok, response} ->\n   417→            send(connection_pid, {:zone_response, query_id, response})\n   418→            cache_response(state, query, response)\n   419→            apply_rpz_and_respond(state, connection_pid, query_id, response)\n   420→\n   421→          error ->\n   422→            error\n   423→        end\n   424→    end\n   425→  end\n   426→\n   427→  defp apply_rpz_and_respond(state, connection_pid, query_id, response) do\n   428→    # Apply RPZ policies if configured\n   429→    final_response =\n   430→      if Enum.empty?(state.rpz_zones) do\n   431→        response\n   432→      else\n   433→        apply_rpz_policies(state, response)\n   434→      end\n   435→\n   436→    # Notify connection process of RPZ evaluation\n   437→    send(connection_pid, {:rpz_evaluation, query_id, :complete})\n   438→\n   439→    {:ok, final_response}\n   440→  end\n   441→\n   442→  defp apply_rpz_policies(_state, response) do\n   443→    # TODO: Implement RPZ policy evaluation\n   444→    # For now, pass through unmodified\n   445→    response\n   446→  end\n   447→\n   448→  defp find_zone_for_name(zones, query_name) do\n   449→    normalized = normalize_name(query_name)\n   450→\n   451→    # Handle both simple zone names and {type, name} tuples\n   452→    Enum.find_value(zones, fn\n   453→      {_type, zone_name} ->\n   454→        zone_suffix = normalize_name(zone_name)\n   455→\n   456→        if String.ends_with?(normalized, zone_suffix) or normalized == zone_suffix do\n   457→          zone_name\n   458→        else\n   459→          nil\n   460→        end\n   461→\n   462→      zone_name when is_binary(zone_name) ->\n   463→        zone_suffix = normalize_name(zone_name)\n   464→\n   465→        if String.ends_with?(normalized, zone_suffix) or normalized == zone_suffix do\n   466→          zone_name\n   467→        else\n   468→          nil\n   469→        end\n   470→    end)\n   471→  end\n   472→\n   473→  defp check_cache(state, name, type) do\n   474→    key = {normalize_name(name), type}\n   475→\n   476→    case :ets.lookup(state.cache_table, key) do\n   477→      [{^key, {response, expires_at}}] ->\n   478→        if expires_at > System.system_time(:second) do\n   479→          {:ok, response}\n   480→        else\n   481→          :ets.delete(state.cache_table, key)\n   482→          :miss\n   483→        end\n   484→\n   485→      [] ->\n   486→        :miss\n   487→    end\n   488→  end\n   489→\n   490→  defp cache_response(state, query, response) do\n   491→    case query.qdlist do\n   492→      [question | _] ->\n   493→        ttl = get_min_ttl(response)\n   494→        key = {normalize_name(question.name), question.type}\n   495→        expires_at = System.system_time(:second) + ttl\n   496→        :ets.insert(state.cache_table, {key, {response, expires_at}})\n   497→\n   498→      [] ->\n   499→        :ok\n   500→    end\n   501→  end\n   502→\n   503→  defp get_min_ttl(response) do\n   504→    all_records = response.anlist ++ response.nslist ++ response.arlist\n   505→\n   506→    case all_records do\n   507→      [] -> 300\n   508→      records -> Enum.map(records, & &1.ttl) |> Enum.min() |> max(60)\n   509→    end\n   510→  end\n   511→\n   512→  defp update_response_id(response, new_id) do\n   513→    %{response | header: %{response.header | id: new_id}}\n   514→  end\n   515→\n   516→  defp normalize_name(%DNS.Message.Domain{} = domain) do\n   517→    domain\n   518→    |> to_string()\n   519→    |> String.downcase()\n   520→    |> String.trim_trailing(\".\")\n   521→  end\n   522→\n   523→  defp normalize_name(name) when is_binary(name) do\n   524→    name\n   525→    |> String.downcase()\n   526→    |> String.trim_trailing(\".\")\n   527→  end\n   528→\n   529→  defp parse_acl(:any), do: :any\n   530→  defp parse_acl(:all), do: :any\n   531→\n   532→  defp parse_acl(acl_name) when is_binary(acl_name) do\n   533→    {:named, acl_name}\n   534→  end\n   535→\n   536→  defp parse_acl(%ACL{} = acl), do: acl\n   537→\n   538→  defp parse_acl(rules) when is_list(rules) do\n   539→    ACL.new(\"inline\", rules)\n   540→  end\n   541→\n   542→  defp parse_acl(_), do: :any\n   543→\n   544→  defp acl_matches?(:any, _client_ip), do: true\n   545→\n   546→  defp acl_matches?({:named, acl_name}, client_ip) do\n   547→    ACL.matches?(acl_name, client_ip)\n   548→  end\n   549→\n   550→  defp acl_matches?(%ACL{} = acl, client_ip) do\n   551→    ACL.matches?(acl, client_ip)\n   552→  end\n   553→\n   554→  defp zone_module(:auth), do: YellowDog.Dns.Zone.Auth\n   555→  defp zone_module(:forward), do: YellowDog.Dns.Zone.Forward\n   556→  defp zone_module(:stub), do: YellowDog.Dns.Zone.Stub\n   557→  defp zone_module(:cache), do: YellowDog.Dns.Zone.Cache\n   558→\n   559→  defp normalize_opts(opts) when is_map(opts), do: opts\n   560→  defp normalize_opts(opts) when is_list(opts), do: Map.new(opts)\n   561→\n   562→  defp via_tuple(view_name) do\n   563→    {:via, Registry, {YellowDog.Dns.ViewRegistry, view_name}}\n   564→  end\n   565→end\n   566→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"84996b7b-e98e-4515-80e7-3bf6c146a135","uuid":"78008b80-0824-4c41-9213-70765c904cbf","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dns/lib/yellow_dog/dns/view.ex","content":"defmodule YellowDog.Dns.View do\n  @moduledoc \"\"\"\n  Individual view process handling request routing and resolution strategy.\n\n  Each view is a GenServer that:\n  - Matches client IPs against its ACL\n  - Routes queries to appropriate zones\n  - Manages view-local cache\n  - Handles recursive resolution (via RecursionController)\n  - Applies RPZ policies (post-resolution filtering)\n\n  ## State\n\n  - ACL configuration (client IP / EDNS client subnet matching)\n  - Zone references (registered zones, including dynamic cache zones)\n  - RPZ references (ordered by specificity for post-resolution filtering)\n  - Recursion enabled/disabled flag\n  - ECS matching enabled/disabled flag\n\n  ## Children (for recursive-enabled views)\n\n  - `YellowDog.Dns.RecursionController` - Manages recursive resolution processes\n  - Root Zone process (one per recursive-enabled view)\n\n  ## Request Handling\n\n  1. Receive request from connection process (via ViewManager, with PID)\n  2. Notify connection process: view matched\n  3. Determine resolution strategy (recursive enabled/disabled)\n  4. Find matching zone, send request to zone (with connection process PID)\n  5. Receive response from zone\n  6. Notify connection process: zone response received\n  7. Apply RPZ policies to response (post-resolution)\n  8. Notify connection process: RPZ evaluation complete\n  9. Send final response to connection process\n  \"\"\"\n\n  use GenServer\n\n  alias YellowDog.Telemetry\n  alias YellowDog.Dns.View.ACL\n  alias YellowDog.Dns.ZoneController\n  alias DNS.Message\n\n  @default_cache_size 1000\n  @default_priority 100\n\n  defstruct [\n    :name,\n    :priority,\n    :acl,\n    :zones,\n    :rpz_zones,\n    :cache_table,\n    :recursion_enabled,\n    :ecs_enabled,\n    :recursion_controller,\n    query_count: 0,\n    hit_count: 0,\n    miss_count: 0\n  ]\n\n  # Client API\n\n  @doc \"\"\"\n  Starts a view process.\n\n  ## Options\n\n  - `:name` - View name (required)\n  - `:priority` - Priority for matching (lower = higher priority, default: 100)\n  - `:acl` - ACL for client matching (default: `:any`)\n  - `:zones` - List of zone names or zone configurations\n  - `:rpz_zones` - List of RPZ zone references (ordered by specificity)\n  - `:recursion_enabled` - Enable recursive resolution (default: true)\n  - `:ecs_enabled` - Enable EDNS client subnet matching (default: false)\n  - `:cache_size` - Maximum cache entries (default: 1000)\n  \"\"\"\n  @spec start_link(map() | keyword()) :: GenServer.on_start()\n  def start_link(opts) do\n    config = normalize_opts(opts)\n    view_name = Map.fetch!(config, :name)\n    GenServer.start_link(__MODULE__, config, name: via_tuple(view_name))\n  end\n\n  @doc \"\"\"\n  Checks if a client IP matches this view's ACL.\n  \"\"\"\n  @spec matches?(pid(), :inet.ip_address()) :: boolean()\n  def matches?(pid, client_ip) do\n    GenServer.call(pid, {:matches?, client_ip})\n  end\n\n  @doc \"\"\"\n  Resolves a DNS query within this view.\n\n  The connection_pid is used for sending async resolution notifications.\n  \"\"\"\n  @spec resolve(pid(), pid(), non_neg_integer(), Message.t()) ::\n          {:ok, Message.t()} | {:error, atom()}\n  def resolve(pid, connection_pid, query_id, query) do\n    GenServer.call(pid, {:resolve, connection_pid, query_id, query})\n  end\n\n  @doc \"\"\"\n  Reloads view configuration.\n  \"\"\"\n  @spec reload(pid(), map() | keyword()) :: :ok\n  def reload(pid, config) do\n    GenServer.call(pid, {:reload, config})\n  end\n\n  @doc \"\"\"\n  Returns view statistics.\n  \"\"\"\n  @spec stats(pid()) :: map()\n  def stats(pid) do\n    GenServer.call(pid, :stats)\n  end\n\n  @doc \"\"\"\n  Gets the view name.\n  \"\"\"\n  @spec get_name(pid()) :: String.t()\n  def get_name(pid) do\n    GenServer.call(pid, :get_name)\n  end\n\n  @doc \"\"\"\n  Gets the view priority.\n  \"\"\"\n  @spec get_priority(pid()) :: integer() | :infinity\n  def get_priority(pid) do\n    GenServer.call(pid, :get_priority)\n  end\n\n  @doc \"\"\"\n  Registers a zone with this view.\n  \"\"\"\n  @spec register_zone(pid(), atom(), String.t()) :: :ok\n  def register_zone(pid, zone_type, zone_name) do\n    GenServer.call(pid, {:register_zone, zone_type, zone_name})\n  end\n\n  @doc \"\"\"\n  Registers an RPZ zone with this view.\n  \"\"\"\n  @spec register_rpz_zone(pid(), String.t()) :: :ok\n  def register_rpz_zone(pid, rpz_name) do\n    GenServer.call(pid, {:register_rpz_zone, rpz_name})\n  end\n\n  # Server Callbacks\n\n  @impl true\n  def init(config) do\n    view_name = Map.fetch!(config, :name)\n    priority = Map.get(config, :priority, @default_priority)\n    acl = parse_acl(Map.get(config, :acl, :any))\n    zones = Map.get(config, :zones, [])\n    rpz_zones = Map.get(config, :rpz_zones, [])\n    recursion_enabled = Map.get(config, :recursion_enabled, true)\n    ecs_enabled = Map.get(config, :ecs_enabled, false)\n    _cache_size = Map.get(config, :cache_size, @default_cache_size)\n\n    # Create view-local cache\n    cache_table =\n      :ets.new(:\"view_cache_#{view_name}\", [\n        :set,\n        :protected,\n        read_concurrency: true\n      ])\n\n    state = %__MODULE__{\n      name: view_name,\n      priority: priority,\n      acl: acl,\n      zones: zones,\n      rpz_zones: rpz_zones,\n      cache_table: cache_table,\n      recursion_enabled: recursion_enabled,\n      ecs_enabled: ecs_enabled\n    }\n\n    Telemetry.info(\"View process started\", %{\n      name: view_name,\n      priority: priority,\n      zones: zones,\n      rpz_zones: rpz_zones,\n      recursion: recursion_enabled,\n      ecs: ecs_enabled\n    })\n\n    {:ok, state}\n  end\n\n  @impl true\n  def handle_call(:get_name, _from, state) do\n    {:reply, state.name, state}\n  end\n\n  @impl true\n  def handle_call(:get_priority, _from, state) do\n    {:reply, state.priority, state}\n  end\n\n  @impl true\n  def handle_call({:matches?, client_ip}, _from, state) do\n    result = acl_matches?(state.acl, client_ip)\n    {:reply, result, state}\n  end\n\n  @impl true\n  def handle_call({:resolve, connection_pid, query_id, query}, _from, state) do\n    state = %{state | query_count: state.query_count + 1}\n\n    case do_resolve(state, connection_pid, query_id, query) do\n      {:ok, _response} = result ->\n        state = %{state | hit_count: state.hit_count + 1}\n        {:reply, result, state}\n\n      {:error, _} = error ->\n        state = %{state | miss_count: state.miss_count + 1}\n        {:reply, error, state}\n    end\n  end\n\n  @impl true\n  def handle_call({:reload, config}, _from, state) do\n    config = normalize_opts(config)\n\n    new_state = %{\n      state\n      | priority: Map.get(config, :priority, state.priority),\n        acl: parse_acl(Map.get(config, :acl, state.acl)),\n        zones: Map.get(config, :zones, state.zones),\n        rpz_zones: Map.get(config, :rpz_zones, state.rpz_zones),\n        recursion_enabled: Map.get(config, :recursion_enabled, state.recursion_enabled),\n        ecs_enabled: Map.get(config, :ecs_enabled, state.ecs_enabled)\n    }\n\n    Telemetry.info(\"View reloaded\", %{name: state.name})\n\n    {:reply, :ok, new_state}\n  end\n\n  @impl true\n  def handle_call({:register_zone, zone_type, zone_name}, _from, state) do\n    zones = [{zone_type, zone_name} | state.zones] |> Enum.uniq()\n    {:reply, :ok, %{state | zones: zones}}\n  end\n\n  @impl true\n  def handle_call({:register_rpz_zone, rpz_name}, _from, state) do\n    rpz_zones = [rpz_name | state.rpz_zones] |> Enum.uniq()\n    {:reply, :ok, %{state | rpz_zones: rpz_zones}}\n  end\n\n  @impl true\n  def handle_call(:stats, _from, state) do\n    cache_size = :ets.info(state.cache_table, :size)\n\n    stats = %{\n      name: state.name,\n      priority: state.priority,\n      zones: state.zones,\n      rpz_zones: state.rpz_zones,\n      recursion_enabled: state.recursion_enabled,\n      ecs_enabled: state.ecs_enabled,\n      query_count: state.query_count,\n      hit_count: state.hit_count,\n      miss_count: state.miss_count,\n      cache_size: cache_size\n    }\n\n    {:reply, stats, state}\n  end\n\n  # Handle cancel query message from connection process\n  @impl true\n  def handle_info({:cancel_query, _query_id}, state) do\n    # TODO: Cancel in-flight resolution\n    {:noreply, state}\n  end\n\n  @impl true\n  def handle_info(_msg, state) do\n    {:noreply, state}\n  end\n\n  @impl true\n  def terminate(_reason, state) do\n    :ets.delete(state.cache_table)\n    :ok\n  end\n\n  # Private Functions\n\n  defp do_resolve(state, connection_pid, query_id, query) do\n    case query.qdlist do\n      [question | _] ->\n        # Check view-local cache first\n        case check_cache(state, question.name, question.type) do\n          {:ok, cached_response} ->\n            # Notify connection process of cache hit\n            send(connection_pid, {:zone_lookup, query_id, :hit})\n            response = update_response_id(cached_response, query.header.id)\n            apply_rpz_and_respond(state, connection_pid, query_id, response)\n\n          :miss ->\n            # Notify connection process of cache miss\n            send(connection_pid, {:zone_lookup, query_id, :miss})\n            # Find zone and resolve\n            resolve_query(state, connection_pid, query_id, query, question)\n        end\n\n      [] ->\n        {:error, :format_error}\n    end\n  end\n\n  defp resolve_query(state, connection_pid, query_id, query, question) do\n    zone_name = find_zone_for_name(state.zones, question.name)\n\n    if zone_name do\n      resolve_in_zone(state, connection_pid, query_id, query, zone_name)\n    else\n      # No matching zone - try recursion if enabled\n      if state.recursion_enabled do\n        perform_recursion(state, connection_pid, query_id, query)\n      else\n        {:error, :refused}\n      end\n    end\n  end\n\n  defp resolve_in_zone(state, connection_pid, query_id, query, zone_name) do\n    # Try different zone types in order\n    zone_types = [:auth, :forward, :stub]\n    view_name = state.name\n\n    result =\n      Enum.find_value(zone_types, fn zone_type ->\n        case ZoneController.find_zone(view_name, zone_type, zone_name) do\n          {:ok, zone_pid} ->\n            module = zone_module(zone_type)\n\n            case module.resolve(zone_pid, query) do\n              {:ok, response} = result ->\n                # Notify connection process\n                send(connection_pid, {:zone_response, query_id, response})\n                # Cache the response\n                cache_response(state, query, response)\n                result\n\n              {:referral, _ns_records} ->\n                # Handle referral - for now, treat as not found\n                nil\n\n              {:error, :refused} ->\n                # This zone refused, try next type\n                nil\n\n              {:error, _} = error ->\n                error\n            end\n\n          :error ->\n            nil\n        end\n      end)\n\n    case result do\n      nil ->\n        # No zone could resolve - try recursion if enabled\n        if state.recursion_enabled do\n          perform_recursion(state, connection_pid, query_id, query)\n        else\n          {:error, :refused}\n        end\n\n      {:ok, response} ->\n        apply_rpz_and_respond(state, connection_pid, query_id, response)\n\n      error ->\n        error\n    end\n  end\n\n  defp perform_recursion(state, connection_pid, query_id, query) do\n    # Notify connection process of recursive step\n    send(connection_pid, {:recursive_step, query_id, %{step: :forward}})\n    view_name = state.name\n\n    # Try to find forward zone \".\" in current view, then fall back to default view\n    zone_pid =\n      case ZoneController.find_zone(view_name, :forward, \".\") do\n        {:ok, pid} ->\n          pid\n\n        :error ->\n          # Fall back to default view's forward zone\n          case ZoneController.find_zone(\"default\", :forward, \".\") do\n            {:ok, pid} -> pid\n            :error -> nil\n          end\n      end\n\n    case zone_pid do\n      nil ->\n        # No forwarding configured\n        {:error, :servfail}\n\n      pid ->\n        case YellowDog.Dns.Zone.Forward.resolve(pid, query) do\n          {:ok, response} ->\n            send(connection_pid, {:zone_response, query_id, response})\n            cache_response(state, query, response)\n            apply_rpz_and_respond(state, connection_pid, query_id, response)\n\n          error ->\n            error\n        end\n    end\n  end\n\n  defp apply_rpz_and_respond(state, connection_pid, query_id, response) do\n    # Apply RPZ policies if configured\n    final_response =\n      if Enum.empty?(state.rpz_zones) do\n        response\n      else\n        apply_rpz_policies(state, response)\n      end\n\n    # Notify connection process of RPZ evaluation\n    send(connection_pid, {:rpz_evaluation, query_id, :complete})\n\n    {:ok, final_response}\n  end\n\n  defp apply_rpz_policies(_state, response) do\n    # TODO: Implement RPZ policy evaluation\n    # For now, pass through unmodified\n    response\n  end\n\n  defp find_zone_for_name(zones, query_name) do\n    normalized = normalize_name(query_name)\n\n    # Handle both simple zone names and {type, name} tuples\n    Enum.find_value(zones, fn\n      {_type, zone_name} ->\n        zone_suffix = normalize_name(zone_name)\n\n        if String.ends_with?(normalized, zone_suffix) or normalized == zone_suffix do\n          zone_name\n        else\n          nil\n        end\n\n      zone_name when is_binary(zone_name) ->\n        zone_suffix = normalize_name(zone_name)\n\n        if String.ends_with?(normalized, zone_suffix) or normalized == zone_suffix do\n          zone_name\n        else\n          nil\n        end\n    end)\n  end\n\n  defp check_cache(state, name, type) do\n    key = {normalize_name(name), type}\n\n    case :ets.lookup(state.cache_table, key) do\n      [{^key, {response, expires_at}}] ->\n        if expires_at > System.system_time(:second) do\n          {:ok, response}\n        else\n          :ets.delete(state.cache_table, key)\n          :miss\n        end\n\n      [] ->\n        :miss\n    end\n  end\n\n  defp cache_response(state, query, response) do\n    case query.qdlist do\n      [question | _] ->\n        ttl = get_min_ttl(response)\n        key = {normalize_name(question.name), question.type}\n        expires_at = System.system_time(:second) + ttl\n        :ets.insert(state.cache_table, {key, {response, expires_at}})\n\n      [] ->\n        :ok\n    end\n  end\n\n  defp get_min_ttl(response) do\n    all_records = response.anlist ++ response.nslist ++ response.arlist\n\n    case all_records do\n      [] -> 300\n      records -> Enum.map(records, & &1.ttl) |> Enum.min() |> max(60)\n    end\n  end\n\n  defp update_response_id(response, new_id) do\n    %{response | header: %{response.header | id: new_id}}\n  end\n\n  defp normalize_name(%DNS.Message.Domain{} = domain) do\n    domain\n    |> to_string()\n    |> String.downcase()\n    |> String.trim_trailing(\".\")\n  end\n\n  defp normalize_name(name) when is_binary(name) do\n    name\n    |> String.downcase()\n    |> String.trim_trailing(\".\")\n  end\n\n  defp parse_acl(:any), do: :any\n  defp parse_acl(:all), do: :any\n\n  defp parse_acl(acl_name) when is_binary(acl_name) do\n    {:named, acl_name}\n  end\n\n  defp parse_acl(%ACL{} = acl), do: acl\n\n  defp parse_acl(rules) when is_list(rules) do\n    ACL.new(\"inline\", rules)\n  end\n\n  defp parse_acl(_), do: :any\n\n  defp acl_matches?(:any, _client_ip), do: true\n\n  defp acl_matches?({:named, acl_name}, client_ip) do\n    ACL.matches?(acl_name, client_ip)\n  end\n\n  defp acl_matches?(%ACL{} = acl, client_ip) do\n    ACL.matches?(acl, client_ip)\n  end\n\n  defp zone_module(:auth), do: YellowDog.Dns.Zone.Auth\n  defp zone_module(:forward), do: YellowDog.Dns.Zone.Forward\n  defp zone_module(:stub), do: YellowDog.Dns.Zone.Stub\n  defp zone_module(:cache), do: YellowDog.Dns.Zone.Cache\n\n  defp normalize_opts(opts) when is_map(opts), do: opts\n  defp normalize_opts(opts) when is_list(opts), do: Map.new(opts)\n\n  defp via_tuple(view_name) do\n    {:via, Registry, {YellowDog.Dns.ViewRegistry, view_name}}\n  end\nend\n","numLines":566,"startLine":1,"totalLines":566}}}
