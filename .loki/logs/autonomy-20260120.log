{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TpFTJ2SxuctSJfQVhdjrp1","type":"tool_result","content":"     1→defmodule Abyss.Listener do\n     2→  @moduledoc \"\"\"\n     3→  UDP listener process that accepts incoming packets and creates handler processes.\n     4→\n     5→  Each listener process is responsible for:\n     6→  - Binding to a UDP port and receiving packets\n     7→  - Applying packet size validation\n     8→  - Creating handler processes for valid packets\n     9→  - Managing connection lifecycle and telemetry events\n    10→\n    11→  ## Modes of Operation\n    12→\n    13→  - **Regular Mode**: Passively receives packets and creates handler processes\n    14→  - **Broadcast Mode**: Actively receives packets with `active: true`\n    15→\n    16→  ## Security Features\n    17→\n    18→  - **Packet Size Validation**: Rejects oversized packets\n    19→  - **Telemetry Events**: Comprehensive monitoring and logging\n    20→\n    21→  ## Process Flow\n    22→\n    23→  1. Initialize UDP socket with transport options\n    24→  2. Start receiving packets (passive or active mode)\n    25→  3. Apply security checks (packet size)\n    26→  4. Create handler process via `Abyss.Connection`\n    27→  5. Emit telemetry events for monitoring\n    28→\n    29→  This module is primarily used internally by `Abyss.ListenerPool`.\n    30→  \"\"\"\n    31→\n    32→  use GenServer, restart: :transient\n    33→\n    34→  @typedoc \"\"\"\n    35→  Internal state of a listener process.\n    36→  \"\"\"\n    37→  @type state :: %{\n    38→          is_active: boolean(),\n    39→          is_listening: boolean(),\n    40→          server_pid: pid(),\n    41→          server_config: Abyss.ServerConfig.t(),\n    42→          listener_id: binary(),\n    43→          listener_socket: Abyss.Transport.socket(),\n    44→          listener_span: Abyss.Telemetry.t(),\n    45→          local_info: Abyss.Transport.socket_info(),\n    46→          transport: module()\n    47→        }\n    48→\n    49→  @doc \"\"\"\n    50→  Start a listener process.\n    51→\n    52→  ## Parameters\n    53→  - `id` - Unique identifier for this listener\n    54→  - `server_pid` - PID of the server supervisor\n    55→  - `config` - Server configuration\n    56→\n    57→  ## Returns\n    58→  - Standard GenServer start result\n    59→  \"\"\"\n    60→  @spec start_link({id :: binary(), server_pid :: pid(), Abyss.ServerConfig.t()}) ::\n    61→          GenServer.on_start()\n    62→  def start_link({id, server_pid, config}),\n    63→    do: GenServer.start_link(__MODULE__, {id, server_pid, config})\n    64→\n    65→  @doc \"\"\"\n    66→  Stop a listener process gracefully.\n    67→\n    68→  ## Parameters\n    69→  - `server` - The listener process PID or name\n    70→  \"\"\"\n    71→  @spec stop(GenServer.server()) :: :ok\n    72→  def stop(server), do: GenServer.stop(server)\n    73→\n    74→  @doc \"\"\"\n    75→  Get information about the listener's local socket endpoint.\n    76→\n    77→  ## Parameters\n    78→  - `server` - The listener process PID or name\n    79→\n    80→  ## Returns\n    81→  - `{ip_address, port}` tuple with local endpoint information\n    82→  \"\"\"\n    83→  @spec listener_info(GenServer.server()) :: Abyss.Transport.socket_info()\n    84→  def listener_info(server), do: GenServer.call(server, :listener_info)\n    85→\n    86→  @doc \"\"\"\n    87→  Get the listener's socket and telemetry span.\n    88→\n    89→  ## Parameters\n    90→  - `server` - The listener process PID or name\n    91→\n    92→  ## Returns\n    93→  - `{socket, telemetry_span}` tuple\n    94→  \"\"\"\n    95→  @spec socket_info(GenServer.server()) ::\n    96→          {Abyss.Transport.listener_socket(), Abyss.Telemetry.t()}\n    97→  def socket_info(server), do: GenServer.call(server, :socket_info)\n    98→\n    99→  @impl GenServer\n   100→  @spec init({listener_id :: neg_integer(), server_pid :: pid(), Abyss.ServerConfig.t()}) ::\n   101→          {:ok, state} | {:stop, term}\n   102→  def init({listener_id, server_pid, server_config}) do\n   103→    broadcast = server_config.broadcast\n   104→\n   105→    transport_options =\n   106→      if broadcast do\n   107→        server_config.transport_options\n   108→        |> Keyword.put(:active, true)\n   109→        |> Keyword.put(:broadcast, true)\n   110→        |> Keyword.put(:recbuf, server_config.udp_buffer_size)\n   111→        |> Keyword.put(:sndbuf, server_config.udp_buffer_size)\n   112→      else\n   113→        server_config.transport_options\n   114→        |> Keyword.put(:active, false)\n   115→        |> Keyword.put(:broadcast, false)\n   116→        |> Keyword.put(:recbuf, server_config.udp_buffer_size)\n   117→        |> Keyword.put(:sndbuf, server_config.udp_buffer_size)\n   118→      end\n   119→\n   120→    transport = server_config.transport_module\n   121→\n   122→    with {:ok, listener_socket} <-\n   123→           transport.listen(\n   124→             server_config.port,\n   125→             transport_options\n   126→           ),\n   127→         {:ok, {ip, port}} <-\n   128→           :inet.sockname(listener_socket) do\n   129→      active =\n   130→        case transport.getopts(listener_socket, [:active]) do\n   131→          {:ok, [active: true]} -> true\n   132→          _ -> false\n   133→        end\n   134→\n   135→      span_metadata = %{\n   136→        listener_id: listener_id,\n   137→        listener_socket: listener_socket,\n   138→        handler: server_config.handler_module,\n   139→        local_address: ip,\n   140→        local_port: port,\n   141→        broadcast: broadcast,\n   142→        transport_options: transport_options\n   143→      }\n   144→\n   145→      listener_span = Abyss.Telemetry.start_span(:listener, %{}, span_metadata)\n   146→\n   147→      state = %{\n   148→        broadcast: broadcast,\n   149→        is_active: active,\n   150→        is_listening: false,\n   151→        server_config: server_config,\n   152→        server_pid: server_pid,\n   153→        listener_id: listener_id,\n   154→        listener_socket: listener_socket,\n   155→        listener_span: listener_span,\n   156→        local_info: {ip, port},\n   157→        transport: transport\n   158→      }\n   159→\n   160→      # Start listening immediately for non-broadcast mode\n   161→      if not broadcast do\n   162→        Process.send_after(self(), :start_listening, 0)\n   163→      end\n   164→\n   165→      {:ok, state}\n   166→    else\n   167→      {:error, reason} ->\n   168→        {:stop, reason}\n   169→    end\n   170→  end\n   171→\n   172→  @impl GenServer\n   173→  def handle_info(\n   174→        :start_listening,\n   175→        %{listener_socket: listener_socket, transport: transport} = state\n   176→      ) do\n   177→    if state.is_listening do\n   178→      {:noreply, state}\n   179→    else\n   180→      case transport.getopts(listener_socket, [:active]) do\n   181→        {:ok, [{:active, false}]} ->\n   182→          Abyss.Telemetry.span_event(state.listener_span, :ready, %{}, %{\n   183→            listener_id: state.listener_id,\n   184→            listener_socket: state.listener_socket,\n   185→            local_info: state.local_info\n   186→          })\n   187→\n   188→          Process.send_after(self(), :do_recv, 0)\n   189→          {:noreply, state |> Map.put(:is_listening, true)}\n   190→\n   191→        {:ok, [active: true]} ->\n   192→          {:noreply, state}\n   193→      end\n   194→    end\n   195→  end\n   196→\n   197→  def handle_info({:udp, socket, ip, port, data}, %{listener_span: listener_span} = state) do\n   198→    # Check packet size\n   199→    if byte_size(data) > state.server_config.max_packet_size do\n   200→      Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n   201→        remote_address: ip,\n   202→        remote_port: port,\n   203→        packet_size: byte_size(data),\n   204→        max_size: state.server_config.max_packet_size\n   205→      })\n   206→\n   207→      {:noreply, state}\n   208→    else\n   209→      start_time = Abyss.Telemetry.monotonic_time()\n   210→\n   211→      # Track connection acceptance\n   212→      Abyss.Telemetry.track_connection_accepted()\n   213→\n   214→      connection_span =\n   215→        Abyss.Telemetry.start_child_span_with_sampling(\n   216→          listener_span,\n   217→          :connection,\n   218→          %{monotonic_time: start_time},\n   219→          %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n   220→          sample_rate: state.server_config.connection_telemetry_sample_rate\n   221→        )\n   222→\n   223→      Abyss.Connection.start_active(\n   224→        state.server_pid,\n   225→        self(),\n   226→        socket,\n   227→        {ip, port, data},\n   228→        state.server_config,\n   229→        connection_span\n   230→      )\n   231→\n   232→      {:noreply, state}\n   233→    end\n   234→  end\n   235→\n   236→  def handle_info(\n   237→        :do_recv,\n   238→        %{listener_span: listener_span, listener_socket: listener_socket, transport: transport} =\n   239→          state\n   240→      ) do\n   241→    Abyss.Telemetry.untimed_span_event(state.listener_span, :waiting, %{}, %{\n   242→      listener_id: state.listener_id,\n   243→      listener_socket: state.listener_socket,\n   244→      local_info: state.local_info\n   245→    })\n   246→\n   247→    # Use 100ms timeout to allow GenServer to handle calls (e.g., listener_info/1)\n   248→    # while still polling for incoming data\n   249→    case transport.recv(listener_socket, 0, 100) do\n   250→      {:error, :timeout} ->\n   251→        # Timeout is expected - retry recv to allow processing of GenServer calls\n   252→        Process.send_after(self(), :do_recv, 0)\n   253→        {:noreply, state}\n   254→\n   255→      {:ok, {ip, port, data}} ->\n   256→        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n   257→          listener_id: state.listener_id,\n   258→          listener_socket: state.listener_socket,\n   259→          local_info: state.local_info\n   260→        })\n   261→\n   262→        # Check packet size\n   263→        if byte_size(data) > state.server_config.max_packet_size do\n   264→          Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n   265→            remote_address: ip,\n   266→            remote_port: port,\n   267→            packet_size: byte_size(data),\n   268→            max_size: state.server_config.max_packet_size\n   269→          })\n   270→\n   271→          Process.send_after(self(), :do_recv, 0)\n   272→          {:noreply, state}\n   273→        else\n   274→          start_time = Abyss.Telemetry.monotonic_time()\n   275→\n   276→          # Track connection acceptance\n   277→          Abyss.Telemetry.track_connection_accepted()\n   278→\n   279→          connection_span =\n   280→            Abyss.Telemetry.start_child_span_with_sampling(\n   281→              listener_span,\n   282→              :connection,\n   283→              %{monotonic_time: start_time},\n   284→              %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n   285→              sample_rate: state.server_config.connection_telemetry_sample_rate\n   286→            )\n   287→\n   288→          Abyss.Connection.start(\n   289→            state.server_pid,\n   290→            self(),\n   291→            listener_socket,\n   292→            {ip, port, data},\n   293→            state.server_config,\n   294→            connection_span\n   295→          )\n   296→\n   297→          Process.send_after(self(), :do_recv, 0)\n   298→\n   299→          {:noreply, state}\n   300→        end\n   301→\n   302→      {:ok, {ip, port, _anc_data, data}} ->\n   303→        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n   304→          listener_id: state.listener_id,\n   305→          listener_socket: state.listener_socket,\n   306→          local_info: state.local_info\n   307→        })\n   308→\n   309→        # Check packet size\n   310→        if byte_size(data) > state.server_config.max_packet_size do\n   311→          Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n   312→            remote_address: ip,\n   313→            remote_port: port,\n   314→            packet_size: byte_size(data),\n   315→            max_size: state.server_config.max_packet_size\n   316→          })\n   317→\n   318→          Process.send_after(self(), :do_recv, 0)\n   319→          {:noreply, state}\n   320→        else\n   321→          start_time = Abyss.Telemetry.monotonic_time()\n   322→\n   323→          # Track connection acceptance\n   324→          Abyss.Telemetry.track_connection_accepted()\n   325→\n   326→          connection_span =\n   327→            Abyss.Telemetry.start_child_span_with_sampling(\n   328→              listener_span,\n   329→              :connection,\n   330→              %{monotonic_time: start_time},\n   331→              %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n   332→              sample_rate: state.server_config.connection_telemetry_sample_rate\n   333→            )\n   334→\n   335→          Abyss.Connection.start(\n   336→            state.server_pid,\n   337→            self(),\n   338→            listener_socket,\n   339→            {ip, port, data},\n   340→            state.server_config,\n   341→            connection_span\n   342→          )\n   343→\n   344→          Process.send_after(self(), :do_recv, 0)\n   345→\n   346→          {:noreply, state}\n   347→        end\n   348→\n   349→      {:error, reason} ->\n   350→        Abyss.Telemetry.span_event(listener_span, :recv_error, %{\n   351→          reason: reason,\n   352→          listener_socket: listener_socket\n   353→        })\n   354→\n   355→        {:stop, reason, state}\n   356→    end\n   357→  end\n   358→\n   359→  def handle_info({:retry_connection, retry_args}, state) do\n   360→    Abyss.Connection.retry_start(retry_args)\n   361→    {:noreply, state}\n   362→  end\n   363→\n   364→  def handle_info({:retry_active_connection, retry_args}, state) do\n   365→    Abyss.Connection.retry_start_active(retry_args)\n   366→    {:noreply, state}\n   367→  end\n   368→\n   369→  def handle_info(_msg, state) do\n   370→    {:noreply, state}\n   371→  end\n   372→\n   373→  @impl GenServer\n   374→  def handle_continue(\n   375→        :listening,\n   376→        %{listener_span: listener_span, listener_socket: listener_socket, transport: transport} =\n   377→          state\n   378→      ) do\n   379→    Abyss.Telemetry.untimed_span_event(state.listener_span, :waiting, %{}, %{\n   380→      listener_id: state.listener_id,\n   381→      listener_socket: state.listener_socket,\n   382→      local_info: state.local_info\n   383→    })\n   384→\n   385→    # Use 100ms timeout to allow GenServer to handle calls while polling for data\n   386→    case transport.recv(listener_socket, 0, 100) do\n   387→      {:error, :timeout} ->\n   388→        # Timeout is expected - continue listening loop to allow processing of GenServer calls\n   389→        {:noreply, state, {:continue, :listening}}\n   390→\n   391→      {:ok, recv_data} ->\n   392→        {ip, port, anc_data} =\n   393→          case recv_data do\n   394→            {ip, port, anc_data, _data} ->\n   395→              {ip, port, anc_data}\n   396→\n   397→            {ip, port, _data} ->\n   398→              {ip, port, nil}\n   399→          end\n   400→\n   401→        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n   402→          listener_id: state.listener_id,\n   403→          listener_socket: state.listener_socket,\n   404→          local_info: state.local_info\n   405→        })\n   406→\n   407→        start_time = Abyss.Telemetry.monotonic_time()\n   408→\n   409→        connection_span =\n   410→          Abyss.Telemetry.start_child_span(\n   411→            listener_span,\n   412→            :connection,\n   413→            %{monotonic_time: start_time},\n   414→            %{remote_address: ip, remote_port: port, anc_data: anc_data}\n   415→          )\n   416→\n   417→        Abyss.Connection.start(\n   418→          state.server_pid,\n   419→          self(),\n   420→          listener_socket,\n   421→          recv_data,\n   422→          state.server_config,\n   423→          connection_span\n   424→        )\n   425→\n   426→        {:noreply, state, {:continue, :listening}}\n   427→\n   428→      {:error, reason} ->\n   429→        Abyss.Telemetry.span_event(listener_span, :recv_error, %{\n   430→          reason: reason,\n   431→          listener_socket: listener_socket\n   432→        })\n   433→\n   434→        {:stop, reason, state}\n   435→    end\n   436→  end\n   437→\n   438→  @impl GenServer\n   439→  @spec handle_call(:listener_info | :socket_info, any, state) ::\n   440→          {:reply,\n   441→           Abyss.Transport.socket_info()\n   442→           | {Abyss.Transport.listener_socket(), Abyss.Telemetry.t()}, state}\n   443→  def handle_call(:listener_info, _from, state) do\n   444→    {:reply, state.local_info, state}\n   445→  end\n   446→\n   447→  def handle_call(:socket_info, _from, state),\n   448→    do: {:reply, {state.listener_socket, state.listener_span}, state}\n   449→\n   450→  @impl GenServer\n   451→  @spec terminate(reason, state) :: :ok\n   452→        when reason: :normal | :shutdown | {:shutdown, term} | term\n   453→  def terminate(_reason, state) do\n   454→    state.transport.close(state.listener_socket)\n   455→    Abyss.Telemetry.stop_span(state.listener_span)\n   456→  end\n   457→end\n   458→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01EcuPGge8XqrpRzcMMHw2DQ","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"301da6f1-697b-4556-9ee2-830ed26475cd","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/abyss/lib/abyss/listener.ex","content":"defmodule Abyss.Listener do\n  @moduledoc \"\"\"\n  UDP listener process that accepts incoming packets and creates handler processes.\n\n  Each listener process is responsible for:\n  - Binding to a UDP port and receiving packets\n  - Applying packet size validation\n  - Creating handler processes for valid packets\n  - Managing connection lifecycle and telemetry events\n\n  ## Modes of Operation\n\n  - **Regular Mode**: Passively receives packets and creates handler processes\n  - **Broadcast Mode**: Actively receives packets with `active: true`\n\n  ## Security Features\n\n  - **Packet Size Validation**: Rejects oversized packets\n  - **Telemetry Events**: Comprehensive monitoring and logging\n\n  ## Process Flow\n\n  1. Initialize UDP socket with transport options\n  2. Start receiving packets (passive or active mode)\n  3. Apply security checks (packet size)\n  4. Create handler process via `Abyss.Connection`\n  5. Emit telemetry events for monitoring\n\n  This module is primarily used internally by `Abyss.ListenerPool`.\n  \"\"\"\n\n  use GenServer, restart: :transient\n\n  @typedoc \"\"\"\n  Internal state of a listener process.\n  \"\"\"\n  @type state :: %{\n          is_active: boolean(),\n          is_listening: boolean(),\n          server_pid: pid(),\n          server_config: Abyss.ServerConfig.t(),\n          listener_id: binary(),\n          listener_socket: Abyss.Transport.socket(),\n          listener_span: Abyss.Telemetry.t(),\n          local_info: Abyss.Transport.socket_info(),\n          transport: module()\n        }\n\n  @doc \"\"\"\n  Start a listener process.\n\n  ## Parameters\n  - `id` - Unique identifier for this listener\n  - `server_pid` - PID of the server supervisor\n  - `config` - Server configuration\n\n  ## Returns\n  - Standard GenServer start result\n  \"\"\"\n  @spec start_link({id :: binary(), server_pid :: pid(), Abyss.ServerConfig.t()}) ::\n          GenServer.on_start()\n  def start_link({id, server_pid, config}),\n    do: GenServer.start_link(__MODULE__, {id, server_pid, config})\n\n  @doc \"\"\"\n  Stop a listener process gracefully.\n\n  ## Parameters\n  - `server` - The listener process PID or name\n  \"\"\"\n  @spec stop(GenServer.server()) :: :ok\n  def stop(server), do: GenServer.stop(server)\n\n  @doc \"\"\"\n  Get information about the listener's local socket endpoint.\n\n  ## Parameters\n  - `server` - The listener process PID or name\n\n  ## Returns\n  - `{ip_address, port}` tuple with local endpoint information\n  \"\"\"\n  @spec listener_info(GenServer.server()) :: Abyss.Transport.socket_info()\n  def listener_info(server), do: GenServer.call(server, :listener_info)\n\n  @doc \"\"\"\n  Get the listener's socket and telemetry span.\n\n  ## Parameters\n  - `server` - The listener process PID or name\n\n  ## Returns\n  - `{socket, telemetry_span}` tuple\n  \"\"\"\n  @spec socket_info(GenServer.server()) ::\n          {Abyss.Transport.listener_socket(), Abyss.Telemetry.t()}\n  def socket_info(server), do: GenServer.call(server, :socket_info)\n\n  @impl GenServer\n  @spec init({listener_id :: neg_integer(), server_pid :: pid(), Abyss.ServerConfig.t()}) ::\n          {:ok, state} | {:stop, term}\n  def init({listener_id, server_pid, server_config}) do\n    broadcast = server_config.broadcast\n\n    transport_options =\n      if broadcast do\n        server_config.transport_options\n        |> Keyword.put(:active, true)\n        |> Keyword.put(:broadcast, true)\n        |> Keyword.put(:recbuf, server_config.udp_buffer_size)\n        |> Keyword.put(:sndbuf, server_config.udp_buffer_size)\n      else\n        server_config.transport_options\n        |> Keyword.put(:active, false)\n        |> Keyword.put(:broadcast, false)\n        |> Keyword.put(:recbuf, server_config.udp_buffer_size)\n        |> Keyword.put(:sndbuf, server_config.udp_buffer_size)\n      end\n\n    transport = server_config.transport_module\n\n    with {:ok, listener_socket} <-\n           transport.listen(\n             server_config.port,\n             transport_options\n           ),\n         {:ok, {ip, port}} <-\n           :inet.sockname(listener_socket) do\n      active =\n        case transport.getopts(listener_socket, [:active]) do\n          {:ok, [active: true]} -> true\n          _ -> false\n        end\n\n      span_metadata = %{\n        listener_id: listener_id,\n        listener_socket: listener_socket,\n        handler: server_config.handler_module,\n        local_address: ip,\n        local_port: port,\n        broadcast: broadcast,\n        transport_options: transport_options\n      }\n\n      listener_span = Abyss.Telemetry.start_span(:listener, %{}, span_metadata)\n\n      state = %{\n        broadcast: broadcast,\n        is_active: active,\n        is_listening: false,\n        server_config: server_config,\n        server_pid: server_pid,\n        listener_id: listener_id,\n        listener_socket: listener_socket,\n        listener_span: listener_span,\n        local_info: {ip, port},\n        transport: transport\n      }\n\n      # Start listening immediately for non-broadcast mode\n      if not broadcast do\n        Process.send_after(self(), :start_listening, 0)\n      end\n\n      {:ok, state}\n    else\n      {:error, reason} ->\n        {:stop, reason}\n    end\n  end\n\n  @impl GenServer\n  def handle_info(\n        :start_listening,\n        %{listener_socket: listener_socket, transport: transport} = state\n      ) do\n    if state.is_listening do\n      {:noreply, state}\n    else\n      case transport.getopts(listener_socket, [:active]) do\n        {:ok, [{:active, false}]} ->\n          Abyss.Telemetry.span_event(state.listener_span, :ready, %{}, %{\n            listener_id: state.listener_id,\n            listener_socket: state.listener_socket,\n            local_info: state.local_info\n          })\n\n          Process.send_after(self(), :do_recv, 0)\n          {:noreply, state |> Map.put(:is_listening, true)}\n\n        {:ok, [active: true]} ->\n          {:noreply, state}\n      end\n    end\n  end\n\n  def handle_info({:udp, socket, ip, port, data}, %{listener_span: listener_span} = state) do\n    # Check packet size\n    if byte_size(data) > state.server_config.max_packet_size do\n      Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n        remote_address: ip,\n        remote_port: port,\n        packet_size: byte_size(data),\n        max_size: state.server_config.max_packet_size\n      })\n\n      {:noreply, state}\n    else\n      start_time = Abyss.Telemetry.monotonic_time()\n\n      # Track connection acceptance\n      Abyss.Telemetry.track_connection_accepted()\n\n      connection_span =\n        Abyss.Telemetry.start_child_span_with_sampling(\n          listener_span,\n          :connection,\n          %{monotonic_time: start_time},\n          %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n          sample_rate: state.server_config.connection_telemetry_sample_rate\n        )\n\n      Abyss.Connection.start_active(\n        state.server_pid,\n        self(),\n        socket,\n        {ip, port, data},\n        state.server_config,\n        connection_span\n      )\n\n      {:noreply, state}\n    end\n  end\n\n  def handle_info(\n        :do_recv,\n        %{listener_span: listener_span, listener_socket: listener_socket, transport: transport} =\n          state\n      ) do\n    Abyss.Telemetry.untimed_span_event(state.listener_span, :waiting, %{}, %{\n      listener_id: state.listener_id,\n      listener_socket: state.listener_socket,\n      local_info: state.local_info\n    })\n\n    # Use 100ms timeout to allow GenServer to handle calls (e.g., listener_info/1)\n    # while still polling for incoming data\n    case transport.recv(listener_socket, 0, 100) do\n      {:error, :timeout} ->\n        # Timeout is expected - retry recv to allow processing of GenServer calls\n        Process.send_after(self(), :do_recv, 0)\n        {:noreply, state}\n\n      {:ok, {ip, port, data}} ->\n        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n          listener_id: state.listener_id,\n          listener_socket: state.listener_socket,\n          local_info: state.local_info\n        })\n\n        # Check packet size\n        if byte_size(data) > state.server_config.max_packet_size do\n          Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n            remote_address: ip,\n            remote_port: port,\n            packet_size: byte_size(data),\n            max_size: state.server_config.max_packet_size\n          })\n\n          Process.send_after(self(), :do_recv, 0)\n          {:noreply, state}\n        else\n          start_time = Abyss.Telemetry.monotonic_time()\n\n          # Track connection acceptance\n          Abyss.Telemetry.track_connection_accepted()\n\n          connection_span =\n            Abyss.Telemetry.start_child_span_with_sampling(\n              listener_span,\n              :connection,\n              %{monotonic_time: start_time},\n              %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n              sample_rate: state.server_config.connection_telemetry_sample_rate\n            )\n\n          Abyss.Connection.start(\n            state.server_pid,\n            self(),\n            listener_socket,\n            {ip, port, data},\n            state.server_config,\n            connection_span\n          )\n\n          Process.send_after(self(), :do_recv, 0)\n\n          {:noreply, state}\n        end\n\n      {:ok, {ip, port, _anc_data, data}} ->\n        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n          listener_id: state.listener_id,\n          listener_socket: state.listener_socket,\n          local_info: state.local_info\n        })\n\n        # Check packet size\n        if byte_size(data) > state.server_config.max_packet_size do\n          Abyss.Telemetry.span_event(listener_span, :packet_too_large, %{\n            remote_address: ip,\n            remote_port: port,\n            packet_size: byte_size(data),\n            max_size: state.server_config.max_packet_size\n          })\n\n          Process.send_after(self(), :do_recv, 0)\n          {:noreply, state}\n        else\n          start_time = Abyss.Telemetry.monotonic_time()\n\n          # Track connection acceptance\n          Abyss.Telemetry.track_connection_accepted()\n\n          connection_span =\n            Abyss.Telemetry.start_child_span_with_sampling(\n              listener_span,\n              :connection,\n              %{monotonic_time: start_time},\n              %{remote_address: ip, remote_port: port, accept_start_time: start_time},\n              sample_rate: state.server_config.connection_telemetry_sample_rate\n            )\n\n          Abyss.Connection.start(\n            state.server_pid,\n            self(),\n            listener_socket,\n            {ip, port, data},\n            state.server_config,\n            connection_span\n          )\n\n          Process.send_after(self(), :do_recv, 0)\n\n          {:noreply, state}\n        end\n\n      {:error, reason} ->\n        Abyss.Telemetry.span_event(listener_span, :recv_error, %{\n          reason: reason,\n          listener_socket: listener_socket\n        })\n\n        {:stop, reason, state}\n    end\n  end\n\n  def handle_info({:retry_connection, retry_args}, state) do\n    Abyss.Connection.retry_start(retry_args)\n    {:noreply, state}\n  end\n\n  def handle_info({:retry_active_connection, retry_args}, state) do\n    Abyss.Connection.retry_start_active(retry_args)\n    {:noreply, state}\n  end\n\n  def handle_info(_msg, state) do\n    {:noreply, state}\n  end\n\n  @impl GenServer\n  def handle_continue(\n        :listening,\n        %{listener_span: listener_span, listener_socket: listener_socket, transport: transport} =\n          state\n      ) do\n    Abyss.Telemetry.untimed_span_event(state.listener_span, :waiting, %{}, %{\n      listener_id: state.listener_id,\n      listener_socket: state.listener_socket,\n      local_info: state.local_info\n    })\n\n    # Use 100ms timeout to allow GenServer to handle calls while polling for data\n    case transport.recv(listener_socket, 0, 100) do\n      {:error, :timeout} ->\n        # Timeout is expected - continue listening loop to allow processing of GenServer calls\n        {:noreply, state, {:continue, :listening}}\n\n      {:ok, recv_data} ->\n        {ip, port, anc_data} =\n          case recv_data do\n            {ip, port, anc_data, _data} ->\n              {ip, port, anc_data}\n\n            {ip, port, _data} ->\n              {ip, port, nil}\n          end\n\n        Abyss.Telemetry.untimed_span_event(state.listener_span, :receiving, %{}, %{\n          listener_id: state.listener_id,\n          listener_socket: state.listener_socket,\n          local_info: state.local_info\n        })\n\n        start_time = Abyss.Telemetry.monotonic_time()\n\n        connection_span =\n          Abyss.Telemetry.start_child_span(\n            listener_span,\n            :connection,\n            %{monotonic_time: start_time},\n            %{remote_address: ip, remote_port: port, anc_data: anc_data}\n          )\n\n        Abyss.Connection.start(\n          state.server_pid,\n          self(),\n          listener_socket,\n          recv_data,\n          state.server_config,\n          connection_span\n        )\n\n        {:noreply, state, {:continue, :listening}}\n\n      {:error, reason} ->\n        Abyss.Telemetry.span_event(listener_span, :recv_error, %{\n          reason: reason,\n          listener_socket: listener_socket\n        })\n\n        {:stop, reason, state}\n    end\n  end\n\n  @impl GenServer\n  @spec handle_call(:listener_info | :socket_info, any, state) ::\n          {:reply,\n           Abyss.Transport.socket_info()\n           | {Abyss.Transport.listener_socket(), Abyss.Telemetry.t()}, state}\n  def handle_call(:listener_info, _from, state) do\n    {:reply, state.local_info, state}\n  end\n\n  def handle_call(:socket_info, _from, state),\n    do: {:reply, {state.listener_socket, state.listener_span}, state}\n\n  @impl GenServer\n  @spec terminate(reason, state) :: :ok\n        when reason: :normal | :shutdown | {:shutdown, term} | term\n  def terminate(_reason, state) do\n    state.transport.close(state.listener_socket)\n    Abyss.Telemetry.stop_span(state.listener_span)\n  end\nend\n","numLines":458,"startLine":1,"totalLines":458}}}
