{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012fcoXQTbzYWvSoM5f6EN85","type":"tool_result","content":"     1→defmodule YellowDog.Console.Plugs.BasicAuth do\n     2→  @moduledoc \"\"\"\n     3→  Basic HTTP Authentication plug for the YellowDog Console.\n     4→\n     5→  This plug provides configurable basic authentication that can be enabled/disabled\n     6→  via configuration. In production, credentials should be set via environment variables.\n     7→\n     8→  ## Configuration\n     9→\n    10→  Configure in your endpoint or router:\n    11→\n    12→      # In config/prod.exs or config/runtime.exs\n    13→      config :yellow_dog_console, YellowDog.Console.Plugs.BasicAuth,\n    14→        enabled: true,\n    15→        username: System.get_env(\"CONSOLE_USERNAME\"),\n    16→        password: System.get_env(\"CONSOLE_PASSWORD\"),\n    17→        realm: \"YellowDog Console\"\n    18→\n    19→      # In config/dev.exs or config/test.exs (disabled by default)\n    20→      config :yellow_dog_console, YellowDog.Console.Plugs.BasicAuth,\n    21→        enabled: false\n    22→\n    23→  ## Environment Variables (Production)\n    24→\n    25→  - `CONSOLE_USERNAME` - The username for basic auth (default: \"admin\")\n    26→  - `CONSOLE_PASSWORD` - The password for basic auth (required in production)\n    27→  - `CONSOLE_AUTH_ENABLED` - Set to \"false\" to disable (default: \"true\" in production)\n    28→\n    29→  ## Security Features\n    30→\n    31→  - Always use HTTPS in production when using Basic Auth\n    32→  - Use strong, unique passwords\n    33→  - Rate limiting on failed authentication attempts via `AuthRateLimiter`\n    34→  - IP addresses are locked out after 5 failed attempts (configurable)\n    35→  \"\"\"\n    36→\n    37→  alias YellowDog.Console.Plugs.AuthRateLimiter\n    38→\n    39→  import Plug.Conn\n    40→  require Logger\n    41→\n    42→  @behaviour Plug\n    43→\n    44→  @default_realm \"YellowDog Console\"\n    45→  @default_username \"admin\"\n    46→\n    47→  @impl Plug\n    48→  def init(opts), do: opts\n    49→\n    50→  @impl Plug\n    51→  def call(conn, _opts) do\n    52→    config = get_config()\n    53→\n    54→    if auth_enabled?(config) do\n    55→      authenticate(conn, config)\n    56→    else\n    57→      conn\n    58→    end\n    59→  end\n    60→\n    61→  # Get configuration from application environment\n    62→  defp get_config do\n    63→    Application.get_env(:yellow_dog_console, __MODULE__, [])\n    64→  end\n    65→\n    66→  # Check if authentication is enabled\n    67→  defp auth_enabled?(config) do\n    68→    case Keyword.get(config, :enabled) do\n    69→      nil ->\n    70→        # Default: enabled in production, disabled otherwise\n    71→        Application.get_env(:yellow_dog_console, :env, :dev) == :prod\n    72→\n    73→      enabled ->\n    74→        enabled\n    75→    end\n    76→  end\n    77→\n    78→  # Perform the actual authentication\n    79→  defp authenticate(conn, config) do\n    80→    username = Keyword.get(config, :username, @default_username)\n    81→    password = Keyword.get(config, :password)\n    82→    realm = Keyword.get(config, :realm, @default_realm)\n    83→    client_ip = get_client_ip(conn)\n    84→\n    85→    cond do\n    86→      is_nil(password) or password == \"\" ->\n    87→        Logger.warning(\n    88→          \"Basic auth is enabled but CONSOLE_PASSWORD is not set. \" <>\n    89→            \"Authentication is disabled until password is configured.\"\n    90→        )\n    91→\n    92→        conn\n    93→\n    94→      true ->\n    95→        # Check rate limiting before processing credentials\n    96→        case AuthRateLimiter.check_rate_limit(client_ip) do\n    97→          {:error, :locked_out, seconds_remaining} ->\n    98→            Logger.warning(\n    99→              \"[BasicAuth] IP #{client_ip} is locked out for #{seconds_remaining}s due to failed attempts\"\n   100→            )\n   101→\n   102→            too_many_requests(conn, seconds_remaining)\n   103→\n   104→          {:ok, _attempts_remaining} ->\n   105→            case get_auth_header(conn) do\n   106→              nil ->\n   107→                unauthorized(conn, realm)\n   108→\n   109→              credentials ->\n   110→                verify_credentials(conn, credentials, username, password, realm, client_ip)\n   111→            end\n   112→        end\n   113→    end\n   114→  end\n   115→\n   116→  # Extract the Authorization header\n   117→  defp get_auth_header(conn) do\n   118→    case get_req_header(conn, \"authorization\") do\n   119→      [\"Basic \" <> encoded | _] ->\n   120→        case Base.decode64(encoded) do\n   121→          {:ok, decoded} -> decoded\n   122→          :error -> nil\n   123→        end\n   124→\n   125→      _ ->\n   126→        nil\n   127→    end\n   128→  end\n   129→\n   130→  # Verify the provided credentials\n   131→  defp verify_credentials(conn, credentials, username, password, realm, client_ip) do\n   132→    case String.split(credentials, \":\", parts: 2) do\n   133→      [provided_user, provided_pass] ->\n   134→        if secure_compare(provided_user, username) and secure_compare(provided_pass, password) do\n   135→          # Successful authentication - reset rate limiter\n   136→          AuthRateLimiter.record_success(client_ip)\n   137→          conn\n   138→        else\n   139→          # Failed authentication - record for rate limiting\n   140→          AuthRateLimiter.record_failure(client_ip)\n   141→\n   142→          Logger.debug(\n   143→            \"Failed authentication attempt for user: #{provided_user} from IP: #{client_ip}\"\n   144→          )\n   145→\n   146→          unauthorized(conn, realm)\n   147→        end\n   148→\n   149→      _ ->\n   150→        # Malformed credentials - count as failure\n   151→        AuthRateLimiter.record_failure(client_ip)\n   152→        unauthorized(conn, realm)\n   153→    end\n   154→  end\n   155→\n   156→  # Send 401 Unauthorized response\n   157→  defp unauthorized(conn, realm) do\n   158→    conn\n   159→    |> put_resp_header(\"www-authenticate\", ~s(Basic realm=\"#{realm}\"))\n   160→    |> send_resp(401, \"Unauthorized\")\n   161→    |> halt()\n   162→  end\n   163→\n   164→  # Send 429 Too Many Requests response for rate limiting\n   165→  defp too_many_requests(conn, seconds_remaining) do\n   166→    conn\n   167→    |> put_resp_header(\"retry-after\", Integer.to_string(seconds_remaining))\n   168→    |> send_resp(429, \"Too Many Requests. Try again in #{seconds_remaining} seconds.\")\n   169→    |> halt()\n   170→  end\n   171→\n   172→  # Extract client IP from connection\n   173→  defp get_client_ip(conn) do\n   174→    # Check X-Forwarded-For header first (for proxy setups)\n   175→    case get_req_header(conn, \"x-forwarded-for\") do\n   176→      [forwarded | _] ->\n   177→        forwarded\n   178→        |> String.split(\",\")\n   179→        |> List.first()\n   180→        |> String.trim()\n   181→\n   182→      [] ->\n   183→        # Fall back to direct connection IP\n   184→        conn.remote_ip\n   185→        |> :inet.ntoa()\n   186→        |> to_string()\n   187→    end\n   188→  end\n   189→\n   190→  # Constant-time string comparison to prevent timing attacks\n   191→  defp secure_compare(a, b) when is_binary(a) and is_binary(b) do\n   192→    byte_size(a) == byte_size(b) and :crypto.hash_equals(a, b)\n   193→  end\n   194→\n   195→  defp secure_compare(_, _), do: false\n   196→end\n   197→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"0d3ee750-7f11-4e1e-a617-3b37d644afe9","uuid":"8c2f6041-f0e9-4193-84e4-a5261a135697","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_console/lib/yellow_dog/console/plugs/basic_auth.ex","content":"defmodule YellowDog.Console.Plugs.BasicAuth do\n  @moduledoc \"\"\"\n  Basic HTTP Authentication plug for the YellowDog Console.\n\n  This plug provides configurable basic authentication that can be enabled/disabled\n  via configuration. In production, credentials should be set via environment variables.\n\n  ## Configuration\n\n  Configure in your endpoint or router:\n\n      # In config/prod.exs or config/runtime.exs\n      config :yellow_dog_console, YellowDog.Console.Plugs.BasicAuth,\n        enabled: true,\n        username: System.get_env(\"CONSOLE_USERNAME\"),\n        password: System.get_env(\"CONSOLE_PASSWORD\"),\n        realm: \"YellowDog Console\"\n\n      # In config/dev.exs or config/test.exs (disabled by default)\n      config :yellow_dog_console, YellowDog.Console.Plugs.BasicAuth,\n        enabled: false\n\n  ## Environment Variables (Production)\n\n  - `CONSOLE_USERNAME` - The username for basic auth (default: \"admin\")\n  - `CONSOLE_PASSWORD` - The password for basic auth (required in production)\n  - `CONSOLE_AUTH_ENABLED` - Set to \"false\" to disable (default: \"true\" in production)\n\n  ## Security Features\n\n  - Always use HTTPS in production when using Basic Auth\n  - Use strong, unique passwords\n  - Rate limiting on failed authentication attempts via `AuthRateLimiter`\n  - IP addresses are locked out after 5 failed attempts (configurable)\n  \"\"\"\n\n  alias YellowDog.Console.Plugs.AuthRateLimiter\n\n  import Plug.Conn\n  require Logger\n\n  @behaviour Plug\n\n  @default_realm \"YellowDog Console\"\n  @default_username \"admin\"\n\n  @impl Plug\n  def init(opts), do: opts\n\n  @impl Plug\n  def call(conn, _opts) do\n    config = get_config()\n\n    if auth_enabled?(config) do\n      authenticate(conn, config)\n    else\n      conn\n    end\n  end\n\n  # Get configuration from application environment\n  defp get_config do\n    Application.get_env(:yellow_dog_console, __MODULE__, [])\n  end\n\n  # Check if authentication is enabled\n  defp auth_enabled?(config) do\n    case Keyword.get(config, :enabled) do\n      nil ->\n        # Default: enabled in production, disabled otherwise\n        Application.get_env(:yellow_dog_console, :env, :dev) == :prod\n\n      enabled ->\n        enabled\n    end\n  end\n\n  # Perform the actual authentication\n  defp authenticate(conn, config) do\n    username = Keyword.get(config, :username, @default_username)\n    password = Keyword.get(config, :password)\n    realm = Keyword.get(config, :realm, @default_realm)\n    client_ip = get_client_ip(conn)\n\n    cond do\n      is_nil(password) or password == \"\" ->\n        Logger.warning(\n          \"Basic auth is enabled but CONSOLE_PASSWORD is not set. \" <>\n            \"Authentication is disabled until password is configured.\"\n        )\n\n        conn\n\n      true ->\n        # Check rate limiting before processing credentials\n        case AuthRateLimiter.check_rate_limit(client_ip) do\n          {:error, :locked_out, seconds_remaining} ->\n            Logger.warning(\n              \"[BasicAuth] IP #{client_ip} is locked out for #{seconds_remaining}s due to failed attempts\"\n            )\n\n            too_many_requests(conn, seconds_remaining)\n\n          {:ok, _attempts_remaining} ->\n            case get_auth_header(conn) do\n              nil ->\n                unauthorized(conn, realm)\n\n              credentials ->\n                verify_credentials(conn, credentials, username, password, realm, client_ip)\n            end\n        end\n    end\n  end\n\n  # Extract the Authorization header\n  defp get_auth_header(conn) do\n    case get_req_header(conn, \"authorization\") do\n      [\"Basic \" <> encoded | _] ->\n        case Base.decode64(encoded) do\n          {:ok, decoded} -> decoded\n          :error -> nil\n        end\n\n      _ ->\n        nil\n    end\n  end\n\n  # Verify the provided credentials\n  defp verify_credentials(conn, credentials, username, password, realm, client_ip) do\n    case String.split(credentials, \":\", parts: 2) do\n      [provided_user, provided_pass] ->\n        if secure_compare(provided_user, username) and secure_compare(provided_pass, password) do\n          # Successful authentication - reset rate limiter\n          AuthRateLimiter.record_success(client_ip)\n          conn\n        else\n          # Failed authentication - record for rate limiting\n          AuthRateLimiter.record_failure(client_ip)\n\n          Logger.debug(\n            \"Failed authentication attempt for user: #{provided_user} from IP: #{client_ip}\"\n          )\n\n          unauthorized(conn, realm)\n        end\n\n      _ ->\n        # Malformed credentials - count as failure\n        AuthRateLimiter.record_failure(client_ip)\n        unauthorized(conn, realm)\n    end\n  end\n\n  # Send 401 Unauthorized response\n  defp unauthorized(conn, realm) do\n    conn\n    |> put_resp_header(\"www-authenticate\", ~s(Basic realm=\"#{realm}\"))\n    |> send_resp(401, \"Unauthorized\")\n    |> halt()\n  end\n\n  # Send 429 Too Many Requests response for rate limiting\n  defp too_many_requests(conn, seconds_remaining) do\n    conn\n    |> put_resp_header(\"retry-after\", Integer.to_string(seconds_remaining))\n    |> send_resp(429, \"Too Many Requests. Try again in #{seconds_remaining} seconds.\")\n    |> halt()\n  end\n\n  # Extract client IP from connection\n  defp get_client_ip(conn) do\n    # Check X-Forwarded-For header first (for proxy setups)\n    case get_req_header(conn, \"x-forwarded-for\") do\n      [forwarded | _] ->\n        forwarded\n        |> String.split(\",\")\n        |> List.first()\n        |> String.trim()\n\n      [] ->\n        # Fall back to direct connection IP\n        conn.remote_ip\n        |> :inet.ntoa()\n        |> to_string()\n    end\n  end\n\n  # Constant-time string comparison to prevent timing attacks\n  defp secure_compare(a, b) when is_binary(a) and is_binary(b) do\n    byte_size(a) == byte_size(b) and :crypto.hash_equals(a, b)\n  end\n\n  defp secure_compare(_, _), do: false\nend\n","numLines":197,"startLine":1,"totalLines":197}}}
