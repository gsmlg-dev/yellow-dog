{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LRAzEwooiCzEgWy75LYRh8","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv4.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv4 message handler using the Abyss.Handler behaviour.\n     4→\n     5→  Processes incoming DHCPv4 messages and implements the DHCP server logic\n     6→  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n     7→  messages. Emits telemetry events for monitoring and debugging.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv4.LeaseManager\n    13→\n    14→  # Telemetry events are handled via :telemetry directly\n    15→\n    16→  @doc \"\"\"\n    17→  Handles incoming DHCPv4 messages from clients.\n    18→\n    19→  ## Parameters\n    20→  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n    21→  - `state`: Handler state containing socket information\n    22→\n    23→  ## Returns\n    24→  - `{:continue, state}` - Continue handling more packets\n    25→  - `{:close, state}` - Close connection after response\n    26→  \"\"\"\n    27→  @impl true\n    28→  def handle_data({ip, port, data}, state) do\n    29→    start_time = System.monotonic_time(:microsecond)\n    30→\n    31→    try do\n    32→      message = DHCPv4.Message.from_iodata(data)\n    33→\n    34→      # Emit telemetry event for message received\n    35→      :telemetry.execute(\n    36→        [:yellow_dog, :dhcpv4, :message_received],\n    37→        %{duration: System.monotonic_time(:microsecond) - start_time},\n    38→        %{client_ip: ip, client_port: port, message_type: message.op}\n    39→      )\n    40→\n    41→      # Process the DHCP message\n    42→      handle_dhcp_message(message, ip, port, state, start_time)\n    43→    rescue\n    44→      e ->\n    45→        # Emit telemetry event for error\n    46→        :telemetry.execute(\n    47→          [:yellow_dog, :dhcpv4, :message, :error],\n    48→          %{duration: System.monotonic_time(:microsecond) - start_time},\n    49→          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n    50→        )\n    51→\n    52→        {:continue, state}\n    53→    end\n    54→  end\n    55→\n    56→  @impl true\n    57→  def handle_error(reason, state) do\n    58→    :telemetry.execute(\n    59→      [:yellow_dog, :dhcpv4, :handler, :error],\n    60→      %{count: 1},\n    61→      %{reason: inspect(reason)}\n    62→    )\n    63→\n    64→    {:continue, state}\n    65→  end\n    66→\n    67→  @impl true\n    68→  def handle_timeout(state) do\n    69→    :telemetry.execute(\n    70→      [:yellow_dog, :dhcpv4, :handler, :timeout],\n    71→      %{count: 1},\n    72→      %{}\n    73→    )\n    74→\n    75→    {:continue, state}\n    76→  end\n    77→\n    78→  # Private helper functions\n    79→\n    80→  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n    81→    case message.op do\n    82→      # BOOTREQUEST\n    83→      1 ->\n    84→        handle_boot_request(message, client_ip, client_port, state, start_time)\n    85→\n    86→      # BOOTREPLY\n    87→      2 ->\n    88→        :telemetry.execute(\n    89→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n    90→          %{count: 1},\n    91→          %{message_type: :bootreply, reason: \"should not happen on server\"}\n    92→        )\n    93→\n    94→        {:continue, state}\n    95→\n    96→      op ->\n    97→        :telemetry.execute(\n    98→          [:yellow_dog, :dhcpv4, :message, :unknown],\n    99→          %{count: 1},\n   100→          %{operation: op}\n   101→        )\n   102→\n   103→        {:continue, state}\n   104→    end\n   105→  end\n   106→\n   107→  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n   108→    case get_dhcp_message_type(message) do\n   109→      :discover ->\n   110→        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n   111→\n   112→      :request ->\n   113→        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n   114→\n   115→      :decline ->\n   116→        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n   117→\n   118→      :release ->\n   119→        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n   120→\n   121→      :inform ->\n   122→        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n   123→\n   124→      msg_type when msg_type in [:offer, :ack, :nak] ->\n   125→        :telemetry.execute(\n   126→          [:yellow_dog, :dhcpv4, :message, :unexpected],\n   127→          %{count: 1},\n   128→          %{message_type: msg_type, reason: \"should not happen on server\"}\n   129→        )\n   130→\n   131→        {:continue, state}\n   132→\n   133→      _ ->\n   134→        :telemetry.execute(\n   135→          [:yellow_dog, :dhcpv4, :message, :unsupported],\n   136→          %{count: 1},\n   137→          %{reason: \"missing or unsupported message type option\"}\n   138→        )\n   139→\n   140→        {:continue, state}\n   141→    end\n   142→  end\n   143→\n   144→  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n   145→    :telemetry.execute(\n   146→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   147→      %{count: 1},\n   148→      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n   149→    )\n   150→\n   151→    # Generate a DHCPOFFER response\n   152→    case create_dhcp_offer(message, client_ip) do\n   153→      nil ->\n   154→        :telemetry.execute(\n   155→          [:yellow_dog, :dhcpv4, :offer, :failed],\n   156→          %{count: 1},\n   157→          %{client_mac: message.chaddr, reason: \"could not create offer\"}\n   158→        )\n   159→\n   160→      offer ->\n   161→        send_dhcp_response(offer, client_ip, client_port, state)\n   162→    end\n   163→\n   164→    # Emit telemetry event\n   165→    :telemetry.execute(\n   166→      [:yellow_dog, :dhcpv4, :discover_handled],\n   167→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   168→      %{client_ip: client_ip, client_mac: message.chaddr}\n   169→    )\n   170→\n   171→    {:continue, state}\n   172→  end\n   173→\n   174→  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n   175→    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n   176→    request_state = determine_request_state(message)\n   177→\n   178→    :telemetry.execute(\n   179→      [:yellow_dog, :dhcpv4, :lease, :requested],\n   180→      %{count: 1},\n   181→      %{\n   182→        client_ip: client_ip,\n   183→        client_mac: message.chaddr,\n   184→        message_type: :request,\n   185→        state: request_state\n   186→      }\n   187→    )\n   188→\n   189→    # Generate a DHCPACK or DHCPNAK response based on state\n   190→    case create_dhcp_ack(message, client_ip, request_state) do\n   191→      {:ok, ack} ->\n   192→        send_dhcp_response(ack, client_ip, client_port, state)\n   193→\n   194→        :telemetry.execute(\n   195→          [:yellow_dog, :dhcpv4, :lease, :granted],\n   196→          %{duration: System.monotonic_time(:microsecond) - start_time},\n   197→          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n   198→        )\n   199→\n   200→      {:nak, reason} ->\n   201→        :telemetry.execute(\n   202→          [:yellow_dog, :dhcpv4, :lease, :rejected],\n   203→          %{count: 1},\n   204→          %{client_mac: message.chaddr, reason: reason, state: request_state}\n   205→        )\n   206→\n   207→        nak = build_dhcp_nak(message, reason)\n   208→        send_dhcp_response(nak, client_ip, client_port, state)\n   209→    end\n   210→\n   211→    {:continue, state}\n   212→  end\n   213→\n   214→  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n   215→    # Get the declined IP address\n   216→    declined_ip = get_requested_ip(message) || client_ip\n   217→\n   218→    :telemetry.execute(\n   219→      [:yellow_dog, :dhcpv4, :lease, :declined],\n   220→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   221→      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n   222→    )\n   223→\n   224→    # Mark the IP as declined in LeaseManager\n   225→    LeaseManager.decline_ip(declined_ip, message.chaddr)\n   226→\n   227→    {:continue, state}\n   228→  end\n   229→\n   230→  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n   231→    :telemetry.execute(\n   232→      [:yellow_dog, :dhcpv4, :lease, :released],\n   233→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   234→      %{client_ip: client_ip, client_mac: message.chaddr}\n   235→    )\n   236→\n   237→    # Release the lease for this MAC address\n   238→    LeaseManager.release_lease(message.chaddr)\n   239→\n   240→    {:continue, state}\n   241→  end\n   242→\n   243→  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n   244→    :telemetry.execute(\n   245→      [:yellow_dog, :dhcpv4, :inform, :received],\n   246→      %{count: 1},\n   247→      %{client_ip: client_ip, client_mac: message.chaddr}\n   248→    )\n   249→\n   250→    # Handle inform - provide configuration parameters only\n   251→    ack = create_dhcp_ack_inform(message, client_ip)\n   252→    # Send to client port 68\n   253→    send_dhcp_response(ack, client_ip, 68, state)\n   254→\n   255→    :telemetry.execute(\n   256→      [:yellow_dog, :dhcpv4, :inform, :handled],\n   257→      %{duration: System.monotonic_time(:microsecond) - start_time},\n   258→      %{client_ip: client_ip, client_mac: message.chaddr}\n   259→    )\n   260→\n   261→    {:continue, state}\n   262→  end\n   263→\n   264→  defp create_dhcp_offer(discover, _client_ip) do\n   265→    # Extract hostname and client identifier from options if present\n   266→    hostname = get_hostname_from_options(discover.options)\n   267→    client_id = get_client_id_from_options(discover.options)\n   268→\n   269→    # Try to allocate a lease from LeaseManager\n   270→    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, \"default\", client_id) do\n   271→      {:ok, lease} ->\n   272→        # Build DHCPOFFER with lease information\n   273→        build_dhcp_offer(discover, lease)\n   274→\n   275→      {:error, :pool_exhausted} ->\n   276→        :telemetry.execute(\n   277→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   278→          %{count: 1},\n   279→          %{client_mac: discover.chaddr, operation: :offer}\n   280→        )\n   281→\n   282→        nil\n   283→\n   284→      {:error, reason} ->\n   285→        :telemetry.execute(\n   286→          [:yellow_dog, :dhcpv4, :offer, :error],\n   287→          %{count: 1},\n   288→          %{client_mac: discover.chaddr, reason: inspect(reason)}\n   289→        )\n   290→\n   291→        nil\n   292→    end\n   293→  end\n   294→\n   295→  defp build_dhcp_offer(discover, lease) do\n   296→    # Get pool configuration for network parameters\n   297→    pool = get_pool_for_lease(lease)\n   298→\n   299→    DHCPv4.Message.new()\n   300→    # BOOTREPLY = 2\n   301→    |> Map.put(:op, 2)\n   302→    |> Map.put(:htype, discover.htype)\n   303→    |> Map.put(:hlen, discover.hlen)\n   304→    |> Map.put(:xid, discover.xid)\n   305→    |> Map.put(:flags, discover.flags)\n   306→    |> Map.put(:ciaddr, 0)\n   307→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   308→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   309→    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n   310→    |> Map.put(:chaddr, discover.chaddr)\n   311→    |> Map.put(:options, build_dhcp_options(2, pool, lease))\n   312→  end\n   313→\n   314→  defp create_dhcp_ack(request, _client_ip, request_state) do\n   315→    # Extract hostname, requested IP, and client identifier\n   316→    hostname = get_hostname_from_options(request.options)\n   317→    client_id = get_client_id_from_options(request.options)\n   318→    server_id = get_server_id_from_options(request.options)\n   319→\n   320→    # Get requested IP based on state\n   321→    requested_ip =\n   322→      case request_state do\n   323→        :renewing ->\n   324→          # For RENEWING, use ciaddr (client's current IP)\n   325→          integer_to_ip_tuple(request.ciaddr)\n   326→\n   327→        :rebinding ->\n   328→          # For REBINDING, use ciaddr (client's current IP)\n   329→          integer_to_ip_tuple(request.ciaddr)\n   330→\n   331→        _ ->\n   332→          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n   333→          get_requested_ip(request)\n   334→      end\n   335→\n   336→    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n   337→    # For SELECTING state, server identifier is required and must match\n   338→    case validate_server_identifier(server_id, request_state) do\n   339→      :ok ->\n   340→        # Server ID is valid, proceed with lease allocation\n   341→        allocate_and_respond(request, requested_ip, hostname, client_id)\n   342→\n   343→      {:error, :wrong_server} ->\n   344→        # Client is requesting from a different server, silently ignore\n   345→        :telemetry.execute(\n   346→          [:yellow_dog, :dhcpv4, :request, :ignored],\n   347→          %{count: 1},\n   348→          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n   349→        )\n   350→\n   351→        {:nak, \"Wrong server identifier\"}\n   352→    end\n   353→  end\n   354→\n   355→  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n   356→    # Try to allocate/renew lease\n   357→    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n   358→      {:ok, lease} ->\n   359→        ack = build_dhcp_ack(request, lease)\n   360→        {:ok, ack}\n   361→\n   362→      {:error, :pool_exhausted} ->\n   363→        :telemetry.execute(\n   364→          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n   365→          %{count: 1},\n   366→          %{client_mac: request.chaddr, operation: :ack}\n   367→        )\n   368→\n   369→        {:nak, \"Address pool exhausted\"}\n   370→\n   371→      {:error, :pool_not_found} ->\n   372→        :telemetry.execute(\n   373→          [:yellow_dog, :dhcpv4, :pool, :not_found],\n   374→          %{count: 1},\n   375→          %{client_mac: request.chaddr}\n   376→        )\n   377→\n   378→        {:nak, \"Invalid network or pool\"}\n   379→\n   380→      {:error, reason} ->\n   381→        :telemetry.execute(\n   382→          [:yellow_dog, :dhcpv4, :ack, :error],\n   383→          %{count: 1},\n   384→          %{client_mac: request.chaddr, reason: inspect(reason)}\n   385→        )\n   386→\n   387→        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n   388→    end\n   389→  end\n   390→\n   391→  defp build_dhcp_ack(request, lease) do\n   392→    # Get pool configuration for network parameters\n   393→    pool = get_pool_for_lease(lease)\n   394→\n   395→    DHCPv4.Message.new()\n   396→    # BOOTREPLY = 2\n   397→    |> Map.put(:op, 2)\n   398→    |> Map.put(:htype, request.htype)\n   399→    |> Map.put(:hlen, request.hlen)\n   400→    |> Map.put(:xid, request.xid)\n   401→    |> Map.put(:flags, request.flags)\n   402→    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n   403→    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n   404→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   405→    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n   406→    |> Map.put(:chaddr, request.chaddr)\n   407→    |> Map.put(:options, build_dhcp_options(5, pool, lease))\n   408→  end\n   409→\n   410→  defp build_dhcp_nak(request, reason) do\n   411→    # Get default pool for server identifier\n   412→    pool = get_default_pool()\n   413→\n   414→    # Build DHCPNAK message according to RFC 2131\n   415→    DHCPv4.Message.new()\n   416→    # BOOTREPLY = 2\n   417→    |> Map.put(:op, 2)\n   418→    |> Map.put(:htype, request.htype)\n   419→    |> Map.put(:hlen, request.hlen)\n   420→    |> Map.put(:xid, request.xid)\n   421→    |> Map.put(:flags, request.flags)\n   422→    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n   423→    |> Map.put(:ciaddr, 0)\n   424→    |> Map.put(:yiaddr, 0)\n   425→    |> Map.put(:siaddr, 0)\n   426→    |> Map.put(:giaddr, 0)\n   427→    |> Map.put(:chaddr, request.chaddr)\n   428→    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n   429→  end\n   430→\n   431→  defp build_dhcp_nak_options(pool, reason) do\n   432→    # DHCPNAK options per RFC 2131\n   433→    base_options = [\n   434→      # Message type = 6 (DHCPNAK)\n   435→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n   436→      # Server identifier\n   437→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n   438→    ]\n   439→\n   440→    # Add message option if reason is provided\n   441→    options_with_message =\n   442→      if reason && is_binary(reason) && byte_size(reason) > 0 do\n   443→        message_value = :binary.copy(reason)\n   444→\n   445→        base_options ++\n   446→          [\n   447→            %DHCPv4.Message.Option{\n   448→              type: 56,\n   449→              length: byte_size(message_value),\n   450→              value: message_value\n   451→            }\n   452→          ]\n   453→      else\n   454→        base_options\n   455→      end\n   456→\n   457→    # Add end option\n   458→    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   459→  end\n   460→\n   461→  defp create_dhcp_ack_inform(inform, client_ip) do\n   462→    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n   463→    # Use first available pool for configuration parameters\n   464→    case LeaseManager.list_leases() do\n   465→      [] ->\n   466→        # No leases, use default pool\n   467→        pool = get_default_pool()\n   468→        build_dhcp_ack_inform(inform, client_ip, pool)\n   469→\n   470→      [lease | _] ->\n   471→        # Use pool from an existing lease\n   472→        pool = get_pool_for_lease(lease)\n   473→        build_dhcp_ack_inform(inform, client_ip, pool)\n   474→    end\n   475→  end\n   476→\n   477→  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n   478→    DHCPv4.Message.new()\n   479→    # BOOTREPLY = 2\n   480→    |> Map.put(:op, 2)\n   481→    |> Map.put(:htype, inform.htype)\n   482→    |> Map.put(:hlen, inform.hlen)\n   483→    |> Map.put(:xid, inform.xid)\n   484→    |> Map.put(:flags, inform.flags)\n   485→    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n   486→    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n   487→    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n   488→    |> Map.put(:chaddr, inform.chaddr)\n   489→    |> Map.put(:options, [\n   490→      # DHCPACK = 5\n   491→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n   492→      # server identifier\n   493→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   494→      # subnet mask\n   495→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   496→      # router\n   497→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   498→      # DNS servers\n   499→      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n   500→      # :end\n   501→      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n   502→    ])\n   503→  end\n   504→\n   505→  defp send_dhcp_response(response, client_ip, client_port, state) do\n   506→    data = DHCP.Parameter.to_iodata(response)\n   507→\n   508→    # Send response to client (port 67 for broadcast, 68 for unicast)\n   509→    response_port = if client_port == 67, do: 68, else: client_port\n   510→\n   511→    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n   512→      :ok ->\n   513→        :telemetry.execute(\n   514→          [:yellow_dog, :dhcpv4, :response, :sent],\n   515→          %{count: 1, bytes: IO.iodata_length(data)},\n   516→          %{client_ip: client_ip, client_port: response_port}\n   517→        )\n   518→\n   519→      {:error, reason} ->\n   520→        :telemetry.execute(\n   521→          [:yellow_dog, :dhcpv4, :response, :error],\n   522→          %{count: 1},\n   523→          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n   524→        )\n   525→    end\n   526→  end\n   527→\n   528→  # Helper functions for building DHCP responses\n   529→\n   530→  defp build_dhcp_options(message_type, pool, lease) do\n   531→    lease_time_binary = <<lease.lease_time::32>>\n   532→    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n   533→\n   534→    base_options = [\n   535→      # Message type\n   536→      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n   537→      # Server identifier\n   538→      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n   539→      # Lease time\n   540→      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n   541→      # Subnet mask\n   542→      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n   543→      # Router\n   544→      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n   545→      %DHCPv4.Message.Option{\n   546→        type: 6,\n   547→        length: byte_size(dns_servers_binary),\n   548→        # DNS servers\n   549→        value: dns_servers_binary\n   550→      }\n   551→    ]\n   552→\n   553→    # Add domain name if present\n   554→    options_with_domain =\n   555→      case pool.domain_name do\n   556→        nil ->\n   557→          base_options\n   558→\n   559→        \"\" ->\n   560→          base_options\n   561→\n   562→        domain ->\n   563→          base_options ++\n   564→            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n   565→      end\n   566→\n   567→    # Add end option\n   568→    options_with_domain ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n   569→  end\n   570→\n   571→  defp get_pool_for_lease(_lease) do\n   572→    # For now, use the first pool from LeaseManager state\n   573→    # In a production system, you'd look up the pool by name from _lease.pool_name\n   574→    get_default_pool()\n   575→  end\n   576→\n   577→  defp get_default_pool do\n   578→    # Return a default pool configuration\n   579→    # This should be retrieved from configuration or LeaseManager state\n   580→    %{\n   581→      name: \"default\",\n   582→      range_start: {192, 168, 1, 100},\n   583→      range_end: {192, 168, 1, 200},\n   584→      subnet_mask: {255, 255, 255, 0},\n   585→      gateway: {192, 168, 1, 1},\n   586→      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n   587→      domain_name: \"local\",\n   588→      lease_time: 86400\n   589→    }\n   590→  end\n   591→\n   592→  defp encode_dns_servers(dns_servers) do\n   593→    dns_servers\n   594→    |> Enum.map(&ip_to_binary/1)\n   595→    |> Enum.join()\n   596→  end\n   597→\n   598→  defp get_hostname_from_options(options) do\n   599→    Enum.find_value(options, fn option ->\n   600→      # Option 12 is hostname\n   601→      if option.type == 12, do: option.value, else: nil\n   602→    end)\n   603→  end\n   604→\n   605→  defp get_client_id_from_options(options) do\n   606→    Enum.find_value(options, fn option ->\n   607→      # Option 61 is client identifier\n   608→      if option.type == 61, do: option.value, else: nil\n   609→    end)\n   610→  end\n   611→\n   612→  defp get_server_id_from_options(options) do\n   613→    Enum.find_value(options, fn option ->\n   614→      # Option 54 is server identifier\n   615→      if option.type == 54, do: option.value, else: nil\n   616→    end)\n   617→  end\n   618→\n   619→  defp validate_server_identifier(nil, :renewing), do: :ok\n   620→  defp validate_server_identifier(nil, :rebinding), do: :ok\n   621→  defp validate_server_identifier(nil, _), do: :ok\n   622→\n   623→  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n   624→    # Get our server identifier (gateway IP from default pool)\n   625→    our_server_id = get_server_identifier()\n   626→\n   627→    if server_id == our_server_id do\n   628→      :ok\n   629→    else\n   630→      {:error, :wrong_server}\n   631→    end\n   632→  end\n   633→\n   634→  defp determine_request_state(request) do\n   635→    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n   636→    server_id = get_server_id_from_options(request.options)\n   637→    requested_ip = get_requested_ip(request)\n   638→    ciaddr = request.ciaddr\n   639→\n   640→    cond do\n   641→      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n   642→      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n   643→        :selecting\n   644→\n   645→      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n   646→      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n   647→        :init_reboot\n   648→\n   649→      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n   650→      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n   651→        :renewing\n   652→\n   653→      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n   654→      ciaddr != 0 && server_id == nil ->\n   655→        :rebinding\n   656→\n   657→      # Default to selecting if we can't determine\n   658→      true ->\n   659→        :selecting\n   660→    end\n   661→  end\n   662→\n   663→  defp integer_to_ip_tuple(0), do: nil\n   664→\n   665→  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n   666→    a = div(ip_int, 256 * 256 * 256)\n   667→    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n   668→    c = div(rem(ip_int, 256 * 256), 256)\n   669→    d = rem(ip_int, 256)\n   670→    {a, b, c, d}\n   671→  end\n   672→\n   673→  defp get_server_identifier do\n   674→    # Get the gateway IP from the default pool as our server identifier\n   675→    pool = get_default_pool()\n   676→    ip_to_binary(pool.gateway)\n   677→  end\n   678→\n   679→  defp get_requested_ip(request) do\n   680→    Enum.find_value(request.options, fn option ->\n   681→      if option.type == 50, do: binary_to_ip(option.value), else: nil\n   682→    end)\n   683→  end\n   684→\n   685→  defp get_dhcp_message_type(message) do\n   686→    Enum.find_value(message.options, 0, fn option ->\n   687→      if option.type == 53, do: decode_message_type(option.value), else: nil\n   688→    end)\n   689→  end\n   690→\n   691→  defp decode_message_type(<<1>>), do: :discover\n   692→  defp decode_message_type(<<2>>), do: :offer\n   693→  defp decode_message_type(<<3>>), do: :request\n   694→  defp decode_message_type(<<4>>), do: :decline\n   695→  defp decode_message_type(<<5>>), do: :ack\n   696→  defp decode_message_type(<<6>>), do: :nak\n   697→  defp decode_message_type(<<7>>), do: :release\n   698→  defp decode_message_type(<<8>>), do: :inform\n   699→  defp decode_message_type(_), do: 0\n   700→\n   701→  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n   702→  defp binary_to_ip(_), do: nil\n   703→\n   704→  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n   705→  defp ip_to_binary(_), do: <<192, 168, 1, 1>>\n   706→\n   707→  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n   708→  defp ip_tuple_to_integer({a, b, c, d})\n   709→       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n   710→    <<integer::32>> = <<a, b, c, d>>\n   711→    integer\n   712→  end\n   713→\n   714→  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n   715→  defp ip_tuple_to_integer(_), do: 0\n   716→end\n   717→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01EcuPGge8XqrpRzcMMHw2DQ","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"c14d3b2e-2684-4319-b563-5d032688a267","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv4/lib/yellow_dog/dhcpv4/handler.ex","content":"defmodule YellowDog.Dhcpv4.Handler do\n  @moduledoc \"\"\"\n  DHCPv4 message handler using the Abyss.Handler behaviour.\n\n  Processes incoming DHCPv4 messages and implements the DHCP server logic\n  for handling DHCPDISCOVER, DHCPOFFER, DHCPREQUEST, DHCPACK, and DHCPNAK\n  messages. Emits telemetry events for monitoring and debugging.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv4.LeaseManager\n\n  # Telemetry events are handled via :telemetry directly\n\n  @doc \"\"\"\n  Handles incoming DHCPv4 messages from clients.\n\n  ## Parameters\n  - `{ip, port, data}`: Tuple containing client IP, port, and message data\n  - `state`: Handler state containing socket information\n\n  ## Returns\n  - `{:continue, state}` - Continue handling more packets\n  - `{:close, state}` - Close connection after response\n  \"\"\"\n  @impl true\n  def handle_data({ip, port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    try do\n      message = DHCPv4.Message.from_iodata(data)\n\n      # Emit telemetry event for message received\n      :telemetry.execute(\n        [:yellow_dog, :dhcpv4, :message_received],\n        %{duration: System.monotonic_time(:microsecond) - start_time},\n        %{client_ip: ip, client_port: port, message_type: message.op}\n      )\n\n      # Process the DHCP message\n      handle_dhcp_message(message, ip, port, state, start_time)\n    rescue\n      e ->\n        # Emit telemetry event for error\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :error],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: ip, client_port: port, error: Exception.message(e)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @impl true\n  def handle_error(reason, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(reason)}\n    )\n\n    {:continue, state}\n  end\n\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private helper functions\n\n  defp handle_dhcp_message(message, client_ip, client_port, state, start_time) do\n    case message.op do\n      # BOOTREQUEST\n      1 ->\n        handle_boot_request(message, client_ip, client_port, state, start_time)\n\n      # BOOTREPLY\n      2 ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: :bootreply, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      op ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unknown],\n          %{count: 1},\n          %{operation: op}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_boot_request(message, client_ip, client_port, state, start_time) do\n    case get_dhcp_message_type(message) do\n      :discover ->\n        handle_dhcp_discover(message, client_ip, client_port, state, start_time)\n\n      :request ->\n        handle_dhcp_request(message, client_ip, client_port, state, start_time)\n\n      :decline ->\n        handle_dhcp_decline(message, client_ip, client_port, state, start_time)\n\n      :release ->\n        handle_dhcp_release(message, client_ip, client_port, state, start_time)\n\n      :inform ->\n        handle_dhcp_inform(message, client_ip, client_port, state, start_time)\n\n      msg_type when msg_type in [:offer, :ack, :nak] ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unexpected],\n          %{count: 1},\n          %{message_type: msg_type, reason: \"should not happen on server\"}\n        )\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :message, :unsupported],\n          %{count: 1},\n          %{reason: \"missing or unsupported message type option\"}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_dhcp_discover(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr, message_type: :discover}\n    )\n\n    # Generate a DHCPOFFER response\n    case create_dhcp_offer(message, client_ip) do\n      nil ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :offer, :failed],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: \"could not create offer\"}\n        )\n\n      offer ->\n        send_dhcp_response(offer, client_ip, client_port, state)\n    end\n\n    # Emit telemetry event\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :discover_handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_request(message, client_ip, client_port, state, start_time) do\n    # Determine REQUEST state: SELECTING, INIT-REBOOT, RENEWING, or REBINDING\n    request_state = determine_request_state(message)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :requested],\n      %{count: 1},\n      %{\n        client_ip: client_ip,\n        client_mac: message.chaddr,\n        message_type: :request,\n        state: request_state\n      }\n    )\n\n    # Generate a DHCPACK or DHCPNAK response based on state\n    case create_dhcp_ack(message, client_ip, request_state) do\n      {:ok, ack} ->\n        send_dhcp_response(ack, client_ip, client_port, state)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :granted],\n          %{duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_mac: message.chaddr, state: request_state}\n        )\n\n      {:nak, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :lease, :rejected],\n          %{count: 1},\n          %{client_mac: message.chaddr, reason: reason, state: request_state}\n        )\n\n        nak = build_dhcp_nak(message, reason)\n        send_dhcp_response(nak, client_ip, client_port, state)\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_decline(message, client_ip, _client_port, state, start_time) do\n    # Get the declined IP address\n    declined_ip = get_requested_ip(message) || client_ip\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :declined],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr, declined_ip: declined_ip}\n    )\n\n    # Mark the IP as declined in LeaseManager\n    LeaseManager.decline_ip(declined_ip, message.chaddr)\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_release(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :lease, :released],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Release the lease for this MAC address\n    LeaseManager.release_lease(message.chaddr)\n\n    {:continue, state}\n  end\n\n  defp handle_dhcp_inform(message, client_ip, _client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :received],\n      %{count: 1},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    # Handle inform - provide configuration parameters only\n    ack = create_dhcp_ack_inform(message, client_ip)\n    # Send to client port 68\n    send_dhcp_response(ack, client_ip, 68, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv4, :inform, :handled],\n      %{duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip, client_mac: message.chaddr}\n    )\n\n    {:continue, state}\n  end\n\n  defp create_dhcp_offer(discover, _client_ip) do\n    # Extract hostname and client identifier from options if present\n    hostname = get_hostname_from_options(discover.options)\n    client_id = get_client_id_from_options(discover.options)\n\n    # Try to allocate a lease from LeaseManager\n    case LeaseManager.allocate_lease(discover.chaddr, nil, hostname, \"default\", client_id) do\n      {:ok, lease} ->\n        # Build DHCPOFFER with lease information\n        build_dhcp_offer(discover, lease)\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: discover.chaddr, operation: :offer}\n        )\n\n        nil\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :offer, :error],\n          %{count: 1},\n          %{client_mac: discover.chaddr, reason: inspect(reason)}\n        )\n\n        nil\n    end\n  end\n\n  defp build_dhcp_offer(discover, lease) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, discover.htype)\n    |> Map.put(:hlen, discover.hlen)\n    |> Map.put(:xid, discover.xid)\n    |> Map.put(:flags, discover.flags)\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(discover.giaddr))\n    |> Map.put(:chaddr, discover.chaddr)\n    |> Map.put(:options, build_dhcp_options(2, pool, lease))\n  end\n\n  defp create_dhcp_ack(request, _client_ip, request_state) do\n    # Extract hostname, requested IP, and client identifier\n    hostname = get_hostname_from_options(request.options)\n    client_id = get_client_id_from_options(request.options)\n    server_id = get_server_id_from_options(request.options)\n\n    # Get requested IP based on state\n    requested_ip =\n      case request_state do\n        :renewing ->\n          # For RENEWING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        :rebinding ->\n          # For REBINDING, use ciaddr (client's current IP)\n          integer_to_ip_tuple(request.ciaddr)\n\n        _ ->\n          # For SELECTING and INIT-REBOOT, use Requested IP Address option\n          get_requested_ip(request)\n      end\n\n    # Validate server identifier if present (RFC 2131 Section 4.3.2)\n    # For SELECTING state, server identifier is required and must match\n    case validate_server_identifier(server_id, request_state) do\n      :ok ->\n        # Server ID is valid, proceed with lease allocation\n        allocate_and_respond(request, requested_ip, hostname, client_id)\n\n      {:error, :wrong_server} ->\n        # Client is requesting from a different server, silently ignore\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :request, :ignored],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: \"non-matching server identifier\"}\n        )\n\n        {:nak, \"Wrong server identifier\"}\n    end\n  end\n\n  defp allocate_and_respond(request, requested_ip, hostname, client_id) do\n    # Try to allocate/renew lease\n    case LeaseManager.allocate_lease(request.chaddr, requested_ip, hostname, \"default\", client_id) do\n      {:ok, lease} ->\n        ack = build_dhcp_ack(request, lease)\n        {:ok, ack}\n\n      {:error, :pool_exhausted} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :exhausted],\n          %{count: 1},\n          %{client_mac: request.chaddr, operation: :ack}\n        )\n\n        {:nak, \"Address pool exhausted\"}\n\n      {:error, :pool_not_found} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :pool, :not_found],\n          %{count: 1},\n          %{client_mac: request.chaddr}\n        )\n\n        {:nak, \"Invalid network or pool\"}\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :ack, :error],\n          %{count: 1},\n          %{client_mac: request.chaddr, reason: inspect(reason)}\n        )\n\n        {:nak, \"Lease allocation failed: #{inspect(reason)}\"}\n    end\n  end\n\n  defp build_dhcp_ack(request, lease) do\n    # Get pool configuration for network parameters\n    pool = get_pool_for_lease(lease)\n\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(request.ciaddr))\n    |> Map.put(:yiaddr, ip_tuple_to_integer(lease.ip_address))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(request.giaddr))\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_options(5, pool, lease))\n  end\n\n  defp build_dhcp_nak(request, reason) do\n    # Get default pool for server identifier\n    pool = get_default_pool()\n\n    # Build DHCPNAK message according to RFC 2131\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, request.htype)\n    |> Map.put(:hlen, request.hlen)\n    |> Map.put(:xid, request.xid)\n    |> Map.put(:flags, request.flags)\n    # RFC 2131: ciaddr, yiaddr, siaddr, and giaddr are set to 0\n    |> Map.put(:ciaddr, 0)\n    |> Map.put(:yiaddr, 0)\n    |> Map.put(:siaddr, 0)\n    |> Map.put(:giaddr, 0)\n    |> Map.put(:chaddr, request.chaddr)\n    |> Map.put(:options, build_dhcp_nak_options(pool, reason))\n  end\n\n  defp build_dhcp_nak_options(pool, reason) do\n    # DHCPNAK options per RFC 2131\n    base_options = [\n      # Message type = 6 (DHCPNAK)\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<6>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)}\n    ]\n\n    # Add message option if reason is provided\n    options_with_message =\n      if reason && is_binary(reason) && byte_size(reason) > 0 do\n        message_value = :binary.copy(reason)\n\n        base_options ++\n          [\n            %DHCPv4.Message.Option{\n              type: 56,\n              length: byte_size(message_value),\n              value: message_value\n            }\n          ]\n      else\n        base_options\n      end\n\n    # Add end option\n    options_with_message ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp create_dhcp_ack_inform(inform, client_ip) do\n    # Build a DHCPACK response for DHCPINFORM (no address allocation)\n    # Use first available pool for configuration parameters\n    case LeaseManager.list_leases() do\n      [] ->\n        # No leases, use default pool\n        pool = get_default_pool()\n        build_dhcp_ack_inform(inform, client_ip, pool)\n\n      [lease | _] ->\n        # Use pool from an existing lease\n        pool = get_pool_for_lease(lease)\n        build_dhcp_ack_inform(inform, client_ip, pool)\n    end\n  end\n\n  defp build_dhcp_ack_inform(inform, client_ip, pool) do\n    DHCPv4.Message.new()\n    # BOOTREPLY = 2\n    |> Map.put(:op, 2)\n    |> Map.put(:htype, inform.htype)\n    |> Map.put(:hlen, inform.hlen)\n    |> Map.put(:xid, inform.xid)\n    |> Map.put(:flags, inform.flags)\n    |> Map.put(:ciaddr, ip_tuple_to_integer(client_ip))\n    |> Map.put(:siaddr, ip_tuple_to_integer(pool.gateway))\n    |> Map.put(:giaddr, ip_tuple_to_integer(inform.giaddr))\n    |> Map.put(:chaddr, inform.chaddr)\n    |> Map.put(:options, [\n      # DHCPACK = 5\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<5>>},\n      # server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      # DNS servers\n      %DHCPv4.Message.Option{type: 6, length: 4, value: encode_dns_servers(pool.dns_servers)},\n      # :end\n      %DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}\n    ])\n  end\n\n  defp send_dhcp_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    # Send response to client (port 67 for broadcast, 68 for unicast)\n    response_port = if client_port == 67, do: 68, else: client_port\n\n    case :gen_udp.send(state.socket, client_ip, response_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :sent],\n          %{count: 1, bytes: IO.iodata_length(data)},\n          %{client_ip: client_ip, client_port: response_port}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv4, :response, :error],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: response_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Helper functions for building DHCP responses\n\n  defp build_dhcp_options(message_type, pool, lease) do\n    lease_time_binary = <<lease.lease_time::32>>\n    dns_servers_binary = encode_dns_servers(pool.dns_servers)\n\n    base_options = [\n      # Message type\n      %DHCPv4.Message.Option{type: 53, length: 1, value: <<message_type>>},\n      # Server identifier\n      %DHCPv4.Message.Option{type: 54, length: 4, value: ip_to_binary(pool.gateway)},\n      # Lease time\n      %DHCPv4.Message.Option{type: 51, length: 4, value: lease_time_binary},\n      # Subnet mask\n      %DHCPv4.Message.Option{type: 1, length: 4, value: ip_to_binary(pool.subnet_mask)},\n      # Router\n      %DHCPv4.Message.Option{type: 3, length: 4, value: ip_to_binary(pool.gateway)},\n      %DHCPv4.Message.Option{\n        type: 6,\n        length: byte_size(dns_servers_binary),\n        # DNS servers\n        value: dns_servers_binary\n      }\n    ]\n\n    # Add domain name if present\n    options_with_domain =\n      case pool.domain_name do\n        nil ->\n          base_options\n\n        \"\" ->\n          base_options\n\n        domain ->\n          base_options ++\n            [%DHCPv4.Message.Option{type: 15, length: byte_size(domain), value: domain}]\n      end\n\n    # Add end option\n    options_with_domain ++ [%DHCPv4.Message.Option{type: 255, length: 0, value: <<>>}]\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use the first pool from LeaseManager state\n    # In a production system, you'd look up the pool by name from _lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    # Return a default pool configuration\n    # This should be retrieved from configuration or LeaseManager state\n    %{\n      name: \"default\",\n      range_start: {192, 168, 1, 100},\n      range_end: {192, 168, 1, 200},\n      subnet_mask: {255, 255, 255, 0},\n      gateway: {192, 168, 1, 1},\n      dns_servers: [{192, 168, 1, 1}, {8, 8, 8, 8}],\n      domain_name: \"local\",\n      lease_time: 86400\n    }\n  end\n\n  defp encode_dns_servers(dns_servers) do\n    dns_servers\n    |> Enum.map(&ip_to_binary/1)\n    |> Enum.join()\n  end\n\n  defp get_hostname_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 12 is hostname\n      if option.type == 12, do: option.value, else: nil\n    end)\n  end\n\n  defp get_client_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 61 is client identifier\n      if option.type == 61, do: option.value, else: nil\n    end)\n  end\n\n  defp get_server_id_from_options(options) do\n    Enum.find_value(options, fn option ->\n      # Option 54 is server identifier\n      if option.type == 54, do: option.value, else: nil\n    end)\n  end\n\n  defp validate_server_identifier(nil, :renewing), do: :ok\n  defp validate_server_identifier(nil, :rebinding), do: :ok\n  defp validate_server_identifier(nil, _), do: :ok\n\n  defp validate_server_identifier(server_id, _request_state) when is_binary(server_id) do\n    # Get our server identifier (gateway IP from default pool)\n    our_server_id = get_server_identifier()\n\n    if server_id == our_server_id do\n      :ok\n    else\n      {:error, :wrong_server}\n    end\n  end\n\n  defp determine_request_state(request) do\n    # Determine REQUEST state based on RFC 2131 Section 4.3.2\n    server_id = get_server_id_from_options(request.options)\n    requested_ip = get_requested_ip(request)\n    ciaddr = request.ciaddr\n\n    cond do\n      # SELECTING: Server Identifier and Requested IP present, ciaddr is 0\n      server_id != nil && requested_ip != nil && ciaddr == 0 ->\n        :selecting\n\n      # INIT-REBOOT: Requested IP present, no Server Identifier, ciaddr is 0\n      requested_ip != nil && server_id == nil && ciaddr == 0 ->\n        :init_reboot\n\n      # RENEWING: ciaddr filled in, no Requested IP or Server Identifier\n      ciaddr != 0 && requested_ip == nil && server_id == nil ->\n        :renewing\n\n      # REBINDING: ciaddr filled in, may have Requested IP but no Server Identifier\n      ciaddr != 0 && server_id == nil ->\n        :rebinding\n\n      # Default to selecting if we can't determine\n      true ->\n        :selecting\n    end\n  end\n\n  defp integer_to_ip_tuple(0), do: nil\n\n  defp integer_to_ip_tuple(ip_int) when is_integer(ip_int) do\n    a = div(ip_int, 256 * 256 * 256)\n    b = div(rem(ip_int, 256 * 256 * 256), 256 * 256)\n    c = div(rem(ip_int, 256 * 256), 256)\n    d = rem(ip_int, 256)\n    {a, b, c, d}\n  end\n\n  defp get_server_identifier do\n    # Get the gateway IP from the default pool as our server identifier\n    pool = get_default_pool()\n    ip_to_binary(pool.gateway)\n  end\n\n  defp get_requested_ip(request) do\n    Enum.find_value(request.options, fn option ->\n      if option.type == 50, do: binary_to_ip(option.value), else: nil\n    end)\n  end\n\n  defp get_dhcp_message_type(message) do\n    Enum.find_value(message.options, 0, fn option ->\n      if option.type == 53, do: decode_message_type(option.value), else: nil\n    end)\n  end\n\n  defp decode_message_type(<<1>>), do: :discover\n  defp decode_message_type(<<2>>), do: :offer\n  defp decode_message_type(<<3>>), do: :request\n  defp decode_message_type(<<4>>), do: :decline\n  defp decode_message_type(<<5>>), do: :ack\n  defp decode_message_type(<<6>>), do: :nak\n  defp decode_message_type(<<7>>), do: :release\n  defp decode_message_type(<<8>>), do: :inform\n  defp decode_message_type(_), do: 0\n\n  defp binary_to_ip(<<a, b, c, d>>), do: {a, b, c, d}\n  defp binary_to_ip(_), do: nil\n\n  defp ip_to_binary({a, b, c, d}), do: <<a, b, c, d>>\n  defp ip_to_binary(_), do: <<192, 168, 1, 1>>\n\n  # Convert IP tuple to 32-bit integer for DHCPv4 message fields\n  defp ip_tuple_to_integer({a, b, c, d})\n       when is_integer(a) and is_integer(b) and is_integer(c) and is_integer(d) do\n    <<integer::32>> = <<a, b, c, d>>\n    integer\n  end\n\n  defp ip_tuple_to_integer(integer) when is_integer(integer), do: integer\n  defp ip_tuple_to_integer(_), do: 0\nend\n","numLines":717,"startLine":1,"totalLines":717}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GGuCD6fdjWU8gcyaRTG4cx","type":"tool_result","content":"     1→defmodule YellowDog.Mdns.Handler do\n     2→  @moduledoc \"\"\"\n     3→  mDNS message handler using Abyss.Handler behaviour.\n     4→\n     5→  Supports three modes:\n     6→  - :listener - Passive listening only (caches messages)\n     7→  - :responder - Active response only (answers queries)\n     8→  - :hybrid - Both listening and responding (recommended)\n     9→  \"\"\"\n    10→\n    11→  use Abyss.Handler\n    12→\n    13→  alias YellowDog.Mdns.{MessageCache, NetworkMonitor, Responder, ServiceRegistry}\n    14→\n    15→  @doc \"\"\"\n    16→  Handles incoming mDNS data packets.\n    17→\n    18→  Routes messages based on mode:\n    19→  - Queries → Responder (if responder mode)\n    20→  - Responses → NetworkMonitor (if listener/hybrid mode)\n    21→  \"\"\"\n    22→  @impl true\n    23→  def handle_data({ip, port, data}, state) do\n    24→    start_time = System.monotonic_time(:microsecond)\n    25→\n    26→    # Emit telemetry event for message reception\n    27→    :telemetry.execute(\n    28→      [:yellow_dog, :mdns, :message_received],\n    29→      %{bytes: byte_size(data)},\n    30→      %{source_ip: ip, source_port: port}\n    31→    )\n    32→\n    33→    try do\n    34→      message = DNS.Message.from_iodata(data)\n    35→      mode = Map.get(state, :mode, :hybrid)\n    36→      handle_dns_message(message, ip, port, state, start_time, mode)\n    37→    rescue\n    38→      e ->\n    39→        :telemetry.execute(\n    40→          [:yellow_dog, :mdns, :message, :parse_error],\n    41→          %{count: 1, bytes: byte_size(data)},\n    42→          %{reason: inspect(e), source_ip: ip, source_port: port}\n    43→        )\n    44→\n    45→        {:continue, state}\n    46→    end\n    47→  rescue\n    48→    e ->\n    49→      :telemetry.execute(\n    50→        [:yellow_dog, :mdns, :handler, :error],\n    51→        %{count: 1, bytes: byte_size(data)},\n    52→        %{error: inspect(e), source_ip: ip, source_port: port}\n    53→      )\n    54→\n    55→      {:continue, state}\n    56→  catch\n    57→    e ->\n    58→      :telemetry.execute(\n    59→        [:yellow_dog, :mdns, :handler, :error],\n    60→        %{count: 1, bytes: byte_size(data)},\n    61→        %{error: inspect(e), source_ip: ip, source_port: port}\n    62→      )\n    63→\n    64→      {:continue, state}\n    65→  end\n    66→\n    67→  @doc \"\"\"\n    68→  Handles error events.\n    69→  \"\"\"\n    70→  @impl true\n    71→  def handle_error(error, state) do\n    72→    :telemetry.execute(\n    73→      [:yellow_dog, :mdns, :handler, :error],\n    74→      %{count: 1},\n    75→      %{reason: inspect(error)}\n    76→    )\n    77→\n    78→    {:continue, state}\n    79→  end\n    80→\n    81→  @doc \"\"\"\n    82→  Handles timeout events for mDNS connections.\n    83→  \"\"\"\n    84→  @impl true\n    85→  def handle_timeout(state) do\n    86→    :telemetry.execute(\n    87→      [:yellow_dog, :mdns, :handler, :timeout],\n    88→      %{count: 1},\n    89→      %{}\n    90→    )\n    91→\n    92→    {:continue, state}\n    93→  end\n    94→\n    95→  # Private functions\n    96→\n    97→  defp handle_dns_message(message, ip, port, state, start_time, mode) do\n    98→    is_query = message.header.qr == 0\n    99→    message_type = if is_query, do: :query, else: :response\n   100→    question_count = length(message.qdlist)\n   101→    answer_count = length(message.anlist)\n   102→\n   103→    # Check if this is a .local domain message\n   104→    if has_local_domain?(message) do\n   105→      # Route based on message type and mode\n   106→      case {is_query, mode} do\n   107→        # Query in responder or hybrid mode → try to respond\n   108→        {true, mode} when mode in [:responder, :hybrid] ->\n   109→          handle_query(message, ip, port, state, start_time)\n   110→\n   111→        # Query in listener mode → just log it\n   112→        {true, :listener} ->\n   113→          NetworkMonitor.log_query(message, ip, port)\n   114→\n   115→        # Response in listener or hybrid mode → cache it\n   116→        {false, mode} when mode in [:listener, :hybrid] ->\n   117→          NetworkMonitor.cache_response(message, ip, port)\n   118→          # Also update legacy MessageCache for backward compatibility\n   119→          MessageCache.cache_message(message, ip, port)\n   120→\n   121→        # Response in responder mode → ignore\n   122→        {false, :responder} ->\n   123→          :ok\n   124→      end\n   125→\n   126→      # Emit telemetry event\n   127→      end_time = System.monotonic_time(:microsecond)\n   128→      duration = end_time - start_time\n   129→\n   130→      :telemetry.execute(\n   131→        [:yellow_dog, :mdns, :message_processed],\n   132→        %{\n   133→          duration: duration,\n   134→          question_count: question_count,\n   135→          answer_count: answer_count,\n   136→          authority_count: length(message.nslist),\n   137→          additional_count: length(message.arlist)\n   138→        },\n   139→        %{source_ip: ip, source_port: port, message_type: message_type, mode: mode}\n   140→      )\n   141→    else\n   142→      :telemetry.execute(\n   143→        [:yellow_dog, :mdns, :message, :ignored],\n   144→        %{count: 1},\n   145→        %{reason: :non_local_domain, source_ip: ip, source_port: port}\n   146→      )\n   147→    end\n   148→\n   149→    {:continue, state}\n   150→  end\n   151→\n   152→  defp handle_query(query, ip, _port, state, _start_time) do\n   153→    # Get matching services from registry\n   154→    services = ServiceRegistry.get_records_for_query(query.qdlist)\n   155→\n   156→    if Enum.empty?(services) do\n   157→      :telemetry.execute(\n   158→        [:yellow_dog, :mdns, :query, :no_match],\n   159→        %{count: 1},\n   160→        %{source_ip: ip}\n   161→      )\n   162→\n   163→      :ok\n   164→    else\n   165→      :telemetry.execute(\n   166→        [:yellow_dog, :mdns, :query, :matched],\n   167→        %{count: 1, service_count: length(services)},\n   168→        %{source_ip: ip}\n   169→      )\n   170→\n   171→      # Check if we should respond (known-answer suppression)\n   172→      if Responder.should_respond?(query, services) do\n   173→        # Build response\n   174→        response = Responder.build_response(query, services)\n   175→\n   176→        # Validate size\n   177→        case Responder.validate_response_size(response) do\n   178→          {:ok, validated_response} ->\n   179→            # Send response via multicast\n   180→            send_multicast_response(validated_response, state)\n   181→\n   182→            :telemetry.execute(\n   183→              [:yellow_dog, :mdns, :response, :sent],\n   184→              %{count: 1, service_count: length(services)},\n   185→              %{}\n   186→            )\n   187→\n   188→          {:error, :too_large, size} ->\n   189→            :telemetry.execute(\n   190→              [:yellow_dog, :mdns, :response, :too_large],\n   191→              %{count: 1, size: size},\n   192→              %{}\n   193→            )\n   194→        end\n   195→      end\n   196→    end\n   197→\n   198→    :ok\n   199→  end\n   200→\n   201→  defp send_multicast_response(message, _state) do\n   202→    # Convert DNS message to binary\n   203→    response_data = DNS.to_iodata(message) |> IO.iodata_to_binary()\n   204→\n   205→    # Send via Server module\n   206→    YellowDog.Mdns.Server.send_multicast(response_data)\n   207→  rescue\n   208→    e ->\n   209→      :telemetry.execute(\n   210→        [:yellow_dog, :mdns, :response, :send_failed],\n   211→        %{count: 1},\n   212→        %{reason: inspect(e)}\n   213→      )\n   214→\n   215→      :ok\n   216→  end\n   217→\n   218→  defp has_local_domain?(message) do\n   219→    # Check questions\n   220→    local_in_questions =\n   221→      Enum.any?(message.qdlist, fn question ->\n   222→        is_local_domain?(to_string(question.name))\n   223→      end)\n   224→\n   225→    # Check answers\n   226→    local_in_answers =\n   227→      Enum.any?(message.anlist, fn record ->\n   228→        is_local_domain?(to_string(record.name))\n   229→      end)\n   230→\n   231→    # Check authority records\n   232→    local_in_authority =\n   233→      Enum.any?(message.nslist, fn record ->\n   234→        is_local_domain?(to_string(record.name))\n   235→      end)\n   236→\n   237→    # Check additional records\n   238→    local_in_additional =\n   239→      Enum.any?(message.arlist, fn record ->\n   240→        is_local_domain?(to_string(record.name))\n   241→      end)\n   242→\n   243→    local_in_questions || local_in_answers || local_in_authority || local_in_additional\n   244→  end\n   245→\n   246→  defp is_local_domain?(domain) when is_binary(domain) do\n   247→    String.ends_with?(domain, \".local\") || String.ends_with?(domain, \".local.\")\n   248→  end\n   249→\n   250→  defp is_local_domain?(_), do: false\n   251→end\n   252→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01EcuPGge8XqrpRzcMMHw2DQ","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"869aa679-6fda-4f4a-9359-1181224dd3e2","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_mdns/lib/yellow_dog/mdns/handler.ex","content":"defmodule YellowDog.Mdns.Handler do\n  @moduledoc \"\"\"\n  mDNS message handler using Abyss.Handler behaviour.\n\n  Supports three modes:\n  - :listener - Passive listening only (caches messages)\n  - :responder - Active response only (answers queries)\n  - :hybrid - Both listening and responding (recommended)\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Mdns.{MessageCache, NetworkMonitor, Responder, ServiceRegistry}\n\n  @doc \"\"\"\n  Handles incoming mDNS data packets.\n\n  Routes messages based on mode:\n  - Queries → Responder (if responder mode)\n  - Responses → NetworkMonitor (if listener/hybrid mode)\n  \"\"\"\n  @impl true\n  def handle_data({ip, port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    # Emit telemetry event for message reception\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :message_received],\n      %{bytes: byte_size(data)},\n      %{source_ip: ip, source_port: port}\n    )\n\n    try do\n      message = DNS.Message.from_iodata(data)\n      mode = Map.get(state, :mode, :hybrid)\n      handle_dns_message(message, ip, port, state, start_time, mode)\n    rescue\n      e ->\n        :telemetry.execute(\n          [:yellow_dog, :mdns, :message, :parse_error],\n          %{count: 1, bytes: byte_size(data)},\n          %{reason: inspect(e), source_ip: ip, source_port: port}\n        )\n\n        {:continue, state}\n    end\n  rescue\n    e ->\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :handler, :error],\n        %{count: 1, bytes: byte_size(data)},\n        %{error: inspect(e), source_ip: ip, source_port: port}\n      )\n\n      {:continue, state}\n  catch\n    e ->\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :handler, :error],\n        %{count: 1, bytes: byte_size(data)},\n        %{error: inspect(e), source_ip: ip, source_port: port}\n      )\n\n      {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles error events.\n  \"\"\"\n  @impl true\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles timeout events for mDNS connections.\n  \"\"\"\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :mdns, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions\n\n  defp handle_dns_message(message, ip, port, state, start_time, mode) do\n    is_query = message.header.qr == 0\n    message_type = if is_query, do: :query, else: :response\n    question_count = length(message.qdlist)\n    answer_count = length(message.anlist)\n\n    # Check if this is a .local domain message\n    if has_local_domain?(message) do\n      # Route based on message type and mode\n      case {is_query, mode} do\n        # Query in responder or hybrid mode → try to respond\n        {true, mode} when mode in [:responder, :hybrid] ->\n          handle_query(message, ip, port, state, start_time)\n\n        # Query in listener mode → just log it\n        {true, :listener} ->\n          NetworkMonitor.log_query(message, ip, port)\n\n        # Response in listener or hybrid mode → cache it\n        {false, mode} when mode in [:listener, :hybrid] ->\n          NetworkMonitor.cache_response(message, ip, port)\n          # Also update legacy MessageCache for backward compatibility\n          MessageCache.cache_message(message, ip, port)\n\n        # Response in responder mode → ignore\n        {false, :responder} ->\n          :ok\n      end\n\n      # Emit telemetry event\n      end_time = System.monotonic_time(:microsecond)\n      duration = end_time - start_time\n\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :message_processed],\n        %{\n          duration: duration,\n          question_count: question_count,\n          answer_count: answer_count,\n          authority_count: length(message.nslist),\n          additional_count: length(message.arlist)\n        },\n        %{source_ip: ip, source_port: port, message_type: message_type, mode: mode}\n      )\n    else\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :message, :ignored],\n        %{count: 1},\n        %{reason: :non_local_domain, source_ip: ip, source_port: port}\n      )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_query(query, ip, _port, state, _start_time) do\n    # Get matching services from registry\n    services = ServiceRegistry.get_records_for_query(query.qdlist)\n\n    if Enum.empty?(services) do\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :query, :no_match],\n        %{count: 1},\n        %{source_ip: ip}\n      )\n\n      :ok\n    else\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :query, :matched],\n        %{count: 1, service_count: length(services)},\n        %{source_ip: ip}\n      )\n\n      # Check if we should respond (known-answer suppression)\n      if Responder.should_respond?(query, services) do\n        # Build response\n        response = Responder.build_response(query, services)\n\n        # Validate size\n        case Responder.validate_response_size(response) do\n          {:ok, validated_response} ->\n            # Send response via multicast\n            send_multicast_response(validated_response, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :mdns, :response, :sent],\n              %{count: 1, service_count: length(services)},\n              %{}\n            )\n\n          {:error, :too_large, size} ->\n            :telemetry.execute(\n              [:yellow_dog, :mdns, :response, :too_large],\n              %{count: 1, size: size},\n              %{}\n            )\n        end\n      end\n    end\n\n    :ok\n  end\n\n  defp send_multicast_response(message, _state) do\n    # Convert DNS message to binary\n    response_data = DNS.to_iodata(message) |> IO.iodata_to_binary()\n\n    # Send via Server module\n    YellowDog.Mdns.Server.send_multicast(response_data)\n  rescue\n    e ->\n      :telemetry.execute(\n        [:yellow_dog, :mdns, :response, :send_failed],\n        %{count: 1},\n        %{reason: inspect(e)}\n      )\n\n      :ok\n  end\n\n  defp has_local_domain?(message) do\n    # Check questions\n    local_in_questions =\n      Enum.any?(message.qdlist, fn question ->\n        is_local_domain?(to_string(question.name))\n      end)\n\n    # Check answers\n    local_in_answers =\n      Enum.any?(message.anlist, fn record ->\n        is_local_domain?(to_string(record.name))\n      end)\n\n    # Check authority records\n    local_in_authority =\n      Enum.any?(message.nslist, fn record ->\n        is_local_domain?(to_string(record.name))\n      end)\n\n    # Check additional records\n    local_in_additional =\n      Enum.any?(message.arlist, fn record ->\n        is_local_domain?(to_string(record.name))\n      end)\n\n    local_in_questions || local_in_answers || local_in_authority || local_in_additional\n  end\n\n  defp is_local_domain?(domain) when is_binary(domain) do\n    String.ends_with?(domain, \".local\") || String.ends_with?(domain, \".local.\")\n  end\n\n  defp is_local_domain?(_), do: false\nend\n","numLines":252,"startLine":1,"totalLines":252}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JuGnj5mjJLVRxZdqrqBAdD","type":"tool_result","content":"     1→defmodule Abyss.Transport.UDP.Core do\n     2→  @moduledoc \"\"\"\n     3→  Core UDP transport functionality shared between Unicast and Broadcast transports.\n     4→\n     5→  This module contains common UDP socket operations that are used by both\n     6→  `Abyss.Transport.UDP.Unicast` and `Abyss.Transport.UDP.Broadcast` to avoid\n     7→  code duplication.\n     8→\n     9→  ## Shared Operations\n    10→\n    11→  - Socket control and ownership transfer\n    12→  - Data receiving and sending\n    13→  - Socket option management\n    14→  - Socket information retrieval\n    15→  - Connection statistics\n    16→\n    17→  This module is not meant to be used directly. Use the specific transport\n    18→  modules instead:\n    19→  - `Abyss.Transport.UDP.Unicast` for unicast traffic\n    20→  - `Abyss.Transport.UDP.Broadcast` for broadcast/multicast traffic\n    21→  \"\"\"\n    22→\n    23→  @doc \"\"\"\n    24→  Transfers ownership of the given socket to the given process.\n    25→  \"\"\"\n    26→  @spec controlling_process(Abyss.Transport.socket(), pid()) ::\n    27→          Abyss.Transport.on_controlling_process()\n    28→  defdelegate controlling_process(socket, pid), to: :gen_udp\n    29→\n    30→  @doc \"\"\"\n    31→  Receives data from a UDP socket.\n    32→  \"\"\"\n    33→  @spec recv(Abyss.Transport.socket(), non_neg_integer(), timeout()) ::\n    34→          Abyss.Transport.on_recv()\n    35→  defdelegate recv(socket, length, timeout), to: :gen_udp\n    36→\n    37→  @spec recv(Abyss.Transport.socket(), non_neg_integer()) :: Abyss.Transport.on_recv()\n    38→  defdelegate recv(socket, length), to: :gen_udp\n    39→\n    40→  @doc \"\"\"\n    41→  Sends data on a UDP socket.\n    42→  \"\"\"\n    43→  @spec send(Abyss.Transport.socket(), iodata()) :: Abyss.Transport.on_send()\n    44→  defdelegate send(socket, data), to: :gen_udp\n    45→  defdelegate send(socket, dest, data), to: :gen_udp\n    46→  defdelegate send(socket, ip, port, data), to: :gen_udp\n    47→  defdelegate send(socket, ip, port, anc_data, data), to: :gen_udp\n    48→\n    49→  @doc \"\"\"\n    50→  Gets socket options.\n    51→  \"\"\"\n    52→  @spec getopts(Abyss.Transport.socket(), Abyss.Transport.socket_get_options()) ::\n    53→          Abyss.Transport.on_getopts()\n    54→  defdelegate getopts(socket, options), to: :inet\n    55→\n    56→  @doc \"\"\"\n    57→  Sets socket options.\n    58→  \"\"\"\n    59→  @spec setopts(Abyss.Transport.socket(), Abyss.Transport.socket_set_options()) ::\n    60→          Abyss.Transport.on_setopts()\n    61→  defdelegate setopts(socket, options), to: :inet\n    62→\n    63→  @doc \"\"\"\n    64→  Closes a UDP socket.\n    65→  \"\"\"\n    66→  @spec close(Abyss.Transport.socket() | Abyss.Transport.listener_socket()) :: :ok\n    67→  defdelegate close(socket), to: :gen_udp\n    68→\n    69→  @doc \"\"\"\n    70→  Returns information about the local socket endpoint.\n    71→  \"\"\"\n    72→  @spec sockname(Abyss.Transport.socket() | Abyss.Transport.listener_socket()) ::\n    73→          Abyss.Transport.on_sockname()\n    74→  defdelegate sockname(socket), to: :inet\n    75→\n    76→  @doc \"\"\"\n    77→  Returns information about the remote socket endpoint.\n    78→  \"\"\"\n    79→  @spec peername(Abyss.Transport.socket()) :: Abyss.Transport.on_peername()\n    80→  defdelegate peername(socket), to: :inet\n    81→\n    82→  @doc \"\"\"\n    83→  Returns statistics about the socket connection.\n    84→  \"\"\"\n    85→  @spec getstat(Abyss.Transport.socket()) :: Abyss.Transport.socket_stats()\n    86→  defdelegate getstat(socket), to: :inet\n    87→\n    88→  @doc \"\"\"\n    89→  Merges user options with default options, ensuring user options take precedence.\n    90→\n    91→  The function handles both keyword-style options (e.g., `{:key, value}`) and\n    92→  atom-style options (e.g., `:atom_option`).\n    93→\n    94→  ## Parameters\n    95→  - `default_options` - Default options to use as base\n    96→  - `user_options` - User-provided options that override defaults\n    97→\n    98→  ## Returns\n    99→  - Merged options list with user options taking precedence\n   100→  \"\"\"\n   101→  @spec merge_options(keyword(), keyword()) :: keyword()\n   102→  def merge_options(default_options, user_options) do\n   103→    Enum.uniq_by(\n   104→      user_options ++ default_options,\n   105→      fn\n   106→        {key, _} when is_atom(key) -> key\n   107→        key when is_atom(key) -> key\n   108→      end\n   109→    )\n   110→  end\n   111→\n   112→  @doc \"\"\"\n   113→  Opens a UDP socket with the given port and options.\n   114→\n   115→  This is a common helper used by both Unicast and Broadcast transports.\n   116→  \"\"\"\n   117→  @spec open_socket(:inet.port_number(), [:inet.inet_backend() | :gen_udp.open_option()]) ::\n   118→          {:ok, Abyss.Transport.socket()} | {:error, :system_limit} | {:error, :inet.posix()}\n   119→  def open_socket(port, options) do\n   120→    :gen_udp.open(port, options)\n   121→  end\n   122→end\n   123→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01EcuPGge8XqrpRzcMMHw2DQ","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"2d5f5829-5c6c-456a-bb58-52fdcc0ff885","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/abyss/lib/abyss/transport/udp/core.ex","content":"defmodule Abyss.Transport.UDP.Core do\n  @moduledoc \"\"\"\n  Core UDP transport functionality shared between Unicast and Broadcast transports.\n\n  This module contains common UDP socket operations that are used by both\n  `Abyss.Transport.UDP.Unicast` and `Abyss.Transport.UDP.Broadcast` to avoid\n  code duplication.\n\n  ## Shared Operations\n\n  - Socket control and ownership transfer\n  - Data receiving and sending\n  - Socket option management\n  - Socket information retrieval\n  - Connection statistics\n\n  This module is not meant to be used directly. Use the specific transport\n  modules instead:\n  - `Abyss.Transport.UDP.Unicast` for unicast traffic\n  - `Abyss.Transport.UDP.Broadcast` for broadcast/multicast traffic\n  \"\"\"\n\n  @doc \"\"\"\n  Transfers ownership of the given socket to the given process.\n  \"\"\"\n  @spec controlling_process(Abyss.Transport.socket(), pid()) ::\n          Abyss.Transport.on_controlling_process()\n  defdelegate controlling_process(socket, pid), to: :gen_udp\n\n  @doc \"\"\"\n  Receives data from a UDP socket.\n  \"\"\"\n  @spec recv(Abyss.Transport.socket(), non_neg_integer(), timeout()) ::\n          Abyss.Transport.on_recv()\n  defdelegate recv(socket, length, timeout), to: :gen_udp\n\n  @spec recv(Abyss.Transport.socket(), non_neg_integer()) :: Abyss.Transport.on_recv()\n  defdelegate recv(socket, length), to: :gen_udp\n\n  @doc \"\"\"\n  Sends data on a UDP socket.\n  \"\"\"\n  @spec send(Abyss.Transport.socket(), iodata()) :: Abyss.Transport.on_send()\n  defdelegate send(socket, data), to: :gen_udp\n  defdelegate send(socket, dest, data), to: :gen_udp\n  defdelegate send(socket, ip, port, data), to: :gen_udp\n  defdelegate send(socket, ip, port, anc_data, data), to: :gen_udp\n\n  @doc \"\"\"\n  Gets socket options.\n  \"\"\"\n  @spec getopts(Abyss.Transport.socket(), Abyss.Transport.socket_get_options()) ::\n          Abyss.Transport.on_getopts()\n  defdelegate getopts(socket, options), to: :inet\n\n  @doc \"\"\"\n  Sets socket options.\n  \"\"\"\n  @spec setopts(Abyss.Transport.socket(), Abyss.Transport.socket_set_options()) ::\n          Abyss.Transport.on_setopts()\n  defdelegate setopts(socket, options), to: :inet\n\n  @doc \"\"\"\n  Closes a UDP socket.\n  \"\"\"\n  @spec close(Abyss.Transport.socket() | Abyss.Transport.listener_socket()) :: :ok\n  defdelegate close(socket), to: :gen_udp\n\n  @doc \"\"\"\n  Returns information about the local socket endpoint.\n  \"\"\"\n  @spec sockname(Abyss.Transport.socket() | Abyss.Transport.listener_socket()) ::\n          Abyss.Transport.on_sockname()\n  defdelegate sockname(socket), to: :inet\n\n  @doc \"\"\"\n  Returns information about the remote socket endpoint.\n  \"\"\"\n  @spec peername(Abyss.Transport.socket()) :: Abyss.Transport.on_peername()\n  defdelegate peername(socket), to: :inet\n\n  @doc \"\"\"\n  Returns statistics about the socket connection.\n  \"\"\"\n  @spec getstat(Abyss.Transport.socket()) :: Abyss.Transport.socket_stats()\n  defdelegate getstat(socket), to: :inet\n\n  @doc \"\"\"\n  Merges user options with default options, ensuring user options take precedence.\n\n  The function handles both keyword-style options (e.g., `{:key, value}`) and\n  atom-style options (e.g., `:atom_option`).\n\n  ## Parameters\n  - `default_options` - Default options to use as base\n  - `user_options` - User-provided options that override defaults\n\n  ## Returns\n  - Merged options list with user options taking precedence\n  \"\"\"\n  @spec merge_options(keyword(), keyword()) :: keyword()\n  def merge_options(default_options, user_options) do\n    Enum.uniq_by(\n      user_options ++ default_options,\n      fn\n        {key, _} when is_atom(key) -> key\n        key when is_atom(key) -> key\n      end\n    )\n  end\n\n  @doc \"\"\"\n  Opens a UDP socket with the given port and options.\n\n  This is a common helper used by both Unicast and Broadcast transports.\n  \"\"\"\n  @spec open_socket(:inet.port_number(), [:inet.inet_backend() | :gen_udp.open_option()]) ::\n          {:ok, Abyss.Transport.socket()} | {:error, :system_limit} | {:error, :inet.posix()}\n  def open_socket(port, options) do\n    :gen_udp.open(port, options)\n  end\nend\n","numLines":123,"startLine":1,"totalLines":123}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E8kfKx7DaokPDEwKFy11eH","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n     6→  REPLY, and other DHCPv6 protocol messages. Handles client identification\n     7→  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv6.LeaseManager\n    13→\n    14→  # DHCPv6 message type constants\n    15→  @msg_type_solicit 1\n    16→  @msg_type_advertise 2\n    17→  @msg_type_request 3\n    18→  # @msg_type_confirm 4\n    19→  @msg_type_renew 5\n    20→  @msg_type_rebind 6\n    21→  @msg_type_reply 7\n    22→  @msg_type_release 8\n    23→  @msg_type_decline 9\n    24→  # @msg_type_reconfigure 10\n    25→  @msg_type_information_request 11\n    26→  @msg_type_relay_forw 12\n    27→  @msg_type_relay_repl 13\n    28→\n    29→  # DHCPv6 option codes\n    30→  @option_client_id 1\n    31→  @option_server_id 2\n    32→  @option_ia_na 3\n    33→  @option_ia_ta 4\n    34→  @option_ia_addr 5\n    35→  # @option_oro 6\n    36→  @option_preference 7\n    37→  # @option_elapsed_time 8\n    38→  # @option_status_code 13\n    39→  # @option_rapid_commit 14\n    40→  @option_dns_servers 23\n    41→  @option_domain_list 24\n    42→  @option_ia_pd 25\n    43→  @option_ia_prefix 26\n    44→\n    45→  @doc \"\"\"\n    46→  Handles incoming DHCPv6 data from clients.\n    47→  \"\"\"\n    48→  @impl true\n    49→  def handle_data({client_ip, client_port, data}, state) do\n    50→    start_time = System.monotonic_time(:microsecond)\n    51→\n    52→    try do\n    53→      case DHCPv6.Message.from_iodata(data) do\n    54→        {:ok, message} ->\n    55→          :telemetry.execute(\n    56→            [:yellow_dog, :dhcpv6, :message, :received],\n    57→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    58→            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n    59→          )\n    60→\n    61→          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n    62→\n    63→        {:error, reason} ->\n    64→          :telemetry.execute(\n    65→            [:yellow_dog, :dhcpv6, :message, :parse_error],\n    66→            %{count: 1},\n    67→            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n    68→          )\n    69→\n    70→          {:continue, state}\n    71→      end\n    72→    rescue\n    73→      error ->\n    74→        :telemetry.execute(\n    75→          [:yellow_dog, :dhcpv6, :message, :error],\n    76→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    77→          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n    78→        )\n    79→\n    80→        {:continue, state}\n    81→    end\n    82→  end\n    83→\n    84→  @doc \"\"\"\n    85→  Handles handler errors (implements Abyss.Handler callback).\n    86→  \"\"\"\n    87→  @impl true\n    88→  def handle_error(error, state) do\n    89→    :telemetry.execute(\n    90→      [:yellow_dog, :dhcpv6, :handler, :error],\n    91→      %{count: 1},\n    92→      %{reason: inspect(error)}\n    93→    )\n    94→\n    95→    {:continue, state}\n    96→  end\n    97→\n    98→  @doc \"\"\"\n    99→  Handles handler timeouts (implements Abyss.Handler callback).\n   100→  \"\"\"\n   101→  @impl true\n   102→  def handle_timeout(state) do\n   103→    :telemetry.execute(\n   104→      [:yellow_dog, :dhcpv6, :handler, :timeout],\n   105→      %{count: 1},\n   106→      %{}\n   107→    )\n   108→\n   109→    {:continue, state}\n   110→  end\n   111→\n   112→  # Private functions for handling specific DHCPv6 message types\n   113→\n   114→  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n   115→    case message.msg_type do\n   116→      @msg_type_solicit ->\n   117→        handle_solicit(message, client_ip, client_port, state, start_time)\n   118→\n   119→      @msg_type_request ->\n   120→        handle_request(message, client_ip, client_port, state, start_time)\n   121→\n   122→      @msg_type_renew ->\n   123→        handle_renew(message, client_ip, client_port, state, start_time)\n   124→\n   125→      @msg_type_rebind ->\n   126→        handle_rebind(message, client_ip, client_port, state, start_time)\n   127→\n   128→      @msg_type_release ->\n   129→        handle_release(message, client_ip, client_port, state, start_time)\n   130→\n   131→      @msg_type_decline ->\n   132→        handle_decline(message, client_ip, client_port, state, start_time)\n   133→\n   134→      @msg_type_information_request ->\n   135→        handle_inform(message, client_ip, client_port, state, start_time)\n   136→\n   137→      @msg_type_relay_forw ->\n   138→        handle_relay_forward(message, client_ip, client_port, state)\n   139→\n   140→      @msg_type_relay_repl ->\n   141→        handle_relay_reply(message, client_ip, client_port, state)\n   142→\n   143→      _ ->\n   144→        :telemetry.execute(\n   145→          [:yellow_dog, :dhcpv6, :message, :unknown],\n   146→          %{count: 1},\n   147→          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n   148→        )\n   149→\n   150→        {:continue, state}\n   151→    end\n   152→  end\n   153→\n   154→  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n   155→    :telemetry.execute(\n   156→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   157→      %{count: 1},\n   158→      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n   159→    )\n   160→\n   161→    client_duid = get_client_duid(message)\n   162→    ia_na = get_ia_na(message)\n   163→    ia_ta = get_ia_ta(message)\n   164→    ia_pd = get_ia_pd(message)\n   165→\n   166→    # Check if any IA type is present\n   167→    case {client_duid, ia_na, ia_ta, ia_pd} do\n   168→      {nil, _, _, _} ->\n   169→        :telemetry.execute(\n   170→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   171→          %{count: 1},\n   172→          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n   173→        )\n   174→\n   175→        {:continue, state}\n   176→\n   177→      {_, nil, nil, nil} ->\n   178→        :telemetry.execute(\n   179→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   180→          %{count: 1},\n   181→          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n   182→        )\n   183→\n   184→        {:continue, state}\n   185→\n   186→      {duid, _, _, _} ->\n   187→        # Process each IA type\n   188→        leases = []\n   189→\n   190→        # Handle IA_NA if present\n   191→        leases =\n   192→          if ia_na do\n   193→            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n   194→              {:ok, lease} ->\n   195→                [lease | leases]\n   196→\n   197→              {:error, reason} ->\n   198→                :telemetry.execute(\n   199→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   200→                  %{count: 1},\n   201→                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n   202→                )\n   203→\n   204→                leases\n   205→            end\n   206→          else\n   207→            leases\n   208→          end\n   209→\n   210→        # Handle IA_TA if present\n   211→        leases =\n   212→          if ia_ta do\n   213→            case allocate_temporary_address(duid, ia_ta.iaid) do\n   214→              {:ok, ta_lease} ->\n   215→                [ta_lease | leases]\n   216→\n   217→              {:error, reason} ->\n   218→                :telemetry.execute(\n   219→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   220→                  %{count: 1},\n   221→                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n   222→                )\n   223→\n   224→                leases\n   225→            end\n   226→          else\n   227→            leases\n   228→          end\n   229→\n   230→        # Handle IA_PD if present\n   231→        leases =\n   232→          if ia_pd do\n   233→            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n   234→            [pd_lease | leases]\n   235→          else\n   236→            leases\n   237→          end\n   238→\n   239→        if length(leases) > 0 do\n   240→          advertise = create_advertise_multi(message, leases)\n   241→          send_dhcpv6_response(advertise, client_ip, client_port, state)\n   242→\n   243→          :telemetry.execute(\n   244→            [:yellow_dog, :dhcpv6, :solicit, :completed],\n   245→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   246→            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n   247→          )\n   248→        end\n   249→\n   250→        {:continue, state}\n   251→    end\n   252→  end\n   253→\n   254→  defp handle_request(message, client_ip, client_port, state, start_time) do\n   255→    :telemetry.execute(\n   256→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   257→      %{count: 1},\n   258→      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n   259→    )\n   260→\n   261→    client_duid = get_client_duid(message)\n   262→    ia_na = get_ia_na(message)\n   263→\n   264→    case {client_duid, ia_na} do\n   265→      {nil, _} ->\n   266→        :telemetry.execute(\n   267→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   268→          %{count: 1},\n   269→          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n   270→        )\n   271→\n   272→        {:continue, state}\n   273→\n   274→      {_, nil} ->\n   275→        :telemetry.execute(\n   276→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   277→          %{count: 1},\n   278→          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n   279→        )\n   280→\n   281→        {:continue, state}\n   282→\n   283→      {duid, %{iaid: iaid}} ->\n   284→        # Allocate or renew lease\n   285→        case LeaseManager.allocate_lease(duid, iaid) do\n   286→          {:ok, lease} ->\n   287→            reply = create_reply(message, lease)\n   288→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   289→\n   290→            :telemetry.execute(\n   291→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   292→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   293→              %{client_ip: client_ip, client_duid: duid}\n   294→            )\n   295→\n   296→          {:error, reason} ->\n   297→            :telemetry.execute(\n   298→              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   299→              %{count: 1},\n   300→              %{reason: inspect(reason), client_duid: duid}\n   301→            )\n   302→        end\n   303→\n   304→        {:continue, state}\n   305→    end\n   306→  end\n   307→\n   308→  defp handle_renew(message, client_ip, client_port, state, start_time) do\n   309→    :telemetry.execute(\n   310→      [:yellow_dog, :dhcpv6, :lease, :renewed],\n   311→      %{count: 1},\n   312→      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n   313→    )\n   314→\n   315→    client_duid = get_client_duid(message)\n   316→    ia_na = get_ia_na(message)\n   317→\n   318→    case {client_duid, ia_na} do\n   319→      {duid, %{iaid: iaid}} when duid != nil ->\n   320→        # Renew existing lease\n   321→        case LeaseManager.allocate_lease(duid, iaid) do\n   322→          {:ok, lease} ->\n   323→            reply = create_reply(message, lease)\n   324→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   325→\n   326→            :telemetry.execute(\n   327→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   328→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   329→              %{client_ip: client_ip, client_duid: duid}\n   330→            )\n   331→\n   332→          {:error, reason} ->\n   333→            :telemetry.execute(\n   334→              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n   335→              %{count: 1},\n   336→              %{reason: inspect(reason), client_duid: duid}\n   337→            )\n   338→        end\n   339→\n   340→        {:continue, state}\n   341→\n   342→      _ ->\n   343→        :telemetry.execute(\n   344→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   345→          %{count: 1},\n   346→          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n   347→        )\n   348→\n   349→        {:continue, state}\n   350→    end\n   351→  end\n   352→\n   353→  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n   354→    :telemetry.execute(\n   355→      [:yellow_dog, :dhcpv6, :lease, :rebind],\n   356→      %{count: 1},\n   357→      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n   358→    )\n   359→\n   360→    # Rebind is similar to renew - reuse the renew logic\n   361→    client_duid = get_client_duid(message)\n   362→    ia_na = get_ia_na(message)\n   363→\n   364→    case {client_duid, ia_na} do\n   365→      {duid, %{iaid: iaid}} when duid != nil ->\n   366→        case LeaseManager.allocate_lease(duid, iaid) do\n   367→          {:ok, lease} ->\n   368→            reply = create_reply(message, lease)\n   369→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   370→\n   371→            :telemetry.execute(\n   372→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   373→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   374→              %{client_ip: client_ip, client_duid: duid}\n   375→            )\n   376→\n   377→          {:error, reason} ->\n   378→            :telemetry.execute(\n   379→              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n   380→              %{count: 1},\n   381→              %{reason: inspect(reason), client_duid: duid}\n   382→            )\n   383→        end\n   384→\n   385→        {:continue, state}\n   386→\n   387→      _ ->\n   388→        :telemetry.execute(\n   389→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   390→          %{count: 1},\n   391→          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n   392→        )\n   393→\n   394→        {:continue, state}\n   395→    end\n   396→  end\n   397→\n   398→  defp handle_release(message, client_ip, client_port, state, start_time) do\n   399→    :telemetry.execute(\n   400→      [:yellow_dog, :dhcpv6, :lease, :released],\n   401→      %{count: 1},\n   402→      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n   403→    )\n   404→\n   405→    client_duid = get_client_duid(message)\n   406→    ia_na = get_ia_na(message)\n   407→\n   408→    case {client_duid, ia_na} do\n   409→      {duid, %{iaid: iaid}} when duid != nil ->\n   410→        LeaseManager.release_lease(duid, iaid)\n   411→\n   412→        :telemetry.execute(\n   413→          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n   414→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   415→          %{client_ip: client_ip, client_duid: duid}\n   416→        )\n   417→\n   418→      _ ->\n   419→        :telemetry.execute(\n   420→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   421→          %{count: 1},\n   422→          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n   423→        )\n   424→    end\n   425→\n   426→    {:continue, state}\n   427→  end\n   428→\n   429→  defp handle_decline(message, client_ip, client_port, state, start_time) do\n   430→    :telemetry.execute(\n   431→      [:yellow_dog, :dhcpv6, :lease, :declined],\n   432→      %{count: 1},\n   433→      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n   434→    )\n   435→\n   436→    client_duid = get_client_duid(message)\n   437→    ia_na = get_ia_na(message)\n   438→\n   439→    case {client_duid, ia_na} do\n   440→      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n   441→        LeaseManager.decline_ip(ia_addr, duid)\n   442→\n   443→        :telemetry.execute(\n   444→          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n   445→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   446→          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n   447→        )\n   448→\n   449→      _ ->\n   450→        :telemetry.execute(\n   451→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   452→          %{count: 1},\n   453→          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n   454→        )\n   455→    end\n   456→\n   457→    {:continue, state}\n   458→  end\n   459→\n   460→  defp handle_inform(message, client_ip, client_port, state, start_time) do\n   461→    :telemetry.execute(\n   462→      [:yellow_dog, :dhcpv6, :inform, :requested],\n   463→      %{count: 1},\n   464→      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n   465→    )\n   466→\n   467→    # INFORMATION-REQUEST - provide configuration without address allocation\n   468→    reply = create_information_reply(message)\n   469→    send_dhcpv6_response(reply, client_ip, client_port, state)\n   470→\n   471→    :telemetry.execute(\n   472→      [:yellow_dog, :dhcpv6, :inform, :completed],\n   473→      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   474→      %{client_ip: client_ip}\n   475→    )\n   476→\n   477→    {:continue, state}\n   478→  end\n   479→\n   480→  defp handle_relay_forward(_message, client_ip, client_port, state) do\n   481→    :telemetry.execute(\n   482→      [:yellow_dog, :dhcpv6, :relay, :forward],\n   483→      %{count: 1},\n   484→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   485→    )\n   486→\n   487→    {:continue, state}\n   488→  end\n   489→\n   490→  defp handle_relay_reply(_message, client_ip, client_port, state) do\n   491→    :telemetry.execute(\n   492→      [:yellow_dog, :dhcpv6, :relay, :reply],\n   493→      %{count: 1},\n   494→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   495→    )\n   496→\n   497→    {:continue, state}\n   498→  end\n   499→\n   500→  # Message creation functions\n   501→\n   502→  defp create_reply(request, lease) do\n   503→    pool = get_pool_for_lease(lease)\n   504→\n   505→    %DHCPv6.Message{\n   506→      msg_type: @msg_type_reply,\n   507→      transaction_id: request.transaction_id,\n   508→      options:\n   509→        [\n   510→          # Server DUID\n   511→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   512→          # Client DUID (echo back)\n   513→          %DHCPv6.Message.Option{\n   514→            option_code: @option_client_id,\n   515→            option_data: get_client_duid(request)\n   516→          },\n   517→          # IA_NA with IA_ADDR\n   518→          create_ia_na_option(lease),\n   519→          # DNS servers\n   520→          create_dns_servers_option(pool.dns_servers)\n   521→        ]\n   522→        |> add_domain_list_option(pool.domain_name)\n   523→    }\n   524→  end\n   525→\n   526→  defp create_information_reply(request) do\n   527→    pool = get_default_pool()\n   528→\n   529→    %DHCPv6.Message{\n   530→      msg_type: @msg_type_reply,\n   531→      transaction_id: request.transaction_id,\n   532→      options:\n   533→        [\n   534→          # Server DUID\n   535→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   536→          # Client DUID (echo back)\n   537→          %DHCPv6.Message.Option{\n   538→            option_code: @option_client_id,\n   539→            option_data: get_client_duid(request)\n   540→          },\n   541→          # DNS servers\n   542→          create_dns_servers_option(pool.dns_servers)\n   543→        ]\n   544→        |> add_domain_list_option(pool.domain_name)\n   545→    }\n   546→  end\n   547→\n   548→  # Helper functions for creating options\n   549→\n   550→  defp create_ia_na_option(lease) do\n   551→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   552→    ia_addr_data =\n   553→      ipv6_to_binary(lease.ip) <>\n   554→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   555→\n   556→    ia_addr_option = %DHCPv6.Message.Option{\n   557→      option_code: @option_ia_addr,\n   558→      option_data: ia_addr_data\n   559→    }\n   560→\n   561→    # IA_NA option (option 3) - contains IA_ADDR\n   562→    # IAID + T1 + T2 (0 = server decides)\n   563→    ia_na_data =\n   564→      <<lease.iaid::32, 0::32, 0::32>> <>\n   565→        DHCP.Parameter.to_iodata(ia_addr_option)\n   566→\n   567→    %DHCPv6.Message.Option{\n   568→      option_code: @option_ia_na,\n   569→      option_data: ia_na_data\n   570→    }\n   571→  end\n   572→\n   573→  defp create_dns_servers_option(dns_servers) do\n   574→    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n   575→\n   576→    %DHCPv6.Message.Option{\n   577→      option_code: @option_dns_servers,\n   578→      option_data: dns_data\n   579→    }\n   580→  end\n   581→\n   582→  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n   583→\n   584→  defp add_domain_list_option(options, domain) do\n   585→    # Encode domain name in DNS format (length-prefixed labels)\n   586→    domain_data = encode_domain_name(domain)\n   587→\n   588→    domain_option = %DHCPv6.Message.Option{\n   589→      option_code: @option_domain_list,\n   590→      option_data: domain_data\n   591→    }\n   592→\n   593→    options ++ [domain_option]\n   594→  end\n   595→\n   596→  defp encode_domain_name(domain) do\n   597→    domain\n   598→    |> String.split(\".\")\n   599→    |> Enum.map_join(fn label ->\n   600→      <<byte_size(label)::8, label::binary>>\n   601→    end)\n   602→    # Terminating zero\n   603→    |> Kernel.<>(<<0>>)\n   604→  end\n   605→\n   606→  # Helper functions for extracting information from messages\n   607→\n   608→  defp get_client_duid(message) do\n   609→    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n   610→      nil -> nil\n   611→      option -> option.option_data\n   612→    end\n   613→  end\n   614→\n   615→  defp get_ia_na(message) do\n   616→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n   617→      nil ->\n   618→        nil\n   619→\n   620→      option ->\n   621→        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   622→        case option.option_data do\n   623→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   624→            # Try to extract IA_ADDR if present\n   625→            ia_addr = extract_ia_addr(rest)\n   626→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n   627→\n   628→          _ ->\n   629→            nil\n   630→        end\n   631→    end\n   632→  end\n   633→\n   634→  defp get_ia_ta(message) do\n   635→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n   636→      nil ->\n   637→        nil\n   638→\n   639→      option ->\n   640→        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n   641→        case option.option_data do\n   642→          <<iaid::32, rest::binary>> ->\n   643→            ia_addr = extract_ia_addr(rest)\n   644→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n   645→\n   646→          _ ->\n   647→            nil\n   648→        end\n   649→    end\n   650→  end\n   651→\n   652→  defp get_ia_pd(message) do\n   653→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n   654→      nil ->\n   655→        nil\n   656→\n   657→      option ->\n   658→        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   659→        case option.option_data do\n   660→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   661→            ia_prefix = extract_ia_prefix(rest)\n   662→            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n   663→\n   664→          _ ->\n   665→            nil\n   666→        end\n   667→    end\n   668→  end\n   669→\n   670→  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n   671→    case data do\n   672→      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n   673→        {a, b, c, d, e, f, g, h}\n   674→\n   675→      _ ->\n   676→        nil\n   677→    end\n   678→  end\n   679→\n   680→  defp extract_ia_addr(_), do: nil\n   681→\n   682→  defp extract_ia_prefix(\n   683→         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n   684→       ) do\n   685→    case data do\n   686→      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n   687→        g::16, h::16>> ->\n   688→        {{a, b, c, d, e, f, g, h}, prefix_len}\n   689→\n   690→      _ ->\n   691→        nil\n   692→    end\n   693→  end\n   694→\n   695→  defp extract_ia_prefix(_), do: nil\n   696→\n   697→  # Allocation helper functions\n   698→\n   699→  defp allocate_temporary_address(duid, iaid) do\n   700→    # Temporary addresses use a separate pool with shorter lifetimes\n   701→    # For now, delegate to LeaseManager with IA_TA type marker\n   702→    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n   703→      {:ok, lease} ->\n   704→        # Mark as temporary address with shorter lifetime\n   705→        ta_lease = %{\n   706→          lease\n   707→          | ia_type: :ia_ta,\n   708→            preferred_lifetime: 600,\n   709→            # 10 minutes\n   710→            valid_lifetime: 1200\n   711→            # 20 minutes\n   712→        }\n   713→\n   714→        {:ok, ta_lease}\n   715→\n   716→      error ->\n   717→        error\n   718→    end\n   719→  end\n   720→\n   721→  defp allocate_prefix_delegation(duid, iaid) do\n   722→    # For now, return a placeholder\n   723→    # Full implementation would use PrefixPool module\n   724→    :telemetry.execute(\n   725→      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n   726→      %{count: 1},\n   727→      %{client_duid: duid, iaid: iaid}\n   728→    )\n   729→\n   730→    # TODO: Integrate with PrefixPool module\n   731→    # Example placeholder prefix: 2001:db8:1000::/56\n   732→    {:ok,\n   733→     %{\n   734→       duid: duid,\n   735→       iaid: iaid,\n   736→       ia_type: :ia_pd,\n   737→       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n   738→       preferred_lifetime: 3600,\n   739→       valid_lifetime: 7200,\n   740→       pool_name: \"default-pd\"\n   741→     }}\n   742→  end\n   743→\n   744→  # Message creation functions with multi-IA support\n   745→\n   746→  defp create_advertise_multi(solicit, leases) do\n   747→    pool = get_default_pool()\n   748→\n   749→    options = [\n   750→      # Server DUID\n   751→      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   752→      # Client DUID (echo back)\n   753→      %DHCPv6.Message.Option{\n   754→        option_code: @option_client_id,\n   755→        option_data: get_client_duid(solicit)\n   756→      },\n   757→      # Preference\n   758→      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n   759→    ]\n   760→\n   761→    # Add IA options for each lease\n   762→    ia_options =\n   763→      Enum.flat_map(leases, fn lease ->\n   764→        case lease.ia_type do\n   765→          :ia_na -> [create_ia_na_option(lease)]\n   766→          :ia_ta -> [create_ia_ta_option(lease)]\n   767→          :ia_pd -> [create_ia_pd_option(lease)]\n   768→          _ -> []\n   769→        end\n   770→      end)\n   771→\n   772→    # Add configuration options (DNS, etc.)\n   773→    config_options =\n   774→      [\n   775→        create_dns_servers_option(pool.dns_servers)\n   776→      ] ++ add_domain_list_option([], pool.domain_name)\n   777→\n   778→    %DHCPv6.Message{\n   779→      msg_type: @msg_type_advertise,\n   780→      transaction_id: solicit.transaction_id,\n   781→      options: options ++ ia_options ++ config_options\n   782→    }\n   783→  end\n   784→\n   785→  defp create_ia_ta_option(lease) do\n   786→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   787→    ia_addr_data =\n   788→      ipv6_to_binary(lease.ip) <>\n   789→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   790→\n   791→    ia_addr_option = %DHCPv6.Message.Option{\n   792→      option_code: @option_ia_addr,\n   793→      option_data: ia_addr_data\n   794→    }\n   795→\n   796→    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n   797→    ia_ta_data =\n   798→      <<lease.iaid::32>> <>\n   799→        DHCP.Parameter.to_iodata(ia_addr_option)\n   800→\n   801→    %DHCPv6.Message.Option{\n   802→      option_code: @option_ia_ta,\n   803→      option_data: ia_ta_data\n   804→    }\n   805→  end\n   806→\n   807→  defp create_ia_pd_option(lease) do\n   808→    {prefix_addr, prefix_len} = lease.delegated_prefix\n   809→\n   810→    # IA_PREFIX option (option 26)\n   811→    ia_prefix_data =\n   812→      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n   813→        ipv6_to_binary(prefix_addr)\n   814→\n   815→    ia_prefix_option = %DHCPv6.Message.Option{\n   816→      option_code: @option_ia_prefix,\n   817→      option_data: ia_prefix_data\n   818→    }\n   819→\n   820→    # IA_PD option (option 25)\n   821→    ia_pd_data =\n   822→      <<lease.iaid::32, 0::32, 0::32>> <>\n   823→        DHCP.Parameter.to_iodata(ia_prefix_option)\n   824→\n   825→    %DHCPv6.Message.Option{\n   826→      option_code: @option_ia_pd,\n   827→      option_data: ia_pd_data\n   828→    }\n   829→  end\n   830→\n   831→  defp get_server_duid do\n   832→    # Generate a simple DUID-LL (Link-Layer) based on server\n   833→    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n   834→    # Using a static server identifier for now\n   835→    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n   836→  end\n   837→\n   838→  defp get_pool_for_lease(_lease) do\n   839→    # For now, use default pool\n   840→    # In production, look up pool by lease.pool_name\n   841→    get_default_pool()\n   842→  end\n   843→\n   844→  defp get_default_pool do\n   845→    %{\n   846→      name: \"default\",\n   847→      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   848→      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n   849→      prefix_length: 64,\n   850→      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n   851→      domain_name: \"local\",\n   852→      preferred_lifetime: 3600,\n   853→      valid_lifetime: 7200\n   854→    }\n   855→  end\n   856→\n   857→  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n   858→    data = DHCP.Parameter.to_iodata(response)\n   859→\n   860→    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n   861→      :ok ->\n   862→        :telemetry.execute(\n   863→          [:yellow_dog, :dhcpv6, :response, :sent],\n   864→          %{count: 1},\n   865→          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n   866→        )\n   867→\n   868→      {:error, reason} ->\n   869→        :telemetry.execute(\n   870→          [:yellow_dog, :dhcpv6, :response, :send_failed],\n   871→          %{count: 1},\n   872→          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n   873→        )\n   874→    end\n   875→  end\n   876→\n   877→  # Utility functions\n   878→\n   879→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   880→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   881→  end\n   882→end\n   883→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01EcuPGge8XqrpRzcMMHw2DQ","session_id":"50d21925-9237-40c9-8dd2-03e5c6e35c37","uuid":"5dc4c532-54e1-4231-85c0-8860f12b1842","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/handler.ex","content":"defmodule YellowDog.Dhcpv6.Handler do\n  @moduledoc \"\"\"\n  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n\n  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n  REPLY, and other DHCPv6 protocol messages. Handles client identification\n  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv6.LeaseManager\n\n  # DHCPv6 message type constants\n  @msg_type_solicit 1\n  @msg_type_advertise 2\n  @msg_type_request 3\n  # @msg_type_confirm 4\n  @msg_type_renew 5\n  @msg_type_rebind 6\n  @msg_type_reply 7\n  @msg_type_release 8\n  @msg_type_decline 9\n  # @msg_type_reconfigure 10\n  @msg_type_information_request 11\n  @msg_type_relay_forw 12\n  @msg_type_relay_repl 13\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  # @option_oro 6\n  @option_preference 7\n  # @option_elapsed_time 8\n  # @option_status_code 13\n  # @option_rapid_commit 14\n  @option_dns_servers 23\n  @option_domain_list 24\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @doc \"\"\"\n  Handles incoming DHCPv6 data from clients.\n  \"\"\"\n  @impl true\n  def handle_data({client_ip, client_port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    try do\n      case DHCPv6.Message.from_iodata(data) do\n        {:ok, message} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :received],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n          )\n\n          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :parse_error],\n            %{count: 1},\n            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n          )\n\n          {:continue, state}\n      end\n    rescue\n      error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :error],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @doc \"\"\"\n  Handles handler errors (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles handler timeouts (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions for handling specific DHCPv6 message types\n\n  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n    case message.msg_type do\n      @msg_type_solicit ->\n        handle_solicit(message, client_ip, client_port, state, start_time)\n\n      @msg_type_request ->\n        handle_request(message, client_ip, client_port, state, start_time)\n\n      @msg_type_renew ->\n        handle_renew(message, client_ip, client_port, state, start_time)\n\n      @msg_type_rebind ->\n        handle_rebind(message, client_ip, client_port, state, start_time)\n\n      @msg_type_release ->\n        handle_release(message, client_ip, client_port, state, start_time)\n\n      @msg_type_decline ->\n        handle_decline(message, client_ip, client_port, state, start_time)\n\n      @msg_type_information_request ->\n        handle_inform(message, client_ip, client_port, state, start_time)\n\n      @msg_type_relay_forw ->\n        handle_relay_forward(message, client_ip, client_port, state)\n\n      @msg_type_relay_repl ->\n        handle_relay_reply(message, client_ip, client_port, state)\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :unknown],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n    ia_ta = get_ia_ta(message)\n    ia_pd = get_ia_pd(message)\n\n    # Check if any IA type is present\n    case {client_duid, ia_na, ia_ta, ia_pd} do\n      {nil, _, _, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil, nil, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, _, _, _} ->\n        # Process each IA type\n        leases = []\n\n        # Handle IA_NA if present\n        leases =\n          if ia_na do\n            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n              {:ok, lease} ->\n                [lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_TA if present\n        leases =\n          if ia_ta do\n            case allocate_temporary_address(duid, ia_ta.iaid) do\n              {:ok, ta_lease} ->\n                [ta_lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_PD if present\n        leases =\n          if ia_pd do\n            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n            [pd_lease | leases]\n          else\n            leases\n          end\n\n        if length(leases) > 0 do\n          advertise = create_advertise_multi(message, leases)\n          send_dhcpv6_response(advertise, client_ip, client_port, state)\n\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :solicit, :completed],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n          )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_request(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {nil, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, %{iaid: iaid}} ->\n        # Allocate or renew lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_renew(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :renewed],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        # Renew existing lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :rebind],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n    )\n\n    # Rebind is similar to renew - reuse the renew logic\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_release(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :released],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        LeaseManager.release_lease(duid, iaid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_decline(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :declined],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n        LeaseManager.decline_ip(ia_addr, duid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_inform(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n    )\n\n    # INFORMATION-REQUEST - provide configuration without address allocation\n    reply = create_information_reply(message)\n    send_dhcpv6_response(reply, client_ip, client_port, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :completed],\n      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_forward(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :forward],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_reply(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :reply],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  # Message creation functions\n\n  defp create_reply(request, lease) do\n    pool = get_pool_for_lease(lease)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # IA_NA with IA_ADDR\n          create_ia_na_option(lease),\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  defp create_information_reply(request) do\n    pool = get_default_pool()\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  # Helper functions for creating options\n\n  defp create_ia_na_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_NA option (option 3) - contains IA_ADDR\n    # IAID + T1 + T2 (0 = server decides)\n    ia_na_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_na,\n      option_data: ia_na_data\n    }\n  end\n\n  defp create_dns_servers_option(dns_servers) do\n    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_dns_servers,\n      option_data: dns_data\n    }\n  end\n\n  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n\n  defp add_domain_list_option(options, domain) do\n    # Encode domain name in DNS format (length-prefixed labels)\n    domain_data = encode_domain_name(domain)\n\n    domain_option = %DHCPv6.Message.Option{\n      option_code: @option_domain_list,\n      option_data: domain_data\n    }\n\n    options ++ [domain_option]\n  end\n\n  defp encode_domain_name(domain) do\n    domain\n    |> String.split(\".\")\n    |> Enum.map_join(fn label ->\n      <<byte_size(label)::8, label::binary>>\n    end)\n    # Terminating zero\n    |> Kernel.<>(<<0>>)\n  end\n\n  # Helper functions for extracting information from messages\n\n  defp get_client_duid(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n      nil -> nil\n      option -> option.option_data\n    end\n  end\n\n  defp get_ia_na(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            # Try to extract IA_ADDR if present\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_ta(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n        case option.option_data do\n          <<iaid::32, rest::binary>> ->\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_pd(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            ia_prefix = extract_ia_prefix(rest)\n            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\n\n  # Allocation helper functions\n\n  defp allocate_temporary_address(duid, iaid) do\n    # Temporary addresses use a separate pool with shorter lifetimes\n    # For now, delegate to LeaseManager with IA_TA type marker\n    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n      {:ok, lease} ->\n        # Mark as temporary address with shorter lifetime\n        ta_lease = %{\n          lease\n          | ia_type: :ia_ta,\n            preferred_lifetime: 600,\n            # 10 minutes\n            valid_lifetime: 1200\n            # 20 minutes\n        }\n\n        {:ok, ta_lease}\n\n      error ->\n        error\n    end\n  end\n\n  defp allocate_prefix_delegation(duid, iaid) do\n    # For now, return a placeholder\n    # Full implementation would use PrefixPool module\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n      %{count: 1},\n      %{client_duid: duid, iaid: iaid}\n    )\n\n    # TODO: Integrate with PrefixPool module\n    # Example placeholder prefix: 2001:db8:1000::/56\n    {:ok,\n     %{\n       duid: duid,\n       iaid: iaid,\n       ia_type: :ia_pd,\n       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n       preferred_lifetime: 3600,\n       valid_lifetime: 7200,\n       pool_name: \"default-pd\"\n     }}\n  end\n\n  # Message creation functions with multi-IA support\n\n  defp create_advertise_multi(solicit, leases) do\n    pool = get_default_pool()\n\n    options = [\n      # Server DUID\n      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n      # Client DUID (echo back)\n      %DHCPv6.Message.Option{\n        option_code: @option_client_id,\n        option_data: get_client_duid(solicit)\n      },\n      # Preference\n      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n    ]\n\n    # Add IA options for each lease\n    ia_options =\n      Enum.flat_map(leases, fn lease ->\n        case lease.ia_type do\n          :ia_na -> [create_ia_na_option(lease)]\n          :ia_ta -> [create_ia_ta_option(lease)]\n          :ia_pd -> [create_ia_pd_option(lease)]\n          _ -> []\n        end\n      end)\n\n    # Add configuration options (DNS, etc.)\n    config_options =\n      [\n        create_dns_servers_option(pool.dns_servers)\n      ] ++ add_domain_list_option([], pool.domain_name)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_advertise,\n      transaction_id: solicit.transaction_id,\n      options: options ++ ia_options ++ config_options\n    }\n  end\n\n  defp create_ia_ta_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n    ia_ta_data =\n      <<lease.iaid::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_ta,\n      option_data: ia_ta_data\n    }\n  end\n\n  defp create_ia_pd_option(lease) do\n    {prefix_addr, prefix_len} = lease.delegated_prefix\n\n    # IA_PREFIX option (option 26)\n    ia_prefix_data =\n      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n        ipv6_to_binary(prefix_addr)\n\n    ia_prefix_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_prefix,\n      option_data: ia_prefix_data\n    }\n\n    # IA_PD option (option 25)\n    ia_pd_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_prefix_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_pd,\n      option_data: ia_pd_data\n    }\n  end\n\n  defp get_server_duid do\n    # Generate a simple DUID-LL (Link-Layer) based on server\n    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n    # Using a static server identifier for now\n    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use default pool\n    # In production, look up pool by lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    %{\n      name: \"default\",\n      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n      prefix_length: 64,\n      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n      domain_name: \"local\",\n      preferred_lifetime: 3600,\n      valid_lifetime: 7200\n    }\n  end\n\n  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :sent],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :send_failed],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Utility functions\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\nend\n","numLines":883,"startLine":1,"totalLines":883}}}
