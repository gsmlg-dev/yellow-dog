  preferred_lifetime: 3600,\n    53→        valid_lifetime: 7200,\n    54→        expires_at: System.system_time(:second) + 7200\n    55→      }\n    56→\n    57→      {:ok, _} = LeaseStorage.put(lease)\n    58→\n    59→      # Update state to active\n    60→      updated_lease = %{lease | state: :active}\n    61→      {:ok, stored} = LeaseStorage.put(updated_lease)\n    62→\n    63→      assert stored.state == :active\n    64→    end\n    65→\n    66→    test \"returns error for non-existent lease\" do\n    67→      assert {:error, :not_found} = LeaseStorage.get(@test_duid, 99999)\n    68→    end\n    69→  end\n    70→\n    71→  describe \"get_by_ip/1\" do\n    72→    test \"retrieves lease by IP address\" do\n    73→      lease = %{\n    74→        duid: @test_duid,\n    75→        iaid: @test_iaid,\n    76→        ip_address: @test_ip,\n    77→        pool_name: \"test-pool\",\n    78→        ia_type: :ia_na,\n    79→        state: :active,\n    80→        preferred_lifetime: 3600,\n    81→        valid_lifetime: 7200,\n    82→        expires_at: System.system_time(:second) + 7200\n    83→      }\n    84→\n    85→      {:ok, _} = LeaseStorage.put(lease)\n    86→\n    87→      assert {:ok, retrieved} = LeaseStorage.get_by_ip(@test_ip)\n    88→      assert retrieved.duid == @test_duid\n    89→      assert retrieved.ip_address == @test_ip\n    90→    end\n    91→\n    92→    test \"returns error for non-existent IP\" do\n    93→      assert {:error, :not_found} = LeaseStorage.get_by_ip({0xFD00, 0, 0, 0, 0, 0, 0, 0x999})\n    94→    end\n    95→  end\n    96→\n    97→  describe \"get_by_duid/1\" do\n    98→    test \"retrieves all leases for a DUID\" do\n    99→      # Create multiple leases for the same DUID\n   100→      lease1 = %{\n   101→        duid: @test_duid,\n   102→        iaid: 1,\n   103→        ip_address: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   104→        pool_name: \"test-pool\",\n   105→        ia_type: :ia_na,\n   106→        state: :active,\n   107