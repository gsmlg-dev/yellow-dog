{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNvq7rm4GJ2ZYN3nuwwLke","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.Handler do\n     2→  @moduledoc \"\"\"\n     3→  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n     4→\n     5→  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n     6→  REPLY, and other DHCPv6 protocol messages. Handles client identification\n     7→  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n     8→  \"\"\"\n     9→\n    10→  use Abyss.Handler\n    11→\n    12→  alias YellowDog.Dhcpv6.{LeaseManager, RateLimiter}\n    13→\n    14→  # DHCPv6 message type constants\n    15→  @msg_type_solicit 1\n    16→  @msg_type_advertise 2\n    17→  @msg_type_request 3\n    18→  # @msg_type_confirm 4\n    19→  @msg_type_renew 5\n    20→  @msg_type_rebind 6\n    21→  @msg_type_reply 7\n    22→  @msg_type_release 8\n    23→  @msg_type_decline 9\n    24→  # @msg_type_reconfigure 10\n    25→  @msg_type_information_request 11\n    26→  @msg_type_relay_forw 12\n    27→  @msg_type_relay_repl 13\n    28→\n    29→  # DHCPv6 option codes\n    30→  @option_client_id 1\n    31→  @option_server_id 2\n    32→  @option_ia_na 3\n    33→  @option_ia_ta 4\n    34→  @option_ia_addr 5\n    35→  # @option_oro 6\n    36→  @option_preference 7\n    37→  # @option_elapsed_time 8\n    38→  # @option_status_code 13\n    39→  # @option_rapid_commit 14\n    40→  @option_dns_servers 23\n    41→  @option_domain_list 24\n    42→  @option_ia_pd 25\n    43→  @option_ia_prefix 26\n    44→\n    45→  @doc \"\"\"\n    46→  Handles incoming DHCPv6 data from clients.\n    47→  \"\"\"\n    48→  @impl true\n    49→  def handle_data({client_ip, client_port, data}, state) do\n    50→    start_time = System.monotonic_time(:microsecond)\n    51→\n    52→    # Check rate limit before processing\n    53→    case RateLimiter.check_rate(client_ip) do\n    54→      :ok ->\n    55→        process_message(client_ip, client_port, data, state, start_time)\n    56→\n    57→      {:error, :rate_limited} ->\n    58→        :telemetry.execute(\n    59→          [:yellow_dog, :dhcpv6, :message, :rate_limited],\n    60→          %{count: 1},\n    61→          %{client_ip: client_ip, client_port: client_port}\n    62→        )\n    63→\n    64→        {:continue, state}\n    65→    end\n    66→  end\n    67→\n    68→  defp process_message(client_ip, client_port, data, state, start_time) do\n    69→    try do\n    70→      case DHCPv6.Message.from_iodata(data) do\n    71→        {:ok, message} ->\n    72→          :telemetry.execute(\n    73→            [:yellow_dog, :dhcpv6, :message, :received],\n    74→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    75→            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n    76→          )\n    77→\n    78→          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n    79→\n    80→        {:error, reason} ->\n    81→          :telemetry.execute(\n    82→            [:yellow_dog, :dhcpv6, :message, :parse_error],\n    83→            %{count: 1},\n    84→            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n    85→          )\n    86→\n    87→          {:continue, state}\n    88→      end\n    89→    rescue\n    90→      error ->\n    91→        :telemetry.execute(\n    92→          [:yellow_dog, :dhcpv6, :message, :error],\n    93→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n    94→          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n    95→        )\n    96→\n    97→        {:continue, state}\n    98→    end\n    99→  end\n   100→\n   101→  @doc \"\"\"\n   102→  Handles handler errors (implements Abyss.Handler callback).\n   103→  \"\"\"\n   104→  @impl true\n   105→  def handle_error(error, state) do\n   106→    :telemetry.execute(\n   107→      [:yellow_dog, :dhcpv6, :handler, :error],\n   108→      %{count: 1},\n   109→      %{reason: inspect(error)}\n   110→    )\n   111→\n   112→    {:continue, state}\n   113→  end\n   114→\n   115→  @doc \"\"\"\n   116→  Handles handler timeouts (implements Abyss.Handler callback).\n   117→  \"\"\"\n   118→  @impl true\n   119→  def handle_timeout(state) do\n   120→    :telemetry.execute(\n   121→      [:yellow_dog, :dhcpv6, :handler, :timeout],\n   122→      %{count: 1},\n   123→      %{}\n   124→    )\n   125→\n   126→    {:continue, state}\n   127→  end\n   128→\n   129→  # Private functions for handling specific DHCPv6 message types\n   130→\n   131→  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n   132→    case message.msg_type do\n   133→      @msg_type_solicit ->\n   134→        handle_solicit(message, client_ip, client_port, state, start_time)\n   135→\n   136→      @msg_type_request ->\n   137→        handle_request(message, client_ip, client_port, state, start_time)\n   138→\n   139→      @msg_type_renew ->\n   140→        handle_renew(message, client_ip, client_port, state, start_time)\n   141→\n   142→      @msg_type_rebind ->\n   143→        handle_rebind(message, client_ip, client_port, state, start_time)\n   144→\n   145→      @msg_type_release ->\n   146→        handle_release(message, client_ip, client_port, state, start_time)\n   147→\n   148→      @msg_type_decline ->\n   149→        handle_decline(message, client_ip, client_port, state, start_time)\n   150→\n   151→      @msg_type_information_request ->\n   152→        handle_inform(message, client_ip, client_port, state, start_time)\n   153→\n   154→      @msg_type_relay_forw ->\n   155→        handle_relay_forward(message, client_ip, client_port, state)\n   156→\n   157→      @msg_type_relay_repl ->\n   158→        handle_relay_reply(message, client_ip, client_port, state)\n   159→\n   160→      _ ->\n   161→        :telemetry.execute(\n   162→          [:yellow_dog, :dhcpv6, :message, :unknown],\n   163→          %{count: 1},\n   164→          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n   165→        )\n   166→\n   167→        {:continue, state}\n   168→    end\n   169→  end\n   170→\n   171→  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n   172→    :telemetry.execute(\n   173→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   174→      %{count: 1},\n   175→      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n   176→    )\n   177→\n   178→    client_duid = get_client_duid(message)\n   179→    ia_na = get_ia_na(message)\n   180→    ia_ta = get_ia_ta(message)\n   181→    ia_pd = get_ia_pd(message)\n   182→\n   183→    # Check if any IA type is present\n   184→    case {client_duid, ia_na, ia_ta, ia_pd} do\n   185→      {nil, _, _, _} ->\n   186→        :telemetry.execute(\n   187→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   188→          %{count: 1},\n   189→          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n   190→        )\n   191→\n   192→        {:continue, state}\n   193→\n   194→      {_, nil, nil, nil} ->\n   195→        :telemetry.execute(\n   196→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   197→          %{count: 1},\n   198→          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n   199→        )\n   200→\n   201→        {:continue, state}\n   202→\n   203→      {duid, _, _, _} ->\n   204→        # Process each IA type\n   205→        leases = []\n   206→\n   207→        # Handle IA_NA if present\n   208→        leases =\n   209→          if ia_na do\n   210→            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n   211→              {:ok, lease} ->\n   212→                [lease | leases]\n   213→\n   214→              {:error, reason} ->\n   215→                :telemetry.execute(\n   216→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   217→                  %{count: 1},\n   218→                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n   219→                )\n   220→\n   221→                leases\n   222→            end\n   223→          else\n   224→            leases\n   225→          end\n   226→\n   227→        # Handle IA_TA if present\n   228→        leases =\n   229→          if ia_ta do\n   230→            case allocate_temporary_address(duid, ia_ta.iaid) do\n   231→              {:ok, ta_lease} ->\n   232→                [ta_lease | leases]\n   233→\n   234→              {:error, reason} ->\n   235→                :telemetry.execute(\n   236→                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   237→                  %{count: 1},\n   238→                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n   239→                )\n   240→\n   241→                leases\n   242→            end\n   243→          else\n   244→            leases\n   245→          end\n   246→\n   247→        # Handle IA_PD if present\n   248→        leases =\n   249→          if ia_pd do\n   250→            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n   251→            [pd_lease | leases]\n   252→          else\n   253→            leases\n   254→          end\n   255→\n   256→        if length(leases) > 0 do\n   257→          advertise = create_advertise_multi(message, leases)\n   258→          send_dhcpv6_response(advertise, client_ip, client_port, state)\n   259→\n   260→          :telemetry.execute(\n   261→            [:yellow_dog, :dhcpv6, :solicit, :completed],\n   262→            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   263→            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n   264→          )\n   265→        end\n   266→\n   267→        {:continue, state}\n   268→    end\n   269→  end\n   270→\n   271→  defp handle_request(message, client_ip, client_port, state, start_time) do\n   272→    :telemetry.execute(\n   273→      [:yellow_dog, :dhcpv6, :lease, :requested],\n   274→      %{count: 1},\n   275→      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n   276→    )\n   277→\n   278→    client_duid = get_client_duid(message)\n   279→    ia_na = get_ia_na(message)\n   280→\n   281→    case {client_duid, ia_na} do\n   282→      {nil, _} ->\n   283→        :telemetry.execute(\n   284→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   285→          %{count: 1},\n   286→          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n   287→        )\n   288→\n   289→        {:continue, state}\n   290→\n   291→      {_, nil} ->\n   292→        :telemetry.execute(\n   293→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   294→          %{count: 1},\n   295→          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n   296→        )\n   297→\n   298→        {:continue, state}\n   299→\n   300→      {duid, %{iaid: iaid}} ->\n   301→        # Allocate or renew lease\n   302→        case LeaseManager.allocate_lease(duid, iaid) do\n   303→          {:ok, lease} ->\n   304→            reply = create_reply(message, lease)\n   305→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   306→\n   307→            :telemetry.execute(\n   308→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   309→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   310→              %{client_ip: client_ip, client_duid: duid}\n   311→            )\n   312→\n   313→          {:error, reason} ->\n   314→            :telemetry.execute(\n   315→              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n   316→              %{count: 1},\n   317→              %{reason: inspect(reason), client_duid: duid}\n   318→            )\n   319→        end\n   320→\n   321→        {:continue, state}\n   322→    end\n   323→  end\n   324→\n   325→  defp handle_renew(message, client_ip, client_port, state, start_time) do\n   326→    :telemetry.execute(\n   327→      [:yellow_dog, :dhcpv6, :lease, :renewed],\n   328→      %{count: 1},\n   329→      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n   330→    )\n   331→\n   332→    client_duid = get_client_duid(message)\n   333→    ia_na = get_ia_na(message)\n   334→\n   335→    case {client_duid, ia_na} do\n   336→      {duid, %{iaid: iaid}} when duid != nil ->\n   337→        # Renew existing lease\n   338→        case LeaseManager.allocate_lease(duid, iaid) do\n   339→          {:ok, lease} ->\n   340→            reply = create_reply(message, lease)\n   341→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   342→\n   343→            :telemetry.execute(\n   344→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   345→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   346→              %{client_ip: client_ip, client_duid: duid}\n   347→            )\n   348→\n   349→          {:error, reason} ->\n   350→            :telemetry.execute(\n   351→              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n   352→              %{count: 1},\n   353→              %{reason: inspect(reason), client_duid: duid}\n   354→            )\n   355→        end\n   356→\n   357→        {:continue, state}\n   358→\n   359→      _ ->\n   360→        :telemetry.execute(\n   361→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   362→          %{count: 1},\n   363→          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n   364→        )\n   365→\n   366→        {:continue, state}\n   367→    end\n   368→  end\n   369→\n   370→  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n   371→    :telemetry.execute(\n   372→      [:yellow_dog, :dhcpv6, :lease, :rebind],\n   373→      %{count: 1},\n   374→      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n   375→    )\n   376→\n   377→    # Rebind is similar to renew - reuse the renew logic\n   378→    client_duid = get_client_duid(message)\n   379→    ia_na = get_ia_na(message)\n   380→\n   381→    case {client_duid, ia_na} do\n   382→      {duid, %{iaid: iaid}} when duid != nil ->\n   383→        case LeaseManager.allocate_lease(duid, iaid) do\n   384→          {:ok, lease} ->\n   385→            reply = create_reply(message, lease)\n   386→            send_dhcpv6_response(reply, client_ip, client_port, state)\n   387→\n   388→            :telemetry.execute(\n   389→              [:yellow_dog, :dhcpv6, :lease, :granted],\n   390→              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   391→              %{client_ip: client_ip, client_duid: duid}\n   392→            )\n   393→\n   394→          {:error, reason} ->\n   395→            :telemetry.execute(\n   396→              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n   397→              %{count: 1},\n   398→              %{reason: inspect(reason), client_duid: duid}\n   399→            )\n   400→        end\n   401→\n   402→        {:continue, state}\n   403→\n   404→      _ ->\n   405→        :telemetry.execute(\n   406→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   407→          %{count: 1},\n   408→          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n   409→        )\n   410→\n   411→        {:continue, state}\n   412→    end\n   413→  end\n   414→\n   415→  defp handle_release(message, client_ip, client_port, state, start_time) do\n   416→    :telemetry.execute(\n   417→      [:yellow_dog, :dhcpv6, :lease, :released],\n   418→      %{count: 1},\n   419→      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n   420→    )\n   421→\n   422→    client_duid = get_client_duid(message)\n   423→    ia_na = get_ia_na(message)\n   424→\n   425→    case {client_duid, ia_na} do\n   426→      {duid, %{iaid: iaid}} when duid != nil ->\n   427→        LeaseManager.release_lease(duid, iaid)\n   428→\n   429→        :telemetry.execute(\n   430→          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n   431→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   432→          %{client_ip: client_ip, client_duid: duid}\n   433→        )\n   434→\n   435→      _ ->\n   436→        :telemetry.execute(\n   437→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   438→          %{count: 1},\n   439→          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n   440→        )\n   441→    end\n   442→\n   443→    {:continue, state}\n   444→  end\n   445→\n   446→  defp handle_decline(message, client_ip, client_port, state, start_time) do\n   447→    :telemetry.execute(\n   448→      [:yellow_dog, :dhcpv6, :lease, :declined],\n   449→      %{count: 1},\n   450→      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n   451→    )\n   452→\n   453→    client_duid = get_client_duid(message)\n   454→    ia_na = get_ia_na(message)\n   455→\n   456→    case {client_duid, ia_na} do\n   457→      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n   458→        LeaseManager.decline_ip(ia_addr, duid)\n   459→\n   460→        :telemetry.execute(\n   461→          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n   462→          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   463→          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n   464→        )\n   465→\n   466→      _ ->\n   467→        :telemetry.execute(\n   468→          [:yellow_dog, :dhcpv6, :message, :invalid],\n   469→          %{count: 1},\n   470→          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n   471→        )\n   472→    end\n   473→\n   474→    {:continue, state}\n   475→  end\n   476→\n   477→  defp handle_inform(message, client_ip, client_port, state, start_time) do\n   478→    :telemetry.execute(\n   479→      [:yellow_dog, :dhcpv6, :inform, :requested],\n   480→      %{count: 1},\n   481→      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n   482→    )\n   483→\n   484→    # INFORMATION-REQUEST - provide configuration without address allocation\n   485→    reply = create_information_reply(message)\n   486→    send_dhcpv6_response(reply, client_ip, client_port, state)\n   487→\n   488→    :telemetry.execute(\n   489→      [:yellow_dog, :dhcpv6, :inform, :completed],\n   490→      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n   491→      %{client_ip: client_ip}\n   492→    )\n   493→\n   494→    {:continue, state}\n   495→  end\n   496→\n   497→  defp handle_relay_forward(_message, client_ip, client_port, state) do\n   498→    :telemetry.execute(\n   499→      [:yellow_dog, :dhcpv6, :relay, :forward],\n   500→      %{count: 1},\n   501→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   502→    )\n   503→\n   504→    {:continue, state}\n   505→  end\n   506→\n   507→  defp handle_relay_reply(_message, client_ip, client_port, state) do\n   508→    :telemetry.execute(\n   509→      [:yellow_dog, :dhcpv6, :relay, :reply],\n   510→      %{count: 1},\n   511→      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n   512→    )\n   513→\n   514→    {:continue, state}\n   515→  end\n   516→\n   517→  # Message creation functions\n   518→\n   519→  defp create_reply(request, lease) do\n   520→    pool = get_pool_for_lease(lease)\n   521→\n   522→    %DHCPv6.Message{\n   523→      msg_type: @msg_type_reply,\n   524→      transaction_id: request.transaction_id,\n   525→      options:\n   526→        [\n   527→          # Server DUID\n   528→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   529→          # Client DUID (echo back)\n   530→          %DHCPv6.Message.Option{\n   531→            option_code: @option_client_id,\n   532→            option_data: get_client_duid(request)\n   533→          },\n   534→          # IA_NA with IA_ADDR\n   535→          create_ia_na_option(lease),\n   536→          # DNS servers\n   537→          create_dns_servers_option(pool.dns_servers)\n   538→        ]\n   539→        |> add_domain_list_option(pool.domain_name)\n   540→    }\n   541→  end\n   542→\n   543→  defp create_information_reply(request) do\n   544→    pool = get_default_pool()\n   545→\n   546→    %DHCPv6.Message{\n   547→      msg_type: @msg_type_reply,\n   548→      transaction_id: request.transaction_id,\n   549→      options:\n   550→        [\n   551→          # Server DUID\n   552→          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   553→          # Client DUID (echo back)\n   554→          %DHCPv6.Message.Option{\n   555→            option_code: @option_client_id,\n   556→            option_data: get_client_duid(request)\n   557→          },\n   558→          # DNS servers\n   559→          create_dns_servers_option(pool.dns_servers)\n   560→        ]\n   561→        |> add_domain_list_option(pool.domain_name)\n   562→    }\n   563→  end\n   564→\n   565→  # Helper functions for creating options\n   566→\n   567→  defp create_ia_na_option(lease) do\n   568→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   569→    ia_addr_data =\n   570→      ipv6_to_binary(lease.ip) <>\n   571→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   572→\n   573→    ia_addr_option = %DHCPv6.Message.Option{\n   574→      option_code: @option_ia_addr,\n   575→      option_data: ia_addr_data\n   576→    }\n   577→\n   578→    # IA_NA option (option 3) - contains IA_ADDR\n   579→    # IAID + T1 + T2 (0 = server decides)\n   580→    ia_na_data =\n   581→      <<lease.iaid::32, 0::32, 0::32>> <>\n   582→        DHCP.Parameter.to_iodata(ia_addr_option)\n   583→\n   584→    %DHCPv6.Message.Option{\n   585→      option_code: @option_ia_na,\n   586→      option_data: ia_na_data\n   587→    }\n   588→  end\n   589→\n   590→  defp create_dns_servers_option(dns_servers) do\n   591→    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n   592→\n   593→    %DHCPv6.Message.Option{\n   594→      option_code: @option_dns_servers,\n   595→      option_data: dns_data\n   596→    }\n   597→  end\n   598→\n   599→  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n   600→\n   601→  defp add_domain_list_option(options, domain) do\n   602→    # Encode domain name in DNS format (length-prefixed labels)\n   603→    domain_data = encode_domain_name(domain)\n   604→\n   605→    domain_option = %DHCPv6.Message.Option{\n   606→      option_code: @option_domain_list,\n   607→      option_data: domain_data\n   608→    }\n   609→\n   610→    options ++ [domain_option]\n   611→  end\n   612→\n   613→  defp encode_domain_name(domain) do\n   614→    # RFC 1035: Each label is limited to 63 octets\n   615→    domain\n   616→    |> String.split(\".\")\n   617→    |> Enum.map_join(fn label ->\n   618→      # Enforce max label length per DNS specification\n   619→      truncated_label =\n   620→        if byte_size(label) > 63 do\n   621→          :telemetry.execute(\n   622→            [:yellow_dog, :dhcpv6, :config, :warning],\n   623→            %{count: 1},\n   624→            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n   625→          )\n   626→\n   627→          binary_part(label, 0, 63)\n   628→        else\n   629→          label\n   630→        end\n   631→\n   632→      <<byte_size(truncated_label)::8, truncated_label::binary>>\n   633→    end)\n   634→    # Terminating zero\n   635→    |> Kernel.<>(<<0>>)\n   636→  end\n   637→\n   638→  # Helper functions for extracting information from messages\n   639→\n   640→  defp get_client_duid(message) do\n   641→    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n   642→      nil -> nil\n   643→      option -> option.option_data\n   644→    end\n   645→  end\n   646→\n   647→  defp get_ia_na(message) do\n   648→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n   649→      nil ->\n   650→        nil\n   651→\n   652→      option ->\n   653→        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   654→        case option.option_data do\n   655→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   656→            # Try to extract IA_ADDR if present\n   657→            ia_addr = extract_ia_addr(rest)\n   658→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n   659→\n   660→          _ ->\n   661→            nil\n   662→        end\n   663→    end\n   664→  end\n   665→\n   666→  defp get_ia_ta(message) do\n   667→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n   668→      nil ->\n   669→        nil\n   670→\n   671→      option ->\n   672→        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n   673→        case option.option_data do\n   674→          <<iaid::32, rest::binary>> ->\n   675→            ia_addr = extract_ia_addr(rest)\n   676→            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n   677→\n   678→          _ ->\n   679→            nil\n   680→        end\n   681→    end\n   682→  end\n   683→\n   684→  defp get_ia_pd(message) do\n   685→    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n   686→      nil ->\n   687→        nil\n   688→\n   689→      option ->\n   690→        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n   691→        case option.option_data do\n   692→          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n   693→            ia_prefix = extract_ia_prefix(rest)\n   694→            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n   695→\n   696→          _ ->\n   697→            nil\n   698→        end\n   699→    end\n   700→  end\n   701→\n   702→  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n   703→    case data do\n   704→      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n   705→        {a, b, c, d, e, f, g, h}\n   706→\n   707→      _ ->\n   708→        nil\n   709→    end\n   710→  end\n   711→\n   712→  defp extract_ia_addr(_), do: nil\n   713→\n   714→  defp extract_ia_prefix(\n   715→         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n   716→       ) do\n   717→    case data do\n   718→      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n   719→        g::16, h::16>> ->\n   720→        {{a, b, c, d, e, f, g, h}, prefix_len}\n   721→\n   722→      _ ->\n   723→        nil\n   724→    end\n   725→  end\n   726→\n   727→  defp extract_ia_prefix(_), do: nil\n   728→\n   729→  # Allocation helper functions\n   730→\n   731→  defp allocate_temporary_address(duid, iaid) do\n   732→    # Temporary addresses use a separate pool with shorter lifetimes\n   733→    # For now, delegate to LeaseManager with IA_TA type marker\n   734→    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n   735→      {:ok, lease} ->\n   736→        # Mark as temporary address with shorter lifetime\n   737→        ta_lease = %{\n   738→          lease\n   739→          | ia_type: :ia_ta,\n   740→            preferred_lifetime: 600,\n   741→            # 10 minutes\n   742→            valid_lifetime: 1200\n   743→            # 20 minutes\n   744→        }\n   745→\n   746→        {:ok, ta_lease}\n   747→\n   748→      error ->\n   749→        error\n   750→    end\n   751→  end\n   752→\n   753→  defp allocate_prefix_delegation(duid, iaid) do\n   754→    # For now, return a placeholder\n   755→    # Full implementation would use PrefixPool module\n   756→    :telemetry.execute(\n   757→      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n   758→      %{count: 1},\n   759→      %{client_duid: duid, iaid: iaid}\n   760→    )\n   761→\n   762→    # TODO: Integrate with PrefixPool module\n   763→    # Example placeholder prefix: 2001:db8:1000::/56\n   764→    {:ok,\n   765→     %{\n   766→       duid: duid,\n   767→       iaid: iaid,\n   768→       ia_type: :ia_pd,\n   769→       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n   770→       preferred_lifetime: 3600,\n   771→       valid_lifetime: 7200,\n   772→       pool_name: \"default-pd\"\n   773→     }}\n   774→  end\n   775→\n   776→  # Message creation functions with multi-IA support\n   777→\n   778→  defp create_advertise_multi(solicit, leases) do\n   779→    pool = get_default_pool()\n   780→\n   781→    options = [\n   782→      # Server DUID\n   783→      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n   784→      # Client DUID (echo back)\n   785→      %DHCPv6.Message.Option{\n   786→        option_code: @option_client_id,\n   787→        option_data: get_client_duid(solicit)\n   788→      },\n   789→      # Preference\n   790→      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n   791→    ]\n   792→\n   793→    # Add IA options for each lease\n   794→    ia_options =\n   795→      Enum.flat_map(leases, fn lease ->\n   796→        case lease.ia_type do\n   797→          :ia_na -> [create_ia_na_option(lease)]\n   798→          :ia_ta -> [create_ia_ta_option(lease)]\n   799→          :ia_pd -> [create_ia_pd_option(lease)]\n   800→          _ -> []\n   801→        end\n   802→      end)\n   803→\n   804→    # Add configuration options (DNS, etc.)\n   805→    config_options =\n   806→      [\n   807→        create_dns_servers_option(pool.dns_servers)\n   808→      ] ++ add_domain_list_option([], pool.domain_name)\n   809→\n   810→    %DHCPv6.Message{\n   811→      msg_type: @msg_type_advertise,\n   812→      transaction_id: solicit.transaction_id,\n   813→      options: options ++ ia_options ++ config_options\n   814→    }\n   815→  end\n   816→\n   817→  defp create_ia_ta_option(lease) do\n   818→    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n   819→    ia_addr_data =\n   820→      ipv6_to_binary(lease.ip) <>\n   821→        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n   822→\n   823→    ia_addr_option = %DHCPv6.Message.Option{\n   824→      option_code: @option_ia_addr,\n   825→      option_data: ia_addr_data\n   826→    }\n   827→\n   828→    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n   829→    ia_ta_data =\n   830→      <<lease.iaid::32>> <>\n   831→        DHCP.Parameter.to_iodata(ia_addr_option)\n   832→\n   833→    %DHCPv6.Message.Option{\n   834→      option_code: @option_ia_ta,\n   835→      option_data: ia_ta_data\n   836→    }\n   837→  end\n   838→\n   839→  defp create_ia_pd_option(lease) do\n   840→    {prefix_addr, prefix_len} = lease.delegated_prefix\n   841→\n   842→    # IA_PREFIX option (option 26)\n   843→    ia_prefix_data =\n   844→      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n   845→        ipv6_to_binary(prefix_addr)\n   846→\n   847→    ia_prefix_option = %DHCPv6.Message.Option{\n   848→      option_code: @option_ia_prefix,\n   849→      option_data: ia_prefix_data\n   850→    }\n   851→\n   852→    # IA_PD option (option 25)\n   853→    ia_pd_data =\n   854→      <<lease.iaid::32, 0::32, 0::32>> <>\n   855→        DHCP.Parameter.to_iodata(ia_prefix_option)\n   856→\n   857→    %DHCPv6.Message.Option{\n   858→      option_code: @option_ia_pd,\n   859→      option_data: ia_pd_data\n   860→    }\n   861→  end\n   862→\n   863→  defp get_server_duid do\n   864→    # Generate a simple DUID-LL (Link-Layer) based on server\n   865→    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n   866→    # Using a static server identifier for now\n   867→    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n   868→  end\n   869→\n   870→  defp get_pool_for_lease(_lease) do\n   871→    # For now, use default pool\n   872→    # In production, look up pool by lease.pool_name\n   873→    get_default_pool()\n   874→  end\n   875→\n   876→  defp get_default_pool do\n   877→    %{\n   878→      name: \"default\",\n   879→      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n   880→      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n   881→      prefix_length: 64,\n   882→      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n   883→      domain_name: \"local\",\n   884→      preferred_lifetime: 3600,\n   885→      valid_lifetime: 7200\n   886→    }\n   887→  end\n   888→\n   889→  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n   890→    data = DHCP.Parameter.to_iodata(response)\n   891→\n   892→    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n   893→      :ok ->\n   894→        :telemetry.execute(\n   895→          [:yellow_dog, :dhcpv6, :response, :sent],\n   896→          %{count: 1},\n   897→          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n   898→        )\n   899→\n   900→      {:error, reason} ->\n   901→        :telemetry.execute(\n   902→          [:yellow_dog, :dhcpv6, :response, :send_failed],\n   903→          %{count: 1},\n   904→          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n   905→        )\n   906→    end\n   907→  end\n   908→\n   909→  # Utility functions\n   910→\n   911→  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n   912→    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n   913→  end\n   914→end\n   915→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"0bb55107-8349-4cae-9bb5-b632487112b4","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/handler.ex","content":"defmodule YellowDog.Dhcpv6.Handler do\n  @moduledoc \"\"\"\n  DHCPv6 message handler implementing the Abyss.Handler behaviour.\n\n  Processes DHCPv6 messages including SOLICIT, ADVERTISE, REQUEST,\n  REPLY, and other DHCPv6 protocol messages. Handles client identification\n  via DUID (DHCP Unique Identifier) and supports IPv6 multicast.\n  \"\"\"\n\n  use Abyss.Handler\n\n  alias YellowDog.Dhcpv6.{LeaseManager, RateLimiter}\n\n  # DHCPv6 message type constants\n  @msg_type_solicit 1\n  @msg_type_advertise 2\n  @msg_type_request 3\n  # @msg_type_confirm 4\n  @msg_type_renew 5\n  @msg_type_rebind 6\n  @msg_type_reply 7\n  @msg_type_release 8\n  @msg_type_decline 9\n  # @msg_type_reconfigure 10\n  @msg_type_information_request 11\n  @msg_type_relay_forw 12\n  @msg_type_relay_repl 13\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  # @option_oro 6\n  @option_preference 7\n  # @option_elapsed_time 8\n  # @option_status_code 13\n  # @option_rapid_commit 14\n  @option_dns_servers 23\n  @option_domain_list 24\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @doc \"\"\"\n  Handles incoming DHCPv6 data from clients.\n  \"\"\"\n  @impl true\n  def handle_data({client_ip, client_port, data}, state) do\n    start_time = System.monotonic_time(:microsecond)\n\n    # Check rate limit before processing\n    case RateLimiter.check_rate(client_ip) do\n      :ok ->\n        process_message(client_ip, client_port, data, state, start_time)\n\n      {:error, :rate_limited} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :rate_limited],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp process_message(client_ip, client_port, data, state, start_time) do\n    try do\n      case DHCPv6.Message.from_iodata(data) do\n        {:ok, message} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :received],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n          )\n\n          handle_dhcpv6_message(message, client_ip, client_port, state, start_time)\n\n        {:error, reason} ->\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :message, :parse_error],\n            %{count: 1},\n            %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n          )\n\n          {:continue, state}\n      end\n    rescue\n      error ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :error],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_port: client_port, error: Exception.message(error)}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  @doc \"\"\"\n  Handles handler errors (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_error(error, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :error],\n      %{count: 1},\n      %{reason: inspect(error)}\n    )\n\n    {:continue, state}\n  end\n\n  @doc \"\"\"\n  Handles handler timeouts (implements Abyss.Handler callback).\n  \"\"\"\n  @impl true\n  def handle_timeout(state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :handler, :timeout],\n      %{count: 1},\n      %{}\n    )\n\n    {:continue, state}\n  end\n\n  # Private functions for handling specific DHCPv6 message types\n\n  defp handle_dhcpv6_message(message, client_ip, client_port, state, start_time) do\n    case message.msg_type do\n      @msg_type_solicit ->\n        handle_solicit(message, client_ip, client_port, state, start_time)\n\n      @msg_type_request ->\n        handle_request(message, client_ip, client_port, state, start_time)\n\n      @msg_type_renew ->\n        handle_renew(message, client_ip, client_port, state, start_time)\n\n      @msg_type_rebind ->\n        handle_rebind(message, client_ip, client_port, state, start_time)\n\n      @msg_type_release ->\n        handle_release(message, client_ip, client_port, state, start_time)\n\n      @msg_type_decline ->\n        handle_decline(message, client_ip, client_port, state, start_time)\n\n      @msg_type_information_request ->\n        handle_inform(message, client_ip, client_port, state, start_time)\n\n      @msg_type_relay_forw ->\n        handle_relay_forward(message, client_ip, client_port, state)\n\n      @msg_type_relay_repl ->\n        handle_relay_reply(message, client_ip, client_port, state)\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :unknown],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: message.msg_type}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_solicit(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :solicit}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n    ia_ta = get_ia_ta(message)\n    ia_pd = get_ia_pd(message)\n\n    # Check if any IA type is present\n    case {client_duid, ia_na, ia_ta, ia_pd} do\n      {nil, _, _, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil, nil, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"SOLICIT missing all IA options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, _, _, _} ->\n        # Process each IA type\n        leases = []\n\n        # Handle IA_NA if present\n        leases =\n          if ia_na do\n            case LeaseManager.allocate_lease(duid, ia_na.iaid) do\n              {:ok, lease} ->\n                [lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_na, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_TA if present\n        leases =\n          if ia_ta do\n            case allocate_temporary_address(duid, ia_ta.iaid) do\n              {:ok, ta_lease} ->\n                [ta_lease | leases]\n\n              {:error, reason} ->\n                :telemetry.execute(\n                  [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n                  %{count: 1},\n                  %{reason: inspect(reason), ia_type: :ia_ta, client_duid: duid}\n                )\n\n                leases\n            end\n          else\n            leases\n          end\n\n        # Handle IA_PD if present\n        leases =\n          if ia_pd do\n            {:ok, pd_lease} = allocate_prefix_delegation(duid, ia_pd.iaid)\n            [pd_lease | leases]\n          else\n            leases\n          end\n\n        if length(leases) > 0 do\n          advertise = create_advertise_multi(message, leases)\n          send_dhcpv6_response(advertise, client_ip, client_port, state)\n\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :solicit, :completed],\n            %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n            %{client_ip: client_ip, client_duid: duid, ia_count: length(leases)}\n          )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_request(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :request}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {nil, _} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing client DUID\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {_, nil} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REQUEST missing IA_NA option\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n\n      {duid, %{iaid: iaid}} ->\n        # Allocate or renew lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :allocation_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_renew(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :renewed],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :renew}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        # Renew existing lease\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :renew_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RENEW missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_rebind(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :rebind],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :rebind}\n    )\n\n    # Rebind is similar to renew - reuse the renew logic\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        case LeaseManager.allocate_lease(duid, iaid) do\n          {:ok, lease} ->\n            reply = create_reply(message, lease)\n            send_dhcpv6_response(reply, client_ip, client_port, state)\n\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :granted],\n              %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n              %{client_ip: client_ip, client_duid: duid}\n            )\n\n          {:error, reason} ->\n            :telemetry.execute(\n              [:yellow_dog, :dhcpv6, :lease, :rebind_failed],\n              %{count: 1},\n              %{reason: inspect(reason), client_duid: duid}\n            )\n        end\n\n        {:continue, state}\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"REBIND missing required options\", client_ip: client_ip}\n        )\n\n        {:continue, state}\n    end\n  end\n\n  defp handle_release(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :released],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :release}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{iaid: iaid}} when duid != nil ->\n        LeaseManager.release_lease(duid, iaid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :release_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"RELEASE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_decline(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :lease, :declined],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :decline}\n    )\n\n    client_duid = get_client_duid(message)\n    ia_na = get_ia_na(message)\n\n    case {client_duid, ia_na} do\n      {duid, %{ia_addr: ia_addr}} when duid != nil and ia_addr != nil ->\n        LeaseManager.decline_ip(ia_addr, duid)\n\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :lease, :decline_completed],\n          %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n          %{client_ip: client_ip, client_duid: duid, declined_ip: ia_addr}\n        )\n\n      _ ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :message, :invalid],\n          %{count: 1},\n          %{reason: \"DECLINE missing required options\", client_ip: client_ip}\n        )\n    end\n\n    {:continue, state}\n  end\n\n  defp handle_inform(message, client_ip, client_port, state, start_time) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :requested],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, message_type: :information_request}\n    )\n\n    # INFORMATION-REQUEST - provide configuration without address allocation\n    reply = create_information_reply(message)\n    send_dhcpv6_response(reply, client_ip, client_port, state)\n\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :inform, :completed],\n      %{count: 1, duration: System.monotonic_time(:microsecond) - start_time},\n      %{client_ip: client_ip}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_forward(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :forward],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  defp handle_relay_reply(_message, client_ip, client_port, state) do\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :relay, :reply],\n      %{count: 1},\n      %{client_ip: client_ip, client_port: client_port, status: :not_implemented}\n    )\n\n    {:continue, state}\n  end\n\n  # Message creation functions\n\n  defp create_reply(request, lease) do\n    pool = get_pool_for_lease(lease)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # IA_NA with IA_ADDR\n          create_ia_na_option(lease),\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  defp create_information_reply(request) do\n    pool = get_default_pool()\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_reply,\n      transaction_id: request.transaction_id,\n      options:\n        [\n          # Server DUID\n          %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n          # Client DUID (echo back)\n          %DHCPv6.Message.Option{\n            option_code: @option_client_id,\n            option_data: get_client_duid(request)\n          },\n          # DNS servers\n          create_dns_servers_option(pool.dns_servers)\n        ]\n        |> add_domain_list_option(pool.domain_name)\n    }\n  end\n\n  # Helper functions for creating options\n\n  defp create_ia_na_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_NA option (option 3) - contains IA_ADDR\n    # IAID + T1 + T2 (0 = server decides)\n    ia_na_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_na,\n      option_data: ia_na_data\n    }\n  end\n\n  defp create_dns_servers_option(dns_servers) do\n    dns_data = Enum.map_join(dns_servers, &ipv6_to_binary/1)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_dns_servers,\n      option_data: dns_data\n    }\n  end\n\n  defp add_domain_list_option(options, domain) when domain in [nil, \"\"], do: options\n\n  defp add_domain_list_option(options, domain) do\n    # Encode domain name in DNS format (length-prefixed labels)\n    domain_data = encode_domain_name(domain)\n\n    domain_option = %DHCPv6.Message.Option{\n      option_code: @option_domain_list,\n      option_data: domain_data\n    }\n\n    options ++ [domain_option]\n  end\n\n  defp encode_domain_name(domain) do\n    # RFC 1035: Each label is limited to 63 octets\n    domain\n    |> String.split(\".\")\n    |> Enum.map_join(fn label ->\n      # Enforce max label length per DNS specification\n      truncated_label =\n        if byte_size(label) > 63 do\n          :telemetry.execute(\n            [:yellow_dog, :dhcpv6, :config, :warning],\n            %{count: 1},\n            %{issue: \"DNS label truncated\", original_length: byte_size(label)}\n          )\n\n          binary_part(label, 0, 63)\n        else\n          label\n        end\n\n      <<byte_size(truncated_label)::8, truncated_label::binary>>\n    end)\n    # Terminating zero\n    |> Kernel.<>(<<0>>)\n  end\n\n  # Helper functions for extracting information from messages\n\n  defp get_client_duid(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_client_id end) do\n      nil -> nil\n      option -> option.option_data\n    end\n  end\n\n  defp get_ia_na(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_na end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_NA: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            # Try to extract IA_ADDR if present\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_ta(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_ta end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_TA: IAID (4 bytes) + options (no T1/T2)\n        case option.option_data do\n          <<iaid::32, rest::binary>> ->\n            ia_addr = extract_ia_addr(rest)\n            %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp get_ia_pd(message) do\n    case Enum.find(message.options, fn opt -> opt.option_code == @option_ia_pd end) do\n      nil ->\n        nil\n\n      option ->\n        # Parse IA_PD: IAID (4 bytes) + T1 (4 bytes) + T2 (4 bytes) + options\n        case option.option_data do\n          <<iaid::32, _t1::32, _t2::32, rest::binary>> ->\n            ia_prefix = extract_ia_prefix(rest)\n            %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n\n          _ ->\n            nil\n        end\n    end\n  end\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\n\n  # Allocation helper functions\n\n  defp allocate_temporary_address(duid, iaid) do\n    # Temporary addresses use a separate pool with shorter lifetimes\n    # For now, delegate to LeaseManager with IA_TA type marker\n    case LeaseManager.allocate_lease(duid, iaid, nil, \"default-ta\") do\n      {:ok, lease} ->\n        # Mark as temporary address with shorter lifetime\n        ta_lease = %{\n          lease\n          | ia_type: :ia_ta,\n            preferred_lifetime: 600,\n            # 10 minutes\n            valid_lifetime: 1200\n            # 20 minutes\n        }\n\n        {:ok, ta_lease}\n\n      error ->\n        error\n    end\n  end\n\n  defp allocate_prefix_delegation(duid, iaid) do\n    # For now, return a placeholder\n    # Full implementation would use PrefixPool module\n    :telemetry.execute(\n      [:yellow_dog, :dhcpv6, :prefix, :delegation_requested],\n      %{count: 1},\n      %{client_duid: duid, iaid: iaid}\n    )\n\n    # TODO: Integrate with PrefixPool module\n    # Example placeholder prefix: 2001:db8:1000::/56\n    {:ok,\n     %{\n       duid: duid,\n       iaid: iaid,\n       ia_type: :ia_pd,\n       delegated_prefix: {{0x2001, 0x0DB8, 0x1000, 0, 0, 0, 0, 0}, 56},\n       preferred_lifetime: 3600,\n       valid_lifetime: 7200,\n       pool_name: \"default-pd\"\n     }}\n  end\n\n  # Message creation functions with multi-IA support\n\n  defp create_advertise_multi(solicit, leases) do\n    pool = get_default_pool()\n\n    options = [\n      # Server DUID\n      %DHCPv6.Message.Option{option_code: @option_server_id, option_data: get_server_duid()},\n      # Client DUID (echo back)\n      %DHCPv6.Message.Option{\n        option_code: @option_client_id,\n        option_data: get_client_duid(solicit)\n      },\n      # Preference\n      %DHCPv6.Message.Option{option_code: @option_preference, option_data: <<255>>}\n    ]\n\n    # Add IA options for each lease\n    ia_options =\n      Enum.flat_map(leases, fn lease ->\n        case lease.ia_type do\n          :ia_na -> [create_ia_na_option(lease)]\n          :ia_ta -> [create_ia_ta_option(lease)]\n          :ia_pd -> [create_ia_pd_option(lease)]\n          _ -> []\n        end\n      end)\n\n    # Add configuration options (DNS, etc.)\n    config_options =\n      [\n        create_dns_servers_option(pool.dns_servers)\n      ] ++ add_domain_list_option([], pool.domain_name)\n\n    %DHCPv6.Message{\n      msg_type: @msg_type_advertise,\n      transaction_id: solicit.transaction_id,\n      options: options ++ ia_options ++ config_options\n    }\n  end\n\n  defp create_ia_ta_option(lease) do\n    # IA_ADDR option (option 5) - IPv6 address + lifetimes\n    ia_addr_data =\n      ipv6_to_binary(lease.ip) <>\n        <<lease.preferred_lifetime::32, lease.valid_lifetime::32>>\n\n    ia_addr_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_addr,\n      option_data: ia_addr_data\n    }\n\n    # IA_TA option (option 4) - contains IA_ADDR (no T1/T2)\n    ia_ta_data =\n      <<lease.iaid::32>> <>\n        DHCP.Parameter.to_iodata(ia_addr_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_ta,\n      option_data: ia_ta_data\n    }\n  end\n\n  defp create_ia_pd_option(lease) do\n    {prefix_addr, prefix_len} = lease.delegated_prefix\n\n    # IA_PREFIX option (option 26)\n    ia_prefix_data =\n      <<lease.preferred_lifetime::32, lease.valid_lifetime::32, prefix_len::8>> <>\n        ipv6_to_binary(prefix_addr)\n\n    ia_prefix_option = %DHCPv6.Message.Option{\n      option_code: @option_ia_prefix,\n      option_data: ia_prefix_data\n    }\n\n    # IA_PD option (option 25)\n    ia_pd_data =\n      <<lease.iaid::32, 0::32, 0::32>> <>\n        DHCP.Parameter.to_iodata(ia_prefix_option)\n\n    %DHCPv6.Message.Option{\n      option_code: @option_ia_pd,\n      option_data: ia_pd_data\n    }\n  end\n\n  defp get_server_duid do\n    # Generate a simple DUID-LL (Link-Layer) based on server\n    # DUID Type 3 (DUID-LL): type (2 bytes) + hardware type (2 bytes) + link-layer address\n    # Using a static server identifier for now\n    <<0, 3, 0, 1, 0x00, 0x00, 0x5E, 0x00, 0x53, 0xFF>>\n  end\n\n  defp get_pool_for_lease(_lease) do\n    # For now, use default pool\n    # In production, look up pool by lease.pool_name\n    get_default_pool()\n  end\n\n  defp get_default_pool do\n    %{\n      name: \"default\",\n      range_start: {0xFD00, 0, 0, 0, 0, 0, 0, 0x100},\n      range_end: {0xFD00, 0, 0, 0, 0, 0, 0, 0x200},\n      prefix_length: 64,\n      dns_servers: [{0xFD00, 0, 0, 0, 0, 0, 0, 1}],\n      domain_name: \"local\",\n      preferred_lifetime: 3600,\n      valid_lifetime: 7200\n    }\n  end\n\n  defp send_dhcpv6_response(response, client_ip, client_port, state) do\n    data = DHCP.Parameter.to_iodata(response)\n\n    case :gen_udp.send(state.socket, client_ip, client_port, data) do\n      :ok ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :sent],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, msg_type: response.msg_type}\n        )\n\n      {:error, reason} ->\n        :telemetry.execute(\n          [:yellow_dog, :dhcpv6, :response, :send_failed],\n          %{count: 1},\n          %{client_ip: client_ip, client_port: client_port, reason: inspect(reason)}\n        )\n    end\n  end\n\n  # Utility functions\n\n  defp ipv6_to_binary({a, b, c, d, e, f, g, h}) do\n    <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16>>\n  end\nend\n","numLines":915,"startLine":1,"totalLines":915}}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01NhbiDewRcg8VDqdSpJYPUK","type":"message","role":"assistant","content":[{"type":"text","text":"Looking at the DHCPv6 handler, I can see it has a different option structure than DHCPv4. DHCPv6 uses typed options with `option_code` and `option_data` fields, and has more complex nested options (IA_NA contains IA_ADDR, etc.). \n\nThe current implementation does multiple `Enum.find` calls for different option types (client_duid, ia_na, ia_ta, ia_pd). Let me create a similar single-pass option parser for DHCPv6."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":12334,"cache_read_input_tokens":92112,"cache_creation":{"ephemeral_5m_input_tokens":12334,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"cd381082-03fd-4a74-9cd0-4d69cb899c2a"}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01NhbiDewRcg8VDqdSpJYPUK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DgfM8TKRzzjW9vKhEFb1jg","name":"Write","input":{"file_path":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/option_parser.ex","content":"defmodule YellowDog.Dhcpv6.OptionParser do\n  @moduledoc \"\"\"\n  Efficient single-pass DHCPv6 option extraction.\n\n  Instead of iterating through the options list multiple times\n  (once per option type), this module extracts all common options\n  in a single pass for better performance.\n\n  ## Performance Benefit\n\n  Before: O(n * m) where n = option count, m = fields to extract\n  After: O(n) - single pass extracts all needed fields\n\n  ## Usage\n\n      options = message.options\n      parsed = OptionParser.extract_common(options)\n      # => %{\n      #      client_id: <<...>>,\n      #      server_id: <<...>>,\n      #      ia_na: %{iaid: 12345, ia_addr: ...},\n      #      ia_ta: nil,\n      #      ia_pd: nil\n      #    }\n  \"\"\"\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @type ia_na :: %{\n          iaid: non_neg_integer(),\n          ia_addr: tuple() | nil,\n          type: :ia_na\n        }\n\n  @type ia_ta :: %{\n          iaid: non_neg_integer(),\n          ia_addr: tuple() | nil,\n          type: :ia_ta\n        }\n\n  @type ia_pd :: %{\n          iaid: non_neg_integer(),\n          ia_prefix: {tuple(), non_neg_integer()} | nil,\n          type: :ia_pd\n        }\n\n  @type parsed_options :: %{\n          client_id: binary() | nil,\n          server_id: binary() | nil,\n          ia_na: ia_na() | nil,\n          ia_ta: ia_ta() | nil,\n          ia_pd: ia_pd() | nil\n        }\n\n  @doc \"\"\"\n  Extracts all commonly needed DHCPv6 options in a single pass.\n\n  This is more efficient than calling multiple individual extractors\n  when you need several option values from the same message.\n\n  ## Parameters\n  - `options` - List of DHCPv6 options from message\n\n  ## Returns\n  - Map with extracted option values (nil for missing options)\n  \"\"\"\n  @spec extract_common([%{option_code: non_neg_integer(), option_data: binary()}]) ::\n          parsed_options()\n  def extract_common(options) do\n    # Initial accumulator with all fields nil\n    initial = %{\n      client_id: nil,\n      server_id: nil,\n      ia_na: nil,\n      ia_ta: nil,\n      ia_pd: nil\n    }\n\n    # Single pass through options, extracting all relevant values\n    Enum.reduce(options, initial, fn option, acc ->\n      case option.option_code do\n        @option_client_id ->\n          %{acc | client_id: option.option_data}\n\n        @option_server_id ->\n          %{acc | server_id: option.option_data}\n\n        @option_ia_na ->\n          %{acc | ia_na: parse_ia_na(option.option_data)}\n\n        @option_ia_ta ->\n          %{acc | ia_ta: parse_ia_ta(option.option_data)}\n\n        @option_ia_pd ->\n          %{acc | ia_pd: parse_ia_pd(option.option_data)}\n\n        # Skip other options\n        _ ->\n          acc\n      end\n    end)\n  end\n\n  @doc \"\"\"\n  Extracts only client DUID - use when you only need the client identifier.\n\n  For cases where only the client DUID is needed, this avoids\n  the overhead of extracting other fields.\n  \"\"\"\n  @spec extract_client_id([%{option_code: non_neg_integer(), option_data: binary()}]) ::\n          binary() | nil\n  def extract_client_id(options) do\n    Enum.find_value(options, fn option ->\n      if option.option_code == @option_client_id do\n        option.option_data\n      end\n    end)\n  end\n\n  # Private helpers for parsing IA options\n\n  defp parse_ia_na(<<iaid::32, _t1::32, _t2::32, rest::binary>>) do\n    ia_addr = extract_ia_addr(rest)\n    %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n  end\n\n  defp parse_ia_na(_), do: nil\n\n  defp parse_ia_ta(<<iaid::32, rest::binary>>) do\n    ia_addr = extract_ia_addr(rest)\n    %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n  end\n\n  defp parse_ia_ta(_), do: nil\n\n  defp parse_ia_pd(<<iaid::32, _t1::32, _t2::32, rest::binary>>) do\n    ia_prefix = extract_ia_prefix(rest)\n    %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n  end\n\n  defp parse_ia_pd(_), do: nil\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\nend\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":12334,"cache_read_input_tokens":92112,"cache_creation":{"ephemeral_5m_input_tokens":12334,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"62d5789b-3895-4da7-a6e5-c65e742bdb1a"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DgfM8TKRzzjW9vKhEFb1jg","type":"tool_result","content":"File created successfully at: /home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/option_parser.ex"}]},"parent_tool_use_id":null,"session_id":"81e7b7f4-e770-437b-8bdf-216395b89020","uuid":"bab6f690-59bf-4e76-ac46-8bbb90347ff4","tool_use_result":{"type":"create","filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/option_parser.ex","content":"defmodule YellowDog.Dhcpv6.OptionParser do\n  @moduledoc \"\"\"\n  Efficient single-pass DHCPv6 option extraction.\n\n  Instead of iterating through the options list multiple times\n  (once per option type), this module extracts all common options\n  in a single pass for better performance.\n\n  ## Performance Benefit\n\n  Before: O(n * m) where n = option count, m = fields to extract\n  After: O(n) - single pass extracts all needed fields\n\n  ## Usage\n\n      options = message.options\n      parsed = OptionParser.extract_common(options)\n      # => %{\n      #      client_id: <<...>>,\n      #      server_id: <<...>>,\n      #      ia_na: %{iaid: 12345, ia_addr: ...},\n      #      ia_ta: nil,\n      #      ia_pd: nil\n      #    }\n  \"\"\"\n\n  # DHCPv6 option codes\n  @option_client_id 1\n  @option_server_id 2\n  @option_ia_na 3\n  @option_ia_ta 4\n  @option_ia_addr 5\n  @option_ia_pd 25\n  @option_ia_prefix 26\n\n  @type ia_na :: %{\n          iaid: non_neg_integer(),\n          ia_addr: tuple() | nil,\n          type: :ia_na\n        }\n\n  @type ia_ta :: %{\n          iaid: non_neg_integer(),\n          ia_addr: tuple() | nil,\n          type: :ia_ta\n        }\n\n  @type ia_pd :: %{\n          iaid: non_neg_integer(),\n          ia_prefix: {tuple(), non_neg_integer()} | nil,\n          type: :ia_pd\n        }\n\n  @type parsed_options :: %{\n          client_id: binary() | nil,\n          server_id: binary() | nil,\n          ia_na: ia_na() | nil,\n          ia_ta: ia_ta() | nil,\n          ia_pd: ia_pd() | nil\n        }\n\n  @doc \"\"\"\n  Extracts all commonly needed DHCPv6 options in a single pass.\n\n  This is more efficient than calling multiple individual extractors\n  when you need several option values from the same message.\n\n  ## Parameters\n  - `options` - List of DHCPv6 options from message\n\n  ## Returns\n  - Map with extracted option values (nil for missing options)\n  \"\"\"\n  @spec extract_common([%{option_code: non_neg_integer(), option_data: binary()}]) ::\n          parsed_options()\n  def extract_common(options) do\n    # Initial accumulator with all fields nil\n    initial = %{\n      client_id: nil,\n      server_id: nil,\n      ia_na: nil,\n      ia_ta: nil,\n      ia_pd: nil\n    }\n\n    # Single pass through options, extracting all relevant values\n    Enum.reduce(options, initial, fn option, acc ->\n      case option.option_code do\n        @option_client_id ->\n          %{acc | client_id: option.option_data}\n\n        @option_server_id ->\n          %{acc | server_id: option.option_data}\n\n        @option_ia_na ->\n          %{acc | ia_na: parse_ia_na(option.option_data)}\n\n        @option_ia_ta ->\n          %{acc | ia_ta: parse_ia_ta(option.option_data)}\n\n        @option_ia_pd ->\n          %{acc | ia_pd: parse_ia_pd(option.option_data)}\n\n        # Skip other options\n        _ ->\n          acc\n      end\n    end)\n  end\n\n  @doc \"\"\"\n  Extracts only client DUID - use when you only need the client identifier.\n\n  For cases where only the client DUID is needed, this avoids\n  the overhead of extracting other fields.\n  \"\"\"\n  @spec extract_client_id([%{option_code: non_neg_integer(), option_data: binary()}]) ::\n          binary() | nil\n  def extract_client_id(options) do\n    Enum.find_value(options, fn option ->\n      if option.option_code == @option_client_id do\n        option.option_data\n      end\n    end)\n  end\n\n  # Private helpers for parsing IA options\n\n  defp parse_ia_na(<<iaid::32, _t1::32, _t2::32, rest::binary>>) do\n    ia_addr = extract_ia_addr(rest)\n    %{iaid: iaid, ia_addr: ia_addr, type: :ia_na}\n  end\n\n  defp parse_ia_na(_), do: nil\n\n  defp parse_ia_ta(<<iaid::32, rest::binary>>) do\n    ia_addr = extract_ia_addr(rest)\n    %{iaid: iaid, ia_addr: ia_addr, type: :ia_ta}\n  end\n\n  defp parse_ia_ta(_), do: nil\n\n  defp parse_ia_pd(<<iaid::32, _t1::32, _t2::32, rest::binary>>) do\n    ia_prefix = extract_ia_prefix(rest)\n    %{iaid: iaid, ia_prefix: ia_prefix, type: :ia_pd}\n  end\n\n  defp parse_ia_pd(_), do: nil\n\n  defp extract_ia_addr(<<@option_ia_addr::16, len::16, data::binary-size(len), _rest::binary>>) do\n    case data do\n      <<a::16, b::16, c::16, d::16, e::16, f::16, g::16, h::16, _lifetimes::binary>> ->\n        {a, b, c, d, e, f, g, h}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_addr(_), do: nil\n\n  defp extract_ia_prefix(\n         <<@option_ia_prefix::16, len::16, data::binary-size(len), _rest::binary>>\n       ) do\n    case data do\n      <<_preferred::32, _valid::32, prefix_len::8, a::16, b::16, c::16, d::16, e::16, f::16,\n        g::16, h::16>> ->\n        {{a, b, c, d, e, f, g, h}, prefix_len}\n\n      _ ->\n        nil\n    end\n  end\n\n  defp extract_ia_prefix(_), do: nil\nend\n","structuredPatch":[],"originalFile":null}}
