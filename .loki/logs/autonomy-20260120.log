{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XiGX1Fvz5wUNkXQUCsPTbU","type":"tool_result","content":"     1→defmodule YellowDog.Dhcpv6.AddressPool do\n     2→  @moduledoc \"\"\"\n     3→  IPv6 address pool management for DHCPv6.\n     4→\n     5→  Manages IPv6 address ranges, allocation, and availability tracking.\n     6→  Supports multiple pools, static reservations, and prefix delegation.\n     7→  \"\"\"\n     8→\n     9→  import Bitwise\n    10→\n    11→  @type ipv6_address ::\n    12→          {0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535}\n    13→  @type duid :: binary()\n    14→  @type address_range :: %{\n    15→          start: ipv6_address(),\n    16→          end: ipv6_address()\n    17→        }\n    18→\n    19→  @type pool_config :: %{\n    20→          name: String.t(),\n    21→          ranges: [address_range()],\n    22→          # Legacy single range support\n    23→          range_start: ipv6_address() | nil,\n    24→          range_end: ipv6_address() | nil,\n    25→          exclude_addresses: [ipv6_address()],\n    26→          prefix_length: pos_integer(),\n    27→          dns_servers: [ipv6_address()],\n    28→          domain_name: String.t() | nil,\n    29→          preferred_lifetime: pos_integer(),\n    30→          valid_lifetime: pos_integer(),\n    31→          static_reservations: %{String.t() => ipv6_address()}\n    32→        }\n    33→\n    34→  @doc \"\"\"\n    35→  Creates a new IPv6 address pool from configuration.\n    36→\n    37→  ## Parameters\n    38→  - `config` - Pool configuration map with either:\n    39→    - `ranges` - List of %{start: ip, end: ip} maps (new format)\n    40→    - `range_start` and `range_end` - Single range (legacy format)\n    41→\n    42→  ## Returns\n    43→  - `{:ok, pool}` - Successfully created pool\n    44→  - `{:error, reason}` - Failed to create pool\n    45→  \"\"\"\n    46→  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n    47→  def new(config) do\n    48→    with {:ok, validated_config} <- validate_pool_config(config) do\n    49→      # Parse static reservations\n    50→      reservations =\n    51→        case Map.get(config, :static_reservations, %{}) do\n    52→          list when is_list(list) ->\n    53→            # Convert list format to map\n    54→            Enum.reduce(list, %{}, fn reservation, acc ->\n    55→              case reservation do\n    56→                %{duid: duid, address: address} when is_binary(address) ->\n    57→                  case parse_ipv6_string(address) do\n    58→                    {:ok, ip_tuple} ->\n    59→                      Map.put(acc, format_duid(duid), ip_tuple)\n    60→\n    61→                    _ ->\n    62→                      acc\n    63→                  end\n    64→\n    65→                %{duid: duid, address: address} when is_tuple(address) ->\n    66→                  Map.put(acc, format_duid(duid), address)\n    67→\n    68→                _ ->\n    69→                  acc\n    70→              end\n    71→            end)\n    72→\n    73→          map when is_map(map) ->\n    74→            map\n    75→\n    76→          _ ->\n    77→            %{}\n    78→        end\n    79→\n    80→      # Parse exclude addresses\n    81→      exclude_addresses =\n    82→        config\n    83→        |> Map.get(:exclude_addresses, [])\n    84→        |> Enum.flat_map(fn\n    85→          addr when is_binary(addr) ->\n    86→            case parse_ipv6_string(addr) do\n    87→              {:ok, ip_tuple} -> [ip_tuple]\n    88→              _ -> []\n    89→            end\n    90→\n    91→          addr when is_tuple(addr) ->\n    92→            [addr]\n    93→\n    94→          _ ->\n    95→            []\n    96→        end)\n    97→        |> MapSet.new()\n    98→\n    99→      pool = %{\n   100→        name: Map.get(config, :name, \"default\"),\n   101→        ranges: validated_config.ranges,\n   102→        range_start: validated_config[:range_start],\n   103→        range_end: validated_config[:range_end],\n   104→        exclude_addresses: exclude_addresses,\n   105→        prefix_length: Map.get(config, :prefix_length, 64),\n   106→        dns_servers: parse_dns_servers(Map.get(config, :dns_servers, [])),\n   107→        domain_name: Map.get(config, :domain_name),\n   108→        preferred_lifetime: Map.get(config, :preferred_lifetime, 3600),\n   109→        valid_lifetime: Map.get(config, :valid_lifetime, 7200),\n   110→        static_reservations: reservations\n   111→      }\n   112→\n   113→      {:ok, pool}\n   114→    end\n   115→  end\n   116→\n   117→  @doc \"\"\"\n   118→  Validates pool configuration.\n   119→\n   120→  Supports both legacy format (range_start/range_end) and new format (ranges list).\n   121→  \"\"\"\n   122→  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n   123→  def validate_pool_config(config) do\n   124→    cond do\n   125→      # New format: multiple ranges\n   126→      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n   127→        validate_ranges_config(config.ranges)\n   128→\n   129→      # Legacy format: single range\n   130→      Map.has_key?(config, :range_start) && Map.has_key?(config, :range_end) ->\n   131→        with {:ok, range_start} <- get_required_ipv6(config, :range_start),\n   132→             {:ok, range_end} <- get_required_ipv6(config, :range_end),\n   133→             :ok <- validate_range_order(range_start, range_end) do\n   134→          {:ok,\n   135→           %{\n   136→             ranges: [%{start: range_start, end: range_end}],\n   137→             range_start: range_start,\n   138→             range_end: range_end\n   139→           }}\n   140→        end\n   141→\n   142→      true ->\n   143→        {:error, \"Pool configuration must have either 'ranges' or 'range_start'/'range_end'\"}\n   144→    end\n   145→  end\n   146→\n   147→  defp validate_ranges_config(ranges) do\n   148→    validated_ranges =\n   149→      Enum.reduce_while(ranges, [], fn range, acc ->\n   150→        case validate_single_range(range) do\n   151→          {:ok, validated_range} -> {:cont, [validated_range | acc]}\n   152→          {:error, reason} -> {:halt, {:error, reason}}\n   153→        end\n   154→      end)\n   155→\n   156→    case validated_ranges do\n   157→      {:error, reason} ->\n   158→        {:error, reason}\n   159→\n   160→      validated when is_list(validated) ->\n   161→        # Take first range as primary for backward compatibility\n   162→        first_range = List.first(validated)\n   163→\n   164→        {:ok,\n   165→         %{\n   166→           ranges: Enum.reverse(validated),\n   167→           range_start: first_range.start,\n   168→           range_end: first_range.end\n   169→         }}\n   170→    end\n   171→  end\n   172→\n   173→  defp validate_single_range(range) do\n   174→    with {:ok, start_ip} <- parse_range_ip(range, :start),\n   175→         {:ok, end_ip} <- parse_range_ip(range, :end),\n   176→         :ok <- validate_range_order(start_ip, end_ip) do\n   177→      {:ok, %{start: start_ip, end: end_ip}}\n   178→    end\n   179→  end\n   180→\n   181→  defp parse_range_ip(range, key) do\n   182→    case Map.get(range, key) do\n   183→      nil ->\n   184→        {:error, \"Missing required field in range: #{key}\"}\n   185→\n   186→      ip when is_tuple(ip) and tuple_size(ip) == 8 ->\n   187→        {:ok, ip}\n   188→\n   189→      ip when is_binary(ip) ->\n   190→        parse_ipv6_string(ip)\n   191→\n   192→      _ ->\n   193→        {:error, \"Invalid IPv6 address format for range #{key}\"}\n   194→    end\n   195→  end\n   196→\n   197→  @doc \"\"\"\n   198→  Gets the next available IPv6 address from the pool.\n   199→\n   200→  ## Parameters\n   201→  - `pool` - Pool configuration\n   202→  - `allocated_ips` - Set of already allocated IP addresses\n   203→  - `duid` - DUID requesting the IP (for static reservation check)\n   204→\n   205→  ## Returns\n   206→  - `{:ok, ip}` - Available IP address\n   207→  - `{:error, :pool_exhausted}` - No available addresses\n   208→  \"\"\"\n   209→  @spec get_available_ip(pool_config(), MapSet.t(ipv6_address()), duid()) ::\n   210→          {:ok, ipv6_address()} | {:error, :pool_exhausted}\n   211→  def get_available_ip(pool, allocated_ips, duid) do\n   212→    # Check for static reservation first\n   213→    case get_static_reservation(pool, duid) do\n   214→      {:ok, ip} ->\n   215→        {:ok, ip}\n   216→\n   217→      :not_found ->\n   218→        # Combine allocated IPs with excluded addresses\n   219→        unavailable_ips = MapSet.union(allocated_ips, pool.exclude_addresses)\n   220→\n   221→        # Try to find available IP from any range\n   222→        find_available_in_ranges(pool.ranges, unavailable_ips)\n   223→    end\n   224→  end\n   225→\n   226→  defp find_available_in_ranges([], _unavailable_ips) do\n   227→    {:error, :pool_exhausted}\n   228→  end\n   229→\n   230→  defp find_available_in_ranges([range | rest], unavailable_ips) do\n   231→    case find_next_available(range.start, range.end, unavailable_ips) do\n   232→      {:ok, ip} -> {:ok, ip}\n   233→      {:error, :pool_exhausted} -> find_available_in_ranges(rest, unavailable_ips)\n   234→    end\n   235→  end\n   236→\n   237→  @doc \"\"\"\n   238→  Checks if an IPv6 address is within any of the pool ranges.\n   239→  \"\"\"\n   240→  @spec in_range?(pool_config(), ipv6_address()) :: boolean()\n   241→  def in_range?(pool, ip) do\n   242→    ip_int = ipv6_to_integer(ip)\n   243→\n   244→    Enum.any?(pool.ranges, fn range ->\n   245→      start_int = ipv6_to_integer(range.start)\n   246→      end_int = ipv6_to_integer(range.end)\n   247→      start_int <= ip_int and ip_int <= end_int\n   248→    end)\n   249→  end\n   250→\n   251→  @doc \"\"\"\n   252→  Gets static reservation for a DUID.\n   253→  \"\"\"\n   254→  @spec get_static_reservation(pool_config(), duid()) ::\n   255→          {:ok, ipv6_address()} | :not_found\n   256→  def get_static_reservation(pool, duid) do\n   257→    case Map.get(pool.static_reservations, format_duid(duid)) do\n   258→      nil -> :not_found\n   259→      ip -> {:ok, ip}\n   260→    end\n   261→  end\n   262→\n   263→  @doc \"\"\"\n   264→  Counts total addresses in the pool (across all ranges, minus exclusions).\n   265→  \"\"\"\n   266→  @spec pool_size(pool_config()) :: non_neg_integer()\n   267→  def pool_size(pool) do\n   268→    total_size =\n   269→      Enum.reduce(pool.ranges, 0, fn range, acc ->\n   270→        start_int = ipv6_to_integer(range.start)\n   271→        end_int = ipv6_to_integer(range.end)\n   272→        acc + (end_int - start_int + 1)\n   273→      end)\n   274→\n   275→    # Subtract excluded addresses\n   276→    total_size - MapSet.size(pool.exclude_addresses)\n   277→  end\n   278→\n   279→  # Private helper functions\n   280→\n   281→  defp get_required_ipv6(config, key) do\n   282→    case Map.get(config, key) do\n   283→      nil ->\n   284→        {:error, \"Missing required field: #{key}\"}\n   285→\n   286→      ip when is_tuple(ip) and tuple_size(ip) == 8 ->\n   287→        {:ok, ip}\n   288→\n   289→      ip when is_binary(ip) ->\n   290→        parse_ipv6_string(ip)\n   291→\n   292→      _ ->\n   293→        {:error, \"Invalid IPv6 address format for #{key}\"}\n   294→    end\n   295→  end\n   296→\n   297→  defp validate_range_order(start_ip, end_ip) do\n   298→    if ipv6_to_integer(start_ip) <= ipv6_to_integer(end_ip) do\n   299→      :ok\n   300→    else\n   301→      {:error, \"range_start must be less than or equal to range_end\"}\n   302→    end\n   303→  end\n   304→\n   305→  defp find_next_available(start_ip, end_ip, unavailable_ips) do\n   306→    start_int = ipv6_to_integer(start_ip)\n   307→    end_int = ipv6_to_integer(end_ip)\n   308→\n   309→    # For large IPv6 ranges, we can't iterate through all addresses\n   310→    # Instead, use a random approach with collision detection\n   311→    max_attempts = 100\n   312→\n   313→    result =\n   314→      Enum.reduce_while(1..max_attempts, nil, fn _attempt, _acc ->\n   315→        # Generate a random offset within the range\n   316→        offset = :rand.uniform(end_int - start_int + 1) - 1\n   317→        ip_int = start_int + offset\n   318→        ip = integer_to_ipv6(ip_int)\n   319→\n   320→        if not MapSet.member?(unavailable_ips, ip) do\n   321→          {:halt, {:ok, ip}}\n   322→        else\n   323→          {:cont, nil}\n   324→        end\n   325→      end)\n   326→\n   327→    case result do\n   328→      nil -> {:error, :pool_exhausted}\n   329→      {:ok, ip} -> {:ok, ip}\n   330→    end\n   331→  end\n   332→\n   333→  defp ipv6_to_integer({a, b, c, d, e, f, g, h}) do\n   334→    a * (1 <<< 112) +\n   335→      b * (1 <<< 96) +\n   336→      c * (1 <<< 80) +\n   337→      d * (1 <<< 64) +\n   338→      e * (1 <<< 48) +\n   339→      f * (1 <<< 32) +\n   340→      g * (1 <<< 16) +\n   341→      h\n   342→  end\n   343→\n   344→  defp integer_to_ipv6(int) do\n   345→    a = int >>> 112 &&& 0xFFFF\n   346→    b = int >>> 96 &&& 0xFFFF\n   347→    c = int >>> 80 &&& 0xFFFF\n   348→    d = int >>> 64 &&& 0xFFFF\n   349→    e = int >>> 48 &&& 0xFFFF\n   350→    f = int >>> 32 &&& 0xFFFF\n   351→    g = int >>> 16 &&& 0xFFFF\n   352→    h = int &&& 0xFFFF\n   353→    {a, b, c, d, e, f, g, h}\n   354→  end\n   355→\n   356→  defp parse_ipv6_string(ip_string) do\n   357→    case :inet.parse_ipv6_address(String.to_charlist(ip_string)) do\n   358→      {:ok, ip_tuple} -> {:ok, ip_tuple}\n   359→      {:error, _} -> {:error, \"Invalid IPv6 address string: #{ip_string}\"}\n   360→    end\n   361→  end\n   362→\n   363→  defp parse_dns_servers(dns_servers) when is_list(dns_servers) do\n   364→    Enum.flat_map(dns_servers, fn\n   365→      server when is_binary(server) ->\n   366→        case parse_ipv6_string(server) do\n   367→          {:ok, ip_tuple} -> [ip_tuple]\n   368→          _ -> []\n   369→        end\n   370→\n   371→      server when is_tuple(server) and tuple_size(server) == 8 ->\n   372→        [server]\n   373→\n   374→      _ ->\n   375→        []\n   376→    end)\n   377→  end\n   378→\n   379→  defp parse_dns_servers(_), do: []\n   380→\n   381→  defp format_duid(duid) when is_binary(duid) do\n   382→    duid\n   383→    |> :binary.bin_to_list()\n   384→    |> Enum.map(&Integer.to_string(&1, 16))\n   385→    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n   386→    |> Enum.join(\":\")\n   387→    |> String.upcase()\n   388→  end\n   389→\n   390→  defp format_duid(_), do: \"UNKNOWN\"\n   391→end\n   392→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"0d3ee750-7f11-4e1e-a617-3b37d644afe9","uuid":"d971318f-4f03-4178-8b8f-a874a1f0322e","tool_use_result":{"type":"text","file":{"filePath":"/home/gao/Workspace/gsmlg-dev/yellow-dog/apps/yellow_dog_dhcpv6/lib/yellow_dog/dhcpv6/address_pool.ex","content":"defmodule YellowDog.Dhcpv6.AddressPool do\n  @moduledoc \"\"\"\n  IPv6 address pool management for DHCPv6.\n\n  Manages IPv6 address ranges, allocation, and availability tracking.\n  Supports multiple pools, static reservations, and prefix delegation.\n  \"\"\"\n\n  import Bitwise\n\n  @type ipv6_address ::\n          {0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535, 0..65535}\n  @type duid :: binary()\n  @type address_range :: %{\n          start: ipv6_address(),\n          end: ipv6_address()\n        }\n\n  @type pool_config :: %{\n          name: String.t(),\n          ranges: [address_range()],\n          # Legacy single range support\n          range_start: ipv6_address() | nil,\n          range_end: ipv6_address() | nil,\n          exclude_addresses: [ipv6_address()],\n          prefix_length: pos_integer(),\n          dns_servers: [ipv6_address()],\n          domain_name: String.t() | nil,\n          preferred_lifetime: pos_integer(),\n          valid_lifetime: pos_integer(),\n          static_reservations: %{String.t() => ipv6_address()}\n        }\n\n  @doc \"\"\"\n  Creates a new IPv6 address pool from configuration.\n\n  ## Parameters\n  - `config` - Pool configuration map with either:\n    - `ranges` - List of %{start: ip, end: ip} maps (new format)\n    - `range_start` and `range_end` - Single range (legacy format)\n\n  ## Returns\n  - `{:ok, pool}` - Successfully created pool\n  - `{:error, reason}` - Failed to create pool\n  \"\"\"\n  @spec new(map()) :: {:ok, pool_config()} | {:error, term()}\n  def new(config) do\n    with {:ok, validated_config} <- validate_pool_config(config) do\n      # Parse static reservations\n      reservations =\n        case Map.get(config, :static_reservations, %{}) do\n          list when is_list(list) ->\n            # Convert list format to map\n            Enum.reduce(list, %{}, fn reservation, acc ->\n              case reservation do\n                %{duid: duid, address: address} when is_binary(address) ->\n                  case parse_ipv6_string(address) do\n                    {:ok, ip_tuple} ->\n                      Map.put(acc, format_duid(duid), ip_tuple)\n\n                    _ ->\n                      acc\n                  end\n\n                %{duid: duid, address: address} when is_tuple(address) ->\n                  Map.put(acc, format_duid(duid), address)\n\n                _ ->\n                  acc\n              end\n            end)\n\n          map when is_map(map) ->\n            map\n\n          _ ->\n            %{}\n        end\n\n      # Parse exclude addresses\n      exclude_addresses =\n        config\n        |> Map.get(:exclude_addresses, [])\n        |> Enum.flat_map(fn\n          addr when is_binary(addr) ->\n            case parse_ipv6_string(addr) do\n              {:ok, ip_tuple} -> [ip_tuple]\n              _ -> []\n            end\n\n          addr when is_tuple(addr) ->\n            [addr]\n\n          _ ->\n            []\n        end)\n        |> MapSet.new()\n\n      pool = %{\n        name: Map.get(config, :name, \"default\"),\n        ranges: validated_config.ranges,\n        range_start: validated_config[:range_start],\n        range_end: validated_config[:range_end],\n        exclude_addresses: exclude_addresses,\n        prefix_length: Map.get(config, :prefix_length, 64),\n        dns_servers: parse_dns_servers(Map.get(config, :dns_servers, [])),\n        domain_name: Map.get(config, :domain_name),\n        preferred_lifetime: Map.get(config, :preferred_lifetime, 3600),\n        valid_lifetime: Map.get(config, :valid_lifetime, 7200),\n        static_reservations: reservations\n      }\n\n      {:ok, pool}\n    end\n  end\n\n  @doc \"\"\"\n  Validates pool configuration.\n\n  Supports both legacy format (range_start/range_end) and new format (ranges list).\n  \"\"\"\n  @spec validate_pool_config(map()) :: {:ok, map()} | {:error, term()}\n  def validate_pool_config(config) do\n    cond do\n      # New format: multiple ranges\n      Map.has_key?(config, :ranges) && is_list(config.ranges) ->\n        validate_ranges_config(config.ranges)\n\n      # Legacy format: single range\n      Map.has_key?(config, :range_start) && Map.has_key?(config, :range_end) ->\n        with {:ok, range_start} <- get_required_ipv6(config, :range_start),\n             {:ok, range_end} <- get_required_ipv6(config, :range_end),\n             :ok <- validate_range_order(range_start, range_end) do\n          {:ok,\n           %{\n             ranges: [%{start: range_start, end: range_end}],\n             range_start: range_start,\n             range_end: range_end\n           }}\n        end\n\n      true ->\n        {:error, \"Pool configuration must have either 'ranges' or 'range_start'/'range_end'\"}\n    end\n  end\n\n  defp validate_ranges_config(ranges) do\n    validated_ranges =\n      Enum.reduce_while(ranges, [], fn range, acc ->\n        case validate_single_range(range) do\n          {:ok, validated_range} -> {:cont, [validated_range | acc]}\n          {:error, reason} -> {:halt, {:error, reason}}\n        end\n      end)\n\n    case validated_ranges do\n      {:error, reason} ->\n        {:error, reason}\n\n      validated when is_list(validated) ->\n        # Take first range as primary for backward compatibility\n        first_range = List.first(validated)\n\n        {:ok,\n         %{\n           ranges: Enum.reverse(validated),\n           range_start: first_range.start,\n           range_end: first_range.end\n         }}\n    end\n  end\n\n  defp validate_single_range(range) do\n    with {:ok, start_ip} <- parse_range_ip(range, :start),\n         {:ok, end_ip} <- parse_range_ip(range, :end),\n         :ok <- validate_range_order(start_ip, end_ip) do\n      {:ok, %{start: start_ip, end: end_ip}}\n    end\n  end\n\n  defp parse_range_ip(range, key) do\n    case Map.get(range, key) do\n      nil ->\n        {:error, \"Missing required field in range: #{key}\"}\n\n      ip when is_tuple(ip) and tuple_size(ip) == 8 ->\n        {:ok, ip}\n\n      ip when is_binary(ip) ->\n        parse_ipv6_string(ip)\n\n      _ ->\n        {:error, \"Invalid IPv6 address format for range #{key}\"}\n    end\n  end\n\n  @doc \"\"\"\n  Gets the next available IPv6 address from the pool.\n\n  ## Parameters\n  - `pool` - Pool configuration\n  - `allocated_ips` - Set of already allocated IP addresses\n  - `duid` - DUID requesting the IP (for static reservation check)\n\n  ## Returns\n  - `{:ok, ip}` - Available IP address\n  - `{:error, :pool_exhausted}` - No available addresses\n  \"\"\"\n  @spec get_available_ip(pool_config(), MapSet.t(ipv6_address()), duid()) ::\n          {:ok, ipv6_address()} | {:error, :pool_exhausted}\n  def get_available_ip(pool, allocated_ips, duid) do\n    # Check for static reservation first\n    case get_static_reservation(pool, duid) do\n      {:ok, ip} ->\n        {:ok, ip}\n\n      :not_found ->\n        # Combine allocated IPs with excluded addresses\n        unavailable_ips = MapSet.union(allocated_ips, pool.exclude_addresses)\n\n        # Try to find available IP from any range\n        find_available_in_ranges(pool.ranges, unavailable_ips)\n    end\n  end\n\n  defp find_available_in_ranges([], _unavailable_ips) do\n    {:error, :pool_exhausted}\n  end\n\n  defp find_available_in_ranges([range | rest], unavailable_ips) do\n    case find_next_available(range.start, range.end, unavailable_ips) do\n      {:ok, ip} -> {:ok, ip}\n      {:error, :pool_exhausted} -> find_available_in_ranges(rest, unavailable_ips)\n    end\n  end\n\n  @doc \"\"\"\n  Checks if an IPv6 address is within any of the pool ranges.\n  \"\"\"\n  @spec in_range?(pool_config(), ipv6_address()) :: boolean()\n  def in_range?(pool, ip) do\n    ip_int = ipv6_to_integer(ip)\n\n    Enum.any?(pool.ranges, fn range ->\n      start_int = ipv6_to_integer(range.start)\n      end_int = ipv6_to_integer(range.end)\n      start_int <= ip_int and ip_int <= end_int\n    end)\n  end\n\n  @doc \"\"\"\n  Gets static reservation for a DUID.\n  \"\"\"\n  @spec get_static_reservation(pool_config(), duid()) ::\n          {:ok, ipv6_address()} | :not_found\n  def get_static_reservation(pool, duid) do\n    case Map.get(pool.static_reservations, format_duid(duid)) do\n      nil -> :not_found\n      ip -> {:ok, ip}\n    end\n  end\n\n  @doc \"\"\"\n  Counts total addresses in the pool (across all ranges, minus exclusions).\n  \"\"\"\n  @spec pool_size(pool_config()) :: non_neg_integer()\n  def pool_size(pool) do\n    total_size =\n      Enum.reduce(pool.ranges, 0, fn range, acc ->\n        start_int = ipv6_to_integer(range.start)\n        end_int = ipv6_to_integer(range.end)\n        acc + (end_int - start_int + 1)\n      end)\n\n    # Subtract excluded addresses\n    total_size - MapSet.size(pool.exclude_addresses)\n  end\n\n  # Private helper functions\n\n  defp get_required_ipv6(config, key) do\n    case Map.get(config, key) do\n      nil ->\n        {:error, \"Missing required field: #{key}\"}\n\n      ip when is_tuple(ip) and tuple_size(ip) == 8 ->\n        {:ok, ip}\n\n      ip when is_binary(ip) ->\n        parse_ipv6_string(ip)\n\n      _ ->\n        {:error, \"Invalid IPv6 address format for #{key}\"}\n    end\n  end\n\n  defp validate_range_order(start_ip, end_ip) do\n    if ipv6_to_integer(start_ip) <= ipv6_to_integer(end_ip) do\n      :ok\n    else\n      {:error, \"range_start must be less than or equal to range_end\"}\n    end\n  end\n\n  defp find_next_available(start_ip, end_ip, unavailable_ips) do\n    start_int = ipv6_to_integer(start_ip)\n    end_int = ipv6_to_integer(end_ip)\n\n    # For large IPv6 ranges, we can't iterate through all addresses\n    # Instead, use a random approach with collision detection\n    max_attempts = 100\n\n    result =\n      Enum.reduce_while(1..max_attempts, nil, fn _attempt, _acc ->\n        # Generate a random offset within the range\n        offset = :rand.uniform(end_int - start_int + 1) - 1\n        ip_int = start_int + offset\n        ip = integer_to_ipv6(ip_int)\n\n        if not MapSet.member?(unavailable_ips, ip) do\n          {:halt, {:ok, ip}}\n        else\n          {:cont, nil}\n        end\n      end)\n\n    case result do\n      nil -> {:error, :pool_exhausted}\n      {:ok, ip} -> {:ok, ip}\n    end\n  end\n\n  defp ipv6_to_integer({a, b, c, d, e, f, g, h}) do\n    a * (1 <<< 112) +\n      b * (1 <<< 96) +\n      c * (1 <<< 80) +\n      d * (1 <<< 64) +\n      e * (1 <<< 48) +\n      f * (1 <<< 32) +\n      g * (1 <<< 16) +\n      h\n  end\n\n  defp integer_to_ipv6(int) do\n    a = int >>> 112 &&& 0xFFFF\n    b = int >>> 96 &&& 0xFFFF\n    c = int >>> 80 &&& 0xFFFF\n    d = int >>> 64 &&& 0xFFFF\n    e = int >>> 48 &&& 0xFFFF\n    f = int >>> 32 &&& 0xFFFF\n    g = int >>> 16 &&& 0xFFFF\n    h = int &&& 0xFFFF\n    {a, b, c, d, e, f, g, h}\n  end\n\n  defp parse_ipv6_string(ip_string) do\n    case :inet.parse_ipv6_address(String.to_charlist(ip_string)) do\n      {:ok, ip_tuple} -> {:ok, ip_tuple}\n      {:error, _} -> {:error, \"Invalid IPv6 address string: #{ip_string}\"}\n    end\n  end\n\n  defp parse_dns_servers(dns_servers) when is_list(dns_servers) do\n    Enum.flat_map(dns_servers, fn\n      server when is_binary(server) ->\n        case parse_ipv6_string(server) do\n          {:ok, ip_tuple} -> [ip_tuple]\n          _ -> []\n        end\n\n      server when is_tuple(server) and tuple_size(server) == 8 ->\n        [server]\n\n      _ ->\n        []\n    end)\n  end\n\n  defp parse_dns_servers(_), do: []\n\n  defp format_duid(duid) when is_binary(duid) do\n    duid\n    |> :binary.bin_to_list()\n    |> Enum.map(&Integer.to_string(&1, 16))\n    |> Enum.map(&String.pad_leading(&1, 2, \"0\"))\n    |> Enum.join(\":\")\n    |> String.upcase()\n  end\n\n  defp format_duid(_), do: \"UNKNOWN\"\nend\n","numLines":392,"startLine":1,"totalLines":392}}}
