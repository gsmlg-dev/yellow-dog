\n    58→      plt_core_path: \"priv/plts\",\n    59→      plt_file: {:no_warn, \"priv/plts/dialyzer.plt\"},\n    60→      plt_add_deps: :apps_direct,\n    61→      plt_add_apps: [:public_key],\n    62→      flags: [\n    63→        \"-Werror_handling\",\n    64→        \"-Wextra_return\",\n    65→        \"-Wmissing_return\",\n    66→        \"-Wunknown\",\n    67→        \"-Wunmatched_returns\",\n    68→        \"-Wunderspecs\"\n    69→      ]\n    70→    ]\n    71→  end\n    72→\n    73→  defp package do\n    74→    [\n    75→      maintainers: [\"Jonathan Gao\"],\n    76→      licenses: [\"MIT\"],\n    77→      files: ~w(lib LICENSE mix.exs README.md),\n    78→      links: %{\n    79→        Github: @source_url,\n    80→        Changelog: \"https://hexdocs.pm/abyss/changelog.html\"\n    81→      }\n    82→    ]\n    83→  end\n    84→\n    85→  defp docs do\n    86→    [\n    87→      main: \"readme\",\n    88→      extras: [\"README.md\"],\n    89→      source_url: @source_url,\n    90→      source_ref: \"v#{@version}\"\n    91→    ]\n    92→  end\n    93→\n    94→  defp aliases do\n    95→    [\n    96→      lint: [\"credo --strict\", \"dialyzer\"],\n    97→      test: [\"test --cover\"],\n    98→      \"test.all\": [\"test --include integration --include slow\"],\n    99→      \"test.unit\": [\"test --exclude integration --exclude slow\"],\n   100→      \"test.integration\": [\"test --include integration\"],\n   101→      ci: [\n   102→        \"format --check-formatted\",\n   103→        \"credo --strict\",\n   104→        \"test --cover --include integration\"\n   105→      ],\n   106→      publish: [\n   107→        \"format\",\n   108→        \"hex.publish --yes\"\n   109→      ]\n   110→    ]\n   111→  end\n   112→end\n   113→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You ca