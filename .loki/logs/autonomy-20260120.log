xtract rcode value for comparison\n    51→  defp rcode_value(%RCode{value: <<value::4>>}), do: value\n    52→  defp rcode_value(other), do: other\n    53→\n    54→  describe \"start_link/1\" do\n    55→    test \"starts connection process with required options\" do\n    56→      {:ok, pid} =\n    57→        ConnectionProcess.start_link(\n    58→          handler_pid: self(),\n    59→          client_ip: {127, 0, 0, 1},\n    60→          client_port: 12345\n    61→        )\n    62→\n    63→      assert is_pid(pid)\n    64→      assert Process.alive?(pid)\n    65→\n    66→      # Cleanup\n    67→      GenServer.stop(pid)\n    68→    end\n    69→\n    70→    test \"starts connection process with all options\" do\n    71→      {:ok, pid} =\n    72→        ConnectionProcess.start_link(\n    73→          handler_pid: self(),\n    74→          client_ip: {192, 168, 1, 100},\n    75→          client_port: 54321,\n    76→          socket: nil,\n    77→          query_timeout: 10_000\n    78→        )\n    79→\n    80→      assert is_pid(pid)\n    81→      assert Process.alive?(pid)\n    82→\n    83→      # Cleanup\n    84→      GenServer.stop(pid)\n    85→    end\n    86→\n    87→    test \"starts with IPv6 client address\" do\n    88→      {:ok, pid} =\n    89→        ConnectionProcess.start_link(\n    90→          handler_pid: self(),\n    91→          client_ip: {0, 0, 0, 0, 0, 0, 0, 1},\n    92→          client_port: 12345\n    93→        )\n    94→\n    95→      assert is_pid(pid)\n    96→      assert Process.alive?(pid)\n    97→\n    98→      # Cleanup\n    99→      GenServer.stop(pid)\n   100→    end\n   101→\n   102→    test \"fails when handler_pid is missing\" do\n   103→      # GenServer.start_link raises when init/1 throws an error\n   104→      # The error comes from Keyword.fetch!\n   105→      Process.flag(:trap_exit, true)\n   106→\n   107→      result =\n   108→        ConnectionProcess.start_link(\n   109→          client_ip: {127, 0, 0, 1},\n   110→      